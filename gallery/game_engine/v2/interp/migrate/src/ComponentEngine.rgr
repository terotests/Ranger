                }
                if ((own35 == 1) && ((st35 == 0) && (xt35 == 0))) {
                    def c35:EvHandle (itemAt bcStack (base + slot35))
                    def x35:EvHandle (itemAt bcStack sp)
                    if ((c35.isString()) && (x35.isString())) {
                        ; in-place append, mirroring the walker's slot rule:
                        ; write through only a handle this slot MINTED, else
                        ; mint one
                        if c35.slotOwned {
                            c35.strSlotAppend((x35.stringOf()))
                            continue
                        }
                        def f35:EvHandle (EvHandle.string(((c35.stringOf()) + (x35.stringOf()))))
                        f35.slotOwned = true
                        set bcStack (base + slot35) f35
                        continue
                    }
                }
                def cb35:EvHandle (this.bcSlotBox((base + slot35)))
                def xb35:EvHandle (this.bcSlotBox(sp))
                bcSp = needTop
                def r35:EvHandle (this.applyBinaryOp(20 cb35 xb35))
                bcSp = base
                if scriptThrew {
                    if (bcTryTop > tryBase) {
                        bcTryTop = (bcTryTop - 1)
                        pc = (itemAt bcTryPcs bcTryTop)
                        sp = (itemAt bcTrySps bcTryTop)
                        scriptThrew = false
                        continue
                    }
                    bcTryTop = tryBase
                    bcRetTag = 3
                    return
                }
                this.bcSlotPut((base + slot35) r35)
                continue
            }
            if (op == 42) {
                ; forward jump (break/continue/over-handler): never counts
                ; toward the loop-iteration guard
                pc = a
                continue
            }
            if (op == 43) {
                while ((array_length bcTryPcs) <= bcTryTop) {
                    push bcTryPcs 0
                }
                while ((array_length bcTrySps) <= bcTryTop) {
                    push bcTrySps 0
                }
                set bcTryPcs bcTryTop a
                set bcTrySps bcTryTop sp
                bcTryTop = (bcTryTop + 1)
                continue
            }
            if (op == 44) {
                bcTryTop = (bcTryTop - 1)
                continue
            }
            if (op == 45) {
                ; throw: an operand-evaluation throw unwound before this op
                ; could run, so the operand IS the exception (walker rule)
                sp = (sp - 1)
                scriptThrowValue = (this.bcSlotBox(sp))
                scriptThrew = true
                if (bcTryTop > tryBase) {
                    bcTryTop = (bcTryTop - 1)
                    pc = (itemAt bcTryPcs bcTryTop)
                    sp = (itemAt bcTrySps bcTryTop)
                    scriptThrew = false
                    continue
                }
                bcTryTop = tryBase
                bcRetTag = 3
                return
            }
            if (op == 46) {
                ; catch entry: bind the pending exception to the parameter
                ; slot (a < 0: parameter-less catch), then reset the value
                ; exactly as the walker's catch does
                if (a >= 0) {
                    this.bcSlotPut((base + a) scriptThrowValue)
                }
                scriptThrowValue = (EvValueBridge.taggedNull())
                continue
            }
            if (op == 47) {
                def o47:EvHandle (this.bcSlotBox((sp - 1)))
                bcSp = needTop
                def keys47:EvHandle (this.bcForInKeys(o47))
                bcSp = base
                set bcTags (sp - 1) 0
                set bcStack (sp - 1) keys47
                continue
            }
            if (op == 48) {
                def k48:EvHandle (this.bcSlotBox((sp - 1)))
                def o48:EvHandle (this.bcSlotBox((sp - 2)))
                sp = (sp - 1)
                def has48:boolean true
                if (o48.isObject()) {
                    has48 = (this.objHasKeyUpChain(o48 (k48.stringOf())))
                }
                set bcTags (sp - 1) 2
                if has48 {
                    set bcNums (sp - 1) 1.0
                } {
                    set bcNums (sp - 1) 0.0
                }
                continue
            }
            if (op == 49) {
                def s49:EvHandle (this.bcSlotBox((sp - 1)))
                bcSp = needTop
                def items49:EvHandle (this.bcForOfItems(s49))
                bcSp = base
                set bcTags (sp - 1) 0
                set bcStack (sp - 1) items49
                continue
            }
        }
        ; fell past the last instruction without a ret (a jump target can be
        ; the very end): completes as undefined
        bcRetTag = 3
        bcTryTop = tryBase
        bcSp = base
        return
    }

    ; The op-20 fast path: a direct VM->VM call when the callee slot holds a
    ; plain user function whose body is compiled. Mirrors the guard ladder
    ; and the compiled-call prologue of callFnValueWithValues exactly; the
    ; only difference is transport -- arguments are copied as slot lanes
    ; into the callee frame and the result comes back through the bcRet
    ; lanes, so nothing at the boundary boxes. Answers:
    ;   -1 = not eligible (caller takes the generic path, which re-runs the
    ;        ladder and handles every special case)
    ;    0 = called; result lanes already written into fnPos's slot
    ;    1 = called and the callee threw
    fn bcTryDirectCall:int (fnPos:int argc:int needTop:int) {
        if ((itemAt bcTags fnPos) != 0) {
            return (0 - 1)
        }
        def fnv:EvHandle (itemAt bcStack fnPos)
        if (fnv.isBuiltinStatic()) {
            return (0 - 1)
        }
        if (false == (fnv.isFunction())) {
            return (0 - 1)
        }
        if (fnv.hasOwnData("__fnprotocall__")) {
            return (0 - 1)
        }
        def ctorN:string (this.builtinCtorNameOf(fnv))
        if ((strlen ctorN) > 0) {
            return (0 - 1)
        }
        if (fnv.isBuiltinMethod()) {
            return (0 - 1)
        }
        if (this.isEvalFunctionValue(fnv)) {
            return (0 - 1)
        }
        if (false == (fnv.hasFunctionNode())) {
            return (0 - 1)
        }
        if ((fnv.boundArgCount()) != 0) {
            return (0 - 1)
        }
        def fnNode:TSNode (fnv.functionNodeOf())
        def pid:int (this.bcProgramFor(fnNode))
        if (pid < 0) {
            return (0 - 1)
        }
        def prChk0:BcProgram (itemAt bcPrograms pid)
        if (argc > prChk0.paramCount) {
            ; extra arguments would land past the parameter slots; the
            ; generic path materializes and drops them correctly
            return (0 - 1)
        }
        def dkr:int (this.bcDirectCallKnown(fnPos argc needTop pid))
        if (dkr == 1) {
            return 1
        }
        ; ladder passed and the call ran: report the program id so the
        ; call site can arm its identity cache
        return (pid + 2)
    }

    ; The prologue + slot call for a callee the ladder (or the site's
    ; identity cache) already proved: a plain user function whose body is
    ; program `pid`. Answers 0 done / 1 threw.
    fn bcDirectCallKnown:int (fnPos:int argc:int needTop:int pid:int) {
        def fnv:EvHandle (itemAt bcStack fnPos)
        def fnNode:TSNode (fnv.functionNodeOf())
        def prF:BcProgram (itemAt bcPrograms pid)
        ; --- the compiled-call prologue, verbatim from callFnValueWithValues
        def savedDidReturnF:boolean scriptDidReturn
        def savedReturnValueF:EvHandle scriptReturnValue
        def savedModuleF:string currentModule
        scriptDidReturn = false
        scriptReturnValue = (EvValueBridge.taggedNull())
        def parentF:EvalContext context
        ; PERF: read the closure id ONCE. closureIdOf narrows the value union
        ; and derefs the function core, so three calls on the same handle were
        ; three narrows and three derefs -- 7.75% of every instruction `fib`
        ; executed, measured with callgrind on the amortised profile, and the
        ; single largest cost on the compiled-call path.
        def cidF:int (fnv.closureIdOf())
        def homeF:string (fnv.homeModuleOf())
        if (cidF >= 0) {
            if (cidF < (array_length closureScopes)) {
                def cellF:ClosureCell (itemAt closureScopes cidF)
                if cellF.ctx {
                    parentF = (unwrap cellF.ctx)
                }
            }
        } {
            ; same read-once rule: hasHomeModule is `(strlen homeModule) > 0`
            ; and the name is copied out unconditionally two lines down anyway,
            ; so one narrow does what three did
            if ((strlen homeF) > 0) {
                parentF = (this.moduleScopeFor(homeF))
            } {
                if ((strlen currentModule) > 0) {
                    parentF = moduleScope
                }
            }
        }
        currentModule = homeF
        ; D-THISCOERCE, compiled form (same as the call-in block)
        def bcThisF:EvHandle (EvValueBridge.taggedUndefined())
        if (fnv.hasBoundThis()) {
            bcThisF = (fnv.boundThisOf())
            if ((bcThisF.isNull()) || (bcThisF.isUndefined())) {
                bcThisF = (this.theGlobalObject())
            } {
                if (bcThisF.isString()) { bcThisF = (this.toObjectValue(bcThisF)) }
                if (bcThisF.isNumber()) { bcThisF = (this.toObjectValue(bcThisF)) }
                if (bcThisF.isBoolean()) { bcThisF = (this.toObjectValue(bcThisF)) }
            }
        } {
            if ((this.nodeKindOf(fnNode)) != 17) {
                bcThisF = (this.theGlobalObject())
            }
        }
        ; copy the argument lanes into the callee's param slots ABOVE this
        ; frame's live region
        this.bcGrowTo((needTop + argc))
        def ai:int 0
        while (ai < argc) {
            def sIdx:int ((fnPos + 1) + ai)
            def tA:int (itemAt bcTags sIdx)
            set bcTags (needTop + ai) tA
            if (tA == 0) {
                set bcStack (needTop + ai) (itemAt bcStack sIdx)
            } {
                set bcNums (needTop + ai) (itemAt bcNums sIdx)
            }
            ai = (ai + 1)
        }
        bcSp = needTop
        callDepth = (callDepth + 1)
        this.runBytecode(prF argc (unwrap parentF) bcThisF)
        callDepth = (callDepth - 1)
        currentModule = savedModuleF
        scriptDidReturn = savedDidReturnF
        scriptReturnValue = savedReturnValueF
        if scriptThrew {
            return 1
        }
        if scriptDidReturn {
            scriptDidReturn = false
        }
        ; result lanes -> the callee-position slot (the ref goes through a
        ; local so the Rust writer clones instead of moving the field)
        set bcTags fnPos bcRetTag
        if (bcRetTag == 0) {
            def rr:EvHandle bcRetRef
            set bcStack fnPos rr
        } {
            set bcNums fnPos bcRetNum
        }
        return 0
    }

    ; The op-32 fast path: a direct VM->VM METHOD call when the receiver's
    ; member resolves to a plain user function with a compiled body -- the
    ; canProps/getMember prefix of bcCallMethod, verbatim, ending in a slot
    ; call with the receiver as `this` instead of a bound clone boxed
    ; through callFnValueWithValues. getMember never runs user code (a
    ; getter goes through resolveGetterOn, which this path does not take),
    ; so a -1 fallback into bcCallMethod repeats the lookup safely.
    ; Answers -1 / 0 / 1 like bcTryDirectCall.
    fn bcTryDirectMethodCall:int (mFnPos:int mArgc:int mName:string needTop:int) {
        if ((itemAt bcTags mFnPos) != 0) {
            ; nullish receivers carry tags 3/4 and take the generic path,
            ; which throws the walker's TypeError
            return (0 - 1)
        }
        def obj:EvHandle (itemAt bcStack mFnPos)
        ; Plain object/function receivers only. Strings and arrays almost
        ; always dispatch to builtins, and probing their own-data here would
        ; tax every push/slice with a map lookup the generic path repeats;
        ; the rare array-with-own-method calls just stay generic.
        if (false == (obj.isObject())) {
            if (false == (obj.isFunction())) {
                return (0 - 1)
            }
        }
        def m:EvHandle (obj.memberFastAt(mName))
        if (m.isHole()) {
            m = (obj.getMember(mName))
        }
        if (m.isBuiltinStatic()) {
            ; bcCallMethod's first branch, without a second getMember: an
            ; invocable static runs here; a non-invocable one is the rare
            ; case the generic chain resolves
            if (this.hasInvocableStatic((m.builtinNamespaceOf()) (m.builtinNameOf()))) {
                def sArgsD:[EvHandle]
                def si:int 0
                while (si < mArgc) {
                    push sArgsD (this.bcSlotBox(((mFnPos + 1) + si)))
                    si = (si + 1)
                }
                staticCallReceiver = obj
                ; bcSp stays raised until the op-32 caller restores it
                bcSp = needTop
                def sRes:EvHandle (this.invokeBuiltinStatic((m.builtinNamespaceOf()) (m.builtinNameOf()) sArgsD))
                if scriptThrew {
                    return 1
                }
                this.bcSlotPut(mFnPos sRes)
                return 0
            }
            return (0 - 1)
        }
        if (m.isBuiltinMethod()) {
            def bmFn:EvHandle m
            if (false == (m.boundExplicitOf())) {
                bmFn = (m.withThisForCall(obj))
            }
            def bArgsD:[EvHandle]
            def bi:int 0
            while (bi < mArgc) {
                push bArgsD (this.bcSlotBox(((mFnPos + 1) + bi)))
                bi = (bi + 1)
            }
            bcSp = needTop
            def bRes:EvHandle (this.callFnValueWithValues(bmFn bArgsD))
            if scriptThrew {
                return 1
            }
            this.bcSlotPut(mFnPos bRes)
            return 0
        }
        if (false == (m.isFunction())) {
            return (0 - 1)
        }
        if (false == (m.hasFunctionNode())) {
            ; a function-kind value with no body: constructors and stubs --
            ; the generic chain owns those
            return (0 - 1)
        }
        def mDirect:boolean true
        if (m.hasBoundThis()) {
            mDirect = false
        }
        if (m.hasOwnData("__fnprotocall__")) {
            mDirect = false
        }
        def mCtorN:string (this.builtinCtorNameOf(m))
        if ((strlen mCtorN) > 0) {
            mDirect = false
        }
        if ((m.boundArgCount()) != 0) {
            mDirect = false
        }
        def fnNodeM:TSNode (m.functionNodeOf())
        def mIsArrow:boolean false
        if ((this.nodeKindOf(fnNodeM)) == 17) {
            ; an arrow found as a member keeps its lexical `this`
            mIsArrow = true
            mDirect = false
        }
        if mDirect {
            def pidM:int (this.bcProgramFor(fnNodeM))
            if (pidM < 0) {
                mDirect = false
            } {
                def prChk:BcProgram (itemAt bcPrograms pidM)
                if (mArgc > prChk.paramCount) {
                    mDirect = false
                }
            }
        }
        if (false == mDirect) {
            ; still one resolution: run bcCallMethod's guest-function branch
            ; here with the value already in hand
            def gFn:EvHandle m
            if ((false == (m.hasBoundThis())) && (false == mIsArrow)) {
                gFn = (m.withThisForCall(obj))
            }
            def gArgsD:[EvHandle]
            def gi:int 0
            while (gi < mArgc) {
                push gArgsD (this.bcSlotBox(((mFnPos + 1) + gi)))
                gi = (gi + 1)
            }
            bcSp = needTop
            def gRes:EvHandle (this.callFnValueWithValues(gFn gArgsD))
            if scriptThrew {
                return 1
            }
            this.bcSlotPut(mFnPos gRes)
            return 0
        }
        def pidM2:int (this.bcProgramFor(fnNodeM))
        def prM:BcProgram (itemAt bcPrograms pidM2)
        ; --- prologue: what callFnValueWithValues does for the bound clone.
        ; The receiver is object-like here (canProps), so D-THISCOERCE is a
        ; no-op and `this` is exactly obj.
        def savedDidReturnM:boolean scriptDidReturn
        def savedReturnValueM:EvHandle scriptReturnValue
        def savedModuleM:string currentModule
        scriptDidReturn = false
        scriptReturnValue = (EvValueBridge.taggedNull())
        def parentM:EvalContext context
        if ((m.closureIdOf()) >= 0) {
            if ((m.closureIdOf()) < (array_length closureScopes)) {
                def cellM:ClosureCell (itemAt closureScopes (m.closureIdOf()))
                if cellM.ctx {
                    parentM = (unwrap cellM.ctx)
                }
            }
        } {
            if (m.hasHomeModule()) {
                parentM = (this.moduleScopeFor((m.homeModuleOf())))
            } {
                if ((strlen currentModule) > 0) {
                    parentM = moduleScope
                }
            }
        }
        currentModule = (m.homeModuleOf())
        this.bcGrowTo((needTop + mArgc))
        def ai:int 0
        while (ai < mArgc) {
            def sIdx:int ((mFnPos + 1) + ai)
            def tA:int (itemAt bcTags sIdx)
            set bcTags (needTop + ai) tA
            if (tA == 0) {
                set bcStack (needTop + ai) (itemAt bcStack sIdx)
            } {
                set bcNums (needTop + ai) (itemAt bcNums sIdx)
            }
            ai = (ai + 1)
        }
        bcSp = needTop
        callDepth = (callDepth + 1)
        this.runBytecode(prM mArgc (unwrap parentM) obj)
        callDepth = (callDepth - 1)
        currentModule = savedModuleM
        scriptDidReturn = savedDidReturnM
        scriptReturnValue = savedReturnValueM
        if scriptThrew {
            return 1
        }
        if scriptDidReturn {
            scriptDidReturn = false
        }
        set bcTags mFnPos bcRetTag
        if (bcRetTag == 0) {
            def rrM:EvHandle bcRetRef
            set bcStack mFnPos rrM
        } {
            set bcNums mFnPos bcRetNum
        }
        return 0
    }

    ; D-ATTRS: for-in visits ENUMERABLE properties only, never the
    ; engine's internal bookkeeping keys, and it walks the PROTOTYPE
    ; CHAIN -- a property put on Boolean.prototype shows up in a for-in
    ; over a Boolean object. A name already seen nearer the object
    ; shadows the inherited one, whether or not the nearer one was
    ; enumerable. Snapshotted at loop entry; shared by the walker and
    ; the bytecode tier.
    fn forInKeyList:[string] (target:EvHandle) {
        def theKeys:[string]
        ; D-PROXY: for-in over a proxy asks the ownKeys trap, which objectKeys
        ; already routes; the chain walk below would read the proxy's own
        ; (empty) map instead.
        if (this.isProxyValue(target)) {
            return (this.objectKeys(target))
        }
        def seenKeys:[string:boolean]
        def walkIn:EvHandle target
        def inSteps:int 0
        while (inSteps < 16) {
            def rawKeys:[string] (this.objectEnumerableKeys(walkIn))
            def ki:int 0
            while (ki < (array_length rawKeys)) {
                def rk:string (itemAt rawKeys ki)
                if (false == (this.isHiddenInstanceKey(rk))) {
                    if (false == (has seenKeys rk)) {
                        set seenKeys rk true
                        push theKeys rk
                    }
                }
                ki = (ki + 1)
            }
            ; A non-enumerable own property still shadows an inherited one.
            def shadow:[string] (this.objectKeys(walkIn))
            def si2:int 0
            while (si2 < (array_length shadow)) {
                set seenKeys (itemAt shadow si2) true
                si2 = (si2 + 1)
            }
            def nextIn:EvHandle (this.protoOfValue(walkIn))
            if (nextIn.isNull()) {
                inSteps = 16
            } {
                walkIn = nextIn
                inSteps = (inSteps + 1)
            }
        }
        return theKeys
    }
    ; Normalise any iterable to a list of per-iteration values: array/Set
    ; elements as-is, Map entries as [key, value] pairs, string chars.
    ; itemsOf copies, so the list is a snapshot on every kind. Shared by
    ; ---- Generators --------------------------------------------------------
    ; HOW THIS WORKS, AND WHAT IT COSTS. A tree-walking interpreter has no way
    ; to suspend a C++/Rust call frame mid-body, so a generator cannot be
    ; resumed at the yield. Instead the body is run to completion at CALL time
    ; and every `yield` appends to a buffer; the object handed back iterates
    ; that buffer.
    ;
    ; Correct for: for-of, spread, Array.from, manual next() over a finite
    ; generator, yield* delegation, and the value sequence in all of those.
    ;
    ; NOT correct for: two-way next(v) -- a yield always evaluates to undefined;
    ; interleaving of the body's side effects with consumption -- they all
    ; happen at the call; and early termination -- `break` in a for-of does not
    ; stop a body that has already run. An unbounded generator hits genLimit
    ; and throws a RangeError naming the reason rather than hanging.
    ;
    ; These are real limits, so they fail LOUDLY where they can and are named
    ; here rather than discovered.
    fn generatorItemsOf:[EvHandle] (v:EvHandle) {
        def items:[EvHandle]
        def cur:EvHandle (v.getMember("__genidx__"))
        def buf:EvHandle (v.getMember("__genitems__"))
        if (buf.isArrayValue()) {
            def k:int (to_int (cur.numberOf()))
            while (k < (buf.denseLen())) {
                push items (buf.arrayItemAt(k))
                k = (k + 1)
            }
        }
        return items
    }
    ; D-GENRESUME: does a `yield` occur anywhere under this node? A nested
    ; function body has its own generator-ness and is opaque here, so the walk
    ; stops at one. Memoised on the node: the answer is syntactic and never
    ; changes, and the resumable driver asks it about every subtree it meets.
    fn nodeHasYield:boolean (node:TSNode) {
        if node.yieldScanned {
            return node.yieldInside
        }
        node.yieldScanned = true
        node.yieldInside = false
        def k:int (this.nodeKindOf(node))
        ; D-ASYNC: an `await` suspends the body the same way a `yield` does, so
        ; the same spine has to be decomposed into frames for it.
        if ((k == 26) || (k == 50)) {
            node.yieldInside = true
            return true
        }
        ; A nested function/arrow/class carries its own yields, not this one's.
        if ((k == 17) || ((k == 18) || ((k == 40) || ((k == 24) || (k == 25))))) {
            return false
        }
        def found:boolean false
        def ci:int 0
        while (ci < (array_length node.children)) {
            if (this.nodeHasYield((itemAt node.children ci))) { found = true }
            ci = (ci + 1)
        }
        if node.left {
            if (this.nodeHasYield((unwrap node.left))) { found = true }
        }
        if node.right {
            if (this.nodeHasYield((unwrap node.right))) { found = true }
        }
        if node.init {
            if (this.nodeHasYield((unwrap node.init))) { found = true }
        }
        if node.body {
            if (this.nodeHasYield((unwrap node.body))) { found = true }
        }
        if node.test {
            if (this.nodeHasYield((unwrap node.test))) { found = true }
        }
        if node.consequent {
            if (this.nodeHasYield((unwrap node.consequent))) { found = true }
        }
        if node.alternate {
            if (this.nodeHasYield((unwrap node.alternate))) { found = true }
        }
        node.yieldInside = found
        return found
    }

    ; ======================================================================
    ; D-GENRESUME: resumable generators
    ;
    ; The body runs on the explicit frame stack in GenState rather than on the
    ; host stack, so it can stop at a `yield` and start again there. Only the
    ; SPINE of nodes leading to a yield is decomposed into frames; every subtree
    ; with no yield in it is handed straight to the ordinary walker, so the
    ; fast path stays the fast path and a generator pays for laziness only at
    ; the points where it is actually lazy.
    ; ======================================================================

    ; Is every node on this subtree's yield spine one the driver can step? A
    ; subtree with no yield is trivially fine -- the walker runs it whole. This
    ; is what lets the resumable path be adopted incrementally: a body whose
    ; spine uses a form not listed here keeps the old eager behaviour instead of
    ; running wrongly.
    fn genSpineOk:boolean (node:TSNode) {
        if (false == (this.nodeHasYield(node))) {
            return true
        }
        def k:int (this.nodeKindOf(node))
        ; --- expressions ---
        if ((k == 26) || (k == 50)) {
            if node.left { return (this.genSpineOk((unwrap node.left))) }
            return true
        }
        if (k == 23) {
            if node.left { return (this.genSpineOk((unwrap node.left))) }
            return true
        }
        if (k == 12) {
            if node.left { return (this.genSpineOk((unwrap node.left))) }
            return false
        }
        if (k == 5) {
            def bOk:boolean true
            if node.left {
                if (false == (this.genSpineOk((unwrap node.left)))) { bOk = false }
            }
            if node.right {
                if (false == (this.genSpineOk((unwrap node.right)))) { bOk = false }
            }
            return bOk
        }
        if (k == 6) {
            ; The TARGET is resolved by the walker, so a yield inside it (a
            ; computed member key) is not steppable here.
            if node.left {
                if (this.nodeHasYield((unwrap node.left))) { return false }
            }
            if node.right { return (this.genSpineOk((unwrap node.right))) }
            return true
        }
        if (k == 13) {
            def cOk:boolean true
            if node.test {
                if (false == (this.genSpineOk((unwrap node.test)))) { cOk = false }
            }
            if node.consequent {
                if (false == (this.genSpineOk((unwrap node.consequent)))) { cOk = false }
            }
            if node.alternate {
                if (false == (this.genSpineOk((unwrap node.alternate)))) { cOk = false }
            }
            return cOk
        }
        if ((k == 19) || (k == 14)) {
            return (this.genChildrenSpineOk(node))
        }
        if (k == 4) {
            ; A CALL is not stepped at all. The comment here used to say the
            ; arguments were -- they never were: no step function handles kind
            ; 4, so the frame was popped without pushing a result and
            ; `console.log(await f())` answered undefined. Silently.
            ;
            ; Refusing it puts the body back on the eager path, which gets the
            ; VALUE right (`c8`/`ca` probes) but runs straight through instead
            ; of suspending, so the interleaving against other microtasks is
            ; wrong. That is the trade this file's incremental-adoption rule
            ; already makes everywhere else, and it beats a wrong answer.
            ; Stepping the call properly is the fix; it needs the callee
            ; resolution the walker owns, which is why it is not done here.
            return false
        }
        ; --- statements ---
        if (k == 30) {
            if node.left { return (this.genSpineOk((unwrap node.left))) }
            return true
        }
        if (k == 31) {
            def di:int 0
            while (di < (array_length node.children)) {
                def d:TSNode (itemAt node.children di)
                if (this.nodeHasYield(d)) {
                    ; a destructuring target with a yield in its initialiser is
                    ; not stepped: the pattern binder is a single walker call
                    if d.left { return false }
                    if d.init {
                        if (false == (this.genSpineOk((unwrap d.init)))) { return false }
                    }
                }
                di = (di + 1)
            }
            return true
        }
        if (k == 34) {
            return (this.genChildrenSpineOk(node))
        }
        if (k == 35) {
            if node.left { return (this.genSpineOk((unwrap node.left))) }
            return true
        }
        if (k == 45) {
            if node.left { return (this.genSpineOk((unwrap node.left))) }
            return true
        }
        if (k == 32) {
            def iOk:boolean true
            if node.left {
                if (false == (this.genSpineOk((unwrap node.left)))) { iOk = false }
            }
            if node.body {
                if (false == (this.genSpineOk((unwrap node.body)))) { iOk = false }
            }
            if node.right {
                if (false == (this.genSpineOk((unwrap node.right)))) { iOk = false }
            }
            return iOk
        }
        if ((k == 36) || (k == 43)) {
            def wOk:boolean true
            if node.left {
                if (false == (this.genSpineOk((unwrap node.left)))) { wOk = false }
            }
            if node.body {
                if (false == (this.genSpineOk((unwrap node.body)))) { wOk = false }
            }
            return wOk
        }
        if (k == 33) {
            ; The init and update clauses run whole through the walker; a yield
            ; in either is not stepped.
            if node.init {
                if (this.nodeHasYield((unwrap node.init))) { return false }
            }
            if node.right {
                if (this.nodeHasYield((unwrap node.right))) { return false }
            }
            def fOk:boolean true
            if node.left {
                if (false == (this.genSpineOk((unwrap node.left)))) { fOk = false }
            }
            if node.body {
                if (false == (this.genSpineOk((unwrap node.body)))) { fOk = false }
            }
            return fOk
        }
        if (k == 37) {
            ; The SOURCE is drained by the walker; the body is stepped.
            if node.right {
                if (this.nodeHasYield((unwrap node.right))) { return false }
            }
            if node.body { return (this.genSpineOk((unwrap node.body))) }
            return true
        }
        if (k == 46) {
            def tOk:boolean true
            if node.body {
                if (false == (this.genSpineOk((unwrap node.body)))) { tOk = false }
            }
            if node.left {
                def cc:TSNode (unwrap node.left)
                if cc.body {
                    if (false == (this.genSpineOk((unwrap cc.body)))) { tOk = false }
                }
            }
            if node.right {
                if (false == (this.genSpineOk((unwrap node.right)))) { tOk = false }
            }
            return tOk
        }
        return false
    }

    fn genChildrenSpineOk:boolean (node:TSNode) {
        def i:int 0
        while (i < (array_length node.children)) {
            if (false == (this.genSpineOk((itemAt node.children i)))) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; ---- frame and operand stack primitives ----

    fn genPushFrame:void (st:GenState node:TSNode ctx:EvalContext) {
        ; As in genPushOp: the index is read into a local so the reuse branch
        ; does not read and write the same cell in one expression.
        def fslot:int st.fTop
        if (fslot == (array_length st.fNode)) {
            push st.fNode node
            push st.fPhase 0
            push st.fIdx 0
            push st.fVal (EvValueBridge.taggedUndefined())
            push st.fCtx ctx
            push st.fBrk false
            push st.fCnt false
            push st.fVal2 (EvValueBridge.taggedUndefined())
            push st.fFlags 0
        } {
            set st.fNode fslot node
            set st.fPhase fslot 0
            set st.fIdx fslot 0
            set st.fVal fslot (EvValueBridge.taggedUndefined())
            set st.fCtx fslot ctx
            set st.fBrk fslot false
            set st.fCnt fslot false
            set st.fVal2 fslot (EvValueBridge.taggedUndefined())
            set st.fFlags fslot 0
        }
        st.fTop = (fslot + 1)
    }

    fn genPopFrame:void (st:GenState) {
        if (st.fTop > 0) {
            st.fTop = (st.fTop - 1)
        }
    }

    fn genPushOp:void (st:GenState v:EvHandle) {
        ; The index goes into a local first: `set st.opStack st.opTop v` reads
        ; and writes the same cell in one expression, which is a double borrow
        ; on the Rust target. It only ever took the grow branch before, so the
        ; reuse branch was never exercised until an async body started reusing
        ; the operand stack across suspensions.
        def slot:int st.opTop
        if (slot == (array_length st.opStack)) {
            push st.opStack v
        } {
            set st.opStack slot v
        }
        st.opTop = (slot + 1)
    }

    fn genPopOp:EvHandle (st:GenState) {
        if (st.opTop == 0) {
            return (EvValueBridge.taggedUndefined())
        }
        st.opTop = (st.opTop - 1)
        return (itemAt st.opStack st.opTop)
    }

    ; Push a SUB-EXPRESSION. One frame if it contains a yield, one walker call
    ; if it does not -- the expression-level twin of genRunBranch, and the other
    ; half of why a generator only pays for the parts of it that are lazy.
    fn genPushExpr:void (st:GenState node:TSNode ctx:EvalContext) {
        if (this.nodeHasYield(node)) {
            this.genPushFrame(st node ctx)
        } {
            this.genPushOp(st (this.evaluateExpr(node)))
        }
    }

    ; Run a branch or loop body: one frame if it contains a yield, one walker
    ; call if it does not. This single line is the whole performance story --
    ; a yield-free body is executed exactly as it would be in a plain function.
    fn genRunBranch:void (st:GenState stmt:TSNode ctx:EvalContext) {
        if (this.nodeHasYield(stmt)) {
            this.genPushFrame(st stmt ctx)
        } {
            this.runBlockOrStatement(stmt)
        }
    }

    ; Walk down to the nearest try frame that can take a pending exception.
    ; Frames above it are abandoned -- which is exactly what unwinding is.
    fn genUnwindToHandler:boolean (st:GenState) {
        def i:int (st.fTop - 1)
        while (i >= 0) {
            def fnode:TSNode (itemAt st.fNode i)
            if ((this.nodeKindOf(fnode)) == 46) {
                def fp:int (itemAt st.fPhase i)
                ; inside the TRY block: the catch clause takes it, or -- with no
                ; catch clause -- only the finally is left to run
                if ((fp == 1) || (fp == 3)) {
                    st.fTop = (i + 1)
                    st.opTop = 0
                    ; The handler frame TAKES the exception: leaving it live
                    ; would make the driver unwind past this same frame again
                    ; on the very next step.
                    def caught:EvHandle scriptThrowValue
                    scriptThrew = false
                    scriptThrowValue = (EvValueBridge.taggedNull())
                    set st.fVal2 i caught
                    ; A catch clause takes it -- unless the throw came from
                    ; INSIDE that catch (fp 3), in which case only the finally
                    ; is left and the exception carries on past it.
                    def toCatch:boolean false
                    if (fp == 1) {
                        if fnode.left { toCatch = true }
                    }
                    if toCatch {
                        set st.fPhase i 2
                    } {
                        set st.fFlags i 2
                        set st.fPhase i 7
                    }
                    return true
                }
            }
            i = (i - 1)
        }
        return false
    }

    fn genEndLoop:void (st:GenState top:int) {
        def noLabels:[string]
        this.settleLoopAbrupt(noLabels (itemAt st.fBrk top) (itemAt st.fCnt top))
        this.genPopFrame(st)
    }

    fn genStepValue:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- await ----------------
        ; The same three phases as a plain yield -- evaluate the operand,
        ; suspend, take the sent value as this expression's result -- with two
        ; differences. There is no delegation (`await*` does not exist), and
        ; there is no return mode: only the driver resumes an async body, and
        ; it resumes with a value or with a throw, never with a return.
        if (k == 50) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                }
                return 0
            }
            if (ph == 1) {
                def av:EvHandle (EvValueBridge.taggedUndefined())
                if node.left { av = (this.genPopOp(st)) }
                set st.fPhase top 2
                genYieldValue = av
                genYieldRaw = true
                return 1
            }
            ; Resumed by the driver: the settled value, or the rejection as a
            ; throw at this point in the body, so an ordinary try/catch around
            ; the await catches it.
            def sv2:EvHandle (EvValueBridge.taggedUndefined())
            if st.sent { sv2 = (unwrap st.sent) }
            if (st.resumeMode == 2) {
                scriptThrowValue = sv2
                scriptThrew = true
                return 0
            }
            this.genPushOp(st sv2)
            this.genPopFrame(st)
            return 0
        }
        ; ---------------- yield ----------------
        if (k == 26) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                }
                return 0
            }
            if (ph == 1) {
                def yv:EvHandle (EvValueBridge.taggedUndefined())
                if node.left { yv = (this.genPopOp(st)) }
                if node.delegate {
                    ; `yield* xs` hands out the operand's items ONE AT A
                    ; TIME, each its own suspension.
                    ; A built-in sequence has no guest-visible protocol to
                    ; observe, so it keeps the list form -- one call instead of
                    ; one guest `next` per element.
                    def plainSeq:boolean false
                    if (yv.isArrayValue()) { plainSeq = true }
                    if (yv.isString()) { plainSeq = true }
                    if (yv.isMap()) { plainSeq = true }
                    if (yv.isSet()) { plainSeq = true }
                    if plainSeq {
                        set st.fFlags top 0
                        def sub:[EvHandle] (this.forOfItemList(yv))
                        if scriptThrew { return 0 }
                        set st.fVal top (EvValueBridge.taggedArray(sub))
                        set st.fIdx top 0
                        set st.fPhase top 4
                        return 0
                    }
                    ; Everything else delegates through the ITERATOR PROTOCOL:
                    ; the operand's iterator is obtained once, then stepped one
                    ; element at a time with whatever the caller sends.
                    def dIter:EvHandle (this.delegateIteratorOf(yv))
                    if scriptThrew { return 0 }
                    if (false == (this.isDescriptorObject(dIter))) {
                        def _di:EvHandle (this.throwSpecError("TypeError" ((this.typeofTag(yv)) + " is not iterable")))
                        return 0
                    }
                    set st.fFlags top 1
                    set st.fVal top dIter
                    set st.fVal2 top (EvValueBridge.taggedUndefined())
                    set st.fPhase top 4
                    return 0
                }
                set st.fPhase top 2
                genYieldValue = yv
                return 1
            }
            if (ph == 2) {
                ; Resumed. What next()/return()/throw() sent IS this
                ; expression's value -- or an abrupt completion of the body.
                def sv:EvHandle (EvValueBridge.taggedUndefined())
                if st.sent { sv = (unwrap st.sent) }
                if (st.resumeMode == 1) {
                    ; `gen.return(v)` is a RETURN COMPLETION at this yield, not
                    ; an abandonment: the frames unwind normally so any
                    ; enclosing `finally` still runs -- and can even yield
                    ; again, which suspends the return.
                    scriptReturnValue = sv
                    scriptDidReturn = true
                    this.genPopFrame(st)
                    return 0
                }
                if (st.resumeMode == 2) {
                    scriptThrowValue = sv
                    scriptThrew = true
                    return 0
                }
                this.genPushOp(st sv)
                this.genPopFrame(st)
                return 0
            }
            ; ph 4/5: the delegation loop
            if (ph == 4) {
                def dIt:EvHandle (itemAt st.fVal top)
                if ((itemAt st.fFlags top) == 0) {
                    ; list form: hand out the elements one at a time
                    def dI:int (itemAt st.fIdx top)
                    if (dI >= (dIt.denseLen())) {
                        this.genPushOp(st (EvValueBridge.taggedUndefined()))
                        this.genPopFrame(st)
                        return 0
                    }
                    set st.fIdx top (dI + 1)
                    set st.fPhase top 5
                    genYieldValue = (dIt.arrayItemAt(dI))
                    return 1
                }
                def dNext:EvHandle (this.iteratorMethodOf(dIt "next"))
                if scriptThrew { return 0 }
                if (false == (dNext.isFunction())) {
                    def _dn:EvHandle (this.throwSpecError("TypeError" "the iterator's next is not a function"))
                    return 0
                }
                def dRes:EvHandle (this.iteratorInvoke(dIt dNext (itemAt st.fVal2 top)))
                if scriptThrew { return 0 }
                if (false == (this.isDescriptorObject(dRes))) {
                    def _dr:EvHandle (this.throwSpecError("TypeError" "iterator result is not an object"))
                    return 0
                }
                def dDone:EvHandle (dRes.getMember("done"))
                if scriptThrew { return 0 }
                if (dDone.toBool()) {
                    ; `yield* it` evaluates to the value the delegate RETURNED.
                    def dVal:EvHandle (dRes.getMember("value"))
                    if scriptThrew { return 0 }
                    this.genPushOp(st dVal)
                    this.genPopFrame(st)
                    return 0
                }
                set st.fPhase top 5
                genYieldValue = dRes
                genYieldRaw = true
                return 1
            }
            def dsv:EvHandle (EvValueBridge.taggedUndefined())
            if st.sent { dsv = (unwrap st.sent) }
            def dIt2:EvHandle (itemAt st.fVal top)
            if ((itemAt st.fFlags top) == 0) {
                if (st.resumeMode == 1) {
                    scriptReturnValue = dsv
                    scriptDidReturn = true
                    this.genPopFrame(st)
                    return 0
                }
                if (st.resumeMode == 2) {
                    scriptThrowValue = dsv
                    scriptThrew = true
                    return 0
                }
                set st.fPhase top 4
                return 0
            }
            if (st.resumeMode == 1) {
                ; A return completion is offered to the DELEGATE first: it may
                ; have a `return` method to run its own cleanup, and what that
                ; answers decides whether the delegation ends here.
                def rFn:EvHandle (this.iteratorMethodOf(dIt2 "return"))
                if scriptThrew { return 0 }
                if (rFn.isFunction()) {
                    def rRes:EvHandle (this.iteratorInvoke(dIt2 rFn dsv))
                    if scriptThrew { return 0 }
                    if (false == (this.isDescriptorObject(rRes))) {
                        def _rr:EvHandle (this.throwSpecError("TypeError" "iterator result is not an object"))
                        return 0
                    }
                    def rDone:EvHandle (rRes.getMember("done"))
                    if scriptThrew { return 0 }
                    def rVal:EvHandle (rRes.getMember("value"))
                    if scriptThrew { return 0 }
                    if (false == (rDone.toBool())) {
                        ; the delegate is not finished: keep delegating
                        set st.fPhase top 5
                        genYieldValue = rRes
                        genYieldRaw = true
                        return 1
                    }
                    scriptReturnValue = rVal
                    scriptDidReturn = true
                    this.genPopFrame(st)
                    return 0
                }
                scriptReturnValue = dsv
                scriptDidReturn = true
                this.genPopFrame(st)
                return 0
            }
            if (st.resumeMode == 2) {
                ; An exception is offered to the delegate's `throw`. A delegate
                ; with none is CLOSED first and then the protocol violation is
                ; reported -- the exception never reaches it.
                def tFn:EvHandle (this.iteratorMethodOf(dIt2 "throw"))
                if scriptThrew { return 0 }
                if (tFn.isFunction()) {
                    def tRes:EvHandle (this.iteratorInvoke(dIt2 tFn dsv))
                    if scriptThrew { return 0 }
                    if (false == (this.isDescriptorObject(tRes))) {
                        def _tr:EvHandle (this.throwSpecError("TypeError" "iterator result is not an object"))
                        return 0
                    }
                    def tDone:EvHandle (tRes.getMember("done"))
                    if scriptThrew { return 0 }
                    def tVal:EvHandle (tRes.getMember("value"))
                    if scriptThrew { return 0 }
                    if (tDone.toBool()) {
                        this.genPushOp(st tVal)
                        this.genPopFrame(st)
                        return 0
                    }
                    set st.fPhase top 5
                    genYieldValue = tRes
                    genYieldRaw = true
                    return 1
                }
                def cFn:EvHandle (this.iteratorMethodOf(dIt2 "return"))
                if (cFn.isFunction()) {
                    def _cc:EvHandle (this.iteratorInvoke(dIt2 cFn (EvValueBridge.taggedUndefined())))
                    if scriptThrew { return 0 }
                }
                def _tv:EvHandle (this.throwSpecError("TypeError" "the iterator does not provide a throw method"))
                return 0
            }
            ; The value the caller sent is forwarded INTO the delegate on its
            ; next step, which is what makes `yield* inner()` transparent to a
            ; two-way conversation.
            set st.fVal2 top dsv
            set st.fPhase top 4
            return 0
        }

        ; ---------------- parenthesised ----------------
        if (k == 23) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- assignment ----------------
        if (k == 6) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.right {
                    this.genPushExpr(st (unwrap node.right) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            def av:EvHandle (this.genPopOp(st))
            genAssignPrimed = true
            genAssignValue = av
            def ares:EvHandle (this.evaluateAssignValue(node))
            genAssignPrimed = false
            this.genPushOp(st ares)
            this.genPopFrame(st)
            return 0
        }

        return 9
    }

    fn genStepOper:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- binary ----------------
        if (k == 5) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            if (ph == 1) {
                def blv:EvHandle (this.genPopOp(st))
                ; The short-circuit operators decide on the LEFT operand
                ; alone, which is the whole reason they are stepped here
                ; rather than handed to applyBinaryOp.
                def bop:int (this.opKindOf(node))
                def shorts:boolean false
                if (bop == 34) {
                    if (false == (blv.toBool())) { shorts = true }
                }
                if (bop == 35) {
                    if (blv.toBool()) { shorts = true }
                }
                if (bop == 36) {
                    if (false == ((blv.isNull()) || (blv.isUndefined()))) { shorts = true }
                }
                set st.fVal top blv
                if shorts {
                    this.genPushOp(st (itemAt st.fVal top))
                    this.genPopFrame(st)
                    return 0
                }
                set st.fPhase top 2
                if node.right {
                    this.genPushExpr(st (unwrap node.right) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            def brv:EvHandle (this.genPopOp(st))
            def blv2:EvHandle (itemAt st.fVal top)
            def bopK:int (this.opKindOf(node))
            if ((bopK == 34) || ((bopK == 35) || (bopK == 36))) {
                ; the left operand did not decide, so the right one is the
                ; whole answer
                this.genPushOp(st brv)
            } {
                this.genPushOp(st (this.applyBinaryOp(bopK blv2 brv)))
            }
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- conditional ----------------
        if (k == 13) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.test {
                    this.genPushExpr(st (unwrap node.test) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            if (ph == 1) {
                def tv:EvHandle (this.genPopOp(st))
                set st.fPhase top 2
                if (tv.toBool()) {
                    if node.consequent {
                        this.genPushExpr(st (unwrap node.consequent) curCtx)
                    } {
                        this.genPushOp(st (EvValueBridge.taggedUndefined()))
                    }
                } {
                    if node.alternate {
                        this.genPushExpr(st (unwrap node.alternate) curCtx)
                    } {
                        this.genPushOp(st (EvValueBridge.taggedUndefined()))
                    }
                }
                return 0
            }
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- array literal ----------------
        if (k == 14) {
            if (ph == 0) {
                set st.fPhase top 1
                set st.fIdx top 0
                return 0
            }
            def alN:int (array_length node.children)
            def ali:int (itemAt st.fIdx top)
            if (ali < alN) {
                set st.fIdx top (ali + 1)
                def alEl:TSNode (itemAt node.children ali)
                ; A HOLE contributes undefined and evaluates nothing.
                if ((this.nodeKindOf(alEl)) == 22) {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                } {
                    this.genPushExpr(st alEl curCtx)
                }
                return 0
            }
            ; Every element is finished and sits on the operand stack in order.
            def alVals:[EvHandle]
            def alk:int 0
            while (alk < alN) {
                push alVals (EvValueBridge.taggedUndefined())
                alk = (alk + 1)
            }
            def alr:int (alN - 1)
            while (alr >= 0) {
                set alVals alr (this.genPopOp(st))
                alr = (alr - 1)
            }
            this.genPushOp(st (EvValueBridge.taggedArray(alVals)))
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- sequence ----------------
        if (k == 19) {
            if (ph == 0) {
                set st.fPhase top 1
                set st.fIdx top 0
                if ((array_length node.children) == 0) {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                    this.genPopFrame(st)
                    return 0
                }
                this.genPushExpr(st (itemAt node.children 0) curCtx)
                return 0
            }
            ; The sequence's value is its LAST operand; the others are
            ; evaluated for their effects and dropped.
            def sqv:EvHandle (this.genPopOp(st))
            def sqi:int ((itemAt st.fIdx top) + 1)
            if (sqi < (array_length node.children)) {
                set st.fIdx top sqi
                this.genPushExpr(st (itemAt node.children sqi) curCtx)
                return 0
            }
            this.genPushOp(st sqv)
            this.genPopFrame(st)
            return 0
        }

        return 9
    }

    fn genStepStmt:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- block / statement list ----------------
        if (k == 34) {
            if (ph == 0) {
                set st.fPhase top 1
                ; D-LEXSCOPE: a block is a scope only when it declares one.
                if (this.blockDeclaresLexical(node)) {
                    def bctx:EvalContext (curCtx.createChild())
                    bctx.isBlockScope = true
                    set st.fCtx top bctx
                    context = (itemAt st.fCtx top)
                }
                this.hoistFunctionDeclarations(node.children)
                return 0
            }
            if (scriptDidReturn || (loopBreak || loopContinue)) {
                this.genPopFrame(st)
                return 0
            }
            def bi:int (itemAt st.fIdx top)
            if (bi >= (array_length node.children)) {
                this.genPopFrame(st)
                return 0
            }
            set st.fIdx top (bi + 1)
            def bstmt:TSNode (itemAt node.children bi)
            if (this.nodeHasYield(bstmt)) {
                this.genPushFrame(st bstmt curCtx)
            } {
                this.runStatementValue(bstmt)
            }
            return 0
        }

        ; ---------------- expression statement ----------------
        if (k == 30) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            def _ev:EvHandle (this.genPopOp(st))
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- variable declaration ----------------
        if (k == 31) {
            def vi:int (itemAt st.fIdx top)
            if (ph == 2) {
                ; the initialiser's value is waiting on the operand stack
                def dv:EvHandle (this.genPopOp(st))
                def dcl2:TSNode (itemAt node.children vi)
                if dcl2.init {
                    if (this.isAnonymousFnDefNode((unwrap dcl2.init))) {
                        this.nameAnonymousValue(dv dcl2.name)
                    }
                }
                this.bindDeclaredName(node dcl2.name dv)
                set st.fIdx top (vi + 1)
                set st.fPhase top 1
                return 0
            }
            if (vi >= (array_length node.children)) {
                this.genPopFrame(st)
                return 0
            }
            def dcl:TSNode (itemAt node.children vi)
            def stepInit:boolean false
            if dcl.init {
                if (this.nodeHasYield((unwrap dcl.init))) {
                    if (null? dcl.left) { stepInit = true }
                }
            }
            if stepInit {
                set st.fPhase top 2
                this.genPushExpr(st (unwrap dcl.init) curCtx)
            } {
                this.processOneDeclarator(node dcl)
                set st.fIdx top (vi + 1)
                set st.fPhase top 1
            }
            return 0
        }

        return 9
    }

    fn genStepStmt2:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- return ----------------
        if (k == 35) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                }
                return 0
            }
            def rv:EvHandle (EvValueBridge.taggedUndefined())
            if node.left { rv = (this.genPopOp(st)) }
            scriptReturnValue = rv
            scriptDidReturn = true
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- throw ----------------
        if (k == 45) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                }
                return 0
            }
            def thv:EvHandle (EvValueBridge.taggedUndefined())
            if node.left { thv = (this.genPopOp(st)) }
            scriptThrowValue = thv
            scriptThrew = true
            this.genPopFrame(st)
            return 0
        }

        ; ---------------- if ----------------
        if (k == 32) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedUndefined()))
                }
                return 0
            }
            if (ph == 1) {
                def cv:EvHandle (this.genPopOp(st))
                set st.fPhase top 2
                if (cv.toBool()) {
                    if node.body { this.genRunBranch(st (unwrap node.body) curCtx) }
                } {
                    if node.right { this.genRunBranch(st (unwrap node.right) curCtx) }
                }
                return 0
            }
            this.genPopFrame(st)
            return 0
        }

        return 9
    }

    fn genStepTry:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- try / catch / finally ----------------
        if (k == 46) {
            if (ph == 0) {
                set st.fPhase top 1
                if node.body { this.genRunBranch(st (unwrap node.body) curCtx) }
                return 0
            }
            if (ph == 1) {
                ; the try block ended without throwing
                set st.fPhase top 4
                return 0
            }
            if (ph == 2) {
                ; an exception reached this frame's try block: the catch clause
                ; binds it in a scope of its own, holding the PARAMETER and
                ; nothing else (§12.14). The unwind already took the exception,
                ; so the value is waiting in fVal2.
                def thrown:EvHandle (itemAt st.fVal2 top)
                set st.fPhase top 3
                if node.left {
                    def cc:TSNode (unwrap node.left)
                    def catchCtx:EvalContext (curCtx.createChild())
                    catchCtx.isBlockScope = true
                    if ((strlen cc.name) > 0) {
                        catchCtx.define(cc.name thrown)
                    }
                    context = catchCtx
                    if cc.body { this.genRunBranch(st (unwrap cc.body) catchCtx) }
                }
                return 0
            }
            if (ph == 3) {
                set st.fPhase top 4
                return 0
            }
            if (ph == 4) {
                if (null? node.right) {
                    this.genPopFrame(st)
                    return 0
                }
                ; D-FINALLY: the finally block runs whatever the try/catch did.
                ; The pending completion -- a return, a break, a continue -- is
                ; set aside for its duration and restored afterwards, unless the
                ; finally produces one of its own, which per spec replaces it.
                def fl:int 0
                if scriptDidReturn { fl = (fl + 1) }
                if scriptThrew { fl = (fl + 2) }
                if loopBreak { fl = (fl + 4) }
                if loopContinue { fl = (fl + 8) }
                set st.fFlags top fl
                def pendVal:EvHandle (EvValueBridge.taggedUndefined())
                if scriptThrew {
                    pendVal = scriptThrowValue
                } {
                    pendVal = scriptReturnValue
                }
                set st.fVal2 top pendVal
                scriptDidReturn = false
                scriptReturnValue = (EvValueBridge.taggedNull())
                scriptThrew = false
                scriptThrowValue = (EvValueBridge.taggedNull())
                loopBreak = false
                loopContinue = false
                set st.fPhase top 5
                this.genRunBranch(st (unwrap node.right) curCtx)
                return 0
            }
            if (ph == 7) {
                ; Reached with an exception already set aside in fVal2: run the
                ; finally, then let it carry on outward.
                if (null? node.right) {
                    scriptThrowValue = (itemAt st.fVal2 top)
                    scriptThrew = true
                    this.genPopFrame(st)
                    return 0
                }
                set st.fPhase top 5
                this.genRunBranch(st (unwrap node.right) curCtx)
                return 0
            }
            ; ph 5: the finally is done
            def fabrupt:boolean false
            if scriptDidReturn { fabrupt = true }
            if scriptThrew { fabrupt = true }
            if loopBreak { fabrupt = true }
            if loopContinue { fabrupt = true }
            if (false == fabrupt) {
                def pf:int (itemAt st.fFlags top)
                if ((bit_and pf 1) != 0) {
                    scriptReturnValue = (itemAt st.fVal2 top)
                    scriptDidReturn = true
                }
                if ((bit_and pf 2) != 0) {
                    scriptThrowValue = (itemAt st.fVal2 top)
                    scriptThrew = true
                }
                if ((bit_and pf 4) != 0) { loopBreak = true }
                if ((bit_and pf 8) != 0) { loopContinue = true }
            }
            this.genPopFrame(st)
            return 0
        }
        return 9
    }

    fn genStepLoop:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- while ----------------
        if (k == 36) {
            if (ph == 0) {
                set st.fBrk top loopBreak
                set st.fCnt top loopContinue
                loopBreak = false
                loopContinue = false
                set st.fPhase top 1
                return 0
            }
            if (ph == 1) {
                set st.fPhase top 2
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedBoolean(true)))
                }
                return 0
            }
            if (ph == 2) {
                def wtv:EvHandle (this.genPopOp(st))
                if (false == (wtv.toBool())) {
                    this.genEndLoop(st top)
                    return 0
                }
                loopContinue = false
                set st.fPhase top 3
                if node.body { this.genRunBranch(st (unwrap node.body) curCtx) }
                return 0
            }
            if (scriptDidReturn || loopBreak) {
                this.genEndLoop(st top)
                return 0
            }
            set st.fPhase top 1
            return 0
        }

        ; ---------------- do-while ----------------
        if (k == 43) {
            if (ph == 0) {
                set st.fBrk top loopBreak
                set st.fCnt top loopContinue
                loopBreak = false
                loopContinue = false
                set st.fPhase top 1
                return 0
            }
            if (ph == 1) {
                loopContinue = false
                set st.fPhase top 2
                if node.body { this.genRunBranch(st (unwrap node.body) curCtx) }
                return 0
            }
            if (ph == 2) {
                if (scriptDidReturn || loopBreak) {
                    this.genEndLoop(st top)
                    return 0
                }
                set st.fPhase top 3
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedBoolean(false)))
                }
                return 0
            }
            def dtv:EvHandle (this.genPopOp(st))
            if (dtv.toBool()) {
                set st.fPhase top 1
            } {
                this.genEndLoop(st top)
            }
            return 0
        }

        return 9
    }

    fn genStepFor:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- for ----------------
        if (k == 33) {
            if (ph == 0) {
                set st.fBrk top loopBreak
                set st.fCnt top loopContinue
                loopBreak = false
                loopContinue = false
                set st.fFlags top 0
                if node.init {
                    def initN:TSNode (unwrap node.init)
                    if ((this.nodeKindOf(initN)) == 31) {
                        ; D-LEXSCOPE: `for (let i = ...)` gives each ITERATION
                        ; its own binding, which is what makes a closure created
                        ; in the body keep that turn's value.
                        def lexNames:[string] (this.forLoopLexNames(initN))
                        if ((array_length lexNames) > 0) {
                            set st.fFlags top 1
                            def loopCtx:EvalContext (curCtx.createChild())
                            loopCtx.isBlockScope = true
                            context = loopCtx
                            this.processVariableDeclaration(initN)
                            def firstCtx:EvalContext (this.copyLoopBindings(curCtx lexNames))
                            set st.fCtx top firstCtx
                            context = (itemAt st.fCtx top)
                        } {
                            this.processVariableDeclaration(initN)
                        }
                    } {
                        def _fi:EvHandle (this.evaluateExpr(initN))
                    }
                }
                set st.fPhase top 1
                return 0
            }
            if (ph == 1) {
                set st.fPhase top 2
                if node.left {
                    this.genPushExpr(st (unwrap node.left) curCtx)
                } {
                    this.genPushOp(st (EvValueBridge.taggedBoolean(true)))
                }
                return 0
            }
            if (ph == 2) {
                def ftv:EvHandle (this.genPopOp(st))
                if (false == (ftv.toBool())) {
                    this.genEndLoop(st top)
                    return 0
                }
                loopContinue = false
                set st.fPhase top 3
                if node.body { this.genRunBranch(st (unwrap node.body) curCtx) }
                return 0
            }
            if (scriptDidReturn || loopBreak) {
                this.genEndLoop(st top)
                return 0
            }
            ; The per-iteration environment is created BETWEEN the body and the
            ; increment, so a closure made in the body keeps this turn's value
            ; and the increment writes the next one.
            if ((itemAt st.fFlags top) == 1) {
                if node.init {
                    def initL:TSNode (unwrap node.init)
                    def lexN:[string] (this.forLoopLexNames(initL))
                    def cur:EvalContext (itemAt st.fCtx top)
                    if cur.parent {
                        def outerC:EvalContext (unwrap cur.parent)
                        def nextCtx:EvalContext (this.copyLoopBindings(outerC lexN))
                        set st.fCtx top nextCtx
                        context = (itemAt st.fCtx top)
                    }
                }
            }
            if node.right {
                this.evaluateUpdateExpr((unwrap node.right))
            }
            set st.fPhase top 1
            return 0
        }

        return 9
    }

    fn genStepForOf:int (st:GenState top:int node:TSNode ph:int k:int curCtx:EvalContext) {
        ; ---------------- for-of ----------------
        if (k == 37) {
            if (ph == 0) {
                set st.fBrk top loopBreak
                set st.fCnt top loopContinue
                loopBreak = false
                loopContinue = false
                def srcV:EvHandle (EvValueBridge.taggedUndefined())
                if node.right { srcV = (this.evaluateExpr((unwrap node.right))) }
                if scriptThrew {
                    this.genEndLoop(st top)
                    return 0
                }
                ; A GENERATOR source is stepped one element at a time -- fFlags
                ; 1 marks that mode and fVal holds the generator itself. Every
                ; other source is normalised to a list in one call, which is
                ; faster for the array/string/map/set cases that make up nearly
                ; all of them.
                if (this.isResumableGenerator(srcV)) {
                    set st.fFlags top 1
                    set st.fVal top srcV
                    set st.fIdx top 0
                    set st.fPhase top 1
                    return 0
                }
                def oItems:[EvHandle] (this.forOfItemList(srcV))
                if scriptThrew {
                    this.genEndLoop(st top)
                    return 0
                }
                set st.fFlags top 0
                set st.fVal top (EvValueBridge.taggedArray(oItems))
                set st.fIdx top 0
                set st.fPhase top 1
                return 0
            }
            if (ph == 1) {
                def oArr:EvHandle (itemAt st.fVal top)
                def oElem:EvHandle (EvValueBridge.taggedUndefined())
                if ((itemAt st.fFlags top) == 1) {
                    ; stepped source: pull exactly one element. A pending
                    ; `continue` is this loop's and is consumed before the step,
                    ; or it travels into the generator's body.
                    loopContinue = false
                    def stepR:EvHandle (this.genCursorStep(oArr))
                    if scriptThrew {
                        this.genEndLoop(st top)
                        return 0
                    }
                    if ((stepR.getMember("done")).toBool()) {
                        this.genEndLoop(st top)
                        return 0
                    }
                    oElem = (stepR.getMember("value"))
                } {
                    def oi:int (itemAt st.fIdx top)
                    if (oi >= (oArr.denseLen())) {
                        this.genEndLoop(st top)
                        return 0
                    }
                    set st.fIdx top (oi + 1)
                    oElem = (oArr.arrayItemAt(oi))
                }
                ; D-ASYNC: `for await (x of xs)` awaits every element before
                ; binding it. Without this the loop ran but handed the body the
                ; PROMISE, so `for await (var v of [Promise.resolve(1), 2])`
                ; concatenated "[object Promise]2".
                if node.await {
                    oElem = (this.awaitBlocking(oElem))
                    if scriptThrew {
                        this.genEndLoop(st top)
                        return 0
                    }
                }
                this.bindForOfTarget(node oElem)
                if scriptThrew {
                    this.genEndLoop(st top)
                    return 0
                }
                loopContinue = false
                set st.fPhase top 2
                ; a `let` target just put a per-iteration scope in place;
                ; the body belongs to THAT, not to the loop's own scope
                def turnCtx@(optional):EvalContext context
                if node.body { this.genRunBranch(st (unwrap node.body) (unwrap turnCtx)) }
                return 0
            }
            if (scriptDidReturn || loopBreak) {
                this.genEndLoop(st top)
                return 0
            }
            set st.fPhase top 1
            return 0
        }

        return 9
    }

    ; Step the body until it yields, returns, or runs out.
    ;   0 = ran to completion   1 = suspended at a yield   2 = threw
    ;
    ; The dispatch is split across four step functions purely so no single one
    ; is enormous; each answers 9 for a node kind that is not its own.
    fn genRun:int (st:GenState) {
        while (st.fTop > 0) {
            if scriptThrew {
                ; A `try` on the yield spine is a frame, so an exception looks
                ; for one to land in before it ends the generator. A try WITHOUT
                ; a yield inside it never gets here -- it runs whole in the
                ; walker and catches there as it always did.
                if (this.genUnwindToHandler(st)) {
                    continue
                }
                st.fTop = 0
                st.opTop = 0
                return 2
            }
            def top:int (st.fTop - 1)
            def node:TSNode (itemAt st.fNode top)
            def ph:int (itemAt st.fPhase top)
            context = (itemAt st.fCtx top)
            ; a bound, non-optional handle on the current scope: child frames
            ; are pushed against it, and a step that swaps `context` (a block
            ; scope, a per-iteration binding) rebinds it before pushing
            def curCtx@(optional):EvalContext context
            def k:int (this.nodeKindOf(node))
            def r:int (this.genStepValue(st top node ph k (unwrap curCtx)))
            if (r == 9) {
                r = (this.genStepOper(st top node ph k (unwrap curCtx)))
            }
            if (r == 9) {
                r = (this.genStepStmt(st top node ph k (unwrap curCtx)))
            }
            if (r == 9) {
                r = (this.genStepStmt2(st top node ph k (unwrap curCtx)))
            }
            if (r == 9) {
                r = (this.genStepLoop(st top node ph k (unwrap curCtx)))
            }
            if (r == 9) {
                r = (this.genStepFor(st top node ph k (unwrap curCtx)))
            }
            if (r == 9) {
                r = (this.genStepForOf(st top node ph k (unwrap curCtx)))
            }
            if (r == 9) {
                r = (this.genStepTry(st top node ph k (unwrap curCtx)))
            }
            if (r == 1) {
                return 1
            }
            if (r == 9) {
                ; Nothing else reaches here: genSpineOk refused the body
                ; otherwise.
                this.genPopFrame(st)
            }
        }
        return 0
    }

    ; The names a `for (let i = ...)` head declares -- the ones each iteration
    ; gets its own copy of.
    fn forLoopLexNames:[string] (initN:TSNode) {
        def names:[string]
        if ((this.nodeKindOf(initN)) != 31) { return names }
        if ((initN.kind != "let") && (initN.kind != "const")) { return names }
        def i:int 0
        while (i < (array_length initN.children)) {
            def d:TSNode (itemAt initN.children i)
            if ((strlen d.name) > 0) {
                push names d.name
            }
            i = (i + 1)
        }
        return names
    }

    ; ---- yield* over an arbitrary iterator ----
    ;
    ; §14.4.14 delegates through the ITERATOR PROTOCOL, not through a list: it
    ; calls next/return/throw on the delegate one step at a time and forwards
    ; whatever the caller sent. Draining the operand first would run it to
    ; completion before the first element came out, and would never forward
    ; anything at all.

    ; GetIterator: the iterator object a value delegates to, or undefined when
    ; it is not iterable (the caller raises the TypeError).
    fn delegateIteratorOf:EvHandle (src:EvHandle) {
        if (this.isResumableGenerator(src)) {
            ; a generator is its own iterator
            return src
        }
        if (false == (this.isDescriptorObject(src))) {
            return (EvValueBridge.taggedUndefined())
        }
        def itFn:EvHandle (this.getPropertyValue(src "@@iterator"))
        if scriptThrew { return (EvValueBridge.taggedUndefined()) }
        if (false == (itFn.isFunction())) {
            return (EvValueBridge.taggedUndefined())
        }
        def noArgs:[EvHandle]
        def it:EvHandle (this.callFnValueWithValues((itFn.withThisForCall(src)) noArgs))
        if scriptThrew { return (EvValueBridge.taggedUndefined()) }
        return it
    }

    fn iteratorMethodOf:EvHandle (iter:EvHandle name:string) {
        if (false == (this.isDescriptorObject(iter))) {
            return (EvValueBridge.taggedUndefined())
        }
        return (this.getPropertyValue(iter name))
    }

    ; Call next/return/throw on the delegate with ONE argument, as the spec
    ; does -- the fixtures check `arguments.length` is 1.
    fn iteratorInvoke:EvHandle (iter:EvHandle fn:EvHandle arg:EvHandle) {
        def args:[EvHandle]
        push args arg
        return (this.callFnValueWithValues((fn.withThisForCall(iter)) args))
    }

    ; D-GENRESUME: a lazy source has to stay lazy on the CONSUMING side too.
    ; Draining a generator into a list before the loop starts defeats the point
    ; of suspending it -- `for (x of naturals()) { ...; break }` would never
    ; reach its own break -- so a generator source is stepped one element at a
    ; time instead. Everything else keeps the list form, which is faster for the
    ; array/string/map/set cases that make up nearly all of them.
    fn genCursorStep:EvHandle (gv:EvHandle) {
        ; D-ASYNCGEN: an ASYNC generator has to be driven past every `await` in
        ; its body before it reaches the yield this step is asking for. Resuming
        ; it raw answers the awaited VALUE instead of an iteration result, so
        ; the loop read `.done` off a number (undefined, so falsy) and `.value`
        ; off it too (undefined) -- `for await (v of h())` over a body
        ; containing `yield await 5` produced empty elements and a phantom turn.
        if (this.isAsyncGeneratorValue(gv)) {
            def agP:EvHandle (this.asyncGenStep(gv 0 (EvValueBridge.taggedUndefined())))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            ; Settled here rather than suspended: this is the same trade the
            ; element-await two frames up already makes -- the values are right,
            ; the interleaving against unrelated microtasks is not guaranteed.
            return (this.awaitBlocking(agP))
        }
        return (this.genResume(gv (EvValueBridge.taggedUndefined()) 0))
    }

    ; IteratorClose: a loop that leaves early tells the generator so, which is
    ; what runs its `finally` blocks.
    fn genCursorClose:void (gv:EvHandle) {
        def st:GenState (this.genStateOf(gv))
        if (st.status == 3) { return }
        ; Same rule as the guest-iterator close: the completion that caused it
        ; is set aside, or it travels into the generator's own finally blocks
        ; and stops them on entry.
        def savedBrkG:boolean loopBreak
        def savedCntG:boolean loopContinue
        def savedRetG:boolean scriptDidReturn
        def savedRetVG:EvHandle scriptReturnValue
        loopBreak = false
        loopContinue = false
        scriptDidReturn = false
        def _c:EvHandle (this.genResume(gv (EvValueBridge.taggedUndefined()) 1))
        loopBreak = savedBrkG
        loopContinue = savedCntG
        scriptDidReturn = savedRetG
        scriptReturnValue = savedRetVG
    }

    ; Bind one turn of a for-of loop's target, creating the per-iteration scope
    ; a `let` target needs. Split out of runForOfStatementValue so the resumable
    ; driver, which owns the loop itself, binds by the same rules.
    fn bindForOfTarget:void (stmt:TSNode item:EvHandle) {
        if (null? stmt.left) { return }
        def leftNode:TSNode (unwrap stmt.left)
        if ((this.nodeKindOf(leftNode)) == 31) {
            ; D-LEXSCOPE: `for (let v of xs)` binds v FRESH on every turn, so a
            ; closure made in the body keeps that turn's element.
            if ((leftNode.kind == "let") || (leftNode.kind == "const")) {
                def turnCtx:EvalContext (context.createChild())
                turnCtx.isBlockScope = true
                context = turnCtx
            }
            if ((array_length leftNode.children) > 0) {
                def decl:TSNode (itemAt leftNode.children 0)
                if decl.left {
                    this.bindPattern((unwrap decl.left) item)
                } {
                    context.define(decl.name item)
                }
            }
            return
        }
        this.assignToTarget(leftNode item)
    }

    ; ---- the generator object, and the resume protocol ----

    fn isResumableGenerator:boolean (v:EvHandle) {
        if (false == (v.isObject())) { return false }
        return (v.hasOwnData("__genstate__"))
    }

    ; The state a generator object stands for. A value that is not one answers
    ; the parked state, which reports itself completed and so does nothing.
    fn genStateOf:GenState (v:EvHandle) {
        def idH:EvHandle (v.getOwnData("__genstate__"))
        def idx:int (to_int (idH.toNumber()))
        if (idx < 0) { return (this.genDeadState()) }
        if (idx >= (array_length genStates)) { return (this.genDeadState()) }
        return (itemAt genStates idx)
    }

    fn genDeadState:GenState () {
        if (genDead == 0) {
            def dead:GenState (new GenState())
            dead.status = 3
            push genStates dead
            genDead = ((array_length genStates) - 1)
        }
        return (itemAt genStates genDead)
    }

    ; May this body run on the resumable driver? A generator whose yield spine
    ; uses a form the driver cannot step keeps the old eager behaviour instead
    ; of running wrongly -- which is what makes this safe to adopt one form at
    ; a time.
    fn genBodyResumable:boolean (fnNode:TSNode) {
        if (null? fnNode.body) { return false }
        def b:TSNode (unwrap fnNode.body)
        if ((this.nodeKindOf(b)) != 34) { return false }
        return (this.genChildrenSpineOk(b))
    }

    ; %GeneratorPrototype%. The three resume methods are properties of THIS
    ; object, shared by every generator, rather than own properties minted per
    ; generator -- which is what makes `Object.getPrototypeOf(g).next` be the
    ; one function the suite compares identities against.
    fn generatorPrototype:EvHandle () {
        if genProto {
            return (unwrap genProto)
        }
        def keysG:[string]
        def valsG:[EvHandle]
        def p:EvHandle (EvValueBridge.taggedObject(keysG valsG))
        p.setProto((this.builtinPrototype("Object")))
        p.setMember("next" (this.sharedNativeMethod("Generator" "next")))
        p.setAttrs("next" true false true)
        p.setMember("return" (this.sharedNativeMethod("Generator" "return")))
        p.setAttrs("return" true false true)
        p.setMember("throw" (this.sharedNativeMethod("Generator" "throw")))
        p.setAttrs("throw" true false true)
        p.setMember("@@iterator" (this.sharedNativeMethod("Generator" "@@iterator")))
        p.setAttrs("@@iterator" true false true)
        p.setMember("@@toStringTag" (EvValueBridge.taggedString("Generator")))
        p.setAttrs("@@toStringTag" false false true)
        ; The memo is taken only once the object is FULLY built. Stored before
        ; the members were on it, the second generator ever made inherited an
        ; empty prototype and had no `next` at all.
        genProto = p
        return (unwrap genProto)
    }

    ; D-ASYNCGEN: %AsyncGeneratorPrototype%, which is a DIFFERENT object from
    ; %GeneratorPrototype% rather than the same one wearing a second name. The
    ; brand lives here, not on the instance -- `Object.getOwnPropertyDescriptor
    ; (g(), Symbol.toStringTag)` is undefined in a real engine too -- and so
    ; does Symbol.asyncIterator, which is what `for await` looks for and what
    ; tells a consumer to await each result.
    fn asyncGeneratorPrototype:EvHandle () {
        if asyncGenProto {
            return (unwrap asyncGenProto)
        }
        def keysA:[string]
        def valsA:[EvHandle]
        def ap:EvHandle (EvValueBridge.taggedObject(keysA valsA))
        ap.setProto((this.builtinPrototype("Object")))
        ap.setMember("next" (this.sharedNativeMethod("Generator" "next")))
        ap.setAttrs("next" true false true)
        ap.setMember("return" (this.sharedNativeMethod("Generator" "return")))
        ap.setAttrs("return" true false true)
        ap.setMember("throw" (this.sharedNativeMethod("Generator" "throw")))
        ap.setAttrs("throw" true false true)
        ; An async generator is its own ASYNC iterator. It is deliberately NOT
        ; a sync one: `for (x of asyncGen())` is a TypeError in a real engine,
        ; and publishing Symbol.iterator here would make it silently iterate
        ; promises instead.
        ap.setMember("@@asyncIterator" (this.sharedNativeMethod("Generator" "@@asyncIterator")))
        ap.setAttrs("@@asyncIterator" true false true)
        ap.setMember("@@toStringTag" (EvValueBridge.taggedString("AsyncGenerator")))
        ap.setAttrs("@@toStringTag" false false true)
        asyncGenProto = ap
        return (unwrap asyncGenProto)
    }

    ; Build the generator object for a call that has NOT run its body: the
    ; activation stays live in the state, and the first next() starts it.
    fn makeResumableGenerator:EvHandle (fnNode:TSNode ctx:EvalContext) {
        return (this.makeResumableGeneratorOn(fnNode ctx (EvValueBridge.taggedUndefined())))
    }

    ; `protoV` is the generator FUNCTION's own `prototype` object, which is what
    ; the generator object inherits from -- `Object.getPrototypeOf(g())` is
    ; `g.prototype`, not %GeneratorPrototype% directly. That object in turn
    ; inherits from %GeneratorPrototype%, which is where next/return/throw live.
    fn makeResumableGeneratorOn:EvHandle (fnNode:TSNode ctx:EvalContext protoV:EvHandle) {
        def st:GenState (new GenState())
        st.rootCtx = ctx
        st.fnNode = fnNode
        st.status = 0
        st.strict = strictMode
        push genStates st
        def gid:int ((array_length genStates) - 1)

        def keys:[string]
        def vals:[EvHandle]
        def g:EvHandle (EvValueBridge.taggedObject(keys vals))
        g.setMember("__genstate__" (EvHandle.fromInt(gid)))
        g.setAttrs("__genstate__" false false false)
        ; next/return/throw are INHERITED from %GeneratorPrototype%, reached
        ; through the function's own `prototype` object when it has one.
        def gProtoUse:EvHandle (this.generatorPrototype())
        if fnNode.async {
            gProtoUse = (this.asyncGeneratorPrototype())
        }
        if (this.isDescriptorObject(protoV)) {
            if (false == (this.isSymbolValue(protoV))) {
                ; the function's prototype object sits BETWEEN the generator and
                ; %GeneratorPrototype%
                protoV.setProto(gProtoUse)
                gProtoUse = protoV
            }
        }
        g.setProto(gProtoUse)
        ; D-ASYNCGEN: an async generator's OBJECT is an async iterator, not a
        ; sync one. The marker is what makes next/return/throw answer promises
        ; and what brands it; both move together, because branding it
        ; AsyncGenerator while next() answered a plain result would send
        ; detecting code down a path that does not work.
        if fnNode.async {
            g.setMember("__asyncgen__" (EvValueBridge.taggedBoolean(true)))
            g.setAttrs("__asyncgen__" false false false)
        }
        return g
    }

    ; `{ value: v, done: d }` -- the shape every resume answers with.
    fn genResultObject:EvHandle (value:EvHandle done:boolean) {
        def keys:[string]
        def vals:[EvHandle]
        push keys "value"
        push vals value
        push keys "done"
        push vals (EvValueBridge.taggedBoolean(done))
        def r:EvHandle (EvValueBridge.taggedObject(keys vals))
        r.setProto((this.builtinPrototype("Object")))
        return r
    }

    ; Resume a suspended body. `mode` is 0 next, 1 return, 2 throw.
    fn genResume:EvHandle (gv:EvHandle sent:EvHandle mode:int) {
        def st:GenState (this.genStateOf(gv))
        ; A generator already finished -- or one being resumed from inside its
        ; own body -- produces nothing.
        if (st.status == 2) {
            return (this.throwSpecError("TypeError" "Generator is already running"))
        }
        if (st.status == 3) {
            if (mode == 2) {
                scriptThrowValue = sent
                scriptThrew = true
                return (EvValueBridge.taggedUndefined())
            }
            def dv:EvHandle (EvValueBridge.taggedUndefined())
            if (mode == 1) { dv = sent }
            return (this.genResultObject(dv true))
        }
        ; return()/throw() on a body that has not started never runs it.
        if (st.status == 0) {
            if (mode == 1) {
                st.status = 3
                return (this.genResultObject(sent true))
            }
            if (mode == 2) {
                st.status = 3
                scriptThrowValue = sent
                scriptThrew = true
                return (EvValueBridge.taggedUndefined())
            }
        }

        def savedContext:EvalContext context
        def savedDidReturn:boolean scriptDidReturn
        def savedReturnValue:EvHandle scriptReturnValue
        def savedStrict:boolean strictMode
        scriptDidReturn = false
        scriptReturnValue = (EvValueBridge.taggedUndefined())
        strictMode = st.strict
        st.sent = sent
        st.resumeMode = mode

        if (st.status == 0) {
            ; First resume: the body's frame goes on, already past its own
            ; scope/hoist setup, so the block frame does not give it a second
            ; scope of its own.
            def bodyN:TSNode (unwrap st.fnNode)
            def bodyB:TSNode (unwrap bodyN.body)
            this.hoistVarNamesMemo(bodyB)
            this.hoistFunctionDeclarations(bodyB.children)
            this.genPushFrame(st bodyB (unwrap st.rootCtx))
            set st.fPhase 0 1
        }
        st.status = 2
        def outcome:int (this.genRun(st))
        st.status = 1
        if (outcome == 1) {
            def yv:EvHandle genYieldValue
            def raw:boolean genYieldRaw
            ; Which suspension this was, kept for the caller. An async
            ; generator's driver has to tell an `await` (keep going -- the body
            ; has not produced anything yet) from a `yield` (stop -- that IS
            ; what next() answers), and the flag is cleared here.
            genLastSuspendRaw = raw
            genYieldRaw = false
            context = savedContext
            scriptDidReturn = savedDidReturn
            scriptReturnValue = savedReturnValue
            strictMode = savedStrict
            if raw {
                return yv
            }
            return (this.genResultObject(yv false))
        }
        ; Completed or threw: the activation is finished either way.
        st.status = 3
        st.fTop = 0
        st.opTop = 0
        def rv:EvHandle (EvValueBridge.taggedUndefined())
        if scriptDidReturn { rv = scriptReturnValue }
        def threw:boolean scriptThrew
        context = savedContext
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        strictMode = savedStrict
        if threw {
            return (EvValueBridge.taggedUndefined())
        }
        return (this.genResultObject(rv true))
    }


    ; ======================================================================
    ; D-ASYNC: async functions
    ;
    ; An async function is a body that can stop in the middle and start again,
    ; which is the same problem generators solve -- so it runs on the same
    ; explicit frame stack, with `await` as the suspension point instead of
    ; `yield`. What sits on top is the driver: the call returns a PROMISE
    ; immediately, and every time the body suspends the driver subscribes to
    ; the awaited value and resumes the body when it settles.
    ;
    ; Before this, `async` and `await` parsed and were then ignored: an async
    ; function ran to completion synchronously and returned its value RAW, so
    ; `f().then(...)` was "then is not a function" and `await p` evaluated to
    ; null. Anything treating an async function as returning a thenable -- which
    ; is all of them -- was broken.
    ; ======================================================================

    ; §27.7.5.1 AsyncFunctionStart. The activation is already prepared by the
    ; ordinary call path; this turns it into a suspended body, starts it, and
    ; hands back the promise.
    ;
    ; An async call ALWAYS answers a promise, including when the driver cannot
    ; step the body's spine. Making the promise conditional on that was the
    ; first shape of this and it was the wrong one: a body the driver declined
    ; ran synchronously and returned its value raw, so whether `f()` was
    ; thenable depended on what the function happened to contain.
    fn callAsyncBody:EvHandle (fnNode:TSNode ctx:EvalContext) {
        def cap:EvHandle (this.newPromiseCapability((this.builtinGlobalObject("Promise"))))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (this.genBodyResumable(fnNode)) {
            def gv:EvHandle (this.makeResumableGenerator(fnNode ctx))
            this.asyncDrive(gv cap 0 (EvValueBridge.taggedUndefined()))
            return (this.capPromiseOf(cap))
        }
        ; Fallback: run it here and settle the promise with the outcome. The
        ; awaits inside take the blocking path above.
        def savedDidR:boolean scriptDidReturn
        def savedRetV:EvHandle scriptReturnValue
        scriptDidReturn = false
        scriptReturnValue = (EvValueBridge.taggedUndefined())
        def res:EvHandle (EvValueBridge.taggedUndefined())
        if fnNode.body {
            def fb:TSNode (unwrap fnNode.body)
            if ((this.nodeKindOf(fb)) == 34) {
                res = (this.callResultOf((this.evaluateFunctionBodyValue(fb))))
            } {
                res = (this.evaluateExpr(fb))
            }
        }
        def threw:boolean scriptThrew
        def thrownV:EvHandle scriptThrowValue
        scriptThrew = false
        scriptThrowValue = (EvValueBridge.taggedUndefined())
        scriptDidReturn = savedDidR
        scriptReturnValue = savedRetV
        if threw {
            def _rjf:EvHandle (this.capInvoke(cap "__cap_reject__" thrownV))
        } {
            def _rsf:EvHandle (this.capInvoke(cap "__cap_resolve__" res))
        }
        return (this.capPromiseOf(cap))
    }

    ; Settle `v` by running the microtask queue until it has, then answer its
    ; value -- or throw its rejection here. Only the fallback path uses this.
    fn awaitBlocking:EvHandle (v:EvHandle) {
        def p:EvHandle (this.promiseResolveIntrinsic(v))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        def guard:int 0
        while (guard < 1000000) {
            def stv:int (this.toIntegerOf((p.getMember("__pstate__"))))
            if (stv != 0) {
                def pv:EvHandle (p.getMember("__pvalue__"))
                if (stv == 2) {
                    scriptThrowValue = pv
                    scriptThrew = true
                    return (EvValueBridge.taggedUndefined())
                }
                return pv
            }
            if (jobHead >= (array_length jobHandler)) {
                ; Nothing left to run and still pending: this await can never
                ; complete. Answering undefined would be a lie, so it is an
                ; error the guest can see.
                return (this.throwSpecError("TypeError" "await would never settle: the promise is pending and no jobs remain"))
            }
            this.drainJobs()
            guard = (guard + 1)
        }
        return (EvValueBridge.taggedUndefined())
    }

    ; One step of an async body: resume it, then look at where it stopped.
    ;
    ;   threw      -> reject the promise
    ;   completed  -> resolve it with the returned value
    ;   suspended  -> subscribe to the awaited value and come back
    ;
    ; The subscription goes through Promise.resolve().then() rather than
    ; inspecting the value, so awaiting a THENABLE works: a guest object with a
    ; `then` method is adopted exactly as the spec says, and awaiting a plain
    ; value still yields to the job queue for one turn rather than continuing
    ; synchronously.
    fn asyncDrive:void (gv:EvHandle cap:EvHandle mode:int sent:EvHandle) {
        def out:EvHandle (this.genResume(gv sent mode))
        if scriptThrew {
            def err:EvHandle scriptThrowValue
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedUndefined())
            def _rj:EvHandle (this.capInvoke(cap "__cap_reject__" err))
            return
        }
        def st:GenState (this.genStateOf(gv))
        if (st.status == 3) {
            ; genResume answers {value, done} on completion.
            def rv:EvHandle (out.getMember("value"))
            def _rs:EvHandle (this.capInvoke(cap "__cap_resolve__" rv))
            return
        }
        ; Suspended at an await. genYieldRaw made the resume answer the awaited
        ; value itself rather than an iterator result.
        def inner:EvHandle (this.promiseResolveIntrinsic(out))
        if scriptThrew {
            def err2:EvHandle scriptThrowValue
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedUndefined())
            def _rj2:EvHandle (this.capInvoke(cap "__cap_reject__" err2))
            return
        }
        def keys:[string]
        def vals:[EvHandle]
        def rec:EvHandle (EvValueBridge.taggedObject(keys vals))
        rec.setMember("__async_gen__" gv)
        rec.setMember("__async_cap__" cap)
        def onOk:EvHandle ((EvValueBridge.taggedNativeMethod("asyncstep" "ok")).withThisForCall(rec))
        def onErr:EvHandle ((EvValueBridge.taggedNativeMethod("asyncstep" "err")).withThisForCall(rec))
        this.shapeAnonFn(onOk 1)
        this.shapeAnonFn(onErr 1)
        def _t:EvHandle (this.promiseThenVia(inner onOk onErr))
        if scriptThrew {
            def err3:EvHandle scriptThrowValue
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedUndefined())
            def _rj3:EvHandle (this.capInvoke(cap "__cap_reject__" err3))
        }
    }

    ; ======================================================================
    ; D-ASYNCGEN: async generators
    ;
    ; `async function*` is both of the suspension mechanisms at once, and the
    ; engine already had each separately: the frame stack stops at a `yield`
    ; for a generator, and the async driver resolves what a body stopped on at
    ; an `await`. What was missing is the composition, so an async generator ran
    ; on the plain generator path and every `await` in its body corrupted the
    ; output -- `yield await 5` produced an empty value and a phantom element.
    ;
    ; next() is a PROMISE for an iteration result. Driving it means resuming
    ; until the body reaches a yield: an await-suspension subscribes and
    ; resumes again, a yield-suspension IS the answer, and completion answers
    ; `{value, done: true}`. That is the only difference from asyncDrive, which
    ; runs to completion because a plain async body has nothing to stop at.
    ; ======================================================================
    fn asyncGenDrive:void (gv:EvHandle cap:EvHandle mode:int sent:EvHandle) {
        def out:EvHandle (this.genResume(gv sent mode))
        if scriptThrew {
            def agErr:EvHandle scriptThrowValue
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedUndefined())
            def _agrj:EvHandle (this.capInvoke(cap "__cap_reject__" agErr))
            return
        }
        def st:GenState (this.genStateOf(gv))
        if (st.status == 3) {
            ; Finished. genResume already shaped the completion as an iteration
            ; result, so it is the answer as it stands.
            def _agrs:EvHandle (this.capInvoke(cap "__cap_resolve__" out))
            return
        }
        if (false == genLastSuspendRaw) {
            ; Suspended at a YIELD -- this is what next() was asked for.
            def _agry:EvHandle (this.capInvoke(cap "__cap_resolve__" out))
            return
        }
        ; Suspended at an AWAIT. Nothing has been produced yet: settle what the
        ; body is waiting on and carry on driving toward a yield.
        def agInner:EvHandle (this.promiseResolveIntrinsic(out))
        if scriptThrew {
            def agErr2:EvHandle scriptThrowValue
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedUndefined())
            def _agrj2:EvHandle (this.capInvoke(cap "__cap_reject__" agErr2))
            return
        }
        def agKeys:[string]
        def agVals:[EvHandle]
        def agRec:EvHandle (EvValueBridge.taggedObject(agKeys agVals))
        agRec.setMember("__agen__" gv)
        agRec.setMember("__agen_cap__" cap)
        def agOk:EvHandle ((EvValueBridge.taggedNativeMethod("asyncgenstep" "ok")).withThisForCall(agRec))
        def agErrF:EvHandle ((EvValueBridge.taggedNativeMethod("asyncgenstep" "err")).withThisForCall(agRec))
        this.shapeAnonFn(agOk 1)
        this.shapeAnonFn(agErrF 1)
        def _agt:EvHandle (this.promiseThenVia(agInner agOk agErrF))
        if scriptThrew {
            def agErr3:EvHandle scriptThrowValue
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedUndefined())
            def _agrj3:EvHandle (this.capInvoke(cap "__cap_reject__" agErr3))
        }
    }

    ; next()/return()/throw() on an async generator: a promise, driven as above.
    fn asyncGenStep:EvHandle (gv:EvHandle mode:int sent:EvHandle) {
        def agCap:EvHandle (this.newPromiseCapability((this.builtinGlobalObject("Promise"))))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        this.asyncGenDrive(gv agCap mode sent)
        return (this.capPromiseOf(agCap))
    }

    ; `new Map(iterable)` / `new Set(iterable)` from an already-evaluated
    ; initialiser. Any iterable is accepted, not only an array literal, because
    ; forOfItemList is what the spec's "iterate it" means here.
    fn constructCollectionValue:EvHandle (name:string init:EvHandle) {
        def isMapKind:boolean (name == "Map")
        def coll:EvHandle (EvValueBridge.taggedSetEmpty())
        if isMapKind {
            coll = (EvValueBridge.taggedMapEmpty())
        }
        if (init.isUndefined()) { return coll }
        if (init.isNull()) { return coll }
        def entries:[EvHandle] (this.forOfItemList(init))
        if scriptThrew {
            return coll
        }
        def ci:int 0
        while (ci < (array_length entries)) {
            def entry:EvHandle (itemAt entries ci)
            if isMapKind {
                ; Each entry is a [key, value] pair; anything else contributes
                ; nothing rather than half an entry.
                if (entry.isArrayValue()) {
                    coll.mapSet((entry.getIndex(0)) (entry.getIndex(1)))
                }
            } {
                coll.setAdd(entry)
            }
            ci = (ci + 1)
        }
        return coll
    }

    ; §23.1.2.1 Array.from, over already-evaluated values. It used to live
    ; inline in the identifier-call path, reading AST argument nodes -- so it
    ; was reachable only by writing the literal name `Array`, and
    ; `class L extends Array {}` had no `L.from` at all even though
    ; Object.getPrototypeOf(L) is Array. One implementation, both doors.
    fn arrayFromValues:EvHandle (srcV:EvHandle mapFn:EvHandle) {
        def frItems:[EvHandle]
        if (srcV.isArrayValue()) {
            def fi:int 0
            while (fi < (srcV.denseLen())) {
                push frItems (srcV.arrayItemAt(fi))
                fi = (fi + 1)
            }
        }
        if (srcV.isString()) {
            ; D-UTF8: Array.from over a string ITERATES it, so the elements are
            ; whole code points -- the same walk forOfItemList does.
            def fCps:[int] (this.codePointsOf((srcV.stringOf())))
            def fsn:int (array_length fCps)
            def fsi:int 0
            while (fsi < fsn) {
                push frItems (EvValueBridge.taggedString((this.cuFromCodePoint((itemAt fCps fsi)))))
                fsi = (fsi + 1)
            }
        }
        if (srcV.isSet()) {
            def stI:int 0
            while (stI < (srcV.denseLen())) {
                push frItems (srcV.arrayItemAt(stI))
                stI = (stI + 1)
            }
        }
        ; A generator (or anything else for-of walks and the three cases above
        ; miss) goes through the shared list, so Array.from and for-of cannot
        ; disagree.
        if (this.isGeneratorValue(srcV)) {
            def gi2:[EvHandle] (this.forOfItemList(srcV))
            def gk2:int 0
            while (gk2 < (array_length gi2)) {
                push frItems (itemAt gi2 gk2)
                gk2 = (gk2 + 1)
            }
        } {
            ; D-ITERATOR: everything else is ITERABLE first and ARRAY-LIKE
            ; second. Both used to answer an empty array.
            if (false == (srcV.isArrayValue())) {
                if (false == (srcV.isString())) {
                    if (false == (srcV.isSet())) {
                        if (this.isDescriptorObject(srcV)) {
                            def itF:EvHandle (this.getPropertyValue(srcV "@@iterator"))
                            def frSrc:[EvHandle] (this.arrayLikeElements(srcV))
                            if (itF.isFunction()) {
                                frSrc = (this.iteratorProtocolItems(srcV))
                            }
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                            def fk3:int 0
                            while (fk3 < (array_length frSrc)) {
                                push frItems (itemAt frSrc fk3)

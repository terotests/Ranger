        def recvV:EvHandle staticCallReceiver
        if (false == (recvV.isFunction())) {
            return (EvValueBridge.taggedArray(items))
        }
        def recvClass:EvHandle (recvV.getMember("__classname__"))
        if (false == (recvClass.isString())) {
            return (EvValueBridge.taggedArray(items))
        }

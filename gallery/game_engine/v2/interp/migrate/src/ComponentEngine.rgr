                        def savedThrowVC:EvHandle scriptThrowValue
                        def savedBrkC:boolean loopBreak
                        def savedCntC:boolean loopContinue
                        def savedRetC:boolean scriptDidReturn
                        def savedRetVC:EvHandle scriptReturnValue
                        scriptThrew = false
                        loopBreak = false
                        loopContinue = false
                        scriptDidReturn = false
                        def gcRes:EvHandle (this.iteratorInvoke(gIter gRet (EvValueBridge.taggedUndefined())))

        ; PERF: no arguments object was built for this call, so there is nothing
        ; to map -- and `context.has` would otherwise find an ENCLOSING
        ; function's object and map this function's parameters onto it.
        if (false == fnNode.usesArguments) {
            return
        }
        if (this.strictForBody(fnNode)) {
            return
        }
        if (false == (context.has("arguments"))) {
            return
        }
        def argObj2:EvalValue (context.lookup("arguments"))
        if (argObj2.valueType != 5) {
            return
        }
        if (false == (has argObj2.objectMap "__arguments__")) {
            return
        }
        def names:[EvalValue]
        def mp:int 0
        def mappable:int 0
        while (mp < (array_length fnNode.params)) {
            def prm:TSNode (itemAt fnNode.params mp)
            def nm:string ""
            ; A plain parameter is a `Parameter` node with a name; a rest or a
            ; destructured one has no single binding to map onto and is skipped.
            if (prm.nodeType == "Parameter") {
                if (null? prm.left) {
                    nm = prm.name
                }
            }
            if ((this.nodeKindOf(prm)) == 1) {
                nm = prm.name
            }
            if (mp < (array_length argVals)) {
                if ((strlen nm) > 0) {
                    mappable = (mappable + 1)
                }
            } {
                nm = ""
            }
            push names (EvalValue.string(nm))
            mp = (mp + 1)
        }
        if (mappable == 0) {
            return
        }
        def slot:int (array_length argMapScopes)
        def argCell (new ClosureCell)
        argCell.ctx = context
        push argMapScopes argCell
        argObj2.setMember("__argscope__" (EvalValue.fromInt(slot)))
        argObj2.setAttrs("__argscope__" false false false)
        argObj2.setMember("__argnames__" (EvalValue.array(names)))
        argObj2.setAttrs("__argnames__" false false false)
    }

    ; The parameter name index `key` of `obj` is mapped onto, or "" when the
    ; value is not a mapped arguments object or the index is not mapped.
    fn argMapName:string (obj:EvalValue key:string) {
        if (obj.valueType != 5) {
            return ""
        }
        if (false == (has obj.objectMap "__argscope__")) {
            return ""
        }
        def idx:int (this.canonicalArrayIndex(key))
        if (idx < 0) {
            return ""
        }
        ; D-ARGMAP: redefining a mapped index as an ACCESSOR removes the mapping
        ; -- the getter is the property now, and routing the read to the
        ; parameter would shadow it. DELETING it removes the mapping too, which
        ; is why an index absent from the object's own map is unmapped whatever
        ; the parameter still holds.
        if (has obj.getterMap key) {
            return ""
        }
        if (has obj.setterMap key) {
            return ""
        }
        if (false == (has obj.objectMap key)) {
            return ""
        }
        def namesV:EvalValue (unwrap (get obj.objectMap "__argnames__"))
        if (idx >= (array_length namesV.arrayValue)) {
            return ""
        }
        def nmV:EvalValue (itemAt namesV.arrayValue idx)
        if (false == (nmV.isString())) {
            return ""
        }
        return nmV.stringValue
    }

    ; D-ARGMAP: deleting a mapped index breaks the link for good. Re-creating
    ; the key with `arguments[0] = v` used to REVIVE the mapping, so the write
    ; landed on the parameter and the read came back with the parameter's value
    ; instead of the one just stored.
    fn unmapArgIndex:void (obj:EvalValue key:string) {
        if (obj.valueType != 5) {
            return
        }
        if (false == (has obj.objectMap "__argnames__")) {
            return
        }
        def idx:int (this.canonicalArrayIndex(key))
        if (idx < 0) {
            return
        }
        def namesV:EvalValue (unwrap (get obj.objectMap "__argnames__"))
        if (idx >= (array_length namesV.arrayValue)) {
            return
        }
        ; Mutated in place: the names array is stored NON-WRITABLE (it is engine
        ; bookkeeping, not a visible property), so setMember would refuse it.
        namesV.setIndexAt(idx (EvalValue.string("")))
    }

    fn argMapScopeOf:EvalContext (obj:EvalValue) {
        def slotV:EvalValue (unwrap (get obj.objectMap "__argscope__"))
        def cell:ClosureCell (itemAt argMapScopes (to_int (slotV.toNumber())))
        return (unwrap cell.ctx)
    }

    fn bindParamList:void (fnNode:TSNode argVals:[EvalValue]) {
        def np:int (array_length fnNode.params)
        def na:int (array_length argVals)
        def pi:int 0
        while (pi < np) {
            def param:TSNode (itemAt fnNode.params pi)
            def pt:string param.nodeType
            if (pt == "RestElement") {
                def items:[EvalValue]
                def k:int pi
                while (k < na) {
                    push items (itemAt argVals k)
                    k = (k + 1)
                }
                def restArr:EvalValue (EvalValue.array(items))
                if param.left {
                    this.bindPattern((unwrap param.left) restArr)
                } {
                    context.define(param.name restArr)
                }
                return
            }
            ; D-DSTR: `function ({a} = {})` arrives as an AssignmentPattern
            ; wrapping the pattern. bindPattern already applies the default and
            ; recurses; the old else-branch defined a binding named "" instead.
            if (pt == "AssignmentPattern") {
                def av:EvalValue (EvalValue.undefined())
                if (pi < na) {
                    av = (itemAt argVals pi)
                }
                this.bindPattern(param av)
                pi = (pi + 1)
                continue
            }
            if ((pt == "ObjectPattern") || (pt == "ArrayPattern")) {
                def pv:EvalValue (EvalValue.undefined())
                if (pi < na) {
                    pv = (itemAt argVals pi)
                }
                ; D-DSTR: a pattern parameter can carry a default too —
                ; `function ({a = 5} = {})`. The default was only applied to
                ; plain identifier parameters, so calling with no argument
                ; destructured `undefined` and bound nothing.
                if (pv.isUndefined()) {
                    if param.init {
                        pv = (this.evaluateExpr((unwrap param.init)))
                    }
                }
                this.bindPattern(param pv)
            } {
                def v:EvalValue (EvalValue.undefined())
                if (pi < na) {
                    v = (itemAt argVals pi)
                }
                if (v.isUndefined()) {
                    if param.init {
                        v = (this.evaluateExpr((unwrap param.init)))
                    }
                }
                context.define(param.name v)
            }
            pi = (pi + 1)
        }
    }

    ; Call a function/arrow node with already-evaluated argument values, returning
    ; its result. Handles both block bodies and arrow expression bodies. Used by
    ; the array higher-order methods (map/filter/forEach/reduce/find/...).
    fn callFnNodeWithValues:EvalValue (fnNode:TSNode argVals:[EvalValue]) {
        def savedContext:EvalContext context
        def savedDidReturn:boolean scriptDidReturn
        def savedReturnValue:EvalValue scriptReturnValue
        scriptDidReturn = false
        scriptReturnValue = (EvalValue.null())
        context = (context.createChild())
        this.bindParams(fnNode argVals)
        def result:EvalValue (EvalValue.null())
        if fnNode.body {
            def body:TSNode (unwrap fnNode.body)
            if ((this.nodeKindOf(body)) == 34) {
                result = (this.callResultOf((this.evaluateFunctionBodyValue(body))))
            } {
                result = (this.evaluateExpr(body))
            }
        }
        context = savedContext
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        return result
    }

    ; Resolve a callback argument node to a callable function node: an inline
    ; arrow/function expression is used directly; anything else is evaluated and,
    ; if it is a function value, its node is used. Returns an empty node on miss.
    fn resolveCallbackNode:TSNode (argNode:TSNode) {
        if ((this.nodeKindOf(argNode)) == 17) {
            return argNode
        }
        if ((this.nodeKindOf(argNode)) == 18) {
            return argNode
        }
        def v:EvalValue (this.evaluateExpr(argNode))
        if (v.isFunction()) {
            if v.functionNode {
                return (unwrap v.functionNode)
            }
        }
        def empty (new TSNode())
        return empty
    }

    ; --- Lexical closures ---
    ; Wrap a function/arrow node as a value that captures the CURRENT scope, so it
    ; resolves free variables against where it was defined, not where it is called.
    fn captureClosure:EvalValue (fnNode:TSNode) {
        def fv:EvalValue (EvalValue.function(fnNode))
        ; D-STRICT: a function is strict if its own body says so or if the scope
        ; that created it was strict. Recorded here rather than asked at use
        ; time, because by then the defining scope is gone.
        fv.strictFn = (this.strictForBody(fnNode))
        fv.srcText = currentSource
        def id:int (array_length closureScopes)
        def cell (new ClosureCell)
        ; D-FNEXPRNAME: a NAMED function expression binds its own name inside its
        ; own body and nowhere else, so
        ; `var f = function fact(n) { return n * fact(n - 1); }` can recurse
        ; while `fact` stays invisible outside. The name was never bound at all,
        ; so every such recursion was a ReferenceError.
        def capturedCtx:EvalContext context
        if ((this.nodeKindOf(fnNode)) == 18) {
            if ((strlen fnNode.name) > 0) {
                capturedCtx = (context.createChild())
                capturedCtx.define(fnNode.name fv)
            }
        }
        cell.ctx = capturedCtx
        push closureScopes cell
        fv.closureId = id
        ; provenance: the module this function was DEFINED in ("" = entry), so a
        ; call can restore the right module register for bare-name `new`.
        fv.homeModule = currentModule
        return fv
    }

    ; Resolve a callback arg to a function value, capturing a closure for inline
    ; arrow/function expressions. Non-inline args are evaluated (already values).
    fn resolveCallbackValue:EvalValue (argNode:TSNode) {
        if ((this.nodeKindOf(argNode)) == 17) {
            return (this.captureClosure(argNode))
        }
        if ((this.nodeKindOf(argNode)) == 18) {
            return (this.captureClosure(argNode))
        }
        return (this.evaluateExpr(argNode))
    }

    ; Call a function VALUE (which may carry a captured closure and/or bound this)
    ; with already-evaluated args. Parents the call scope on the closure when set.
    ; D-CTORVALUE: the built-in constructor a value stands for, or "" when it is
    ; not one. bind() renames its result "bound X", as the spec says it should,
    ; so the prefix is peeled before the name is recognised -- otherwise
    ; `Number.bind(null)` produced something callable-looking that nothing would
    ; call.
    fn builtinCtorNameOf:string (v:EvalValue) {
        if (v.valueType != 6) {
            return ""
        }
        if v.functionNode {
            return ""
        }
        if ((strlen v.builtinName) > 0) {
            return ""
        }
        def nm:string v.functionName
        def guard:int 0
        while (guard < 8) {
            if ((strlen nm) > 6) {
                if ((substring nm 0 6) == "bound ") {
                    nm = (substring nm 6 (strlen nm))
                    guard = (guard + 1)
                } {
                    guard = 8
                }
            } {
                guard = 8
            }
        }
        if (this.isBuiltinCtorName(nm)) {
            return nm
        }
        if (this.isErrorCtorName(nm)) {
            return nm
        }
        return ""
    }

    ; D-CTORVALUE: a built-in CONSTRUCTOR invoked through a value rather than by
    ; name -- `Number.bind(null)(42)`, `Function.call(null, "return 1")`,
    ; `[].map(Number)`. The direct call sites read the AST, so a captured
    ; constructor was not callable at all and answered a plain object or a
    ; "not a function" TypeError. `asNew` picks the construct form where the two
    ; differ.
    fn callBuiltinCtorValues:EvalValue (name:string args:[EvalValue] asNew:boolean) {
        if (this.isErrorCtorName(name)) {
            def emsg:string ""
            if ((array_length args) > 0) {
                def ev:EvalValue (itemAt args 0)
                if (false == (ev.isUndefined())) {
                    emsg = (this.toStringOf(ev))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                }
            }
            return (this.makeError(name emsg))
        }
        if (name == "Function") {
            return (this.buildFunctionFromValues(args))
        }
        if (name == "Object") {
            def ov:EvalValue (EvalValue.null())
            if ((array_length args) > 0) {
                ov = (itemAt args 0)
            }
            return (this.toObjectValue(ov))
        }
        if (name == "Array") {
            return (this.buildArrayFromValues(args))
        }
        ; D-REGEX: the constructor reached through a VALUE -- `var F =
        ; RegExp.prototype.constructor; new F()`. Without a case here it fell off
        ; the end and answered null, so the result was not a RegExp at all.
        if (name == "RegExp") {
            return (this.buildRegexFromValues(args asNew))
        }
        if (name == "Date") {
            if asNew {
                return (this.makeDateValue(args))
            }
            def dtc (new DateTime())
            return (EvalValue.string((dtc.toFullString((dtc.timeClip((this.realmNowMs())))))))
        }
        if (this.isWrapperCtorName(name)) {
            def prim:EvalValue (EvalValue.null())
            if ((array_length args) > 0) {
                prim = (itemAt args 0)
            }
            if asNew {
                return (this.makeWrapper(name prim))
            }
            ; Called as a FUNCTION a wrapper coerces rather than boxes.
            if (name == "String") {
                if (prim.isNull()) {
                    return (EvalValue.string(""))
                }
                return (EvalValue.string((this.toStringOf(prim))))
            }
            if (name == "Number") {
                if (prim.isNull()) {
                    return (EvalValue.number(0.0))
                }
                return (EvalValue.number((this.toNumberOf(prim))))
            }
            if (name == "Boolean") {
                if (prim.isNull()) {
                    return (EvalValue.boolean(false))
                }
                return (EvalValue.boolean((prim.toBool())))
            }
        }
        return (EvalValue.null())
    }

    ; The value-level twin of buildArrayFromArgs, for a captured `Array`.
    fn buildArrayFromValues:EvalValue (args:[EvalValue]) {
        def items:[EvalValue]
        def n:int (array_length args)
        if (n == 1) {
            def only:EvalValue (itemAt args 0)
            if (only.isNumber()) {
                def rawLen:double (only.toNumber())
                if ((rawLen < 0.0) || (rawLen > 4294967295.0)) {
                    return (this.throwSpecError("RangeError" "Invalid array length"))
                }
                ; Integrality is tested on the DOUBLE. Round-tripping through an
                ; int first wrapped 4294967295 to a negative number, so the one
                ; length at the top of the legal range was rejected as invalid.
                if ((this.floorNum(rawLen)) != rawLen) {
                    return (this.throwSpecError("RangeError" "Invalid array length"))
                }
                def slots:int (to_int rawLen)
                ; D-ARRAYSPARSE: a length past what the dense store can hold is
                ; DECLARED rather than materialised -- `new Array(4294967295)`
                ; is legal and has no elements at all, and raising a RangeError
                ; for it confused "too big to allocate" with "not a length".
                if (slots > 10000000) {
                    def bigArr:EvalValue (EvalValue.array(items))
                    bigArr.declaredLength = slots
                    return bigArr
                }
                def si:int 0
                while (si < slots) {
                    push items (EvalValue.hole())
                    si = (si + 1)
                }
                return (EvalValue.array(items))
            }
            push items only
            return (EvalValue.array(items))
        }
        def i:int 0
        while (i < n) {
            push items (itemAt args i)
            i = (i + 1)
        }
        return (EvalValue.array(items))
    }

    fn callFnValueWithValues:EvalValue (fnValue:EvalValue argVals:[EvalValue]) {
        ; D-REGISTRY: a built-in extracted as a value (`var f = arr.slice`, or
        ; `Array.prototype.slice`) is invoked through the same dispatcher the
        ; direct call uses, so the two paths cannot diverge. Its receiver is
        ; whatever bind/call/apply supplied.
        ; D-STATICS: a static held as a value -- `var f = Object.keys; f(o)`, or
        ; a static passed as a callback. Checked ahead of the method path
        ; because a static carries a builtinName too.
        if (fnValue.isBuiltinStatic()) {
            return (this.invokeBuiltinStatic(fnValue.builtinNamespace fnValue.builtinName argVals))
        }
        ; D-CTORVALUE: a built-in CONSTRUCTOR held as a value is callable.
        if (fnValue.valueType == 6) {
            if (has fnValue.objectMap "__fnprotocall__") {
                return (EvalValue.undefined())
            }
        }
        def ctorNameV:string (this.builtinCtorNameOf(fnValue))
        if ((strlen ctorNameV) > 0) {
            def mergedV:[EvalValue]
            def mvi:int 0
            while (mvi < (array_length fnValue.boundArgs)) {
                push mergedV (itemAt fnValue.boundArgs mvi)
                mvi = (mvi + 1)
            }
            def mvj:int 0
            while (mvj < (array_length argVals)) {
                push mergedV (itemAt argVals mvj)
                mvj = (mvj + 1)
            }
            def cOut:EvalValue (this.callBuiltinCtorValues(ctorNameV mergedV false))
            if (false == (cOut.isNull())) {
                return cOut
            }
            if scriptThrew {
                return (EvalValue.undefined())
            }
        }
        if (fnValue.isBuiltinMethod()) {
            def bRecv:EvalValue (EvalValue.undefined())
            if fnValue.boundThis {
                bRecv = (unwrap fnValue.boundThis)
            }
            def bArgs:[EvalValue] argVals
            if ((array_length fnValue.boundArgs) > 0) {
                def bMerged:[EvalValue]
                def bi0:int 0
                while (bi0 < (array_length fnValue.boundArgs)) {
                    push bMerged (itemAt fnValue.boundArgs bi0)
                    bi0 = (bi0 + 1)
                }
                def bi1:int 0
                while (bi1 < (array_length argVals)) {
                    push bMerged (itemAt argVals bi1)
                    bi1 = (bi1 + 1)
                }
                bArgs = bMerged
            }
            return (this.invokeBuiltin(fnValue.builtinKind fnValue.builtinName bRecv bArgs))
        }
        if (this.isEvalFunctionValue(fnValue)) {
            return (this.runIndirectEval(argVals))
        }
        if (null? fnValue.functionNode) {
            return (EvalValue.null())
        }
        def fnNode:TSNode (unwrap fnValue.functionNode)
        def savedContext:EvalContext context
        def savedDidReturn:boolean scriptDidReturn
        def savedReturnValue:EvalValue scriptReturnValue
        def savedModule:string currentModule
        scriptDidReturn = false
        scriptReturnValue = (EvalValue.null())
        def parent:EvalContext context
        if (fnValue.closureId >= 0) {
            if (fnValue.closureId < (array_length closureScopes)) {
                def cell:ClosureCell (itemAt closureScopes fnValue.closureId)
                if cell.ctx {
                    parent = (unwrap cell.ctx)
                }
            }
        } {
            ; No captured scope: root lexically by provenance. A module-owned
            ; value roots in its module scope; an entry-owned value invoked FROM
            ; module code roots in the entry module scope (never the module's
            ; chain). Pure entry→entry calls keep the legacy caller chain.
            if ((strlen fnValue.homeModule) > 0) {
                parent = (this.moduleScopeFor(fnValue.homeModule))
            } {
                if ((strlen currentModule) > 0) {
                    parent = moduleScope
                }
            }
        }
        currentModule = fnValue.homeModule
        context = (parent.createChild())
        if fnValue.boundThis {
            ; D-THISCOERCE: a SLOPPY function called with no receiver -- or with
            ; null/undefined through call/apply -- gets the GLOBAL OBJECT, and a
            ; primitive receiver is boxed. A strict one keeps exactly what it was
            ; given. `Function("this.field = 1").apply()` turns on this rule.
            def rawThis:EvalValue (unwrap fnValue.boundThis)
            ; D-STRICT: whose strictness decides is the CALLEE's, and it was
            ; stamped on the value when the function was created. Asking
            ; strictForBody here folds in the ambient flag -- the CALLER's -- so
            ; a sloppy function called from strict code kept an undefined
            ; `this`, which is exactly what `"use strict";
            ; Function("return typeof this")()` reports.
            def calleeStrict:boolean fnValue.strictFn
            if (this.bodyOnlyStrict(fnNode)) {
                calleeStrict = true
            }
            if (false == calleeStrict) {
                if ((rawThis.isNull()) || (rawThis.isUndefined())) {
                    rawThis = (this.theGlobalObject())
                } {
                    if (rawThis.valueType == 2) { rawThis = (this.toObjectValue(rawThis)) }
                    if (rawThis.valueType == 1) { rawThis = (this.toObjectValue(rawThis)) }
                    if (rawThis.valueType == 3) { rawThis = (this.toObjectValue(rawThis)) }
                }
            }
            context.define("this" rawThis)
        } {
            ; D-THISCOERCE: a bare `f()` supplies no receiver at all, which is
            ; the undefined case -- so a SLOPPY callee still gets the global
            ; object. Leaving `this` unbound let it resolve up the scope chain
            ; to whatever the DEFINING scope had, which is not the same thing.
            ; An ARROW takes `this` lexically and must not be given one here --
            ; binding the global object would shadow the enclosing `this`.
            def bareStrict:boolean fnValue.strictFn
            if (this.bodyOnlyStrict(fnNode)) {
                bareStrict = true
            }
            if ((this.nodeKindOf(fnNode)) == 17) {
                bareStrict = true
            }
            if (false == bareStrict) {
                context.define("this" (this.theGlobalObject()))
            } {
                ; A STRICT callee called bare has `this` UNDEFINED. Leaving it
                ; unbound let the name resolve up the scope chain to whatever
                ; the enclosing function had, so a strict function nested in a
                ; sloppy one saw the sloppy one's global object. An arrow is the
                ; exception: it genuinely has no `this` of its own.
                if ((this.nodeKindOf(fnNode)) != 17) {
                    context.define("this" (EvalValue.undefined()))
                }
            }
        }
        ; D-FNPROTO: arguments fixed by bind() come first, then the call site's.
        def effArgs:[EvalValue] argVals
        if ((array_length fnValue.boundArgs) > 0) {
            def merged:[EvalValue]
            def bi:int 0
            while (bi < (array_length fnValue.boundArgs)) {
                push merged (itemAt fnValue.boundArgs bi)
                bi = (bi + 1)
            }
            def ci2:int 0
            while (ci2 < (array_length argVals)) {
                push merged (itemAt argVals ci2)
                ci2 = (ci2 + 1)
            }
            effArgs = merged
        }
        pendingCallee = fnValue
        pendingCalleeValid = true
        this.bindParams(fnNode effArgs)
        pendingCalleeValid = false
        ; D-STRICT: the function's OWN strictness governs the code it runs. It
        ; was taken from the body directive plus the ambient flag, so a strict
        ; callback handed to a sloppy helper -- which is exactly what
        ; assert.throws does -- ran sloppy.
        def savedStrict:boolean strictMode
        ; The function's LEXICAL strictness was stamped on the value when the
        ; closure was captured, so the ambient flag must not be folded in again:
        ; a function built by the Function constructor inside strict code is
        ; sloppy, and calling it from that strict code has to run it sloppy.
        strictMode = (this.bodyOnlyStrict(fnNode))
        if fnValue.strictFn {
            strictMode = true
        }
        callDepth = (callDepth + 1)
        ; D-FNSRC: the code about to run came from this function's source, so a
        ; function IT defines belongs to the same string. Without the swap a
        ; closure returned by an eval'd factory would slice the main script.
        def savedSrcText:string currentSource
        if ((strlen fnValue.srcText) > 0) {
            currentSource = fnValue.srcText
        }
        def result:EvalValue (EvalValue.null())
        if fnNode.body {
            def body:TSNode (unwrap fnNode.body)
            if ((this.nodeKindOf(body)) == 34) {
                result = (this.callResultOf((this.evaluateFunctionBodyValue(body))))
            } {
                result = (this.evaluateExpr(body))
            }
        }
        currentSource = savedSrcText
        strictMode = savedStrict
        callDepth = (callDepth - 1)
        context = savedContext
        currentModule = savedModule
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        return result
    }

    ; ==========================================================================
    ; JSX Evaluation
    ; ==========================================================================
    
    fn evaluateJSX:EVGElement (node:TSNode) {
        def element (new EVGElement())
        
        if (node.nodeType == "JSXElement") {
            return (this.evaluateJSXElement(node))
        }
        
        if (node.nodeType == "JSXFragment") {
            element.tagName = "div"
            this.evaluateChildren(element node)
            return element
        }
        
        if ((this.nodeKindOf(node)) == 23) {
            if node.left {
                def inner:TSNode (unwrap node.left)
                return (this.evaluateJSX(inner))
            }
        }
        
        ; Fallback: any other expression (e.g. a helper call that returns JSX,
        ; like hud() -> playHud(...)). Evaluate it and unwrap the element result.
        def val:EvalValue (this.evaluateExpr(node))
        if (val.isElement()) {
            if val.evgElement {
                return (unwrap val.evgElement)
            }
        }
        
        return element
    }
    
    fn evaluateJSXElement:EVGElement (jsxNode:TSNode) {
        ; Get tag name from opening element
        def tagName:string ""
        if jsxNode.left {
            def openingEl:TSNode (unwrap jsxNode.left)
            tagName = openingEl.name
        }
        
        ; Check if it's a component (not a primitive)
        if (this.isComponent(tagName)) {
            return (this.expandComponent(tagName jsxNode))
        }
        
        ; Primitive element - create EVG element
        def element (new EVGElement())
        element.tagName = (this.mapTagName(tagName))
        
        ; Set elementType based on tag
        if ((tagName == "Label") || (tagName == "span") || (tagName == "text")) {
            element.elementType = 1  ; Text
        }
        if ((tagName == "Image") || (tagName == "img") || (tagName == "image")) {
            element.elementType = 2  ; Image
        }
        if ((tagName == "Path") || (tagName == "path")) {
            element.elementType = 3  ; Path
        }
        
        ; Parse attributes
        if jsxNode.left {
            def openingEl:TSNode (unwrap jsxNode.left)
            this.evaluateAttributes(element openingEl)
        }
        
        ; Handle Print element - resolve book format and update engine dimensions
        if (tagName == "Print") {
            element.resolveBookFormat()
            ; Update engine's page dimensions for children
            if (element.pageWidth > 0.0) {
                pageWidth = element.pageWidth
            }
            if (element.pageHeight > 0.0) {
                pageHeight = element.pageHeight
            }
            ; Update print settings for hooks
            printFormat = element.format
            printOrientation = element.orientation
            print "Print settings: format=" + printFormat + " orientation=" + printOrientation + " " + (to_string pageWidth) + "x" + (to_string pageHeight)
        }
        
        ; Handle text content for Label/text elements
        if ((tagName == "Label") || (tagName == "span") || (tagName == "text")) {
            element.textContent = (this.evaluateTextContent(jsxNode))
        } {
            ; Evaluate children
            this.evaluateChildren(element jsxNode)
        }
        
        return element
    }
    
    fn isComponent:boolean (name:string) {
        if ((strlen name) == 0) {
            return false
        }
        
        ; Check if it's a primitive
        def i:int 0
        while (i < (array_length primitives)) {
            if ((itemAt primitives i) == name) {
                return false
            }
            i = i + 1
        }
        
        ; Check if first character is uppercase (A-Z is 65-90)
        def firstChar:int (charAt name 0)
        if ((firstChar >= 65) && (firstChar <= 90)) {
            return true
        }
        
        return false
    }
    
    fn expandComponent:EVGElement (name:string jsxNode:TSNode) {
        ; Use the last registered match (hot reload upserts may leave older entries).
        def foundIdx:int -1
        def i:int 0
        while (i < (array_length localComponents)) {
            def sym:ImportedSymbol (itemAt localComponents i)
            if (sym.name == name) {
                foundIdx = i
            }
            i = i + 1
        }
        if (foundIdx >= 0) {
            def sym:ImportedSymbol (itemAt localComponents foundIdx)
            def props:EvalValue (this.evaluateProps(jsxNode))
            if sym.functionNode {
                def fnNode:TSNode (unwrap sym.functionNode)
                def hi:int 0
                while (hi < (array_length sym.helperFunctions)) {
                    def helperFn:TSNode (itemAt sym.helperFunctions hi)
                    def helperName:string helperFn.name
                    def __fnv:EvalValue (EvalValue.function(helperFn))
                    __fnv.strictFn = (this.strictForBody(helperFn))
                    __fnv.srcText = currentSource
                    def helperValue:EvalValue __fnv
                    context.define(helperName helperValue)
                    print ("Registered helper function: " + helperName)
                    hi = hi + 1
                }
                return (this.evaluateFunctionWithProps(fnNode props))
            }
        }
        
        ; Not found - return empty element
        print ("Warning: Unknown component: " + name)
        def empty (new EVGElement())
        empty.tagName = "div"
        return empty
    }
    
    fn evaluateProps:EvalValue (jsxNode:TSNode) {
        def keys:[string]
        def values:[EvalValue]
        
        if jsxNode.left {
            def openingEl:TSNode (unwrap jsxNode.left)
            
            def i:int 0
            while (i < (array_length openingEl.children)) {
                def attr:TSNode (itemAt openingEl.children i)
                
                if (attr.nodeType == "JSXAttribute") {
                    def attrName:string attr.name
                    def attrValue:EvalValue (this.evaluateAttributeValue(attr))
                    
                    push keys attrName
                    push values attrValue
                }
                
                i = i + 1
            }
        }
        
        ; Also collect JSX children and add as "children" prop
        ; Only if there are children and no explicit children prop
        def hasExplicitChildren:boolean false
        def ci:int 0
        while (ci < (array_length keys)) {
            if ((itemAt keys ci) == "children") {
                hasExplicitChildren = true
            }
            ci = ci + 1
        }
        
        if (hasExplicitChildren == false) {
            def childElements:[EvalValue] (this.collectChildElements(jsxNode))
            if ((array_length childElements) > 0) {
                push keys "children"
                if ((array_length childElements) == 1) {
                    ; Single child - pass as element directly
                    push values (itemAt childElements 0)
                } {
                    ; Multiple children - pass as array
                    push values (EvalValue.array(childElements))
                }
            }
        }
        
        return (EvalValue.object(keys values))
    }
    
    ; Collect child JSX elements as EvalValue elements
    fn collectChildElements:[EvalValue] (jsxNode:TSNode) {
        def results:[EvalValue]
        
        def i:int 0
        while (i < (array_length jsxNode.children)) {
            def child:TSNode (itemAt jsxNode.children i)
            
            if (child.nodeType == "JSXElement") {
                def el:EVGElement (this.evaluateJSXElement(child))
                if ((strlen el.tagName) > 0) {
                    push results (EvalValue.element(el))
                }
            }
            
            if (child.nodeType == "JSXText") {
                ; Only include non-whitespace text as children
                def text:string (this.trimText(child.value))
                if ((strlen text) > 0) {
                    ; Create a text element
                    def textEl (new EVGElement())
                    textEl.tagName = "text"
                    textEl.textContent = text
                    push results (EvalValue.element(textEl))
                }
            }
            
            if (child.nodeType == "JSXExpressionContainer") {
                if child.left {
                    def exprNode:TSNode (unwrap child.left)
                    def exprValue:EvalValue (this.evaluateExpr(exprNode))
                    
                    if (exprValue.isElement()) {
                        push results exprValue
                    }
                    if (exprValue.isArray()) {
                        ; Flatten array elements into children
                        def ai:int 0
                        while (ai < (array_length exprValue.arrayValue)) {
                            def arrItem:EvalValue (itemAt exprValue.arrayValue ai)
                            if (arrItem.isElement()) {
                                push results arrItem
                            }
                            ai = ai + 1
                        }
                    }
                }
            }
            
            i = i + 1
        }
        
        return results
    }
    
    fn evaluateAttributeValue:EvalValue (attr:TSNode) {
        if attr.right {
            def rightNode:TSNode (unwrap attr.right)
            
            ; String literal
            if ((this.nodeKindOf(rightNode)) == 8) {
                return (EvalValue.string((this.unquote(rightNode.value))))
            }
            
            ; Expression container
            if (rightNode.nodeType == "JSXExpressionContainer") {
                if rightNode.left {
                    def exprNode:TSNode (unwrap rightNode.left)
                    return (this.evaluateExpr(exprNode))
                }
            }
        }
        
        ; Boolean attribute (no value means true)
        return (EvalValue.boolean(true))
    }
    
    fn evaluateAttributes:void (element:EVGElement openingNode:TSNode) {
        def i:int 0
        while (i < (array_length openingNode.children)) {
            def attr:TSNode (itemAt openingNode.children i)
            
            if (attr.nodeType == "JSXAttribute") {
                def rawAttrName:string attr.name
                def attrValue:EvalValue (this.evaluateAttributeValue(attr))
                def strValue:string (attrValue.toString())
                
                ; Apply attribute to element
                this.applyAttribute(element rawAttrName strValue)
            }
            
            i = i + 1
        }
    }
    
    fn applyAttribute:void (element:EVGElement rawName:string strValue:string) {
        ; Handle special attributes
        if (rawName == "id") {
            element.id = strValue
            return
        }
        if (rawName == "className") {
            element.className = strValue
            return
        }
        if (rawName == "src") {
            element.src = strValue
            return
        }
        
        ; For everything else, use setAttribute which handles all the parsing
        element.setAttribute(rawName strValue)
    }
    
    fn evaluateTextContent:string (jsxNode:TSNode) {
        def result:string ""
        
        def i:int 0
        while (i < (array_length jsxNode.children)) {
            def child:TSNode (itemAt jsxNode.children i)
            
            if (child.nodeType == "JSXText") {
                ; Get the actual text content
                def rawText:string child.value
                
                if ((strlen rawText) > 0) {
                    ; Use smart join to handle punctuation properly
                    result = (this.smartJoinText(result rawText))
                }
            }
            
            if (child.nodeType == "JSXExpressionContainer") {
                if child.left {
                    def exprNode:TSNode (unwrap child.left)
                    def exprValue:EvalValue (this.evaluateExpr(exprNode))
                    def exprStr:string (exprValue.toString())
                    
                    ; Use smart join to handle punctuation properly
                    result = (this.smartJoinText(result exprStr))
                }
            }
            
            i = i + 1
        }
        
        ; Now normalize and trim the complete text
        def normalizedText:string (this.normalizeWhitespace(result))
        def trimmedText:string (this.trimText(normalizedText))
        
        return trimmedText
    }
    
    fn evaluateChildren:void (element:EVGElement jsxNode:TSNode) {
        def i:int 0
        def accumulatedText:string ""
        
        while (i < (array_length jsxNode.children)) {
            def child:TSNode (itemAt jsxNode.children i)
            
            if (child.nodeType == "JSXText") {
                ; Accumulate consecutive JSXText nodes with smart joining
                accumulatedText = (this.smartJoinText(accumulatedText child.value))
                i = i + 1
                continue
            }
            
            ; Flush accumulated text before processing other node types
            if ((strlen accumulatedText) > 0) {
                def normalizedText:string (this.normalizeWhitespace(accumulatedText))
                def text:string (this.trimText(normalizedText))
                if ((strlen text) > 0) {
                    def textEl (new EVGElement())
                    textEl.tagName = "text"
                    textEl.textContent = text
                    element.addChild(textEl)
                }
                accumulatedText = ""
            }
            
            if (child.nodeType == "JSXElement") {
                def childEl:EVGElement (this.evaluateJSXElement(child))
                if ((strlen childEl.tagName) > 0) {
                    element.addChild(childEl)
                }
            }
            
            if (child.nodeType == "JSXExpressionContainer") {
                this.evaluateExpressionChild(element child)
            }
            
            if (child.nodeType == "JSXFragment") {
                ; Flatten fragment children
                this.evaluateChildren(element child)
            }
            
            i = i + 1
        }
        
        ; Flush any remaining accumulated text at the end
        if ((strlen accumulatedText) > 0) {
            def normalizedText:string (this.normalizeWhitespace(accumulatedText))
            def text:string (this.trimText(normalizedText))
            if ((strlen text) > 0) {
                def textEl (new EVGElement())
                textEl.tagName = "text"
                textEl.textContent = text
                element.addChild(textEl)
            }
        }
    }
    
    fn evaluateExpressionChild:void (element:EVGElement exprContainer:TSNode) {
        if exprContainer.left {
            def exprNode:TSNode (unwrap exprContainer.left)
            
            ; Handle CallExpression - both array.map() and regular function calls
            if ((this.nodeKindOf(exprNode)) == 4) {
                ; Check if it's a method call like array.map()
                if exprNode.left {
                    def calleeNode:TSNode (unwrap exprNode.left)
                    if ((this.nodeKindOf(calleeNode)) == 3) {
                        ; Method call - check for .map()
                        def methodName:string calleeNode.name
                        if (methodName == "map") {
                            this.evaluateArrayMapChild(element exprNode)
                            return
                        }
                    }
                }
                ; Regular function call like buildColorBoxes()
                ; Evaluate using evaluateExpr which handles CallExpression
                def callResult:EvalValue (this.evaluateExpr(exprNode))
                
                ; Handle array result (array of elements from function)
                if (callResult.isArray()) {
                    def ai:int 0
                    while (ai < (array_length callResult.arrayValue)) {
                        def arrItem:EvalValue (itemAt callResult.arrayValue ai)
                        if (arrItem.isElement()) {
                            if arrItem.evgElement {
                                def arrChildEl:EVGElement (unwrap arrItem.evgElement)
                                if ((strlen arrChildEl.tagName) > 0) {
                                    element.addChild(arrChildEl)
                                }
                            }
                        }
                        ai = ai + 1
                    }
                    return
                }
                
                ; Handle single element result
                if (callResult.isElement()) {
                    if callResult.evgElement {
                        def childEl:EVGElement (unwrap callResult.evgElement)
                        if ((strlen childEl.tagName) > 0) {
                            element.addChild(childEl)
                        }
                    }
                    return
                }
                
                ; Handle string/number result as text
                def isStr:boolean (callResult.isString())
                def isNum:boolean (callResult.isNumber())
                if (isStr || isNum) {
                    def textEl (new EVGElement())
                    textEl.tagName = "text"
                    textEl.textContent = (callResult.toString())
                    element.addChild(textEl)
                }
                return
            }
            
            ; Handle ternary conditionals
            if ((this.nodeKindOf(exprNode)) == 13) {
                this.evaluateTernaryChild(element exprNode)
                return
            }
            
            ; Handle && conditionals
            if ((this.nodeKindOf(exprNode)) == 5) {
                if (exprNode.value == "&&") {
                    this.evaluateAndChild(element exprNode)
                    return
                }
            }
            
            ; For literals, add as text
            def value:EvalValue (this.evaluateExpr(exprNode))
            
            ; Handle EVGElement values (e.g., {children} prop containing JSX)
            if (value.isElement()) {
                if value.evgElement {
                    def childEl:EVGElement (unwrap value.evgElement)
                    if ((strlen childEl.tagName) > 0) {
                        element.addChild(childEl)
                    }
                }
                return
            }
            
            ; Handle arrays of EVGElements (e.g., {children} containing multiple elements)
            if (value.isArray()) {
                def ai:int 0
                while (ai < (array_length value.arrayValue)) {
                    def arrItem:EvalValue (itemAt value.arrayValue ai)
                    if (arrItem.isElement()) {
                        if arrItem.evgElement {
                            def arrChildEl:EVGElement (unwrap arrItem.evgElement)
                            if ((strlen arrChildEl.tagName) > 0) {
                                element.addChild(arrChildEl)
                            }
                        }
                    }
                    ai = ai + 1
                }
                return
            }
            
            def isStr:boolean (value.isString())
            def isNum:boolean (value.isNumber())
            if (isStr || isNum) {
                def textEl (new EVGElement())
                textEl.tagName = "text"
                textEl.textContent = (value.toString())
                element.addChild(textEl)
            }
        }
    }
    
    fn evaluateArrayMapChild:void (element:EVGElement callNode:TSNode) {
        ; Get the array being mapped
        if callNode.left {
            def calleeNode:TSNode (unwrap callNode.left)
            if ((this.nodeKindOf(calleeNode)) == 3) {
                def methodName:string calleeNode.name
                if (methodName == "map") {
                    ; Get the array
                    if calleeNode.left {
                        def arrayExpr:TSNode (unwrap calleeNode.left)
                        def arrayValue:EvalValue (this.evaluateExpr(arrayExpr))
                        
                        if (arrayValue.isArray()) {
                            ; Get the callback function
                            if ((array_length callNode.children) > 0) {
                                def callback:TSNode (itemAt callNode.children 0)
                                
                                ; Map over array
                                def i:int 0
                                while (i < (array_length arrayValue.arrayValue)) {
                                    def item:EvalValue (itemAt arrayValue.arrayValue i)
                                    
                                    ; Create child context with map variable
                                    def savedContext:EvalContext context
                                    context = (context.createChild())
                                    
                                    ; Bind the callback parameter
                                    this.bindMapCallback(callback item i)
                                    
                                    ; Evaluate callback body
                                    def resultEl:EVGElement (this.evaluateMapCallbackBody(callback))
                                    if ((strlen resultEl.tagName) > 0) {
                                        element.addChild(resultEl)
                                    }
                                    
                                    context = savedContext
                                    i = i + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    fn bindMapCallback:void (callback:TSNode item:EvalValue index:int) {
        if ((this.nodeKindOf(callback)) == 17) {
            ; Get parameter name
            if ((array_length callback.params) > 0) {
                def param:TSNode (itemAt callback.params 0)
                def paramName:string param.name
                context.define(paramName item)
            }
            ; Bind index if second param exists
            if ((array_length callback.params) > 1) {
                def indexParam:TSNode (itemAt callback.params 1)
                context.define(indexParam.name (EvalValue.fromInt(index)))
            }
        }
    }
    
    fn evaluateMapCallbackBody:EVGElement (callback:TSNode) {
        def empty (new EVGElement())
        
        if ((this.nodeKindOf(callback)) == 17) {
            ; Arrow function body
            if callback.body {
                def body:TSNode (unwrap callback.body)
                if ((body.nodeType == "JSXElement") || (body.nodeType == "JSXFragment")) {
                    return (this.evaluateJSX(body))
                }
                if ((this.nodeKindOf(body)) == 34) {
                    return (this.evaluateFunctionBody(body))
                }
                ; generic expression body — e.g. (e, i) => buildTile(e, i) — is
                ; evaluated like any expression; an element result is the child.
                def v:EvalValue (this.evaluateExpr(body))
                if (v.isElement()) {
                    if v.evgElement {
                        return (unwrap v.evgElement)
                    }
                }
            }
        }

        return empty
    }
    
    fn evaluateTernaryChild:void (element:EVGElement node:TSNode) {
        ; Evaluate condition
        if node.test {
            def testExpr:TSNode (unwrap node.test)
            def testValue:EvalValue (this.evaluateExpr(testExpr))
            
            if (testValue.toBool()) {
                ; True branch
                if node.consequent {
                    def conseqNode:TSNode (unwrap node.consequent)
                    if ((conseqNode.nodeType == "JSXElement") || (conseqNode.nodeType == "JSXFragment")) {
                        def childEl:EVGElement (this.evaluateJSX(conseqNode))
                        if ((strlen childEl.tagName) > 0) {
                            element.addChild(childEl)
                        }
                    }
                }
            } {
                ; False branch
                if node.alternate {
                    def altNode:TSNode (unwrap node.alternate)
                    if ((altNode.nodeType == "JSXElement") || (altNode.nodeType == "JSXFragment")) {
                        def childEl:EVGElement (this.evaluateJSX(altNode))
                        if ((strlen childEl.tagName) > 0) {
                            element.addChild(childEl)
                        }
                    }
                }
            }
        }
    }
    
    fn evaluateAndChild:void (element:EVGElement node:TSNode) {
        ; Evaluate left side
        if node.left {
            def leftExpr:TSNode (unwrap node.left)
            def leftValue:EvalValue (this.evaluateExpr(leftExpr))
            
            if (leftValue.toBool()) {
                ; Render right side (the JSX element)
                if node.right {
                    def rightNode:TSNode (unwrap node.right)
                    if ((rightNode.nodeType == "JSXElement") || (rightNode.nodeType == "JSXFragment")) {
                        def childEl:EVGElement (this.evaluateJSX(rightNode))
                        if ((strlen childEl.tagName) > 0) {
                            element.addChild(childEl)
                        }
                    }
                }
            }
        }
    }
    
    ; ==========================================================================
    ; Expression Evaluation
    ; ==========================================================================
    
    fn evaluateExpr:EvalValue (node:TSNode) {
        def exprK:int (this.nodeKindOf(node))
        ; Fast dispatch: the node types that dominate evaluation of real scripts
        ; (variable reads, member/array access, calls, arithmetic) are checked
        ; first so the common case does not fall through the whole if-chain.
        if (exprK == 1) {
            ; Resolution memo: an identifier read walks the scope chain hashing
            ; its name at every level. The depth is a property of the syntactic
            ; position, so it is walked once and reused -- and RE-VERIFIED, so a
            ; stale memo costs one probe and a fallback rather than answering
            ; with the wrong binding. A `with` scope makes depth meaningless.
            if (false == anyWithScope) {
                if (node.scopeHops >= 0) {
                    def memoHit@(optional):EvalValue (context.tryLookupAtDepth(node.name node.scopeHops))
                    if memoHit {
                        return (unwrap memoHit)
                    }
                } {
                    node.scopeHops = (context.depthOfBinding(node.name))
                }
            }
            return (this.lookupIdentifier(node.name))
        }
        ; PERF: a numeric literal is held as source TEXT, so evaluating it means
        ; parsing that text -- and a loop bound is evaluated once per iteration.
        ; The parse is memoised on the node, and the case sits at the front
        ; rather than fifteen string comparisons down the chain.
        if (exprK == 2) {
            if (false == node.numScanned) {
                node.numScanned = true
                def parsedNum@(optional):double (to_double node.value)
                if parsedNum {
                    node.numValue = (unwrap parsedNum)
                }
            }
            ; The VALUE is memoised too, not just the parse. Below 4096 the
            ; shared pool already answers; above it, minting a fresh EvalValue
            ; per evaluation made a loop bound cost one allocation per iteration.
            def numPool:EvalConstPool (EvalConstPool.__singleton())
            if (node.numCacheId >= 0) {
                return (numPool.literalAt(node.numCacheId))
            }
            def litVal:EvalValue (EvalValue.number(node.numValue))
            node.numCacheId = (numPool.addLiteral(litVal))
            return litVal
        }
        if (exprK == 3) {
            return (this.evaluateMemberExpr(node))
        }
        if (exprK == 4) {
            return (this.evaluateCallExpr(node))
        }
        if (exprK == 16) {
            return (this.evaluateNewExpr(node))
        }
        ; D-HOLES: an array elision is an ABSENT element. It reads as undefined
        ; wherever a value is wanted, and `0 in [,1]` is false.
        if (exprK == 22) {
            return (EvalValue.hole())
        }
        ; D-REGEX: `/pattern/flags` as a value.
        if (exprK == 21) {
            return (this.regexFromLiteral(node.value))
        }
        ; The comma operator evaluates every operand and yields the LAST. It had
        ; no case at all, so `(1, 2)` evaluated to undefined and any side effect
        ; in an earlier operand never ran.
        if (exprK == 19) {
            def seqOut:EvalValue (EvalValue.undefined())
            def si:int 0
            while (si < (array_length node.children)) {
                seqOut = (this.evaluateExpr((itemAt node.children si)))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                si = (si + 1)
            }
            return seqOut
        }
        if (exprK == 20) {
            ; D-GLOBALTHIS: outside any function, `this` is the global object.
            if (false == (context.has("this"))) {
                ; D-STRICT: a strict function called without a receiver has
                ; `this` undefined -- there is no substitution of the global
                ; object, which is what the suite checks a strict function's
                ; identity with.
                if strictMode {
                    if (this.insideFunctionCall()) {
                        return (EvalValue.undefined())
                    }
                }
                return (this.theGlobalObject())
            }
            return (context.lookup("this"))
        }
        if (exprK == 5) {
            return (this.evaluateBinaryExpr(node))
        }
        ; Assignment / update in value position: x = (y = 5), let d = c++, arr[i]++
        if (exprK == 6) {
            return (this.evaluateAssignValue(node))
        }
        if (exprK == 7) {
            return (this.evaluateUpdateValue(node))
        }
        ; Arrow / function expression as a value: capture the defining scope so the
        ; resulting closure is lexical when stored, returned or passed around.
        ; D-CLASSEXPR: `var C = class { ... }`. The class table is keyed by name,
        ; so an anonymous class expression is registered under a generated one
        ; and the value carries that key. `new C()` then resolves through the
        ; value rather than through the source-level name, which it does not have.
        if (exprK == 24) {
            return (this.registerClassExpression(node))
        }
        if (exprK == 17) {
            return (this.captureClosure(node))
        }
        if (exprK == 18) {
            return (this.captureClosure(node))
        }
        ; Literals
        if (exprK == 2) {
            def numVal@(optional):double (to_double node.value)
            if numVal {
                return (EvalValue.number((unwrap numVal)))
            }
            return (EvalValue.number(0.0))
        }
        
        if (exprK == 8) {
            ; The lexer already removed the delimiters, so unquoting again ate
            ; real characters whenever the CONTENT began and ended with the same
            ; quote: `'\'hi\''` became `hi`, and `eval('"BJ"')` was handed the
            ; identifier BJ. That is the "lexer drops escaped quotes" gap -- it
            ; was never the lexer.
            return (EvalValue.string(node.value))
        }
        
        if (exprK == 11) {
            ; Template literals have TemplateElement children with the text
            ; The text may contain ${...} expressions that need to be evaluated
            def templateText:string ""
            def ti:int 0
            while (ti < (array_length node.children)) {
                def templateChild:TSNode (itemAt node.children ti)
                if (templateChild.nodeType == "TemplateElement") {

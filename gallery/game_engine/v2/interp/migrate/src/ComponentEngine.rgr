                                    if (copK == 2) { return (ca <= cb) }
                                    if (copK == 3) { return (ca > cb) }
                                    if (copK == 4) { return (ca >= cb) }
                                    if (copK == 5) { return (ca == cb) }
                                    return (ca != cb)

        return (condV.toBool())
    }

    fn evaluateExprTransient:EvHandle (node:TSNode) {
        if anyWithScope {
            return (this.evaluateExpr(node))
        }
        def tk:int (this.nodeKindOf(node))
        if (tk == 3) {
            if (this.transientOperandOk(node 0)) {

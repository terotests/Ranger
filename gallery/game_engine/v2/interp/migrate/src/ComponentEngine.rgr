            }
            if (name == "call") {
                def callThis:EvalValue (EvalValue.undefined())
                def rest:[EvalValue]
                def i:int 0
                while (i < (array_length args)) {
                    if (i == 0) {
                        callThis = (itemAt args 0)
                    } {
                        push rest (itemAt args i)
                    }
                    i = (i + 1)

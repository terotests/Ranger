                def curProto:EvHandle (this.protoOfValue(rTgt))
                def sameProto:boolean false
                if (rProto.isNull()) {
                    if (curProto.isNull()) { sameProto = true }
                    if (curProto.isUndefined()) { sameProto = true }
                } {
                    if (this.isDescriptorObject(curProto)) {

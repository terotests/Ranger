            }
            def keep:boolean (this.uriUnreserved(c))
            if keepReserved {
                if (this.uriReserved(c)) { keep = true }
            }
            if keep {
                out = (out + (strfromcode c))
                i = (i + 1)
            } {
                if bytesModel {
                    ; The units ARE the UTF-8 bytes; each one escapes as it is.
                    ; A lone SURROGATE is still a URIError, and in this model it
                    ; has already been folded into bytes -- ED A0..BF is exactly
                    ; the U+D800..U+DFFF range, so that pair is what identifies
                    ; one here.
                    if (c == 237) {
                        if ((i + 1) < n) {

            if (false == (numRecv.isNumber())) {
                return (this.throwSpecError("TypeError" ("Number.prototype." + name + " called on a non-number")))
            }
        }
        if (kind == "boolean") {
            def boolRecv:EvHandle (this.unwrapPrimitive(recv))
            if (false == (boolRecv.isBoolean())) {
                return (this.throwSpecError("TypeError" ("Boolean.prototype." + name + " called on a non-boolean")))
            }

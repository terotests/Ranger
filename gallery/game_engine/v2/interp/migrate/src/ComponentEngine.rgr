                            def turnCtx:EvalContext ((unwrap ofOuter).createChild())
                            turnCtx.isBlockScope = true
                            context = turnCtx
                        }
                        if varPattern {
                            this.bindPattern((unwrap varPattern) item)
                        } {
                            if ((strlen varName) > 0) {
                                context.define(varName item)
                            } {
                                if varTarget {
                                    this.assignToTarget((unwrap varTarget) item)
                                }
                            }
                        }
                        loopContinue = false
                        if stmt.body {
                            this.runBlockOrStatement((unwrap stmt.body))
                        }
                        if (scriptDidReturn || scriptThrew) {
                            looping = false
                        } {
                            if loopBreak {
                                looping = false
                            } {
                                if (this.continueEscapes(myLabels)) {
                                    looping = false
                                } {
                                    i = i + 1
                                }
                            }
                        }
                    }
                }
            }
        }
        context = (unwrap ofOuter)
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }
    fn runWhileStatementValue:void (stmt:TSNode) {
        ; D-COMPLETION: an iteration statement's completion value starts at
        ; UNDEFINED, not at whatever the statement before it produced. That is
        ; what makes `eval('1; for (x in {}) { }')` undefined rather than 1 --
        ; a loop that runs no iterations, or whose body produces nothing,
        ; evaluates to undefined.
        completionValue = (EvValueBridge.taggedUndefined())
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        def maxIterations:int maxLoopIterations
        def iterations:int 0
        def looping:boolean true
        while ((iterations < maxIterations) && looping) {
            if (scriptDidReturn || scriptThrew) {
                looping = false
            } {
                def proceed:boolean true
                if stmt.left {
                    if ((this.evaluateCondBool((unwrap stmt.left))) == false) {
                        proceed = false
                    }
                }
                if (proceed == false) {
                    looping = false
                } {
                    loopContinue = false
                    if stmt.body {
                        this.runBlockOrStatement((unwrap stmt.body))
                    }
                    if (scriptDidReturn || scriptThrew) {
                        looping = false
                    } {
                        if loopBreak {
                            looping = false
                        } {
                            if (this.continueEscapes(myLabels)) {
                                looping = false
                            } {
                                iterations = iterations + 1
                            }
                        }
                    }
                }
            }
        }
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }

    ; switch(disc){ case v: ... [break] ; default: ... }. JS fall-through: once a
    ; case matches (or default, if none match) execution runs from there onward
    ; until a break/return/continue. `break` ends the switch (consumed here);
    ; `continue`/`return` propagate to the enclosing loop/function.
    fn runSwitchStatementValue:void (stmt:TSNode) {
        ; D-COMPLETION: an iteration statement's completion value starts at
        ; UNDEFINED, not at whatever the statement before it produced. That is
        ; what makes `eval('1; for (x in {}) { }')` undefined rather than 1 --
        ; a loop that runs no iterations, or whose body produces nothing,
        ; evaluates to undefined.
        completionValue = (EvValueBridge.taggedUndefined())
        def savedBreak:boolean loopBreak
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        def disc:EvHandle (EvValueBridge.taggedNull())
        if stmt.left {
            disc = (this.evaluateExpr((unwrap stmt.left)))
        }
        def n:int (array_length stmt.children)
        def matchIdx:int (0 - 1)
        def defaultIdx:int (0 - 1)
        def ci:int 0
        while (ci < n) {
            def caseNode:TSNode (itemAt stmt.children ci)
            if (caseNode.kind == "default") {
                defaultIdx = ci
            } {
                if caseNode.left {
                    def testVal:EvHandle (this.evaluateExpr((unwrap caseNode.left)))
                    if (disc.equals(testVal)) {
                        if (matchIdx < 0) {
                            matchIdx = ci
                        }
                    }
                }
            }
            ci = (ci + 1)
        }
        def startIdx:int matchIdx
        if (startIdx < 0) {
            startIdx = defaultIdx
        }
        if (startIdx >= 0) {
            def si:int startIdx
            def running:boolean true
            while ((si < n) && running) {
                def cn:TSNode (itemAt stmt.children si)
                this.runStatementList(cn.children)
                if (scriptDidReturn || scriptThrew) {
                    running = false
                } {
                    if loopBreak {
                        running = false
                    } {

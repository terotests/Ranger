        ; §27.1.2.1 Iterator.from: any iterable -- or any object with a `next` --
        ; becomes an iterator carrying the helpers.
        if (nsName == "Iterator") {
            if (name == "from") {
                def fromArg:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 0) { fromArg = (itemAt args 0) }
                if ((fromArg.isUndefined()) || (fromArg.isNull())) {
                    return (this.throwSpecError("TypeError" "Iterator.from called on null or undefined"))
                }

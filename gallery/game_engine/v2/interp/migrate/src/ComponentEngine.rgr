    }

    ; Run a registered built-in. Reached both from a direct `recv.name(...)` call
    ; and from an extracted value invoked later via call/apply/bind, so the two
    ; paths cannot drift apart.
    ; D-REGISTRY: a method the GUEST put on a built-in prototype, replacing the
    ; registry's. `Array.prototype.toString = Object.prototype.toString` has to
    ; make `[].toString()` brand the array, and the direct call path went
    ; straight to the registry and never looked. Null when the prototype still
    ; holds the registry's own entry -- compared by identity, which is exactly
    ; what sharedNativeMethod exists to make possible.
    ; D-REGISTRY: `delete Object.prototype.toString` really removes the method.
    ; The registry would otherwise mint it again on the next read, so the
    ; deletion is RECORDED on the prototype object and every path that consults
    ; the registry checks here first. Only a registered built-in prototype can
    ; carry such a record; an ordinary object's delete is the map's business.
    ; D-ATTRS: a NON-CONFIGURABLE own property cannot be deleted -- `delete
    ; Number.NaN` is false, and a TypeError in strict mode. The delete operator
    ; removed whatever it was pointed at, attributes and all.
    ; D-PROXY: the `deleteProperty` trap, as a single entry point every delete
    ; form can consult. Answers 1 for "the trap handled it and said yes", 0 for
    ; "handled it and said no", and -1 for "not a proxy, carry on".
    fn proxyDelete:int (obj:EvHandle key:string) {
        if (false == (this.isProxyValue(obj))) {
            return (0 - 1)
        }
        def dTgt:EvHandle (this.proxyTargetOf(obj))
        def dTrap:EvHandle (this.proxyTrap(obj "deleteProperty"))
        if scriptThrew {
            return 0
        }
        if (dTrap.isFunction()) {
            def dArgs:[EvHandle]
            push dArgs dTgt
            push dArgs (EvValueBridge.taggedString(key))
            def dRes:EvHandle (this.callProxyTrap(dTrap dArgs))
            if scriptThrew {
                return 0
            }
            if (dRes.toBool()) {
                ; D-PROXYINV: a NON-CONFIGURABLE target property cannot be
                ; deleted, so a trap that says it was is contradicting its own
                ; target.
                def dd:EvHandle (this.ownPropertyDescriptorOf(dTgt key))
                if scriptThrew {
                    return 0
                }
                if (this.isDescriptorObject(dd)) {
                    if (false == ((this.descGet(dd "configurable")).toBool())) {
                        def _de:EvHandle (this.throwSpecError("TypeError" "proxy deleteProperty reported success for a non-configurable property"))
                        return 0
                    }
                }
                return 1
            }
            return 0
        }
        ; No trap: the delete runs against the TARGET, with the target's own
        ; rules. It removed the property unconditionally and answered true, so a
        ; proxy over a frozen object deleted what the object itself refuses.
        if (this.deleteRefused(dTgt key)) {
            return 0
        }
        this.unmapArgIndex(dTgt key)
        dTgt.removeMember(key)
        return 1
    }

    fn deleteRefused:boolean (obj:EvHandle key:string) {
        ; D-GLOBALTHIS: a script's `var` and function declarations are properties
        ; of the global object with { DontDelete }, so `delete this["x"]` answers
        ; false and the property survives -- the same answer `delete x` gives.
        if (this.isGlobalVarName(key)) {
            def gv:EvHandle (this.theGlobalObject())
            if (gv.equals(obj)) {
                return true
            }
        }
        if (false == (this.isDescriptorObject(obj))) {
            return false
        }
        ; D-FNPROPS: a function's synthesised `prototype` is non-configurable,
        ; so `delete f.prototype` answers false and the property survives. It is
        ; not own DATA, so the presence test below could not see it and the
        ; delete reported success.
        if (obj.isFunction()) {
            if (key == "prototype") {
                if (false == (obj.hasSuppressed(key))) {
                    if (false == (obj.hasOwnAttrs(key))) {
                        return true
                    }
                }
            }
        }
        ; D-ARRAYDEFINE: an array ELEMENT lives in the dense store, not in own
        ; data, so none of the checks below could see it and `delete a[0]`
        ; succeeded however the element was defined -- on a frozen array, on a
        ; sealed one, and on an index defineProperty had made non-configurable.
        ; That is also what the suite's own `isConfigurable` helper measures:
        ; it deletes the property and asks whether it is gone.
        if (obj.isArrayValue()) {
            def dIdx:double (this.canonicalArrayIndexD(key))
            if (dIdx >= 0.0) {
                if (dIdx >= (obj.arrayLengthD())) {
                    return false
                }
                ; A HOLE is not a property at all, so deleting it is a no-op
                ; rather than a refusal.
                if (dIdx <= 10000000.0) {
                    if ((obj.getIndex((to_int dIdx))).isHole()) {
                        return false
                    }
                }
                if (obj.isFrozenObj()) { return true }
                if (obj.isSealedObj()) { return true }
                if (obj.hasOwnAttrs(key)) {
                    return (false == (obj.isConfigurable(key)))
                }
                return false
            }
        }
        def present:boolean false
        if (obj.hasOwnData(key)) { present = true }
        if (obj.hasOwnGetter(key)) { present = true }
        if (obj.hasOwnSetter(key)) { present = true }
        if (false == present) {
            return false
        }
        return (false == (obj.isConfigurable(key)))
    }

    fn isBuiltinPrototypeObject:boolean (v:EvHandle) {
        ; Array.prototype is an array and Function.prototype is a function, so
        ; the check cannot be "is it a plain object".
        if (false == (this.isDescriptorObject(v))) {
            return false
        }
        def names:[string] (keys builtinProtos)
        def i:int 0
        while (i < (array_length names)) {
            def p:EvHandle (unwrap (get builtinProtos (itemAt names i)))
            if (p.equals(v)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn registryMethodDeleted:boolean (v:EvHandle name:string) {
        if (this.isDescriptorObject(v)) {
            if (v.hasSuppressed(name)) {
                if (false == (v.hasOwnData(name))) {
                    return true
                }
            }
        }
        return (this.kindRegistryDeleted((this.receiverKind(v)) name))
    }

    ; A method deleted off a KIND prototype leaves Object.prototype's own copy
    ; standing: `delete Number.prototype.toString` makes `(new Number()).toString()`
    ; the brand, not a TypeError. True when that fallback is available.
    fn objectProtoFallbackFor:boolean (kind:string name:string) {
        if (kind == "object") {
            return false
        }
        if (false == (this.hasBuiltin("object" name))) {
            return false
        }
        return (false == (this.kindRegistryDeleted("object" name)))
    }

    ; The same question asked of the receiver's KIND prototype, so an ordinary
    ; object stops finding `toString` once Object.prototype's is deleted. Only
    ; the kind's OWN prototype is consulted -- a deletion on Object.prototype
    ; does not reach a kind that publishes its own copy of the name, which is
    ; the shape the per-kind registry can express.
    fn kindRegistryDeleted:boolean (kind:string name:string) {
        def cn:string (this.ctorNameForKind(kind))
        ; The plain-object kind has no entry there -- ctorNameForKind answers ""
        ; so the override machinery leaves Object.prototype alone -- but a
        ; deletion recorded on it is exactly what an ordinary object must see.
        if (kind == "object") {
            cn = "Object"
        }
        if ((strlen cn) == 0) {
            return false
        }
        def found@(optional):EvHandle (get builtinProtos cn)
        if (null? found) {
            return false
        }
        def p:EvHandle (unwrap found)
        if (false == (p.hasSuppressed(name))) {
            return false
        }

        ; Putting the name BACK -- `Number.prototype.toString = saved` -- undoes
        ; the deletion. The record would otherwise outlive the property it
        ; describes and keep answering "gone" for something plainly there.
        if (p.hasOwnData(name)) {
            return false
        }
        return true
    }

    fn overriddenPrototypeMethod:EvHandle (kind:string name:string) {
        def cn:string (this.ctorNameForKind(kind))
        if ((strlen cn) == 0) {
            return (EvValueBridge.taggedNull())
        }
        ; Do not CREATE the prototype here: a prototype that has never been
        ; touched cannot carry an override, and creating one would populate it
        ; from the registry during dispatch.
        def found@(optional):EvHandle (get builtinProtos cn)
        if (null? found) {
            return (EvValueBridge.taggedNull())
        }
        def p:EvHandle (unwrap found)
        if (false == (p.hasOwnData(name))) {
            return (EvValueBridge.taggedNull())
        }
        def m:EvHandle (p.getOwnData(name))
        if (false == (m.isFunction())) {
            return (EvValueBridge.taggedNull())
        }
        ; PERF: ask the VALUE whether it is still the registered built-in rather
        ; than materialising the registered one and comparing identities. The
        ; prototypes are pre-populated, so the old form ran a string concat, a
        ; cache lookup and an identity compare on EVERY built-in method call --
        ; only to conclude "not overridden" almost every time.
        if (m.isBuiltinMethod()) {
            if (((m.builtinKindOf()) == kind) && ((m.builtinNameOf()) == name)) {
                return (EvValueBridge.taggedNull())
            }
        }
        return m
    }

    fn invokeBuiltin:EvHandle (kind:string name:string recv:EvHandle args:[EvHandle]) {
        def override:EvHandle (this.overriddenPrototypeMethod(kind name))
        if (override.isFunction()) {
            return (this.callFnValueWithValues((override.withThisForCall(recv)) args))
        }
        return (this.invokeBuiltinDirect(kind name recv args))
    }
    ; The registry body WITHOUT the per-call override probe -- for callers
    ; that already proved no override under the current dispatch epoch
    ; (the call-site ICs).
    fn invokeBuiltinDirect:EvHandle (kind:string name:string recv:EvHandle args:[EvHandle]) {
        ; Generator iteration over the buffer built at call time. next(v) takes
        ; no value: this implementation cannot deliver one back into the body.
        if (kind == "Generator") {
            def gk:[string]
            def gv:[EvHandle]
            def res:EvHandle (EvValueBridge.taggedObject(gk gv))
            ; A generator is its own iterator -- sync or async.
            if (name == "@@iterator") {
                return recv
            }
            if (name == "@@asyncIterator") {
                return recv
            }
            ; D-GENRESUME: a RESUMABLE generator's three methods are all one
            ; operation -- start the suspended body again, telling it how.
            if (this.isResumableGenerator(recv)) {
                def rMode:int 0
                if (name == "return") { rMode = 1 }
                if (name == "throw") { rMode = 2 }
                def rSent:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 0) {
                    rSent = (itemAt args 0)
                }
                ; D-ASYNCGEN: an async generator answers a PROMISE for the
                ; iteration result, and gets there by resuming past every
                ; `await` in the body until it reaches a yield.
                if (this.isAsyncGeneratorValue(recv)) {
                    return (this.asyncGenStep(recv rMode rSent))
                }
                return (this.genResume(recv rSent rMode))

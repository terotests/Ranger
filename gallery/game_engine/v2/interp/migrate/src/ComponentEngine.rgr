        ; The optional iterable initialiser: entries for a WeakMap, values for
        ; a WeakSet, and each of them checked exactly as an add would be.
        if ((array_length args) > 0) {
            def wInit:EvHandle (itemAt args 0)
            if (false == ((wInit.isUndefined()) || (wInit.isNull()))) {
                def wItems:[EvHandle] (this.forOfItemList(wInit))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())

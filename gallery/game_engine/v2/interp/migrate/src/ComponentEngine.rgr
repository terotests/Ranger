            return (EvValueBridge.taggedNumber(0.0))
        }
        ; The string forms report "Invalid Date" rather than propagating NaN.
        if (name == "toString") { return (EvValueBridge.taggedString((dtl.toFullString(tv)))) }
        if (name == "toDateString") { return (EvValueBridge.taggedString((dtl.toDateString(tv)))) }
        if (name == "toTimeString") { return (EvValueBridge.taggedString((dtl.toTimeString(tv)))) }
        ; D-INTL: §21.4.4.38-40 are defined as Intl.DateTimeFormat with the
        ; same arguments. They used to answer the non-locale forms, so a date
        ; in a German document came out in English.
        if ((name == "toLocaleString") || ((name == "toLocaleDateString") || (name == "toLocaleTimeString"))) {
            def dlTag:string ""
            if ((array_length args) > 0) {
                dlTag = (this.intlFirstTag((itemAt args 0)))
                if scriptThrew { return (EvValueBridge.taggedUndefined()) }
            }
            def dlLoc:int (this.localeIndexOf(dlTag))
            def dlWhich:int 0
            if (name == "toLocaleTimeString") { dlWhich = 4 }
            if (name == "toLocaleString") { dlWhich = 5 }
            return (EvValueBridge.taggedString((this.intlFormatDate(dlLoc dlWhich tv))))

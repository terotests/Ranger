                    }
                }
                return (EvalValue.string((this.toExponentialString(fnum edigits))))
            }
            if (name == "toPrecision") {
                if ((array_length args) == 0) {
                    return (EvalValue.string((this.toStringOf(fprim))))
                }
                def pv:EvalValue (itemAt args 0)
                if (pv.isUndefined()) {
                    return (EvalValue.string((this.toStringOf(fprim))))
                }
                def prec:int (this.toIntegerOf(pv))
                if ((prec < 1) || (prec > 100)) {
                    return (this.throwSpecError("RangeError" "toPrecision() argument must be between 1 and 100"))
                }
                return (EvalValue.string((this.toPrecisionString(fnum prec))))
            }
        }
        if (kind == "function") {
            ; call/apply/bind operate ON a function. Reaching them with a
            ; non-callable receiver — `var c = f.call; c(x)` — is a TypeError,
            ; which is exactly what an unbound extraction must produce.
            if (recv.valueType != 6) {
                return (this.throwSpecError("TypeError" (name + " called on a non-function")))
            }
            if (name == "call") {
                def callThis:EvalValue (EvalValue.undefined())
                def rest:[EvalValue]
                def i:int 0
                while (i < (array_length args)) {
                    if (i == 0) {
                        callThis = (itemAt args 0)
                    } {
                        push rest (itemAt args i)
                    }
                    i = (i + 1)
                }
                def b1:EvalValue (recv.withThis(callThis))
                return (this.callFnValueWithValues(b1 rest))
            }
            if (name == "apply") {
                def applyThis:EvalValue (EvalValue.undefined())
                def aargs:[EvalValue]
                if ((array_length args) > 0) {
                    applyThis = (itemAt args 0)
                }
                if ((array_length args) > 1) {
                    def arr:EvalValue (itemAt args 1)
                    ; CreateListFromArrayLike: any object with a length works,
                    ; which is what lets `f.apply(null, arguments)` forward a
                    ; call. A primitive that is not null/undefined is a
                    ; TypeError rather than an empty argument list.
                    if (false == ((arr.isNull()) || (arr.isUndefined()))) {
                        def okArgs:boolean false
                        if (arr.valueType == 4) { okArgs = true }
                        if (arr.valueType == 5) { okArgs = true }
                        if (false == okArgs) {
                            return (this.throwSpecError("TypeError" "CreateListFromArrayLike called on non-object"))
                        }
                        def alist:[EvalValue] (this.arrayLikeElements(arr))
                        def k:int 0
                        while (k < (array_length alist)) {
                            push aargs (itemAt alist k)
                            k = (k + 1)
                        }
                    }
                }
                def b2:EvalValue (recv.withThis(applyThis))
                return (this.callFnValueWithValues(b2 aargs))
            }
            if (name == "bind") {
                def bindThis:EvalValue (EvalValue.undefined())
                def partial:[EvalValue]
                def j:int 0
                while (j < (array_length args)) {
                    if (j == 0) {
                        bindThis = (itemAt args 0)
                    } {
                        push partial (itemAt args j)
                    }
                    j = (j + 1)
                }
                def b3:EvalValue (recv.withThis(bindThis))
                b3.boundArgs = partial
                b3.boundExplicit = true
                b3.functionName = ("bound " + recv.functionName)
                return b3
            }
        }
        return (EvalValue.undefined())
    }

    ; D-ARGCHECK: Object statics whose first argument must be an object. Note
    ; what is NOT here: keys/values/entries/assign/getOwnPropertyNames coerce in
    ; ES2015+ rather than throwing, but throw on null/undefined specifically —
    ; handled by the nullish check at the call site. freeze/seal/isFrozen/
    ; isSealed/isExtensible accept anything and are deliberately absent.
    ; Statics that genuinely REQUIRE an object argument in the current spec.
    ; Array methods whose first argument must be callable.
    ; D-WRAPPER: constructors whose instances box a primitive.
    fn isWrapperCtorName:boolean (name:string) {
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        return false
    }

    ; The boxed object. `__primitive__` is the internal slot; the wrapper reports
    ; the primitive's receiver kind so String.prototype methods dispatch to it.
    ; D-TOOBJECT: ToObject. A primitive is BOXED rather than handed back
    ; unchanged -- `Object(5)` is a Number object, and `typeof Object(5)` is
    ; "object", which the old passthrough got wrong. null/undefined (and the
    ; no-argument form, which arrives as a null EvalValue) make a fresh object.
    fn toObjectValue:EvalValue (v:EvalValue) {
        if (v.valueType == 2) { return (this.makeWrapper("String" v)) }
        if (v.valueType == 1) { return (this.makeWrapper("Number" v)) }
        if (v.valueType == 3) { return (this.makeWrapper("Boolean" v)) }
        if ((v.valueType == 0) || (v.isUndefined())) {
            def keysO:[string]
            def valsO:[EvalValue]
            def o:EvalValue (EvalValue.object(keysO valsO))
            o.protoRef = (this.builtinPrototype("Object"))
            return o
        }
        return v
    }

    fn makeWrapper:EvalValue (ctorName:string prim:EvalValue) {
        def keysW:[string]
        def valsW:[EvalValue]
        def w:EvalValue (EvalValue.object(keysW valsW))
        def p:EvalValue prim
        if (ctorName == "String") {
            if (prim.valueType == 0) {
                p = (EvalValue.string(""))
            } {
                p = (EvalValue.string((this.toStringOf(prim))))
            }
        }
        if (ctorName == "Number") {
            ; `new Number()` is +0, but `new Number(undefined)` is NaN -- the
            ; absence of an argument and an undefined argument are different
            ; things, and the caller signals which by passing a null EvalValue.
            if (prim.valueType == 0) {
                p = (EvalValue.number(0.0))
            } {
                p = (EvalValue.number((this.toNumberOf(prim))))
            }
        }
        if (ctorName == "Boolean") {
            p = (EvalValue.boolean((prim.toBool())))
        }
        w.setMember("__primitive__" p)
        w.setMember("__wrapper__" (EvalValue.string(ctorName)))
        ; A boxed string exposes `length` as a real own property, which is what
        ; `with ('ab') { length }` resolves against, plus one own property per
        ; index. Both are what `Object.keys(new String('ab'))` reports -- the
        ; indices are enumerable, `length` is not.
        if (ctorName == "String") {
            def sw:string p.stringValue
            def ci:int 0
            while (ci < (strlen sw)) {
                w.setMember((to_string ci) (EvalValue.string((substring sw ci (ci + 1)))))
                w.setAttrs((to_string ci) false true false)
                ci = (ci + 1)
            }
            w.setMember("length" (EvalValue.fromInt((strlen sw))))
            w.setAttrs("length" false false false)
        }
        w.protoRef = (this.builtinPrototype(ctorName))
        return w
    }

    ; ==========================================================================
    ; D-CLASSOF: the [[Class]] brand, as ES5 15.2.4.2 exposes it through
    ; Object.prototype.toString.
    ; --------------------------------------------------------------------------
    ; This is the only place the language lets a program observe a value's
    ; internal type, and the suite leans on it hard: 86 ES5 files capture
    ; `Object.prototype.toString` under the name `getClass` and assert the brand
    ; of what they just built. The engine answered "[object Object]" for
    ; everything, so an array, a boxed number and a plain object were
    ; indistinguishable and every one of those assertions failed.
    ;
    ; A boxed primitive brands as its constructor, not as Object -- that is the
    ; whole point of the wrapper -- so the check reads the internal slot rather
    ; than the value type.
    ; --------------------------------------------------------------------------
    fn objectClassOf:string (v:EvalValue) {
        if (v.isUndefined()) { return "Undefined" }
        if (v.valueType == 0) { return "Null" }
        if (v.valueType == 4) { return "Array" }
        if (v.valueType == 6) { return "Function" }
        if (v.valueType == 2) { return "String" }
        if (v.valueType == 1) { return "Number" }
        if (v.valueType == 3) { return "Boolean" }
        if (v.valueType == 5) {
            if (has v.objectMap "__nsbrand__") {
                return ((unwrap (get v.objectMap "__nsbrand__")).toString())
            }
            if (has v.objectMap "__wrapper__") {
                return ((unwrap (get v.objectMap "__wrapper__")).toString())
            }
            ; An error INSTANCE brands as Error; Error.prototype is an ordinary
            ; object and brands as Object, which is why the marker is checked on
            ; the own map rather than through the prototype chain.
            if (has v.objectMap "__error__") { return "Error" }
            if (has v.objectMap "__date__") { return "Date" }
            if (has v.objectMap "__arguments__") { return "Arguments" }
        }
        return "Object"
    }

    ; The primitive inside a wrapper, or the value itself when it is not one.
    fn unwrapPrimitive:EvalValue (v:EvalValue) {
        if (v.valueType == 5) {
            if (has v.objectMap "__primitive__") {
                return (unwrap (get v.objectMap "__primitive__"))
            }
        }
        return v
    }

    ; ==========================================================================
    ; D-TOPRIMITIVE: converting an object to a primitive, the way every operator
    ; that is not `===` does it.
    ; --------------------------------------------------------------------------
    ; The operators read raw values, so an object went straight to its debug
    ; form: `({valueOf: function () { return 5; }}) + 1` produced a string
    ; instead of 6, and every comparison against an object compared text. The
    ; whole language/expressions area turns on this -- addition, the relational
    ; operators, the bitwise operators and compound assignment all funnel
    ; through ToPrimitive then ToNumber.
    ;
    ; Number hint tries valueOf then toString; string hint the other way. A
    ; method that returns an object is skipped, per spec, rather than accepted.
    ; --------------------------------------------------------------------------
    fn callPrimitiveMethod:EvalValue (obj:EvalValue name:string) {
        primitiveMethodUsable = false
        def m:EvalValue (obj.getMember(name))
        if (m.valueType == 6) {
            if m.functionNode {
                def noArgs:[EvalValue]
                def bound:EvalValue (m.withThis(obj))
                def out:EvalValue (this.callFnValueWithValues(bound noArgs))
                ; A throw from the guest's own valueOf/toString is the answer.
                ; Swallowing it here let ToPrimitive carry on and raise its own
                ; TypeError instead, so the exception the test threw never
                ; reached the catch that was waiting for it.
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                ; An OBJECT result is not a primitive, so the method is skipped
                ; and the other one tried. Arrays and functions are objects too.
                if (out.valueType == 5) {
                    return (EvalValue.null())
                }
                if (out.valueType == 4) {
                    return (EvalValue.null())
                }
                if (out.valueType == 6) {
                    return (EvalValue.null())
                }
                ; A method that falls off its end returns UNDEFINED, which is a
                ; perfectly good primitive. The engine represents "no return" as
                ; null, which is also this function's "not usable" sentinel, so
                ; the two are told apart by the flag rather than by the value.
                primitiveMethodUsable = true
                if (out.valueType == 0) {
                    return (EvalValue.undefined())
                }
                return out
            }
        }
        return (EvalValue.null())
    }

    ; Lexicographic comparison by code unit: -1, 0 or 1. Ranger has no string
    ; relational operator, and comparing via toNumber would make "10" < "9"
    ; answer the numeric question instead of the textual one.
    fn compareStrings:int (a:string b:string) {
        def la:int (strlen a)
        def lb:int (strlen b)
        def n:int la
        if (lb < n) {
            n = lb
        }
        def i:int 0
        while (i < n) {
            def ca:int (charAt a i)
            def cb:int (charAt b i)
            if (ca < cb) { return (0 - 1) }
            if (ca > cb) { return 1 }
            i = (i + 1)
        }
        if (la < lb) { return (0 - 1) }
        if (la > lb) { return 1 }
        return 0
    }

    fn toPrimitive:EvalValue (v:EvalValue wantString:boolean) {
        ; Arrays and functions are object-like too and must convert, which is
        ; why `[1,2] + ''` is "1,2". A guest override of Array.prototype or
        ; Function.prototype toString wins over the built-in rendering, so the
        ; method is looked for BEFORE falling back to it.
        if (v.isArray()) {
            def ar:EvalValue (this.callPrimitiveMethod(v "toString"))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            if primitiveMethodUsable {
                return ar
            }
            return (EvalValue.string((this.arrayJoinString(v ","))))
        }
        if (v.valueType == 6) {
            def fr:EvalValue (this.callPrimitiveMethod(v "toString"))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            if primitiveMethodUsable {
                return fr
            }
            return (EvalValue.string(("function " + v.functionName + "() { [native code] }")))
        }
        if (v.valueType != 5) {
            return v
        }
        ; A boxed primitive is its primitive.
        if (has v.objectMap "__primitive__") {
            return (unwrap (get v.objectMap "__primitive__"))
        }
        def first:string "valueOf"
        def second:string "toString"
        if wantString {
            first = "toString"
            second = "valueOf"
        }
        def r1:EvalValue (this.callPrimitiveMethod(v first))
        if scriptThrew {
            return (EvalValue.undefined())
        }
        if primitiveMethodUsable {
            return r1
        }
        ; With a string hint and no user toString, the DEFAULT toString applies
        ; and succeeds, so valueOf is never reached: `String({valueOf: …})` is
        ; the brand, not the number valueOf would have given.
        if wantString {
            ; Only when `toString` resolves to the BUILT-IN one. A property that
            ; exists but is not callable (`{toString: undefined}`) is skipped,
            ; and valueOf gets its turn.
            if (this.usesDefaultToString(v)) {
                return (EvalValue.string(("[object " + (this.objectClassOf(v)) + "]")))
            }
        }
        def r2:EvalValue (this.callPrimitiveMethod(v second))
        if scriptThrew {
            return (EvalValue.undefined())
        }
        if primitiveMethodUsable {
            return r2
        }
        ; Neither yielded a primitive. If the object supplied its own methods,
        ; that is the spec's TypeError -- an object whose valueOf and toString
        ; both return objects cannot be converted, and the suite checks that it
        ; says so rather than inventing an answer.
        ; The DEFAULT valueOf returns the object itself, which is not a
        ; primitive either, so one usable-but-object-returning method is enough
        ; to make the conversion impossible.
        if (this.hasUserMethod(v "valueOf")) {
            return (this.throwSpecError("TypeError" "Cannot convert object to primitive value"))
        }
        if (this.hasUserMethod(v "toString")) {
            return (this.throwSpecError("TypeError" "Cannot convert object to primitive value"))
        }
        ; Otherwise the inherited Object.prototype.toString applies, which is
        ; what makes `String({valueOf: function () { return 7; }})` the brand
        ; rather than 7 -- the string hint never reaches valueOf when the
        ; default toString is in play.
        return (EvalValue.string(("[object " + (this.objectClassOf(v)) + "]")))
    }

    ; A method the GUEST defined, as opposed to one inherited from a built-in
    ; prototype. The difference decides whether a failed ToPrimitive is an error
    ; or falls back to the default rendering.
    ; True when `toString` on this object is the inherited built-in rather than
    ; something the guest supplied -- callable or not.
    fn usesDefaultToString:boolean (v:EvalValue) {
        ; An OWN `toString` shadows the default even when its value is
        ; undefined: the property is there, it is simply not callable, so
        ; ToPrimitive skips it and valueOf gets its turn.
        if (has v.objectMap "toString") {
            return false
        }
        def m:EvalValue (v.getMember("toString"))
        if (m.valueType == 6) {
            if (null? m.functionNode) {
                return true
            }
            return false
        }
        ; Present but not a function: not the default, and not usable either --
        ; ToPrimitive skips it and tries valueOf.
        if (false == (m.isUndefined())) {
            return false
        }
        return true
    }

    fn hasUserMethod:boolean (v:EvalValue name:string) {
        def m:EvalValue (v.getMember(name))
        if (m.valueType != 6) {
            return false
        }
        if (null? m.functionNode) {
            return false
        }
        return true
    }

    ; ToNumber, honouring ToPrimitive for objects.
    ; D-STRNUM: ToNumber applied to a string, per the StringNumericLiteral
    ; grammar rather than by handing the text to the host parser. Two things go
    ; wrong otherwise: the host parse is LENIENT, so "12x" came back as 12 where
    ; the spec says NaN, and it knows nothing of the 0x / 0b / 0o prefixes, so
    ; Number("0xff") was 0.
    fn stringToNumber:double (raw:string) {
        def nan:double (0.0 / 0.0)
        def inf:double (1.0 / 0.0)
        def s:string (trim raw)
        def n:int (strlen s)
        if (n == 0) {
            return 0.0
        }
        ; Sign, which only a decimal literal or Infinity may carry.
        def sign:double 1.0
        def i:int 0
        def first:string (substring s 0 1)
        if (first == "-") {
            sign = (0.0 - 1.0)
            i = 1
        }
        if (first == "+") {
            i = 1
        }
        def body:string (substring s i n)
        if (body == "Infinity") {
            return (sign * inf)
        }
        if ((strlen body) == 0) {
            return nan
        }
        ; A radix prefix is only legal WITHOUT a sign.
        if ((i == 0) && ((strlen s) > 2)) {
            def p2:string (substring s 0 2)
            def radix:int 0
            if ((p2 == "0x") || (p2 == "0X")) { radix = 16 }
            if ((p2 == "0b") || (p2 == "0B")) { radix = 2 }
            if ((p2 == "0o") || (p2 == "0O")) { radix = 8 }
            if (radix > 0) {
                def digits:string (substring s 2 (strlen s))
                return (this.digitsToNumber(digits radix))
            }
        }
        ; Decimal: the whole remainder must be a well-formed literal, or the
        ; answer is NaN. The host parser stops at the first bad character and
        ; reports what it read, which is why this is validated first.
        if (false == (this.isDecimalLiteral(body))) {
            return nan
        }
        def d@(optional):double (to_double body)
        if d {
            return (sign * (unwrap d))
        }
        return nan
    }

    ; Digits in a given radix, or NaN when any character is not a digit of it.
    fn digitsToNumber:double (digits:string radix:int) {
        def nan:double (0.0 / 0.0)
        def n:int (strlen digits)
        if (n == 0) {
            return nan
        }
        def acc:double 0.0
        def i:int 0
        while (i < n) {
            def c:int (charAt digits i)
            def dv:int (0 - 1)
            if ((c >= 48) && (c <= 57)) { dv = (c - 48) }
            if ((c >= 97) && (c <= 122)) { dv = ((c - 97) + 10) }
            if ((c >= 65) && (c <= 90)) { dv = ((c - 65) + 10) }
            if (dv < 0) { return nan }
            if (dv >= radix) { return nan }
            acc = ((acc * (to_double radix)) + (to_double dv))
            i = (i + 1)
        }
        return acc
    }

    ; DecimalLiteral: digits with at most one dot, an optional exponent, and at
    ; least one digit in the mantissa.
    fn isDecimalLiteral:boolean (s:string) {
        def n:int (strlen s)
        if (n == 0) {
            return false
        }
        def i:int 0
        def mantissaDigits:int 0
        def dots:int 0
        def seenExp:boolean false
        def expDigits:int 0
        while (i < n) {
            def c:int (charAt s i)
            def isDigit:boolean ((c >= 48) && (c <= 57))
            if seenExp {
                if isDigit {
                    expDigits = (expDigits + 1)
                } {
                    ; A sign is allowed, but only right after the e.
                    if ((c == 43) || (c == 45)) {
                        if (expDigits > 0) { return false }
                        ; and only once, which a second sign would violate
                        if (i > 0) {
                            def prev:int (charAt s (i - 1))
                            if ((prev != 101) && (prev != 69)) { return false }
                        }
                    } {
                        return false
                    }
                }
            } {
                if isDigit {
                    mantissaDigits = (mantissaDigits + 1)
                } {
                    if (c == 46) {
                        dots = (dots + 1)
                        if (dots > 1) { return false }
                    } {
                        if ((c == 101) || (c == 69)) {
                            if (mantissaDigits == 0) { return false }
                            seenExp = true
                        } {
                            return false
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if (mantissaDigits == 0) {
            return false
        }
        if seenExp {
            if (expDigits == 0) { return false }
        }
        return true
    }

    ; ToInteger: ToNumber, then truncate toward zero, with NaN becoming 0. The
    ; argument-taking Number methods are specified against this, and handing
    ; `to_int` a NaN directly produced a nonsense digit count.
    fn toIntegerOf:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        if (d != d) {
            return 0
        }
        if (false == (this.isFiniteNum(d))) {
            if (d > 0.0) { return 2147483647 }
            return (0 - 2147483647)
        }
        ; Truncate TOWARD ZERO. `to_int` floors on this backend, so -0.1 became
        ; -1 and `(1).toFixed(-0.1)` raised a RangeError where the spec asks for
        ; ToInteger(-0.1) = 0.
        if (d < 0.0) {
            return (0 - (to_int (0.0 - d)))
        }
        return (to_int d)
    }

    ; ToUint16: ToInteger, then reduced modulo 2^16 into [0, 65535].
    ; ToInt32: ToNumber, truncate, then wrap modulo 2^32 into the signed range.
    ; The bitwise and shift operators are all specified against it, and reading
    ; `.toNumber()` off the value skipped the object conversion entirely --
    ; `({valueOf: function () { return 1; }}) << 1` answered 0.
    fn toInt32Of:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        if (d != d) { return 0 }
        if (false == (this.isFiniteNum(d))) { return 0 }
        def t:double (this.floorNum(d))
        if (d < 0.0) {
            t = (0.0 - (this.floorNum((0.0 - d))))
        }
        def m:double (this.wrapUint32(t))
        def half:double 2147483648.0
        if (m >= half) {
            m = (m - (half * 2.0))
        }
        return (to_int m)
    }

    ; The value reduced into [0, 2^32).
    fn wrapUint32:double (t:double) {
        def two32:double 4294967296.0
        def q:double (this.floorNum((t / two32)))
        def m:double (t - (q * two32))
        if (m < 0.0) { m = (m + two32) }
        return m
    }

    fn toUint16Of:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        ; NaN and the infinities all map to +0 before the modulo, so
        ; String.fromCharCode(Infinity) is "\u0000" rather than "\uffff".
        if (d != d) {
            return 0
        }
        if (false == (this.isFiniteNum(d))) {
            return 0
        }
        def i:int (this.toIntegerOf(v))
        def m:int (i % 65536)
        if (m < 0) {
            m = (m + 65536)
        }
        return m
    }

    fn toNumberOf:double (v:EvalValue) {
        def p:EvalValue (this.toPrimitive(v false))
        if (p.isString()) {
            return (this.stringToNumber(p.stringValue))
        }
        if (p.isUndefined()) {
            return (0.0 / 0.0)
        }
        if (p.isNull()) {
            return 0.0
        }
        return (p.toNumber())
    }

    fn arrayNeedsCallback:boolean (name:string) {
        if (name == "forEach") { return true }
        if (name == "map") { return true }
        if (name == "filter") { return true }
        if (name == "find") { return true }
        if (name == "findIndex") { return true }
        if (name == "some") { return true }
        if (name == "every") { return true }
        if (name == "reduce") { return true }
        if (name == "reduceRight") { return true }
        return false
    }

    ; D-DESCVALID: a property descriptor may be a DATA descriptor (value and/or
    ; writable) or an ACCESSOR descriptor (get and/or set), never both, and its
    ; get/set must be callable. Accepting a contradictory descriptor silently
    ; produced a property that matched neither shape.
    fn descriptorError:string (d:EvalValue) {
        def hasValue:boolean (has d.objectMap "value")
        def hasWritable:boolean (has d.objectMap "writable")
        def hasGet:boolean (has d.objectMap "get")
        def hasSet:boolean (has d.objectMap "set")
        if (hasGet || hasSet) {
            if (hasValue || hasWritable) {
                return "descriptor cannot be both a data and an accessor descriptor"
            }
            if hasGet {
                def g:EvalValue (d.getMember("get"))
                if (g.valueType != 6) {
                    if (false == (g.isUndefined())) {
                        return "getter must be a function"
                    }
                }
            }
            if hasSet {
                def st:EvalValue (d.getMember("set"))
                if (st.valueType != 6) {
                    if (false == (st.isUndefined())) {
                        return "setter must be a function"
                    }
                }
            }
        }
        return ""
    }

    ; D-REDEFINE: whether a defineProperty call is legal against the property
    ; that is already there. A NON-CONFIGURABLE property is close to frozen: its
    ; configurable and enumerable flags cannot change, and if it is also
    ; non-writable neither its writability nor its value may change. Adding a
    ; new property to a non-extensible object is likewise rejected. Accepting
    ; any of these silently let a test's setup succeed where the spec requires
    ; it to fail. Returns "" when the redefinition is allowed.
    ; D-ARRAYLIKE: the optional thisArg every higher-order Array method takes as
    ; its SECOND argument. It was ignored, so a callback written against a
    ; receiver -- `arr.filter(function (v) { return v === this.n; }, ctx)` --
    ; saw undefined for `this` and quietly filtered everything out. A callback
    ; that already carries its own binding (an arrow, or a bound function) keeps
    ; it, which is why the existing binding is checked first.
    fn withCallbackThis:EvalValue (cb:EvalValue args:[EvalValue]) {
        if ((array_length args) < 2) {
            return cb
        }
        if cb.boundThis {
            return cb
        }
        return (cb.withThis((itemAt args 1)))
    }

    ; D-ARRAYLIKE: the elements of any array-like receiver -- ToLength(this.length)
    ; entries read by index, with a missing index reading as undefined. This is
    ; how every non-mutating Array.prototype method is specified to see its
    ; receiver, and it is what lets `arguments` and `{length: n, …}` be passed
    ; through .call().
    fn arrayLikeElements:[EvalValue] (v:EvalValue) {
        def out:[EvalValue]
        if (v.isArray()) {
            return v.arrayValue
        }
        if (v.isString()) {
            def si:int 0
            while (si < (strlen v.stringValue)) {
                push out (EvalValue.string((substring v.stringValue si (si + 1))))
                si = (si + 1)
            }
            return out
        }
        def lenV:EvalValue (v.getMember("length"))
        if (lenV.isUndefined()) {
            return out
        }
        def n:int (to_int (lenV.toNumber()))
        if (n < 0) {
            return out
        }
        ; A hostile length is a hang, not a test failure, so it is capped.
        if (n > 1000000) {
            n = 1000000
        }
        def i:int 0
        while (i < n) {
            push out (v.getMember((to_string i)))
            i = (i + 1)
        }
        return out
    }

    ; ToString: an object runs its own toString/valueOf, everything else answers
    ; for itself.
    fn toStringOf:string (v:EvalValue) {
        if (v.isString()) {
            return v.stringValue
        }
        def p:EvalValue v
        if (v.valueType == 5) { p = (this.toPrimitive(v true)) }
        if (v.valueType == 4) { p = (this.toPrimitive(v true)) }
        if (p.isString()) {
            return p.stringValue
        }
        return (p.toString())
    }

    ; ToPropertyKey. A property name is whatever ToString says, so an object or
    ; an array used as a key runs its own toString: `gOPD(obj, [1])` asks for
    ; "1". The raw EvalValue.toString() is the engine's DEBUG rendering, which
    ; for an array is not the same string at all.
    fn toPropertyKey:string (v:EvalValue) {
        if (v.isString()) {
            return v.stringValue
        }
        def p:EvalValue v
        if (v.valueType == 5) { p = (this.toPrimitive(v true)) }
        if (v.valueType == 4) { p = (this.toPrimitive(v true)) }
        if (p.isString()) {
            return p.stringValue
        }
        return (p.toString())
    }

    ; ToPropertyDescriptor rejects anything that is not an Object -- which
    ; includes arrays and functions, so the check cannot simply be "is a plain
    ; object". `Object.defineProperty(o, 'k', function () {})` is legal and
    ; defines an undefined-valued property.
    fn isDescriptorObject:boolean (v:EvalValue) {
        if (v.valueType == 5) { return true }
        if (v.valueType == 4) { return true }
        if (v.valueType == 6) { return true }
        if (v.valueType == 9) { return true }
        if (v.valueType == 10) { return true }
        return false
    }

    ; D-DEFINEOWN: one [[DefineOwnProperty]], shared by Object.defineProperty and
    ; Object.defineProperties. The two had separate copies and only the singular
    ; form validated anything, so `Object.defineProperties(o, {p: true})` quietly
    ; created `p` with value undefined instead of throwing, and the plural form
    ; would happily redefine a non-configurable property.
    ;
    ; Returns "" on success, or the TypeError message to raise.
    fn definePropertyOn:string (obj:EvalValue key:string desc:EvalValue) {
        if (false == (this.isDescriptorObject(desc))) {
            return "Property description must be an object"
        }
        def dErr:string (this.descriptorError(desc))
        if ((strlen dErr) > 0) {
            return dErr
        }
        def rErr:string (this.redefineError(obj key desc))
        if ((strlen rErr) > 0) {
            return rErr
        }
        def gv:EvalValue (desc.getMember("get"))
        def sv:EvalValue (desc.getMember("set"))
        if ((gv.valueType == 6) || (sv.valueType == 6)) {
            ; D-ACCESSORS: a real accessor property. The functions are stored
            ; apart from objectMap so the property is never mistaken for a data
            ; one.
            if (gv.valueType == 6) {
                obj.defineGetter(key gv)
            }
            if (sv.valueType == 6) {
                obj.defineSetter(key sv)
            }
            obj.setAttrs(key false ((desc.getMember("enumerable")).toBool()) ((desc.getMember("configurable")).toBool()))
            return ""
        }
        ; D-ATTRS: defineProperty defaults every attribute to FALSE, unlike plain
        ; assignment which defaults them all true. Recording that is what lets a
        ; descriptor report honestly. Written through the raw map because
        ; setMember would refuse a second defineProperty on a non-writable
        ; property, while redefining a CONFIGURABLE one is allowed.
        set obj.objectMap key (desc.getMember("value"))
        obj.setAttrs(key ((desc.getMember("writable")).toBool()) ((desc.getMember("enumerable")).toBool()) ((desc.getMember("configurable")).toBool()))
        return ""
    }

    fn redefineError:string (obj:EvalValue key:string desc:EvalValue) {
        ; An accessor property lives in getterMap/setterMap rather than
        ; objectMap, so existence has to be asked of all three. Checking only
        ; objectMap made every accessor look absent, which meant none of the
        ; rules below ever applied to one.
        def isAccessor:boolean false
        if (has obj.getterMap key) { isAccessor = true }
        if (has obj.setterMap key) { isAccessor = true }
        def exists:boolean isAccessor
        if (has obj.objectMap key) { exists = true }
        if (false == exists) {
            if (false == obj.extensibleFlag) {
                return "cannot add property to a non-extensible object"
            }
            return ""
        }
        if (obj.isConfigurable(key)) {
            return ""
        }
        ; Non-configurable from here on. configurable and enumerable are frozen
        ; whichever category the property is.
        if (has desc.objectMap "configurable") {
            if ((desc.getMember("configurable")).toBool()) {
                return "cannot redefine a non-configurable property as configurable"
            }
        }
        if (has desc.objectMap "enumerable") {
            def wantE:boolean ((desc.getMember("enumerable")).toBool())
            if (wantE != (obj.isEnumerable(key))) {
                return "cannot change enumerable of a non-configurable property"
            }
        }
        ; A non-configurable property cannot change category either. Both
        ; directions matter: data -> accessor and accessor -> data.
        def wantsAccessor:boolean false
        if (has desc.objectMap "get") { wantsAccessor = true }
        if (has desc.objectMap "set") { wantsAccessor = true }
        def wantsData:boolean false
        if (has desc.objectMap "value") { wantsData = true }
        if (has desc.objectMap "writable") { wantsData = true }
        if (isAccessor) {
            if wantsData {
                return "cannot redefine a non-configurable accessor property as a data property"
            }
            ; Same category: the accessor functions themselves are frozen too.
            if (has desc.objectMap "get") {
                def curG:EvalValue (obj.findGetter(key 0))
                if (false == (curG.equals((desc.getMember("get"))))) {
                    return "cannot change the getter of a non-configurable property"
                }
            }
            if (has desc.objectMap "set") {
                def curS:EvalValue (obj.findSetter(key 0))
                if (false == (curS.equals((desc.getMember("set"))))) {
                    return "cannot change the setter of a non-configurable property"
                }
            }
            return ""
        }
        if wantsAccessor {
            return "cannot redefine a non-configurable data property as an accessor property"
        }
        if (obj.isWritable(key)) {
            return ""
        }
        ; Non-configurable AND non-writable: value and writability are frozen.
        if (has desc.objectMap "writable") {
            if ((desc.getMember("writable")).toBool()) {
                return "cannot make a non-configurable, non-writable property writable"
            }
        }
        if (has desc.objectMap "value") {
            def cur:EvalValue (obj.getMember(key))
            def want:EvalValue (desc.getMember("value"))
            if (false == (cur.equals(want))) {
                return "cannot change the value of a non-configurable, non-writable property"
            }
        }
        return ""
    }

    fn objectStaticNeedsObject:boolean (name:string) {
        if (name == "defineProperty") { return true }
        if (name == "defineProperties") { return true }
        if (name == "setPrototypeOf") { return true }
        if (name == "create") { return true }
        return false
    }

    ; Statics that COERCE their argument to an object and throw only on
    ; null/undefined. ES5.1 threw for any non-object here, and modelling that
    ; older rule made Object.keys('abc') a TypeError instead of ["0","1","2"] --
    ; Test262 tracks the current spec, so the stricter reading cost score even
    ; on tests tagged es5id.
    fn objectStaticCoerces:boolean (name:string) {
        if (name == "keys") { return true }
        if (name == "values") { return true }
        if (name == "entries") { return true }
        if (name == "getOwnPropertyNames") { return true }
        if (name == "getOwnPropertyDescriptor") { return true }
        if (name == "getPrototypeOf") { return true }
        return false
    }

    fn errorKindNames:[string] () {
        def out:[string]
        push out "Error"
        push out "TypeError"
        push out "ReferenceError"
        push out "RangeError"
        push out "SyntaxError"
        push out "EvalError"
        push out "URIError"
        return out
    }

    ; D-SYMBOL: `Symbol` as a global with the well-known symbols. Each is a
    ; distinct object value, so `Symbol.iterator !== Symbol.asyncIterator` and a
    ; symbol compares equal only to itself — the property tests rely on that.
    ; Symbol() as a factory is handled at the call site; this seeds the statics.
    fn ensureSymbolGlobal:void () {
        def existing:EvalValue (hostScope.lookup("Symbol"))
        if (existing.valueType == 6) {
            return
        }
        def sym:EvalValue (EvalValue.nativeFunction("Symbol"))
        sym.setMember("name" (EvalValue.string("Symbol")))
        def wk:[string]
        push wk "iterator"
        push wk "asyncIterator"
        push wk "hasInstance"
        push wk "toPrimitive"
        push wk "toStringTag"
        push wk "species"
        push wk "isConcatSpreadable"
        push wk "unscopables"
        push wk "match"
        push wk "replace"
        push wk "search"
        push wk "split"
        def i:int 0
        while (i < (array_length wk)) {
            def nm:string (itemAt wk i)
            def keysS:[string]
            def valsS:[EvalValue]
            def s:EvalValue (EvalValue.object(keysS valsS))
            s.setMember("__symbol__" (EvalValue.string(nm)))
            s.setMember("description" (EvalValue.string(("Symbol." + nm))))
            sym.setMember(nm s)
            i = (i + 1)
        }
        hostScope.define("Symbol" sym)
        ; D-EVAL: eval is seeded as a real function value so `typeof eval` is
        ; "function". Calls are intercepted by name before reaching this value,
        ; which is what keeps it DIRECT eval (running in the caller's scope)
        ; rather than an ordinary function call with its own frame.
        def ev:EvalValue (EvalValue.nativeFunction("eval"))
        ev.setMember("name" (EvalValue.string("eval")))
        hostScope.define("eval" ev)
    }

    fn ensureErrorCtors:void () {
        if errorCtorsReady {
            return
        }
        errorCtorsReady = true
        this.ensureSymbolGlobal()
        def names:[string] (this.errorKindNames())
        def i:int 0
        while (i < (array_length names)) {
            def nm:string (itemAt names i)
            def c:EvalValue (EvalValue.nativeFunction(nm))
            c.setMember("name" (EvalValue.string(nm)))
            c.setMember("__errorctor__" (EvalValue.string(nm)))
            hostScope.define(nm c)
            i = (i + 1)
        }
    }

    ; The constructor function value for a kind ("TypeError"), or null when the
    ; name is not an error constructor.
    fn errorCtorFor:EvalValue (kind:string) {
        this.ensureErrorCtors()
        return (hostScope.lookup(kind))
    }

    ; Build an error object: { name, message, constructor } plus a marker the
    ; engine uses to recognise it. `constructor` is the shared singleton.
    fn makeError:EvalValue (kind:string message:string) {
        def keys0:[string]
        def vals0:[EvalValue]
        def e:EvalValue (EvalValue.object(keys0 vals0))
        e.setMember("name" (EvalValue.string(kind)))
        e.setMember("message" (EvalValue.string(message)))
        e.setMember("__error__" (EvalValue.string(kind)))
        def ctor:EvalValue (this.errorCtorFor(kind))
        if (ctor.valueType == 6) {
            e.setMember("constructor" ctor)
        }
        return e
    }

    ; Raise a spec error. Sets the same unwind flags a guest `throw` sets, so a
    ; try/catch around the offending code catches it exactly like any other throw.
    fn throwSpecError:EvalValue (kind:string message:string) {
        scriptThrowValue = (this.makeError(kind message))
        scriptThrew = true
        return (EvalValue.undefined())
    }

    ; Names the engine resolves structurally rather than through a binding
    ; (Math.PI, JSON.stringify, Object.keys …). Reading one of these bare must
    ; not be a ReferenceError even though no binding exists for it.
    fn isEngineGlobalName:boolean (name:string) {
        if (name == "Function") { return true }
        if (name == "Map") { return true }
        if (name == "Set") { return true }
        if (name == "Symbol") { return true }
        if (name == "Math") { return true }
        if (name == "JSON") { return true }
        if (name == "Object") { return true }
        if (name == "Array") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Date") { return true }
        if (name == "console") { return true }
        if (name == "globalThis") { return true }
        if (name == "NaN") { return true }
        if (name == "Infinity") { return true }
        if (name == "undefined") { return true }
        if (name == "arguments") { return true }
        return false
    }

    ; Read an identifier as a *reference*: an unresolvable name is a
    ; ReferenceError, not a silent null. `typeof x` does not come through here
    ; (it uses bindingExists), which is what the spec requires.
    ; D-GLOBALTHIS: created on first use so identity is stable.
    fn theGlobalObject:EvalValue () {
        if globalObject {
            return (unwrap globalObject)
        }
        def keysG:[string]
        def valsG:[EvalValue]
        def g:EvalValue (EvalValue.object(keysG valsG))
        globalObject = g
        return g
    }

    fn lookupIdentifier:EvalValue (name:string) {
        if (name == "undefined") {
            return (EvalValue.undefined())
        }
        ; D-IEEE: Infinity and NaN are VALUES, not merely names the engine knows
        ; about. They were resolving to undefined, so `x === -Infinity` compared
        ; against NaN and was false for every x — a comparison that silently
        ; never held.
        if (name == "Infinity") {
            return (EvalValue.number((1.0 / 0.0)))
        }
        if (name == "NaN") {
            return (EvalValue.number((0.0 / 0.0)))
        }
        if (context.has(name)) {
            return (context.lookup(name))
        }
        this.ensureErrorCtors()
        if (hostScope.has(name)) {
            return (hostScope.lookup(name))
        }
        ; D-GLOBALOBJ: the built-in namespaces are real OBJECTS, not merely names
        ; the engine recognises structurally. They resolved to undefined, so
        ; `Math.value = 1` silently vanished, passing Math where an object is
        ; expected was a TypeError, and every `X.prototype` read off one of them
        ; failed — the largest failure bucket in ES5 was reading a property of
        ; undefined. Calls like Math.floor(x) still dispatch structurally before
        ; reaching here, so this adds reachability without changing dispatch.
        if (this.isEngineGlobalName(name)) {
            def g:EvalValue (this.builtinGlobalObject(name))
            if (g.valueType == 5) {
                return g
            }
            if (g.valueType == 6) {
                return g
            }
            return (EvalValue.undefined())
        }
        ; D-GLOBALTHIS: a bare name may have been created as a property of the
        ; global object (`this.p1 = 1` at top level), which is a global binding.
        def gObj:EvalValue (this.theGlobalObject())
        if (has gObj.objectMap name) {
            return (unwrap (get gObj.objectMap name))
        }
        ; D-CLASSREF: a class is registered in the class table, not bound in a
        ; scope, so its bare name resolved to nothing — and once unresolved names
        ; began throwing, `A.staticMethod()` failed on the receiver before the
        ; call was even attempted. A class name resolves to a value carrying the
        ; class name so it is both referenceable and dispatchable.
        def clsRef:TSNode (this.classNodeByName(name))
        if (clsRef.nodeType == "ClassDeclaration") {
            def cv:EvalValue (EvalValue.nativeFunction(name))
            cv.setMember("__classname__" (EvalValue.string(name)))
            cv.setMember("name" (EvalValue.string(name)))
            return cv
        }
        if strictReferences {
            return (this.throwSpecError("ReferenceError" (name + " is not defined")))
        }
        return (EvalValue.null())
    }

    fn typeofTag:string (val:EvalValue) {
        if (val.isUndefined()) {
            return "undefined"
        }
        if (val.isNull()) {
            return "object"
        }
        if (val.isNumber()) {
            return "number"
        }
        if (val.isString()) {
            return "string"
        }
        if (val.isBoolean()) {
            return "boolean"
        }
        if (val.isFunction()) {
            return "function"
        }
        if (val.isArray()) {
            return "object"
        }
        if (val.isObject()) {
            ; D-SYMBOL: symbols are modelled as objects internally, but `typeof`
            ; must answer "symbol" — that is how guest code tells them apart, and
            ; answering "object" would make every symbol type-check wrong.
            def symTag@(optional):EvalValue (get val.objectMap "__symbol__")
            if symTag {
                return "symbol"
            }
            return "object"
        }
        if (val.isMap()) {
            return "object"
        }
        if (val.isSet()) {
            return "object"
        }
        if (val.isElement()) {
            return "object"
        }
        return "undefined"
    }

    fn evaluateTypeofExpr:EvalValue (node:TSNode) {
        if node.left {
            def argNode:TSNode (unwrap node.left)
            if (argNode.nodeType == "Identifier") {
                def name:string argNode.name
                if (name == "undefined") {
                    return (EvalValue.string("undefined"))
                }
                if (false == (this.bindingExists(name))) {
                    ; D-GLOBALOBJ: a built-in global is not a scope binding, but
                    ; it exists — typeof must say so. Constructors report
                    ; "function", namespaces like Math and JSON report "object".
                    if (this.isEngineGlobalName(name)) {
                        if (this.isBuiltinCtorName(name)) {
                            return (EvalValue.string("function"))
                        }
                        def gv:EvalValue (this.builtinGlobalObject(name))
                        if (gv.valueType == 5) {
                            return (EvalValue.string("object"))
                        }
                    }
                    return (EvalValue.string("undefined"))
                }
                def val:EvalValue (context.lookup(name))
                return (EvalValue.string((this.typeofTag(val))))
            }
            def val:EvalValue (this.evaluateExpr(argNode))
            return (EvalValue.string((this.typeofTag(val))))
        }
        return (EvalValue.string("undefined"))
    }
    
    fn evaluateUnaryExpr:EvalValue (node:TSNode) {
        def op:string node.value
        if (op == "typeof") {
            return (this.evaluateTypeofExpr(node))
        }
        ; delete obj.x / obj["k"] / arr[i] — remove the property (operand is a
        ; reference, so it must not be evaluated to a value first).
        if (op == "delete") {
            if node.left {
                def tgt:TSNode (unwrap node.left)
                if (tgt.nodeType == "MemberExpression") {
                    def obj:EvalValue (EvalValue.null())
                    if tgt.left {
                        obj = (this.evaluateExpr((unwrap tgt.left)))
                    }
                    if tgt.computed {
                        if tgt.right {
                            def iv:EvalValue (this.evaluateExpr((unwrap tgt.right)))
                            obj.removeMember((iv.toString()))
                        }
                    } {
                        obj.removeMember(tgt.name)
                    }
                }
            }
            return (EvalValue.boolean(true))
        }
        if node.left {
            def argExpr:TSNode (unwrap node.left)
            def arg:EvalValue (this.evaluateExpr(argExpr))
            
            if (op == "!") {
                return (EvalValue.boolean(((arg.toBool()) == false)))
            }
            if (op == "-") {
                ; D-IEEE: negate by MULTIPLYING by -1, not by subtracting from
                ; zero. `0.0 - 0.0` is +0, so subtraction silently destroyed
                ; negative zero and the engine had no -0 at all.
                def negOne:double (0.0 - 1.0)
                return (EvalValue.number((negOne * (this.toNumberOf(arg)))))
            }
            if (op == "+") {
                ; ToNumber, not the value's own idea of a number: `+"0xff"` is
                ; 255 and `+{valueOf: …}` runs the method.
                return (EvalValue.number((this.toNumberOf(arg))))
            }
            ; Bitwise NOT (~x == -(x)-1). Coerce to int32 like JS/AS.
            if (op == "~") {
                return (EvalValue.fromInt((bit_not (to_int (this.toNumberOf(arg))))))
            }
            ; void x evaluates the operand for side effects and yields undefined.
            if (op == "void") {
                return (EvalValue.undefined())
            }
        }

        return (EvalValue.null())
    }

    fn evaluateConditionalExpr:EvalValue (node:TSNode) {
        if node.test {
            def testExpr:TSNode (unwrap node.test)
            def test:EvalValue (this.evaluateExpr(testExpr))
            
            if (test.toBool()) {
                if node.consequent {
                    def conseqNode:TSNode (unwrap node.consequent)
                    return (this.evaluateExpr(conseqNode))
                }
            } {
                if node.alternate {
                    def altNode:TSNode (unwrap node.alternate)
                    return (this.evaluateExpr(altNode))
                }
            }
        }
        
        return (EvalValue.null())
    }
    
    ; ---- user classes: instances, methods, `this`-bound dispatch ----------
    ; The __class__ name stamped on an instance object, or "" for non-instances.
    fn instanceClassName:string (obj:EvalValue) {
        if (obj.valueType != 5) { return "" }
        def cv@(optional):EvalValue (get obj.objectMap "__class__")
        if cv {
            def c:EvalValue (unwrap cv)
            if (c.valueType == 2) {
                return c.stringValue
            }
        }
        return ""
    }

    ; The virtual module an instance's class was declared in ("" = entry-realm
    ; class). Stamped by evaluateNewExpr for module-owned classes.
    fn instanceModuleTag:string (obj:EvalValue) {
        if (obj.valueType != 5) { return "" }
        def mv@(optional):EvalValue (get obj.objectMap "__module__")
        if mv {
            def m:EvalValue (unwrap mv)
            if (m.valueType == 2) {
                return m.stringValue
            }
        }
        return ""
    }

    ; Resolve the class declaration an instance was constructed from: a module
    ; tag routes to that module's class table, otherwise the engine-wide map
    ; (entry-realm classes). Empty node when unknown.
    fn classNodeForInstance:TSNode (obj:EvalValue) {
        def empty:TSNode (new TSNode())
        def clsName:string (this.instanceClassName(obj))
        if ((strlen clsName) == 0) {
            return empty
        }
        def tag:string (this.instanceModuleTag(obj))
        if ((strlen tag) > 0) {
            return (this.moduleClassNode(tag clsName))
        }
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) {
            return empty
        }
        return (unwrap cn)
    }

    ; D-CLASSSTATIC: a `static m() {}` member, which the parser tags kind="static".
    ; Kept separate from findMethodOnClassNode so a static and an instance method
    ; of the same name never resolve to each other.
    ; D-CLASSEXPR: give a class expression a table key and hand back a value that
    ; refers to it. A named class expression keeps its own name so recursive
    ; self-reference inside the body still resolves.
    ; D-CLASSEXTENDS: the superclass name of a class declaration. The parser puts

            j = (j + 1)
        }
        return out
    }

    ; Step three: canonical composition. A combining character composes into the
    ; last starter unless something BETWEEN them blocks it -- another starter, or
    ; a mark of the same or higher class.
    fn nfcPoints:[int] (cps:[int]) {
        def seq:[int] (this.nfdPoints(cps))
        def n:int (array_length seq)
        def out:[int]
        if (n == 0) { return out }
        push out (itemAt seq 0)
        def starter:int 0
        def lastClass:int (0 - 1)
        if ((this.cccOf((itemAt seq 0))) != 0) {
            lastClass = (this.cccOf((itemAt seq 0)))
        }
        def i:int 1
        while (i < n) {
            def cp:int (itemAt seq i)
            def c:int (this.cccOf(cp))
            def s:int (itemAt out starter)
            def composite:int (0 - 1)
            def open:boolean false
            if ((this.cccOf(s)) == 0) {
                if (lastClass < c) { open = true }
                if (lastClass == (0 - 1)) { open = true }
            }
            if open {
                ; Hangul composition, then the table.
                if (((s >= 4352) && (s < 4371)) && ((cp >= 4449) && (cp < 4470))) {
                    composite = (44032 + ((((s - 4352) * 21) + (cp - 4449)) * 28))
                } {
                    def isSyl:boolean (this.isHangulSyllable(s))
                    def tOk:boolean false
                    if isSyl {

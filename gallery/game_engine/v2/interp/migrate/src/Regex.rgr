; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; Regex — an ECMAScript regular-expression engine
; =============================================================================
; D-REGEX: the ES5 pattern grammar, compiled to a node tree and matched by
; backtracking. It exists because String.prototype.match, replace, search and
; split are all specified against RegExp, and without one those four methods
; could not be implemented at all -- match scored 0/36 and split 44/100, and
; every failure in them was the same missing piece.
;
; Why a tree and not a scan-as-you-match interpreter: alternation and
; quantifiers both need to try a branch, fail, and resume at the same place with
; different state. That is natural over a compiled tree and painful over raw
; pattern text, where every retry has to re-find the branch boundaries.
;
; Backtracking is expressed as recursion over a node LIST: matchList(nodes, i,
; pos) matches node i and then asks itself to match the rest from wherever that
; landed. A quantifier tries its counts in order and, for each one, hands the
; remainder to the same function -- so a failure deep in the tail unwinds back
; into the quantifier and it tries the next count. Captures are engine state,
; saved and restored around every attempt that can fail.
;
; What is deliberately absent: the `v` flag's set notation. The `u`, `y`, `s`
; and `d` flags, named groups, lookbehind and the \p{...} property escapes are
; all here.
; =============================================================================

; Node kinds. Held as an int rather than a subclass hierarchy because Ranger has
; no virtual dispatch to switch on, and the matcher is one function either way.
;   0 CHAR      a literal code unit
;   1 ANY       `.`
;   2 CLASS     [...] including the \d \w \s shorthands
;   3 GROUP     (...) / (?:...) — children hold the alternatives
;   4 ALT       one alternative's node list
;   5 ANCHOR    ^ $ \b \B
;   6 BACKREF   \1 .. \9
;   7 LOOK      (?=...) / (?!...)
;   8 LOOKBEHIND (?<=...) / (?<!...)
class RegexNode {
    def kind:int 0
    def ch:int 0
    ; For GROUP/LOOK: the alternatives, each an ALT node. For ALT: the sequence.
    def children:[RegexNode]
    ; Quantifier, applied to THIS node. min 0 / max -1 means unbounded.
    def min:int 1
    def max:int 1
    def greedy:boolean true
    ; CLASS: flattened [lo, hi] pairs, plus shorthand markers.
    def ranges:[int]
    def shorthands:[int]
    def negate:boolean false
    ; GROUP: 1-based capture index, or 0 for a non-capturing group.
    def groupIndex:int 0
    ; ANCHOR: 0 = ^, 1 = $, 2 = \b, 3 = \B
    def anchorKind:int 0
    ; LOOK: negative lookahead when true.
    def lookNegate:boolean false
    ; The flags in force for THIS node, resolved once after parsing: a modifier
    ; applies to a lexical subtree, so it is pushed down the tree rather than
    ; tracked while matching -- the matcher's control flow is a continuation
    ; chain, and there is no single point at which a group is "left".
    def effIc:boolean false
    def effMl:boolean false
    def effDot:boolean false
    ; GROUP with a MODIFIER -- `(?i:…)`, `(?-i:…)`, `(?ims-x:…)`. Each is -1
    ; for "unchanged", 0 for off and 1 for on, applying to this group's whole
    ; subtree. A modifier is scoped, unlike a flag.
    def modIgnoreCase:int (0 - 1)
    def modMultiline:int (0 - 1)
    def modDotAll:int (0 - 1)
    ; CLASS under the `v` flag: the operand classes of a set expression, and
    ; which operation joins them -- 0 union, 1 intersection, 2 difference.
    ; A `v` class is a TREE, because `[[\p{ASCII}--[a-z]]&&\w]` is one.
    def subClasses:[RegexNode]
    def setOp:int 0
    ; CLASS: the multi-character strings a `\q{ab|cd}` contributes. A class that
    ; has any can match more than one character, which no other class can.
    def strings:[string]
    ; CLASS: the \p{...} properties this class matches, each encoded as
    ; (index * 2) plus 1 for the NEGATED \P{...} form. Held apart from
    ; `shorthands` because a property is a table lookup rather than one of the
    ; six built-in classes.
    def props:[int]
    ; BACKREF by NAME -- `\k<n>`. The name rather than the index, because a
    ; named backreference may point FORWARD to a group the parser has not
    ; reached yet; it is resolved against the program at match time.
    def groupName:string ""
}

; A compiled pattern: the alternatives at the top level, plus how many capture
; groups it has.
class RegexProgram {
    def alternatives:[RegexNode]
    def groupCount:int 0
    def ignoreCase:boolean false
    def multiline:boolean false
    def global:boolean false
    ; The `y` flag. A sticky match must begin exactly at lastIndex, which is a
    ; different question from where the search may start.
    def sticky:boolean false
    ; The `u` flag. In Unicode mode the subject is a sequence of CODE POINTS,
    ; so a search steps over a surrogate PAIR whole and can never begin, end or
    ; resume between its halves -- which is what makes /\udf06/u fail to match
    ; the low half of '\ud834\udf06' rather than finding it at index 1.
    def unicode:boolean false
    ; The `v` flag: `u` plus set notation inside a character class.
    def unicodeSets:boolean false
    ; The `s` flag: `.` stops excluding the line terminators.
    def dotAll:boolean false
    ; The `d` flag: exec additionally reports where each capture ran.
    def hasIndices:boolean false
    ; Capture NAMES, indexed by group number -- "" for an unnamed group, and
    ; slot 0 unused so the index is the group number itself.
    def groupNames:[string]
    def valid:boolean true
    def errorMessage:string ""
    def source:string ""
}

; One match: where it started and ended, plus the capture bounds. A capture that
; did not participate has start -1, which is what makes it read as undefined
; rather than as the empty string.
class RegexMatch {
    def matched:boolean false
    def start:int 0
    def end:int 0
    def capStart:[int]
    def capEnd:[int]
}

; =============================================================================
; Text, in code units
; =============================================================================
; The regex engine used to reach the pattern and the subject through `charAt`
; and `substring` directly, and on the byte-model target those two do not agree
; about what an index means: `substring` walks code POINTS while `charAt` walks
; BYTES. So /naïve/ compiled with the ï split into its two bytes, the matcher
; stepped over the subject a byte at a time, and `m.index` came back as a byte
; offset -- which is why /\w+/ over "naïve café" answered ["na", "e ", "afé"].
;
; Both sides now decode ONCE into an array of UTF-16 code units and index that.
; Positions are then code-unit indices everywhere, which is what `m.index` and
; `lastIndex` are defined to be, so nothing has to be converted on the way out.
class RegexText {

    ; 0 = UTF-16 units (es6), 1 = UTF-8 bytes (C++), 2 = code points (Rust).
    static sfn modelKind:int () {
        if ((strlen "é") > 1) { return 1 }
        if ((strlen "😀") == 1) { return 2 }
        return 0
    }

    ; Whether every unit is below 128, in which case all three models agree
    ; about the string and no decoding is needed at all.
    static sfn isAscii:boolean (s:string) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if (c < 0) { return false }
            if (c > 127) { return false }
            i = (i + 1)
        }
        return true
    }

    static sfn units:[int] (s:string) {
        def out:[int]
        def n:int (strlen s)
        def kind:int (RegexText.modelKind())
        if (kind == 1) {
            def i:int 0
            while (i < n) {
                def b0:int (bit_and (charAt s i) 255)
                def w:int 1
                if (b0 >= 240) {
                    w = 4
                } {
                    if (b0 >= 224) {
                        w = 3
                    } {
                        if (b0 >= 192) { w = 2 }
                    }
                }
                if ((i + w) > n) { w = 1 }
                def cp:int b0
                if (w == 2) {
                    cp = (((bit_and b0 31) * 64) + (bit_and (charAt s (i + 1)) 63))
                }
                if (w == 3) {
                    def d1:int (bit_and (charAt s (i + 1)) 63)
                    def d2:int (bit_and (charAt s (i + 2)) 63)
                    cp = ((((bit_and b0 15) * 4096) + (d1 * 64)) + d2)
                }
                if (w == 4) {
                    def e1:int (bit_and (charAt s (i + 1)) 63)
                    def e2:int (bit_and (charAt s (i + 2)) 63)
                    def e3:int (bit_and (charAt s (i + 3)) 63)
                    cp = (((((bit_and b0 7) * 262144) + (e1 * 4096)) + (e2 * 64)) + e3)
                }
                if (cp > 65535) {
                    def adj:int (cp - 65536)
                    push out (55296 + (bit_shr adj 10))
                    push out (56320 + (bit_and adj 1023))
                } {
                    push out cp
                }
                i = (i + w)
            }
            return out
        }
        if (kind == 2) {
            def p:int 0
            while (p < n) {
                def cp2:int (charAt s p)
                if (cp2 > 65535) {
                    def adj2:int (cp2 - 65536)
                    push out (55296 + (bit_shr adj2 10))
                    push out (56320 + (bit_and adj2 1023))
                } {
                    push out cp2
                }
                p = (p + 1)
            }
            return out
        }
        def u:int 0
        while (u < n) {
            push out (bit_and (charAt s u) 65535)
            u = (u + 1)
        }
        return out
    }

    ; One code unit as text. A lone surrogate has no representation on the
    ; code-point target, so it comes back empty there rather than corrupt.
    static sfn unitStr:string (c:int) {
        if (c < 0) { return "" }
        def kind:int (RegexText.modelKind())
        if (kind == 1) {
            if (c < 128) { return (strfromcode c) }
            if (c < 2048) {
                return ((strfromcode (bit_or 192 (bit_shr c 6))) + (strfromcode (bit_or 128 (bit_and c 63))))
            }
            def c1:int (bit_or 224 (bit_shr c 12))
            def c2:int (bit_or 128 (bit_and (bit_shr c 6) 63))
            def c3:int (bit_or 128 (bit_and c 63))
            return (((strfromcode c1) + (strfromcode c2)) + (strfromcode c3))
        }
        if (kind == 2) {
            if ((c >= 55296) && (c <= 57343)) { return "" }
        }
        return (strfromcode c)
    }
}

; =============================================================================
; Unicode properties
; =============================================================================
; D-PROPS: `\p{L}` and its kin, answered from the generated range table. The
; ranges are sorted and disjoint, so membership is a binary search -- which
; matters, because \p{L} alone is several hundred runs and a class is tested
; once per character of the subject.
;
; The table is loaded ONCE per process: it is three static array literals, and
; rebuilding them per match would cost more than the matching.
class RegexProps @singleton(true) {
    def loaded:boolean false
    def names:[string]
    def offsets:[int]
    def counts:[int]
    def ranges:[int]

    fn ensure:void () {
        if loaded { return }
        loaded = true
        names = (UnicodeProps.names())
        offsets = (UnicodeProps.offsets())
        counts = (UnicodeProps.counts())
        ranges = (UnicodeProps.ranges())
    }

    static sfn lowerAscii:string (s:string) {
        def upper:string "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        def lower:string "abcdefghijklmnopqrstuvwxyz"
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            def at:int (indexOf upper ch)
            if (at >= 0) {
                out = (out + (substring lower at (at + 1)))
            } {
                out = (out + ch)
            }
            i = (i + 1)
        }
        return out
    }

    static sfn hasPrefix:boolean (s:string prefix:string) {
        if ((strlen prefix) > (strlen s)) { return false }
        return ((substring s 0 (strlen prefix)) == prefix)
    }

    static sfn indexOfName:int (name:string) {
        def self:RegexProps (RegexProps.__singleton())
        self.ensure()
        def i:int 0
        while (i < (array_length self.names)) {
            if ((itemAt self.names i) == name) { return i }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; Whether code point `cp` is in property `idx`, by binary search over that
    ; property's runs.
    static sfn holds:boolean (idx:int cp:int) {
        def self:RegexProps (RegexProps.__singleton())
        self.ensure()
        if (idx < 0) { return false }
        if (idx >= (array_length self.offsets)) { return false }
        def off:int (itemAt self.offsets idx)
        def cnt:int (itemAt self.counts idx)
        def lo:int 0
        def hi:int (cnt - 1)
        while (lo <= hi) {
            def mid:int (lo + (bit_shr (hi - lo) 1))
            def a:int (itemAt self.ranges ((off + mid) * 2))
            def b:int (itemAt self.ranges (((off + mid) * 2) + 1))
            if (cp < a) {
                hi = (mid - 1)
            } {
                if (cp > b) {
                    lo = (mid + 1)
                } {
                    return true
                }
            }
        }
        return false
    }
}

; =============================================================================
; Compiler
; =============================================================================
class RegexCompiler {
    def src:string ""
    ; The pattern as code UNITS, and its length in them. `pos` indexes these,
    ; never the raw string.
    def srcU:[int]
    def srcLen:int 0
    def pos:int 0
    def groupCount:int 0
    ; Capture names as they are met, indexed by group number. Grown to keep
    ; step with groupCount so the index never has to be searched for.
    def groupNames:[string]
    ; The `u` flag, needed while PARSING: a Unicode-mode pattern is stricter
    ; about what an escape may be.
    def uMode:boolean false
    ; The `v` flag, which replaces the class grammar entirely.
    def vMode:boolean false
    def failed:boolean false
    def failMessage:string ""

    fn compile:RegexProgram (pattern:string flags:string) {
        def prog (new RegexProgram)
        prog.source = pattern
        src = pattern
        srcU = (RegexText.units(pattern))
        srcLen = (array_length srcU)
        pos = 0
        groupCount = 0
        uMode = false
        vMode = false
        def freshNames:[string]
        push freshNames ""
        groupNames = freshNames
        failed = false
        failMessage = ""
        def fi:int 0
        while (fi < (strlen flags)) {
            def f:string (substring flags fi (fi + 1))
            if (f == "i") { prog.ignoreCase = true }
            if (f == "m") { prog.multiline = true }
            if (f == "g") { prog.global = true }
            if (f == "y") { prog.sticky = true }
            if (f == "u") { prog.unicode = true }
            if (f == "u") { uMode = true }
            ; `v` is `u` with set notation: everything Unicode mode does, plus
            ; the class grammar below.
            if (f == "v") {
                prog.unicode = true
                prog.unicodeSets = true
                uMode = true
                vMode = true
            }
            if (f == "s") { prog.dotAll = true }
            if (f == "d") { prog.hasIndices = true }
            fi = (fi + 1)
        }
        prog.alternatives = (this.parseAlternatives())
        ; D-MODIFIERS: push the effective flags down the tree. Every node then
        ; knows the case-sensitivity, multiline and dotAll in force where it
        ; sits, whether that came from the flags or from an enclosing `(?i:…)`.
        this.resolveModifiers(prog.alternatives prog.ignoreCase prog.multiline prog.dotAll)
        if (pos < srcLen) {
            ; A ")" with no opening group, or anything else the parser refused
            ; to consume, means the pattern is malformed.
            failed = true
            if ((strlen failMessage) == 0) {
                failMessage = "Unmatched ')'"
            }
        }
        prog.groupCount = groupCount
        prog.groupNames = groupNames
        prog.valid = (false == failed)
        prog.errorMessage = failMessage
        return prog
    }

    fn resolveModifiers:void (nodes:[RegexNode] ic:boolean ml:boolean dot:boolean) {
        def i:int 0
        while (i < (array_length nodes)) {
            def n:RegexNode (itemAt nodes i)
            def nIc:boolean ic
            def nMl:boolean ml
            def nDot:boolean dot
            if (n.modIgnoreCase >= 0) { nIc = (n.modIgnoreCase == 1) }
            if (n.modMultiline >= 0) { nMl = (n.modMultiline == 1) }
            if (n.modDotAll >= 0) { nDot = (n.modDotAll == 1) }
            n.effIc = nIc
            n.effMl = nMl
            n.effDot = nDot
            this.resolveModifiers(n.children nIc nMl nDot)
            this.resolveModifiers(n.subClasses nIc nMl nDot)
            i = (i + 1)
        }
    }

    ; The code unit at `p`, or -1 past the end.
    fn uAt:int (p:int) {
        if (p < 0) { return (0 - 1) }
        if (p >= srcLen) { return (0 - 1) }
        return (itemAt srcU p)
    }

    ; The code unit at `p` as a one-unit string, for the many places that
    ; compare against a literal.
    fn uStr:string (p:int) {
        if (p < 0) { return "" }
        if (p >= srcLen) { return "" }
        return (RegexText.unitStr((itemAt srcU p)))
    }

    ; alternatives := sequence ("|" sequence)*
    fn parseAlternatives:[RegexNode] () {
        def out:[RegexNode]
        push out (this.parseSequence())
        while (this.peekIs("|")) {
            pos = (pos + 1)
            push out (this.parseSequence())
        }
        return out
    }

    fn parseSequence:RegexNode () {
        def seq (new RegexNode)
        seq.kind = 4
        def looping:boolean true
        while looping {
            if (pos >= srcLen) {
                looping = false
            } {
                if ((this.peekIs("|")) || (this.peekIs(")"))) {
                    looping = false
                } {
                    ; A quantifier needs an ATOM in front of it. `*a`, `+a`,
                    ; `?a` and a well-formed `{n,m}` in term position are all
                    ; SyntaxErrors -- the parser used to read the `*` as a
                    ; literal and accept the pattern.
                    if (this.quantifierAhead()) {
                        failed = true
                        failMessage = "Nothing to repeat"
                        looping = false
                    } {
                    def atom:RegexNode (this.parseAtom())
                    if failed {
                        looping = false
                    } {
                        this.applyQuantifier(atom)
                        if failed {
                            looping = false
                        } {
                            push seq.children atom
                        }
                    }
                    }
                }
            }
        }
        return seq
    }

    ; True when a QUANTIFIER starts here. `{` counts only when it is a
    ; well-formed bound: a lone `{` is a literal brace, which is what Annex B
    ; and web reality settled on.
    fn quantifierAhead:boolean () {
        if (pos >= srcLen) {
            return false
        }
        def c:string (this.uStr(pos))
        if (c == "*") { return true }
        if (c == "+") { return true }
        if (c == "?") { return true }
        if (c == "{") {
            return (this.boundAhead())
        }
        return false
    }

    ; Whether `{` at `pos` opens a well-formed `{n}` / `{n,}` / `{n,m}`.
    fn boundAhead:boolean () {
        def p:int (pos + 1)
        def digits:int 0
        def scanning:boolean true
        while (scanning && (p < srcLen)) {
            def d:int (this.uAt(p))
            if ((d >= 48) && (d <= 57)) {
                digits = (digits + 1)
                p = (p + 1)
            } {
                scanning = false
            }
        }
        if (digits == 0) {
            return false
        }
        if (p >= srcLen) {
            return false
        }
        def nx:string (this.uStr(p))
        if (nx == "}") {
            return true
        }
        if (nx != ",") {
            return false
        }
        p = (p + 1)
        def scanning2:boolean true
        while (scanning2 && (p < srcLen)) {
            def d2:int (this.uAt(p))
            if ((d2 >= 48) && (d2 <= 57)) {
                p = (p + 1)
            } {
                scanning2 = false
            }
        }
        if (p >= srcLen) {
            return false
        }
        return ((this.uStr(p)) == "}")
    }

    fn peekIs:boolean (c:string) {
        if (pos >= srcLen) {
            return false
        }
        return ((this.uStr(pos)) == c)
    }

    fn peekAt:int (offset:int) {
        def p:int (pos + offset)
        if (p >= srcLen) {
            return (0 - 1)
        }
        return (this.uAt(p))
    }

    ; A quantifier binds to the atom just parsed. `{` that is not a well-formed
    ; bound is a literal brace, which is what web reality (and Annex B) settled
    ; on, so it is not an error.
    fn applyQuantifier:void (n:RegexNode) {
        if (pos >= srcLen) {
            return
        }
        def c:string (this.uStr(pos))
        def applied:boolean false
        if (c == "*") {
            n.min = 0
            n.max = (0 - 1)
            pos = (pos + 1)
            applied = true
        }
        if (c == "+") {
            n.min = 1
            n.max = (0 - 1)
            pos = (pos + 1)
            applied = true
        }
        if (c == "?") {
            n.min = 0
            n.max = 1
            pos = (pos + 1)
            applied = true
        }
        if (c == "{") {
            def save:int pos
            def p:int (pos + 1)
            def lo:int 0
            def loDigits:int 0
            while (p < srcLen) {
                def d:int (this.uAt(p))
                if ((d >= 48) && (d <= 57)) {
                    lo = ((lo * 10) + (d - 48))
                    loDigits = (loDigits + 1)
                    p = (p + 1)
                } {
                    p = srcLen
                }
            }
            ; The loop above ran to the end; redo it properly with a flag.
            p = (pos + 1)
            lo = 0
            loDigits = 0
            def scanning:boolean true
            while (scanning && (p < srcLen)) {
                def d2:int (this.uAt(p))
                if ((d2 >= 48) && (d2 <= 57)) {
                    lo = ((lo * 10) + (d2 - 48))
                    loDigits = (loDigits + 1)
                    p = (p + 1)
                } {
                    scanning = false
                }
            }
            if (loDigits > 0) {
                def hi:int lo
                def ok:boolean false
                if (p < srcLen) {
                    def nx:string (this.uStr(p))
                    if (nx == "}") {
                        ok = true
                        p = (p + 1)
                    }
                    if (nx == ",") {
                        p = (p + 1)
                        def hiDigits:int 0
                        hi = 0
                        def scanning2:boolean true
                        while (scanning2 && (p < srcLen)) {
                            def d3:int (this.uAt(p))
                            if ((d3 >= 48) && (d3 <= 57)) {
                                hi = ((hi * 10) + (d3 - 48))
                                hiDigits = (hiDigits + 1)
                                p = (p + 1)
                            } {
                                scanning2 = false
                            }
                        }
                        if (hiDigits == 0) {
                            hi = (0 - 1)
                        }
                        if (p < srcLen) {
                            if ((this.uStr(p)) == "}") {
                                ok = true
                                p = (p + 1)
                            }
                        }
                    }
                }
                if ok {
                    n.min = lo
                    n.max = hi
                    pos = p
                    applied = true
                } {
                    pos = save
                }
            }
        }
        if applied {
            if (this.peekIs("?")) {
                n.greedy = false
                pos = (pos + 1)
            }
            ; A quantifier cannot quantify a quantifier: `a**`, `a???` and
            ; `x{1,2}{1}` are SyntaxErrors. The lazy `?` was consumed just
            ; above, so anything still here is a second quantifier.
            if (this.quantifierAhead()) {
                failed = true
                failMessage = "Nothing to repeat"
                return
            }
            ; `{n,m}` with n greater than m is out of order.
            if (n.max >= 0) {
                if (n.min > n.max) {
                    failed = true
                    failMessage = "numbers out of order in {} quantifier"
                    return
                }
            }
        }
    }

    fn parseAtom:RegexNode () {
        def c:string (this.uStr(pos))
        if (c == "(") {
            return (this.parseGroup())
        }
        if (c == "[") {
            return (this.parseClass())
        }
        if (c == ".") {
            pos = (pos + 1)
            def any (new RegexNode)
            any.kind = 1
            return any
        }
        if (c == "^") {
            pos = (pos + 1)
            def a (new RegexNode)
            a.kind = 5
            a.anchorKind = 0
            return a
        }
        if (c == "$") {
            pos = (pos + 1)
            def a2 (new RegexNode)
            a2.kind = 5
            a2.anchorKind = 1
            return a2
        }
        if (c == "\\") {
            return (this.parseEscape())
        }
        pos = (pos + 1)
        def lit (new RegexNode)
        lit.kind = 0
        lit.ch = (this.uAt((pos - 1)))
        return lit
    }

    fn parseGroup:RegexNode () {
        pos = (pos + 1)
        def g (new RegexNode)
        g.kind = 3
        def capturing:boolean true
        if (this.peekIs("?")) {
            def nx:int (this.peekAt(1))
            if (nx == 58) {
                ; (?:
                capturing = false
                pos = (pos + 2)
            }
            if (nx == 61) {
                ; (?=
                g.kind = 7
                g.lookNegate = false
                capturing = false
                pos = (pos + 2)
            }
            if (nx == 33) {
                ; (?!
                g.kind = 7
                g.lookNegate = true
                capturing = false
                pos = (pos + 2)
            }
            ; D-MODIFIERS: `(?flags:…)` and `(?flags-flags:…)`. The letters may
            ; be i, m or s, and the group is non-capturing.
            if ((nx == 105) || ((nx == 109) || ((nx == 115) || (nx == 45)))) {
                def scan:int (pos + 1)
                def onI:int (0 - 1)
                def onM:int (0 - 1)
                def onS:int (0 - 1)
                def turningOff:boolean false
                def modOk:boolean true
                def sawAny:boolean false
                def scanning:boolean true
                while (scanning && (scan < srcLen)) {
                    def mc:int (this.uAt(scan))
                    if (mc == 58) {
                        scanning = false
                    } {
                        def val:int 1
                        if turningOff { val = 0 }
                        if (mc == 45) {
                            if turningOff { modOk = false }
                            turningOff = true
                            scan = (scan + 1)
                        } {
                            if (mc == 105) { onI = val
                                sawAny = true
                                scan = (scan + 1) } {
                                if (mc == 109) { onM = val
                                    sawAny = true
                                    scan = (scan + 1) } {
                                    if (mc == 115) { onS = val
                                        sawAny = true
                                        scan = (scan + 1) } {
                                        modOk = false
                                        scanning = false
                                    }
                                }
                            }
                        }
                    }
                }
                if (scan >= srcLen) { modOk = false }
                if (false == sawAny) { modOk = false }
                if modOk {
                    g.modIgnoreCase = onI
                    g.modMultiline = onM
                    g.modDotAll = onS
                    capturing = false
                    pos = (scan + 1)
                    g.children = (this.parseAlternatives())
                    if (this.peekIs(")")) {
                        pos = (pos + 1)
                    } {
                        failed = true
                        failMessage = "Unterminated group"
                    }
                    return g
                }
                failed = true
                failMessage = "Invalid group"
                return g
            }
            if (nx == 60) {
                ; `(?<` is three things at once: (?<= and (?<! are lookbehind,
                ; and anything else is a NAMED capture group.
                def nx2:int (this.peekAt(2))
                if (nx2 == 61) {
                    g.kind = 8
                    g.lookNegate = false
                    capturing = false
                    pos = (pos + 3)
                } {
                    if (nx2 == 33) {
                        g.kind = 8
                        g.lookNegate = true
                        capturing = false
                        pos = (pos + 3)
                    } {
                        ; (?<name> — a capture like any other, plus a name.
                        pos = (pos + 2)
                        def gname:string ""
                        def naming:boolean true
                        while (naming && (pos < srcLen)) {
                            def nc:string (this.uStr(pos))
                            if (nc == ">") {
                                naming = false
                                pos = (pos + 1)
                            } {
                                gname = (gname + nc)
                                pos = (pos + 1)
                            }
                        }
                        if ((strlen gname) == 0) {
                            failed = true
                            failMessage = "Invalid capture group name"
                            return g
                        }
                        groupCount = (groupCount + 1)
                        g.groupIndex = groupCount
                        ; groupNames is indexed BY GROUP NUMBER, so it is padded
                        ; up to AND INCLUDING this group before the name is
                        ; written: `set` past the end grows a JS array and
                        ; segfaults a native one.
                        while ((array_length groupNames) < (groupCount + 1)) {
                            push groupNames ""
                        }
                        set groupNames groupCount gname
                        g.children = (this.parseAlternatives())
                        if (this.peekIs(")")) {
                            pos = (pos + 1)
                        } {
                            failed = true
                            failMessage = "Unterminated group"
                        }
                        return g
                    }
                }
            }
        }
        if capturing {
            groupCount = (groupCount + 1)
            g.groupIndex = groupCount
            while ((array_length groupNames) < (groupCount + 1)) {
                push groupNames ""
            }
        }
        g.children = (this.parseAlternatives())
        if (this.peekIs(")")) {
            pos = (pos + 1)
        } {
            failed = true
            failMessage = "Unterminated group"
        }
        return g
    }

    ; D-VFLAG: the `v` class grammar. A class is a SET EXPRESSION -- operands
    ; joined by union (juxtaposition), intersection (`&&`) or difference
    ; (`--`), where an operand may itself be a nested class. Only one operator
    ; kind may appear at a level, which is what keeps `a--b&&c` from needing a
    ; precedence rule.
    fn parseClassV:RegexNode () {
        pos = (pos + 1)
        def cls (new RegexNode)
        cls.kind = 2
        if (this.peekIs("^")) {
            cls.negate = true
            pos = (pos + 1)
        }
        def closed:boolean false
        while ((pos < srcLen) && (false == closed)) {
            if (this.peekIs("]")) {
                pos = (pos + 1)
                closed = true
            } {
                def isDiff:boolean false
                def isInter:boolean false
                if (this.peekIs("-")) {
                    if ((this.peekAt(1)) == 45) { isDiff = true }
                }
                if (this.peekIs("&")) {
                    if ((this.peekAt(1)) == 38) { isInter = true }
                }
                if isDiff {
                    cls.setOp = 2
                    pos = (pos + 2)
                } {
                    if isInter {
                        cls.setOp = 1
                        pos = (pos + 2)
                    } {
                        def operand:RegexNode (this.parseClassVOperand())
                        push cls.subClasses operand
                        if failed { closed = true }
                    }
                }
            }
        }
        if (false == closed) {
            failed = true
            failMessage = "Unterminated character class"
        }
        return cls
    }

    ; One operand of a `v` set expression: a nested class, a `\q{…}` string
    ; set, or an ordinary atom (possibly the low end of a range).
    fn parseClassVOperand:RegexNode () {
        def part (new RegexNode)
        part.kind = 2
        if (this.peekIs("[")) {
            return (this.parseClassV())
        }
        ; `\q{a|bc}` -- the one construct that puts multi-character STRINGS in
        ; a class, and the reason a `v` class can consume more than one
        ; character.
        if (this.peekIs("\\")) {
            if ((this.peekAt(1)) == 113) {
                if ((this.peekAt(2)) == 123) {
                    pos = (pos + 3)
                    def cur:string ""
                    def reading:boolean true
                    while (reading && (pos < srcLen)) {
                        def c:string (this.uStr(pos))
                        if (c == "}") {
                            reading = false
                            pos = (pos + 1)
                        } {
                            if (c == "|") {
                                push part.strings cur
                                cur = ""
                                pos = (pos + 1)
                            } {
                                cur = (cur + c)
                                pos = (pos + 1)
                            }
                        }
                    }
                    push part.strings cur
                    if reading {
                        failed = true
                        failMessage = "Unterminated \\q"
                    }
                    return part
                }
            }
        }
        def lo:int (this.readClassAtom(part))
        if (lo >= 0) {
            def isRange:boolean false
            if (this.peekIs("-")) {
                ; `--` is the difference OPERATOR, not a range.
                if ((this.peekAt(1)) != 45) {
                    if ((this.peekAt(1)) != 93) {
                        if ((this.peekAt(1)) >= 0) { isRange = true }
                    }
                }
            }
            if isRange {
                pos = (pos + 1)
                def hi:int (this.readClassAtom(part))
                if (hi >= 0) {
                    if (lo > hi) {
                        failed = true
                        failMessage = "Range out of order in character class"
                    }
                    push part.ranges lo
                    push part.ranges hi
                } {
                    push part.ranges lo
                    push part.ranges lo
                    push part.ranges 45
                    push part.ranges 45
                }
            } {
                push part.ranges lo
                push part.ranges lo
            }
        }
        return part
    }

    fn parseClass:RegexNode () {
        if vMode {
            return (this.parseClassV())
        }
        pos = (pos + 1)
        def cls (new RegexNode)
        cls.kind = 2
        if (this.peekIs("^")) {
            cls.negate = true
            pos = (pos + 1)
        }
        def closed:boolean false
        while ((pos < srcLen) && (false == closed)) {
            if (this.peekIs("]")) {
                pos = (pos + 1)
                closed = true
            } {
                def lo:int (this.readClassAtom(cls))
                if (lo >= 0) {
                    ; A "-" between two atoms makes a range, unless it is the
                    ; last character before "]", where it is a literal.
                    def isRange:boolean false
                    if (this.peekIs("-")) {
                        if ((this.peekAt(1)) != 93) {
                            if ((this.peekAt(1)) >= 0) {
                                isRange = true
                            }
                        }
                    }
                    if isRange {
                        pos = (pos + 1)
                        def hi:int (this.readClassAtom(cls))
                        if (hi >= 0) {
                            ; A range whose start is above its end is a
                            ; SyntaxError -- `[b-a]`, `[z-a]`, `[{-z]`. It used
                            ; to be accepted and simply never match. A range
                            ; involving a SHORTHAND (`[\d-G]`) is not a range at
                            ; all: the `-` there is literal, which is the branch
                            ; below.
                            if (lo > hi) {
                                failed = true
                                failMessage = "Range out of order in character class"
                                closed = true
                            }
                            push cls.ranges lo
                            push cls.ranges hi
                        } {
                            push cls.ranges lo
                            push cls.ranges lo
                            push cls.ranges 45
                            push cls.ranges 45
                        }
                    } {
                        push cls.ranges lo
                        push cls.ranges lo
                    }
                }
            }
        }
        if (false == closed) {
            failed = true
            failMessage = "Unterminated character class"
        }
        return cls
    }

    ; One member of a character class. Returns its code unit, or -1 when it was
    ; a shorthand (\d, \w, \s …) which is recorded on the class instead.
    fn readClassAtom:int (cls:RegexNode) {
        def c:string (this.uStr(pos))
        if (c == "\\") {
            def e:int (this.peekAt(1))
            ; The shorthands cannot take part in a range, so they are recorded
            ; separately and the caller is told there is no code unit.
            ; A property escape INSIDE a class contributes its whole set, and
            ; like a shorthand it cannot be one end of a range.
            if (uMode) {
                if ((e == 112) || (e == 80)) {
                    def cpid:int (this.readPropertyEscape((e == 80)))
                    if (cpid >= 0) {
                        push cls.props cpid
                    }
                    return (0 - 1)
                }
            }
            if (e == 100) {
                pos = (pos + 2)
                push cls.shorthands 1
                return (0 - 1)
            }
            if (e == 68) {
                pos = (pos + 2)
                push cls.shorthands 2
                return (0 - 1)
            }
            if (e == 119) {
                pos = (pos + 2)
                push cls.shorthands 3
                return (0 - 1)
            }
            if (e == 87) {
                pos = (pos + 2)
                push cls.shorthands 4
                return (0 - 1)
            }
            if (e == 115) {
                pos = (pos + 2)
                push cls.shorthands 5
                return (0 - 1)
            }
            if (e == 83) {
                pos = (pos + 2)
                push cls.shorthands 6
                return (0 - 1)
            }
            ; \b inside a class is a backspace, not a word boundary.
            if (e == 98) {
                pos = (pos + 2)
                return 8
            }
            return (this.readEscapedChar())
        }
        pos = (pos + 1)
        return (this.uAt((pos - 1)))
    }

    ; The code unit an escape sequence denotes, with `pos` on the backslash.
    fn readEscapedChar:int () {
        pos = (pos + 1)
        if (pos >= srcLen) {
            ; A backslash with nothing after it is not a literal backslash: the
            ; pattern simply ends mid-escape, which is a SyntaxError. Answering
            ; 92 accepted `new RegExp("\\")` as a one-character pattern.
            failed = true
            failMessage = "\\ at end of pattern"
            return 92
        }
        def e:int (this.uAt(pos))
        pos = (pos + 1)
        if (e == 110) { return 10 }
        if (e == 116) { return 9 }
        if (e == 114) { return 13 }
        if (e == 102) { return 12 }
        if (e == 118) { return 11 }
        if (e == 48) { return 0 }
        if (e == 120) {
            def v:int (this.readHex(2))
            if (v >= 0) { return v }
            return 120
        }
        if (e == 117) {
            ; `\u{...}` -- the Unicode-mode form, which is the only way to write
            ; a code point past U+FFFF in a pattern. Without it the braces were
            ; read as literal characters and `[\u{10400}]` matched the letter u.
            if (uMode) {
                if ((this.uAt(pos)) == 123) {
                    def bp:int (pos + 1)
                    def cp:int 0
                    def digits:int 0
                    def scanning:boolean true
                    while (scanning && (bp < srcLen)) {
                        def hc:int (this.uAt(bp))
                        def hv:int (0 - 1)
                        if ((hc >= 48) && (hc <= 57)) { hv = (hc - 48) }
                        if ((hc >= 97) && (hc <= 102)) { hv = ((hc - 97) + 10) }
                        if ((hc >= 65) && (hc <= 70)) { hv = ((hc - 65) + 10) }
                        if (hv < 0) {
                            ; Stop AT the non-digit -- the closing brace is
                            ; checked next, and moving the cursor to the end
                            ; instead lost it.
                            scanning = false
                        } {
                            cp = ((cp * 16) + hv)
                            digits = (digits + 1)
                            bp = (bp + 1)
                        }
                    }
                    if (digits > 0) {
                        if ((this.uAt(bp)) == 125) {
                            pos = (bp + 1)
                            return cp
                        }
                    }
                }
            }
            def v2:int (this.readHex(4))
            if (v2 >= 0) { return v2 }
            return 117
        }
        if (e == 99) {
            ; \cX is the control character for letter X.
            if (pos < srcLen) {
                def letter:int (this.uAt(pos))
                def upper:int letter
                if ((letter >= 97) && (letter <= 122)) { upper = (letter - 32) }
                if ((upper >= 65) && (upper <= 90)) {
                    pos = (pos + 1)
                    return (upper - 64)
                }
            }
            return 99
        }
        return e
    }

    fn readHex:int (count:int) {
        if ((pos + count) > srcLen) {
            return (0 - 1)
        }
        def v:int 0
        def i:int 0
        while (i < count) {
            def c:int (this.uAt((pos + i)))
            def d:int (0 - 1)
            if ((c >= 48) && (c <= 57)) { d = (c - 48) }
            if ((c >= 97) && (c <= 102)) { d = ((c - 97) + 10) }
            if ((c >= 65) && (c <= 70)) { d = ((c - 65) + 10) }
            if (d < 0) {
                return (0 - 1)
            }
            v = ((v * 16) + d)
            i = (i + 1)
        }
        pos = (pos + count)
        return v
    }

    ; `\p{Name}` / `\p{Key=Value}`, positioned at the backslash. Answers the
    ; encoded property id, or -1 having marked the pattern as failed.
    fn readPropertyEscape:int (negated:boolean) {
        if ((this.peekAt(2)) != 123) {
            failed = true
            failMessage = "Invalid property name"
            pos = (pos + 2)
            return (0 - 1)
        }
        def p:int (pos + 3)
        def raw:string ""
        def reading:boolean true
        while (reading && (p < srcLen)) {
            def c:string (this.uStr(p))
            if (c == "}") {
                reading = false
            } {
                raw = (raw + c)
                p = (p + 1)
            }
        }
        if reading {
            failed = true
            failMessage = "Invalid property name"
            pos = srcLen
            return (0 - 1)
        }
        pos = (p + 1)
        ; Canonicalised the way the table stores it: lowercase, and the two
        ; spellings of a general category -- `\p{Lu}` and
        ; `\p{General_Category=Lu}` -- name the same set.
        def name:string (RegexProps.lowerAscii(raw))
        def isGcLong:boolean (RegexProps.hasPrefix(name "general_category="))
        if isGcLong {
            name = (substring name 17 (strlen name))
        }
        def isGcShort:boolean (RegexProps.hasPrefix(name "gc="))
        if isGcShort {
            name = (substring name 3 (strlen name))
        }
        def isScShort:boolean (RegexProps.hasPrefix(name "sc="))
        if isScShort {
            name = ("script=" + (substring name 3 (strlen name)))
        }
        def isScxLong:boolean (RegexProps.hasPrefix(name "script_extensions="))
        if isScxLong {
            name = ("script=" + (substring name 18 (strlen name)))
        }
        def isScxShort:boolean (RegexProps.hasPrefix(name "scx="))
        if isScxShort {
            name = ("script=" + (substring name 4 (strlen name)))
        }
        ; A general category has a LONG name as well as its two-letter one, and
        ; both are legal: `\p{Letter}` is `\p{L}`. The table is generated from
        ; the short names -- the ranges are identical, so storing both would
        ; double it to say the same thing twice -- and the long spelling is
        ; folded onto the short one here instead.
        name = (this.canonicalGeneralCategory(name))
        def idx:int (RegexProps.indexOfName(name))
        if (idx < 0) {
            failed = true
            failMessage = ("Invalid property name: " + raw)
            return (0 - 1)
        }
        def encoded:int (idx * 2)
        if negated { encoded = (encoded + 1) }
        return encoded
    }

    ; The two-letter general category a long name spells out, or the name
    ; unchanged when it is not one. Lowercased already by the caller.
    fn canonicalGeneralCategory:string (name:string) {
        if (name == "letter") { return "l" }
        if (name == "uppercase_letter") { return "lu" }
        if (name == "lowercase_letter") { return "ll" }
        if (name == "titlecase_letter") { return "lt" }
        if (name == "modifier_letter") { return "lm" }
        if (name == "other_letter") { return "lo" }
        if (name == "cased_letter") { return "lc" }
        if (name == "mark") { return "m" }
        if (name == "combining_mark") { return "m" }
        if (name == "nonspacing_mark") { return "mn" }
        if (name == "spacing_mark") { return "mc" }
        if (name == "enclosing_mark") { return "me" }
        if (name == "number") { return "n" }
        if (name == "decimal_number") { return "nd" }
        if (name == "digit") { return "nd" }
        if (name == "letter_number") { return "nl" }
        if (name == "other_number") { return "no" }
        if (name == "punctuation") { return "p" }
        if (name == "punct") { return "p" }
        if (name == "connector_punctuation") { return "pc" }
        if (name == "dash_punctuation") { return "pd" }
        if (name == "open_punctuation") { return "ps" }
        if (name == "close_punctuation") { return "pe" }
        if (name == "initial_punctuation") { return "pi" }
        if (name == "final_punctuation") { return "pf" }
        if (name == "other_punctuation") { return "po" }
        if (name == "symbol") { return "s" }
        if (name == "math_symbol") { return "sm" }
        if (name == "currency_symbol") { return "sc" }
        if (name == "modifier_symbol") { return "sk" }
        if (name == "other_symbol") { return "so" }
        if (name == "separator") { return "z" }
        if (name == "space_separator") { return "zs" }
        if (name == "line_separator") { return "zl" }
        if (name == "paragraph_separator") { return "zp" }
        if (name == "other") { return "c" }
        if (name == "control") { return "cc" }
        if (name == "cntrl") { return "cc" }
        if (name == "format") { return "cf" }
        if (name == "private_use") { return "co" }
        if (name == "surrogate") { return "cs" }
        if (name == "unassigned") { return "cn" }
        return name
    }

    fn parseEscape:RegexNode () {
        def e:int (this.peekAt(1))
        ; Word-boundary assertions.
        if (e == 98) {
            pos = (pos + 2)
            def b (new RegexNode)
            b.kind = 5
            b.anchorKind = 2
            return b
        }
        if (e == 66) {
            pos = (pos + 2)
            def nb (new RegexNode)
            nb.kind = 5
            nb.anchorKind = 3
            return nb
        }
        ; The shorthands, as one-member classes.
        def short:int 0
        if (e == 100) { short = 1 }
        if (e == 68) { short = 2 }
        if (e == 119) { short = 3 }
        if (e == 87) { short = 4 }
        if (e == 115) { short = 5 }
        if (e == 83) { short = 6 }
        if (short > 0) {
            pos = (pos + 2)
            def sc (new RegexNode)
            sc.kind = 2
            push sc.shorthands short
            return sc
        }
        ; \p{...} / \P{...} — a Unicode property escape, which is a one-member
        ; CLASS whose members come from a table. Outside Unicode mode `\p` is an
        ; identity escape meaning the letter p, which the fall-through below
        ; already handles: the escape only has this meaning under `u`.
        if (uMode) {
            if ((e == 112) || (e == 80)) {
                def pid:int (this.readPropertyEscape((e == 80)))
                def pe (new RegexNode)
                pe.kind = 2
                if (pid >= 0) {
                    push pe.props pid
                }
                return pe
            }
        }
        ; `\k<name>` — a backreference by NAME. It may point forward, so the
        ; name rather than an index is carried and resolved at match time.
        if (e == 107) {
            if ((this.peekAt(2)) == 60) {
                def kp:int (pos + 3)
                def kname:string ""
                def reading:boolean true
                while (reading && (kp < srcLen)) {
                    def kc:string (this.uStr(kp))
                    if (kc == ">") {
                        reading = false
                    } {
                        kname = (kname + kc)
                        kp = (kp + 1)
                    }
                }
                if (false == reading) {
                    pos = (kp + 1)
                    def kb (new RegexNode)
                    kb.kind = 6
                    kb.groupName = kname
                    return kb
                }
            }
        }
        ; \1 .. \9 — a backreference, but only up to the number of groups the
        ; pattern actually has; beyond that it is an octal escape.
        if ((e >= 49) && (e <= 57)) {
            def p:int (pos + 1)
            def num:int 0
            while (p < srcLen) {
                def d:int (this.uAt(p))
                if ((d >= 48) && (d <= 57)) {
                    num = ((num * 10) + (d - 48))
                    p = (p + 1)
                } {
                    p = srcLen
                }
            }
            p = (pos + 1)
            num = 0
            def scanning:boolean true
            while (scanning && (p < srcLen)) {
                def d2:int (this.uAt(p))
                if ((d2 >= 48) && (d2 <= 57)) {
                    num = ((num * 10) + (d2 - 48))
                    p = (p + 1)
                } {
                    scanning = false
                }
            }
            pos = p
            def br (new RegexNode)
            br.kind = 6
            br.ch = num
            return br
        }
        def lit (new RegexNode)
        lit.kind = 0
        lit.ch = (this.readEscapedChar())
        return lit
    }
}

; =============================================================================
; Matcher
; =============================================================================
; The matcher walks a node list and recurses on the REMAINDER, which is what
; makes backtracking fall out of ordinary control flow: a quantifier tries a
; count, asks the rest of the pattern to match from there, and moves to the next
; count if that fails. Where the remainder is not lexically at hand -- inside a
; group, whose body must be able to give characters back to satisfy what follows
; the group -- it is carried explicitly as a RegexCont chain.
; A node list behind a reference, so a continuation frame holds a POINTER to it
; rather than a copy. Ranger copies an array field on assignment; the frames are
; allocated per attempt and a pattern's node lists never change once compiled.
class RegexNodeList {
    def nodes:[RegexNode]
}

; D-REGEX: the rest of the pattern, as data. A quantified GROUP cannot be matched
; in isolation -- the outer pattern has to be able to reject what the group found
; and ask it for a different inner match -- so the group descends into its body
; carrying the continuation that resumes the quantifier once the body completes.
; That is the continuation-passing matcher, encoded as an immutable linked list
; instead of function values, which Ranger does not have. Before this, a group
; took the first inner match that worked and `/^(a+)\1*,\1+$/` could not find a
; match that needed `(a+)` to give characters back.
class RegexCont {
    ; The end of the chain: reaching it means the whole pattern matched.
    def isEnd:boolean true
    def next@(optional):RegexCont
    def list@(optional):RegexNodeList
    ; Where to resume in `list`: the index of the quantified group itself, since
    ; the quantifier decides whether to go round again.
    def idx:int 0
    def quant@(optional):RegexNode
    ; Repetitions completed once the body now running finishes.
    def done:int 0
    ; The capture to close, and where this repetition began.
    def groupIndex:int 0
    def groupStart:int 0
    ; A LOOKBEHIND runs its sub-pattern with a required end position: the whole
    ; question is whether it can finish exactly where the lookbehind sits. -1
    ; means "anywhere", which is every other use of the end continuation.
    def mustEnd:int (0 - 1)
}

class RegexMatcher {
    def prog@(optional):RegexProgram
    def input:string ""
    ; The subject as code UNITS. Every position the matcher deals in -- where a
    ; match started, where a capture ran to, `lastIndex` -- is an index into
    ; this, which is what makes them the indices JavaScript reports.
    def inU:[int]
    def inLen:int 0
    ; An all-ASCII subject is left alone: every model already agrees about it,
    ; so the matcher reads the string directly and no unit array is built.
    ; Decoding unconditionally cost about 4% on the regex benchmark, all of it
    ; in allocating an array per exec for text that needed no translation.
    def inAscii:boolean true
    def capStart:[int]
    def capEnd:[int]
    ; D-MODIFIERS: the flags in force for the node being matched. Set from the
    ; node at the top of matchOnce, which is the only place any of the three is
    ; consulted -- so a `(?i:…)` group is case-insensitive and its surroundings
    ; are not.
    def effIc:boolean false
    def effMl:boolean false
    def effDot:boolean false
    ; Guards against a pathological pattern taking the process down with it.
    def steps:int 0
    def stepLimit:int 400000

    fn setup:void (p:RegexProgram s:string) {
        prog = p
        input = s
        inAscii = (RegexText.isAscii(s))
        if inAscii {
            def none:[int]
            inU = none
            inLen = (strlen s)
        } {
            inU = (RegexText.units(s))
            inLen = (array_length inU)
        }
        def n:int (p.groupCount + 1)
        def cs:[int]
        def ce:[int]
        def i:int 0
        while (i < n) {
            push cs (0 - 1)
            push ce (0 - 1)
            i = (i + 1)
        }
        capStart = cs
        capEnd = ce
        steps = 0
    }

    ; The code unit at `p`, or -1 outside the subject.
    fn cAt:int (p:int) {
        if (p < 0) { return (0 - 1) }
        if (p >= inLen) { return (0 - 1) }
        if inAscii {
            return (charAt input p)
        }
        return (itemAt inU p)
    }

    ; The first match at or after `from`, or a RegexMatch with matched false.
    fn exec:RegexMatch (from:int) {
        def out (new RegexMatch)
        def p:RegexProgram (unwrap prog)
        def start:int from
        if (start < 0) { start = 0 }
        while (start <= inLen) {
            this.resetCaptures()
            def alts:[RegexNode] p.alternatives
            def ai:int 0
            while (ai < (array_length alts)) {
                def alt:RegexNode (itemAt alts ai)
                def end:int (this.matchList(alt.children 0 start (this.endCont())))
                if (end >= 0) {
                    out.matched = true
                    out.start = start
                    out.end = end
                    out.capStart = (this.copyInts(capStart))
                    out.capEnd = (this.copyInts(capEnd))
                    return out
                }
                ai = (ai + 1)
            }
            start = (this.advanceIndex(start p.unicode))
        }
        return out
    }

    ; §22.2.7.3 AdvanceStringIndex. One code unit ordinarily; in Unicode mode a
    ; surrogate pair counts as one position, so a failed attempt at the high
    ; half resumes AFTER the character rather than inside it.
    fn advanceIndex:int (pos:int uni:boolean) {
        if (uni == false) { return (pos + 1) }
        if ((pos + 1) >= inLen) { return (pos + 1) }
        def hi:int (this.cAt(pos))
        if ((hi < 55296) || (hi > 56319)) { return (pos + 1) }
        def lo:int (this.cAt((pos + 1)))
        if ((lo < 56320) || (lo > 57343)) { return (pos + 1) }
        return (pos + 2)
    }

    fn copyInts:[int] (src:[int]) {
        def out:[int]
        def i:int 0
        while (i < (array_length src)) {
            push out (itemAt src i)
            i = (i + 1)
        }
        return out
    }

    fn resetCaptures:void () {
        def i:int 0
        while (i < (array_length capStart)) {
            set capStart i (0 - 1)
            set capEnd i (0 - 1)
            i = (i + 1)
        }
    }

    ; Every capture index inside a node, its own included. Each repetition of a
    ; quantified group CLEARS these before matching its body, per the spec's
    ; RepeatMatcher: a group that participated on an earlier pass and not on this
    ; one reports undefined, it does not keep the earlier text. `/(z)((a+)?(b+)?(c))*/`
    ; against "zaacbbbcac" is the standard demonstration -- the `(b+)` is undefined
    ; because the last repetition had no b, even though an earlier one did.
    fn collectGroupIndexes:void (n:RegexNode out:[int]) {
        if (n.groupIndex > 0) {
            push out n.groupIndex
        }
        def i:int 0
        while (i < (array_length n.children)) {
            this.collectGroupIndexes((itemAt n.children i) out)
            i = (i + 1)
        }
    }

    fn clearGroupsIn:void (n:RegexNode) {
        def idxs:[int]
        this.collectGroupIndexes(n idxs)
        def i:int 0
        while (i < (array_length idxs)) {
            def gi:int (itemAt idxs i)
            if (gi < (array_length capStart)) {
                set capStart gi (0 - 1)
                set capEnd gi (0 - 1)
            }
            i = (i + 1)
        }
    }

    ; The empty continuation: nothing left to match, so reaching it is a match.
    fn endCont:RegexCont () {
        def c (new RegexCont)
        c.isEnd = true
        return c
    }

    fn endContAt:RegexCont (p:int) {
        def c (new RegexCont)
        c.isEnd = true
        c.mustEnd = p
        return c
    }

    ; Match nodes[i..] starting at `pos`, then whatever `cont` says comes after.
    ; Returns the end position, or -1.
    fn matchList:int (nodes:[RegexNode] i:int pos:int cont:RegexCont) {
        steps = (steps + 1)
        if (steps > stepLimit) {
            return (0 - 1)
        }
        if (i >= (array_length nodes)) {
            if cont.isEnd {
                if (cont.mustEnd >= 0) {
                    if (pos != cont.mustEnd) {
                        return (0 - 1)
                    }
                }
                return pos
            }
            return (this.resumeCont(cont pos))
        }
        def n:RegexNode (itemAt nodes i)
        return (this.matchQuantified(nodes i n pos 0 cont false))
    }

    ; A group's body finished at `pos`; carry on where the group left off. The
    ; capture is closed HERE rather than when the body matched, so a backreference
    ; later in the same pattern sees the repetition that actually stuck.
    fn resumeCont:int (cont:RegexCont pos:int) {
        steps = (steps + 1)
        if (steps > stepLimit) {
            return (0 - 1)
        }
        def nxt:RegexCont (this.endCont())
        if cont.next {
            nxt = (unwrap cont.next)
        }
        def lst:RegexNodeList (unwrap cont.list)
        if (null? cont.quant) {
            return (this.matchList(lst.nodes cont.idx pos nxt))
        }
        def qn:RegexNode (unwrap cont.quant)
        def savedS:[int] (this.copyInts(capStart))
        def savedE:[int] (this.copyInts(capEnd))
        if (cont.groupIndex > 0) {
            set capStart cont.groupIndex cont.groupStart
            set capEnd cont.groupIndex pos
        }
        ; A repetition that consumed nothing would repeat forever, so once the
        ; minimum is met a zero-width body ends the expansion.
        def blockMore:boolean false
        if (pos == cont.groupStart) {
            if (cont.done >= qn.min) {
                blockMore = true
            }
        }
        def r:int (this.matchQuantified(lst.nodes cont.idx qn pos cont.done nxt blockMore))
        if (r >= 0) {
            return r
        }
        this.restoreCaptures(savedS savedE)
        return (0 - 1)
    }

    ; One node with its quantifier. `done` counts repetitions already matched.
    ; Greedy tries one more first and falls back to stopping; lazy the reverse.
    ; `blockMore` refuses another repetition, which is how a zero-width group body
    ; is stopped from looping.
    fn matchQuantified:int (nodes:[RegexNode] i:int n:RegexNode pos:int done:int cont:RegexCont blockMore:boolean) {
        steps = (steps + 1)
        if (steps > stepLimit) {
            return (0 - 1)
        }
        def canStop:boolean (done >= n.min)
        def canGo:boolean true
        if (n.max >= 0) {
            if (done >= n.max) { canGo = false }
        }
        if blockMore {
            canGo = false
        }
        if (false == n.greedy) {
            if canStop {
                def lazyOut:int (this.matchList(nodes (i + 1) pos cont))
                if (lazyOut >= 0) {
                    return lazyOut
                }
            }
        }
        if canGo {
            ; Try one more repetition. Captures are saved so a failed attempt
            ; leaves none of its groups behind.
            def savedS:[int] (this.copyInts(capStart))
            def savedE:[int] (this.copyInts(capEnd))
            if (n.kind == 3) {
                ; A GROUP descends into its body carrying the continuation that
                ; brings control back here. Its inner quantifiers then backtrack
                ; against everything that follows the group, which is the whole
                ; difference from matching the body in isolation.
                def wrapper (new RegexNodeList)
                wrapper.nodes = nodes
                def frame (new RegexCont)
                frame.isEnd = false
                frame.next = cont
                frame.list = wrapper
                frame.idx = i
                frame.quant = n
                frame.done = (done + 1)
                frame.groupIndex = n.groupIndex
                frame.groupStart = pos
                def ai:int 0
                while (ai < (array_length n.children)) {
                    def alt:RegexNode (itemAt n.children ai)
                    this.clearGroupsIn(n)
                    def r:int (this.matchList(alt.children 0 pos frame))
                    if (r >= 0) {
                        return r
                    }
                    this.restoreCaptures(savedS savedE)
                    ai = (ai + 1)
                }
            } {
                def once:int (this.matchOnce(n pos))
                if (once >= 0) {
                    ; A zero-width repetition would loop forever; stop expanding.
                    def progressed:boolean (once > pos)
                    if (progressed || (done < n.min)) {
                        def deeper:int (this.matchQuantified(nodes i n once (done + 1) cont false))
                        if (deeper >= 0) {
                            return deeper
                        }
                    }
                }
            }
            this.restoreCaptures(savedS savedE)
        }
        if n.greedy {
            if canStop {
                return (this.matchList(nodes (i + 1) pos cont))
            }
        }
        return (0 - 1)
    }

    fn restoreCaptures:void (s:[int] e:[int]) {
        def i:int 0
        while (i < (array_length s)) {
            set capStart i (itemAt s i)
            set capEnd i (itemAt e i)
            i = (i + 1)
        }
    }

    ; Match exactly one occurrence of a node. Returns the end position or -1.
    ; A GROUP has to know the rest of the pattern to backtrack correctly, so it
    ; is handled here only for the simple case and by matchGroupThen otherwise.
    fn matchOnce:int (n:RegexNode pos:int) {
        def p:RegexProgram (unwrap prog)
        effIc = n.effIc
        effMl = n.effMl
        effDot = n.effDot
        if (n.kind == 0) {
            if (pos >= inLen) { return (0 - 1) }
            ; A literal past U+FFFF -- written `\u{1F600}` -- is one CODE POINT
            ; and two code units, so it is compared as a code point and consumes
            ; both. Comparing the unit alone could only ever match a surrogate
            ; half, which no pattern means.
            if (n.ch > 65535) {
                if p.unicode {
                    if ((pos + 1) < inLen) {
                        def hiU:int (this.cAt(pos))
                        def loU:int (this.cAt((pos + 1)))
                        if ((hiU >= 55296) && (hiU <= 56319)) {
                            if ((loU >= 56320) && (loU <= 57343)) {
                                def cpHere:int ((65536 + ((hiU - 55296) * 1024)) + (loU - 56320))
                                if (cpHere == n.ch) {
                                    return (pos + 2)
                                }
                            }
                        }
                    }
                    ; The code-POINT string model stores it as one unit, so the
                    ; direct comparison below still has to run.
                }
            }
            if (this.sameChar((this.cAt(pos)) n.ch)) {
                return (pos + 1)
            }
            return (0 - 1)
        }
        if (n.kind == 1) {
            if (pos >= inLen) { return (0 - 1) }
            ; `.` matches anything except a line terminator -- and in Unicode
            ; mode it matches ONE CHARACTER, which for a supplementary one is
            ; two code units. Consuming a single unit made /./gu count an emoji
            ; twice and left the cursor between the halves of a pair.
            def c:int (this.cAt(pos))
            ; ...unless `s` is set, which is the entire content of that flag.
            if (false == effDot) {
                if ((c == 10) || (c == 13)) { return (0 - 1) }
                if ((c == 8232) || (c == 8233)) { return (0 - 1) }
            }
            return (this.advanceIndex(pos p.unicode))
        }
        if (n.kind == 2) {
            ; D-VFLAG: `\q{ab|c}` puts whole STRINGS in a class, so the class
            ; may consume more than one character. The longest alternative wins,
            ; which is what makes `[\q{abc|a}]` match "abc" rather than "a".
            def strHit:int (this.classStringMatch(n pos))
            if (strHit >= 0) {
                return strHit
            }
            if (pos >= inLen) { return (0 - 1) }
            ; In Unicode mode a class is tested against the CODE POINT, not the
            ; code unit: a `\p{L}` against an astral letter saw only the high
            ; surrogate, which belongs to no property at all.
            def cc:int (this.cAt(pos))
            if p.unicode {
                if ((cc >= 55296) && (cc <= 56319)) {
                    if ((pos + 1) < inLen) {
                        def lowU:int (this.cAt((pos + 1)))
                        if ((lowU >= 56320) && (lowU <= 57343)) {
                            cc = ((65536 + ((cc - 55296) * 1024)) + (lowU - 56320))
                        }
                    }
                }
            }
            if (this.classMatches(n cc)) {
                return (this.advanceIndex(pos p.unicode))
            }
            return (0 - 1)
        }
        if (n.kind == 5) {
            if (this.anchorHolds(n pos)) {
                return pos
            }
            return (0 - 1)
        }
        if (n.kind == 6) {
            return (this.matchBackref(n pos))
        }
        if (n.kind == 7) {
            def look:boolean (this.lookaheadHolds(n pos))
            if (look != n.lookNegate) {
                return pos
            }
            return (0 - 1)
        }
        if (n.kind == 8) {
            def behind:boolean (this.lookbehindHolds(n pos))
            if (behind != n.lookNegate) {
                return pos
            }
            return (0 - 1)
        }
        ; A GROUP never reaches here: it needs the rest of the pattern in order
        ; to backtrack, so matchQuantified handles it with a continuation.
        return (0 - 1)
    }

    fn matchBackref:int (n:RegexNode pos:int) {
        def gi:int n.ch
        if ((strlen n.groupName) > 0) {
            def bp:RegexProgram (unwrap prog)
            gi = 0
            def gn:int 1
            while (gn < (array_length bp.groupNames)) {
                if ((itemAt bp.groupNames gn) == n.groupName) {
                    gi = gn
                    gn = (array_length bp.groupNames)
                } {
                    gn = (gn + 1)
                }
            }
            ; A name the pattern does not define matches empty, the same way an
            ; out-of-range numeric reference does.
            if (gi == 0) { return pos }
        }
        if (gi >= (array_length capStart)) {
            ; A reference to a group the pattern does not have matches empty.
            return pos
        }
        def cs:int (itemAt capStart gi)
        def ce:int (itemAt capEnd gi)
        if (cs < 0) {
            ; An unparticipating group backreferences the empty string.
            return pos
        }
        def len:int (ce - cs)
        if ((pos + len) > inLen) {
            return (0 - 1)
        }
        def k:int 0
        while (k < len) {
            if (false == (this.sameChar((this.cAt((pos + k))) (this.cAt((cs + k)))))) {
                return (0 - 1)
            }
            k = (k + 1)
        }
        return (pos + len)
    }

    fn lookaheadHolds:boolean (n:RegexNode pos:int) {
        def savedS:[int] (this.copyInts(capStart))
        def savedE:[int] (this.copyInts(capEnd))
        def ai:int 0
        while (ai < (array_length n.children)) {
            def alt:RegexNode (itemAt n.children ai)
            ; A lookahead is an INDEPENDENT sub-match: nothing after it can make
            ; it give characters back, so it runs on an empty continuation.
            def end:int (this.matchList(alt.children 0 pos (this.endCont())))
            if (end >= 0) {
                ; A NEGATIVE lookahead leaves no captures behind.
                if n.lookNegate {
                    this.restoreCaptures(savedS savedE)
                }
                return true
            }
            ai = (ai + 1)
        }
        this.restoreCaptures(savedS savedE)
        return false
    }

    ; A lookbehind asks whether the sub-pattern matches the text ENDING here.
    ; It is answered by trying every start position and requiring the sub-match
    ; to finish exactly at `pos` -- which is what the mustEnd continuation is
    ; for, so the sub-pattern still backtracks properly rather than being
    ; accepted on its first (possibly too long) reading.
    fn lookbehindHolds:boolean (n:RegexNode pos:int) {
        def savedS:[int] (this.copyInts(capStart))
        def savedE:[int] (this.copyInts(capEnd))
        def from:int pos
        while (from >= 0) {
            def ai:int 0
            while (ai < (array_length n.children)) {
                def alt:RegexNode (itemAt n.children ai)
                def end:int (this.matchList(alt.children 0 from (this.endContAt(pos))))
                if (end >= 0) {
                    if n.lookNegate {
                        this.restoreCaptures(savedS savedE)
                    }
                    return true
                }
                ai = (ai + 1)
            }
            from = (from - 1)
        }
        this.restoreCaptures(savedS savedE)
        return false
    }

    fn anchorHolds:boolean (n:RegexNode pos:int) {
        def p:RegexProgram (unwrap prog)
        if (n.anchorKind == 0) {
            if (pos == 0) { return true }
            if effMl {
                def prev:int (this.cAt((pos - 1)))
                if ((prev == 10) || (prev == 13)) { return true }
            }
            return false
        }
        if (n.anchorKind == 1) {
            if (pos == inLen) { return true }
            if effMl {
                def here:int (this.cAt(pos))
                if ((here == 10) || (here == 13)) { return true }
            }
            return false
        }
        def before:boolean false
        def after:boolean false
        if (pos > 0) { before = (this.isWordChar((this.cAt((pos - 1))))) }
        if (pos < inLen) { after = (this.isWordChar((this.cAt(pos)))) }
        def boundary:boolean (before != after)
        if (n.anchorKind == 2) {
            return boundary
        }
        return (false == boundary)
    }

    fn isWordChar:boolean (c:int) {
        if ((c >= 48) && (c <= 57)) { return true }
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 97) && (c <= 122)) { return true }
        if (c == 95) { return true }
        return false
    }

    fn isSpaceChar:boolean (c:int) {
        if (c == 32) { return true }
        if ((c >= 9) && (c <= 13)) { return true }
        if (c == 160) { return true }
        if (c == 65279) { return true }
        if ((c >= 8192) && (c <= 8202)) { return true }
        if (c == 8232) { return true }
        if (c == 8233) { return true }
        if (c == 8239) { return true }
        if (c == 8287) { return true }
        if (c == 12288) { return true }
        return false
    }

    ; D-VFLAG: a `v` class is a SET EXPRESSION over operands, so membership is
    ; the operation applied to what each operand answers. A class with no
    ; operands is the ordinary kind and answers from its own members alone.
    ; The end position of the longest `\q{…}` alternative matching at `at`, or
    ; -1. Searched through the whole operand tree, since a nested class carries
    ; its own strings.
    fn classStringMatch:int (n:RegexNode at:int) {
        def best:int (0 - 1)
        def si:int 0
        while (si < (array_length n.strings)) {
            def want:string (itemAt n.strings si)
            def wu:[int] (RegexText.units(want))
            def wn:int (array_length wu)
            if (wn > 0) {
                if ((at + wn) <= inLen) {
                    def ok:boolean true
                    def k:int 0
                    while (k < wn) {
                        if (false == (this.sameChar((this.cAt((at + k))) (itemAt wu k)))) {
                            ok = false
                            k = wn
                        } {
                            k = (k + 1)
                        }
                    }
                    if ok {
                        if ((at + wn) > best) { best = (at + wn) }
                    }
                }
            }
            si = (si + 1)
        }
        ; A negated class does not match strings at all -- there is no
        ; complement of a set of strings.
        if n.negate {
            return (0 - 1)
        }
        def ci:int 0
        while (ci < (array_length n.subClasses)) {
            ; Only a UNION carries its operands' strings outward; an
            ; intersection or difference of string sets is not something the
            ; grammar can produce here.
            if (n.setOp == 0) {
                def sub:int (this.classStringMatch((itemAt n.subClasses ci) at))
                if (sub > best) { best = sub }
            }
            ci = (ci + 1)
        }
        return best
    }

    fn classMatches:boolean (n:RegexNode c:int) {
        def opCount:int (array_length n.subClasses)
        if (opCount == 0) {
            return (this.classSelfMatches(n c))
        }
        def hit:boolean false
        if (n.setOp == 0) {
            ; Union: the class's own members plus every operand's.
            hit = (this.classSelfMatches(n c))
            if n.negate { hit = (false == hit) }
            def ui:int 0
            while (ui < opCount) {
                if (this.classMatches((itemAt n.subClasses ui) c)) { hit = true }
                ui = (ui + 1)
            }
        }
        if (n.setOp == 1) {
            ; Intersection: every operand must hold.
            hit = true
            def ii:int 0
            while (ii < opCount) {
                if (false == (this.classMatches((itemAt n.subClasses ii) c))) {
                    hit = false
                }
                ii = (ii + 1)
            }
        }
        if (n.setOp == 2) {
            ; Difference: the first operand, minus every later one.
            hit = (this.classMatches((itemAt n.subClasses 0) c))
            def di:int 1
            while (di < opCount) {
                if (this.classMatches((itemAt n.subClasses di) c)) { hit = false }
                di = (di + 1)
            }
        }
        if n.negate {
            return (false == hit)
        }
        return hit
    }

    fn classSelfMatches:boolean (n:RegexNode c:int) {
        def hit:boolean false
        def i:int 0
        while (i < (array_length n.ranges)) {
            def lo:int (itemAt n.ranges i)
            def hi:int (itemAt n.ranges (i + 1))
            if ((c >= lo) && (c <= hi)) {
                hit = true
            } {
                ; Case-insensitive matching folds the INPUT character, so a
                ; range written in one case still covers the other.
                if effIc {
                    def alt:int (this.swapCase(c))
                    if (alt != c) {
                        if ((alt >= lo) && (alt <= hi)) { hit = true }
                    }
                }
            }
            i = (i + 2)
        }
        def si:int 0
        while (si < (array_length n.shorthands)) {
            def sh:int (itemAt n.shorthands si)
            if (sh == 1) { if (this.isDigit(c)) { hit = true } }
            if (sh == 2) { if (false == (this.isDigit(c))) { hit = true } }
            if (sh == 3) { if (this.isWordChar(c)) { hit = true } }
            if (sh == 4) { if (false == (this.isWordChar(c))) { hit = true } }
            if (sh == 5) { if (this.isSpaceChar(c)) { hit = true } }
            if (sh == 6) { if (false == (this.isSpaceChar(c))) { hit = true } }
            si = (si + 1)
        }
        ; D-PROPS: the \p{...} members. `c` is a code point here -- the matcher
        ; hands whole characters to a class in Unicode mode -- so the table is
        ; consulted directly.
        def pi:int 0
        while (pi < (array_length n.props)) {
            def enc:int (itemAt n.props pi)
            def pIdx:int (bit_shr enc 1)
            def pNeg:boolean ((bit_and enc 1) == 1)
            def inSet:boolean (RegexProps.holds(pIdx c))
            if (inSet != pNeg) { hit = true }
            pi = (pi + 1)
        }
        if n.negate {
            return (false == hit)
        }
        return hit
    }

    fn isDigit:boolean (c:int) {
        return ((c >= 48) && (c <= 57))
    }

    fn swapCase:int (c:int) {
        if ((c >= 65) && (c <= 90)) { return (c + 32) }
        if ((c >= 97) && (c <= 122)) { return (c - 32) }
        return c
    }

    fn sameChar:boolean (a:int b:int) {
        if (a == b) {
            return true
        }
        def p:RegexProgram (unwrap prog)
        if effIc {
            return ((this.swapCase(a)) == b)
        }
        return false
    }
}

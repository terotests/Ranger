; =============================================================================
; EvValue — E1 target shape (PLAN_SHAPES.md §7.5 / §3.1)
; =============================================================================
; Closed family for the kind discriminant (PLAN_SHAPES.md §7.5 step 4).
; Named EvValue so `class EvalValue` can keep holding collection payloads
; and identity while `body:EvValue` owns the kind. E3 create/check goes
; through EvValueBridge; E4 deletes `valueType` in favour of this shape.
;
; Groups:
;   Primitive       — Null / Undefined / Hole / Number / String / Boolean
;   Reference       — identity-bearing cases
;   PropertyCarrier — objects that own a property bag
;   Callable        — values that can be invoked (required capability)

Import "../../../evg/EVGElement.rgr"

class EvMapEntry {
    def key:EvValue
    def value:EvValue
}

shape EvPropertySlot {
    case Data {
        def value:EvValue
        def attributes:int 0
    }
    case Accessor {
        def getter@(optional):EvValue
        def setter@(optional):EvValue
        def attributes:int 0
    }
}

class EvPropertyBag {
    def slots:[string:EvPropertySlot]
    def prototype@(optional):EvValue
    def extensible:boolean true
    def sealed:boolean false
    def frozen:boolean false

    ; E4c: property-bag SoT. Value payload is EvValue (avoids EvalValue import cycle).
    fn hasData:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            ; Hole value = attrs-only placeholder (setAttrs before a value),
            ; not a real data property — array index attrs must not shadow
            ; dense elements on Array.prototype.
            def v:EvValue (unwrap d.value)
            if (EvValue.isHole(v)) {
                return false
            }
            return true
        }
        return false
    }
    fn getData:EvValue (key:string) {
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            ; Case field typed as a shape without a default is optional at the
            ; type level; putData always sets it.
            return (unwrap d.value)
        }
        return (EvValue.undefined())
    }
    fn putData:void (key:string value:EvValue attrs:int) {
        ; Bind through the union type so Rust gets union_EvPropertySlot, not the
        ; bare case struct (same pattern as `def a:Value (new Value.Num(...))`).
        def slot:EvPropertySlot (new EvPropertySlot.Data(value attrs))
        set slots key slot
    }
    fn removeData:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def rebuilt:[string:EvPropertySlot]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (kk != key) {
                set rebuilt kk (unwrap (get slots kk))
            }
        }
        slots = rebuilt
    }
    fn dataKeys:[string] () {
        def out:[string]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            def slot:EvPropertySlot (unwrap (get slots kk))
            case slot d:EvPropertySlot.Data {
                push out kk
            }
        }
        return out
    }

    fn hasSlot:boolean (key:string) {
        return (has slots key)
    }
    fn attrsOf:int (key:string) {
        if (false == (has slots key)) {
            return 7
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            return d.attributes
        }
        case slot a:EvPropertySlot.Accessor {
            return a.attributes
        }
        return 7
    }
    fn setAttrsOn:void (key:string attrs:int) {
        if (false == (has slots key)) {
            ; Attribute bits without a value — Hole placeholder so hasData is
            ; false (must not shadow array dense indexes / inherited reads).
            def slot0:EvPropertySlot (new EvPropertySlot.Data((EvValue.hole()) attrs))
            set slots key slot0
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            def slotD:EvPropertySlot (new EvPropertySlot.Data((unwrap d.value) attrs))
            set slots key slotD
            return
        }
        case slot a:EvPropertySlot.Accessor {
            ; Hole sentinel = absent half (ctor requires non-optional EvValue).
            def g:EvValue (EvValue.hole())
            def s:EvValue (EvValue.hole())
            if a.getter {
                g = (unwrap a.getter)
            }
            if a.setter {
                s = (unwrap a.setter)
            }
            def slotA:EvPropertySlot (new EvPropertySlot.Accessor(g s attrs))
            set slots key slotA
        }
    }

    fn hasGetter:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            if a.getter {
                def g:EvValue (unwrap a.getter)
                if (false == (EvValue.isHole(g))) {
                    return true
                }
            }
        }
        return false
    }
    fn hasSetter:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            if a.setter {
                def s:EvValue (unwrap a.setter)
                if (false == (EvValue.isHole(s))) {
                    return true
                }
            }
        }
        return false
    }
    fn hasAccessor:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            return true
        }
        return false
    }
    fn getGetter:EvValue (key:string) {
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            return (unwrap a.getter)
        }
        return (EvValue.undefined())
    }
    fn getSetter:EvValue (key:string) {
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            return (unwrap a.setter)
        }
        return (EvValue.undefined())
    }
    fn putGetter:void (key:string g:EvValue attrs:int) {
        def useAttrs:int attrs
        def s:EvValue (EvValue.hole())
        if (has slots key) {
            def slot:EvPropertySlot (unwrap (get slots key))
            case slot a:EvPropertySlot.Accessor {
                if a.setter {
                    def sv:EvValue (unwrap a.setter)
                    if (false == (EvValue.isHole(sv))) {
                        s = sv
                    }
                }
                useAttrs = a.attributes
            }
        }
        def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s useAttrs))
        set slots key slotN
    }
    fn putSetter:void (key:string s:EvValue attrs:int) {
        def useAttrs:int attrs
        def g:EvValue (EvValue.hole())
        if (has slots key) {
            def slot:EvPropertySlot (unwrap (get slots key))
            case slot a:EvPropertySlot.Accessor {
                if a.getter {
                    def gv:EvValue (unwrap a.getter)
                    if (false == (EvValue.isHole(gv))) {
                        g = gv
                    }
                }
                useAttrs = a.attributes
            }
        }
        def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s useAttrs))
        set slots key slotN
    }
    fn clearGetter:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            def s:EvValue (EvValue.hole())
            def at:int a.attributes
            if a.setter {
                def sv:EvValue (unwrap a.setter)
                if (false == (EvValue.isHole(sv))) {
                    s = sv
                }
            }
            if (EvValue.isHole(s)) {
                this.removeData(key)
            } {
                def g:EvValue (EvValue.hole())
                def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s at))
                set slots key slotN
            }
        }
    }
    fn clearSetter:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            def g:EvValue (EvValue.hole())
            def at:int a.attributes
            if a.getter {
                def gv:EvValue (unwrap a.getter)
                if (false == (EvValue.isHole(gv))) {
                    g = gv
                }
            }
            if (EvValue.isHole(g)) {
                this.removeData(key)
            } {
                def s:EvValue (EvValue.hole())
                def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s at))
                set slots key slotN
            }
        }
    }
    fn clearAccessor:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            this.removeData(key)
        }
    }
    fn getterKeys:[string] () {
        def out:[string]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (this.hasGetter(kk)) {
                push out kk
            }
        }
        return out
    }
    fn setterKeys:[string] () {
        def out:[string]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (this.hasSetter(kk)) {
                push out kk
            }
        }
        return out
    }

    fn hasPrototype:boolean () {
        if prototype {
            return true
        }
        return false
    }
    fn getPrototype:EvValue () {
        return (unwrap prototype)
    }
    fn setPrototype:void (p:EvValue) {
        prototype = p
    }
}

; Function core shared across bindings (PLAN_SHAPES.md §7.3). Identity lives
; on the Reference group of the Function case, not here.
class EvFunctionCore {
    def functionName:string ""
    def closureId:int (0 - 1)
    def homeModule:string ""
    def srcText:string ""
    def builtinKind:string ""
    def builtinName:string ""
    def builtinNamespace:string ""
    def strictFn:boolean false
}

class EvFunctionBinding {
    def boundThis@(optional):EvValue
    def boundArgs:[EvValue]
    def boundExplicit:boolean false
}

shape EvValue {
    group Primitive @(value)

    group Reference @(reference) {
        def identityId:int 0
    }

    group PropertyCarrier does Reference {
        ; Default-constructed so the field is non-optional (class-typed
        ; fields without a default are treated as optional, which breaks
        ; the generated group getter's return type).
        def properties:EvPropertyBag (new EvPropertyBag())
    }

    ; Capability: every callable case must name itself for dispatch smoke tests.
    ; Real invoke (engine call) lands when ComponentEngine converts by kind.
    group Callable does PropertyCarrier {
        fn invokeLabel:string ()
    }

    case Null      does Primitive
    case Undefined does Primitive
    case Hole      does Primitive
    case Number    does Primitive {
        def value:double 0.0
    }
    case String    does Primitive {
        def value:string ""
    }
    case Boolean   does Primitive {
        def value:boolean false
    }

    case Array does PropertyCarrier {
        def items:[EvValue]
        def declaredLength:int (0 - 1)
    }
    case Object does PropertyCarrier
    case Function does Callable {
        def core:EvFunctionCore
        def binding:EvFunctionBinding
        fn invokeLabel:string () {
            def c:EvFunctionCore core
            return c.functionName
        }
    }
    case Map does PropertyCarrier {
        def entries:[EvMapEntry]
    }
    case Set does PropertyCarrier {
        def items:[EvValue]
    }
    case Element does Reference {
        def element:EVGElement
    }

    fn toBool:boolean () {
        match self {
            Null | Undefined | Hole {
                return false
            }
            Number n {
                return ((n.value == n.value) && (n.value != 0.0))
            }
            String s {
                return ((strlen s.value) > 0)
            }
            Boolean b {
                return b.value
            }
            Reference {
                return true
            }
        }
        return false
    }

    ; ---- E2 compatibility factories (PLAN_SHAPES.md §7.5) -----------------
    ; Same call spelling as class EvalValue.* so call sites can switch one
    ; kind at a time. Not wired into ComponentEngine yet.

    sfn null:EvValue () {
        return (new EvValue.Null())
    }
    sfn undefined:EvValue () {
        return (new EvValue.Undefined())
    }
    sfn hole:EvValue () {
        return (new EvValue.Hole())
    }
    sfn number:EvValue (n:double) {
        return (new EvValue.Number(n))
    }
    sfn string:EvValue (s:string) {
        return (new EvValue.String(s))
    }
    sfn boolean:EvValue (b:boolean) {
        return (new EvValue.Boolean(b))
    }

    ; ---- E3 reference / carrier factories (fixture + bridge kind arms) ----
    ; Case ctors take Reference.identityId then PropertyCarrier.properties
    ; (when applicable) before the case's own fields — see E1 fixture.
    sfn element:EvValue (el:EVGElement) {
        return (EvValue.elementAt(0 el))
    }
    sfn elementAt:EvValue (id:int el:EVGElement) {
        return (new EvValue.Element(id el))
    }
    sfn array:EvValue (items:[EvValue]) {
        return (EvValue.arrayAt(0 items))
    }
    sfn arrayAt:EvValue (id:int items:[EvValue]) {
        def props:EvPropertyBag (new EvPropertyBag())
        return (new EvValue.Array(id props items (array_length items)))
    }
    sfn object:EvValue () {
        return (EvValue.objectAt(0))
    }
    sfn objectAt:EvValue (id:int) {
        def props:EvPropertyBag (new EvPropertyBag())
        return (new EvValue.Object(id props))
    }
    sfn mapEmpty:EvValue () {
        return (EvValue.mapEmptyAt(0))
    }
    sfn mapEmptyAt:EvValue (id:int) {
        def props:EvPropertyBag (new EvPropertyBag())
        ; Bind the empty literal — Rust case ctors drop a bare `([] _:T ())`
        ; argument (ISSUES / empty typed array as ctor arg).
        def entries:[EvMapEntry]
        return (new EvValue.Map(id props entries))
    }
    sfn setEmpty:EvValue () {
        return (EvValue.setEmptyAt(0))
    }
    sfn setEmptyAt:EvValue (id:int) {
        def props:EvPropertyBag (new EvPropertyBag())
        def items:[EvValue]
        return (new EvValue.Set(id props items))
    }
    sfn functionStub:EvValue (name:string) {
        return (EvValue.functionStubAt(0 name))
    }
    sfn functionStubAt:EvValue (id:int name:string) {
        def props:EvPropertyBag (new EvPropertyBag())
        def c:EvFunctionCore (new EvFunctionCore())
        c.functionName = name
        def b:EvFunctionBinding (new EvFunctionBinding())
        return (new EvValue.Function(id props c b))
    }

    fn isNull:boolean () {
        case self n:EvValue.Null {
            return true
        }
        return false
    }
    fn isNumber:boolean () {
        case self n:EvValue.Number {
            return true
        }
        return false
    }
    fn isString:boolean () {
        case self n:EvValue.String {
            return true
        }
        return false
    }
    fn isHole:boolean () {
        case self n:EvValue.Hole {
            return true
        }
        return false
    }
    fn isUndefined:boolean () {
        case self n:EvValue.Undefined {
            return true
        }
        return false
    }
    fn isBoolean:boolean () {
        case self n:EvValue.Boolean {
            return true
        }
        return false
    }
    fn isNullOrUndefined:boolean () {
        case self n:EvValue.Null {
            return true
        }
        case self u:EvValue.Undefined {
            return true
        }
        return false
    }
    fn isElement:boolean () {
        case self n:EvValue.Element {
            return true
        }
        return false
    }
    ; Named isArrayValue — a global `isArray` operator blocks methods named isArray.
    fn isArrayValue:boolean () {
        case self n:EvValue.Array {
            return true
        }
        return false
    }
    fn isObject:boolean () {
        case self n:EvValue.Object {
            return true
        }
        return false
    }
    fn isFunction:boolean () {
        case self n:EvValue.Function {
            return true
        }
        return false
    }
    fn isMap:boolean () {
        case self n:EvValue.Map {
            return true
        }
        return false
    }
    fn isSet:boolean () {
        case self n:EvValue.Set {
            return true
        }
        return false
    }
}

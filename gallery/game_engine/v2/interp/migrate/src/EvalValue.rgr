; =============================================================================
; EvalValue - Runtime value type for expression evaluation
; =============================================================================
; Represents values that can be evaluated: numbers, strings, booleans, 
; null, arrays, objects, functions, and EVG elements.
;
; Migration (PLAN_SHAPES.md §7.5 step 4 / E4c): kind lives in `body:EvValue`.
; Array dense items + declaredLength are SoT on `body` (Array case). Object /
; Map / Set payloads still sit on this class until their cutovers. `valueType`
; is gone. Shape storage holds `EvValue`; `EvValueHandles` round-trips refs.

Import "../../../evg/EVGElement.rgr"
Import "../../../../../ts_parser/ts_parser_simple.rgr"
Import "EvValue.rgr"

; Kind discriminant: `body` (shape EvValue). Legacy int tags are gone.
; Map: keys in arrayValue, values in mapVals. Set: elements in arrayValue.

; Runtime hooks the LLVM backend replaces with intrinsics. Every other target
; keeps these bodies, so the optimisations they gate simply never fire there --
; the answers below are the conservative ones.
class RangerMem {
    sfn liveObjects:int () { return 0 }
    sfn resetStats:void () { }
    ; "Is the value under `key` held by nothing but this map?" Only a reference
    ; counted runtime can answer; without one the honest answer is "cannot tell",
    ; which callers must read as "not unique".
    sfn mapValueUnique:boolean (m:[string:EvalValue] key:string) { return false }
    ; "Assign only if the key is already there", answering whether it was. The
    ; portable fallback is the two-lookup form the intrinsic replaces.
    sfn mapPutIfPresent:boolean (m:[string:EvalValue] key:string v:EvalValue) {
        if (has m key) {
            set m key v
            return true
        }
        return false
    }
}

; =============================================================================
; EvalPayload - the part of a value that only ONE kind of value has
; =============================================================================
; A closed variant family (PLAN_SHAPES.md 7.3). A value is a function, or an
; element, or neither: the three are mutually exclusive, which is what a shape
; states and what thirteen fields on one class could not.
;
; Before this split every EvalValue -- including every number the interpreter
; mints for an arithmetic result -- carried six strings, a map and a vector that
; only a function value ever reads. On C++ that is sizeof(EvalValue) paid on
; every allocation; on a target with a nursery it is wasted rather than slow.
;
; FnCore holds collections, so it is a REFERENCE case: its fields stay mutable
; and two of them are equal only when they are the same object. `None` holds
; nothing, so C++ and Rust carry it inside the tag and a value with no payload
; allocates nothing for it.
shape EvalPayload {
    case None
    case FnCore {
        def functionName:string ""
        ; Captured defining scope for a function/arrow value (lexical closures).
        ; Held by integer id into ComponentEngine.closureScopes to avoid a type
        ; cycle (EvalContext lives in ComponentEngine, which imports this file).
        ; -1 = none.
        def closureId:int (0 - 1)
        ; Module provenance: the virtual-module name this function was defined
        ; in ("" = the entry script). Consumed at call time so the body
        ; evaluates rooted in its OWN module scope -- the D-MODULES contract.
        def homeModule:string ""
        ; D-FNSRC: the WHOLE source text this function's node was parsed from,
        ; not a slice. Function.prototype.toString cuts [node.start, node.end)
        ; out of it, and a nested function captured while this one runs inherits
        ; it -- its own offsets are absolute in the same string, so a pre-cut
        ; slice would be useless to it. Empty for a builtin ([native code]).
        def srcText:string ""
        ; D-REGISTRY: a built-in method held as a VALUE. Ranger has no function
        ; pointers, so a built-in is identified by the pair (receiver kind, name)
        ; and invoked through the engine's single type-keyed dispatcher.
        def builtinKind:string ""
        def builtinName:string ""
        ; D-STATICS: the namespace a built-in STATIC belongs to ("Object",
        ; "Math"). Empty for everything else, which is what distinguishes a
        ; static from a prototype method held as a value.
        def builtinNamespace:string ""
        ; D-STRICT: whether this function is strict -- its own "use strict"
        ; prologue OR the strictness of the scope that created it.
        def strictFn:boolean false
        ; D-CLASSOF: true only for a value produced by Function.prototype.bind.
        ; Only an explicit bind() survives the rebinding a method call does.
        def boundExplicit:boolean false
        ; D-FNPROPS: names whose SYNTHESISED value has been deleted. A
        ; function's length/name/prototype are computed on read rather than
        ; stored, so there was nothing for `delete f.length` to remove.
        def suppressedKeys:[string:boolean]
        ; D-FNPROTO: arguments fixed by Function.prototype.bind, prepended ahead
        ; of the call-site arguments every time the bound function is invoked.
        def boundArgs:[EvalValue]
    }
    case ElemBox {
        def evgElement:EVGElement   ; a JSX element held as a value
    }
}

class EvalValue {
    ; Kind discriminant — closed family (PLAN_SHAPES.md §7.5 step 4).
    def body:EvValue (new EvValue.Undefined())
    ; The kind-specific part. `None` until a function or an element needs it.
    def payload:EvalPayload (new EvalPayload.None())
    def numberValue:double 0.0
    def stringValue:string ""
    def boolValue:boolean false
    ; True only for a number minted to fill ONE binding's slot in a frame whose
    ; body scan proved the name's value object never escapes. Nothing else can
    ; be holding it, so `i++` writes `numberValue` in place. Every value the
    ; script can alias -- and every pooled literal, which is shared by every
    ; occurrence of that constant -- keeps false and takes the minting path.
    def slotOwned:boolean false
    ; D-IDENTITY: immutable reference identity. Object/array/function/Map/Set/
    ; element values are stamped with a unique id (>= 1) at mint; primitives keep
    ; 0 and compare by value. Never changed by property writes, reparenting, or
    ; array reorder — assigned exactly once at the creation factory below.
    def identityId:int 0
    def arrayValue:[EvalValue]
    def mapVals:[EvalValue]     ; parallel to arrayValue for Map
    def objectMap:[string:EvalValue]
    ; For a bound method reference (obj.method held as a value): the receiver the
    ; method is called on. null for plain functions/closures.
    def boundThis@(optional):EvalValue
    ; D-PROTO: the prototype link. On a function value this is its `.prototype`
    ; object (created on first read, so `F.prototype.m = ...` persists); on an
    ; object it is the prototype it inherits from, set by `new F()`. A property
    ; miss walks this chain, which is how a method defined on a prototype is
    ; found through an instance.
    def protoRef@(optional):EvalValue
    ; D-ACCESSORS: getter/setter functions keyed by property name, held apart
    ; from objectMap so an accessor property is never mistaken for a data one.
    ; They cannot be INVOKED from here (EvalValue has no evaluator reference), so
    ; the member-access sites in ComponentEngine look them up and call them.
    def getterMap:[string:EvalValue]
    def setterMap:[string:EvalValue]
    ; D-ATTRS: per-property attributes, as a bitmask keyed by property name.
    ;   bit 0 = writable, bit 1 = enumerable, bit 2 = configurable
    ; An ABSENT key means all three true, which is what plain assignment
    ; (`o.k = 1`) creates. Object.defineProperty defaults them to FALSE instead,
    ; and the engine could not previously tell the two apart — every descriptor
    ; reported writable/enumerable/configurable true regardless of how the
    ; property was made.
    def attrFlags:[string:int]
    ; Object-level integrity: preventExtensions / seal / freeze. Stored as flags
    ; rather than derived, because "frozen" must stay true for an empty object.
    def extensibleFlag:boolean true
    def sealedFlag:boolean false
    def frozenFlag:boolean false
    ; D-ARRAYSPARSE: an array `length` LARGER than the dense store can hold.
    ; -1 means "the dense store is the length". The spec allows a length up to
    ; 2^32-1 with no elements at all, which no dense container can materialise,
    ; so the declared length is carried beside the elements instead. Every value
    ; that IS stored still lives in arrayValue or, past the cap, as a property.
    def declaredLength:int (0 - 1)
    def functionNode@(optional):TSNode  ; For function AST nodes

    ; ---- the payload, read and written through these -----------------------
    ; A read answers the default of the field when there is no FnCore, which is
    ; what the flat class answered for a value that was not a function. A write
    ; creates the FnCore, so only a value that is actually given function state
    ; pays for one.

    fn fnCore:EvalPayload.FnCore () {
        case payload have:EvalPayload.FnCore {
            return have
        }
        def sk:[string:boolean]
        def ba:[EvalValue]
        def made:EvalPayload.FnCore (new EvalPayload.FnCore("" (0 - 1) "" "" "" "" "" false false sk ba))
        payload = made
        return made
    }

    fn fnName:string () {
        case payload f:EvalPayload.FnCore { return f.functionName }
        return ""
    }
    fn setFnName:void (s:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.functionName = s
    }

    fn closureIdOf:int () {
        case payload f:EvalPayload.FnCore { return f.closureId }
        return (0 - 1)
    }
    fn setClosureId:void (v:int) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.closureId = v
    }

    fn homeModuleOf:string () {
        case payload f:EvalPayload.FnCore { return f.homeModule }
        return ""
    }
    fn setHomeModule:void (s:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.homeModule = s
    }

    fn srcTextOf:string () {
        case payload f:EvalPayload.FnCore { return f.srcText }
        return ""
    }
    fn setSrcText:void (s:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.srcText = s
    }

    fn builtinKindOf:string () {
        case payload f:EvalPayload.FnCore { return f.builtinKind }
        return ""
    }
    fn setBuiltinKind:void (s:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.builtinKind = s
    }

    fn builtinNameOf:string () {
        case payload f:EvalPayload.FnCore { return f.builtinName }
        return ""
    }
    fn setBuiltinName:void (s:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.builtinName = s
    }

    fn builtinNamespaceOf:string () {
        case payload f:EvalPayload.FnCore { return f.builtinNamespace }
        return ""
    }
    fn setBuiltinNamespace:void (s:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.builtinNamespace = s
    }

    fn strictFnOf:boolean () {
        case payload f:EvalPayload.FnCore { return f.strictFn }
        return false
    }
    fn setStrictFn:void (b:boolean) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.strictFn = b
    }

    fn boundExplicitOf:boolean () {
        case payload f:EvalPayload.FnCore { return f.boundExplicit }
        return false
    }
    fn setBoundExplicit:void (b:boolean) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.boundExplicit = b
    }

    ; The collections are reached through operations rather than handed out: a
    ; target that returns a collection by value would copy it, and a caller that
    ; wrote into the copy would lose the write.
    fn hasSuppressed:boolean (key:string) {
        case payload f:EvalPayload.FnCore { return (has f.suppressedKeys key) }
        return false
    }
    fn addSuppressed:void (key:string) {
        def f:EvalPayload.FnCore (this.fnCore())
        set f.suppressedKeys key true
    }
    fn suppressedKeyList:[string] () {
        case payload f:EvalPayload.FnCore { return (keys f.suppressedKeys) }
        def none:[string]
        return none
    }
    fn setSuppressed:void (m:[string:boolean]) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.suppressedKeys = m
    }

    fn boundArgCount:int () {
        case payload f:EvalPayload.FnCore { return (array_length f.boundArgs) }
        return 0
    }
    fn boundArgAt:EvalValue (index:int) {
        case payload f:EvalPayload.FnCore { return (itemAt f.boundArgs index) }
        return (EvalValue.undefined())
    }
    fn setBoundArgs:void (items:[EvalValue]) {
        def f:EvalPayload.FnCore (this.fnCore())
        f.boundArgs = items
    }

    ; ---- the element payload -----------------------------------------------
    fn hasElement:boolean () {
        case payload e:EvalPayload.ElemBox { return true }
        return false
    }
    fn elementOf:EVGElement () {
        case payload e:EvalPayload.ElemBox { return (unwrap e.evgElement) }
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.blankElement
    }
    fn setElement:void (el:EVGElement) {
        payload = (new EvalPayload.ElemBox(el))
    }

    ; Constructors
    ; null / undefined / true / false are immutable (never mutated in place — the
    ; mutating ops setMember/setIndexAt/push only act on objects/arrays), so they
    ; are returned as shared singletons instead of allocating a new value every
    ; time. This removes the single largest source of interpreter allocations.
    sfn null:EvalValue () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.nullValue
    }

    ; Allocating variants used to seed the shared constant pool.
    sfn rawNull:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.null())
        return v
    }

    sfn rawUndefined:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.undefined())
        return v
    }

    ; D-HOLES: an ABSENT array element, as distinct from one holding undefined.
    ; It reads as undefined everywhere a value is wanted, so nothing that merely
    ; consumes elements has to know about it -- but `1 in [0,,2]` is false and
    ; forEach/filter/every/map skip it, which no undefined can express. Its own
    ; Kind is Hole, so any code that missed the distinction still sees
    ; undefined rather than something it cannot classify.
    sfn rawHole:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.hole())
        return v
    }

    sfn hole:EvalValue () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.holeValue
    }

    ; True when this element is absent rather than undefined.
    fn holeSlot:boolean () {
        return (this.isHole())
    }

    sfn rawBoolean:EvalValue (b:boolean) {
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.boolean(b))
        v.boolValue = b
        return v
    }
    
    sfn rawNumber:EvalValue (n:double) {
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.number(n))
        v.numberValue = n
        return v
    }

    sfn number:EvalValue (n:double) {
        ; a small non-negative integer comes from the shared pool.
        ; NEGATIVE ZERO must not: -0.0 >= 0.0 and -0.0 == 0.0 both hold,
        ; but the pooled +0 loses the sign — 1/-0 is -Infinity, and
        ; Object.is / toString / JSON all observe it.
        if ((n >= 0.0) && (n < 4096.0)) {
            def ni:int (to_int n)
            if ((to_double ni) == n) {
                if ((ni != 0) || ((1.0 / n) > 0.0)) {
                    def pool:EvalConstPool (EvalConstPool.__singleton())
                    return (pool.smallInt(ni))
                }
            }
        }
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.number(n))
        v.numberValue = n
        return v
    }

    sfn fromInt:EvalValue (n:int) {
        if ((n >= 0) && (n < 4096)) {
            def pool:EvalConstPool (EvalConstPool.__singleton())
            return (pool.smallInt(n))
        }
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.number((to_double n)))
        v.numberValue = (to_double n)
        return v
    }
    
    sfn string:EvalValue (s:string) {
        def v:EvalValue (new EvalValue())
        v.body = (EvValue.string(s))
        v.stringValue = s
        return v
    }
    
    sfn boolean:EvalValue (b:boolean) {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        if b {
            return pool.trueValue
        }
        return pool.falseValue
    }
    

    ; E4c: shape ↔ class. Primitives rebuild from scalar fields; refs return the
    ; live `body` and register with EvValueHandles so Array.items can store
    ; EvValue and still round-trip to the same class handle (===).
    fn toStored:EvValue () {
        def _k:EvValue body
        if (EvValue.isHole(_k)) {
            return (EvValue.hole())
        }
        if (EvValue.isNull(_k)) {
            return (EvValue.null())
        }
        if (EvValue.isUndefined(_k)) {
            return (EvValue.undefined())
        }
        if (EvValue.isNumber(_k)) {
            return (EvValue.number(numberValue))
        }
        if (EvValue.isString(_k)) {
            return (EvValue.string(stringValue))
        }
        if (EvValue.isBoolean(_k)) {
            return (EvValue.boolean(boolValue))
        }
        ; Refs: return the live body. Factories / fromBody register the class
        ; handle in EvValueHandles (do not pass `this` here — Rust codegen
        ; double-wraps Rc when `this` is an argument).
        return _k
    }

    sfn fromBody:EvalValue (ev:EvValue) {
        case ev h:EvValue.Hole {
            return (EvalValue.hole())
        }
        case ev n:EvValue.Null {
            return (EvalValue.null())
        }
        case ev u:EvValue.Undefined {
            return (EvalValue.undefined())
        }
        case ev num:EvValue.Number {
            return (EvalValue.number(num.value))
        }
        case ev s:EvValue.String {
            return (EvalValue.string(s.value))
        }
        case ev b:EvValue.Boolean {
            return (EvalValue.boolean(b.value))
        }
        case ev el:EvValue.Element {
            def id:int el.identityId
            if (id > 0) {
                def handles:EvValueHandles (EvValueHandles.__singleton())
                def hit@(optional):EvalValue (handles.lookup(id))
                if hit {
                    return (unwrap hit)
                }
                def v:EvalValue (new EvalValue())
                v.body = ev
                v.identityId = id
                v.setElement((unwrap el.element))
                handles.remember(v)
                return v
            }
            return (EvalValue.element((unwrap el.element)))
        }
        case ev a:EvValue.Array {
            def id:int a.identityId
            if (id > 0) {
                def handles2:EvValueHandles (EvValueHandles.__singleton())
                def hit2@(optional):EvalValue (handles2.lookup(id))
                if hit2 {
                    return (unwrap hit2)
                }
                def v2:EvalValue (new EvalValue())
                v2.body = ev
                v2.identityId = id
                handles2.remember(v2)
                return v2
            }
            def items:[EvalValue]
            for a.items it:EvValue i {
                push items (EvalValue.fromBody(it))
            }
            return (EvalValue.array(items))
        }
        case ev o:EvValue.Object {
            def id3:int o.identityId
            if (id3 > 0) {
                def handles3:EvValueHandles (EvValueHandles.__singleton())
                def hit3@(optional):EvalValue (handles3.lookup(id3))
                if hit3 {
                    return (unwrap hit3)
                }
                def v3:EvalValue (new EvalValue())
                v3.body = ev
                v3.identityId = id3
                handles3.remember(v3)
                return v3
            }
            return (EvalValue.object(([] _:string ()) ([] _:EvalValue ())))
        }
        case ev f:EvValue.Function {
            def id4:int f.identityId
            def c:EvFunctionCore (unwrap f.core)
            if (id4 > 0) {
                def handles4:EvValueHandles (EvValueHandles.__singleton())
                def hit4@(optional):EvalValue (handles4.lookup(id4))
                if hit4 {
                    return (unwrap hit4)
                }
                def v4:EvalValue (new EvalValue())
                v4.body = ev
                v4.identityId = id4
                v4.setFnName(c.functionName)
                handles4.remember(v4)
                return v4
            }
            return (EvalValue.nativeFunction(c.functionName))
        }
        case ev m:EvValue.Map {
            def id5:int m.identityId
            if (id5 > 0) {
                def handles5:EvValueHandles (EvValueHandles.__singleton())
                def hit5@(optional):EvalValue (handles5.lookup(id5))
                if hit5 {
                    return (unwrap hit5)
                }
                def v5:EvalValue (new EvalValue())
                v5.body = ev
                v5.identityId = id5
                handles5.remember(v5)
                return v5
            }
            return (EvalValue.mapEmpty())
        }
        case ev st:EvValue.Set {
            def id6:int st.identityId
            if (id6 > 0) {
                def handles6:EvValueHandles (EvValueHandles.__singleton())
                def hit6@(optional):EvalValue (handles6.lookup(id6))
                if hit6 {
                    return (unwrap hit6)
                }
                def v6:EvalValue (new EvalValue())
                v6.body = ev
                v6.identityId = id6
                handles6.remember(v6)
                return v6
            }
            return (EvalValue.setEmpty())
        }
        return (EvalValue.undefined())
    }

    sfn array:EvalValue (items:[EvalValue]) {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        ; E4c: dense store on body.Array.items (EvValue[]).
        def stored:[EvValue]
        def i:int 0
        while (i < (array_length items)) {
            def it:EvalValue (itemAt items i)
            push stored (it.toStored())
            i = (i + 1)
        }
        v.body = (EvValue.arrayAt(id stored))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; Empty Map: keys in arrayValue, values in mapVals by index.
    sfn mapEmpty:EvalValue () {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.mapEmptyAt(id))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; Empty Set: unique elements in arrayValue (insertion order).
    sfn setEmpty:EvalValue () {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.setEmptyAt(id))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    sfn object:EvalValue (keys:[string] values:[EvalValue]) {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.objectAt(id))
        v.identityId = id
        def i:int 0
        while (i < (array_length keys)) {
            if (i < (array_length values)) {
                v.putOwnData((itemAt keys i) (itemAt values i))
            }
            i = (i + 1)
        }
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }
    
    sfn function:EvalValue (fnNode:TSNode) {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.functionStubAt(id ""))
        v.identityId = id
        v.functionNode = fnNode
        v.setFnName(fnNode.name)
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-ERRORS: a function value with no body — an engine-provided constructor
    ; such as TypeError. It is a real function value (typeof === "function", own
    ; identity) so guest code can compare it by reference and read `.name`, but
    ; it has no functionNode, so the call paths that require one skip it and the
    ; engine handles the construction itself.
    sfn nativeFunction:EvalValue (name:string) {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.functionStubAt(id ""))
        v.identityId = id
        v.setFnName(name)
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-REGISTRY: a built-in method as a first-class function value. `boundThis`
    ; carries the receiver when the value came from `arr.slice`; it is absent for
    ; the unbound form read off a prototype (`Array.prototype.slice`), which is
    ; exactly the case .call/.apply exist to supply.
    sfn nativeMethod:EvalValue (kind:string name:string) {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.functionStubAt(id ""))
        v.identityId = id
        def core:EvalPayload.FnCore (v.fnCore())
        core.functionName = name
        core.builtinKind = kind
        core.builtinName = name
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-STATICS: a built-in STATIC (Object.keys, Math.floor) as a first-class
    ; value. Like nativeMethod it is identified by a pair, but the first half is
    ; the namespace rather than a receiver kind -- a static has no receiver.
    sfn nativeStatic:EvalValue (ns:string name:string) {
        def v:EvalValue (new EvalValue())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvValue.functionStubAt(id ""))
        v.identityId = id
        def core:EvalPayload.FnCore (v.fnCore())
        core.functionName = name
        core.builtinNamespace = ns
        core.builtinName = name
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    fn isBuiltinStatic:boolean () {
        if (false == (this.isFunction())) {
            return false

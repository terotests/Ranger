; =============================================================================
; EvalValue — E1 target shape (PLAN_SHAPES.md §7.5 / §3.1)
; =============================================================================
; Closed family for the kind discriminant (PLAN_SHAPES.md §7.5 step 4).
; Named EvalValue so `class EvHandle` can keep holding collection payloads
; and identity while `body:EvalValue` owns the kind. E3 create/check goes
; through EvValueBridge; E4 deletes `valueType` in favour of this shape.
;
; Groups:
;   Primitive       — Null / Undefined / Hole / Number / String / Boolean
;   Reference       — identity-bearing cases
;   PropertyCarrier — objects that own a property bag
;   Callable        — values that can be invoked (required capability)

Import "../../../evg/EVGElement.rgr"
Import "../../../../../ts_parser/ts_parser_simple.rgr"

shape EvalValue {
    group Primitive @(value)

    group Reference @(reference) {
        def identityId:int 0
    }

    group PropertyCarrier does Reference {
        ; Default-constructed so the field is non-optional (class-typed
        ; fields without a default are treated as optional, which breaks
        ; the generated group getter's return type).
        def properties:EvPropertyBag (new EvPropertyBag())
    }

    ; Capability: every callable case must name itself for dispatch smoke tests.
    ; Real invoke (engine call) lands when ComponentEngine converts by kind.
    group Callable does PropertyCarrier {
        fn invokeLabel:string ()
    }

    case Null      does Primitive
    case Undefined does Primitive
    case Hole      does Primitive
    case Number    does Primitive {
        def value:double 0.0
    }
    case String    does Primitive {
        def value:string ""
    }
    case Boolean   does Primitive {
        def value:boolean false
    }

    case Array does PropertyCarrier {
        def items:[EvalValue]
        def declaredLength:int (0 - 1)
    }
    case Object does PropertyCarrier
    case Function does Callable {
        def core:EvFunctionCore
        def binding:EvFunctionBinding
        fn invokeLabel:string () {
            def c:EvFunctionCore core
            return c.functionName
        }
    }
    case Map does PropertyCarrier {
        def entries:[EvMapEntry]
    }
    case Set does PropertyCarrier {
        def items:[EvalValue]
    }
    case Element does Reference {
        def element:EVGElement
    }

    fn toBool:boolean () {
        match self {
            Null | Undefined | Hole {
                return false
            }
            Number n {
                return ((n.value == n.value) && (n.value != 0.0))
            }
            String s {
                return ((strlen s.value) > 0)
            }
            Boolean b {
                return b.value
            }
            Reference {
                return true
            }
        }
        return false
    }

    ; ---- E2 compatibility factories (PLAN_SHAPES.md §7.5) -----------------
    ; Same call spelling as class EvHandle.* so call sites can switch one
    ; kind at a time. Not wired into ComponentEngine yet.

    sfn null:EvalValue () {
        return (new EvalValue.Null())
    }
    sfn undefined:EvalValue () {
        return (new EvalValue.Undefined())
    }
    sfn hole:EvalValue () {
        return (new EvalValue.Hole())
    }
    sfn number:EvalValue (n:double) {
        return (new EvalValue.Number(n))
    }
    sfn string:EvalValue (s:string) {
        return (new EvalValue.String(s))
    }
    sfn boolean:EvalValue (b:boolean) {
        return (new EvalValue.Boolean(b))
    }

    ; ---- E3 reference / carrier factories (fixture + bridge kind arms) ----
    ; Case ctors take Reference.identityId then PropertyCarrier.properties
    ; (when applicable) before the case's own fields — see E1 fixture.
    sfn element:EvalValue (el:EVGElement) {
        return (EvalValue.elementAt(0 el))
    }
    sfn elementAt:EvalValue (id:int el:EVGElement) {
        return (new EvalValue.Element(id el))
    }
    sfn array:EvalValue (items:[EvalValue]) {
        return (EvalValue.arrayAt(0 items))
    }
    sfn arrayAt:EvalValue (id:int items:[EvalValue]) {
        def props:EvPropertyBag (new EvPropertyBag())
        return (new EvalValue.Array(id props items (array_length items)))
    }
    sfn object:EvalValue () {
        return (EvalValue.objectAt(0))
    }
    sfn objectAt:EvalValue (id:int) {
        def props:EvPropertyBag (new EvPropertyBag())
        return (new EvalValue.Object(id props))
    }
    sfn mapEmpty:EvalValue () {
        return (EvalValue.mapEmptyAt(0))
    }
    sfn mapEmptyAt:EvalValue (id:int) {
        def props:EvPropertyBag (new EvPropertyBag())
        ; Bind the empty literal — Rust case ctors drop a bare `([] _:T ())`
        ; argument (ISSUES / empty typed array as ctor arg).
        def entries:[EvMapEntry]
        return (new EvalValue.Map(id props entries))
    }
    sfn setEmpty:EvalValue () {
        return (EvalValue.setEmptyAt(0))
    }
    sfn setEmptyAt:EvalValue (id:int) {
        def props:EvPropertyBag (new EvPropertyBag())
        def items:[EvalValue]
        return (new EvalValue.Set(id props items))
    }
    sfn functionStub:EvalValue (name:string) {
        return (EvalValue.functionStubAt(0 name))
    }
    sfn functionStubAt:EvalValue (id:int name:string) {
        def props:EvPropertyBag (new EvPropertyBag())
        def c:EvFunctionCore (new EvFunctionCore())
        c.functionName = name
        def b:EvFunctionBinding (new EvFunctionBinding())
        return (new EvalValue.Function(id props c b))
    }

    fn isNull:boolean () {
        case self n:EvalValue.Null {
            return true
        }
        return false
    }
    fn isNumber:boolean () {
        case self n:EvalValue.Number {
            return true
        }
        return false
    }
    fn isString:boolean () {
        case self n:EvalValue.String {
            return true
        }
        return false
    }
    fn isHole:boolean () {
        case self n:EvalValue.Hole {
            return true
        }
        return false
    }
    fn isUndefined:boolean () {
        case self n:EvalValue.Undefined {
            return true
        }
        return false
    }
    fn isBoolean:boolean () {
        case self n:EvalValue.Boolean {
            return true
        }
        return false
    }
    fn isNullOrUndefined:boolean () {
        case self n:EvalValue.Null {
            return true
        }
        case self u:EvalValue.Undefined {
            return true
        }
        return false
    }
    fn isElement:boolean () {
        case self n:EvalValue.Element {
            return true
        }
        return false
    }
    ; Named isArrayValue — a global `isArray` operator blocks methods named isArray.
    fn isArrayValue:boolean () {
        case self n:EvalValue.Array {
            return true
        }
        return false
    }
    fn isObject:boolean () {
        case self n:EvalValue.Object {
            return true
        }
        return false
    }
    fn isFunction:boolean () {
        case self n:EvalValue.Function {
            return true
        }
        return false
    }
    fn isMap:boolean () {
        case self n:EvalValue.Map {
            return true
        }
        return false
    }
    fn isSet:boolean () {
        case self n:EvalValue.Set {
            return true
        }
        return false
    }
}

; Bag / function helpers. Source order does not control C++ emission — the
; writer still places ordinary classes before shape cases — so the native
; bench build post-processes engine_bench.cpp (fix_cpp_evalvalue_order.py)
; to complete the six by-value EvalValue alternatives before EvMapEntry.

class EvMapEntry {
    def key:EvalValue
    def value:EvalValue
}

shape EvPropertySlot {
    case Data {
        def value:EvalValue
        def attributes:int 0
    }
    case Accessor {
        ; Hole = absent accessor half. A shape case field without a default is
        ; still optional at the type level and C++ lowers that to `!= NULL`,
        ; which does not work for by-value variants — default to Hole.
        def getter:EvalValue (EvalValue.hole())
        def setter:EvalValue (EvalValue.hole())
        def attributes:int 0
    }
}

class EvPropertyBag {
    def slots:[string:EvPropertySlot]
    ; Hole = no prototype. @(optional) on a shape lowers to `!= NULL` on C++,
    ; which does not work for by-value variants — use the Hole sentinel.
    def prototype:EvalValue (EvalValue.hole())
    def extensible:boolean true
    def sealed:boolean false
    def frozen:boolean false
    ; Deleted synthesised / registry keys (Function length/name, or a built-in
    ; method removed from a prototype). Lives on the bag so Object.prototype
    ; can record `delete Object.prototype.toString` without becoming a Function.
    def suppressedKeys:[string:boolean]

    ; E4c: property-bag SoT. Value payload is EvalValue (avoids EvHandle import cycle).
    fn hasData:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            ; Hole value = attrs-only placeholder (setAttrs before a value),
            ; not a real data property — array index attrs must not shadow
            ; dense elements on Array.prototype.
            def v:EvalValue (unwrap d.value)
            if (EvalValue.isHole(v)) {
                return false
            }
            return true
        }
        return false
    }
    fn getData:EvalValue (key:string) {
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            ; Case field typed as a shape without a default is optional at the
            ; type level; putData always sets it.
            return (unwrap d.value)
        }
        return (EvalValue.undefined())
    }
    fn putData:void (key:string value:EvalValue attrs:int) {
        ; Bind through the union type so Rust gets union_EvPropertySlot, not the
        ; bare case struct (same pattern as `def a:Value (new Value.Num(...))`).
        def slot:EvPropertySlot (new EvPropertySlot.Data(value attrs))
        set slots key slot
    }
    fn removeData:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def rebuilt:[string:EvPropertySlot]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (kk != key) {
                set rebuilt kk (unwrap (get slots kk))
            }
        }
        slots = rebuilt
    }
    fn dataKeys:[string] () {
        def out:[string]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (this.hasData(kk)) {
                push out kk
            }
        }
        return out
    }

    fn hasSlot:boolean (key:string) {
        return (has slots key)
    }
    fn attrsOf:int (key:string) {
        if (false == (has slots key)) {
            return 7
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            return d.attributes
        }
        case slot a:EvPropertySlot.Accessor {
            return a.attributes
        }
        return 7
    }
    fn setAttrsOn:void (key:string attrs:int) {
        if (false == (has slots key)) {
            ; Attribute bits without a value — Hole placeholder so hasData is
            ; false (must not shadow array dense indexes / inherited reads).
            def slot0:EvPropertySlot (new EvPropertySlot.Data((EvalValue.hole()) attrs))
            set slots key slot0
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot d:EvPropertySlot.Data {
            def slotD:EvPropertySlot (new EvPropertySlot.Data((unwrap d.value) attrs))
            set slots key slotD
            return
        }
        case slot a:EvPropertySlot.Accessor {
            ; Hole sentinel = absent half (ctor requires non-optional EvalValue).
            def g:EvalValue (EvalValue.hole())
            def s:EvalValue (EvalValue.hole())
            g = a.getter
            s = a.setter
            def slotA:EvPropertySlot (new EvPropertySlot.Accessor(g s attrs))
            set slots key slotA
        }
    }

    fn hasGetter:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            def g:EvalValue a.getter
            if (false == (EvalValue.isHole(g))) {
                return true
            }
        }
        return false
    }
    fn hasSetter:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            def s:EvalValue a.setter
            if (false == (EvalValue.isHole(s))) {
                return true
            }
        }
        return false
    }
    fn hasAccessor:boolean (key:string) {
        if (false == (has slots key)) {
            return false
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            return true
        }
        return false
    }
    fn getGetter:EvalValue (key:string) {
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            return a.getter
        }
        return (EvalValue.undefined())
    }
    fn getSetter:EvalValue (key:string) {
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            return a.setter
        }
        return (EvalValue.undefined())
    }
    fn putGetter:void (key:string g:EvalValue attrs:int) {
        def useAttrs:int attrs
        def s:EvalValue (EvalValue.hole())
        if (has slots key) {
            def slot:EvPropertySlot (unwrap (get slots key))
            case slot a:EvPropertySlot.Accessor {
                def sv:EvalValue a.setter
                if (false == (EvalValue.isHole(sv))) {
                    s = sv
                }
                useAttrs = a.attributes
            }
        }
        def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s useAttrs))
        set slots key slotN
    }
    fn putSetter:void (key:string s:EvalValue attrs:int) {
        def useAttrs:int attrs
        def g:EvalValue (EvalValue.hole())
        if (has slots key) {
            def slot:EvPropertySlot (unwrap (get slots key))
            case slot a:EvPropertySlot.Accessor {
                def gv:EvalValue a.getter
                if (false == (EvalValue.isHole(gv))) {
                    g = gv
                }
                useAttrs = a.attributes
            }
        }
        def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s useAttrs))
        set slots key slotN
    }
    fn clearGetter:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            def s:EvalValue (EvalValue.hole())
            def at:int a.attributes
            def sv:EvalValue a.setter
            if (false == (EvalValue.isHole(sv))) {
                s = sv
            }
            if (EvalValue.isHole(s)) {
                this.removeData(key)
            } {
                def g:EvalValue (EvalValue.hole())
                def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s at))
                set slots key slotN
            }
        }
    }
    fn clearSetter:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            def g:EvalValue (EvalValue.hole())
            def at:int a.attributes
            def gv:EvalValue a.getter
            if (false == (EvalValue.isHole(gv))) {
                g = gv
            }
            if (EvalValue.isHole(g)) {
                this.removeData(key)
            } {
                def s:EvalValue (EvalValue.hole())
                def slotN:EvPropertySlot (new EvPropertySlot.Accessor(g s at))
                set slots key slotN
            }
        }
    }
    fn clearAccessor:void (key:string) {
        if (false == (has slots key)) {
            return
        }
        def slot:EvPropertySlot (unwrap (get slots key))
        case slot a:EvPropertySlot.Accessor {
            this.removeData(key)
        }
    }
    fn getterKeys:[string] () {
        def out:[string]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (this.hasGetter(kk)) {
                push out kk
            }
        }
        return out
    }
    fn setterKeys:[string] () {
        def out:[string]
        def ks:[string] (keys slots)
        for ks kk:string idx {
            if (this.hasSetter(kk)) {
                push out kk
            }
        }
        return out
    }

    fn hasPrototype:boolean () {
        if (false == (EvalValue.isHole(prototype))) {
            return true
        }
        return false
    }
    fn getPrototype:EvalValue () {
        return prototype
    }
    fn setPrototype:void (p:EvalValue) {
        prototype = p
    }
}

; Function core shared across bindings (PLAN_SHAPES.md §7.3). Identity lives
; on the Reference group of the Function case, not here. withThis currently
; copies the core (bind renames / suppresses prototype keys); sharing the
; core object is a later optimisation once those writes live only on binding.
class EvFunctionCore {
    def functionName:string ""
    def closureId:int (0 - 1)
    def homeModule:string ""
    def srcText:string ""
    def builtinKind:string ""
    def builtinName:string ""
    def builtinNamespace:string ""
    def strictFn:boolean false
    ; AST node for script-defined functions (absent for builtins / stubs).
    def functionNode@(optional):TSNode
}

class EvFunctionBinding {
    ; Hole = unbound. Same C++ optional-shape constraint as prototype.
    def boundThis:EvalValue (EvalValue.hole())
    def boundArgs:[EvalValue]
    def boundExplicit:boolean false
}


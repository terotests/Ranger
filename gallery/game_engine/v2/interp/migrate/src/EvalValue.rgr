    fn kindName:string () {
        ; Case once on a local copy — chaining this.is*() re-borrows `body`
        ; and panics on the Rust RefCell target.
        def b:EvValue body
        case b h:EvValue.Hole { return "Hole" }
        case b n:EvValue.Null { return "Null" }
        case b u:EvValue.Undefined { return "Undefined" }
        case b num:EvValue.Number { return "Number" }
        case b s:EvValue.String { return "String" }
        case b bo:EvValue.Boolean { return "Boolean" }
        case b a:EvValue.Array { return "Array" }
        case b o:EvValue.Object { return "Object" }
        case b f:EvValue.Function { return "Function" }
        case b el:EvValue.Element { return "Element" }
        case b m:EvValue.Map { return "Map" }
        case b st:EvValue.Set { return "Set" }
        return "Unknown"
    }
    
    ; Type coercion
    fn toNumber:double () {
        if (this.isNumber()) {
            return numberValue
        }
        if (this.isString()) {
            ; Try to parse string as number
            def parsed@(optional):double (to_double stringValue)
            return (unwrap parsed)
        }
        if (this.isBoolean()) {
            if boolValue {
                return 1.0
            }
            return 0.0
        }
        return 0.0
    }
    
    fn toString:string () {
        if (this.isNull()) {
            return "null"
        }
        if (this.isHole()) {
            ; A hole READS as undefined when stringified as a value.
            return "undefined"
        }
        if (this.isUndefined()) {
            return "undefined"
        }
        if (this.isNumber()) {
            ; NaN and the infinities print their JS names — the native f64
            ; formatters say "inf"/"-inf" where JavaScript says "Infinity"
            if (numberValue != numberValue) {
                return "NaN"
            }
            if (numberValue == (1.0 / 0.0)) {
                return "Infinity"
            }
            if (numberValue == ((0.0 - 1.0) / 0.0)) {
                return "-Infinity"
            }
            ; Format number - remove trailing zeros
            def s:string (to_string numberValue)
            ; Check if it's a whole number
            def intVal:int (to_int numberValue)
            if ((to_double intVal) == numberValue) {
                return (to_string intVal)
            }
            return s
        }
        if (this.isString()) {
            return stringValue
        }
        if (this.isBoolean()) {
            if boolValue {
                return "true"
            }
            return "false"
        }
        if (this.isArray()) {
            def result:string "["
            def i:int 0
            def n:int (this.denseLen())
            while (i < n) {
                if (i > 0) {
                    result = result + ", "
                }
                def item:EvalValue (this.arrayItemAt(i))
                def itemStr:string (item.toString())
                result = result + itemStr
                i = i + 1
            }
            return result + "]"
        }
        if (this.isObject()) {
            def result:string "{"
            def keyList:[string] (this.ownDataKeys())
            def i:int 0
            for keyList kk:string idx {
                if (i > 0) {
                    result = result + ", "
                }
                def val:EvalValue (this.getOwnData(kk))
                def valStr:string (val.toString())
                result = result + kk + ": " + valStr
                i = i + 1
            }
            return result + "}"
        }
        if (this.isFunction()) {
            return "[Function: " + (this.fnName()) + "]"
        }
        if (this.isElement()) {
            if (this.hasElement()) {
                def el:EVGElement (this.elementOf())
                return "[EVGElement: " + el.tagName + "]"
            }
            return "[EVGElement: null]"
        }
        return "undefined"
    }
    
    fn toBool:boolean () {
        if (this.isNull()) {
            return false
        }
        if (this.isHole()) {
            return false
        }
        if (this.isUndefined()) {
            return false
        }
        if (this.isNumber()) {
            ; NaN is FALSY. `n != 0.0` is true for NaN, so `!NaN` answered false
            ; and every `if (nan)` took the wrong branch.
            if (numberValue != numberValue) {
                return false
            }
            return (numberValue != 0.0)
        }
        if (this.isString()) {
            return ((strlen stringValue) > 0)
        }
        if (this.isBoolean()) {
            return boolValue
        }
        if (this.isArray()) {
            return true ; Arrays are always truthy
        }
        if (this.isObject()) {
            return true ; Objects are always truthy
        }
        if (this.isFunction()) {
            return true ; Functions are always truthy
        }
        if (this.isElement()) {
            return true ; Elements are always truthy
        }
        return false
    }
    

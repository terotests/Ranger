; ==============================================================================
; RgRanger2D — first-class retained 2D scene + sprite system (D-2D, P1).
; ==============================================================================
; ranger:2d is a sibling of ranger:three, NOT THREE.Sprite. Persistent 2D types
; live in their own typed arenas over the shared registry (D-TYPE); frame-local
; drawing (DrawList2D) is a separate command buffer with NO persistent identity.
;
; Object model (this slice):
;   Texture2D          decoded image resource
;   SpriteAtlas        texture + named regions + animation clips (retains texture)
;   Sprite2D           atlas + region + layer membership + transform (retains atlas)
;   Layer2D            membership container (add/remove is not ownership)
;   Camera2D           translate / zoom / rotation + world<->screen transforms
;   AnimationPlayer2D  playback state over an atlas clip, timed by runtime.time
;   DrawList2D         frame-local immediate commands (no registry handles)
;   PoseBinding2D      weak body -> sprite link (generation-checked)
;
; Binding rules honoured: sprite identity never depends on index / z-order /
; layer; reorder + reparent preserve the handle; texture/atlas/sprite/player
; identities are separate; sharing is refcounted (D-OWN); membership ≠ object
; (D-LIFE); animation timing uses one shared model on runtime.time.
; ==============================================================================

Import "../../host/RgRegistry.rgr"
Import "../../host/handles/RgHandle.rgr"
Import "../../host/ownership/OwnedHandle.rgr"

class Rg2DType {
    sfn texture:int () { return 30 }
    sfn atlas:int () { return 31 }
    sfn sprite:int () { return 32 }
    sfn layer:int () { return 33 }
    sfn camera:int () { return 34 }
    sfn player:int () { return 35 }
}

; ---- payload types -----------------------------------------------------------
; A texture may carry a decoded pixel store (D-2D): rgb is 0xRRGGBB per texel
; (≤ 0xFFFFFF, i32-safe on every ABI profile — no sign-bit trap), alpha is
; 0..255 per texel, both row-major width*height. hasPixels stays false for a
; dimensions-only texture (the headless default); a backend that samples must
; check it. Kept as two i32-safe channels rather than one packed 0xRRGGBBAA so
; the wasm32 profile transfers them without the alpha byte setting the sign bit.
class RgTexture2D {
    def width:int 0
    def height:int 0
    def rgb:[int]
    def alpha:[int]
    def hasPixels:boolean false
}

class RgSpriteRegion {
    def name:string ""
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0
    def pivotX:double 0.5
    def pivotY:double 0.5
}

class RgAnimClip2D {
    def name:string ""
    def frames:[int]        ; region indices, in order
    def durations:[double]  ; seconds per frame (parallel to frames)
}

class RgSpriteAtlas {
    def textureH:RgHandle (new RgHandle)
    def regions:[RgSpriteRegion]
    def clips:[RgAnimClip2D]
    ; Spritesheet grid (v1 "sheet" kind). frameW>0 marks a sheet atlas: a sprite
    ; samples a (col,row) cell of frameW×frameH instead of a named region.
    def frameW:int 0
    def frameH:int 0
    def cols:int 0
    def rows:int 0
}

class RgSprite2D {
    def atlasH:RgHandle (new RgHandle)
    ; Texture-backed source (PLAN_2D_EMBED_3D D10): when useTexture is true the
    ; sprite samples textureH over the full UV rect instead of an atlas region.
    def textureH:RgHandle (new RgHandle)
    def useTexture:boolean false
    def regionIndex:int 0
    def x:double 0.0
    def y:double 0.0
    def layerSlot:int 0    ; membership (0 = none)
    ; destination extent in WORLD units. 0 => draw the region at its native
    ; texel size (1 texel = 1 world unit). A platform sets w×h to stretch one
    ; region across its span; a background sets it to the view size.
    def w:double 0.0
    def h:double 0.0
    ; draw order within a layer (painter's order): lower z drawn first, ties
    ; broken by creation slot. Background 0 < platforms < players.
    def z:int 0
    ; horizontal mirror for facing (D-2D: transform state, not a new region).
    def flipX:boolean false
    ; spritesheet cell (v1 "sheet" kind): cellCol >= 0 samples the atlas frame
    ; grid at (cellCol,cellRow) instead of the named region. -1 = use region.
    def cellCol:int (0 - 1)
    def cellRow:int 0
    ; split-screen ownership: -1 = drawn in every pane (world objects); >=0 =
    ; drawn only in that pane (a local player hidden from the other's view).
    def paneOwner:int (0 - 1)
}

class RgLayer2D {
    def childCount:int 0
}

class RgCamera2D {
    def x:double 0.0
    def y:double 0.0
    def zoom:double 1.0
    def rotation:double 0.0
}

class RgAnimPlayer2D {
    def spriteH:RgHandle (new RgHandle)
    def clipIndex:int 0
    def playing:boolean true
}

; ---- frame-local draw list (NOT an arena) -----------------------------------
; Immediate commands with no persistent object identity. Reset each frame; it
; never allocates a registry handle.
class RgDrawCmd2D {
    def kind:int 0   ; 0 sprite-blit, 1 rect
    def regionIndex:int 0
    def x:double 0.0
    def y:double 0.0
}

class RgDrawList2D {
    def cmds:[RgDrawCmd2D]

    fn drawSprite:void (regionIndex:int x:double y:double) {
        def c:RgDrawCmd2D (new RgDrawCmd2D)
        c.kind = 0
        c.regionIndex = regionIndex
        c.x = x
        c.y = y
        push this.cmds c
    }

    fn drawRect:void (x:double y:double) {
        def c:RgDrawCmd2D (new RgDrawCmd2D)
        c.kind = 1
        c.x = x
        c.y = y
        push this.cmds c
    }

    fn count:int () { return (array_length this.cmds) }

    ; frame boundary: immediate commands do not persist
    fn reset:void () {
        def empty:[RgDrawCmd2D]
        this.cmds = empty
    }
}

; ---- immediate world-space background primitives (v1 createStaticBg model) ---
; The static environment (sky gradient, 3-tone platforms, clouds, flag, the
; bitmap diamond glyph) is NOT retained sprites: the game paints it every frame
; in WORLD coordinates via fillRect/fillCircle, exactly like v1's bgFillRect /
; bgFillCircle. A backend rasterises the list through each pane's camera BEFORE
; the retained sprites, so it composites under the players. No persistent
; identity — the list is cleared at the start of the game's draw (bgBegin).
class RgBgCmd2D {
    def kind:int 0   ; 0 = rect, 1 = circle
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def rad:double 0.0
    def r:int 0
    def g:int 0
    def b:int 0
}

; ---- immediate screen-space overlay (HUD) primitive -------------------------
; Overlay rects are NORMALISED to the pane (x,y,w,h in [0,1]), so a HUD is
; resolution-independent — the backend maps them to the pane's pixel size AFTER
; the sprites, WITHOUT the camera transform (screen space, not world). `pane` is
; the owning pane (-1 = every pane) for per-player HUDs on a split screen.
class RgOvCmd2D {
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def r:int 0
    def g:int 0
    def b:int 0
    def pane:int (0 - 1)
}

; ---- weak pose binding (body -> sprite) -------------------------------------
class RgPoseBinding2D {
    def bodyH:RgHandle (new RgHandle)
    def spriteH:RgHandle (new RgHandle)
}

; ==============================================================================
class RgRanger2D {
    def registry:RgRegistry (new RgRegistry)
    def realmId:int 1

    def textures:[RgTexture2D]
    def texFree:[int]
    def atlases:[RgSpriteAtlas]
    def atlasFree:[int]
    def sprites:[RgSprite2D]
    def spriteFree:[int]
    def layers:[RgLayer2D]
    def layerFree:[int]
    def cameras:[RgCamera2D]
    def camFree:[int]
    def players:[RgAnimPlayer2D]
    def playerFree:[int]

    ; frame-local immediate background draw list (world space; no identity)
    def bgCmds:[RgBgCmd2D]
    ; Per-pane snapshots taken at rg2d_render time so a game can paint a
    ; different immediate background for each split-screen pane (separate
    ; sessions: each child's diamonds/FX). When the guest paints once and
    ; renders twice, both panes receive the same snapshot — today's shared
    ; env stays backward-compatible.
    def bgCmdsPane0:[RgBgCmd2D]
    def bgCmdsPane1:[RgBgCmd2D]
    def bgSnap0:int 0
    def bgSnap1:int 0
    ; frame-local immediate overlay draw list (screen space, normalised; HUD)
    def ovCmds:[RgOvCmd2D]

    ; ---- immediate background draw list (world space) ------------------------
    ; bgBegin clears the list at the start of the game's per-frame draw; bgRect /
    ; bgCircle append world-space primitives a backend rasterises through the
    ; pane camera (under the retained sprites). Mirrors v1 bgFillRect/bgFillCircle.
    fn bgBegin:void () {
        def empty:[RgBgCmd2D]
        this.bgCmds = empty
    }
    fn bgRect:void (x:double y:double w:double h:double r:int g:int b:int) {
        def c:RgBgCmd2D (new RgBgCmd2D)
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = r
        c.g = g
        c.b = b
        push this.bgCmds c
    }
    fn bgCircle:void (cx:double cy:double rad:double r:int g:int b:int) {
        def c:RgBgCmd2D (new RgBgCmd2D)
        c.kind = 1
        c.x = cx
        c.y = cy
        c.rad = rad
        c.r = r
        c.g = g
        c.b = b
        push this.bgCmds c
    }
    fn bgCount:int () {
        return (array_length this.bgCmds)
    }
    fn bgClearSnapshots:void () {
        this.bgSnap0 = 0
        this.bgSnap1 = 0
    }
    ; Copy the live bg list into the pane's present snapshot (called from
    ; rg2d_render). Shallow: cmds are not mutated after append.
    fn bgSnapshotPane:void (pane:int) {
        def copy:[RgBgCmd2D]
        def i 0
        while (i < (array_length this.bgCmds)) {
            push copy (itemAt this.bgCmds i)
            i = (i + 1)
        }
        if (pane == 0) {
            this.bgCmdsPane0 = copy
            this.bgSnap0 = 1
        }
        if (pane == 1) {
            this.bgCmdsPane1 = copy
            this.bgSnap1 = 1
        }
    }
    ; Present-time list for a pane: snapshot if one was taken this frame,
    ; otherwise the live list (single-pane / no-render path).
    fn bgCmdsForPane:[RgBgCmd2D] (pane:int) {
        if (pane == 0) {
            if (this.bgSnap0 == 1) { return this.bgCmdsPane0 }
        }
        if (pane == 1) {
            if (this.bgSnap1 == 1) { return this.bgCmdsPane1 }
        }
        return this.bgCmds
    }

    ; ---- immediate overlay draw list (screen space, normalised; HUD) ---------
    fn ovBegin:void () {
        def empty:[RgOvCmd2D]
        this.ovCmds = empty
    }
    fn ovRect:void (x:double y:double w:double h:double r:int g:int b:int pane:int) {
        def c:RgOvCmd2D (new RgOvCmd2D)
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = r
        c.g = g
        c.b = b
        c.pane = pane
        push this.ovCmds c
    }
    fn ovCount:int () {
        return (array_length this.ovCmds)
    }

    ; ---- generic pool alloc (one helper per pool) ----------------------------
    fn allocTex:int () {
        def nf:int (array_length this.texFree)
        if (nf > 0) {
            def idx:int (itemAt this.texFree (nf - 1))
            def kept:[int]
            def i 0
            while (i < (nf - 1)) {
                push kept (itemAt this.texFree i)
                i = (i + 1)
            }
            this.texFree = kept
            return idx
        }
        def n:int (array_length this.textures)
        push this.textures (new RgTexture2D)
        return n
    }
    fn allocAtlas:int () {
        def nf:int (array_length this.atlasFree)
        if (nf > 0) {
            def idx:int (itemAt this.atlasFree (nf - 1))
            def kept:[int]
            def i 0
            while (i < (nf - 1)) {
                push kept (itemAt this.atlasFree i)
                i = (i + 1)
            }
            this.atlasFree = kept
            return idx
        }
        def n:int (array_length this.atlases)
        push this.atlases (new RgSpriteAtlas)
        return n
    }
    ; Clear every field so recycled payload slots cannot inherit flip/z/pane/etc.
    fn resetSprite:void (sp:RgSprite2D) {
        sp.atlasH = (RgHandle.invalid())
        sp.textureH = (RgHandle.invalid())
        sp.useTexture = false
        sp.regionIndex = 0
        sp.x = 0.0
        sp.y = 0.0
        sp.layerSlot = 0
        sp.w = 0.0
        sp.h = 0.0
        sp.z = 0
        sp.flipX = false
        sp.cellCol = (0 - 1)
        sp.cellRow = 0
        sp.paneOwner = (0 - 1)
    }

    fn allocSprite:int () {
        def nf:int (array_length this.spriteFree)
        if (nf > 0) {
            def idx:int (itemAt this.spriteFree (nf - 1))
            def kept:[int]
            def i 0
            while (i < (nf - 1)) {
                push kept (itemAt this.spriteFree i)
                i = (i + 1)
            }
            this.spriteFree = kept
            this.resetSprite((itemAt this.sprites idx))
            return idx
        }
        def n:int (array_length this.sprites)
        push this.sprites (new RgSprite2D)
        return n
    }
    fn allocLayer:int () {
        def nf:int (array_length this.layerFree)
        if (nf > 0) {
            def idx:int (itemAt this.layerFree (nf - 1))
            def kept:[int]
            def i 0
            while (i < (nf - 1)) {
                push kept (itemAt this.layerFree i)
                i = (i + 1)
            }
            this.layerFree = kept
            return idx
        }
        def n:int (array_length this.layers)
        push this.layers (new RgLayer2D)
        return n
    }
    fn allocCam:int () {
        def nf:int (array_length this.camFree)
        if (nf > 0) {
            def idx:int (itemAt this.camFree (nf - 1))
            def kept:[int]
            def i 0
            while (i < (nf - 1)) {
                push kept (itemAt this.camFree i)
                i = (i + 1)
            }
            this.camFree = kept
            return idx
        }
        def n:int (array_length this.cameras)
        push this.cameras (new RgCamera2D)
        return n
    }
    fn allocPlayer:int () {
        def nf:int (array_length this.playerFree)
        if (nf > 0) {
            def idx:int (itemAt this.playerFree (nf - 1))
            def kept:[int]
            def i 0
            while (i < (nf - 1)) {
                push kept (itemAt this.playerFree i)
                i = (i + 1)
            }
            this.playerFree = kept
            return idx
        }
        def n:int (array_length this.players)
        push this.players (new RgAnimPlayer2D)
        return n
    }

    ; ---- create (owned) ------------------------------------------------------
    fn textureCreate:OwnedHandle (w:int h:int) {
        def idx:int (this.allocTex())
        def tx:RgTexture2D (itemAt this.textures idx)
        tx.width = w
        tx.height = h
        def th:RgHandle (this.registry.alloc(this.realmId (Rg2DType.texture()) idx))
        return (OwnedHandle.own(th))
    }

    fn textureResolve:RgTexture2D (textureH:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(textureH (Rg2DType.texture())))
        if (r.ok == false) { return (new RgTexture2D) }
        return (itemAt this.textures r.payloadIndex)
    }

    ; Upload a decoded pixel store into a texture (D-2D). rgb/alpha are row-major
    ; width*height; this REPLACES any prior store and marks the texture sampled.
    ; Rendering never calls this — it is a resource op, not a sync boundary.
    fn textureUpload:void (textureH:RgHandle w:int h:int rgb:[int] alpha:[int]) {
        def tx:RgTexture2D (this.textureResolve(textureH))
        tx.width = w
        tx.height = h
        tx.rgb = rgb
        tx.alpha = alpha
        tx.hasPixels = true
    }

    fn textureHasPixels:boolean (textureH:RgHandle) {
        def tx:RgTexture2D (this.textureResolve(textureH))
        return tx.hasPixels
    }

    ; Sample one texel (clamped). Returns 0xRRGGBB; a=0 (via texelA) means the
    ; texel is transparent / out of a store-less texture.
    fn texelRGB:int (textureH:RgHandle px:int py:int) {
        def tx:RgTexture2D (this.textureResolve(textureH))
        if (tx.hasPixels == false) { return 0 }
        if (tx.width <= 0) { return 0 }
        if (tx.height <= 0) { return 0 }
        def cx:int px
        def cy:int py
        if (cx < 0) { cx = 0 }
        if (cy < 0) { cy = 0 }
        if (cx >= tx.width) { cx = (tx.width - 1) }
        if (cy >= tx.height) { cy = (tx.height - 1) }
        def idx:int ((cy * tx.width) + cx)
        if (idx < 0) { return 0 }
        if (idx >= (array_length tx.rgb)) { return 0 }
        return (itemAt tx.rgb idx)
    }
    fn texelA:int (textureH:RgHandle px:int py:int) {
        def tx:RgTexture2D (this.textureResolve(textureH))
        if (tx.hasPixels == false) { return 0 }
        if (tx.width <= 0) { return 0 }
        if (tx.height <= 0) { return 0 }
        def cx:int px
        def cy:int py
        if (cx < 0) { cx = 0 }
        if (cy < 0) { cy = 0 }
        if (cx >= tx.width) { cx = (tx.width - 1) }
        if (cy >= tx.height) { cy = (tx.height - 1) }
        def idx:int ((cy * tx.width) + cx)
        if (idx < 0) { return 0 }
        if (idx >= (array_length tx.alpha)) { return 0 }
        return (itemAt tx.alpha idx)
    }

    ; atlas retains its texture (shared retain, D-OWN)
    fn atlasCreate:OwnedHandle (textureH:RgHandle) {
        def idx:int (this.allocAtlas())
        def at:RgSpriteAtlas (itemAt this.atlases idx)
        at.textureH = textureH
        def emptyR:[RgSpriteRegion]
        at.regions = emptyR
        def emptyC:[RgAnimClip2D]
        at.clips = emptyC
        this.registry.retain(textureH)
        def h:RgHandle (this.registry.alloc(this.realmId (Rg2DType.atlas()) idx))
        return (OwnedHandle.own(h))
    }

    fn atlasResolve:RgSpriteAtlas (atlasH:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(atlasH (Rg2DType.atlas())))
        if (r.ok == false) { return (new RgSpriteAtlas) }
        return (itemAt this.atlases r.payloadIndex)
    }

    fn atlasAddRegion:int (atlasH:RgHandle name:string x:int y:int w:int h:int) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        def reg:RgSpriteRegion (new RgSpriteRegion)
        reg.name = name
        reg.x = x
        reg.y = y
        reg.w = w
        reg.h = h
        push at.regions reg
        return ((array_length at.regions) - 1)
    }

    fn atlasRegionIndex:int (atlasH:RgHandle name:string) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        def n:int (array_length at.regions)
        def i 0
        while (i < n) {
            def reg:RgSpriteRegion (itemAt at.regions i)
            if (reg.name == name) { return i }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; deterministic region lookup — the same host command TS and WASM both call.
    fn atlasRegionX:int (atlasH:RgHandle name:string) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        def idx:int (this.atlasRegionIndex(atlasH name))
        if (idx < 0) { return (0 - 1) }
        def reg:RgSpriteRegion (itemAt at.regions idx)
        return reg.x
    }
    fn atlasRegionW:int (atlasH:RgHandle name:string) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        def idx:int (this.atlasRegionIndex(atlasH name))
        if (idx < 0) { return (0 - 1) }
        def reg:RgSpriteRegion (itemAt at.regions idx)
        return reg.w
    }

    fn atlasAddClip:int (atlasH:RgHandle name:string frames:[int] durations:[double]) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        def clip:RgAnimClip2D (new RgAnimClip2D)
        clip.name = name
        clip.frames = frames
        clip.durations = durations
        push at.clips clip
        return ((array_length at.clips) - 1)
    }

    ; sprite retains its atlas (shared retain, D-OWN)
    fn spriteCreate:OwnedHandle (atlasH:RgHandle regionIndex:int) {
        def idx:int (this.allocSprite())
        def sp:RgSprite2D (itemAt this.sprites idx)
        sp.atlasH = atlasH
        sp.regionIndex = regionIndex
        sp.useTexture = false
        this.registry.retain(atlasH)
        def h:RgHandle (this.registry.alloc(this.realmId (Rg2DType.sprite()) idx))
        return (OwnedHandle.own(h))
    }

    ; Texture-backed sprite (D10): samples the full texture as a TextureView2D.
    ; Retains the texture (same ownership rule as atlas-backed sprites).
    fn spriteCreateFromTexture:OwnedHandle (textureH:RgHandle) {
        def idx:int (this.allocSprite())
        def sp:RgSprite2D (itemAt this.sprites idx)
        sp.textureH = textureH
        sp.useTexture = true
        this.registry.retain(textureH)
        def h:RgHandle (this.registry.alloc(this.realmId (Rg2DType.sprite()) idx))
        return (OwnedHandle.own(h))
    }

    ; Create a CPU render-target colour attachment: a Texture2D initialised to
    ; fully transparent pixels so RTT → sprite compositing starts clean (D9/D11).
    fn renderTargetCreate:OwnedHandle (w:int h:int) {
        def o:OwnedHandle (this.textureCreate(w h))
        def n:int (w * h)
        def rgb:[int]
        def alpha:[int]
        def i 0
        while (i < n) {
            push rgb 0
            push alpha 0
            i = (i + 1)
        }
        this.textureUpload(o.handle w h rgb alpha)
        return o
    }

    fn spriteResolve:RgSprite2D (spriteH:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(spriteH (Rg2DType.sprite())))
        if (r.ok == false) { return (new RgSprite2D) }
        return (itemAt this.sprites r.payloadIndex)
    }

    fn spriteAtlasHandle:RgHandle (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.atlasH
    }

    fn spriteUsesTexture:boolean (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.useTexture
    }

    fn spriteTextureHandle:RgHandle (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.textureH
    }

    fn spriteSetRegion:void (spriteH:RgHandle regionIndex:int) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        sp.regionIndex = regionIndex
    }
    fn spriteRegion:int (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.regionIndex
    }

    fn spriteSetSize:void (spriteH:RgHandle w:double h:double) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        sp.w = w
        sp.h = h
    }
    fn spriteW:double (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.w
    }
    fn spriteH:double (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.h
    }
    fn spriteSetZ:void (spriteH:RgHandle z:int) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        sp.z = z
    }
    fn spriteZ:int (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.z
    }
    fn spriteSetFlipX:void (spriteH:RgHandle flip:int) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        if (flip != 0) { sp.flipX = true } { sp.flipX = false }
    }
    fn spriteFlipX:boolean (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.flipX
    }

    fn spriteSetCell:void (spriteH:RgHandle col:int row:int) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        sp.cellCol = col
        sp.cellRow = row
    }
    fn spriteCellCol:int (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.cellCol
    }
    fn spriteSetPaneOwner:void (spriteH:RgHandle pane:int) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        sp.paneOwner = pane
    }
    fn spritePaneOwner:int (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.paneOwner
    }

    ; declare an atlas as a spritesheet grid (v1 "sheet" kind)
    fn atlasSetSheet:void (atlasH:RgHandle fw:int fh:int cols:int rows:int) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        at.frameW = fw
        at.frameH = fh
        at.cols = cols
        at.rows = rows
    }
    fn atlasFrameW:int (atlasH:RgHandle) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        return at.frameW
    }

    ; region geometry by index (renderer reads these to place/sample a sprite)
    fn regionAt:RgSpriteRegion (atlasH:RgHandle idx:int) {
        def at:RgSpriteAtlas (this.atlasResolve(atlasH))
        if (idx < 0) { return (new RgSpriteRegion) }
        if (idx >= (array_length at.regions)) { return (new RgSpriteRegion) }
        return (itemAt at.regions idx)
    }

    ; The source texel rect a sprite samples: a spritesheet CELL when the sprite
    ; has one (cellCol>=0) and its atlas is a sheet, else the named region. This
    ; is v1's drawSheet cell selection (col*frameW, row*frameH) folded into the
    ; existing region-sampling backend. Texture-backed sprites (D10) expose the
    ; full texture as a synthetic region at (0,0,w,h).
    fn spriteSrcRegion:RgSpriteRegion (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        if sp.useTexture {
            def tx:RgTexture2D (this.textureResolve(sp.textureH))
            def regT:RgSpriteRegion (new RgSpriteRegion)
            regT.x = 0
            regT.y = 0
            regT.w = tx.width
            regT.h = tx.height
            return regT
        }
        if (sp.cellCol >= 0) {
            def at:RgSpriteAtlas (this.atlasResolve(sp.atlasH))
            if (at.frameW > 0) {
                def reg:RgSpriteRegion (new RgSpriteRegion)
                reg.x = (sp.cellCol * at.frameW)
                reg.y = (sp.cellRow * at.frameH)
                reg.w = at.frameW
                reg.h = at.frameH
                return reg
            }
        }
        return (this.regionAt(sp.atlasH sp.regionIndex))
    }

    fn spriteSetPos:void (spriteH:RgHandle x:double y:double) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        sp.x = x
        sp.y = y
    }
    fn spriteX:double (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.x
    }
    fn spriteY:double (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.y
    }

    ; Enumerate live sprite handles (for a backend that READS host state to draw
    ; — D-SYNC: rendering reads, it never mutates). Handles are reconstructed
    ; from the registry slot metadata, staying generation-checked.
    fn liveSpriteHandles:[RgHandle] () {
        def out:[RgHandle]
        def n:int (array_length this.registry.gen)
        def i 0
        while (i < n) {
            if ((itemAt this.registry.live i)) {
                if ((itemAt this.registry.typ i) == (Rg2DType.sprite())) {
                    def h:RgHandle (RgHandle.of((i + 1) (itemAt this.registry.gen i) (itemAt this.registry.realm i) (Rg2DType.sprite())))
                    push out h
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; ---- layer membership (D-LIFE lifetime 2, never ownership) --------------
    fn layerCreate:OwnedHandle () {
        def idx:int (this.allocLayer())
        def ly:RgLayer2D (itemAt this.layers idx)
        ly.childCount = 0
        def h:RgHandle (this.registry.alloc(this.realmId (Rg2DType.layer()) idx))
        return (OwnedHandle.own(h))
    }

    fn layerChildCount:int (layerH:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(layerH (Rg2DType.layer())))
        if (r.ok == false) { return (0 - 1) }
        def ly:RgLayer2D (itemAt this.layers r.payloadIndex)
        return ly.childCount
    }

    fn decLayer:void (layerSlot:int) {
        def idx:int (layerSlot - 1)
        if (idx >= 0) {
            def payIdx:int (itemAt this.registry.payload idx)
            if (payIdx >= 0) {
                if (payIdx < (array_length this.layers)) {
                    def ly:RgLayer2D (itemAt this.layers payIdx)
                    if (ly.childCount > 0) { ly.childCount = (ly.childCount - 1) }
                }
            }
        }
    }

    fn layerAdd:RgResolve (spriteH:RgHandle layerH:RgHandle) {
        def rs:RgResolve (this.registry.resolveTyped(spriteH (Rg2DType.sprite())))
        if (rs.ok == false) { return rs }
        def rl:RgResolve (this.registry.resolveTyped(layerH (Rg2DType.layer())))
        if (rl.ok == false) { return rl }
        def sp:RgSprite2D (itemAt this.sprites rs.payloadIndex)
        if (sp.layerSlot != 0) {
            if (sp.layerSlot != layerH.slot) { this.decLayer(sp.layerSlot) }
        }
        if (sp.layerSlot != layerH.slot) {
            sp.layerSlot = layerH.slot
            def ly:RgLayer2D (itemAt this.layers rl.payloadIndex)
            ly.childCount = (ly.childCount + 1)
        }
        return rs
    }

    fn layerRemove:RgResolve (spriteH:RgHandle) {
        def rs:RgResolve (this.registry.resolveTyped(spriteH (Rg2DType.sprite())))
        if (rs.ok == false) { return rs }
        def sp:RgSprite2D (itemAt this.sprites rs.payloadIndex)
        if (sp.layerSlot != 0) {
            this.decLayer(sp.layerSlot)
            sp.layerSlot = 0
        }
        return rs
    }

    fn spriteLayerSlot:int (spriteH:RgHandle) {
        def sp:RgSprite2D (this.spriteResolve(spriteH))
        return sp.layerSlot
    }

    ; ---- Camera2D transforms (SW + GPU formulations must agree) -------------
    fn cameraCreate:OwnedHandle () {
        def idx:int (this.allocCam())
        def cam:RgCamera2D (itemAt this.cameras idx)
        cam.x = 0.0
        cam.y = 0.0
        cam.zoom = 1.0
        cam.rotation = 0.0
        def h:RgHandle (this.registry.alloc(this.realmId (Rg2DType.camera()) idx))
        return (OwnedHandle.own(h))
    }

    fn cameraResolve:RgCamera2D (camH:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(camH (Rg2DType.camera())))
        if (r.ok == false) { return (new RgCamera2D) }
        return (itemAt this.cameras r.payloadIndex)
    }

    fn cameraSet:void (camH:RgHandle x:double y:double zoom:double rotation:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        cam.x = x
        cam.y = y
        cam.zoom = zoom
        cam.rotation = rotation
    }

    ; software path: direct arithmetic. Returns screen X.
    fn worldToScreenSwX:double (camH:RgHandle wx:double wy:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        def dx:double ((wx - cam.x) * cam.zoom)
        def dy:double ((wy - cam.y) * cam.zoom)
        def c:double (cos cam.rotation)
        def s:double (sin cam.rotation)
        return ((dx * c) - (dy * s))
    }
    fn worldToScreenSwY:double (camH:RgHandle wx:double wy:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        def dx:double ((wx - cam.x) * cam.zoom)
        def dy:double ((wy - cam.y) * cam.zoom)
        def c:double (cos cam.rotation)
        def s:double (sin cam.rotation)
        return ((dx * s) + (dy * c))
    }

    ; GPU path: build the affine (a,b,c,d,e,f) and apply — same math, matrix form.
    fn worldToScreenGpuX:double (camH:RgHandle wx:double wy:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        def co:double (cos cam.rotation)
        def si:double (sin cam.rotation)
        def a:double (cam.zoom * co)
        def b:double (0.0 - (cam.zoom * si))
        def e:double (0.0 - ((cam.x * a) + (cam.y * b)))
        return (((a * wx) + (b * wy)) + e)
    }
    fn worldToScreenGpuY:double (camH:RgHandle wx:double wy:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        def co:double (cos cam.rotation)
        def si:double (sin cam.rotation)
        def cc:double (cam.zoom * si)
        def dd:double (cam.zoom * co)
        def f:double (0.0 - ((cam.x * cc) + (cam.y * dd)))
        return (((cc * wx) + (dd * wy)) + f)
    }

    ; screenToWorld inverse of the SW path (round-trip check)
    fn screenToWorldX:double (camH:RgHandle sx:double sy:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        def c:double (cos cam.rotation)
        def s:double (sin cam.rotation)
        ; un-rotate then un-zoom then un-translate
        def rx:double ((sx * c) + (sy * s))
        return ((rx / cam.zoom) + cam.x)
    }
    fn screenToWorldY:double (camH:RgHandle sx:double sy:double) {
        def cam:RgCamera2D (this.cameraResolve(camH))
        def c:double (cos cam.rotation)
        def s:double (sin cam.rotation)
        def ry:double ((0.0 - (sx * s)) + (sy * c))
        return ((ry / cam.zoom) + cam.y)
    }

    ; ---- AnimationPlayer2D (one shared model on runtime.time) ---------------
    fn playerCreate:OwnedHandle (spriteH:RgHandle clipIndex:int) {
        def idx:int (this.allocPlayer())
        def pl:RgAnimPlayer2D (itemAt this.players idx)
        pl.spriteH = spriteH
        pl.clipIndex = clipIndex
        pl.playing = true
        def h:RgHandle (this.registry.alloc(this.realmId (Rg2DType.player()) idx))
        return (OwnedHandle.own(h))
    }

    ; region index displayed at a given (looping) runtime time, deterministic.
    fn playerFrameAt:int (playerH:RgHandle time:double) {
        def r:RgResolve (this.registry.resolveTyped(playerH (Rg2DType.player())))
        if (r.ok == false) { return (0 - 1) }
        def pl:RgAnimPlayer2D (itemAt this.players r.payloadIndex)
        def sp:RgSprite2D (this.spriteResolve(pl.spriteH))
        def at:RgSpriteAtlas (this.atlasResolve(sp.atlasH))
        def clip:RgAnimClip2D (itemAt at.clips pl.clipIndex)
        def nf:int (array_length clip.frames)
        if (nf == 0) { return (0 - 1) }
        def total:double 0.0
        def i 0
        while (i < nf) {
            total = (total + (itemAt clip.durations i))
            i = (i + 1)
        }
        ; loop time into [0,total)
        def tt:double time
        while (tt >= total) { tt = (tt - total) }
        while (tt < 0.0) { tt = (tt + total) }
        def acc:double 0.0
        def j 0
        while (j < nf) {
            acc = (acc + (itemAt clip.durations j))
            if (tt < acc) {
                return (itemAt clip.frames j)
            }
            j = (j + 1)
        }
        return (itemAt clip.frames (nf - 1))
    }

    ; ---- weak PoseBinding2D -------------------------------------------------
    ; body -> sprite; rejects a stale body OR sprite handle. Never keeps either
    ; alive (the caller holds the physics-world / 2D registries separately).
    fn poseBindingValid:boolean (bodyLive:boolean spriteH:RgHandle) {
        if (bodyLive == false) { return false }
        return (this.registry.isLive(spriteH))
    }

    ; ---- shared ownership helpers ------------------------------------------
    fn refcount:int (h:RgHandle) { return (this.registry.refcountOf(h)) }
    fn isLive:boolean (h:RgHandle) { return (this.registry.isLive(h)) }
    fn liveCount:int () { return (this.registry.liveCount()) }
    fn liveOfType:int (typeId:int) {
        def n:int (array_length this.registry.gen)
        def c 0
        def i 0
        while (i < n) {
            if ((itemAt this.registry.live i)) {
                if ((itemAt this.registry.typ i) == typeId) { c = (c + 1) }
            }
            i = (i + 1)
        }
        return c
    }

    ; release a sprite: ends its ownership; releases its retained atlas ref.
    fn releaseSprite:RgResolve (owned:OwnedHandle) {
        if (owned.released) { return (RgResolve.fail((RgErr.doubleRelease()))) }
        def sp:RgSprite2D (this.spriteResolve(owned.handle))
        def atlasH:RgHandle sp.atlasH
        def texH:RgHandle sp.textureH
        def fromTex:boolean sp.useTexture
        def r:RgResolve (this.registry.releaseOnce(owned.handle))
        if (r.ok) {
            owned.released = true
            if (r.freed) {
                push this.spriteFree r.payloadIndex
                ; drop the sprite's retained source reference (atlas or texture)
                if fromTex {
                    this.registry.releaseOnce(texH)
                } {
                    this.registry.releaseOnce(atlasH)
                }
            }
        }
        return r
    }

    fn teardownRealm:int (realmId:int) { return (this.registry.teardownRealm(realmId)) }
}

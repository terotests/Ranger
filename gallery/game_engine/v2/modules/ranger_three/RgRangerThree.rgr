; ==============================================================================
; RgRangerThree — thin host arena wrapping ThreeSceneHost for ranger:three.
; ==============================================================================
; Guest commands mint OwnedHandles whose payloadIndex is the 1-based Three
; SceneHost handle. Render-to-texture copies the software backend's RGB+alpha
; buffers into an RgTexture2D (PLAN_2D_EMBED_3D path A: SW 3D → CPU Texture2D →
; SW 2D). Handle args are resolved with resolveTyped (wrong arena type rejected).
; ==============================================================================

Import "../../host/RgRegistry.rgr"
Import "../../host/handles/RgHandle.rgr"
Import "../../host/ownership/OwnedHandle.rgr"
Import "../../three/port/src/three_scene_host.rgr"
Import "../../three/port/src/three_object3d.rgr"
Import "../ranger_2d/RgRanger2D.rgr"

class Rg3DType {
    sfn scene:int () { return 40 }
    sfn camera:int () { return 41 }
    sfn geometry:int () { return 42 }
    sfn material:int () { return 43 }
    sfn mesh:int () { return 44 }
    sfn light:int () { return 45 }
    sfn group:int () { return 46 }
    sfn orbit:int () { return 47 }
}

class RgRangerThree {
    def registry:RgRegistry (new RgRegistry)
    def realmId:int 1
    def host:ThreeSceneHost (new ThreeSceneHost)
    ; Set when a typed resolve fails; bridge turns this into a typed error.
    def lastErr:string ""
    ; Counts successful renderToTexture calls (regression: present must not bump).
    def rttCount:int 0

    fn clearErr:void () {
        this.lastErr = ""
    }

    fn sceneH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.scene())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:scene"
            return 0
        }
        return r.payloadIndex
    }

    ; direct children of a scene handle (D-SYNC membership inspection for tests).
    fn sceneChildCount:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.scene())))
        if (r.ok == false) { return (0 - 1) }
        return (this.host.sceneChildCount(r.payloadIndex))
    }

    fn cameraH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.camera())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:camera"
            return 0
        }
        return r.payloadIndex
    }

    fn geometryH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.geometry())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:geometry"
            return 0
        }
        return r.payloadIndex
    }

    fn materialH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.material())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:material"
            return 0
        }
        return r.payloadIndex
    }

    fn meshH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.mesh())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:mesh"
            return 0
        }
        return r.payloadIndex
    }

    fn lightH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.light())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:light"
            return 0
        }
        return r.payloadIndex
    }

    fn orbitH:int (h:RgHandle) {
        def r:RgResolve (this.registry.resolveTyped(h (Rg3DType.orbit())))
        if (r.ok == false) {
            this.lastErr = "wrong-type:orbit"
            return 0
        }
        return r.payloadIndex
    }

    ; D-SYNC: resolve ANY renderable scene entity to its host entities[] index.
    ; Meshes, host-decoded model roots (mesh-typed), lights and groups all live in
    ; the host entities[] array, so membership ops (set_parent / remove) accept any
    ; of them uniformly — a group is usable both AS a child and AS a parent.
    ; Returns 0 (typed "wrong-type:mesh" in lastErr, backward compatible with the
    ; mesh-only guard) when the handle is none of them.
    fn entityH:int (h:RgHandle) {
        def rm:RgResolve (this.registry.resolveTyped(h (Rg3DType.mesh())))
        if (rm.ok) { return rm.payloadIndex }
        def rl:RgResolve (this.registry.resolveTyped(h (Rg3DType.light())))
        if (rl.ok) { return rl.payloadIndex }
        def rg:RgResolve (this.registry.resolveTyped(h (Rg3DType.group())))
        if (rg.ok) { return rg.payloadIndex }
        this.lastErr = "wrong-type:mesh"
        return 0
    }

    fn sceneCreate:OwnedHandle () {
        def th:int (this.host.sceneNew())
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.scene()) th))
        return (OwnedHandle.own(h))
    }

    ; D-SYNC: DETACHED create — a Group node with a stable handle and NO scene
    ; membership. Membership is established separately via entitySetParent
    ; (scene.add(group)). Mirrors sceneCreate/meshCreate detached.
    fn groupCreate:OwnedHandle () {
        def th:int (this.host.groupNewDetached())
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.group()) th))
        return (OwnedHandle.own(h))
    }

    fn cameraCreate:OwnedHandle () {
        def th:int (this.host.cameraNew())
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.camera()) th))
        return (OwnedHandle.own(h))
    }

    ; Read-only camera world-position accessors (general query for tools /
    ; controllers). Resolve the camera typed; a bad handle reads 0.0 (never
    ; mutates, never a typed error).
    fn cameraPosX:double (camH:RgHandle) {
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return 0.0 }
        return (this.host.cameraPosX(cam))
    }
    fn cameraPosY:double (camH:RgHandle) {
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return 0.0 }
        return (this.host.cameraPosY(cam))
    }
    fn cameraPosZ:double (camH:RgHandle) {
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return 0.0 }
        return (this.host.cameraPosZ(cam))
    }

    fn cameraSet:boolean (camH:RgHandle fov:double aspect:double near:double far:double) {
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return false }
        this.host.cameraSet(cam fov aspect near far)
        return true
    }

    fn cameraPose:boolean (camH:RgHandle px:double py:double pz:double ex:double ey:double ez:double) {
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return false }
        this.host.cameraPose(cam px py pz ex ey ez)
        return true
    }

    ; --- orbit controls -------------------------------------------------------
    ; Create an OrbitControls bound to an existing camera. Invalid handle out on
    ; a bad camera (mirrors meshCreate's resource-resolve guard).
    fn orbitCreate:OwnedHandle (camH:RgHandle) {
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return (OwnedHandle.own((RgHandle.invalid()))) }
        def th:int (this.host.orbitCreate(cam))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.orbit()) th))
        return (OwnedHandle.own(h))
    }

    fn orbitViewport:boolean (ctrlH:RgHandle w:int h:int) {
        def oc:int (this.orbitH(ctrlH))
        if (oc == 0) { return false }
        this.host.orbitViewport(oc w h)
        return true
    }

    fn orbitTarget:boolean (ctrlH:RgHandle x:double y:double z:double) {
        def oc:int (this.orbitH(ctrlH))
        if (oc == 0) { return false }
        this.host.orbitTarget(oc x y z)
        return true
    }

    fn orbitPointer:boolean (ctrlH:RgHandle phase:int x:double y:double button:int) {
        def oc:int (this.orbitH(ctrlH))
        if (oc == 0) { return false }
        this.host.orbitPointer(oc phase x y button)
        return true
    }

    fn orbitWheel:boolean (ctrlH:RgHandle delta:double) {
        def oc:int (this.orbitH(ctrlH))
        if (oc == 0) { return false }
        this.host.orbitWheel(oc delta)
        return true
    }

    fn orbitApply:boolean (ctrlH:RgHandle) {
        def oc:int (this.orbitH(ctrlH))
        if (oc == 0) { return false }
        this.host.orbitApply(oc)
        return true
    }

    fn geometryBox:OwnedHandle (w:double h:double d:double) {
        def th:int (this.host.geometryBox(w h d))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.geometry()) th))
        return (OwnedHandle.own(h))
    }

    ; Flat plane geometry (leaf resource, mirrors geometryBox). Used as a floor.
    fn geometryPlane:OwnedHandle (width:double height:double wSeg:int hSeg:int) {
        def th:int (this.host.geometryPlane(width height wSeg hSeg))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.geometry()) th))
        return (OwnedHandle.own(h))
    }

    fn geometryOctahedron:OwnedHandle (radius:double) {
        def th:int (this.host.geometryOctahedron(radius))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.geometry()) th))
        return (OwnedHandle.own(h))
    }

    ; Utah teapot geometry (leaf resource, mirrors geometryBox). The 5 part/shape
    ; flags arrive as booleans; the bridge decodes the schema's i32 0/1 encoding.
    fn geometryTeapot:OwnedHandle (size:double seg:int bottom:boolean lid:boolean body:boolean fitLid:boolean blinn:boolean) {
        def th:int (this.host.geometryTeapot(size seg bottom lid body fitLid blinn))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.geometry()) th))
        return (OwnedHandle.own(h))
    }

    ; Smooth UV sphere (radius, widthSegments, heightSegments) — full sphere.
    fn geometrySphere:OwnedHandle (radius:double wSeg:int hSeg:int) {
        def th:int (this.host.geometrySphere(radius wSeg hSeg 0.0 6.2831853 0.0 3.14159265))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.geometry()) th))
        return (OwnedHandle.own(h))
    }

    ; Cylinder (radiusTop, radiusBottom, height, radialSegments) — capped.
    fn geometryCylinder:OwnedHandle (rTop:double rBot:double height:double radialSeg:int) {
        def th:int (this.host.geometryCylinder(rTop rBot height radialSeg 1 false 0.0 6.2831853))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.geometry()) th))
        return (OwnedHandle.own(h))
    }

    fn materialBasic:OwnedHandle (colorHex:int) {
        def th:int (this.host.materialBasic(colorHex 0 false))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.material()) th))
        return (OwnedHandle.own(h))
    }

    fn materialLambert:OwnedHandle (colorHex:int) {
        def th:int (this.host.materialLambert(colorHex 0))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.material()) th))
        return (OwnedHandle.own(h))
    }

    ; Phong material (colour, specular colour, shininess) — smooth-shaded with a
    ; specular highlight, for shiny metal (the ball) and glossy caps.
    fn materialPhong:OwnedHandle (colorHex:int specularHex:int shininess:double) {
        def th:int (this.host.materialPhong(colorHex specularHex shininess false 0))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.material()) th))
        return (OwnedHandle.own(h))
    }

    fn materialSetOpacity:boolean (matH:RgHandle opacity:double) {
        def mat:int (this.materialH(matH))
        if (mat == 0) { return false }
        this.host.materialSetOpacity(mat opacity)
        return true
    }

    ; D-SYNC: DETACHED create — object lifetime is independent of scene
    ; membership. No scene handle: builds the light into entities[] without adding
    ; it to any scene. Membership is established separately via entitySetParent.
    fn lightAmbient:OwnedHandle (colorHex:int intensity:double) {
        def th:int (this.host.lightAmbientDetached(colorHex intensity))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.light()) th))
        return (OwnedHandle.own(h))
    }

    ; D-SYNC: DETACHED create (see lightAmbient). Preserves the extra shadow params.
    fn lightDirectional:OwnedHandle (colorHex:int intensity:double dx:double dy:double dz:double) {
        def th:int (this.host.lightDirectionalDetached(colorHex intensity dx dy dz false 0))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.light()) th))
        return (OwnedHandle.own(h))
    }

    ; D-SYNC: DETACHED create — object lifetime is independent of scene
    ; membership. No scene handle: builds the mesh into entities[] without adding
    ; it to any scene. Membership is established separately via entitySetParent.
    fn meshCreate:OwnedHandle (geoH:RgHandle matH:RgHandle) {
        def gh:int (this.geometryH(geoH))
        if (gh == 0) { return (OwnedHandle.own((RgHandle.invalid()))) }
        def mh:int (this.materialH(matH))
        if (mh == 0) { return (OwnedHandle.own((RgHandle.invalid()))) }
        def th:int (this.host.meshNewDetached(gh mh))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.mesh()) th))
        return (OwnedHandle.own(h))
    }

    ; Transform ops are entity-generic (host.entityTransform/entitySetScale act on
    ; ANY entities[] node), so resolve via entityH (mesh|light|group) — this lets a
    ; Group be transformed as a unit (group.setTransform). A non-entity handle
    ; still fails entityH with the mesh-compatible "wrong-type:mesh" guard.
    fn meshTransform:boolean (meshH:RgHandle px:double py:double pz:double ex:double ey:double ez:double) {
        def mesh:int (this.entityH(meshH))
        if (mesh == 0) { return false }
        this.host.entityTransform(mesh px py pz ex ey ez 1.0 1.0 1.0)
        return true
    }

    fn meshSetScale:boolean (meshH:RgHandle sx:double sy:double sz:double) {
        def mesh:int (this.entityH(meshH))
        if (mesh == 0) { return false }
        this.host.entitySetScale(mesh sx sy sz)
        return true
    }

    ; D-SYNC: reparent an ALREADY-created entity (membership decoupled from
    ; creation). The child is a mesh entity; the parent may be a scene root or
    ; another mesh entity — resolved by trying the scene type first, then mesh.
    ; Membership only: allocates nothing, releases nothing. Returns false (typed
    ; bad-handle in lastErr) on any unresolved handle, mirroring meshTransform's
    ; guard so the bridge turns it into a typed error.
    fn entitySetParent:boolean (childH:RgHandle parentH:RgHandle) {
        def child:int (this.entityH(childH))
        if (child == 0) { return false }
        def ps:int (this.sceneH(parentH))
        if (ps != 0) {
            this.lastErr = ""
            this.host.entitySetParent(child ps 0)
            return true
        }
        ; A parent may be any entity — mesh, light OR group — so a group is usable
        ; AS a parent (group.add(child)). Resolve via entityH (mesh|light|group).
        def pe:int (this.entityH(parentH))
        if (pe != 0) {
            this.lastErr = ""
            this.host.entitySetParent(child 0 pe)
            return true
        }
        this.lastErr = "wrong-type:parent"
        return false
    }

    ; D-SYNC: detach an entity from a scene — MEMBERSHIP ONLY. The object is NOT
    ; destroyed (entities[] slot and handle survive), so a later entitySetParent
    ; can re-attach it. Resolves both handles typed (scene via sceneH, entity via
    ; meshH); returns false (typed bad-handle in lastErr) on any unresolved
    ; handle, mirroring meshTransform's guard so the bridge yields a typed error.
    fn entityRemove:boolean (sceneH:RgHandle entH:RgHandle) {
        def sh:int (this.sceneH(sceneH))
        if (sh == 0) { return false }
        def eh:int (this.entityH(entH))
        if (eh == 0) { return false }
        this.host.entityRemove(sh eh)
        return true
    }

    ; Attach a host-decoded Object3D subtree (e.g. from ThreeGLTFFile.loadGLB).
    ; Package I/O and image decode stay in the bridge — this arena is game-agnostic.
    ; D-SYNC: DETACHED create — register the decoded root into entities[] with NO
    ; scene membership. Membership is established separately via entitySetParent.
    fn modelAttachRoot:OwnedHandle (root:ThreeObject3D) {
        def th:int (this.host.modelAttachDetached(root))
        def h:RgHandle (this.registry.alloc(this.realmId (Rg3DType.mesh()) th))
        return (OwnedHandle.own(h))
    }

    ; SW 3D → CPU Texture2D with 2× supersampling.
    ; Rasterise at 2w×2h, then resolve each 2×2 block with a premultiplied
    ; RGBA average into the uploaded w×h texture (avoids dark fringes from
    ; averaging straight RGB against transparent black). Path A: executed at
    ; record time; presenter must not re-run RTT.
    fn renderToTexture:boolean (sceneH:RgHandle camH:RgHandle texH:RgHandle w:int h:int d2:RgRanger2D) {
        def sh:int (this.sceneH(sceneH))
        if (sh == 0) { return false }
        def cam:int (this.cameraH(camH))
        if (cam == 0) { return false }
        if (w < 1) { return false }
        if (h < 1) { return false }
        def sw:int (w * 2)
        def shh:int (h * 2)
        this.host.renderer.setClearColor(0.0 0.0 0.0)
        this.host.render(sh cam sw shh)
        def raw:buffer (this.host.raw())
        def aRaw:buffer (this.host.rawAlpha())
        def rgb:[int]
        def alpha:[int]
        def y 0
        while (y < h) {
            def x 0
            while (x < w) {
                def sumRA:int 0
                def sumGA:int 0
                def sumBA:int 0
                def sumA:int 0
                def dy 0
                while (dy < 2) {
                    def dx 0
                    while (dx < 2) {
                        def sx:int ((x * 2) + dx)
                        def sy:int ((y * 2) + dy)
                        def pidx:int ((sy * sw) + sx)
                        def o:int (pidx * 3)
                        def r:int (buffer_get raw o)
                        def g:int (buffer_get raw (o + 1))
                        def b:int (buffer_get raw (o + 2))
                        def a:int (buffer_get aRaw pidx)
                        sumRA = (sumRA + (r * a))
                        sumGA = (sumGA + (g * a))
                        sumBA = (sumBA + (b * a))
                        sumA = (sumA + a)
                        dx = (dx + 1)
                    }
                    dy = (dy + 1)
                }
                def outA:int (idiv (sumA + 2) 4)
                def outR:int 0
                def outG:int 0
                def outB:int 0
                if (sumA > 0) {
                    ; Un-premultiply the averaged coverage into straight RGB for
                    ; the existing src-over 2D compositor.
                    outR = (idiv sumRA sumA)
                    outG = (idiv sumGA sumA)
                    outB = (idiv sumBA sumA)
                }
                push rgb (((outR * 65536) + (outG * 256)) + outB)
                push alpha outA
                x = (x + 1)
            }
            y = (y + 1)
        }
        d2.textureUpload(texH w h rgb alpha)
        this.rttCount = (this.rttCount + 1)
        return true
    }

    fn teardownRealm:int (realmId:int) {
        return (this.registry.teardownRealm(realmId))
    }
}

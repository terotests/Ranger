; ==============================================================================
; ylos3d_wasm_game_test — the ylos3d gems (wasm32) run through RgWasmGameHost.
; ==============================================================================
; Loads games/ylos3d_wasm/logic.wasm through RgWasmGameHost (the wasm sibling of
; RgGameHost) and asserts it drives the SAME generic bridge .tsx games use: a
; cluster of coloured, spinning octahedral gems is built, PRESENTED (rendered to
; a render target a single pane displays), and animated. Real rasterised colour
; reaches the framebuffer. Only the SDL blit is untestable here.
; ==============================================================================

Import "../../runtime/game_host/RgWasmGameHost.rgr"
Import "../../runtime/game_host/Rg2DPresenter.rgr"
Import "../harness/RgTest.rgr"

class Ylos3dWasmGameTest {
    ; count framebuffer samples that carry a non-clear colour (the gems).
    sfn colouredSamples:int (fb:RgFramebuffer x0:int y0:int x1:int y1:int) {
        def n 0
        def y:int y0
        while (y < y1) {
            def x:int x0
            while (x < x1) {
                if ((fb.at(x y)) != 0) { n = (n + 1) }
                x = (x + 4)
            }
            y = (y + 4)
        }
        return n
    }
    sfn diffCount:int (a:RgFramebuffer b:RgFramebuffer x0:int y0:int x1:int y1:int) {
        def n 0
        def y:int y0
        while (y < y1) {
            def x:int x0
            while (x < x1) {
                if ((a.at(x y)) != (b.at(x y))) { n = (n + 1) }
                x = (x + 4)
            }
            y = (y + 4)
        }
        return n
    }

    sfn m@(main):void () {
        def t:RgTest (RgTest.forSuite("games/ylos3d_wasm (gems via RgWasmGameHost)"))
        def host:RgWasmGameHost (new RgWasmGameHost)

        ; ---- load: init() builds the gem cluster through the generic bridge ---
        def ok:boolean (host.load("gallery/game_engine/v2/games/ylos3d_wasm" "logic.wasm"))
        t.ok("wasm game loaded + init drained" ok)
        t.eqInt("no bridge errors after init" host.bridge.errorCount 0)
        t.eqInt("init built 5 gem meshes" (host.bridge.d3.host.entityCount()) 5)
        t.eqInt("init built 5 gem geometries" (host.bridge.d3.host.geometryCount()) 5)
        t.eqInt("init built 5 gem materials" (host.bridge.d3.host.materialCount()) 5)

        ; all five gems are parented to the scene (D-SYNC across the wasm loader)
        def sceneH:RgHandle (host.bridge.resolveGuestId((host.hostId(1))))
        t.eqInt("all 5 gems parented to the scene" (host.bridge.d3.sceneChildCount(sceneH)) 5)

        ; init declared a single on-screen pane
        t.eqInt("init declared one full pane" (host.bridge.surface.paneCount()) 1)

        ; ---- one frame binds the pane; present composites the coloured gems ---
        host.frame(16.667)
        def fb1:RgFramebuffer (RgFramebuffer.create(320 320))
        def drawn:int (Rg2DPresenter.presentTextured(host.bridge 0 fb1 0))
        t.ok("pane 0 composites the gems (a sprite was drawn)" (drawn >= 1))
        t.ok("the gems rendered in colour (non-clear framebuffer pixels)"
            ((Ylos3dWasmGameTest.colouredSamples(fb1 40 60 280 260)) > 0))

        ; ---- run frames: the gems spin, so the picture changes ---------------
        def before:int host.disp.dispatched
        def i 0
        while (i < 10) {
            host.frame(16.667)
            i = (i + 1)
        }
        t.eqInt("no bridge errors across 10 frames" host.bridge.errorCount 0)
        t.eqInt("still 5 gems (spinning, not leaked)" (host.bridge.d3.host.entityCount()) 5)
        def fb2:RgFramebuffer (RgFramebuffer.create(320 320))
        def drawn2:int (Rg2DPresenter.presentTextured(host.bridge 0 fb2 0))
        t.ok("still compositing after spinning" (drawn2 >= 1))
        t.ok("the gems are animating (framebuffer changed as they spun)"
            ((Ylos3dWasmGameTest.diffCount(fb1 fb2 40 60 280 260)) > 0))

        t.summary()
    }
}

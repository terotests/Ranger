; ==============================================================================
; ylos3d_wasm_e2e_test — the faithful Rust/wasm32 port of ylos3d, through the host.
; ==============================================================================
; Loads games/ylos3d_wasm/logic.wasm through RgWasmGameHost and asserts it drives
; the SAME generic bridge as the .tsx ylos3d: split-screen surface, LPC player
; sprites with real physics (rest on the floor, jump, walk), enemies, 3D diamonds,
; and a rendered world — all from Rust. Sprite positions are read back from the
; host 2D arena to check the SIMULATION; a present proves the world rasterises.
; ==============================================================================

Import "../../runtime/game_host/RgWasmGameHost.rgr"
Import "../../runtime/game_host/Rg2DPresenter.rgr"
Import "../harness/RgTest.rgr"

class Ylos3dWasmGameTest {
    ; sprite Y of a guest-local sprite id (through the host 2D arena)
    sfn spriteY:double (host:RgWasmGameHost gid:int) {
        def h:RgHandle (host.bridge.resolveGuestId((host.hostId(gid))))
        return (host.bridge.d2.spriteY(h))
    }
    sfn spriteX:double (host:RgWasmGameHost gid:int) {
        def h:RgHandle (host.bridge.resolveGuestId((host.hostId(gid))))
        return (host.bridge.d2.spriteX(h))
    }
    sfn nonClear:int (fb:RgFramebuffer w:int h:int) {
        def n 0
        def y 0
        while (y < h) {
            def x 0
            while (x < w) {
                if ((fb.at(x y)) != 0) { n = (n + 1) }
                x = (x + 6)
            }
            y = (y + 6)
        }
        return n
    }
    sfn stepN:void (host:RgWasmGameHost n:int) {
        def i 0
        while (i < n) {
            host.frame(16.667)
            i = (i + 1)
        }
    }

    sfn m@(main):void () {
        def t:RgTest (RgTest.forSuite("games/ylos3d_wasm (ylos3d Rust port via RgWasmGameHost)"))
        def host:RgWasmGameHost (new RgWasmGameHost)

        ; ---- load: init builds the whole scene through the generic bridge -----
        def ok:boolean (host.load("gallery/game_engine/v2/games/ylos3d_wasm" "logic.wasm"))
        t.ok("wasm game loaded + init drained" ok)
        t.eqInt("no bridge errors after init" host.bridge.errorCount 0)
        t.eqInt("split-screen: two panes" (host.bridge.surface.paneCount()) 2)
        t.ok("3D diamonds built (entities present)" ((host.bridge.d3.host.entityCount()) > 0))

        ; ---- physics: players rest on the floor platform --------------------
        Ylos3dWasmGameTest.stepN(host 3)
        t.eqInt("no unhandled commands running the game" host.bridge.unhandledCount 0)
        t.eqInt("no bridge errors running the game" host.bridge.errorCount 0)
        def p0rest:double (Ylos3dWasmGameTest.spriteY(host 10))
        def p1rest:double (Ylos3dWasmGameTest.spriteY(host 12))
        t.near("player 0 rests on the ground (sprite y ~ 1811)" p0rest 1811.0)
        t.near("player 1 rests on the ground (sprite y ~ 1811)" p1rest 1811.0)
        def p0x0:double (Ylos3dWasmGameTest.spriteX(host 10))

        ; ---- input: JUMP raises the player ----------------------------------
        host.bridge.input.setAction(0 "jump" true)
        Ylos3dWasmGameTest.stepN(host 5)
        t.ok("holding JUMP lifts player 0 off the floor"
            ((Ylos3dWasmGameTest.spriteY(host 10)) < p0rest))
        host.bridge.input.setAction(0 "jump" false)
        Ylos3dWasmGameTest.stepN(host 70)
        t.near("player 0 lands back on the floor after the jump"
            (Ylos3dWasmGameTest.spriteY(host 10)) 1811.0)

        ; ---- input: RIGHT walks the player ----------------------------------
        host.bridge.input.setAction(0 "right" true)
        Ylos3dWasmGameTest.stepN(host 10)
        t.ok("holding RIGHT walks player 0 rightward"
            ((Ylos3dWasmGameTest.spriteX(host 10)) > p0x0))
        host.bridge.input.setAction(0 "right" false)

        ; ---- enemies patrol (enemy 0 sprite is placed on its platform) ------
        t.ok("enemy 0 is seated in the world (not hidden)"
            ((Ylos3dWasmGameTest.spriteY(host 40)) > 0.0))

        ; ---- present: the split-screen world rasterises ---------------------
        def fb:RgFramebuffer (RgFramebuffer.create(240 270))
        def drawn:int (Rg2DPresenter.presentTextured(host.bridge 0 fb 0))
        t.ok("pane 0 composites the world (sprites drawn)" (drawn >= 1))
        t.ok("the world rendered (sky/platforms/player fill the pane)"
            ((Ylos3dWasmGameTest.nonClear(fb 240 270)) > 0))
        t.eqInt("no bridge errors across the whole run" host.bridge.errorCount 0)

        t.summary()
    }
}

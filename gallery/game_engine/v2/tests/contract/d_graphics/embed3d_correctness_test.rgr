; ==============================================================================
; embed3d_correctness_test — PR review gates for PLAN_2D_EMBED_3D path A.
; ==============================================================================
; Covers: typed 3D handle rejection, no RTT re-run at present, black geometry
; survives (not chroma-keyed), recycled sprite payloads fully reset.
; ==============================================================================

Import "../../../interp/engine/RgRegistryBridge.rgr"
Import "../../../runtime/game_host/RgComposePresenter.rgr"
Import "../../harness/RgTest.rgr"

class Embed3dCorrectnessTest {
    fn num:EvHandle (n:double) { return (EvHandle.number(n)) }
    fn str:EvHandle (s:string) { return (EvHandle.string(s)) }

    fn callI:int (b:RgRegistryBridge name:string args:[EvHandle]) {
        def r:EvHandle (b.invoke(name args))
        return (to_int r.numberValue)
    }

    sfn m@(main):void () {
        def t:RgTest (RgTest.forSuite("tests/contract/d_graphics/embed3d_correctness"))
        def s:Embed3dCorrectnessTest (new Embed3dCorrectnessTest)
        def empty:[EvHandle]

        ; ================= typed 3D handle rejection =========================
        def b:RgRegistryBridge (RgRegistryBridge.create())
        def sceneId:int (s.callI(b "rg3d_scene_create" empty))
        def camId:int (s.callI(b "rg3d_camera_create" empty))
        def geoA:[EvHandle]
        push geoA (s.num(1.0))
        def geoId:int (s.callI(b "rg3d_geometry_octahedron" geoA))
        def matA:[EvHandle]
        push matA (s.num(16711680.0))
        def matId:int (s.callI(b "rg3d_material_lambert" matA))
        def e0:int b.errorCount

        def badCam:[EvHandle]
        push badCam (s.num((to_double sceneId)))
        push badCam (s.num(35.0))
        push badCam (s.num(1.0))
        push badCam (s.num(0.1))
        push badCam (s.num(20.0))
        b.invoke("rg3d_camera_set" badCam)
        t.eqInt("camera_set rejects scene handle" b.errorCount (e0 + 1))
        t.ok("error names wrong-type:camera" ((indexOf b.lastError "wrong-type:camera") >= 0))

        def badXf:[EvHandle]
        push badXf (s.num((to_double matId)))
        push badXf (s.num(0.0))
        push badXf (s.num(0.0))
        push badXf (s.num(0.0))
        push badXf (s.num(0.0))
        push badXf (s.num(0.0))
        push badXf (s.num(0.0))
        b.invoke("rg3d_mesh_transform" badXf)
        t.eqInt("mesh_transform rejects material handle" b.errorCount (e0 + 2))
        t.ok("error names wrong-type:mesh" ((indexOf b.lastError "wrong-type:mesh") >= 0))

        ; D-SYNC: mesh_create is now DETACHED (geo, mat) — no scene arg. Still a
        ; typed bad-handle guard: a camera handle where geometry is expected.
        def badMesh:[EvHandle]
        push badMesh (s.num((to_double camId)))
        push badMesh (s.num((to_double matId)))
        b.invoke("rg3d_mesh_create" badMesh)
        t.eqInt("mesh_create rejects camera as geometry" b.errorCount (e0 + 3))
        t.ok("error names wrong-type:geometry" ((indexOf b.lastError "wrong-type:geometry") >= 0))

        ; D-SYNC: light_ambient is now DETACHED (color, intensity) — no handle arg,
        ; so the old bad-scene-handle case is impossible. Repurpose the negative
        ; coverage onto rg3d_entity_set_parent, which still takes handles: a
        ; geometry handle where a child ENTITY (mesh) is expected must raise the
        ; same typed bad-handle error, preserving the suite's negative-path delta.
        def badParent:[EvHandle]
        push badParent (s.num((to_double geoId)))
        push badParent (s.num((to_double sceneId)))
        b.invoke("rg3d_entity_set_parent" badParent)
        t.eqInt("entity_set_parent rejects geometry as child" b.errorCount (e0 + 4))
        t.ok("error names wrong-type:mesh" ((indexOf b.lastError "wrong-type:mesh") >= 0))

        def badOp:[EvHandle]
        push badOp (s.num((to_double sceneId)))
        push badOp (s.num(0.5))
        b.invoke("rg3d_material_set_opacity" badOp)
        t.eqInt("set_opacity rejects scene handle" b.errorCount (e0 + 5))

        ; ================= no RTT re-run at present ==========================
        def b2:RgRegistryBridge (RgRegistryBridge.create())
        def layA:[EvHandle]
        push layA (s.num(0.0))
        b2.invoke("rgcore_surface_set_layout" layA)
        def rtA:[EvHandle]
        push rtA (s.num(16.0))
        push rtA (s.num(16.0))
        def texId:int (s.callI(b2 "rgcore_graphics_rt_create" rtA))
        def sc2:int (s.callI(b2 "rg3d_scene_create" empty))
        def c2:int (s.callI(b2 "rg3d_camera_create" empty))
        def cs:[EvHandle]
        push cs (s.num((to_double c2)))
        push cs (s.num(35.0))
        push cs (s.num(1.0))
        push cs (s.num(0.1))
        push cs (s.num(20.0))
        b2.invoke("rg3d_camera_set" cs)
        def cp:[EvHandle]
        push cp (s.num((to_double c2)))
        push cp (s.num(0.0))
        push cp (s.num(0.0))
        push cp (s.num(3.0))
        push cp (s.num(0.0))
        push cp (s.num(0.0))
        push cp (s.num(0.0))
        b2.invoke("rg3d_camera_pose" cp)
        def boxA:[EvHandle]
        push boxA (s.num(1.0))
        push boxA (s.num(1.0))
        push boxA (s.num(1.0))
        def boxG:int (s.callI(b2 "rg3d_geometry_box" boxA))
        def m2A:[EvHandle]
        push m2A (s.num(255.0))
        def m2:int (s.callI(b2 "rg3d_material_basic" m2A))
        ; D-SYNC: detached create + explicit membership == old fused scene graph.
        def meshA:[EvHandle]
        push meshA (s.num((to_double boxG)))
        push meshA (s.num((to_double m2)))
        def mesh2:int (s.callI(b2 "rg3d_mesh_create" meshA))
        def par2:[EvHandle]
        push par2 (s.num((to_double mesh2)))
        push par2 (s.num((to_double sc2)))
        b2.invoke("rg3d_entity_set_parent" par2)
        def before:int b2.d3.rttCount
        def rttA:[EvHandle]
        push rttA (s.num((to_double sc2)))
        push rttA (s.num((to_double c2)))
        push rttA (s.num((to_double texId)))
        push rttA (s.num(16.0))
        push rttA (s.num(16.0))
        b2.invoke("rg3d_render_to" rttA)
        t.eqInt("rtt executed once at record" b2.d3.rttCount (before + 1))
        def afterRecord:int b2.d3.rttCount
        def fb:RgFramebuffer (RgFramebuffer.create(32 32))
        RgComposePresenter.presentPane(b2 0 fb 0)
        RgComposePresenter.presentPane(b2 0 fb 0)
        t.eqInt("present does not re-run RTT" b2.d3.rttCount afterRecord)

        ; ================= black geometry is not chroma-keyed ================
        def b3:RgRegistryBridge (RgRegistryBridge.create())
        def rt3A:[EvHandle]
        push rt3A (s.num(16.0))
        push rt3A (s.num(16.0))
        def tex3:int (s.callI(b3 "rgcore_graphics_rt_create" rt3A))
        def sc3:int (s.callI(b3 "rg3d_scene_create" empty))
        def c3:int (s.callI(b3 "rg3d_camera_create" empty))
        def cs3:[EvHandle]
        push cs3 (s.num((to_double c3)))
        push cs3 (s.num(35.0))
        push cs3 (s.num(1.0))
        push cs3 (s.num(0.1))
        push cs3 (s.num(20.0))
        b3.invoke("rg3d_camera_set" cs3)
        def cp3:[EvHandle]
        push cp3 (s.num((to_double c3)))
        push cp3 (s.num(0.0))
        push cp3 (s.num(0.0))
        push cp3 (s.num(2.5))
        push cp3 (s.num(0.0))
        push cp3 (s.num(0.0))
        push cp3 (s.num(0.0))
        b3.invoke("rg3d_camera_pose" cp3)
        def box3A:[EvHandle]
        push box3A (s.num(1.2))
        push box3A (s.num(1.2))
        push box3A (s.num(1.2))
        def box3:int (s.callI(b3 "rg3d_geometry_box" box3A))
        def mat3A:[EvHandle]
        push mat3A (s.num(0.0))
        def mat3:int (s.callI(b3 "rg3d_material_basic" mat3A))
        ; D-SYNC: detached create + explicit membership == old fused scene graph.
        def mesh3A:[EvHandle]
        push mesh3A (s.num((to_double box3)))
        push mesh3A (s.num((to_double mat3)))
        def mesh3:int (s.callI(b3 "rg3d_mesh_create" mesh3A))
        def par3:[EvHandle]
        push par3 (s.num((to_double mesh3)))
        push par3 (s.num((to_double sc3)))
        b3.invoke("rg3d_entity_set_parent" par3)
        def rtt3:[EvHandle]
        push rtt3 (s.num((to_double sc3)))
        push rtt3 (s.num((to_double c3)))
        push rtt3 (s.num((to_double tex3)))
        push rtt3 (s.num(16.0))
        push rtt3 (s.num(16.0))
        b3.invoke("rg3d_render_to" rtt3)
        def texH:RgHandle (b3.resolveGuestId(tex3))
        def midA:int (b3.d2.texelA(texH 8 8))
        def midRGB:int (b3.d2.texelRGB(texH 8 8))
        t.ok("black box centre has coverage alpha" (midA > 0))
        t.eqInt("black box centre RGB is black" midRGB 0)

        ; ================= recycled sprite payload reset =====================
        def b4:RgRegistryBridge (RgRegistryBridge.create())
        def tex4A:[EvHandle]
        push tex4A (s.num(4.0))
        push tex4A (s.num(4.0))
        def tex4:int (s.callI(b4 "rgcore_graphics_rt_create" tex4A))
        def atA:[EvHandle]
        push atA (s.num((to_double tex4)))
        def atlas:int (s.callI(b4 "rg2d_atlas_create" atA))
        def rgArgs:[EvHandle]
        push rgArgs (s.num((to_double atlas)))
        push rgArgs (s.str("cell"))
        push rgArgs (s.num(0.0))
        push rgArgs (s.num(0.0))
        push rgArgs (s.num(2.0))
        push rgArgs (s.num(2.0))
        def reg:int (s.callI(b4 "rg2d_atlas_add_region" rgArgs))
        def spA:[EvHandle]
        push spA (s.num((to_double atlas)))
        push spA (s.num((to_double reg)))
        def spr1:int (s.callI(b4 "rg2d_sprite_create" spA))
        def szA:[EvHandle]
        push szA (s.num((to_double spr1)))
        push szA (s.num(40.0))
        push szA (s.num(50.0))
        b4.invoke("rg2d_sprite_set_size" szA)
        def zA:[EvHandle]
        push zA (s.num((to_double spr1)))
        push zA (s.num(10.0))
        b4.invoke("rg2d_sprite_set_z" zA)
        def fxA:[EvHandle]
        push fxA (s.num((to_double spr1)))
        push fxA (s.num(1.0))
        b4.invoke("rg2d_sprite_set_flip" fxA)
        def paneA:[EvHandle]
        push paneA (s.num((to_double spr1)))
        push paneA (s.num(1.0))
        b4.invoke("rg2d_sprite_set_pane" paneA)
        def relA:[EvHandle]
        push relA (s.num((to_double spr1)))
        b4.invoke("rg2d_sprite_release" relA)
        def texSpA:[EvHandle]
        push texSpA (s.num((to_double tex4)))
        def spr2:int (s.callI(b4 "rg2d_sprite_create_tex" texSpA))
        def spH:RgHandle (b4.resolveGuestId(spr2))
        t.eqInt("recycled sprite z reset" (b4.d2.spriteZ(spH)) 0)
        t.no("recycled sprite flipX reset" (b4.d2.spriteFlipX(spH)))
        t.eqInt("recycled sprite paneOwner reset" (b4.d2.spritePaneOwner(spH)) (0 - 1))
        t.near("recycled sprite w reset" (b4.d2.spriteW(spH)) 0.0)
        t.near("recycled sprite h reset" (b4.d2.spriteH(spH)) 0.0)

        t.summary()
    }
}

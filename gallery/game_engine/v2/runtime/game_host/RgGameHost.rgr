; ==============================================================================
; RgGameHost — the single generic host for interpreted v2 ranger2d TSX games.
; ==============================================================================
; (Scope stated exactly, per design review: generic across games on this
; protocol and the interpreter profile — not yet across compiled/WASM guests;
; that arrives with the BRIDGES.md rev-2 profiles.)
;
; A game is a folder of TSX content and nothing else — no per-game .rgr shell
; may exist. The host knows the LIFECYCLE protocol, never a game:
;
;   guest exports     init() · update(props{dtMs})
;   presentation      none here — the guest declares pane views ONCE via
;                     rgcore_surface_pane_view (real handles in host pane
;                     state); Rg2DPresenter reads that state (renderer choice
;                     lives there, keeping this host backend-agnostic)
;   demo input        none here — RgAttractDriver is the optional out-of-band
;                     driver for guests that export autopilotBits
;   capabilities      everything else via ranger:2d / ranger:core
;
; Lifecycle: load(dir,file) evaluates façade+game and calls init(); frame(dt)
; runs one host-owned pipeline tick (update → frame boundary). A guest
; `launch(path)` request is honoured generically: teardown (D-OWN backstop),
; then the requested game folder loads in a fresh realm.
;
; The ranger2d.tsx façade is the standard guest prelude until the generated
; wrapper replaces it (BRIDGES.md §2.6 / step 6).
; ==============================================================================

Import "../../interp/engine/RgRegistryBridge.rgr"

class RgGameHost {
    def engine:ComponentEngine (new ComponentEngine())
    def bridge:RgRegistryBridge (RgRegistryBridge.create())
    def loaded:boolean false
    def v2Root:string "gallery/game_engine/v2"

    ; ---- guest calls (protocol only — no game knowledge) --------------------
    fn callSlot:double (name:string slot:int) {
        def r:EvalValue (this.engine.callFunction(name (EvalValue.number((to_double slot)))))
        return r.numberValue
    }

    ; ---- load ---------------------------------------------------------------
    ; No source concatenation: the host registers the virtual `ranger:*`
    ; packages (guest-side sources under modules/) and evaluates the game file
    ; ONLY. Dependencies are explicit — a game that does not import ranger:2d
    ; has no Sprite2D. Lifecycle runs through the ranger:core entry points
    ; (`runtime.start(game)` → __rgGameInit / __rgGameUpdate).
    fn load:boolean (dir:string file:string) {
        this.engine = (new ComponentEngine())
        this.engine.quiet = true
        this.bridge = (RgRegistryBridge.create())
        this.engine.setNativeBridge(this.bridge)
        def coreDir:string (this.v2Root + "/modules/ranger_core")
        def coreSrc:buffer (buffer_read_file coreDir "ranger_core.tsx")
        this.engine.registerVirtualModule("ranger:core" (buffer_to_string coreSrc))
        def twoDir:string (this.v2Root + "/modules/ranger_2d")
        def twoSrc:buffer (buffer_read_file twoDir "ranger_2d.tsx")
        this.engine.registerVirtualModule("ranger:2d" (buffer_to_string twoSrc))
        ; Opt-in 3D package (PLAN H3) — games that do not import ranger:three
        ; never touch the Three host arena.
        def threeDir:string (this.v2Root + "/modules/ranger_three")
        def threeSrc:buffer (buffer_read_file threeDir "ranger_three.tsx")
        this.engine.registerVirtualModule("ranger:three" (buffer_to_string threeSrc))
        this.bridge.packageDir = dir
        def game:buffer (buffer_read_file dir file)
        this.engine.loadScript((buffer_to_string game))
        def initR:EvalValue (this.engine.callFunction("__rgGameInit" (EvalValue.null())))
        this.loaded = (this.bridge.errorCount == 0)
        if (initR.numberValue < 0.5) { this.loaded = false }
        return this.loaded
    }

    ; ---- frame pipeline -----------------------------------------------------
    fn frame:void (dtMs:double) {
        ; Clear the global pass list at the update boundary (PLAN D2).
        this.bridge.clearPasses()
        def keys:[string]
        push keys "dtMs"
        def vals:[EvalValue]
        push vals (EvalValue.number(dtMs))
        this.engine.callFunction("__rgGameUpdate" (EvalValue.object(keys vals)))
        this.bridge.frameBoundary((dtMs / 1000.0))
    }

    ; one discrete edge press for a player action (menus): down → frame (guest
    ; sees the wasPressed edge; boundary clears it) → up → settle frame
    fn press:void (slot:int action:string) {
        this.bridge.input.setAction(slot action true)
        this.frame(33.333)
        this.bridge.input.setAction(slot action false)
        this.frame(33.333)
    }

    ; Load a guest-side TEST FIXTURE into the current realm (rule 5 door):
    ; fixtures live under <package>/tests/ and run through this host only.
    fn loadFixture:boolean (dir:string file:string) {
        def src:buffer (buffer_read_file dir file)
        def txt:string (buffer_to_string src)
        if ((strlen txt) == 0) { return false }
        this.engine.loadAdditionalScript(txt)
        return true
    }

    ; ---- launch handoff (generic) -------------------------------------------
    fn launchRequest:string () {
        return this.bridge.launchRequest
    }

    ; Honour a guest launch(path) request: tear the current realm down and load
    ; `<v2Root>/<path>/index.tsx` in a fresh realm. Returns false if no request
    ; is pending or the load fails.
    fn loadLaunched:boolean () {
        def path:string this.bridge.launchRequest
        if (path == "") { return false }
        this.bridge.teardown()
        def gameDir:string (this.v2Root + ("/" + path))
        return (this.load(gameDir "index.tsx"))
    }
}

; ==============================================================================
; web_mesh_editor_host — Ranger Three preview host for the spline mesh editor.
; ==============================================================================
; Supports multi-part lathe meshes (one part per profile segment) with per-part
; colour, shininess (from roughness), opacity, reflectivity (metalness), and an
; optional RGBA texture map (gradient / procedural / upload).
;
; V2 TRANSPORT: every resource create and scene mutation goes through the ONE
; live transport — RgRegistryBridge.invoke(rg3d_*) → RgRangerThree → typed host
; arenas — exactly like a TSX or wasm32 guest. This host holds only guest ids
; (the ints the bridge mints); it never touches ThreeSceneHost's arrays.
;
;   editor JS ──▶ WebMeshEditorHost ──▶ RgRegistryBridge.invoke("rg3d_*")
;                                            │
;                                            ▼
;                                      RgRangerThree ──▶ typed arenas
;                                            │
;                        ThreeSceneHost.render (presentation READS host state)
;
; Two seams deliberately read the arena directly rather than issue commands,
; matching web/web_live3d_host.rgr:
;   * present  — render + raw() pixel readback (a renderer reads host state;
;                per AGENTS.md that is not a sync boundary)
;   * view get — camera/target/fov the JS surface-picker needs, plus the orbit
;                distance clamp, which has no command
; ==============================================================================

Import "../../interp/engine/RgRegistryBridge.rgr"
Import "../../three/port/src/three_gl_backend.rgr"

class WebMeshEditorHost {
    def bridge:RgRegistryBridge (RgRegistryBridge.create())
    def gl:ThreeGLBackend (new ThreeGLBackend)
    def useGL:boolean false
    def ready:boolean false
    def w:int 480
    def h:int 480
    ; Guest ids minted by the bridge — NOT ThreeSceneHost indices.
    def sceneId:int 0
    def camId:int 0
    def orbitId:int 0
    def meshIds:[int]
    ; Material per part, so a hot atlas swap can re-map every live part.
    def matIds:[int]
    def matMode:int 3
    def autoRotate:boolean false
    def angle:double 0.0
    def outBuf:buffer (buffer_alloc 0)
    def lastMatId:int 0
    ; Shared RGBA atlas for the current beginParts batch (set once, applied per part).
    def partMapRgba:[int]
    def partMapW:int 0
    def partMapH:int 0
    def hasPartMap:boolean false

    ; ---- bridge helpers ------------------------------------------------------
    fn num:EvHandle (n:double) {
        return (EvHandle.number(n))
    }
    fn callN:EvHandle (name:string args:[EvHandle]) {
        return (this.bridge.invoke(name args))
    }
    fn callI:int (name:string args:[EvHandle]) {
        def r:EvHandle (this.bridge.invoke(name args))
        return (to_int r.numberValue)
    }
    fn intsToEval:EvHandle (src:[int]) {
        def out:[EvHandle]
        def n:int (array_length src)
        def i:int 0
        while (i < n) {
            push out (EvHandle.number((to_double (itemAt src i))))
            i = (i + 1)
        }
        return (EvHandle.array(out))
    }

    fn setupGL:boolean (canvasId:string) {
        def ok:boolean (gl.init(canvasId))
        if (ok == false) {
            useGL = false
            return false
        }
        ; Presentation backend selection — a renderer concern, not a command.
        this.bridge.d3.host.useBackend(gl)
        useGL = true
        return true
    }

    fn init:void (winW:int winH:int) {
        w = winW
        h = winH
        def empty:[EvHandle]
        sceneId = (this.callI("rg3d_scene_create" empty))
        def bgA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double sceneId)))
            (this.num(0.12))
            (this.num(0.13))
            (this.num(0.16))
        ))
        this.callN("rg3d_scene_background" bgA)

        def empty2:[EvHandle]
        camId = (this.callI("rg3d_camera_create" empty2))
        def csA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double camId)))
            (this.num(45.0))
            (this.num(((to_double w) / (to_double h))))
            (this.num(0.1))
            (this.num(100.0))
        ))
        this.callN("rg3d_camera_set" csA)
        def cpA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double camId)))
            (this.num(2.6))
            (this.num(1.4))
            (this.num(3.2))
            (this.num(0.0))
            (this.num(0.0))
            (this.num(0.0))
        ))
        this.callN("rg3d_camera_pose" cpA)

        ; D-SYNC: lights are DETACHED creates; membership is a separate op.
        def ambA:[EvHandle] ([] _:EvHandle (
            (this.num(16777215.0))
            (this.num(0.4))
        ))
        def ambId:int (this.callI("rg3d_light_ambient" ambA))
        def ambP:[EvHandle] ([] _:EvHandle (
            (this.num((to_double ambId)))
            (this.num((to_double sceneId)))
        ))
        this.callN("rg3d_entity_set_parent" ambP)

        def dirA:[EvHandle] ([] _:EvHandle (
            (this.num(16777215.0))
            (this.num(1.2))
            (this.num(0.45))
            (this.num(0.85))
            (this.num(0.35))
        ))
        def dirId:int (this.callI("rg3d_light_directional" dirA))
        def dirP:[EvHandle] ([] _:EvHandle (
            (this.num((to_double dirId)))
            (this.num((to_double sceneId)))
        ))
        this.callN("rg3d_entity_set_parent" dirP)

        def ocA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double camId)))
        ))
        orbitId = (this.callI("rg3d_orbit_create" ocA))
        def ovA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double orbitId)))
            (this.num((to_double w)))
            (this.num((to_double h)))
        ))
        this.callN("rg3d_orbit_viewport" ovA)
        def otA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double orbitId)))
            (this.num(0.0))
            (this.num(0.0))
            (this.num(0.0))
        ))
        this.callN("rg3d_orbit_target" otA)
        ; No command for the zoom clamp — set it on the arena's controller.
        ; Bind to a local first: a statement headed by a parenthesised call
        ; receiver — `(this.controls()).setX(...)` — makes the compiler DROP the
        ; rest of the method body silently (no error, truncated output).
        def oc:ThreeOrbitControls (this.controls())
        oc.setDistanceRange(1.2 20.0)
        def oaA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double orbitId)))
        ))
        this.callN("rg3d_orbit_apply" oaA)
        ready = true
    }

    ; Arena-side orbit controller: read-only view state + the distance clamp.
    fn controls:ThreeOrbitControls () {
        def oh:RgHandle (this.bridge.resolveGuestId(orbitId))
        def oc:int (this.bridge.d3.orbitH(oh))
        return (this.bridge.d3.host.orbitAt(oc))
    }

    fn clearParts:void () {
        def i:int 0
        while (i < (array_length meshIds)) {
            def mid:int (itemAt meshIds i)
            if (mid > 0) {
                def rA:[EvHandle] ([] _:EvHandle (
                    (this.num((to_double sceneId)))
                    (this.num((to_double mid)))
                ))
                this.callN("rg3d_entity_remove" rA)
            }
            i = (i + 1)
        }
        clear meshIds
        clear matIds
    }

    ; Build a Phong material tinted by colourHex; shininess/opacity/reflectivity
    ; come from the segment style. matMode 0 forces wireframe basic.
    fn buildPartMaterial:int (colorHex:int shininess:double opacity:double reflectivity:double) {
        def side:int 2
        def mid:int 0
        if (matMode == 0) {
            def wbA:[EvHandle] ([] _:EvHandle (
                (this.num((to_double colorHex)))
                (this.num((to_double side)))
                (this.num(1.0))
            ))
            mid = (this.callI("rg3d_material_basic_ex" wbA))
        } {
            def flat:int 0
            if (matMode == 1) {
                flat = 1
            }
            def phA:[EvHandle] ([] _:EvHandle (
                (this.num((to_double colorHex)))
                (this.num(4210752.0))
                (this.num(shininess))
                (this.num((to_double flat)))
                (this.num((to_double side)))
            ))
            mid = (this.callI("rg3d_material_phong_ex" phA))
        }
        def opA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double mid)))
            (this.num(opacity))
        ))
        this.callN("rg3d_material_set_opacity" opA)
        if (matMode != 0) {
            if ((reflectivity > 0.05) || (matMode == 4)) {
                def r:double reflectivity
                if (matMode == 4) {
                    if (r < 0.5) {
                        r = 0.85
                    }
                }
                def rfA:[EvHandle] ([] _:EvHandle (
                    (this.num((to_double mid)))
                    (this.num(r))
                ))
                this.callN("rg3d_material_reflective" rfA)
                def seA:[EvHandle] ([] _:EvHandle (
                    (this.num((to_double sceneId)))
                    (this.num(64.0))
                ))
                this.callN("rg3d_scene_environment_studio" seA)
            }
        }
        return mid
    }

    ; Interleave the separate attribute arrays into the ONE vertex buffer the
    ; rg3d_geometry_buffer command takes (8 doubles/vertex).
    fn interleave:[double] (positions:[double] normals:[double] uvs:[double]) {
        def out:[double]
        def vc:int (idiv (array_length positions) 3)
        def nLen:int (array_length normals)
        def uLen:int (array_length uvs)
        def i:int 0
        while (i < vc) {
            def b:int (i * 3)
            def ub:int (i * 2)
            push out (itemAt positions b)
            push out (itemAt positions (b + 1))
            push out (itemAt positions (b + 2))
            if ((b + 2) < nLen) {
                push out (itemAt normals b)
                push out (itemAt normals (b + 1))
                push out (itemAt normals (b + 2))
            } {
                push out 0.0
                push out 1.0
                push out 0.0
            }
            if ((ub + 1) < uLen) {
                push out (itemAt uvs ub)
                push out (itemAt uvs (ub + 1))
            } {
                push out 0.0
                push out 0.0
            }
            i = (i + 1)
        }
        return out
    }

    fn bufferToInts:[int] (buf:buffer n:int) {
        def out:[int]
        def i:int 0
        while (i < n) {
            push out (buffer_get buf i)
            i = (i + 1)
        }
        return out
    }

    ; Clear the shared part map (call from beginParts / when switching atlases).
    fn clearPartMap:void () {
        hasPartMap = false
        clear partMapRgba
        partMapW = 0
        partMapH = 0
    }

    ; Re-apply the staged atlas to every material already built in this batch.
    ;
    ; The direct-Three host kept ONE mutable ThreeTexture and handed the same
    ; instance to every part, so replacing its pixels retroactively changed all
    ; parts and the batch always showed the LAST atlas uploaded. UVs are global
    ; across the whole profile (v = row / rows-1), so that shared atlas is what
    ; makes a multi-part gradient continuous. A command API mints a texture per
    ; material instead, which would give each part its own atlas sampled through
    ; global UVs — a visible seam at every segment boundary. Re-applying keeps
    ; the original, intended behaviour over the transport.
    fn remapParts:void () {
        def i:int 0
        while (i < (array_length matIds)) {
            this.applyPartMap((itemAt matIds i))
            i = (i + 1)
        }
    }

    ; Stage the shared atlas for this batch (and refresh parts already added).
    fn setPartMapBuffer:void (rgba:buffer mw:int mh:int) {
        def need:int ((mw * mh) * 4)
        partMapRgba = (this.bufferToInts(rgba need))
        partMapW = mw
        partMapH = mh
        hasPartMap = true
        this.remapParts()
    }

    ; Hot-swap atlas pixels without beginParts / addPart (geometry stays).
    fn updatePartMapBuffer:void (rgba:buffer mw:int mh:int) {
        this.setPartMapBuffer(rgba mw mh)
    }

    ; Legacy: convert [int]/Uint8-like arrays into the shared part map.
    fn setPartMap:void (bytes:[int] mw:int mh:int) {
        partMapRgba = bytes
        partMapW = mw
        partMapH = mh
        hasPartMap = true
        this.remapParts()
    }

    fn applyPartMap:void (matId:int) {
        if (hasPartMap == false) {
            return
        }
        if ((array_length partMapRgba) < ((partMapW * partMapH) * 4)) {
            return
        }
        def mA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double matId)))
            (this.intsToEval(partMapRgba))
            (this.num((to_double partMapW)))
            (this.num((to_double partMapH)))
        ))
        this.callN("rg3d_material_map_rgba" mA)
    }

    ; Add one lathed segment. Prefer hasPartMap when set; else mapBytes non-empty.
    fn addPart:void (positions:[double] normals:[double] uvs:[double] indices:[int] colorHex:int shininess:double opacity:double reflectivity:double mapBytes:[int] mapW:int mapH:int) {
        if (ready == false) {
            return
        }
        def vtx:[double] (this.interleave(positions normals uvs))
        def vArr:[EvHandle]
        def vn:int (array_length vtx)
        def vi:int 0
        while (vi < vn) {
            push vArr (EvHandle.number((itemAt vtx vi)))
            vi = (vi + 1)
        }
        def gA:[EvHandle] ([] _:EvHandle (
            (EvHandle.array(vArr))
            (this.intsToEval(indices))
        ))
        def geoId:int (this.callI("rg3d_geometry_buffer" gA))

        def matId:int (this.buildPartMaterial(colorHex shininess opacity reflectivity))
        if (hasPartMap) {
            this.applyPartMap(matId)
        } {
            if (((array_length mapBytes) > 0) && (mapW > 0) && (mapH > 0)) {
                def mA:[EvHandle] ([] _:EvHandle (
                    (this.num((to_double matId)))
                    (this.intsToEval(mapBytes))
                    (this.num((to_double mapW)))
                    (this.num((to_double mapH)))
                ))
                this.callN("rg3d_material_map_rgba" mA)
            }
        }
        lastMatId = matId

        ; D-SYNC: DETACHED mesh create, then membership as a separate op.
        def mcA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double geoId)))
            (this.num((to_double matId)))
        ))
        def meshId:int (this.callI("rg3d_mesh_create" mcA))
        def spA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double meshId)))
            (this.num((to_double sceneId)))
        ))
        this.callN("rg3d_entity_set_parent" spA)
        this.transformPart(meshId)
        push meshIds meshId
        push matIds matId
    }

    fn transformPart:void (meshId:int) {
        def tA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double meshId)))
            (this.num(0.0))
            (this.num(0.0))
            (this.num(0.0))
            (this.num(0.12))
            (this.num(angle))
            (this.num(0.0))
        ))
        this.callN("rg3d_mesh_transform" tA)
    }

    fn beginParts:void () {
        this.clearParts()
        this.clearPartMap()
    }

    fn setMaterialMode:void (mode:int) {
        matMode = mode
    }

    ; Back-compat single-mesh path used by older callers.
    fn setMesh:void (positions:[double] normals:[double] uvs:[double] indices:[int]) {
        this.beginParts()
        def emptyMap:[int]
        this.addPart(positions normals uvs indices 12632256 220.0 1.0 0.0 emptyMap 0 0)
    }

    fn setAutoRotate:void (on:boolean) {
        ; Autorotate removed — always off so UV / assign picks stay stable.
        autoRotate = false
    }

    ; View state for JS surface picking (camera + mesh yaw/tilt).
    fn viewCamX:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.camX())
    }
    fn viewCamY:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.camY())
    }
    fn viewCamZ:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.camZ())
    }
    fn viewTargetX:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.getTargetX())
    }
    fn viewTargetY:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.getTargetY())
    }
    fn viewTargetZ:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.getTargetZ())
    }
    fn viewFov:double () {
        def oc:ThreeOrbitControls (this.controls())
        return (oc.getFov())
    }
    fn viewMeshAngle:double () {
        return angle
    }
    fn viewMeshTilt:double () {
        return 0.12
    }
    fn viewWidth:double () {
        return (to_double w)
    }
    fn viewHeight:double () {
        return (to_double h)
    }

    ; Pointer / wheel drive the controller through its commands (phase 0/1/2).
    fn orbitPointer:void (phase:int x:double y:double button:int) {
        def pA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double orbitId)))
            (this.num((to_double phase)))
            (this.num(x))
            (this.num(y))
            (this.num((to_double button)))
        ))
        this.callN("rg3d_orbit_pointer" pA)
    }
    fn pointerDown:void (x:double y:double button:int) {
        this.orbitPointer(0 x y button)
    }
    fn pointerMove:void (x:double y:double) {
        this.orbitPointer(1 x y 0)
    }
    fn pointerUp:void () {
        this.orbitPointer(2 0.0 0.0 0)
    }
    fn wheel:void (delta:double) {
        def wA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double orbitId)))
            (this.num(delta))
        ))
        this.callN("rg3d_orbit_wheel" wA)
    }

    fn frame:void (dtMs:double) {
        if (ready == false) {
            return
        }
        ; Keep mesh yaw/tilt fixed (no autorotate). Re-assert transform each frame
        ; so newly added parts stay aligned after beginParts/addPart.
        def i:int 0
        while (i < (array_length meshIds)) {
            this.transformPart((itemAt meshIds i))
            i = (i + 1)
        }
        def oaA:[EvHandle] ([] _:EvHandle (
            (this.num((to_double orbitId)))
        ))
        this.callN("rg3d_orbit_apply" oaA)

        ; ---- present: the renderer READS host state (not a sync boundary) ----
        def sh3:RgHandle (this.bridge.resolveGuestId(sceneId))
        def ch3:RgHandle (this.bridge.resolveGuestId(camId))
        def sceneIdx:int (this.bridge.d3.sceneH(sh3))
        def camIdx:int (this.bridge.d3.cameraH(ch3))
        if (useGL) {
            this.bridge.d3.host.render(sceneIdx camIdx w h)
            return
        }
        def sw:int (w * 2)
        def sh:int (h * 2)
        this.bridge.d3.host.renderer.setClearColor(0.12 0.13 0.16)
        this.bridge.d3.host.render(sceneIdx camIdx sw sh)
        def raw:buffer (this.bridge.d3.host.raw())
        def total:int ((w * h) * 3)
        def out:buffer (buffer_alloc total)
        def y:int 0
        while (y < h) {
            def x:int 0
            while (x < w) {
                def sumR:int 0
                def sumG:int 0
                def sumB:int 0
                def dy:int 0
                while (dy < 2) {
                    def dx:int 0
                    while (dx < 2) {
                        def sx:int ((x * 2) + dx)
                        def sy:int ((y * 2) + dy)
                        def o:int (((sy * sw) + sx) * 3)
                        sumR = (sumR + (buffer_get raw o))
                        sumG = (sumG + (buffer_get raw (o + 1)))
                        sumB = (sumB + (buffer_get raw (o + 2)))
                        dx = (dx + 1)
                    }
                    dy = (dy + 1)
                }
                def d:int (((y * w) + x) * 3)
                buffer_set out d (idiv sumR 4)
                buffer_set out (d + 1) (idiv sumG 4)
                buffer_set out (d + 2) (idiv sumB 4)
                x = (x + 1)
            }
            y = (y + 1)
        }
        outBuf = out
    }

    fn framePixels:buffer () {
        return outBuf
    }

    fn usingGL:boolean () {
        return useGL
    }

    fn partCount:int () {
        return (array_length meshIds)
    }
}

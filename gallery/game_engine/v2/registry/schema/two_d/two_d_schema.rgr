; ==============================================================================
; two_d_schema — authored registry rows for the `ranger:2d` module (D-REGISTRY).
; ==============================================================================
; DATA, not code: the declarative command surface of ranger:2d. Everything the
; bridge, the WASM import list, and the guest façade know about these commands
; derives from these rows (BRIDGES.md §2.1). Published ids are immutable:
;   classIds 20–29 · command ids 2000–2999   (golden-checked)
;
; argSpec: i=i32 d=f64 s=string h=handle ai=array<i32> ad=array<f64>
; retSpec: v void · i i32 · d f64 · h handle (create → guest id)
; ==============================================================================

Import "../RgSchema.rgr"

class TwoDSchema {
    sfn build:RgSchema () {
        def s:RgSchema (new RgSchema)

        ; ---- Texture2D (20) --------------------------------------------------
        def tex:RgClassDef (RgClassDef.of(20 "Texture2D"))
        tex.addMethod((RgMethodDef.cmd(2000 "rg2d_texture_create" "rg2d_texture_create" "i:i" "h" "create")))
        s.addClass(tex)

        ; ---- SpriteAtlas (21) — retains its texture (D-OWN) ------------------
        def atlas:RgClassDef (RgClassDef.of(21 "SpriteAtlas"))
        atlas.addMethod((RgMethodDef.cmd(2010 "rg2d_atlas_create" "rg2d_atlas_create" "h" "h" "create")))
        atlas.addMethod((RgMethodDef.cmd(2011 "rg2d_atlas_add_region" "rg2d_atlas_add_region" "h:s:i:i:i:i" "i" "none")))
        atlas.addMethod((RgMethodDef.cmd(2012 "rg2d_atlas_add_clip" "rg2d_atlas_add_clip" "h:s:ai:ad" "i" "none")))
        atlas.addMethod((RgMethodDef.cmd(2013 "rg2d_atlas_region_index" "rg2d_atlas_region_index" "h:s" "i" "none")))
        s.addClass(atlas)

        ; ---- Sprite2D (22) — retains its atlas; layer membership ≠ ownership -
        def sprite:RgClassDef (RgClassDef.of(22 "Sprite2D"))
        sprite.addProp((RgPropDef.of(2200 "position" "vec2"
            (RgResidency.host()) (RgOwnership.none()) true (RgSync.immediate()))))
        sprite.addProp((RgPropDef.of(2201 "region" "i32"
            (RgResidency.host()) (RgOwnership.none()) true (RgSync.immediate()))))
        sprite.addMethod((RgMethodDef.cmd(2020 "rg2d_sprite_create" "rg2d_sprite_create" "h:i" "h" "create")))
        sprite.addMethod((RgMethodDef.cmd(2021 "rg2d_sprite_set_pos" "rg2d_sprite_set_pos" "h:d:d" "v" "none")))
        sprite.addMethod((RgMethodDef.cmd(2022 "rg2d_sprite_set_region" "rg2d_sprite_set_region" "h:i" "v" "none")))
        sprite.addMethod((RgMethodDef.cmd(2023 "rg2d_sprite_release" "rg2d_sprite_release" "h" "i" "release")))
        ; destination extent / draw order / facing — the transform state a
        ; sampling backend needs beyond position (platform width, backgrounds,
        ; painter order, mirror). Native-region size when unset (w=h=0).
        sprite.addMethod((RgMethodDef.cmd(2024 "rg2d_sprite_set_size" "rg2d_sprite_set_size" "h:d:d" "v" "none")))
        sprite.addMethod((RgMethodDef.cmd(2025 "rg2d_sprite_set_z" "rg2d_sprite_set_z" "h:i" "v" "none")))
        sprite.addMethod((RgMethodDef.cmd(2026 "rg2d_sprite_set_flip" "rg2d_sprite_set_flip" "h:i" "v" "none")))
        ; spritesheet cell (col,row) — samples the atlas frame grid (v1 "sheet")
        sprite.addMethod((RgMethodDef.cmd(2027 "rg2d_sprite_set_cell" "rg2d_sprite_set_cell" "h:i:i" "v" "none")))
        ; split-screen pane ownership (-1 = all panes; >=0 = only that pane)
        sprite.addMethod((RgMethodDef.cmd(2028 "rg2d_sprite_set_pane" "rg2d_sprite_set_pane" "h:i" "v" "none")))
        ; Texture-backed sprite (PLAN_2D_EMBED_3D D10) — full TextureView2D
        sprite.addMethod((RgMethodDef.cmd(2029 "rg2d_sprite_create_tex" "rg2d_sprite_create_tex" "h" "h" "create")))
        s.addClass(sprite)

        ; ---- Layer2D (23) ----------------------------------------------------
        def layer:RgClassDef (RgClassDef.of(23 "Layer2D"))
        layer.addMethod((RgMethodDef.cmd(2030 "rg2d_layer_create" "rg2d_layer_create" "" "h" "create")))
        layer.addMethod((RgMethodDef.cmd(2031 "rg2d_layer_add" "rg2d_layer_add" "h:h" "v" "none")))
        layer.addMethod((RgMethodDef.cmd(2032 "rg2d_layer_remove" "rg2d_layer_remove" "h" "v" "none")))
        s.addClass(layer)

        ; ---- Camera2D (24) ---------------------------------------------------
        def cam:RgClassDef (RgClassDef.of(24 "Camera2D"))
        cam.addMethod((RgMethodDef.cmd(2040 "rg2d_camera_create" "rg2d_camera_create" "" "h" "create")))
        cam.addMethod((RgMethodDef.cmd(2041 "rg2d_camera_set" "rg2d_camera_set" "h:d:d:d:d" "v" "none")))
        cam.addMethod((RgMethodDef.cmd(2060 "rg2d_render" "rg2d_render" "h:h:i" "v" "none")))
        s.addClass(cam)

        ; ---- AnimationPlayer2D (25) — clocked by runtime.time ---------------
        def player:RgClassDef (RgClassDef.of(25 "AnimationPlayer2D"))
        player.addMethod((RgMethodDef.cmd(2050 "rg2d_player_create" "rg2d_player_create" "h:i" "h" "create")))
        player.addMethod((RgMethodDef.cmd(2051 "rg2d_player_frame_at" "rg2d_player_frame_at" "h:d" "i" "none")))
        s.addClass(player)

        ; ---- DrawList2D (26) — immediate world-space background primitives ---
        ; The static environment (sky gradient, 3-tone platforms, clouds, flag,
        ; bitmap glyphs) is painted every frame in world coords, rasterised by a
        ; backend through each pane's camera BEFORE the retained sprites. No
        ; persistent identity — the v1 createStaticBg / bgFillRect model.
        def draw:RgClassDef (RgClassDef.of(26 "DrawList2D"))
        draw.addMethod((RgMethodDef.cmd(2070 "rg2d_bg_begin" "rg2d_bg_begin" "" "v" "none")))
        draw.addMethod((RgMethodDef.cmd(2071 "rg2d_bg_rect" "rg2d_bg_rect" "d:d:d:d:i:i:i" "v" "none")))
        draw.addMethod((RgMethodDef.cmd(2072 "rg2d_bg_circle" "rg2d_bg_circle" "d:d:d:i:i:i" "v" "none")))
        ; screen-space overlay (HUD): normalised rects drawn AFTER the sprites,
        ; per pane, no camera transform. rg2d_ov_rect args are nx,ny,nw,nh in
        ; [0,1] + r,g,b + owning pane (-1 = all).
        draw.addMethod((RgMethodDef.cmd(2073 "rg2d_ov_begin" "rg2d_ov_begin" "" "v" "none")))
        draw.addMethod((RgMethodDef.cmd(2074 "rg2d_ov_rect" "rg2d_ov_rect" "d:d:d:d:i:i:i:i" "v" "none")))
        s.addClass(draw)

        return s
    }
}

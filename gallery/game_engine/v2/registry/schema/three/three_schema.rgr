; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; three_schema — authored registry rows for the `ranger:three` module.
; ==============================================================================
; Minimal live guest surface for PLAN_2D_EMBED_3D H3 (SW path A): scene, camera,
; box/octahedron geometry, basic/lambert materials (+ opacity), mesh, lights,
; package-relative .glb model load (game supplies the uri), and render-to-texture.
; No asset- or game-specific commands — games pass pkg:// paths.
; Published ids are immutable:
;   classIds 30–39 · command ids 3000–3999   (golden-checked)
; ==============================================================================

Import "../RgSchema.rgr"

class ThreeSchema {
    sfn build:RgSchema () {
        def s:RgSchema (new RgSchema)

        ; ---- Scene3D (30) ----------------------------------------------------
        def scene:RgClassDef (RgClassDef.of(30 "Scene3D"))
        scene.addMethod((RgMethodDef.cmd(3000 "rg3d_scene_create" "rg3d_scene_create" "" "h" "create")))
        ; Clear/background colour as linear rgb (0..1) — replaces per-title sky
        ; colours baked into a presenter (see TODO "abstraction boundary debt").
        scene.addMethod((RgMethodDef.cmd(3004 "rg3d_scene_background" "rg3d_scene_background" "h:d:d:d" "v" "none")))
        ; Generated studio environment probe, `size` cube face pixels. Needed by
        ; reflective materials; no asset, so it is a command not a resource load.
        scene.addMethod((RgMethodDef.cmd(3005 "rg3d_scene_environment_studio" "rg3d_scene_environment_studio" "h:i" "v" "none")))
        s.addClass(scene)

        ; ---- Camera3D (31) ---------------------------------------------------
        def cam:RgClassDef (RgClassDef.of(31 "Camera3D"))
        cam.addMethod((RgMethodDef.cmd(3001 "rg3d_camera_create" "rg3d_camera_create" "" "h" "create")))
        cam.addMethod((RgMethodDef.cmd(3002 "rg3d_camera_set" "rg3d_camera_set" "h:d:d:d:d" "v" "none")))
        cam.addMethod((RgMethodDef.cmd(3003 "rg3d_camera_pose" "rg3d_camera_pose" "h:d:d:d:d:d:d" "v" "none")))
        s.addClass(cam)

        ; ---- Geometry3D (32) -------------------------------------------------
        def geo:RgClassDef (RgClassDef.of(32 "Geometry3D"))
        geo.addMethod((RgMethodDef.cmd(3010 "rg3d_geometry_box" "rg3d_geometry_box" "d:d:d" "h" "create")))
        geo.addMethod((RgMethodDef.cmd(3011 "rg3d_geometry_octahedron" "rg3d_geometry_octahedron" "d" "h" "create")))
        ; Utah teapot resource. size(d), segments(i); the 5 part/shape booleans
        ; (bottom, lid, body, fitLid, blinn) are encoded as i32 0/1 (the argSpec
        ; alphabet is {i,d,s,h,ai,ad}; no bool code) and converted in dispatch.
        geo.addMethod((RgMethodDef.cmd(3012 "rg3d_geometry_teapot" "rg3d_geometry_teapot" "d:i:i:i:i:i:i" "h" "create")))
        ; Flat plane primitive (floor). width(d), height(d), then the segment
        ; counts wSeg(i), hSeg(i). A leaf resource, mirrors geometry_box.
        geo.addMethod((RgMethodDef.cmd(3013 "rg3d_geometry_plane" "rg3d_geometry_plane" "d:d:i:i" "h" "create")))
        ; Smooth UV sphere: radius(d), widthSegments(i), heightSegments(i).
        geo.addMethod((RgMethodDef.cmd(3014 "rg3d_geometry_sphere" "rg3d_geometry_sphere" "d:i:i" "h" "create")))
        ; Cylinder: radiusTop(d), radiusBottom(d), height(d), radialSegments(i).
        geo.addMethod((RgMethodDef.cmd(3015 "rg3d_geometry_cylinder" "rg3d_geometry_cylinder" "d:d:d:i" "h" "create")))
        ; AUTHORED geometry (vs the generators above): an interleaved vertex
        ; buffer + index list, for meshes a tool produced rather than a formula.
        ; `ad` packs 8 doubles per vertex — px,py,pz, nx,ny,nz, u,v — and `ai`
        ; is the index list. ONE ad + ONE ai on purpose: the generic decoder
        ; accumulates all `ad` args into a single span (as does `ai`), so two
        ; double arrays would silently concatenate. Interleaving is also the
        ; natural contiguous GPU/wasm32 form.
        geo.addMethod((RgMethodDef.cmd(3016 "rg3d_geometry_buffer" "rg3d_geometry_buffer" "ad:ai" "h" "create")))
        s.addClass(geo)

        ; ---- Material3D (33) -------------------------------------------------
        def mat:RgClassDef (RgClassDef.of(33 "Material3D"))
        mat.addMethod((RgMethodDef.cmd(3020 "rg3d_material_basic" "rg3d_material_basic" "i" "h" "create")))
        mat.addMethod((RgMethodDef.cmd(3021 "rg3d_material_lambert" "rg3d_material_lambert" "i" "h" "create")))
        mat.addMethod((RgMethodDef.cmd(3022 "rg3d_material_set_opacity" "rg3d_material_set_opacity" "h:d" "v" "none")))
        ; Phong (smooth-shaded, specular): colour(i), specularColour(i), shininess(d).
        mat.addMethod((RgMethodDef.cmd(3023 "rg3d_material_phong" "rg3d_material_phong" "i:i:d" "h" "create")))
        ; Diffuse texture map from a pkg-relative PNG (printed playfield art etc.).
        mat.addMethod((RgMethodDef.cmd(3024 "rg3d_material_map" "rg3d_material_map" "h:s" "v" "none")))
        ; --- authoring variants -------------------------------------------
        ; 3020/3023 are golden: their arg lists cannot grow (a "defaulted" param
        ; still breaks a compiled guest at instantiate). Wider forms therefore
        ; get NEW ids, which is additive and leaves old guests working.
        ; Basic with explicit side(i) and wireframe(i 0/1) — wireframe preview.
        mat.addMethod((RgMethodDef.cmd(3025 "rg3d_material_basic_ex" "rg3d_material_basic_ex" "i:i:i" "h" "create")))
        ; Phong with flatShading(i 0/1) and side(i) — faceted vs smooth preview.
        mat.addMethod((RgMethodDef.cmd(3026 "rg3d_material_phong_ex" "rg3d_material_phong_ex" "i:i:d:i:i" "h" "create")))
        ; Env-map reflectivity 0..1 (pairs with rg3d_scene_environment_studio).
        mat.addMethod((RgMethodDef.cmd(3027 "rg3d_material_reflective" "rg3d_material_reflective" "h:d" "v" "none")))
        ; Diffuse map from RAW RGBA bytes: material(h), pixels(ai), w(i), h(i).
        ; Sibling of 3024 for generated atlases that never exist as a file.
        mat.addMethod((RgMethodDef.cmd(3028 "rg3d_material_map_rgba" "rg3d_material_map_rgba" "h:ai:i:i" "v" "none")))
        s.addClass(mat)

        ; ---- Mesh3D (34) -----------------------------------------------------
        def mesh:RgClassDef (RgClassDef.of(34 "Mesh3D"))
        ; D-SYNC: DETACHED create — object lifetime is independent of scene
        ; membership. Args are (geo, mat); membership is established separately.
        mesh.addMethod((RgMethodDef.cmd(3030 "rg3d_mesh_create" "rg3d_mesh_create" "h:h" "h" "create")))
        mesh.addMethod((RgMethodDef.cmd(3031 "rg3d_mesh_transform" "rg3d_mesh_transform" "h:d:d:d:d:d:d" "v" "none")))
        mesh.addMethod((RgMethodDef.cmd(3032 "rg3d_mesh_set_scale" "rg3d_mesh_set_scale" "h:d:d:d" "v" "none")))
        ; D-SYNC: standalone membership — reparent an existing entity (child, parent).
        mesh.addMethod((RgMethodDef.cmd(3033 "rg3d_entity_set_parent" "rg3d_entity_set_parent" "h:h" "v" "none")))
        ; D-SYNC: detach membership ONLY (scene, entity) — do NOT destroy the object.
        mesh.addMethod((RgMethodDef.cmd(3034 "rg3d_entity_remove" "rg3d_entity_remove" "h:h" "v" "none")))
        ; D-SYNC: DETACHED create — a transform-only Group/Object3D node (no args,
        ; like scene_create). It is a first-class entity: usable as a child
        ; (scene.add(group)) and as a parent (group.add(mesh)).
        mesh.addMethod((RgMethodDef.cmd(3035 "rg3d_group_create" "rg3d_group_create" "" "h" "create")))
        s.addClass(mesh)

        ; ---- Renderer3D (35) — RTT into a Texture2D / RenderTarget ------------
        def ren:RgClassDef (RgClassDef.of(35 "Renderer3D"))
        ren.addMethod((RgMethodDef.cmd(3040 "rg3d_render_to" "rg3d_render_to" "h:h:h:i:i" "v" "none")))
        s.addClass(ren)

        ; ---- Light3D (36) — ambient + directional for SW Lambert -------------
        def light:RgClassDef (RgClassDef.of(36 "Light3D"))
        light.addMethod((RgMethodDef.cmd(3050 "rg3d_light_ambient" "rg3d_light_ambient" "i:d" "h" "create")))
        light.addMethod((RgMethodDef.cmd(3051 "rg3d_light_directional" "rg3d_light_directional" "i:d:d:d:d" "h" "create")))
        s.addClass(light)

        ; ---- Model3D (37) — package-relative .glb → scene entity --------------
        def model:RgClassDef (RgClassDef.of(37 "Model3D"))
        model.addMethod((RgMethodDef.cmd(3060 "rg3d_model_load" "rg3d_model_load" "s" "h" "create")))
        s.addClass(model)

        ; ---- OrbitControls3D (38) — spherical camera controller --------------
        ; Own decade (3070+): the "continue after group's 3035" range (3036..3041)
        ; would collide with rg3d_render_to (3040), so orbit takes the next free
        ; decade after model (3060), matching the one-class-per-decade layout.
        ; create binds to a camera (h→h); the rest drive the bound controller.
        def orbit:RgClassDef (RgClassDef.of(38 "OrbitControls3D"))
        orbit.addMethod((RgMethodDef.cmd(3070 "rg3d_orbit_create" "rg3d_orbit_create" "h" "h" "create")))
        orbit.addMethod((RgMethodDef.cmd(3071 "rg3d_orbit_viewport" "rg3d_orbit_viewport" "h:i:i" "v" "none")))
        orbit.addMethod((RgMethodDef.cmd(3072 "rg3d_orbit_target" "rg3d_orbit_target" "h:d:d:d" "v" "none")))
        ; pointer: (ctrl, phase i, x d, y d, button i). phase 0=down/1=move/2=up.
        orbit.addMethod((RgMethodDef.cmd(3073 "rg3d_orbit_pointer" "rg3d_orbit_pointer" "h:i:d:d:i" "v" "none")))
        orbit.addMethod((RgMethodDef.cmd(3074 "rg3d_orbit_wheel" "rg3d_orbit_wheel" "h:d" "v" "none")))
        orbit.addMethod((RgMethodDef.cmd(3075 "rg3d_orbit_apply" "rg3d_orbit_apply" "h" "v" "none")))
        s.addClass(orbit)

        return s
    }
}

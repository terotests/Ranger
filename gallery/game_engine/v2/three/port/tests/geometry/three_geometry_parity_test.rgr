; ==============================================================================
; three_geometry_parity_test — geometry parity, DRIVEN THROUGH THE INTERPRETER.
; ==============================================================================
; The unit test is a JS scene (three/tsx/geom/geom_probes.tsx) run by the TSX
; interpreter against the three.tsx façade. `new THREE.SphereGeometry(1,8,6)` in
; that script only carries the ARGS; ThreeTsxBridge reconciles it and the REAL
; geometry is constructed in the Ranger host (three_scene_host.geometry*), because
; the objects live in Ranger, not JS. We then read the real host geometry back and
; validate it against golden data from the real three.js (reference/geom_goldens.
; json): exact vertexCount / indexCount, bounding box, exact sample vertices, and
; render-free invariants (unit normals, in-range indices). No GPU involved.
; ==============================================================================

Import "../../tsx/three_tsx_bridge.rgr"
Import "../../src/three_json.rgr"
Import "../../../../interp/migrate/src/ComponentEngine.rgr"
Import "../../../../interp/migrate/src/EvalValue.rgr"

class GeomParityCheck {
    def passed:int 0
    def failed:int 0
    def golds:ThreeJsonValue (new ThreeJsonValue)

    fn boot:void () {
        def gbuf:buffer (buffer_read_file "gallery/game_engine/three/reference" "geom_goldens.json")
        def parser:ThreeJsonParser (new ThreeJsonParser)
        golds = (parser.parse((buffer_to_string gbuf)))
    }
    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }
    sfn near:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) { d = (0.0 - d) }
        return (d < 0.001)
    }

    ; render-free invariants that hold for every well-formed geometry
    fn invariants:void (label:string g:ThreeBufferGeometry) {
        def vc:int (g.vertexCount())
        def ic:int (g.indexCount())
        this.ok((label + " index is whole triangles") (((idiv ic 3) * 3) == ic))
        def idxOk:boolean true
        def k:int 0
        while (k < ic) {
            def vi:int (g.getIndex(k))
            if ((vi < 0) || (vi >= vc)) { idxOk = false }
            k = (k + 1)
        }
        this.ok((label + " all indices in range") idxOk)
        def nrmOk:boolean true
        def v:int 0
        while (v < vc) {
            def nx:double (g.getNormal(v 0))
            def ny:double (g.getNormal(v 1))
            def nz:double (g.getNormal(v 2))
            def nl:double (sqrt(((nx * nx) + (ny * ny)) + (nz * nz)))
            if (false == (GeomParityCheck.near(nl 1.0))) { nrmOk = false }
            v = (v + 1)
        }
        this.ok((label + " normals are unit length") nrmOk)
    }

    ; parity vs the golden for `key`; exactSamples=false for equivalent-but-
    ; different-order tessellations (the hand-written box), documented not faked.
    fn parity:void (key:string g:ThreeBufferGeometry exactSamples:boolean) {
        def gold:ThreeJsonValue (golds.get(key))
        this.ok((key + " vertexCount == " + (to_string (gold.intOr("vertexCount" (0 - 1))))) ((g.vertexCount()) == (gold.intOr("vertexCount" (0 - 1)))))
        this.ok((key + " indexCount == " + (to_string (gold.intOr("indexCount" (0 - 1))))) ((g.indexCount()) == (gold.intOr("indexCount" (0 - 1)))))

        def minx:double 1000000.0
        def miny:double 1000000.0
        def minz:double 1000000.0
        def maxx:double (0.0 - 1000000.0)
        def maxy:double (0.0 - 1000000.0)
        def maxz:double (0.0 - 1000000.0)
        def vc:int (g.vertexCount())
        def i:int 0
        while (i < vc) {
            def x:double (g.getPosition(i 0))
            def y:double (g.getPosition(i 1))
            def z:double (g.getPosition(i 2))
            if (x < minx) { minx = x }
            if (y < miny) { miny = y }
            if (z < minz) { minz = z }
            if (x > maxx) { maxx = x }
            if (y > maxy) { maxy = y }
            if (z > maxz) { maxz = z }
            i = (i + 1)
        }
        def bb:ThreeJsonValue (gold.get("bbox"))
        def bboxOk:boolean true
        if (false == (GeomParityCheck.near(minx (bb.numOr("minx" 0.0))))) { bboxOk = false }
        if (false == (GeomParityCheck.near(miny (bb.numOr("miny" 0.0))))) { bboxOk = false }
        if (false == (GeomParityCheck.near(minz (bb.numOr("minz" 0.0))))) { bboxOk = false }
        if (false == (GeomParityCheck.near(maxx (bb.numOr("maxx" 0.0))))) { bboxOk = false }
        if (false == (GeomParityCheck.near(maxy (bb.numOr("maxy" 0.0))))) { bboxOk = false }
        if (false == (GeomParityCheck.near(maxz (bb.numOr("maxz" 0.0))))) { bboxOk = false }
        this.ok((key + " bounding box matches three.js") bboxOk)

        if exactSamples {
            def samples:ThreeJsonValue (gold.get("samples"))
            def sampleOk:boolean true
            def si:int 0
            while (si < (samples.length())) {
                def sv:ThreeJsonValue (samples.at(si))
                def vi:int (sv.intOr("i" 0))
                if (false == (GeomParityCheck.near((g.getPosition(vi 0)) (sv.numOr("x" 0.0))))) { sampleOk = false }
                if (false == (GeomParityCheck.near((g.getPosition(vi 1)) (sv.numOr("y" 0.0))))) { sampleOk = false }
                if (false == (GeomParityCheck.near((g.getPosition(vi 2)) (sv.numOr("z" 0.0))))) { sampleOk = false }
                si = (si + 1)
            }
            this.ok((key + " sample vertices match three.js exactly") sampleOk)
        } {
            print ("  NOTE " + key + " equivalent tessellation, different vertex order (count+bbox checked)")
        }
    }

    ; validate host geometry handle `h` against golden `key`
    fn check:void (host:ThreeSceneHost h:int key:string exactSamples:boolean) {
        def g:ThreeBufferGeometry (host.geometryAt(h))
        this.parity(key g exactSamples)
        this.invariants(key g)
    }
}

class ThreeGeometryParityTest {
    sfn m@(main):void () {
        def ck:GeomParityCheck (new GeomParityCheck)
        ck.boot()

        ; --- run the JS geometry scene through the interpreter ------------------
        def engine (new ComponentEngine())
        engine.quiet = true
        def tk:[string]
        def tv:[EvalValue]
        push tk "SRGBColorSpace"
        push tv (EvalValue.string("srgb"))
        engine.registerGlobal("THREE" (EvalValue.object(tk tv)))
        def wk:[string]
        def wv:[EvalValue]
        push wk "innerWidth"
        push wv (EvalValue.number(200.0))
        push wk "innerHeight"
        push wv (EvalValue.number(200.0))
        push wk "devicePixelRatio"
        push wv (EvalValue.number(1.0))
        engine.registerGlobal("window" (EvalValue.object(wk wv)))

        def facade:buffer (buffer_read_file "gallery/game_engine/three/tsx" "three.tsx")
        def scene:buffer (buffer_read_file "gallery/game_engine/three/tests/geometry" "geom_probes.tsx")
        def src:string ((buffer_to_string facade) + "\n" + (buffer_to_string scene))
        engine.loadScript(src)
        def initR:EvalValue (engine.callFunction("init" (EvalValue.null())))

        ; --- reconcile the interpreted scene into the real Ranger host ----------
        def bridge (new ThreeTsxBridge)
        bridge.setEngine(engine)
        bridge.renderFrame(200 200)

        print "== geometry parity via the interpreter (args from JS, objects in Ranger) =="
        print ("  host built geometries: " + (to_string (bridge.host.geometryCount())))

        ; handles are assigned in scene.add() order (see geom_probes.tsx)
        ck.check(bridge.host 1 "plane" true)
        ck.check(bridge.host 2 "circle" true)
        ck.check(bridge.host 3 "ring" true)
        ck.check(bridge.host 4 "sphere" true)
        ck.check(bridge.host 5 "cylinder" true)
        ck.check(bridge.host 6 "cone" true)
        ck.check(bridge.host 7 "torus" true)
        print "== more complex geometries =="
        ck.check(bridge.host 8 "torusknot" true)
        ck.check(bridge.host 9 "box" false)

        print "== summary =="
        print ("passed=" + (to_string ck.passed) + " failed=" + (to_string ck.failed))
        if (ck.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

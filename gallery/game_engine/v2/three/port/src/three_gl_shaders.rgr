; ==============================================================================
; three_gl_shaders — shared GLSL for the GPU backend (WebGL + OpenGL/GLES).
; ==============================================================================
;
; GLSL ES 1.00 (attribute/varying/texture2D/gl_FragColor) — one source runs on
; WebGL1/2, GLES2 (Raspberry Pi) and desktop GL compat. An übershader: unlit
; (MeshBasicMaterial), Lambert diffuse, and Blinn-Phong specular are selected by
; uShading (0/1/2). Up to MAX_LIGHTS directional lights + one ambient term; a
; two-sided flag flips the normal toward the viewer for DoubleSide materials.
;
; Attributes: interleaved pos(3) + normal(3) + uv(2), 32-byte stride.
; ==============================================================================

class ThreeGLShaders {
    sfn vertexSrc:string () {
        return "attribute vec3 aPos;\nattribute vec3 aNormal;\nattribute vec2 aUv;\nattribute vec4 aTangent;\nuniform mat4 uMVP;\nuniform mat4 uModel;\nuniform mat4 uShadowMatrix;\nvarying vec3 vWorldPos;\nvarying vec3 vNormal;\nvarying vec2 vUv;\nvarying vec4 vShadowCoord;\nvarying vec4 vTangent;\nvoid main() {\n  vec4 wp = uModel * vec4(aPos, 1.0);\n  vWorldPos = wp.xyz;\n  vNormal = (uModel * vec4(aNormal, 0.0)).xyz;\n  vTangent = vec4((uModel * vec4(aTangent.xyz, 0.0)).xyz, aTangent.w);\n  vUv = aUv;\n  vShadowCoord = uShadowMatrix * wp;\n  gl_Position = uMVP * vec4(aPos, 1.0);\n}\n"
    }
    sfn fragmentSrc:string () {
        return "#ifdef GL_ES\nprecision highp float;\n#endif\nconst int MAX_LIGHTS = 4;\nvarying vec3 vWorldPos;\nvarying vec3 vNormal;\nvarying vec2 vUv;\nvarying vec4 vShadowCoord;\nvarying vec4 vTangent;\nuniform sampler2D uTex;\nuniform sampler2D uNormalMap;\nuniform float uHasNormal;\nuniform sampler2D uShadowMap;\nuniform float uShadowEnabled;\nuniform samplerCube uEnvMap;\nuniform vec3 uColor;\nuniform vec3 uSpecular;\nuniform float uShininess;\nuniform float uHasTex;\nuniform float uShading;\nuniform float uSide;\nuniform float uHasEnv;\nuniform float uReflectivity;\nuniform vec3 uAmbient;\nuniform vec3 uLightDir[MAX_LIGHTS];\nuniform vec3 uLightColor[MAX_LIGHTS];\nuniform int uLightCount;\nuniform vec3 uCamPos;\nuniform float uToneMapping;\nuniform float uExposure;\nvec3 toneMap(vec3 c) {\n  vec3 x = c * uExposure;\n  if (uToneMapping > 3.5) { return clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14), 0.0, 1.0); }\n  if (uToneMapping > 1.5) { return x / (1.0 + x); }\n  if (uToneMapping > 0.5) { return clamp(x, 0.0, 1.0); }\n  return c;\n}\nfloat shadowFactor() {\n  if (uShadowEnabled < 0.5) return 1.0;\n  vec3 p = vShadowCoord.xyz / vShadowCoord.w;\n  p = p * 0.5 + 0.5;\n  if (p.z > 1.0 || p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return 1.0;\n  float bias = 0.0025;\n  float o = 1.0 / 2048.0;\n  float lit = 0.0;\n  for (int i = -1; i <= 1; i++) {\n    for (int j = -1; j <= 1; j++) {\n      float d = texture2D(uShadowMap, p.xy + vec2(float(i), float(j)) * o).r;\n      lit += (p.z - bias > d) ? 0.0 : 1.0;\n    }\n  }\n  return lit / 9.0;\n}\nuniform sampler2D uProbeTex;\nuniform float uProbeEnabled;\nuniform float uProbeTexH;\nuniform vec3 uProbeCount;\nuniform vec3 uProbeOrigin;\nuniform vec3 uProbeSize;\nvec3 shCoeff(float P, float j) {\n  return texture2D(uProbeTex, vec2((j + 0.5) / 9.0, (P + 0.5) / uProbeTexH)).rgb;\n}\nvec3 probeIrradiance(float P, vec3 n) {\n  float x = n.x; float y = n.y; float z = n.z;\n  vec3 r = shCoeff(P, 0.0) * 0.886227;\n  r += shCoeff(P, 1.0) * (1.023328 * y);\n  r += shCoeff(P, 2.0) * (1.023328 * z);\n  r += shCoeff(P, 3.0) * (1.023328 * x);\n  r += shCoeff(P, 4.0) * (0.858086 * x * y);\n  r += shCoeff(P, 5.0) * (0.858086 * y * z);\n  r += shCoeff(P, 6.0) * ((0.743125 * z * z) - 0.247708);\n  r += shCoeff(P, 7.0) * (0.858086 * x * z);\n  r += shCoeff(P, 8.0) * (0.429043 * ((x * x) - (y * y)));\n  return max(r, vec3(0.0));\n}\nvec3 sampleProbeVolume(vec3 wp, vec3 n) {\n  vec3 lo = uProbeOrigin - uProbeSize * 0.5;\n  vec3 t = clamp((wp - lo) / uProbeSize, 0.0, 1.0);\n  vec3 f = t * (uProbeCount - 1.0);\n  vec3 i0 = floor(f);\n  vec3 fr = f - i0;\n  vec3 acc = vec3(0.0);\n  for (int dz = 0; dz < 2; dz++) {\n    for (int dy = 0; dy < 2; dy++) {\n      for (int dx = 0; dx < 2; dx++) {\n        vec3 d = vec3(float(dx), float(dy), float(dz));\n        vec3 c = min(i0 + d, uProbeCount - 1.0);\n        float P = ((c.z * uProbeCount.y) + c.y) * uProbeCount.x + c.x;\n        float w = mix(1.0 - fr.x, fr.x, float(dx)) * mix(1.0 - fr.y, fr.y, float(dy)) * mix(1.0 - fr.z, fr.z, float(dz));\n        acc += probeIrradiance(P, n) * w;\n      }\n    }\n  }\n  return acc;\n}\nvec3 perturbNormal(vec3 N) {\n  vec3 mapN = texture2D(uNormalMap, vUv).xyz * 2.0 - 1.0;\n  vec3 T = normalize(vTangent.xyz - N * dot(N, vTangent.xyz));\n  vec3 B = cross(N, T) * vTangent.w;\n  mat3 TBN = mat3(T, B, N);\n  return normalize(TBN * mapN);\n}\nvoid main() {\n  vec3 base = uColor;\n  if (uHasTex > 0.5) { base = base * texture2D(uTex, vUv).rgb; }\n  if (uShading < 0.5) { gl_FragColor = vec4(base, 1.0); return; }\n  vec3 N = normalize(vNormal);\n  vec3 V = normalize(uCamPos - vWorldPos);\n  if (uSide > 1.5 && dot(N, V) < 0.0) { N = -N; }\n  if (uHasNormal > 0.5) { N = perturbNormal(N); }\n  float sf = shadowFactor();\n  vec3 amb = uAmbient;\n  if (uProbeEnabled > 0.5) { amb = sampleProbeVolume(vWorldPos, N); }\n  vec3 col = amb * base;\n  for (int i = 0; i < MAX_LIGHTS; i++) {\n    if (i >= uLightCount) break;\n    vec3 L = normalize(uLightDir[i]);\n    float ndl = max(dot(N, L), 0.0);\n    col += sf * uLightColor[i] * base * ndl;\n    if (uShading > 1.5 && ndl > 0.0) {\n      vec3 H = normalize(L + V);\n      float s = pow(max(dot(N, H), 0.0), uShininess);\n      col += sf * uLightColor[i] * uSpecular * s;\n    }\n  }\n  if (uHasEnv > 0.5) {\n    vec3 R = reflect(-V, N);\n    vec3 env = textureCube(uEnvMap, R).rgb;\n    col = mix(col, env, uReflectivity);\n  }\n  gl_FragColor = vec4(toneMap(col), 1.0);\n}\n"
    }

    ; depth-only pass (shadow map): transform the position by the light's
    ; view-projection * model (uMVP). Colour is unused — only depth is captured.
    sfn depthVertexSrc:string () {
        return "attribute vec3 aPos;\nuniform mat4 uMVP;\nvoid main() {\n  gl_Position = uMVP * vec4(aPos, 1.0);\n}\n"
    }
    ; also pack window depth (gl_FragCoord.z) into RGB as a 24-bit fixed point, so
    ; the shadow map's colour attachment can be read back on the CPU for per-probe
    ; sun-visibility during the GI bake. (The depth *texture* attachment still gets
    ; real depth for the shading pass — this only adds a readable colour copy.)
    sfn depthFragmentSrc:string () {
        return "#ifdef GL_ES\nprecision highp float;\n#endif\nvoid main() {\n  float v = clamp(gl_FragCoord.z, 0.0, 0.999999);\n  float r = floor(v * 256.0);\n  float g = floor(fract(v * 256.0) * 256.0);\n  float b = floor(fract(v * 256.0 * 256.0) * 256.0);\n  gl_FragColor = vec4(r / 255.0, g / 255.0, b / 255.0, 1.0);\n}\n"
    }

    ; skybox: sample the environment cube map by view direction. aPos (offset 0,
    ; stride 32) doubles as the sampling direction for a cube centered at origin.
    sfn skyVertexSrc:string () {
        return "attribute vec3 aPos;\nuniform mat4 uMVP;\nvarying vec3 vDir;\nvoid main() {\n  vDir = aPos;\n  gl_Position = uMVP * vec4(aPos, 1.0);\n}\n"
    }
    sfn skyFragmentSrc:string () {
        return "#ifdef GL_ES\nprecision mediump float;\n#endif\nvarying vec3 vDir;\nuniform samplerCube uSky;\nvoid main() {\n  gl_FragColor = vec4(textureCube(uSky, normalize(vDir)).rgb, 1.0);\n}\n"
    }

    ; Preetham atmospheric sky (Three.js addons Sky.js), ported to GLSL ES 1.00.
    ; aPos is the huge sky-box position (also the world direction); uModel/uMVP are
    ; the model + view-projection; the scattering uniforms come from ThreeSky. Draw
    ; behind everything (the vertex shader forces gl_Position.z = w = far plane).
    sfn atmosphereVertexSrc:string () {
        return "attribute vec3 aPos;\nuniform mat4 uMVP;\nuniform mat4 uModel;\nuniform vec3 uSunPosition;\nuniform float uRayleigh;\nuniform float uTurbidity;\nuniform float uMieCoefficient;\nvarying vec3 vWorldPosition;\nvarying vec3 vSunDirection;\nvarying float vSunfade;\nvarying vec3 vBetaR;\nvarying vec3 vBetaM;\nvarying float vSunE;\nconst vec3 up = vec3(0.0, 1.0, 0.0);\nconst float e = 2.71828182845904523536028747135266249775724709369995957;\nconst vec3 totalRayleigh = vec3(5.804542996261093e-6, 1.3562911419845635e-5, 3.0265902468824876e-5);\nconst float v = 4.0;\nconst vec3 K = vec3(0.686, 0.678, 0.666);\nconst vec3 MieConst = vec3(1.8399918514433978e14, 2.7798023919660528e14, 4.0790479543861094e14);\nconst float cutoffAngle = 1.6110731556870734;\nconst float steepness = 1.5;\nconst float EE = 1000.0;\nfloat sunIntensity(float zenithAngleCos) {\n  zenithAngleCos = clamp(zenithAngleCos, -1.0, 1.0);\n  return EE * max(0.0, 1.0 - pow(e, -((cutoffAngle - acos(zenithAngleCos)) / steepness)));\n}\nvec3 totalMie(float T) {\n  float c = (0.2 * T) * 1e-18;\n  return 0.434 * c * MieConst;\n}\nvoid main() {\n  vec4 worldPosition = uModel * vec4(aPos, 1.0);\n  vWorldPosition = worldPosition.xyz;\n  gl_Position = uMVP * vec4(aPos, 1.0);\n  gl_Position.z = gl_Position.w;\n  vSunDirection = normalize(uSunPosition);\n  vSunE = sunIntensity(dot(vSunDirection, up));\n  vSunfade = 1.0 - clamp(1.0 - exp((uSunPosition.y / 450000.0)), 0.0, 1.0);\n  float rayleighCoefficient = uRayleigh - (1.0 * (1.0 - vSunfade));\n  vBetaR = totalRayleigh * rayleighCoefficient;\n  vBetaM = totalMie(uTurbidity) * uMieCoefficient;\n}\n"
    }
    sfn atmosphereFragmentSrc:string () {
        return "#ifdef GL_ES\nprecision highp float;\n#endif\nvarying vec3 vWorldPosition;\nvarying vec3 vSunDirection;\nvarying float vSunfade;\nvarying vec3 vBetaR;\nvarying vec3 vBetaM;\nvarying float vSunE;\nuniform float uMieDirectionalG;\nuniform float uToneMapping;\nuniform float uExposure;\nconst vec3 up = vec3(0.0, 1.0, 0.0);\nconst vec3 cameraPos = vec3(0.0, 0.0, 0.0);\nconst float pi = 3.141592653589793238462643383279502884197169;\nconst float n = 1.0003;\nconst float N = 2.545e25;\nconst float rayleighZenithLength = 8.4e3;\nconst float mieZenithLength = 1.25e3;\nconst float sunAngularDiameterCos = 0.999956676946448443553574619906976478926848692873900859324;\nconst float THREE_OVER_SIXTEENPI = 0.05968310365946075;\nconst float ONE_OVER_FOURPI = 0.07957747154594767;\nfloat rayleighPhase(float cosTheta) {\n  return THREE_OVER_SIXTEENPI * (1.0 + pow(cosTheta, 2.0));\n}\nfloat hgPhase(float cosTheta, float g) {\n  float g2 = pow(g, 2.0);\n  float inverse = 1.0 / pow(1.0 - 2.0 * g * cosTheta + g2, 1.5);\n  return ONE_OVER_FOURPI * ((1.0 - g2) * inverse);\n}\nvoid main() {\n  vec3 direction = normalize(vWorldPosition - cameraPos);\n  float zenithAngle = acos(max(0.0, dot(up, direction)));\n  float inverse = 1.0 / (cos(zenithAngle) + 0.15 * pow(93.885 - ((zenithAngle * 180.0) / pi), -1.253));\n  float sR = rayleighZenithLength * inverse;\n  float sM = mieZenithLength * inverse;\n  vec3 Fex = exp(-(vBetaR * sR + vBetaM * sM));\n  float cosTheta = dot(direction, vSunDirection);\n  float rPhase = rayleighPhase(cosTheta * 0.5 + 0.5);\n  vec3 betaRTheta = vBetaR * rPhase;\n  float mPhase = hgPhase(cosTheta, uMieDirectionalG);\n  vec3 betaMTheta = vBetaM * mPhase;\n  vec3 Lin = pow(vSunE * ((betaRTheta + betaMTheta) / (vBetaR + vBetaM)) * (1.0 - Fex), vec3(1.5));\n  Lin *= mix(vec3(1.0), pow(vSunE * ((betaRTheta + betaMTheta) / (vBetaR + vBetaM)) * Fex, vec3(0.5)), clamp(pow(1.0 - dot(up, vSunDirection), 5.0), 0.0, 1.0));\n  vec3 L0 = vec3(0.1) * Fex;\n  float sundisk = smoothstep(sunAngularDiameterCos, sunAngularDiameterCos + 0.00002, cosTheta);\n  L0 += (vSunE * 19000.0 * Fex) * sundisk;\n  vec3 texColor = (Lin + L0) * 0.04 + vec3(0.0, 0.0003, 0.00075);\n  vec3 x = texColor * uExposure;\n  vec3 retColor;\n  if (uToneMapping > 3.5) { retColor = clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14), 0.0, 1.0); }\n  else if (uToneMapping > 1.5) { retColor = x / (1.0 + x); }\n  else if (uToneMapping > 0.5) { retColor = clamp(x, 0.0, 1.0); }\n  else { retColor = pow(texColor, vec3(1.0 / (1.2 + (1.2 * vSunfade)))); }\n  gl_FragColor = vec4(retColor, 1.0);\n}\n"
    }
}

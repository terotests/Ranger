; ==============================================================================
; three_teapot_test — tessellate the teapot and sanity-check the mesh.
; ==============================================================================

Import "three_teapot_geometry.rgr"

class ThreeTeapotTest {
    sfn m@(main):void () {
        def passed:int 0
        def failed:int 0

        def g:ThreeTeapotGeometry (new ThreeTeapotGeometry)
        g.setTeapot(1.0 4 true true true false true)

        def vc:int (g.vertexCount())
        def ic:int (g.indexCount())
        print ("teapot (tess 4): vertices=" + (to_string vc) + " indices=" + (to_string ic))

        ; 32 surfaces * (4+1)^2 = 800 verts; 32 * 4*4 * 2 * 3 = 3072 indices.
        if (vc == 800) {
            passed = (passed + 1)
            print "  PASS vertex count = 800"
        } {
            failed = (failed + 1)
            print "  FAIL vertex count"
        }
        if (ic == 3072) {
            passed = (passed + 1)
            print "  PASS index count = 3072"
        } {
            failed = (failed + 1)
            print "  FAIL index count"
        }

        ; bounds: min/max over each axis should be finite and non-degenerate.
        def minY:double 1000000.0
        def maxY:double (0.0 - 1000000.0)
        def minX:double 1000000.0
        def maxX:double (0.0 - 1000000.0)
        def i:int 0
        while (i < vc) {
            def x:double (g.getPosition(i 0))
            def y:double (g.getPosition(i 1))
            if (x < minX) { minX = x }
            if (x > maxX) { maxX = x }
            if (y < minY) { minY = y }
            if (y > maxY) { maxY = y }
            i = (i + 1)
        }
        print ("  X range [" + (to_string minX) + " , " + (to_string maxX) + "]")
        print ("  Y range [" + (to_string minY) + " , " + (to_string maxY) + "]")
        def spanX:double (maxX - minX)
        def spanY:double (maxY - minY)
        ; X spans spout-to-handle (~4.08), wider than the [-1,1] height.
        if ((spanX > 0.3) && (spanX < 6.0)) {
            passed = (passed + 1)
            print "  PASS X span reasonable"
        } {
            failed = (failed + 1)
            print "  FAIL X span"
        }
        if ((spanY > 0.3) && (spanY < 4.0)) {
            passed = (passed + 1)
            print "  PASS Y span reasonable"
        } {
            failed = (failed + 1)
            print "  FAIL Y span"
        }

        ; body-only (no lid, no bottom) has fewer vertices than the full teapot.
        def g2:ThreeTeapotGeometry (new ThreeTeapotGeometry)
        g2.setTeapot(1.0 4 false false true false true)
        if ((g2.vertexCount()) < vc) {
            passed = (passed + 1)
            print "  PASS body-only has fewer vertices"
        } {
            failed = (failed + 1)
            print "  FAIL body-only vertex count"
        }

        print "== summary =="
        print ("passed=" + (to_string passed) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

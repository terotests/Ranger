; ==============================================================================
; RgSoftwareRenderer2D — software 2D present (Phase 11, D-SYNC).
; ==============================================================================
; The first place pixels are required. A backend READS host state only and
; rasterises it into a framebuffer — rendering is NOT a sync boundary (D-SYNC):
; it never mutates the scene, never allocates a handle, and re-presents
; identically for identical host state. It honours the same `Camera2D` the rest
; of the engine uses (D-2D-4).
; ==============================================================================

Import "../../../modules/ranger_2d/RgRanger2D.rgr"
Import "../../../host/handles/RgHandle.rgr"

; A CPU framebuffer: width*height ints (0 = clear; a sprite marks its pixel with
; a non-zero colour). Kept tiny for headless CI.
class RgFramebuffer {
    def width:int 0
    def height:int 0
    def pixels:[int]
    ; Persistent RGBA present buffer — rebuilt only when size changes so the
    ; SDL present path does not allocate ~518 KB/pane every frame.
    def rgbaBuf:buffer (buffer_alloc 0)
    def rgbaBytes:int 0

    sfn create:RgFramebuffer (width:int height:int) {
        def fb:RgFramebuffer (new RgFramebuffer)
        fb.width = width
        fb.height = height
        def px:[int]
        def n:int (width * height)
        def i 0
        while (i < n) {
            push px 0
            i = (i + 1)
        }
        fb.pixels = px
        return fb
    }

    fn clear:void () {
        def n:int (this.width * this.height)
        def i 0
        while (i < n) {
            set this.pixels i 0
            i = (i + 1)
        }
    }

    fn fill:void (color:int) {
        def n:int (this.width * this.height)
        def i 0
        while (i < n) {
            set this.pixels i color
            i = (i + 1)
        }
    }

    fn at:int (px:int py:int) {
        if (px < 0) { return 0 }
        if (py < 0) { return 0 }
        if (px >= this.width) { return 0 }
        if (py >= this.height) { return 0 }
        return (itemAt this.pixels ((py * this.width) + px))
    }

    fn plot:void (px:int py:int color:int) {
        if (px < 0) { return }
        if (py < 0) { return }
        if (px >= this.width) { return }
        if (py >= this.height) { return }
        set this.pixels ((py * this.width) + px) color
    }

    ; Pack the 0xRRGGBB int grid into a tightly-packed RGBA byte buffer
    ; (w*h*4, opaque) — the format the native present operators (gfx_present /
    ; gfx_present_split, SDL_PIXELFORMAT_RGBA32) expect. Pure conversion;
    ; testable headlessly, independent of any window. Reuses rgbaBuf across
    ; frames when the pane size is unchanged.
    fn toRgbaBuffer:buffer () {
        def n:int (this.width * this.height)
        def need:int (n * 4)
        if (need != this.rgbaBytes) {
            this.rgbaBuf = (buffer_alloc need)
            this.rgbaBytes = need
        }
        def buf:buffer this.rgbaBuf
        def i 0
        while (i < n) {
            def c:int (itemAt this.pixels i)
            def r:int (idiv c 65536)
            def g:int (idiv (c - (r * 65536)) 256)
            def b:int ((c - (r * 65536)) - (g * 256))
            def o:int (i * 4)
            buffer_set buf o r
            buffer_set buf (o + 1) g
            buffer_set buf (o + 2) b
            buffer_set buf (o + 3) 255
            i = (i + 1)
        }
        return buf
    }

    ; ---- immediate-mode fills (v1 SoftCanvas parity, 0xRRGGBB grid) ----------
    ; Clipped opaque rectangle. Mirrors SoftCanvas.fillRect (framebuffer.rgr):
    ; the static-environment primitive the game paints platforms/sky/flag with.
    fn fillRectRGB:void (x:int y:int rw:int rh:int color:int) {
        if (rw <= 0) { return }
        if (rh <= 0) { return }
        def x0 x
        def y0 y
        def x1 (x + rw)
        def y1 (y + rh)
        if (x0 < 0) { x0 = 0 }
        if (y0 < 0) { y0 = 0 }
        if (x1 > this.width) { x1 = this.width }
        if (y1 > this.height) { y1 = this.height }
        def yy y0
        while (yy < y1) {
            def base (yy * this.width)
            def xx x0
            while (xx < x1) {
                set this.pixels (base + xx) color
                xx = (xx + 1)
            }
            yy = (yy + 1)
        }
    }

    ; Clipped filled circle, per-row half-width — the exact scanline test in
    ; SoftCanvas.fillCircle (largest hw with hw*hw <= rad^2 - dy^2).
    fn fillCircleRGB:void (cx:int cy:int rad:int color:int) {
        if (rad <= 0) { return }
        def r2 (rad * rad)
        def yy (cy - rad)
        def yEnd (cy + rad)
        while (yy <= yEnd) {
            if (yy >= 0) {
                if (yy < this.height) {
                    def dy (yy - cy)
                    def rem (r2 - (dy * dy))
                    if (rem >= 0) {
                        def hw 0
                        while (((hw + 1) * (hw + 1)) <= rem) {
                            hw = (hw + 1)
                        }
                        def x0 (cx - hw)
                        def x1 ((cx + hw) + 1)
                        if (x0 < 0) { x0 = 0 }
                        if (x1 > this.width) { x1 = this.width }
                        def base (yy * this.width)
                        def xx x0
                        while (xx < x1) {
                            set this.pixels (base + xx) color
                            xx = (xx + 1)
                        }
                    }
                }
            }
            yy = (yy + 1)
        }
    }
}

class RgSoftwareRenderer2D {
    ; Present every sprite in `layerH` through `camH` into `fb`. Screen origin is
    ; the framebuffer centre. Returns the number of sprites drawn. Reads host
    ; state only.
    sfn present2D:int (d:RgRanger2D fb:RgFramebuffer layerH:RgHandle camH:RgHandle paneIndex:int) {
        def cx:int (idiv fb.width 2)
        def cy:int (idiv fb.height 2)
        def handles:[RgHandle] (d.liveSpriteHandles())
        def n:int (array_length handles)
        def drawn 0
        def i 0
        while (i < n) {
            def sh:RgHandle (itemAt handles i)
            def owner:int (d.spritePaneOwner(sh))
            def paneOk:boolean true
            if (owner >= 0) {
                if (owner != paneIndex) { paneOk = false }
            }
            if (paneOk) {
            if ((d.spriteLayerSlot(sh)) == layerH.slot) {
                def sx:double (d.worldToScreenSwX(camH (d.spriteX(sh)) (d.spriteY(sh))))
                def sy:double (d.worldToScreenSwY(camH (d.spriteX(sh)) (d.spriteY(sh))))
                def px:int ((floor (sx + 0.5)) + cx)
                def py:int ((floor (sy + 0.5)) + cy)
                ; colour keyed on the region so different frames are distinguishable
                def color:int (100 + (d.spriteRegion(sh)))
                fb.plot(px py color)
                drawn = (drawn + 1)
            }
            }
            i = (i + 1)
        }
        return drawn
    }
}

; ==============================================================================
; game_sprite - generic retained sprite schema + sync + draw dispatch.
; ==============================================================================
;
; Game scripts (TypeScript) declare shapes once in sprites() and drive runtime
; pose via state.entities[id]. The engine understands a small, game-agnostic
; vocabulary of kinds and numeric params (p0..p2). Pac-Man, Breakout, etc.
; compose these primitives in TS — nothing game-specific lives here.
;
; Sprite definition (sprites()):
;   { id, kind, w?, h?, rad?, r?, g?, b?, p0?, p1?, p2? }
;   bitmap: { px?, br,bg,bb, er,eg,eb, frames: [ [row strings...], ... ] }
;
; Runtime pose (state.entities[id]):
;   { x, y, visible?, r?, g?, b?, p0?, p1?, p2? }
;   bitmap: p0 = animation frame index (0..frameCount-1)
;
; Kinds:
;   rect   - axis-aligned rectangle (w x h), center at (x,y)
;   circle - filled circle (rad)
;   wedge  - circle with a directional bite removed (p0=dir 0..3, p1=open 0..3)
;   ghost  - domed sprite with scalloped hem and plus eyes (p0=dir, p1=0 full / 1 eyes-only)
;   bitmap - cached pixel-art with animated frame set (p0=frame)
;   sheet  - PNG spritesheet sub-rect blit (p0=frame col, p1=row, path/frameW/H)
;            scale is baked once at load (loadSheetImage); draw is 1:1 blit per frame.
; ==============================================================================

Import "../framebuffer.rgr"
Import "../../runtime/sdl/gfx_sdl.rgr"
Import "./game_image_loader.rgr"
Import "../../imaging/jpeg/ImageBuffer.rgr"

; Retained on-screen object: static shape from sprites(), runtime pose from state.
class GameEntity {
    def id:string ""
    def screen:string ""
    def kind:string "rect"
    def x:int 0
    def y:int 0
    def lastX:int -9999
    def lastY:int -9999
    def w:int 8
    def h:int 8
    def rad:int 4
    def cr:int 255
    def cg:int 255
    def cb:int 255
    def p0:int 0
    def p1:int 0
    def p2:int 0
    def angleDeg:double 0.0
    def visible:boolean true
    def bmPx:int 3
    def bmFrameCount:int 0
    def bmFrameLen:[int]
    def bmFrameStart:[int]
    def bmPixels:[int]
    def shPath:string ""
    def shFrameW:int 64
    def shFrameH:int 64
    def shCols:int 9
    def shRows:int 4
    def shScale:int 50
    def shFeetTrim:int 0
    def shJumpFrame:int 0
    def shImg:ImageBuffer (new ImageBuffer())
    def shGpuTexId:int 0
}

class GameSpriteRenderer {
    def imageLoader:GameImageLoader (new GameImageLoader())
    def gpuSheetOverlay:boolean false
    def gpuPane:int -1
    ; R1b: optional GPU ortho camera for the sprite overlay (pan px / zoom /
    ; rotation about the pane centre). Off by default -> identity, no change.
    def gpuCamEnabled:boolean false
    def gpuCamX:double 0.0
    def gpuCamY:double 0.0
    def gpuCamZoom:double 1.0
    def gpuCamAngleDeg:double 0.0
    def sheetCachePaths:[string]
    def sheetCacheTpl:[GameEntity]

    fn setImageLoader:void (loader:GameImageLoader) {
        imageLoader = loader
    }

    fn setGpuSheetOverlay:void (enabled:boolean) {
        gpuSheetOverlay = enabled
    }

    fn setGpuPane:void (pane:int) {
        gpuPane = pane
    }

    fn setGpuCamera:void (x:double y:double zoom:double angleDeg:double) {
        gpuCamEnabled = true
        gpuCamX = x
        gpuCamY = y
        gpuCamZoom = zoom
        gpuCamAngleDeg = angleDeg
    }

    fn resetGpuCamera:void () {
        gpuCamEnabled = false
        gpuCamX = 0.0
        gpuCamY = 0.0
        gpuCamZoom = 1.0
        gpuCamAngleDeg = 0.0
    }

    fn beginGpuSpriteFrame:void (pw:int ph:int gpuMode:boolean) {
        if (gpuMode) {
            if (gpuSheetOverlay) {
                gfx_gpu_sprites_begin pw ph gpuPane
                if (gpuCamEnabled) {
                    gfx_gpu_camera_set gpuPane gpuCamX gpuCamY gpuCamZoom gpuCamAngleDeg
                }
                if (gpuCamEnabled == false) {
                    gfx_gpu_camera_reset gpuPane
                }
            }
        }
    }

    fn clearSheetCache:void () {
        clear sheetCachePaths
        clear sheetCacheTpl
    }

    fn sheetCacheIndex:int (path:string) {
        def i 0
        while (i < (array_length sheetCachePaths)) {
            if ((itemAt sheetCachePaths i) == path) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn copySheetFields:void (dst:GameEntity src:GameEntity) {
        dst.shPath = src.shPath
        dst.shFrameW = src.shFrameW
        dst.shFrameH = src.shFrameH
        dst.shCols = src.shCols
        dst.shRows = src.shRows
        dst.shScale = src.shScale
        dst.shFeetTrim = src.shFeetTrim
        dst.shJumpFrame = src.shJumpFrame
        dst.shImg = src.shImg
        dst.shGpuTexId = src.shGpuTexId
    }

    fn storeSheetCache:void (e:GameEntity) {
        if ((strlen e.shPath) == 0) {
            return
        }
        if ((this.sheetCacheIndex(e.shPath)) >= 0) {
            return
        }
        def t:GameEntity (new GameEntity)
        this.copySheetFields(t e)
        push sheetCachePaths e.shPath
        push sheetCacheTpl t
    }

    fn updateSheetCacheTex:void (path:string texId:int) {
        def idx:int (this.sheetCacheIndex(path))
        if (idx < 0) {
            return
        }
        def t:GameEntity (itemAt sheetCacheTpl idx)
        t.shGpuTexId = texId
    }

    fn applySheetCache:boolean (e:GameEntity path:string) {
        def idx:int (this.sheetCacheIndex(path))
        if (idx < 0) {
            return false
        }
        def t:GameEntity (itemAt sheetCacheTpl idx)
        this.copySheetFields(e t)
        return true
    }

    fn hasSheetCache:boolean () {
        return ((array_length sheetCachePaths) > 0)
    }
    fn half:int (n:int) {
        def result 0
        def rem n
        while (rem >= 2) {
            rem = (rem - 2)
            result = (result + 1)
        }
        return result
    }

    fn memInt:int (obj:EvHandle key:string dflt:int) {
        def v:EvHandle (obj.getMember(key))
        if (v.isNull()) {
            return dflt
        }
        return (to_int v.numberValue)
    }

    fn memDouble:double (obj:EvHandle key:string dflt:double) {
        def v:EvHandle (obj.getMember(key))
        if (v.isNull()) {
            return dflt
        }
        return v.numberValue
    }

    fn appendBitmapPixel:void (e:GameEntity dx:int dy:int r:int g:int b:int) {
        push e.bmPixels dx
        push e.bmPixels dy
        push e.bmPixels r
        push e.bmPixels g
        push e.bmPixels b
    }

    ; Parse one frame (array of row strings). Chars: X=body O=eye ./space=skip.
    fn cacheOneBitmapFrame:int (e:GameEntity frameVal:EvHandle bodyR:int bodyG:int bodyB:int eyeR:int eyeG:int eyeB:int) {
        if (false == (frameVal.isArray())) {
            return 0
        }
        def rows:[EvHandle] (frameVal.itemsOf())
        def rowCount (array_length rows)
        def count 0
        def row 0
        while (row < rowCount) {
            def rowVal:EvHandle (itemAt rows row)
            def line:string (rowVal.stringOf())
            def colCount:int (strlen line)
            def col 0
            def midCol (this.half(colCount))
            def midRow (this.half(rowCount))
            while (col < colCount) {
                def ch:string (substring line col (col + 1))
                def dx ((col - midCol) * e.bmPx)
                def dy ((row - midRow) * e.bmPx)
                if (ch == "X") {
                    this.appendBitmapPixel(e dx dy bodyR bodyG bodyB)
                    count = (count + 1)
                }
                if (ch == "O") {
                    this.appendBitmapPixel(e dx dy eyeR eyeG eyeB)
                    count = (count + 1)
                }
                col = (col + 1)
            }
            row = (row + 1)
        }
        return count
    }

    fn cacheBitmapFrames:void (e:GameEntity d:EvHandle) {
        e.bmPx = (this.memInt(d "px" 3))
        e.bmFrameCount = 0
        clear e.bmFrameLen
        clear e.bmFrameStart
        clear e.bmPixels
        def framesVal:EvHandle (d.getMember("frames"))
        if (false == (framesVal.isArray())) {
            return
        }
        def bodyR (this.memInt(d "br" 255))
        def bodyG (this.memInt(d "bg" 255))
        def bodyB (this.memInt(d "bb" 255))
        def eyeR (this.memInt(d "er" 255))
        def eyeG (this.memInt(d "eg" 255))
        def eyeB (this.memInt(d "eb" 255))
        def arr:[EvHandle] (framesVal.itemsOf())
        def fi 0
        while (fi < (array_length arr)) {
            if (fi >= 8) {
                break
            }
            push e.bmFrameStart (array_length e.bmPixels)
            def count (this.cacheOneBitmapFrame(e (itemAt arr fi) bodyR bodyG bodyB eyeR eyeG eyeB))
            push e.bmFrameLen count
            e.bmFrameCount = (e.bmFrameCount + 1)
            fi = (fi + 1)
        }
    }

    fn scaledDim:int (base:int scalePct:int) {
        def v:int (to_int ((to_double (base * scalePct)) / 100.0))
        if (v < 1) {
            return 1
        }
        return v
    }

    ; Bake spritesheet scale once at load so per-frame draw is 1:1 alpha blit (no live resize).
    fn bakeSheetScale:void (e:GameEntity) {
        if (false == (this.sheetImageReady(e))) {
            return
        }
        def scale:int e.shScale
        if (scale == 100) {
            return
        }
        def src:ImageBuffer e.shImg
        def atlasW:int (this.scaledDim(src.width scale))
        def atlasH:int (this.scaledDim(src.height scale))
        def scratch:SoftCanvas (new SoftCanvas)
        scratch.init(atlasW atlasH)
        scratch.blitImageRectScaled(src 0 0 src.width src.height 0 0 atlasW atlasH)
        def baked:ImageBuffer (new ImageBuffer)
        baked.initClear(atlasW atlasH)
        scratch.copyPixelsToImage(baked)
        e.shImg = baked
        e.shFrameW = (this.scaledDim(e.shFrameW scale))
        e.shFrameH = (this.scaledDim(e.shFrameH scale))
        e.shFeetTrim = (this.scaledDim(e.shFeetTrim scale))
        e.shScale = 100
    }

    fn uploadSheetGpuTex:void (e:GameEntity) {
        if (false == gpuSheetOverlay) {
            return
        }
        if (false == (this.sheetImageReady(e))) {
            return
        }
        def tex:int (gfx_gpu_upload_texture e.shImg.pixels e.shImg.width e.shImg.height)
        if (tex > 0) {
            e.shGpuTexId = tex
            this.updateSheetCacheTex(e.shPath tex)
        }
    }

    fn loadSheetImage:void (e:GameEntity d:EvHandle) {
        def pathv:EvHandle (d.getMember("path"))
        e.shPath = (pathv.stringOf())
        e.shFrameW = (this.memInt(d "frameW" 64))
        e.shFrameH = (this.memInt(d "frameH" 64))
        e.shCols = (this.memInt(d "cols" 9))
        e.shRows = (this.memInt(d "rows" 4))
        e.shScale = (this.memInt(d "scale" 50))
        e.shFeetTrim = (this.memInt(d "feetTrim" 0))
        e.shJumpFrame = (this.memInt(d "jumpFrame" 0))
        if ((strlen e.shPath) > 0) {
            if (this.applySheetCache(e e.shPath)) {
                return
            }
            e.shImg = (imageLoader.load(e.shPath))
            this.bakeSheetScale(e)
            this.storeSheetCache(e)
        }
    }

    ; Apply a sprites() entry to a fresh GameEntity (defaults + static fields).
    fn applyDef:void (e:GameEntity d:EvHandle) {
        def idv:EvHandle (d.getMember("id"))
        def kindv:EvHandle (d.getMember("kind"))
        e.id = (idv.stringOf())
        e.kind = (kindv.stringOf())
        if (e.kind == "bitmap") {
            this.cacheBitmapFrames(e d)
            return
        }
        if (e.kind == "sheet") {
            this.loadSheetImage(e d)
            return
        }
        e.w = (this.memInt(d "w" 8))
        e.h = (this.memInt(d "h" 8))
        e.rad = (this.memInt(d "rad" 4))
        e.cr = (this.memInt(d "r" 255))
        e.cg = (this.memInt(d "g" 255))
        e.cb = (this.memInt(d "b" 255))
        e.p0 = (this.memInt(d "p0" 0))
        e.p1 = (this.memInt(d "p1" 0))
        e.p2 = (this.memInt(d "p2" 0))
    }

    ; Merge state.entities[id] into a retained entity (pose + optional overrides).
    fn syncPose:void (e:GameEntity pos:EvHandle pw:int ph:int) {
        def nx:int (this.memInt(pos "x" e.x))
        def ny:int (this.memInt(pos "y" e.y))
        if (nx != e.lastX) {
            e.x = nx
            e.lastX = nx
        }
        if (ny != e.lastY) {
            e.y = ny
            e.lastY = ny
        }
        def vis:EvHandle (pos.getMember("visible"))
        if (false == (vis.isNull())) {
            if (vis.isBoolean()) {
                e.visible = (vis.boolOf())
            } {
                e.visible = ((to_int vis.numberValue) != 0)
            }
        } {
            e.visible = true
            if (nx < -24) { e.visible = false }
            if (ny < -24) { e.visible = false }
            if (nx > (pw + 24)) { e.visible = false }
            if (ny > (ph + 24)) { e.visible = false }
        }
        def rv:EvHandle (pos.getMember("r"))
        if (false == (rv.isNull())) {
            e.cr = (this.memInt(pos "r" e.cr))
            e.cg = (this.memInt(pos "g" e.cg))
            e.cb = (this.memInt(pos "b" e.cb))
        }
        def p0v:EvHandle (pos.getMember("p0"))
        if (false == (p0v.isNull())) {
            e.p0 = (this.memInt(pos "p0" e.p0))
        }
        def p1v:EvHandle (pos.getMember("p1"))
        if (false == (p1v.isNull())) {
            e.p1 = (this.memInt(pos "p1" e.p1))
        }
        def p2v:EvHandle (pos.getMember("p2"))
        if (false == (p2v.isNull())) {
            e.p2 = (this.memInt(pos "p2" e.p2))
        }
        def angleV:EvHandle (pos.getMember("angle"))
        if (false == (angleV.isNull())) {
            e.angleDeg = (this.memDouble(pos "angle" e.angleDeg))
        }
        def radv:EvHandle (pos.getMember("rad"))
        if (false == (radv.isNull())) {
            e.rad = (this.memInt(pos "rad" e.rad))
        }
        ; Optional live draw scale for kind:"sheet" (percent, 100 = 1:1).
        ; Lets games do pseudo-3D depth without pre-baking every size.
        def scaleV:EvHandle (pos.getMember("scale"))
        if (false == (scaleV.isNull())) {
            def sc:int (this.memInt(pos "scale" e.shScale))
            if (sc < 1) {
                sc = 1
            }
            if (sc > 400) {
                sc = 400
            }
            e.shScale = sc
        }
        ; Optional live size for kind:"rect" (pseudo-3D road strips, etc.).
        def wv:EvHandle (pos.getMember("w"))
        if (false == (wv.isNull())) {
            def nw:int (this.memInt(pos "w" e.w))
            if (nw < 1) {
                nw = 1
            }
            e.w = nw
        }
        def hv:EvHandle (pos.getMember("h"))
        if (false == (hv.isNull())) {
            def nh:int (this.memInt(pos "h" e.h))
            if (nh < 1) {
                nh = 1
            }
            e.h = nh
        }
    }

    fn drawBitmap:void (e:GameEntity canvas:SoftCanvas) {
        if (e.bmFrameCount <= 0) {
            return
        }
        def frame (e.p0 % e.bmFrameCount)
        if (frame < 0) {
            frame = 0
        }
        def start (itemAt e.bmFrameStart frame)
        def count (itemAt e.bmFrameLen frame)
        def px e.bmPx
        def half (this.half(px))
        def i 0
        def idx start
        while (i < count) {
            def dx (itemAt e.bmPixels idx)
            def dy (itemAt e.bmPixels (idx + 1))
            def pr (itemAt e.bmPixels (idx + 2))
            def pg (itemAt e.bmPixels (idx + 3))
            def pb (itemAt e.bmPixels (idx + 4))
            canvas.fillRect((e.x + dx - half) (e.y + dy - half) px px pr pg pb)
            idx = (idx + 5)
            i = (i + 1)
        }
    }

    fn sheetImageReady:boolean (e:GameEntity) {
        if (e.shImg.width <= 1) {
            return false
        }
        if (e.shImg.height <= 1) {
            return false
        }
        return true
    }

    fn drawSheet:void (e:GameEntity canvas:SoftCanvas) {
        if (false == (this.sheetImageReady(e))) {
            return
        }
        def col:int (e.p0 % e.shCols)
        if (col < 0) {
            col = 0
        }
        def row:int (e.p1 % e.shRows)
        if (row < 0) {
            row = 0
        }
        if (e.p2 != 0) {
            col = e.shJumpFrame
        }
        def sx:int (col * e.shFrameW)
        def sy:int (row * e.shFrameH)
        def dw:int e.shFrameW
        def dh:int e.shFrameH
        if (e.shScale != 100) {
            dw = (this.scaledDim(e.shFrameW e.shScale))
            dh = (this.scaledDim(e.shFrameH e.shScale))
        }
        ; Feet at (x,y). feetTrim shaves transparent LPC padding from the frame bottom.
        def trim:int e.shFeetTrim
        if (e.shScale != 100) {
            trim = (this.scaledDim(e.shFeetTrim e.shScale))
        }
        if (gpuSheetOverlay) {
            if (e.shGpuTexId <= 0) {
                this.uploadSheetGpuTex(e)
            }
            if (e.shGpuTexId > 0) {
                def atlasW:int e.shImg.width
                def atlasH:int e.shImg.height
                if (e.angleDeg == 0.0) {
                    def dx:int (e.x - (this.half(dw)))
                    def dy:int ((e.y - dh) + trim)
                    gfx_gpu_sprites_push e.shGpuTexId atlasW atlasH sx sy dw dh (to_double dx) (to_double dy) (to_double dw) (to_double dh) 0.0 0
                } {
                    def pivotY:int (e.y - (this.half(dh)) + trim)
                    gfx_gpu_sprites_push e.shGpuTexId atlasW atlasH sx sy dw dh (to_double e.x) (to_double pivotY) (to_double dw) (to_double dh) e.angleDeg 1
                }
                return
            }
        }
        def pivotY:int (e.y - (this.half(dh)) + trim)
        if (e.angleDeg == 0.0) {
            def dx:int (e.x - (this.half(dw)))
            def dy:int ((e.y - dh) + trim)
            if (e.shScale == 100) {
                canvas.blitImageRect(e.shImg sx sy dw dh dx dy)
            } {
                canvas.blitImageRectScaled(e.shImg sx sy e.shFrameW e.shFrameH dx dy dw dh)
            }
        } {
            if (e.shScale == 100) {
                canvas.blitImageRectScaledRotated(e.shImg sx sy dw dh e.x pivotY dw dh e.angleDeg)
            } {
                canvas.blitImageRectScaledRotated(e.shImg sx sy e.shFrameW e.shFrameH e.x pivotY dw dh e.angleDeg)
            }
        }
    }

    fn drawEntity:void (e:GameEntity canvas:SoftCanvas) {
        if (false == e.visible) {
            return
        }
        if (e.kind == "sheet") {
            this.drawSheet(e canvas)
            return
        }
        if (e.kind == "bitmap") {
            this.drawBitmap(e canvas)
            return
        }
        if (e.kind == "circle") {
            canvas.fillCircle(e.x e.y e.rad e.cr e.cg e.cb)
            if (e.angleDeg != 0.0) {
                def rad2:double (canvas.degToRad(e.angleDeg))
                def markR:int (e.rad - 1)
                if (markR < 2) {
                    markR = 2
                }
                def ex:int (e.x + (to_int (cos(rad2) * (to_double markR))))
                def ey:int (e.y + (to_int (sin(rad2) * (to_double markR))))
                canvas.fillRect((ex - 1) (ey - 1) 2 2 20 20 20)
            }
            return
        }
        if (e.kind == "wedge") {
            canvas.fillWedgeCircle(e.x e.y e.rad e.p0 e.p1 e.cr e.cg e.cb)
            return
        }
        if (e.kind == "ghost") {
            canvas.fillGhost(e.x e.y e.rad e.p0 e.p1 e.cr e.cg e.cb)
            return
        }
        ; Horizontal trapezoid: top (x ± w/2) @ y → bottom (p1 ± p0/2) @ y+h.
        if (e.kind == "trap") {
            def y0:int e.y
            def y1:int (e.y + e.h)
            def half0:int (this.half(e.w))
            def half1:int (this.half(e.p0))
            canvas.fillTrapezoid(y0 (e.x - half0) (e.x + half0) y1 (e.p1 - half1) (e.p1 + half1) e.cr e.cg e.cb)
            return
        }
        if (e.angleDeg != 0.0) {
            canvas.fillRectRotated(e.x e.y e.w e.h e.angleDeg e.cr e.cg e.cb)
            return
        }
        canvas.fillRect((e.x - (this.half(e.w))) (e.y - (this.half(e.h))) e.w e.h e.cr e.cg e.cb)
    }
}

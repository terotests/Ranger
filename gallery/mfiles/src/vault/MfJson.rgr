; =============================================================================
; MfJson — a JSON value, a reader and a writer, in plain Ranger
; =============================================================================
; The vault speaks gRPC-shaped JSON to extensions. `lib/JSON.rgr` maps JSON
; onto each target's native types, which is the right answer for an app and
; the wrong one here: the emulator must behave identically on every backend,
; so the value is a class of its own and the parser is forty branches of
; character codes.
;
; Keys keep their insertion order, which is what makes a response written by
; the emulator diff cleanly against the one a test expects.
; =============================================================================

class MfJ {
    ; 0 null, 1 boolean, 2 number, 3 string, 4 array, 5 object
    def kind:int 0
    def flag:boolean false
    def num:double 0.0
    def str:string ""
    def arr:[MfJ]
    def ks:[string]
    def vs:[MfJ]

    sfn nul:MfJ () {
        return (new MfJ)
    }
    sfn ofBool:MfJ (b:boolean) {
        def j (new MfJ)
        j.kind = 1
        j.flag = b
        return j
    }
    sfn ofNum:MfJ (n:double) {
        def j (new MfJ)
        j.kind = 2
        j.num = n
        return j
    }
    sfn ofInt:MfJ (n:int) {
        def j (new MfJ)
        j.kind = 2
        j.num = (to_double n)
        return j
    }
    sfn ofStr:MfJ (s:string) {
        def j (new MfJ)
        j.kind = 3
        j.str = s
        return j
    }
    sfn newArr:MfJ () {
        def j (new MfJ)
        j.kind = 4
        return j
    }
    sfn newObj:MfJ () {
        def j (new MfJ)
        j.kind = 5
        return j
    }

    fn isNull:boolean () {
        return (kind == 0)
    }
    fn isObj:boolean () {
        return (kind == 5)
    }
    fn isArr:boolean () {
        return (kind == 4)
    }

    ; --- objects ------------------------------------------------------------

    fn has:boolean (key:string) {
        for ks k:string i {
            if (k == key) {
                return true
            }
        }
        return false
    }

    fn field:MfJ (key:string) {
        def n:int (array_length ks)
        def i:int 0
        while (i < n) {
            def k:string (itemAt ks i)
            if (k == key) {
                def v:MfJ (itemAt vs i)
                return v
            }
            i = (i + 1)
        }
        return (new MfJ)
    }

    fn put:MfJ (key:string v:MfJ) {
        kind = 5
        def n:int (array_length ks)
        def i:int 0
        while (i < n) {
            def k:string (itemAt ks i)
            if (k == key) {
                set vs i v
                return this
            }
            i = (i + 1)
        }
        push ks key
        push vs v
        return this
    }

    fn putStr:MfJ (key:string s:string) {
        def v:MfJ (MfJ.ofStr(s))
        return (this.put(key v))
    }
    fn putInt:MfJ (key:string n:int) {
        def v:MfJ (MfJ.ofInt(n))
        return (this.put(key v))
    }
    fn putNum:MfJ (key:string n:double) {
        def v:MfJ (MfJ.ofNum(n))
        return (this.put(key v))
    }
    fn putBool:MfJ (key:string b:boolean) {
        def v:MfJ (MfJ.ofBool(b))
        return (this.put(key v))
    }

    fn str_:string (key:string) {
        def v:MfJ (this.field(key))
        if (v.kind == 3) {
            return v.str
        }
        if (v.kind == 2) {
            return (MfJ.numText(v.num))
        }
        return ""
    }
    fn int_:int (key:string fallback:int) {
        def v:MfJ (this.field(key))
        if (v.kind == 2) {
            return (to_int v.num)
        }
        if (v.kind == 3) {
            def p@(optional):int (str2int v.str)
            if (!null? p) {
                return (unwrap p)
            }
        }
        return fallback
    }
    fn num_:double (key:string fallback:double) {
        def v:MfJ (this.field(key))
        if (v.kind == 2) {
            return v.num
        }
        return fallback
    }
    fn bool_:boolean (key:string fallback:boolean) {
        def v:MfJ (this.field(key))
        if (v.kind == 1) {
            return v.flag
        }
        return fallback
    }
    ; The array under `key`, or an empty one.
    fn list:[MfJ] (key:string) {
        def v:MfJ (this.field(key))
        if (v.kind == 4) {
            return v.arr
        }
        def none:[MfJ]
        return none
    }

    ; --- arrays -------------------------------------------------------------

    fn add:MfJ (v:MfJ) {
        kind = 4
        push arr v
        return this
    }
    fn count:int () {
        if (kind == 4) {
            return (array_length arr)
        }
        if (kind == 5) {
            return (array_length ks)
        }
        return 0
    }
    fn item:MfJ (i:int) {
        if (kind != 4) {
            return (new MfJ)
        }
        if ((i < 0) || (i >= (array_length arr))) {
            return (new MfJ)
        }
        def v:MfJ (itemAt arr i)
        return v
    }

    ; --- writing ------------------------------------------------------------

    sfn numText:string (n:double) {
        if (n != n) {
            return "null"
        }
        def whole:int (to_int n)
        def back:double (to_double whole)
        if (back == n) {
            return (to_string whole)
        }
        return (to_string n)
    }

    sfn quote:string (s:string) {
        def parts:[string]
        push parts "\""
        def n:int (strlen s)
        def start:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            def esc:string ""
            if (c == 34) {
                esc = "\\\""
            }
            if (c == 92) {
                esc = "\\\\"
            }
            if (c == 10) {
                esc = "\\n"
            }
            if (c == 13) {
                esc = "\\r"
            }
            if (c == 9) {
                esc = "\\t"
            }
            if ((strlen esc) == 0) {
                if (c < 32) {
                    def hex:string "0123456789abcdef"
                    def hi:int (to_int (c / 16))
                    def lo:int (c % 16)
                    esc = ("\\u00" + (substring hex hi (hi + 1)) + (substring hex lo (lo + 1)))
                }
            }
            if ((strlen esc) > 0) {
                if (i > start) {
                    push parts (substring s start i)
                }
                push parts esc
                start = (i + 1)
            }
            i = (i + 1)
        }
        if (n > start) {
            push parts (substring s start n)
        }
        push parts "\""
        return (join parts "")
    }

    fn emit:void (out:[string]) {
        if (kind == 0) {
            push out "null"
            return
        }
        if (kind == 1) {
            if flag {
                push out "true"
            } {
                push out "false"
            }
            return
        }
        if (kind == 2) {
            push out (MfJ.numText(num))
            return
        }
        if (kind == 3) {
            push out (MfJ.quote(str))
            return
        }
        if (kind == 4) {
            push out "["
            def n:int (array_length arr)
            def i:int 0
            while (i < n) {
                if (i > 0) {
                    push out ","
                }
                def v:MfJ (itemAt arr i)
                v.emit(out)
                i = (i + 1)
            }
            push out "]"
            return
        }
        push out "{"
        def m:int (array_length ks)
        def j:int 0
        while (j < m) {
            if (j > 0) {
                push out ","
            }
            def k:string (itemAt ks j)
            push out (MfJ.quote(k))
            push out ":"
            def fv:MfJ (itemAt vs j)
            fv.emit(out)
            j = (j + 1)
        }
        push out "}"
    }

    fn toJson:string () {
        def out:[string]
        this.emit(out)
        return (join out "")
    }

    sfn parse:MfJ (text:string) {
        def p (new MfJsonReader)
        return (p.read(text))
    }
}

class MfJsonReader {
    def src:string ""
    def pos:int 0
    def len:int 0
    def error:string ""

    fn read:MfJ (text:string) {
        src = text
        pos = 0
        len = (strlen text)
        error = ""
        def v:MfJ (this.value())
        this.ws()
        if ((strlen error) == 0) {
            if (pos < len) {
                error = ("unexpected text at " + (to_string pos))
            }
        }
        return v
    }

    fn ws:void () {
        def going:boolean true
        while ((pos < len) && going) {
            def c:int (charAt src pos)
            if ((((c == 32) || (c == 10)) || (c == 13)) || (c == 9)) {
                pos = (pos + 1)
            } {
                going = false
            }
        }
    }

    fn fail:MfJ (why:string) {
        if ((strlen error) == 0) {
            error = (why + " at " + (to_string pos))
        }
        pos = len
        return (new MfJ)
    }

    fn value:MfJ () {
        this.ws()
        if (pos >= len) {
            return (this.fail("unexpected end"))
        }
        def c:int (charAt src pos)
        if (c == 123) {
            return (this.object())
        }
        if (c == 91) {
            return (this.array())
        }
        if (c == 34) {
            def s:string (this.stringLit())
            return (MfJ.ofStr(s))
        }
        if (c == 116) {
            return (this.word("true" (MfJ.ofBool(true))))
        }
        if (c == 102) {
            return (this.word("false" (MfJ.ofBool(false))))
        }
        if (c == 110) {
            return (this.word("null" (new MfJ)))
        }
        return (this.number())
    }

    fn word:MfJ (w:string v:MfJ) {
        def n:int (strlen w)
        if ((pos + n) > len) {
            return (this.fail("bad literal"))
        }
        if ((substring src pos (pos + n)) != w) {
            return (this.fail("bad literal"))
        }
        pos = (pos + n)
        return v
    }

    fn number:MfJ () {
        def start:int pos
        def going:boolean true
        while ((pos < len) && going) {
            def c:int (charAt src pos)
            def numeric:boolean ((c >= 48) && (c <= 57))
            if ((((c == 45) || (c == 43)) || (c == 46)) || ((c == 101) || (c == 69))) {
                numeric = true
            }
            if numeric {
                pos = (pos + 1)
            } {
                going = false
            }
        }
        if (pos == start) {
            return (this.fail("unexpected character"))
        }
        def t:string (substring src start pos)
        def d@(optional):double (str2double t)
        if (null? d) {
            return (this.fail("bad number"))
        }
        return (MfJ.ofNum((unwrap d)))
    }

    sfn hexVal:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return (c - 87)
        }
        if ((c >= 65) && (c <= 70)) {
            return (c - 55)
        }
        return 0
    }

    fn stringLit:string () {
        ; at the opening quote
        pos = (pos + 1)
        def parts:[string]
        def start:int pos
        def done:boolean false
        while ((pos < len) && (done == false)) {
            def c:int (charAt src pos)
            if (c == 34) {
                if (pos > start) {
                    push parts (substring src start pos)
                }
                pos = (pos + 1)
                done = true
            } {
                if (c == 92) {
                    if (pos > start) {
                        push parts (substring src start pos)
                    }
                    def e:int 0
                    if ((pos + 1) < len) {
                        e = (charAt src (pos + 1))
                    }
                    pos = (pos + 2)
                    if (e == 110) {
                        push parts "\n"
                    }
                    if (e == 116) {
                        push parts "\t"
                    }
                    if (e == 114) {
                        push parts "\r"
                    }
                    if (e == 98) {
                        push parts (strfromcode 8)
                    }
                    if (e == 102) {
                        push parts (strfromcode 12)
                    }
                    if (((e == 34) || (e == 92)) || (e == 47)) {
                        push parts (strfromcode e)
                    }
                    if (e == 117) {
                        def code:int 0
                        def k:int 0
                        while ((k < 4) && (pos < len)) {
                            def hc:int (charAt src pos)
                            code = ((code * 16) + (MfJsonReader.hexVal(hc)))
                            pos = (pos + 1)
                            k = (k + 1)
                        }
                        push parts (strfromcode code)
                    }
                    start = pos
                } {
                    pos = (pos + 1)
                }
            }
        }
        if (done == false) {
            this.fail("unterminated string")
        }
        return (join parts "")
    }

    fn array:MfJ () {
        pos = (pos + 1)
        def out:MfJ (MfJ.newArr())
        this.ws()
        if (pos < len) {
            if ((charAt src pos) == 93) {
                pos = (pos + 1)
                return out
            }
        }
        def going:boolean true
        while going {
            def v:MfJ (this.value())
            out.add(v)
            this.ws()
            if (pos >= len) {
                return (this.fail("unterminated array"))
            }
            def c:int (charAt src pos)
            pos = (pos + 1)
            if (c == 93) {
                going = false
            } {
                if (c != 44) {
                    return (this.fail("expected , or ]"))
                }
            }
        }
        return out
    }

    fn object:MfJ () {
        pos = (pos + 1)
        def out:MfJ (MfJ.newObj())
        this.ws()
        if (pos < len) {
            if ((charAt src pos) == 125) {
                pos = (pos + 1)
                return out
            }
        }
        def going:boolean true
        while going {
            this.ws()
            if (pos >= len) {
                return (this.fail("unterminated object"))
            }
            if ((charAt src pos) != 34) {
                return (this.fail("expected key"))
            }
            def k:string (this.stringLit())
            this.ws()
            if (pos >= len) {
                return (this.fail("unterminated object"))
            }
            if ((charAt src pos) != 58) {
                return (this.fail("expected :"))
            }
            pos = (pos + 1)
            def v:MfJ (this.value())
            out.put(k v)
            this.ws()
            if (pos >= len) {
                return (this.fail("unterminated object"))
            }
            def c:int (charAt src pos)
            pos = (pos + 1)
            if (c == 125) {
                going = false
            } {
                if (c != 44) {
                    return (this.fail("expected , or }"))
                }
            }
        }
        return out
    }
}

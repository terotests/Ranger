        push out "{\"name\":\"logic\",\"survey\":{\"elements\":[{\"type\":\"text\",\"name\":\"a\",\"inputType\":\"number\"},{\"type\":\"text\",\"name\":\"b\",\"inputType\":\"number\"},{\"type\":\"text\",\"name\":\"andBoth\",\"visibleIf\":\"{a} > 1 && {b} > 1\"},{\"type\":\"text\",\"name\":\"orEither\",\"visibleIf\":\"{a} > 5 || {b} > 5\"},{\"type\":\"text\",\"name\":\"notEqual\",\"visibleIf\":\"{a} <> {b}\"},{\"type\":\"text\",\"name\":\"filled\",\"visibleIf\":\"{a} notempty\"},{\"type\":\"text\",\"name\":\"blank\",\"visibleIf\":\"{b} empty\"},{\"type\":\"expression\",\"name\":\"picked\",\"expression\":\"iif({a} > {b}, {a}, {b})\"}]},\"script\":[{\"a\":2},{\"b\":3},{\"a\":9},{\"b\":9}]}"
        push out "{\"name\":\"enable-readonly\",\"survey\":{\"elements\":[{\"type\":\"boolean\",\"name\":\"wants_post\"},{\"type\":\"text\",\"name\":\"address\",\"enableIf\":\"{wants_post} = true\",\"isRequired\":true},{\"type\":\"text\",\"name\":\"secret\",\"visible\":false,\"isRequired\":true},{\"type\":\"text\",\"name\":\"always\"}]},\"script\":[{\"wants_post\":true},{\"address\":\"Somewhere 1\"},{\"wants_post\":false}]}"

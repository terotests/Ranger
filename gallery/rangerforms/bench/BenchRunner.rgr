; ============================================================================
; BenchRunner.rgr — one side of the comparison against SurveyJS.
; ============================================================================
;
; A case is a SurveyJS form and a script of answers:
;
;   { "name": "clinic",
;     "survey": { "elements": [ … ] },
;     "script": [ { "age": 12 }, { "age": 40 }, { "height": 1.8 } ] }
;
; This runs it and prints, after the initial pass and after every step, what
; the engine believes about every question — showing, required, and the value.
; `bench.mjs` runs the SAME case through survey-core and diffs the two.
;
; The output is deliberately a flat, sorted, textual line per question rather
; than a structure: a diff of two lines tells somebody what disagreed, and a
; diff of two object graphs tells them that two object graphs are different.
; ============================================================================

Import "../engine/FormEngine.rgr"
Import "../io/SurveyReader.rgr"

class BenchRunner {
    def reader:SurveyReader (new SurveyReader)
    def engine:FormEngine (new FormEngine)
    def state:AnswerState (new AnswerState)
    def steps:JsonValue (new JsonValue)
    def name:string ""
    def errorText:string ""
    def ready:boolean false

    Constructor () {
    }

    ; ------------------------------------------------------------------------
    ; Loading
    ; ------------------------------------------------------------------------
    fn load:boolean (caseJson:string todayDays:int) {
        def p:JsonParser (new JsonParser)
        def root:JsonValue (p.parse(caseJson))
        if ((p.ok) == false) {
            errorText = p.err
            return false
        }
        name = (root.stringOr("name" "case"))
        def survey:JsonValue (root.get("survey"))
        if ((survey.isObject()) == false) {
            errorText = "the case has no survey"
            return false
        }
        reader = (SurveyReader.read((BenchRunner.reprint(survey))))
        if ((strlen reader.errorText) > 0) {
            errorText = reader.errorText
            return false
        }
        engine = (FormEngine.load(reader.form reader.host))
        if ((engine.ready) == false) {
            errorText = engine.errorText
            return false
        }
        state = (engine.start(todayDays))
        steps = (root.get("script"))
        ready = true
        return true
    }

    ; The reader takes text, and the case arrived as a parsed tree. Printing
    ; the sub-object back out is cheaper than giving the reader a second entry
    ; point, and it round-trips through the same parser either way.
    sfn reprint:string (v:JsonValue) {
        if (v.isNull()) {
            return "null"
        }
        if (v.isNumber()) {
            return (FormValue.numberText((v.asDouble())))
        }
        if (v.isString()) {
            return (BenchRunner.quoted((v.asString())))
        }
        if (v.kind == 1) {
            if (v.asBool()) {
                return "true"
            }
            return "false"
        }
        if (v.isArray()) {
            def out:string "["
            def i:int 0
            def n:int (v.count())
            while (i < n) {
                if (i > 0) {
                    out = (out + ",")
                }
                out = (out + (BenchRunner.reprint((v.at(i)))))
                i = (i + 1)
            }
            return (out + "]")
        }
        def out2:string "{"
        def k:int 0
        def nk:int (array_length v.keys)
        while (k < nk) {
            def key:string (itemAt v.keys k)
            if (k > 0) {
                out2 = (out2 + ",")
            }
            out2 = (out2 + (BenchRunner.quoted(key)) + ":" + (BenchRunner.reprint((v.get(key)))))
            k = (k + 1)
        }
        return (out2 + "}")
    }

    sfn quoted:string (s:string) {
        return (FormEngine.jsonString(s))
    }

    ; ------------------------------------------------------------------------
    ; Running
    ; ------------------------------------------------------------------------
    fn stepCount:int () {
        if ((steps.isArray()) == false) {
            return 0
        }
        return (steps.count())
    }

    ; Apply one step: every key in it is answered, in the order written.
    fn applyStep:void (index:int) {
        if ((steps.isArray()) == false) {
            return
        }
        if (index >= (steps.count())) {
            return
        }
        def step:JsonValue (steps.at(index))
        if ((step.isObject()) == false) {
            return
        }
        def k:int 0
        def nk:int (array_length step.keys)
        while (k < nk) {
            def key:string (itemAt step.keys k)
            def v:JsonValue (step.get(key))
            engine.answer(state key (BenchRunner.valueOf(v)))
            k = (k + 1)
        }
    }

    sfn valueOf:FormValue (v:JsonValue) {
        if (v.isNull()) {
            return (FormValue.blank())
        }
        if (v.isNumber()) {
            return (FormValue.ofNumber((v.asDouble())))
        }
        if (v.kind == 1) {
            return (FormValue.ofBool((v.asBool())))
        }
        if (v.isArray()) {
            def items:[string]
            def i:int 0
            def n:int (v.count())
            while (i < n) {
                def one:JsonValue (v.at(i))
                if (one.isNumber()) {
                    push items (FormValue.numberText((one.asDouble())))
                } {
                    push items (one.asString())
                }
                i = (i + 1)
            }
            return (FormValue.ofList(items))
        }
        def text:string (v.asString())
        if ((strlen text) == 0) {
            return (FormValue.blank())
        }
        return (FormValue.ofText(text))
    }

    ; ------------------------------------------------------------------------
    ; What the engine believes
    ; ------------------------------------------------------------------------
    ;
    ; One line per question, in the order the form declares them, so a diff of
    ; two runs points at the question that disagreed.
    fn snapshot:string () {
        def out:string ""
        def i:int 0
        def n:int (array_length engine.form.questions)
        while (i < n) {
            def q:Question (itemAt engine.form.questions i)
            def st:QuestionState (state.stateOf(q.name))
            def line:string (q.name + " visible=" + (BenchRunner.yesNo(st.visible)))
            line = (line + " required=" + (BenchRunner.yesNo(st.required)))
            line = (line + " value=" + (BenchRunner.shown(state q.name st)))
            out = (out + line + "\n")
            i = (i + 1)
        }
        return out
    }

    ; The value SurveyJS would report: a hidden question has none, and an
    ; unanswered one has none. Numbers are printed the way JavaScript prints
    ; them, because the other side of the comparison is JavaScript.
    sfn shown:string (state:AnswerState name:string st:QuestionState) {
        if ((st.visible) == false) {
            return "-"
        }
        def v:FormValue (state.rawValueOf(name))
        if (v.isEmpty()) {
            return "-"
        }
        if (v.isError()) {
            return "-"
        }
        return (v.asText())
    }

    sfn yesNo:string (b:boolean) {
        if b {
            return "1"
        }
        return "0"
    }

    ; The whole run: the initial pass, then a snapshot after each step.
    fn report:string () {
        def out:string ("case " + name + "\n")
        out = (out + "gaps " + (to_string (reader.gapCount())) + "\n")
        def g:int 0
        def ng:int (array_length reader.unsupported)
        while (g < ng) {
            out = (out + "gap " + (itemAt reader.unsupported g) + "\n")
            g = (g + 1)
        }
        out = (out + "-- step 0\n")
        out = (out + (this.snapshot()))
        def i:int 0
        def n:int (this.stepCount())
        while (i < n) {
            this.applyStep(i)
            out = (out + "-- step " + (to_string (i + 1)) + "\n")
            out = (out + (this.snapshot()))
            i = (i + 1)
        }
        out = (out + "evaluations " + (to_string state.evaluations) + "\n")
        return out
    }
}

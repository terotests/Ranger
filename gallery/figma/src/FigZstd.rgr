; Zstd for the JavaScript target. OpenFig uses fzstd for the same step;
; the kiwi decode, the node tree and the EVG paint are Ranger. The page
; (and the Node bench) install `globalThis.__figZstdDecompress` before
; a .fig that actually needs zstd is opened. Node 22+'s zlib is used
; when that hook is missing.

operators {
    fig_zstd_decompress _:buffer (src:buffer) {
        templates {
            es6 ("__fig_zstd_decompress(" (e 1) ")"
                (create_polyfill "
function __fig_zstd_decompress(src) {
  var asAB = function (u8) {
    var ab = u8.buffer.slice ? u8.buffer.slice(u8.byteOffset, u8.byteOffset + u8.byteLength) : u8.buffer;
    if (!(ab instanceof ArrayBuffer) || ab.byteLength !== u8.byteLength) {
      ab = new ArrayBuffer(u8.byteLength);
      new Uint8Array(ab).set(u8);
    }
    ab._view = new DataView(ab);
    return ab;
  };
  if (typeof globalThis.__figZstdDecompress === 'function') {
    var out = globalThis.__figZstdDecompress(src);
    if (out && out.buffer && typeof out.byteLength === 'number') return asAB(out);
    if (out instanceof ArrayBuffer) { out._view = new DataView(out); return out; }
    return out;
  }
  if (typeof process !== 'undefined' && typeof require === 'function') {
    var z = require('zlib');
    if (typeof z.zstdDecompressSync === 'function') {
      var buf = Buffer.from(src instanceof ArrayBuffer ? new Uint8Array(src) : src);
      var dec = z.zstdDecompressSync(buf);
      return asAB(dec);
    }
  }
  throw new Error('zstd host missing: set globalThis.__figZstdDecompress');
}
"))
            * ("(buffer_alloc 0)")
        }
    }
}

class FigZstdHost {
    Constructor () {
    }
}

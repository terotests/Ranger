; Inspect a .fig / .deck: node tree and parse timings.
;   node gallery/figma/bin/fig_cli.js inspect file.fig
;   node gallery/figma/bin/fig_cli.js sample

Import "FigParser.rgr"
Import "FigSample.rgr"
Import "FigModel.rgr"
Import "../../evg/EVGCodepoint.rgr"
Import "convert/FigToScene.rgr"
Import "evg/SceneToEVG.rgr"
Import "../../evg/EVGTreeJson.rgr"
Import "write/SceneToFig.rgr"
Import "write/EvgToScene.rgr"

class FigCli {
    sfn main:void () {
        def n:int (shell_arg_cnt)
        if (n < 1) {
            print "usage: fig_cli inspect <file.fig|.deck>"
            print "       fig_cli fields <file.fig> <node-id>"
            print "       fig_cli sample"
            print "       fig_cli write-sample <out.fig>"
            print "       fig_cli rewrite <in.fig> <out.fig>   read a file and write it back"
            print "       fig_cli to-evg  <in.fig> <out.evg.json> [page]   one page, as an editable document"
            print "       fig_cli from-evg <in.evg.json> <out.fig>         an editable document, as a file"
            return
        }
        def cmd:string (shell_arg 0)
        if (cmd == "sample") {
            def p (new FigParser())
            def doc:FigDoc (p.parseBytes((FigSample.buildFig()) "sample.fig"))
            FigCli.dump(doc)
            return
        }
        ; Read a document and write it out again — the round trip that says
        ; whether the writer understood what the reader found. Nothing is
        ; changed in between on purpose: a difference is the writer's.
        if (cmd == "rewrite") {
            if (n < 3) {
                print "usage: fig_cli rewrite <in.fig> <out.fig>"
                return
            }
            def src:string (shell_arg 1)
            def dest:string (shell_arg 2)
            def raw@(optional):buffer (buffer_read_file (FigCli.dirOf(src)) (FigCli.nameOf(src)))
            if (null? raw) {
                print ("cannot read " + src)
                return
            }
            def p2 (new FigParser())
            def doc:FigDoc (p2.parseBytes((unwrap raw) (FigCli.nameOf(src))))
            if (doc.ok == false) {
                print ("cannot parse " + src + ": " + doc.err)
                return
            }
            def conv (new FigToScene())
            def scene:SceneDocument (conv.convertDoc(doc))
            def w (new SceneToFig())
            def bytes:buffer (w.toBytes(scene (FigCli.nameOf(src))))
            buffer_write_file (FigCli.dirOf(dest)) (FigCli.nameOf(dest)) bytes
            print ("wrote " + dest + " (" + (to_string (buffer_length bytes)) + " bytes)")
            def li:int 0
            while (li < (array_length w.losses)) {
                print ("  lost  " + (itemAt w.losses li))
                li = (li + 1)
            }
            if ((array_length w.losses) == 0) {
                print "  nothing reported lost"
            }
            return
        }
        ; A page, as an editable EVG document. From here the whole agent
        ; toolchain works on a Figma file: outline for addresses, patch for
        ; changes, measure for a verdict, and the PNG tool for a picture.
        if (cmd == "to-evg") {
            if (n < 3) {
                print "usage: fig_cli to-evg <in.fig> <out.evg.json> [page]"
                return
            }
            def src3:string (shell_arg 1)
            def dest3:string (shell_arg 2)
            def want:int 0
            if (n > 3) {
                def givenPage@(optional):int (to_int (shell_arg 3))
                if givenPage {
                    want = (unwrap givenPage)
                }
            }
            def raw3@(optional):buffer (buffer_read_file (FigCli.dirOf(src3)) (FigCli.nameOf(src3)))
            if (null? raw3) {
                print ("cannot read " + src3)
                return
            }
            def p3 (new FigParser())
            def doc3:FigDoc (p3.parseBytes((unwrap raw3) (FigCli.nameOf(src3))))
            if (doc3.ok == false) {
                print ("cannot parse " + src3 + ": " + doc3.err)
                return
            }
            def conv3 (new FigToScene())
            def scene3:SceneDocument (conv3.convertDoc(doc3))
            if (want >= (array_length scene3.pages)) {
                print (("that file has " + (to_string (array_length scene3.pages))) + " page(s)")
                return
            }
            def page3:SceneNode (itemAt scene3.pages want)
            def emitter3 (new SceneToEVG())
            def evgRoot:EVGElement (emitter3.buildPage(page3 page3 0.0 0.0 1.0))
            ; `buildPage` sizes the root 100%/100% because it is normally put
            ; inside a viewport. A document saved on its own has no viewport to
            ; be a percentage of, and everything downstream — measure, the PNG
            ; tool — then measures it against a guess. The page's own size is
            ; the answer, so it is written in.
            evgRoot.setAttribute("width" ((to_string (to_int page3.w)) + "px"))
            evgRoot.setAttribute("height" ((to_string (to_int page3.h)) + "px"))
            evgRoot.markInline("width")
            evgRoot.markInline("height")
            ; A Figma image lives inside the archive, and an EVG document
            ; resolves `src` against itself — so a page with pictures converted
            ; without them produces a document that cannot render. The bytes go
            ; out beside the document, under the names the paints already use.
            def wrote:int (FigCli.writeImages(doc3 (FigCli.dirOf(dest3))))
            if (wrote > 0) {
                print (("  " + (to_string wrote)) + " image(s) written beside it")
            }
            def text3:string (EVGTreeJson.toText(evgRoot))
            write_file (FigCli.dirOf(dest3)) (FigCli.nameOf(dest3)) text3
            print (("wrote " + dest3) + ((" (page " + (to_string want)) + (", " + page3.name) + ")"))
            return
        }

        ; And back: an editable document becomes a file Figma opens.
        if (cmd == "from-evg") {
            if (n < 3) {
                print "usage: fig_cli from-evg <in.evg.json> <out.fig>"
                return
            }
            def src4:string (shell_arg 1)
            def dest4:string (shell_arg 2)
            def text4@(optional):string (read_file (FigCli.dirOf(src4)) (FigCli.nameOf(src4)))
            if (null? text4) {
                print ("cannot read " + src4)
                return
            }
            def evg4@(optional):EVGElement (EVGTreeJson.fromText((unwrap text4)))
            if (null? evg4) {
                print (src4 + " is not an EVG document")
                return
            }
            def conv4 (new EvgToScene())
            def node4:SceneNode (conv4.build((unwrap evg4)))
            def bytes4:buffer (SceneToFig.writeNode(node4 (FigCli.nameOf(dest4))))
            buffer_write_file (FigCli.dirOf(dest4)) (FigCli.nameOf(dest4)) bytes4
            print ("wrote " + dest4 + " (" + (to_string (buffer_length bytes4)) + " bytes)")
            def wi:int 0
            while (wi < (array_length conv4.losses)) {
                print ("  lost  " + (itemAt conv4.losses wi))
                wi = (wi + 1)
            }
            return
        }

        if (cmd == "write-sample") {
            if (n < 2) {
                print "usage: fig_cli write-sample <out.fig>"
                return
            }
            def dest:string (shell_arg 1)
            def bytes:buffer (FigSample.buildFig())
            def dir:string (FigCli.dirOf(dest))
            def name:string (FigCli.nameOf(dest))
            buffer_write_file dir name bytes
            print ("wrote " + dest + " (" + (to_string (buffer_length bytes)) + " bytes)")
            return
        }
        if (cmd == "inspect") {
            if (n < 2) {
                print "usage: fig_cli inspect <file.fig|.deck>"
                return
            }
            def path:string (shell_arg 1)
            def dir:string (FigCli.dirOf(path))
            def name:string (FigCli.nameOf(path))
            def bytes:buffer (buffer_read_file dir name)
            def p (new FigParser())
            def doc:FigDoc (p.parseBytes(bytes name))
            FigCli.dump(doc)
            return
        }
        if (cmd == "fields") {
            if (n < 3) {
                print "usage: fig_cli fields <file.fig> <node-id>"
                return
            }
            def fpath:string (shell_arg 1)
            def fdir:string (FigCli.dirOf(fpath))
            def fname:string (FigCli.nameOf(fpath))
            def fbytes:buffer (buffer_read_file fdir fname)
            def fp (new FigParser())
            def fdoc:FigDoc (fp.parseBytes(fbytes fname))
            if (fdoc.ok == false) {
                print ("error: " + fdoc.err)
                return
            }
            def want:string (shell_arg 2)
            def nd:FigNode (fdoc.nodeById(want))
            if ((strlen nd.id) == 0) {
                print ("no node " + want)
                return
            }
            print (nd.typeName + "  " + nd.name + "  " + nd.id)
            def c:int 0
            while (c < (array_length nd.children)) {
                def ch:FigNode (itemAt nd.children c)
                print ("  child  " + ch.typeName + "  " + ch.name + "  " + ch.id)
                c = (c + 1)
            }
            print (nd.raw.toJson())
            return
        }
        print ("unknown command: " + cmd)
    }

    sfn dump:void (doc:FigDoc) {
        if (doc.ok == false) {
            print ("error: " + doc.err)
            return
        }
        print ("file     " + doc.fileName)
        print ("prelude  " + doc.prelude)
        print ("version  " + (to_string doc.version))
        print ("nodes    " + (to_string (array_length doc.nodes)))
        print ("pages    " + (to_string (array_length doc.pages)))
        print ("blobs    " + (to_string (array_length doc.blobs)))
        print ("images   " + (to_string (array_length doc.images)))
        print ("schema   " + (to_string doc.schemaCount) + " types")
        print ("zstd     " + (FigCli.yesno(doc.usedZstd)))
        print ("ms zip=" + (to_string doc.zipMs) + " inflate=" + (to_string doc.inflateMs) + " zstd=" + (to_string doc.zstdMs) + " schema=" + (to_string doc.schemaMs) + " decode=" + (to_string doc.decodeMs) + " tree=" + (to_string doc.treeMs) + " total=" + (to_string doc.totalMs))
        print ""
        def i:int 0
        while (i < (array_length doc.pages)) {
            def page:FigNode (itemAt doc.pages i)
            FigCli.dumpNode(page 0)
            i = (i + 1)
        }
    }

    sfn dumpNode:void (nd:FigNode depth:int) {
        def pad:string ""
        def d:int 0
        while (d < depth) {
            pad = (pad + "  ")
            d = (d + 1)
        }
        def extra:string ""
        if ((nd.w > 0.0) || (nd.h > 0.0)) {
            extra = ("  " + (to_string nd.w) + "x" + (to_string nd.h))
        }
        print (pad + nd.typeName + "  " + nd.name + "  " + nd.id + extra)
        def i:int 0
        while (i < (array_length nd.children)) {
            FigCli.dumpNode((itemAt nd.children i) (depth + 1))
            i = (i + 1)
        }
    }

    sfn yesno:string (v:boolean) {
        if v {
            return "yes"
        }
        return "no"
    }

    ; Every image in the archive, on disk next to the document. Returns how
    ; many, so the caller can say so rather than leave it to be discovered by a
    ; render that fails.
    sfn writeImages:int (doc:FigDoc dir:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length doc.images)) {
            def im:FigImage (itemAt doc.images i)
            if ((buffer_length im.bytes) > 0) {
                buffer_write_file dir im.name im.bytes
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn dirOf:string (path:string) {
        def n:int (strlen path)
        def last:int (0 - 1)
        def i:int 0
        while (i < n) {
            def c:int (charAt path i)
            if ((c == 47) || (c == 92)) {
                last = i
            }
            i = (i + 1)
        }
        if (last < 0) {
            return "."
        }
        if (last == 0) {
            return "/"
        }
        def out:string ""
        def j:int 0
        while (j < last) {
            out = (out + (strfromcode (charAt path j)))
            j = (j + 1)
        }
        return out
    }

    sfn nameOf:string (path:string) {
        def n:int (strlen path)
        def last:int (0 - 1)
        def i:int 0
        while (i < n) {
            def c:int (charAt path i)
            if ((c == 47) || (c == 92)) {
                last = i
            }
            i = (i + 1)
        }
        if (last < 0) {
            return path
        }
        def out:string ""
        def j:int (last + 1)
        while (j < n) {
            out = (out + (strfromcode (charAt path j)))
            j = (j + 1)
        }
        return out
    }
}

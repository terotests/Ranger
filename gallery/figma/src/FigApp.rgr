; SPDX-License-Identifier: AGPL-3.0-or-later

; Viewer: Figma bytes → SceneDocument → EVGElement → display list.
; Viewport pan/zoom is a root EVG transform. Painting never reads FigNode.

Import "FigParser.rgr"
Import "FigSample.rgr"
Import "KiwiValue.rgr"
Import "FigFieldReport.rgr"
Import "convert/FigToScene.rgr"
Import "evg/SceneToEVG.rgr"
Import "scene/SceneNode.rgr"
Import "scene/SceneAssets.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGColor.rgr"

class FigApp {
    def parser:FigParser (new FigParser())
    def converter:FigToScene (new FigToScene())
    def emitter:SceneToEVG (new SceneToEVG())
    def assets:SceneAssets (new SceneAssets())
    def doc:FigDoc (new FigDoc())
    def sceneDoc:SceneDocument (new SceneDocument())
    def evgRoot:EVGElement (EVGElement.createDiv())
    def list:EVGDisplayList (new EVGDisplayList())
    def evgDump:string ""
    ; The EVG tree as text is for the debug pane and the tests, and on a real
    ; board it is twelve megabytes of it. Built on every rebuild — so on
    ; every frame of a pan — it was most of what a pan cost and all of it was
    ; thrown away unread. Built when someone asks for it now.
    def dumpStale:boolean true
    ; The tree in `evgRoot` has been laid out at the current page size and
    ; matches the current scene. False until the first build, and whenever
    ; anything under the view changes.
    def laidOut:boolean false
    def layout:EVGLayout (new EVGLayout())
    def pageIndex:int 0
    def frameIndex:int (0 - 1)
    def selected:string ""
    def name:string ""
    def ok:boolean false
    def err:string ""
    def panX:double 40.0
    def panY:double 40.0
    def zoom:double 1.0
    def debug:boolean false
    def cmdCount:int 0
    def pageW:double 1200.0
    def pageH:double 800.0

    Constructor () {
        evgRoot = (EVGElement.createDiv())
    }

    fn openBytes:boolean (bytes:buffer fileName:string) {
        name = fileName
        doc = (parser.parseBytes(bytes fileName))
        ok = doc.ok
        err = doc.err
        pageIndex = 0
        frameIndex = (0 - 1)
        selected = ""
        if ok {
            this.convert()
            this.fit()
            this.rebuild()
        }
        return ok
    }

    fn openSample:boolean () {
        return (this.openBytes((FigSample.buildFig()) "sample.fig"))
    }

    fn openClipboardSample:boolean () {
        return (this.openBytes((FigSample.buildClipboard()) "clipboard"))
    }

    fn convert:void () {
        laidOut = false
        sceneDoc = (converter.convertDoc(doc))
        assets = (new SceneAssets())
        def i:int 0
        while (i < (array_length doc.images)) {
            def im:FigImage (itemAt doc.images i)
            assets.setImage(im.name im.name)
            i = (i + 1)
        }
        emitter.setAssets(assets)
    }

    fn pageCount:int () {
        return (array_length sceneDoc.pages)
    }

    fn currentPage:SceneNode () {
        return (sceneDoc.pageAt(pageIndex))
    }

    fn framesOnPage:[SceneNode] () {
        def page:SceneNode (this.currentPage())
        def out:[SceneNode]
        def i:int 0
        while (i < (array_length page.children)) {
            def ch:SceneNode (itemAt page.children i)
            if (ch.isFrameLike()) {
                push out ch
            }
            i = (i + 1)
        }
        return out
    }

    fn setPage:void (i:int) {
        def n:int (this.pageCount())
        if (n <= 0) {
            return
        }
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        pageIndex = i
        frameIndex = (0 - 1)
        selected = ""
        laidOut = false
        this.fit()
        this.rebuild()
    }

    fn setFrame:void (i:int) {
        frameIndex = i
        selected = ""
        laidOut = false
        this.fit()
        this.rebuild()
    }

    ; The ring is a command on top of the same tree.
    fn select:void (id:string) {
        selected = id
        this.repaint()
    }

    fn setDebug:void (on:boolean) {
        debug = on
        emitter.setDebug(on)
        laidOut = false
        this.rebuild()
    }

    fn setImageUrl:void (ref:string url:string) {
        assets.setImage(ref url)
        emitter.setAssets(assets)
        laidOut = false
        this.rebuild()
    }

    fn viewRoot:SceneNode () {
        def page:SceneNode (this.currentPage())
        if (frameIndex < 0) {
            return page
        }
        def frames:[SceneNode] (this.framesOnPage())
        if (frameIndex >= (array_length frames)) {
            return page
        }
        return (itemAt frames frameIndex)
    }

    ; What the view root covers. A page has no size of its own — its
    ; frames sit wherever they were drawn — so a page is measured as the
    ; union of its children, and fit/100% pan to that rather than to 0,0.
    fn contentBox:SceneNode (target:SceneNode) {
        def box (new SceneNode())
        box.x = target.x
        box.y = target.y
        box.w = target.w
        box.h = target.h
        if ((target.sourceType != "CANVAS") && (target.w >= 1.0)) {
            return box
        }
        def n:int (array_length target.children)
        if (n == 0) {
            box.w = 800.0
            box.h = 600.0
            return box
        }
        def minX:double 0.0
        def minY:double 0.0
        def maxX:double 0.0
        def maxY:double 0.0
        def i:int 0
        while (i < n) {
            def ch:SceneNode (itemAt target.children i)
            if ((i == 0) || (ch.x < minX)) {
                minX = ch.x
            }
            if ((i == 0) || (ch.y < minY)) {
                minY = ch.y
            }
            if ((i == 0) || ((ch.x + ch.w) > maxX)) {
                maxX = (ch.x + ch.w)
            }
            if ((i == 0) || ((ch.y + ch.h) > maxY)) {
                maxY = (ch.y + ch.h)
            }
            i = (i + 1)
        }
        box.x = minX
        box.y = minY
        box.w = (maxX - minX)
        box.h = (maxY - minY)
        return box
    }

    ; The canvas size in CSS pixels. The display list is built at this size,
    ; so the host paints it one to one; before this it was always 1200x800
    ; and stretched to whatever the canvas was, which squashed every frame.
    fn setViewport:void (w:double h:double) {
        if ((w < 1.0) || (h < 1.0)) {
            return
        }
        if ((w == pageW) && (h == pageH)) {
            return
        }
        pageW = w
        pageH = h
        laidOut = false
        this.rebuild()
    }

    fn fit:void () {
        def target:SceneNode (this.contentBox((this.viewRoot())))
        def w:double target.w
        def h:double target.h
        def ox:double target.x
        def oy:double target.y
        if (w < 1.0) {
            w = 800.0
        }
        if (h < 1.0) {
            h = 600.0
        }
        def sx:double ((pageW - 80.0) / w)
        def sy:double ((pageH - 80.0) / h)
        def sc:double sx
        if (sy < sc) {
            sc = sy
        }
        if (sc > 1.5) {
            sc = 1.5
        }
        if (sc < 0.1) {
            sc = 0.1
        }
        zoom = sc
        panX = (40.0 - (ox * zoom))
        panY = (40.0 - (oy * zoom))
    }

    fn zoom100:void () {
        def target:SceneNode (this.contentBox((this.viewRoot())))
        zoom = 1.0
        panX = (40.0 - target.x)
        panY = (40.0 - target.y)
        this.applyView()
    }

    fn setView:void (x:double y:double sc:double) {
        panX = x
        panY = y
        zoom = sc
        if (zoom < 0.05) {
            zoom = 0.05
        }
        if (zoom > 16.0) {
            zoom = 16.0
        }
        this.applyView()
    }

    ; The whole way down: the scene into an element tree, the tree laid out,
    ; the layout walked into a display list. Everything that changes what is
    ; on the page comes through here.
    fn rebuild:void () {
        if (ok == false) {
            return
        }
        emitter.setDebug(debug)
        emitter.setAssets(assets)
        def root:SceneNode (this.viewRoot())
        evgRoot = (emitter.buildPage(root (this.currentPage()) panX panY zoom))
        dumpStale = true
        layout = (new EVGLayout())
        layout.setPageSize(pageW pageH)
        layout.layout(evgRoot)
        laidOut = true
        this.repaint()
    }

    ; The walk, and only the walk. A selection ring or a new view changes
    ; which commands come out of a tree that is already built and already
    ; laid out, and rebuilding both for it was most of what a pan cost: on a
    ; board of 3,565 nodes, 1,230 ms a frame against 210 for the walk.
    fn repaint:void () {
        if (ok == false) {
            return
        }
        if (laidOut == false) {
            this.rebuild()
            return
        }
        list = (new EVGDisplayList())
        list.setTextEngine((layout.getTextEngine()))
        list.build(evgRoot)
        cmdCount = (array_length list.cmds)
        if ((strlen selected) > 0) {
            this.paintSelect()
        }
    }

    ; Pan and zoom move the pixels, not the boxes. The transform is one
    ; attribute on the world element and the layout underneath it does not
    ; change, so a view change writes that attribute and walks the tree
    ; again — no second element tree, no second layout.
    fn applyView:void () {
        if (ok == false) {
            return
        }
        if (laidOut == false) {
            this.rebuild()
            return
        }
        if ((evgRoot.getChildCount()) == 0) {
            this.rebuild()
            return
        }
        def world:EVGElement (evgRoot.getChild(0))
        world.setAttribute("transform" (SceneToEVG.viewTransform(panX panY zoom)))
        dumpStale = true
        this.repaint()
    }

    ; The ring around the selected layer. Its box has to be walked to, not
    ; read off the node: `x`/`y` are an offset from the PARENT, so a title
    ; twenty pixels into a card three thousand pixels across the board drew
    ; its ring at 20,16 — in the page's top-left corner, nowhere near the
    ; layer it was pointing at.
    fn paintSelect:void () {
        def n:SceneNode (this.absBox(selected))
        if ((strlen n.id) == 0) {
            return
        }
        def x:double ((n.x * zoom) + panX)
        def y:double ((n.y * zoom) + panY)
        def w:double (n.w * zoom)
        def h:double (n.h * zoom)
        ; A divider is a line: zero high, and a ring of no height is not a
        ; selection anyone can see.
        if (w < 2.0) {
            w = 2.0
        }
        if (h < 2.0) {
            h = 2.0
        }
        list.addFrame(x y w h 2.0 (EVGColor.rgb(59 130 246)))
        cmdCount = (array_length list.cmds)
    }

    ; A node's box in the coordinates the view is drawn in: its own offset
    ; plus every parent's, the same walk the hit test makes.
    fn absBox:SceneNode (id:string) {
        def box (new SceneNode())
        if ((strlen id) == 0) {
            return box
        }
        def found:boolean (this.absWalk((this.viewRoot()) 0.0 0.0 id box))
        return box
    }

    fn absWalk:boolean (n:SceneNode ox:double oy:double id:string box:SceneNode) {
        def nx:double (ox + n.x)
        def ny:double (oy + n.y)
        if (n.id == id) {
            box.id = n.id
            box.x = nx
            box.y = ny
            box.w = n.w
            box.h = n.h
            return true
        }
        def i:int 0
        while (i < (array_length n.children)) {
            def ch:SceneNode (itemAt n.children i)
            if (this.absWalk(ch nx ny id box)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn findScene:SceneNode (id:string) {
        return (this.findWalk((this.currentPage()) id))
    }

    fn findWalk:SceneNode (n:SceneNode id:string) {
        if (n.id == id) {
            return n
        }
        def i:int 0
        while (i < (array_length n.children)) {
            def ch:SceneNode (itemAt n.children i)
            def hit:SceneNode (this.findWalk(ch id))
            if ((strlen hit.id) > 0) {
                return hit
            }
            i = (i + 1)
        }
        return (new SceneNode())
    }

    fn sceneJson:string () {
        def body:string (list.toJson())
        return ("{\"width\":" + (to_string (to_int pageW)) + ",\"height\":" + (to_string (to_int pageH)) + ",\"list\":" + body + "}")
    }

    ; The same frame as typed arrays. A board is thousands of commands and
    ; tens of thousands of coordinates, and writing that as text — a number
    ; at a time — was most of what a pan cost: of 9.1 seconds of profile,
    ; `toJson` and the number formatting under it were 42%, and the garbage
    ; they made another 33%. The host reads these arrays as they are.
    ; `EVGSceneBinary` carries exactly what the JSON carried, to the
    ; hundredth, which is what lets the two be compared field by field.
    fn sceneBinary:EVGSceneBinary () {
        def bin:EVGSceneBinary (list.toBinary())
        bin.width = pageW
        bin.height = pageH
        return bin
    }

    fn sceneGraphJson:string () {
        return (sceneDoc.toJson())
    }

    fn evgText:string () {
        if dumpStale {
            evgDump = (emitter.dump(evgRoot))
            dumpStale = false
        }
        return evgDump
    }

    fn hit:string (x:double y:double) {
        def sx:double ((x - panX) / zoom)
        def sy:double ((y - panY) / zoom)
        def root:SceneNode (this.viewRoot())
        if (root.sourceType == "CANVAS") {
            return (this.hitWalk(root 0.0 0.0 sx sy ""))
        }
        return (this.hitWalk(root 0.0 0.0 sx sy ""))
    }

    fn hitWalk:string (n:SceneNode ox:double oy:double x:double y:double best:string) {
        def nx:double (ox + n.x)
        def ny:double (oy + n.y)
        def inside:boolean false
        if ((((x >= nx) && (x <= (nx + n.w))) && (y >= ny)) && (y <= (ny + n.h))) {
            inside = true
        }
        if (n.sourceType == "CANVAS") {
            inside = true
        }
        if inside {
            if ((n.sourceType != "CANVAS") && ((strlen n.id) > 0)) {
                best = n.id
            }
            def i:int 0
            while (i < (array_length n.children)) {
                def ch:SceneNode (itemAt n.children i)
                best = (this.hitWalk(ch nx ny x y best))
                i = (i + 1)
            }
        }
        return best
    }

    fn statsJson:string () {
        def o:string "{"
        o = (o + "\"ok\":")
        if ok {
            o = (o + "true")
        } {
            o = (o + "false")
        }
        o = (o + ",\"error\":\"" + (this.esc(err)) + "\"")
        o = (o + ",\"file\":\"" + (this.esc(doc.fileName)) + "\"")
        o = (o + ",\"prelude\":\"" + (this.esc(doc.prelude)) + "\"")
        o = (o + ",\"version\":" + (to_string doc.version))
        o = (o + ",\"nodes\":" + (to_string (array_length doc.nodes)))
        o = (o + ",\"pages\":" + (to_string (array_length doc.pages)))
        o = (o + ",\"blobs\":" + (to_string (array_length doc.blobs)))
        ; What the tree could not place. On a paste these are the copied
        ; layers and "adopted" should match; anywhere else a non-zero
        ; count is content the viewer parsed and did not draw.
        o = (o + ",\"orphans\":" + (to_string doc.orphanCount))
        o = (o + ",\"unrooted\":" + (to_string doc.unrootedCount))
        o = (o + ",\"adopted\":" + (to_string doc.adoptedCount))
        o = (o + ",\"images\":" + (to_string (array_length doc.images)))
        o = (o + ",\"schemaTypes\":" + (to_string doc.schemaCount))
        o = (o + ",\"cmds\":" + (to_string cmdCount))
        o = (o + ",\"debug\":")
        if debug {
            o = (o + "true")
        } {
            o = (o + "false")
        }
        o = (o + ",\"pasted\":")
        if doc.pasted {
            o = (o + "true")
        } {
            o = (o + "false")
        }
        o = (o + ",\"zstd\":")
        if doc.usedZstd {
            o = (o + "true")
        } {
            o = (o + "false")
        }
        o = (o + ",\"ms\":{")
        o = (o + "\"zip\":" + (to_string doc.zipMs))
        o = (o + ",\"inflate\":" + (to_string doc.inflateMs))
        o = (o + ",\"zstd\":" + (to_string doc.zstdMs))
        o = (o + ",\"schema\":" + (to_string doc.schemaMs))
        o = (o + ",\"decode\":" + (to_string doc.decodeMs))
        o = (o + ",\"tree\":" + (to_string doc.treeMs))
        o = (o + ",\"total\":" + (to_string doc.totalMs))
        o = (o + "}}")
        return o
    }

    fn pagesJson:string () {
        def o:string "["
        def i:int 0
        while (i < (array_length sceneDoc.pages)) {
            if (i > 0) {
                o = (o + ",")
            }
            def p:SceneNode (itemAt sceneDoc.pages i)
            o = (o + "{\"id\":\"" + (this.esc(p.id)) + "\",\"name\":\"" + (this.esc(p.name)) + "\",\"type\":\"" + (this.esc(p.sourceType)) + "\"}")
            i = (i + 1)
        }
        return (o + "]")
    }

    fn framesJson:string () {
        def frames:[SceneNode] (this.framesOnPage())
        def o:string "["
        def i:int 0
        while (i < (array_length frames)) {
            if (i > 0) {
                o = (o + ",")
            }
            def f:SceneNode (itemAt frames i)
            o = (o + "{\"id\":\"" + (this.esc(f.id)) + "\",\"name\":\"" + (this.esc(f.name)) + "\",\"w\":" + (to_string f.w) + ",\"h\":" + (to_string f.h) + "}")
            i = (i + 1)
        }
        return (o + "]")
    }

    fn treeJson:string () {
        def root:SceneNode (this.currentPage())
        return (this.nodeTree(root 0))
    }

    fn nodeTree:string (nd:SceneNode depth:int) {
        if (depth > 24) {
            return "{}"
        }
        def o:string "{\"id\":\""
        o = (o + (this.esc(nd.id)) + "\",\"name\":\"" + (this.esc(nd.name)))
        o = (o + "\",\"type\":\"" + (this.esc(nd.sourceType)) + "\"")
        o = (o + ",\"kind\":\"" + (this.esc(nd.kind)) + "\"")
        o = (o + ",\"w\":" + (to_string nd.w) + ",\"h\":" + (to_string nd.h))
        o = (o + ",\"children\":[")
        def i:int 0
        while (i < (array_length nd.children)) {
            if (i > 0) {
                o = (o + ",")
            }
            o = (o + (this.nodeTree((itemAt nd.children i) (depth + 1))))
            i = (i + 1)
        }
        return (o + "]}")
    }

    fn propsJson:string () {
        if ((strlen selected) == 0) {
            return "{}"
        }
        def nd:FigNode (doc.nodeById(selected))
        def sn:SceneNode (this.findScene(selected))
        def o:string "{"
        o = (o + "\"id\":\"" + (this.esc(selected)) + "\"")
        o = (o + ",\"figma\":{")
        o = (o + "\"name\":\"" + (this.esc(nd.name)) + "\"")
        o = (o + ",\"type\":\"" + (this.esc(nd.typeName)) + "\"")
        o = (o + ",\"x\":" + (to_string nd.m02) + ",\"y\":" + (to_string nd.m12))
        o = (o + ",\"w\":" + (to_string nd.w) + ",\"h\":" + (to_string nd.h))
        o = (o + "}")
        o = (o + ",\"scene\":" + (sn.toJson()))
        o = (o + ",\"evg\":\"" + (this.esc((this.evgText()))) + "\"")
        return (o + "}")
    }

    ; --- the inspector ---------------------------------------------------
    ;
    ; What the right-hand pane shows about the selected layer, and the
    ; values its fields write back. Small on purpose: `propsJson` carries
    ; the whole EVG dump, which is megabytes on a real board and not
    ; something to re-read on every keystroke.
    fn inspectJson:string () {
        if ((strlen selected) == 0) {
            return "{}"
        }
        def n:SceneNode (this.findScene(selected))
        if ((strlen n.id) == 0) {
            return "{}"
        }
        def box:SceneNode (this.absBox(selected))
        def nd:FigNode (doc.nodeById(selected))
        def o:string "{"
        o = (o + "\"id\":\"" + (this.esc(n.id)) + "\"")
        o = (o + ",\"name\":\"" + (this.esc(n.name)) + "\"")
        o = (o + ",\"kind\":\"" + (this.esc(n.kind)) + "\"")
        o = (o + ",\"source\":\"" + (this.esc(n.sourceType)) + "\"")
        o = (o + ",\"x\":" + (to_string n.x) + ",\"y\":" + (to_string n.y))
        o = (o + ",\"w\":" + (to_string n.w) + ",\"h\":" + (to_string n.h))
        o = (o + ",\"pageX\":" + (to_string box.x) + ",\"pageY\":" + (to_string box.y))
        o = (o + ",\"opacity\":" + (to_string n.opacity))
        o = (o + ",\"visible\":" + (FigApp.jsonBool(n.visible)))
        o = (o + ",\"clip\":" + (FigApp.jsonBool(n.clip)))
        o = (o + ",\"radius\":" + (to_string n.radius.tl))
        o = (o + ",\"radiusUniform\":" + (FigApp.jsonBool(n.radius.uniform)))
        o = (o + ",\"children\":" + (to_string (array_length n.children)))
        o = (o + ",\"hasPath\":" + (FigApp.jsonBool(((strlen n.pathData) > 0))))
        o = (o + ",\"image\":\"" + (this.esc(n.imageRef)) + "\"")
        if ((array_length n.fills) > 0) {
            def f:SceneFill (n.firstFill())
            o = (o + ",\"fill\":{\"kind\":\"" + f.kind + "\",\"hex\":\"" + (f.hex()) + "\"")
            o = (o + ",\"alpha\":" + (to_string (f.a * f.opacity)))
            o = (o + ",\"visible\":" + (FigApp.jsonBool(f.visible)) + "}")
        }
        if ((array_length n.strokes) > 0) {
            def st:SceneStroke (n.firstStroke())
            o = (o + ",\"stroke\":{\"hex\":\"" + (st.hex()) + "\",\"weight\":" + (to_string st.weight))
            o = (o + ",\"align\":\"" + st.align + "\"}")
        }
        if (n.kind == "text") {
            o = (o + ",\"text\":{\"chars\":\"" + (this.esc(n.text.characters)) + "\"")
            o = (o + ",\"family\":\"" + (this.esc(n.text.fontFamily)) + "\"")
            o = (o + ",\"size\":" + (to_string n.text.fontSize))
            o = (o + ",\"weight\":\"" + n.text.fontWeight + "\"")
            o = (o + ",\"style\":\"" + n.text.fontStyle + "\"")
            o = (o + ",\"lineHeight\":" + (to_string n.text.lineHeight))
            o = (o + ",\"letterSpacing\":" + (to_string n.text.letterSpacing))
            o = (o + ",\"align\":\"" + n.text.align + "\"")
            o = (o + ",\"outline\":" + (FigApp.jsonBool((n.text.hasOutline()))) + "}")
        }
        if (n.layout.isFlex()) {
            o = (o + ",\"layout\":{\"mode\":\"" + n.layout.mode + "\",\"gap\":" + (to_string n.layout.gap))
            o = (o + ",\"padding\":[" + (to_string n.layout.padT) + "," + (to_string n.layout.padR))
            o = (o + "," + (to_string n.layout.padB) + "," + (to_string n.layout.padL) + "]")
            o = (o + ",\"justify\":\"" + n.layout.justify + "\",\"align\":\"" + n.layout.alignItems + "\"}")
        }
        o = (o + ",\"effects\":[")
        def e:int 0
        while (e < (array_length n.effects)) {
            def fx:SceneEffect (itemAt n.effects e)
            if (e > 0) {
                o = (o + ",")
            }
            o = (o + "{\"kind\":\"" + fx.kind + "\",\"blur\":" + (to_string fx.blur))
            o = (o + ",\"x\":" + (to_string fx.x) + ",\"y\":" + (to_string fx.y))
            o = (o + ",\"hex\":\"" + (SceneFill.rgbHex(fx.r fx.g fx.b)) + "\"}")
            e = (e + 1)
        }
        o = (o + "]")
        o = (o + ",\"warnings\":[")
        def w:int 0
        while (w < (array_length n.warnings)) {
            def wn:SceneWarn (itemAt n.warnings w)
            if (w > 0) {
                o = (o + ",")
            }
            o = (o + "\"" + (this.esc(wn.feature)) + "\"")
            w = (w + 1)
        }
        o = (o + "]")
        ; What the file says about this node, for the fields the scene
        ; graph has no place for.
        o = (o + ",\"figma\":{\"type\":\"" + (this.esc(nd.typeName)) + "\"")
        o = (o + ",\"name\":\"" + (this.esc(nd.name)) + "\"}")
        o = (o + ",\"edits\":" + (to_string edits))
        return (o + "}")
    }

    sfn jsonBool:string (v:boolean) {
        if v {
            return "true"
        }
        return "false"
    }

    ; --- editing -----------------------------------------------------------
    ;
    ; The scene graph is a graph, not a picture: changing a value on it and
    ; painting again is the whole of an edit. Nothing is written back to
    ; the file — `revertEdits` re-reads the document it was converted from.
    def edits:int 0

    fn editNode:SceneNode () {
        return (this.findScene(selected))
    }

    fn editRect:void (x:double y:double w:double h:double) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        n.x = x
        n.y = y
        if (w >= 0.0) {
            n.w = w
        }
        if (h >= 0.0) {
            n.h = h
        }
        this.afterEdit()
    }

    fn editOpacity:void (v:double) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        if (v < 0.0) {
            v = 0.0
        }
        if (v > 1.0) {
            v = 1.0
        }
        n.opacity = v
        this.afterEdit()
    }

    fn editVisible:void (on:boolean) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        n.visible = on
        this.afterEdit()
    }

    fn editRadius:void (v:double) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        if (v < 0.0) {
            v = 0.0
        }
        n.radius.setAll(v)
        this.afterEdit()
    }

    ; A colour as "#rrggbb". The paint keeps its own alpha: a fill at 15%
    ; recoloured is still at 15%.
    fn editFill:void (hex:string) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        def f:SceneFill (new SceneFill())
        if ((array_length n.fills) > 0) {
            f = (itemAt n.fills 0)
        } {
            push n.fills f
        }
        f.kind = "solid"
        f.visible = true
        f.r = (FigApp.hexPart(hex 1))
        f.g = (FigApp.hexPart(hex 3))
        f.b = (FigApp.hexPart(hex 5))
        this.afterEdit()
    }

    fn editStroke:void (hex:string weight:double) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        def st:SceneStroke (new SceneStroke())
        if ((array_length n.strokes) > 0) {
            st = (itemAt n.strokes 0)
        } {
            push n.strokes st
        }
        st.visible = true
        st.r = (FigApp.hexPart(hex 1))
        st.g = (FigApp.hexPart(hex 3))
        st.b = (FigApp.hexPart(hex 5))
        if (weight >= 0.0) {
            st.weight = weight
        }
        this.afterEdit()
    }

    ; Retyping a layer drops the glyph outlines the editor shaped with it:
    ; those are the old string, drawn. What replaces them is the text laid
    ; out here, in whatever font this machine has — which is the honest
    ; result and says plainly which half of the pipeline drew it.
    fn editText:void (text:string) {
        def n:SceneNode (this.editNode())
        if ((strlen n.id) == 0) {
            return
        }
        n.text.characters = text
        n.text.outline = ""
        this.afterEdit()
    }

    fn revertEdits:void () {
        if (ok == false) {
            return
        }
        edits = 0
        this.convert()
        this.rebuild()
    }

    fn editCount:int () {
        return edits
    }

    ; An edit changes the scene, so the tree and its layout go with it.
    fn afterEdit:void () {
        edits = (edits + 1)
        laidOut = false
        this.rebuild()
    }

    ; One hex pair of "#rrggbb" as 0..1.
    sfn hexPart:double (hex:string at:int) {
        if ((strlen hex) < (at + 2)) {
            return 0.0
        }
        def hi:int (FigApp.hexDigit((charAt hex at)))
        def lo:int (FigApp.hexDigit((charAt hex (at + 1))))
        def v:int ((hi * 16) + lo)
        return ((to_double v) / 255.0)
    }

    sfn hexDigit:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return ((c - 97) + 10)
        }
        if ((c >= 65) && (c <= 70)) {
            return ((c - 65) + 10)
        }
        return 0
    }

    ; A census of the scene by Figma node type: how many of each, and how
    ; many of those put nothing on the canvas — no fill, no stroke, no
    ; path, no image, no text, and no children either. A type whose nodes
    ; mostly draw nothing is where a page that "does not look like Figma"
    ; is losing its content, and it points at a type rather than at a
    ; layer, which is what makes it worth counting.
    fn censusJson:string () {
        def types:[string]
        def totals:[int]
        def empties:[int]
        def missingImages:int 0
        def imageNodes:int 0
        def i:int 0
        while (i < (array_length sceneDoc.pages)) {
            missingImages = (missingImages + (this.censusWalk((itemAt sceneDoc.pages i) types totals empties)))
            i = (i + 1)
        }
        def o:string "{\"types\":["
        def j:int 0
        while (j < (array_length types)) {
            if (j > 0) {
                o = (o + ",")
            }
            o = (o + "{\"type\":\"" + (this.esc((itemAt types j))) + "\"")
            o = (o + ",\"nodes\":" + (to_string (itemAt totals j)))
            o = (o + ",\"drawNothing\":" + (to_string (itemAt empties j)) + "}")
            j = (j + 1)
        }
        o = (o + "],\"imagesMissing\":" + (to_string missingImages))
        ; What the instances brought with them. `seen` above `used` means
        ; overrides arrived and were not matched to a node in the
        ; component — the placeholder text would still be showing, and
        ; that is a different fault from having no overrides at all.
        o = (o + ",\"overridesSeen\":" + (to_string converter.overridesSeen))
        o = (o + ",\"overridesUsed\":" + (to_string converter.overridesUsed))
        o = (o + ",\"overridesUnplaced\":" + (to_string (converter.overridesSeen - converter.overridesUsed)))
        return (o + "}")
    }

    ; Returns how many image references had no bytes behind them.
    fn censusWalk:int (n:SceneNode types:[string] totals:[int] empties:[int]) {
        def missing:int 0
        def key:string n.sourceType
        if ((strlen key) == 0) {
            key = n.kind
        }
        def at:int (0 - 1)
        def i:int 0
        while (i < (array_length types)) {
            if ((itemAt types i) == key) {
                at = i
            }
            i = (i + 1)
        }
        if (at < 0) {
            push types key
            push totals 0
            push empties 0
            at = ((array_length types) - 1)
        }
        set totals at ((itemAt totals at) + 1)
        if ((array_length n.children) == 0) {
            if (FigToScene.drawsNothing(n)) {
                set empties at ((itemAt empties at) + 1)
            }
        }
        if ((strlen n.imageRef) > 0) {
            if ((assets.hasImage(n.imageRef)) == false) {
                missing = (missing + 1)
            }
        }
        def c:int 0
        while (c < (array_length n.children)) {
            missing = (missing + (this.censusWalk((itemAt n.children c) types totals empties)))
            c = (c + 1)
        }
        return missing
    }

    ; Everything the file carries that the converter never reads, counted.
    ; A warning can only report a case someone thought of; when a page comes
    ; out wrong and nothing is reported, what is missing is by definition
    ; what nobody wrote a warning for. This asks it the other way round.
    fn unreadJson:string () {
        def rep (new FigFieldReport())
        rep.scan(doc)
        def o:string "["
        def i:int 0
        while (i < (array_length rep.uses)) {
            if (i > 0) {
                o = (o + ",")
            }
            def u:FigFieldUse (itemAt rep.uses i)
            o = (o + "{\"field\":\"" + (this.esc(u.name)) + "\"")
            o = (o + ",\"count\":" + (to_string u.count))
            o = (o + ",\"note\":\"" + (this.esc(u.note)) + "\"")
            o = (o + ",\"id\":\"" + (this.esc(u.exampleId)) + "\"")
            o = (o + ",\"name\":\"" + (this.esc(u.exampleName)) + "\"}")
            i = (i + 1)
        }
        return (o + "]")
    }

    fn warningsJson:string () {
        def o:string "["
        def i:int 0
        while (i < (array_length sceneDoc.warnings)) {
            if (i > 0) {
                o = (o + ",")
            }
            def w:SceneWarn (itemAt sceneDoc.warnings i)
            o = (o + "{\"id\":\"" + (this.esc(w.nodeId)) + "\",\"name\":\"" + (this.esc(w.nodeName)) + "\",\"feature\":\"" + (this.esc(w.feature)) + "\"}")
            i = (i + 1)
        }
        return (o + "]")
    }

    fn imageCount:int () {
        return (array_length doc.images)
    }

    fn imageName:string (i:int) {
        if ((i < 0) || (i >= (array_length doc.images))) {
            return ""
        }
        def im:FigImage (itemAt doc.images i)
        return im.name
    }

    fn imageBytes:buffer (name:string) {
        def im:FigImage (doc.imageByName(name))
        return im.bytes
    }

    fn esc:string (s:string) {
        def v (new KiwiValue())
        return (v.jsonEscape(s))
    }
}

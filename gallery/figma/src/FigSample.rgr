        def f12:KiwiValue (FigSample.node(3 12 "FRAME" "12-nested-frame" 0 3 "L" 200.0 160.0 760.0 380.0))
        f12.put("fillPaints" (FigSample.paints(0.94 0.95 0.97)))
        nodes.pushItem(f12)
        def inner:KiwiValue (FigSample.node(3 29 "FRAME" "Inner" 3 12 "!" 140.0 100.0 30.0 30.0))
        inner.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        inner.put("cornerRadius" (KiwiValue.fromDouble(8.0)))
        nodes.pushItem(inner)
        def innr:KiwiValue (FigSample.node(3 30 "RECTANGLE" "InnerRect" 3 29 "!" 80.0 40.0 20.0 20.0))
        innr.put("fillPaints" (FigSample.paints(0.145 0.388 0.922)))
        nodes.pushItem(innr)
        def f13:KiwiValue (FigSample.node(3 13 "FRAME" "13-rotation" 0 3 "M" 200.0 160.0 40.0 600.0))
        f13.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        nodes.pushItem(f13)
        def r13:KiwiValue (FigSample.node(3 31 "RECTANGLE" "Tilt" 3 13 "!" 80.0 48.0 50.0 50.0))
        r13.put("fillPaints" (FigSample.paints(0.976 0.451 0.086)))
        r13.put("transform" (FigSample.xformRot(50.0 50.0 0.965925826289 0.258819045103)))
        nodes.pushItem(r13)
        def f14:KiwiValue (FigSample.node(3 14 "FRAME" "14-shadow" 0 3 "N" 200.0 140.0 280.0 600.0))
        f14.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        nodes.pushItem(f14)
        def r14:KiwiValue (FigSample.node(3 32 "RECTANGLE" "Shade" 3 14 "!" 120.0 72.0 40.0 34.0))
        r14.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        r14.put("cornerRadius" (KiwiValue.fromDouble(8.0)))
        r14.put("effects" (FigSample.dropShadow()))
        nodes.pushItem(r14)
        def f15:KiwiValue (FigSample.node(3 15 "FRAME" "15-gradient" 0 3 "O" 200.0 140.0 520.0 600.0))
        f15.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        nodes.pushItem(f15)

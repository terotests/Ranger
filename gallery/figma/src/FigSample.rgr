        ir.put("fillPaints" (FigSample.paints(0.078 0.722 0.651)))
        nodes.pushItem(ir)
        ; The shape a real Figma export uses: an instance with no children
        ; of its own, naming the component whose subtree it draws. Without
        ; that lookup this node paints an empty box, which is what every
        ; file built out of components did.
        def fInst2:KiwiValue (FigSample.node(3 40 "INSTANCE" "LinkedInstance" 0 3 "S" 200.0 80.0 540.0 800.0))
        fInst2.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        fInst2.put("symbolID" (FigSample.guid(3 36)))
        nodes.pushItem(fInst2)
        ; A component with text in it, and an instance that changes that
        ; text. Reading the component but not the change is what leaves a
        ; real file showing the designer's placeholder everywhere.
        def tComp:KiwiValue (FigSample.node(3 46 "COMPONENT" "CardWithTitle" 0 3 "Y" 220.0 80.0 1380.0 800.0))
        tComp.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        nodes.pushItem(tComp)
        def tTitle:KiwiValue (FigSample.node(3 47 "TEXT" "Title" 3 46 "!" 180.0 24.0 20.0 20.0))
        def tTd:KiwiValue (KiwiValue.fromObject())
        tTd.put("characters" (KiwiValue.fromString("Title text")))
        tTitle.put("textData" tTd)
        tTitle.put("fontSize" (KiwiValue.fromDouble(18.0)))
        nodes.pushItem(tTitle)
        def tInst:KiwiValue (FigSample.node(3 48 "INSTANCE" "TitledInstance" 0 3 "Z" 220.0 80.0 1620.0 800.0))
        tInst.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        def tSym:KiwiValue (KiwiValue.fromObject())
        tSym.put("symbolID" (FigSample.guid(3 46)))
        tInst.put("symbolData" tSym)
        def overrides:KiwiValue (KiwiValue.fromArray())
        def ov:KiwiValue (KiwiValue.fromObject())
        def ovPath:KiwiValue (KiwiValue.fromObject())
        def ovGuids:KiwiValue (KiwiValue.fromArray())
        ovGuids.pushItem((FigSample.guid(3 47)))
        ovPath.put("guids" ovGuids)
        ov.put("guidPath" ovPath)
        def ovTd:KiwiValue (KiwiValue.fromObject())
        ovTd.put("characters" (KiwiValue.fromString("The real text")))
        ov.put("textData" ovTd)
        ov.put("fillPaints" (FigSample.paints(0.05 0.4 0.75)))
        overrides.pushItem(ov)
        tInst.put("derivedSymbolData" overrides)
        nodes.pushItem(tInst)

        ; A component inside a component, and an override that reaches
        ; through both. This is the shape a real file is made of and the
        ; one that was failing: the path names the nested instance first
        ; and the node inside it second, so a reader matching on the last
        ; guid alone, or dropping the outer table on the way in, places
        ; almost nothing.
        def inner:KiwiValue (FigSample.node(3 50 "COMPONENT" "InnerCard" 0 3 "a" 200.0 40.0 1860.0 800.0))
        inner.put("fillPaints" (FigSample.paints(0.95 0.95 0.96)))
        nodes.pushItem(inner)
        def innerText:KiwiValue (FigSample.node(3 51 "TEXT" "InnerTitle" 3 50 "!" 180.0 24.0 10.0 8.0))
        def innerTd:KiwiValue (KiwiValue.fromObject())
        innerTd.put("characters" (KiwiValue.fromString("Inner placeholder")))
        innerText.put("textData" innerTd)
        nodes.pushItem(innerText)
        def wrapper:KiwiValue (FigSample.node(3 52 "COMPONENT" "WrapperCard" 0 3 "b" 220.0 60.0 2100.0 800.0))
        wrapper.put("fillPaints" (FigSample.paints(0.92 0.94 0.98)))
        nodes.pushItem(wrapper)
        def nestedInst:KiwiValue (FigSample.node(3 53 "INSTANCE" "InnerInstance" 3 52 "!" 200.0 40.0 10.0 10.0))
        def nestedSym:KiwiValue (KiwiValue.fromObject())
        nestedSym.put("symbolID" (FigSample.guid(3 50)))
        nestedInst.put("symbolData" nestedSym)
        nodes.pushItem(nestedInst)
        def outer:KiwiValue (FigSample.node(3 54 "INSTANCE" "NestedOverride" 0 3 "c" 220.0 60.0 2340.0 800.0))
        def outerSym:KiwiValue (KiwiValue.fromObject())
        outerSym.put("symbolID" (FigSample.guid(3 52)))
        outer.put("symbolData" outerSym)
        def deepOverrides:KiwiValue (KiwiValue.fromArray())
        def deep:KiwiValue (KiwiValue.fromObject())
        def deepPath:KiwiValue (KiwiValue.fromObject())
        def deepGuids:KiwiValue (KiwiValue.fromArray())
        deepGuids.pushItem((FigSample.guid(3 53)))
        deepGuids.pushItem((FigSample.guid(3 51)))
        deepPath.put("guids" deepGuids)
        deep.put("guidPath" deepPath)
        def deepTd:KiwiValue (KiwiValue.fromObject())
        deepTd.put("characters" (KiwiValue.fromString("Deep real text")))
        deep.put("textData" deepTd)
        deepOverrides.pushItem(deep)
        outer.put("derivedSymbolData" deepOverrides)
        nodes.pushItem(outer)

        ; A component that is a single shape — an icon, a divider — is a
        ; normal thing to have. Its instance has nothing to borrow and
        ; nothing is missing, so it must not be reported as unsupported.
        def leaf:KiwiValue (FigSample.node(3 42 "COMPONENT" "LeafComponent" 0 3 "U" 60.0 60.0 1060.0 800.0))
        leaf.put("fillPaints" (FigSample.paints(0.9 0.4 0.2)))
        nodes.pushItem(leaf)
        def leafInst:KiwiValue (FigSample.node(3 43 "INSTANCE" "LeafInstance" 0 3 "V" 60.0 60.0 1140.0 800.0))
        leafInst.put("fillPaints" (FigSample.paints(0.9 0.4 0.2)))
        def leafSym:KiwiValue (KiwiValue.fromObject())
        leafSym.put("symbolID" (FigSample.guid(3 42)))
        leafInst.put("symbolData" leafSym)
        nodes.pushItem(leafInst)
        ; An outside-aligned stroke whose own outline came with the file.
        ; Nothing is approximated here, so nothing is reported.
        def exact:KiwiValue (FigSample.node(3 44 "RECTANGLE" "ExactStroke" 0 3 "W" 60.0 60.0 1220.0 800.0))
        exact.put("strokePaints" (FigSample.paints(0.1 0.1 0.1)))
        exact.put("strokeWeight" (KiwiValue.fromDouble(4.0)))
        exact.put("strokeAlign" (KiwiValue.fromString("OUTSIDE")))
        exact.put("borderStrokeWeightsIndependent" (KiwiValue.fromBool(true)))
        def sgeom:KiwiValue (KiwiValue.fromArray())
        def sg0:KiwiValue (KiwiValue.fromObject())
        sg0.put("commandsBlob" (KiwiValue.fromInt(0)))
        sgeom.pushItem(sg0)
        exact.put("strokeGeometry" sgeom)
        nodes.pushItem(exact)
        ; The same stroke without that outline: an approximation, and said.
        def guessed:KiwiValue (FigSample.node(3 45 "RECTANGLE" "GuessedStroke" 0 3 "X" 60.0 60.0 1300.0 800.0))
        guessed.put("strokePaints" (FigSample.paints(0.1 0.1 0.1)))
        guessed.put("strokeWeight" (KiwiValue.fromDouble(4.0)))
        guessed.put("strokeAlign" (KiwiValue.fromString("OUTSIDE")))
        nodes.pushItem(guessed)

        ; The shape a Figma export actually writes: the guid is inside a
        ; symbolData block, not on the node. Reading only the flat spelling
        ; left every instance in a real file empty.
        def fInst3:KiwiValue (FigSample.node(3 41 "INSTANCE" "NestedInstance" 0 3 "T" 200.0 80.0 800.0 800.0))
        fInst3.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        def symBlock:KiwiValue (KiwiValue.fromObject())
        symBlock.put("symbolID" (FigSample.guid(3 36)))
        fInst3.put("symbolData" symBlock)
        nodes.pushItem(fInst3)
        ; A variant set: two components, and an instance that names the
        ; first and is swapped to the second. `overriddenSymbolID` is an
        ; override of the symbol the instance names, so it has to beat the
        ; name rather than fill in for a missing one.
        def varA:KiwiValue (FigSample.node(3 65 "COMPONENT" "VariantA" 0 3 "h" 200.0 40.0 3640.0 800.0))
        varA.put("fillPaints" (FigSample.paints(0.9 0.9 0.95)))
        nodes.pushItem(varA)
        def varAText:KiwiValue (FigSample.node(3 66 "TEXT" "VariantLabel" 3 65 "!" 180.0 24.0 10.0 8.0))
        varAText.put("textData" (FigSample.chars("Placeholder artwork")))
        nodes.pushItem(varAText)
        def varB:KiwiValue (FigSample.node(3 67 "COMPONENT" "VariantB" 0 3 "i" 200.0 40.0 3880.0 800.0))
        varB.put("fillPaints" (FigSample.paints(0.9 0.95 0.9)))
        nodes.pushItem(varB)
        def varBText:KiwiValue (FigSample.node(3 68 "TEXT" "VariantLabel" 3 67 "!" 180.0 24.0 10.0 8.0))
        varBText.put("textData" (FigSample.chars("You are here")))
        nodes.pushItem(varBText)
        def swapInst:KiwiValue (FigSample.node(3 69 "INSTANCE" "SwappedInstance" 0 3 "j" 200.0 40.0 4120.0 800.0))
        def swapSym:KiwiValue (KiwiValue.fromObject())
        swapSym.put("symbolID" (FigSample.guid(3 65)))
        swapInst.put("symbolData" swapSym)
        swapInst.put("overriddenSymbolID" (FigSample.guid(3 67)))
        nodes.pushItem(swapInst)

        ; A masking layer: the rectangle cuts the layers ABOVE it in the
        ; same parent down to its own shape. The wide bar below is twice
        ; the mask's width, so a reader that ignores the flag draws it
        ; running out of the group — and draws the mask itself, which
        ; Figma never does.
        def maskGroup:KiwiValue (FigSample.node(3 70 "FRAME" "MaskedGroup" 0 3 "k" 200.0 100.0 4360.0 800.0))
        nodes.pushItem(maskGroup)
        def maskRect:KiwiValue (FigSample.node(3 71 "RECTANGLE" "MaskShape" 3 70 "!" 80.0 80.0 10.0 10.0))
        maskRect.put("fillPaints" (FigSample.paints(0.0 0.0 0.0)))
        maskRect.put("mask" (KiwiValue.fromBool(true)))
        nodes.pushItem(maskRect)
        def maskedBar:KiwiValue (FigSample.node(3 72 "RECTANGLE" "MaskedBar" 3 70 "#" 160.0 40.0 10.0 30.0))
        maskedBar.put("fillPaints" (FigSample.paints(0.2 0.6 0.9)))
        nodes.pushItem(maskedBar)

        ; The arc tool: a three-quarter ring. Drawn as its whole ellipse
        ; — which is what a reader that skips `arcData` does — this is a
        ; filled circle with no hole and no missing quarter.
        def arc:KiwiValue (FigSample.node(3 73 "ELLIPSE" "ArcRing" 0 3 "l" 100.0 100.0 4600.0 800.0))
        arc.put("fillPaints" (FigSample.paints(0.95 0.45 0.1)))
        def arcData:KiwiValue (KiwiValue.fromObject())
        arcData.put("startingAngle" (KiwiValue.fromDouble(0.0)))
        arcData.put("endingAngle" (KiwiValue.fromDouble(4.71238898038469)))
        arcData.put("innerRadius" (KiwiValue.fromDouble(0.5)))
        arc.put("arcData" arcData)
        nodes.pushItem(arc)

        ; A table row: a rule under it and nothing on the other three
        ; sides. Drawn at the node's single `strokeWeight` it comes out
        ; boxed, which is a different drawing rather than a near miss.
        def row:KiwiValue (FigSample.node(3 74 "RECTANGLE" "TableRow" 0 3 "m" 200.0 40.0 4840.0 800.0))
        row.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        row.put("strokePaints" (FigSample.paints(0.8 0.8 0.82)))
        row.put("strokeWeight" (KiwiValue.fromDouble(1.0)))
        row.put("strokeAlign" (KiwiValue.fromString("INSIDE")))
        row.put("borderStrokeWeightsIndependent" (KiwiValue.fromBool(true)))
        row.put("borderTopWeight" (KiwiValue.fromDouble(0.0)))
        row.put("borderRightWeight" (KiwiValue.fromDouble(0.0)))
        row.put("borderBottomWeight" (KiwiValue.fromDouble(2.0)))
        row.put("borderLeftWeight" (KiwiValue.fromDouble(0.0)))
        nodes.pushItem(row)

        ; Tracking: the designer tightened this heading. Drawn at the
        ; font's own spacing it is a few per cent wider than the box the
        ; file sized for it.
        def tracked:KiwiValue (FigSample.node(3 75 "TEXT" "TrackedHeading" 0 3 "n" 300.0 40.0 5080.0 800.0))
        tracked.put("textData" (FigSample.chars("TIGHT HEADING")))
        tracked.put("fontSize" (KiwiValue.fromDouble(24.0)))
        tracked.put("letterSpacing" (KiwiValue.fromDouble(0.0 - 1.5)))
        nodes.pushItem(tracked)

        ; --- FigJam ---------------------------------------------------
        ;
        ; A sticky has no children. Its look is two lists that pair by
        ; guidPath: the geometry, and the paints and text for the same
        ; layers. A reader that stops at the node draws an empty box.
        def sticky:KiwiValue (FigSample.node(3 60 "STICKY" "Sticky" 0 3 "d" 240.0 240.0 2580.0 800.0))
        def stGeom:KiwiValue (KiwiValue.fromArray())
        def stBody:KiwiValue (KiwiValue.fromObject())
        stBody.put("guidPath" (FigSample.path1(40000000 0)))
        stBody.put("size" (FigSample.vec(240.0 240.0)))
        stBody.put("transform" (FigSample.xform(0.0 0.0)))
        stBody.put("fillGeometry" (FigSample.geomBlob(0)))
        stGeom.pushItem(stBody)
        def stTextGeom:KiwiValue (KiwiValue.fromObject())
        stTextGeom.put("guidPath" (FigSample.path1(40000000 1)))
        stTextGeom.put("size" (FigSample.vec(200.0 48.0)))
        stTextGeom.put("transform" (FigSample.xform(20.0 20.0)))
        stGeom.pushItem(stTextGeom)
        def stAuthorGeom:KiwiValue (KiwiValue.fromObject())
        stAuthorGeom.put("guidPath" (FigSample.path1(40000000 2)))
        stAuthorGeom.put("size" (FigSample.vec(200.0 16.0)))
        stAuthorGeom.put("transform" (FigSample.xform(0.0 0.0)))
        stGeom.pushItem(stAuthorGeom)
        def stFrame:KiwiValue (KiwiValue.fromObject())
        stFrame.put("overrides" stGeom)
        sticky.put("derivedImmutableFrameData" stFrame)
        def stStyles:KiwiValue (KiwiValue.fromArray())
        def stBodyStyle:KiwiValue (KiwiValue.fromObject())
        stBodyStyle.put("guidPath" (FigSample.path1(40000000 0)))
        stBodyStyle.put("fillPaints" (FigSample.paints(0.576 0.89 0.588)))
        stStyles.pushItem(stBodyStyle)
        def stTextStyle:KiwiValue (KiwiValue.fromObject())
        stTextStyle.put("guidPath" (FigSample.path1(40000000 1)))
        stTextStyle.put("textData" (FigSample.chars("Sticky text")))
        stTextStyle.put("fillPaints" (FigSample.paints(0.2 0.2 0.2)))
        stTextStyle.put("fontSize" (KiwiValue.fromDouble(16.0)))
        stStyles.pushItem(stTextStyle)
        ; The author's name is a layer like any other, and the file says
        ; it is switched off.
        def stAuthorStyle:KiwiValue (KiwiValue.fromObject())
        stAuthorStyle.put("guidPath" (FigSample.path1(40000000 2)))
        stAuthorStyle.put("textData" (FigSample.chars("Author")))
        stAuthorStyle.put("visible" (KiwiValue.fromBool(false)))
        stStyles.pushItem(stAuthorStyle)
        def stGen:KiwiValue (KiwiValue.fromObject())
        stGen.put("overrides" stStyles)
        sticky.put("nodeGenerationData" stGen)
        nodes.pushItem(sticky)

        ; A table, where the first guid on a path names the layer and the
        ; rest name the cell: a cell's background and its text share a path
        ; TAIL and not a prefix, so the text is placed against the entry
        ; with the same tail. Get that wrong and every cell's text piles up
        ; in the table's first cell.
        def table:KiwiValue (FigSample.node(3 61 "TABLE" "Table" 0 3 "e" 200.0 40.0 2860.0 800.0))
        def tbGeom:KiwiValue (KiwiValue.fromArray())
        def cellA:KiwiValue (KiwiValue.fromObject())
        cellA.put("guidPath" (FigSample.path2(40000000 0 9 1)))
        cellA.put("size" (FigSample.vec(100.0 40.0)))
        cellA.put("transform" (FigSample.xform(0.0 0.0)))
        cellA.put("fillGeometry" (FigSample.geomBlob(0)))
        tbGeom.pushItem(cellA)
        def cellB:KiwiValue (KiwiValue.fromObject())
        cellB.put("guidPath" (FigSample.path2(40000000 0 9 2)))
        cellB.put("size" (FigSample.vec(100.0 40.0)))
        cellB.put("transform" (FigSample.xform(100.0 0.0)))
        cellB.put("fillGeometry" (FigSample.geomBlob(0)))
        tbGeom.pushItem(cellB)
        def cellBText:KiwiValue (KiwiValue.fromObject())
        cellBText.put("guidPath" (FigSample.path2(40000000 1 9 2)))
        cellBText.put("size" (FigSample.vec(80.0 20.0)))
        cellBText.put("transform" (FigSample.xform(10.0 10.0)))
        tbGeom.pushItem(cellBText)
        def tbFrame:KiwiValue (KiwiValue.fromObject())
        tbFrame.put("overrides" tbGeom)
        table.put("derivedImmutableFrameData" tbFrame)
        def tbStyles:KiwiValue (KiwiValue.fromArray())
        def cellAStyle:KiwiValue (KiwiValue.fromObject())
        cellAStyle.put("guidPath" (FigSample.path2(40000000 0 9 1)))
        cellAStyle.put("fillPaints" (FigSample.paints(0.95 0.95 0.95)))
        tbStyles.pushItem(cellAStyle)
        def cellBStyle:KiwiValue (KiwiValue.fromObject())
        cellBStyle.put("guidPath" (FigSample.path2(40000000 0 9 2)))
        cellBStyle.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        tbStyles.pushItem(cellBStyle)
        def cellBTextStyle:KiwiValue (KiwiValue.fromObject())
        cellBTextStyle.put("guidPath" (FigSample.path2(40000000 1 9 2)))
        cellBTextStyle.put("textData" (FigSample.chars("Cell two")))
        cellBTextStyle.put("fillPaints" (FigSample.paints(0.1 0.1 0.1)))
        tbStyles.pushItem(cellBTextStyle)
        def tbGen:KiwiValue (KiwiValue.fromObject())
        tbGen.put("overrides" tbStyles)
        table.put("nodeGenerationData" tbGen)
        nodes.pushItem(table)

        ; A component out of a library: the copy carries new guids and the
        ; override paths still name the old ones, which every node keeps in
        ; `overrideKey`. And two lists — what the designer typed, and what
        ; Figma computed from it — because the text is only in the first
        ; and the size the instance laid it out at only in the second.
        def kComp:KiwiValue (FigSample.node(3 62 "COMPONENT" "KeyedCard" 0 3 "f" 220.0 80.0 3120.0 800.0))
        kComp.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        kComp.put("overrideKey" (FigSample.guid(1 899)))
        nodes.pushItem(kComp)
        def kText:KiwiValue (FigSample.node(3 63 "TEXT" "KeyedTitle" 3 62 "!" 180.0 24.0 20.0 20.0))
        kText.put("textData" (FigSample.chars("Keyed placeholder")))
        kText.put("overrideKey" (FigSample.guid(1 900)))
        nodes.pushItem(kText)
        def kInst:KiwiValue (FigSample.node(3 64 "INSTANCE" "KeyedInstance" 0 3 "g" 220.0 80.0 3380.0 800.0))
        def kSym:KiwiValue (KiwiValue.fromObject())
        kSym.put("symbolID" (FigSample.guid(3 62)))
        def kEdits:KiwiValue (KiwiValue.fromArray())
        def kEdit:KiwiValue (KiwiValue.fromObject())
        kEdit.put("guidPath" (FigSample.path1(1 900)))
        kEdit.put("textData" (FigSample.chars("Typed by hand")))
        kEdits.pushItem(kEdit)
        kSym.put("symbolOverrides" kEdits)
        kInst.put("symbolData" kSym)
        def kDerived:KiwiValue (KiwiValue.fromArray())
        def kDer:KiwiValue (KiwiValue.fromObject())
        kDer.put("guidPath" (FigSample.path1(1 900)))
        kDer.put("size" (FigSample.vec(180.0 44.0)))
        kDerived.pushItem(kDer)
        kInst.put("derivedSymbolData" kDerived)
        nodes.pushItem(kInst)

        def blobs:KiwiValue (KiwiValue.fromArray())
        def blob0:KiwiValue (KiwiValue.fromObject())
        blob0.put("bytes" (KiwiValue.fromBytes((FigSample.triangleBlob()))))
        blobs.pushItem(blob0)
        def root:KiwiValue (KiwiValue.fromObject())
        root.put("nodeChanges" nodes)
        root.put("blobs" blobs)
        return root
    }

    sfn png1x1:buffer () {
        def b:[int]
        push b 137
        push b 80
        push b 78
        push b 71
        push b 13
        push b 10
        push b 26
        push b 10
        push b 0
        push b 0
        push b 0
        push b 13
        push b 73
        push b 72
        push b 68
        push b 82
        push b 0
        push b 0
        push b 0
        push b 1
        push b 0
        push b 0
        push b 0
        push b 1
        push b 8
        push b 2
        push b 0
        push b 0
        push b 0
        push b 144
        push b 119
        push b 83
        push b 222
        push b 0
        push b 0
        push b 0
        push b 12
        push b 73
        push b 68
        push b 65
        push b 84
        push b 8
        push b 215
        push b 99
        push b 248
        push b 207
        push b 192
        push b 0

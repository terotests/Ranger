        r15.put("fillPaints" (FigSample.gradient(0.145 0.388 0.922 0.545 0.361 0.965)))
        r15.put("cornerRadius" (KiwiValue.fromDouble(12.0)))
        nodes.pushItem(r15)
        def fLine:KiwiValue (FigSample.node(3 34 "FRAME" "line-wrap" 0 3 "P" 200.0 80.0 760.0 600.0))
        fLine.put("fillPaints" (FigSample.paints(1.0 1.0 1.0)))
        nodes.pushItem(fLine)

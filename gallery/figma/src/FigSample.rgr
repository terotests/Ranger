        ln.put("strokePaints" (FigSample.paints(0.15 0.18 0.22)))
        ln.put("strokeWeight" (KiwiValue.fromDouble(3.0)))
        nodes.pushItem(ln)
        def fComp:KiwiValue (FigSample.node(3 36 "COMPONENT" "CardComponent" 0 3 "Q" 200.0 80.0 40.0 800.0))
        fComp.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        nodes.pushItem(fComp)
        def cr:KiwiValue (FigSample.node(3 37 "RECTANGLE" "CompRect" 3 36 "!" 160.0 48.0 20.0 16.0))
        cr.put("fillPaints" (FigSample.paints(0.078 0.722 0.651)))
        nodes.pushItem(cr)
        def fInst:KiwiValue (FigSample.node(3 38 "INSTANCE" "CardInstance" 0 3 "R" 200.0 80.0 280.0 800.0))
        fInst.put("fillPaints" (FigSample.paints(0.97 0.97 0.98)))
        nodes.pushItem(fInst)
        def ir:KiwiValue (FigSample.node(3 39 "RECTANGLE" "InstRect" 3 38 "!" 160.0 48.0 20.0 16.0))
        ir.put("fillPaints" (FigSample.paints(0.078 0.722 0.651)))
        nodes.pushItem(ir)
        def blobs:KiwiValue (KiwiValue.fromArray())
        def blob0:KiwiValue (KiwiValue.fromObject())
        blob0.put("bytes" (KiwiValue.fromBytes((FigSample.triangleBlob()))))
        blobs.pushItem(blob0)
        def root:KiwiValue (KiwiValue.fromObject())
        root.put("nodeChanges" nodes)
        root.put("blobs" blobs)
        return root
    }


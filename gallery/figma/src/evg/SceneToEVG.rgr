; SceneNode → EVGElement. Reads only the format-agnostic IR.
; Viewport pan/zoom is one root transform, not per-node geometry.

Import "../../../evg/EVGElement.rgr"
Import "../scene/SceneNode.rgr"
Import "../scene/SceneAssets.rgr"

class SceneToEVG {
    def debug:boolean false
    def assets:SceneAssets (new SceneAssets())

    Constructor () {
    }

    fn setDebug:void (on:boolean) {
        debug = on
    }

    fn setAssets:void (a:SceneAssets) {
        assets = a
    }

    fn buildPage:EVGElement (page:SceneNode panX:double panY:double zoom:double) {
        def root (EVGElement.createDiv())
        root.setAttribute("position" "relative")
        root.setAttribute("width" "100%")
        root.setAttribute("height" "100%")
        root.setAttribute("overflow" "hidden")
        root.setAttribute("transform-origin" "0 0")
        def t:string ("translate(" + (to_string panX) + "px, " + (to_string panY) + "px) scale(" + (to_string zoom) + ")")
        root.setAttribute("transform" t)
        def kids:[EVGElement]
        if (page.sourceType == "CANVAS") {
            kids = (this.emitKids(page false))
        } {
            def only:EVGElement (this.emit(page false))
            push kids only
        }
        def i:int 0
        while (i < (array_length kids)) {
            def kid:EVGElement (itemAt kids i)
            root.addChild(kid)
            i = (i + 1)
        }
        return root
    }

    fn emitKids:[EVGElement] (n:SceneNode parentFlex:boolean) {
        def out:[EVGElement]
        def i:int 0
        while (i < (array_length n.children)) {
            def ch:SceneNode (itemAt n.children i)
            push out (this.emit(ch parentFlex))
            i = (i + 1)
        }
        return out
    }

    fn emit:EVGElement (n:SceneNode parentFlex:boolean) {
        def el:EVGElement (this.createEl(n))
        el.id = n.id
        this.applyBox(el n parentFlex)
        this.applyFill(el n)
        this.applyStroke(el n)
        this.applyRadius(el n)
        this.applyOpacity(el n)
        this.applyClip(el n)
        this.applyShadow(el n)
        this.applyXf(el n)
        this.applyText(el n)
        this.applyImage(el n)
        this.applyPath(el n)
        this.applyLayout(el n)
        this.applyDebug(el n)
        def childFlex:boolean (n.layout.isFlex())
        def kids:[EVGElement] (this.emitKids(n childFlex))
        def i:int 0
        while (i < (array_length kids)) {
            def kid:EVGElement (itemAt kids i)
            el.addChild(kid)
            i = (i + 1)
        }
        return el
    }

    fn createEl:EVGElement (n:SceneNode) {
        if (n.kind == "text") {
            return (EVGElement.createSpan())
        }
        if (n.kind == "image") {
            return (EVGElement.createImg())
        }
        if (n.kind == "path") {
            return (EVGElement.createPath())
        }
        if (n.kind == "ellipse") {
            return (EVGElement.createPath())
        }
        if (n.kind == "line") {
            return (EVGElement.createPath())
        }
        return (EVGElement.createDiv())
    }

    fn applyBox:void (el:EVGElement n:SceneNode parentFlex:boolean) {
        if parentFlex {
            if n.layout.fillW {
                el.setAttribute("flex-grow" "1")
            }
            if n.layout.fillH {
                el.setAttribute("flex-grow" "1")
            }
        } {
            el.setAttribute("position" "absolute")
            el.setAttribute("left" ((to_string n.x) + "px"))
            el.setAttribute("top" ((to_string n.y) + "px"))
        }
        if ((n.layout.hugW == false) && (n.w > 0.0)) {
            el.setAttribute("width" ((to_string n.w) + "px"))
        }
        if ((n.layout.hugH == false) && (n.h > 0.0)) {
            el.setAttribute("height" ((to_string n.h) + "px"))
        }
    }

    fn applyFill:void (el:EVGElement n:SceneNode) {
        if ((array_length n.fills) == 0) {
            return
        }
        def f:SceneFill (n.firstFill())
        if (f.visible == false) {
            return
        }
        if (f.kind == "solid") {
            if (this.isPathKind(n.kind)) {
                el.setAttribute("fill" (f.hex()))
            } {
                el.setAttribute("background-color" (f.hex()))
            }
            return
        }
        if (f.kind == "gradient") {
            el.setAttribute("gradient-from" (f.hex()))
            el.setAttribute("gradient-to" (SceneFill.rgbHex(f.gradR f.gradG f.gradB)))
            el.setAttribute("gradient-dir" (to_string f.gradDir))
            return
        }
        if (f.kind == "image") {
            def url:string (assets.resolveImage(f.imageRef))
            if (n.kind == "image") {
                el.src = url
                el.setAttribute("object-fit" (this.fitOf(f.imageFit)))
            } {
                el.setAttribute("background-color" "#cccccc")
            }
        }
    }

    fn isPathKind:boolean (kind:string) {
        if (kind == "path") {
            return true
        }
        if (kind == "ellipse") {
            return true
        }
        if (kind == "line") {
            return true
        }
        return false
    }

    fn fitOf:string (mode:string) {
        if (mode == "FIT") {
            return "contain"
        }
        if (mode == "contain") {
            return "contain"
        }
        if (mode == "TILE") {
            return "cover"
        }
        return "cover"
    }

    fn applyStroke:void (el:EVGElement n:SceneNode) {
        if ((array_length n.strokes) == 0) {
            return
        }
        def s:SceneStroke (n.firstStroke())
        if (s.visible == false) {
            return
        }
        if (this.isPathKind(n.kind)) {
            el.setAttribute("stroke" (s.hex()))
            el.setAttribute("stroke-width" (to_string s.weight))
            return
        }
        el.setAttribute("border-width" ((to_string s.weight) + "px"))
        el.setAttribute("border-color" (s.hex()))
        el.setAttribute("border-style" "solid")
    }

    fn applyRadius:void (el:EVGElement n:SceneNode) {
        if ((n.radius.any()) == false) {
            return
        }
        if n.radius.uniform {
            el.setAttribute("border-radius" ((to_string n.radius.tl) + "px"))
            return
        }
        def v:string ((to_string n.radius.tl) + "px " + (to_string n.radius.tr) + "px " + (to_string n.radius.br) + "px " + (to_string n.radius.bl) + "px")
        el.setAttribute("border-radius" v)
    }

    fn applyOpacity:void (el:EVGElement n:SceneNode) {
        def a:double n.opacity
        if ((array_length n.fills) > 0) {
            def f:SceneFill (n.firstFill())
            a = (f.finalAlpha(n.opacity))
        }
        if (a < 0.999) {
            el.setAttribute("opacity" (to_string a))
        }
        if (n.visible == false) {
            el.setAttribute("display" "none")
        }
    }

    fn applyClip:void (el:EVGElement n:SceneNode) {
        if n.clip {
            el.setAttribute("overflow" "hidden")
        }
    }

    fn applyShadow:void (el:EVGElement n:SceneNode) {
        if ((n.hasShadow()) == false) {
            return
        }
        def e:SceneEffect (n.firstShadow())
        el.setAttribute("shadow-radius" (to_string e.blur))
        el.setAttribute("shadow-color" (SceneFill.rgbHex(e.r e.g e.b)))
        el.setAttribute("shadow-offset-x" (to_string e.x))
        el.setAttribute("shadow-offset-y" (to_string e.y))
    }

    fn applyXf:void (el:EVGElement n:SceneNode) {
        if (n.hasXf == false) {
            return
        }
        def deg:double (n.xf.rotationDeg())
        if ((deg > 0.05) || (deg < (0.0 - 0.05))) {
            el.setAttribute("transform" ("rotate(" + (to_string deg) + "deg)"))
        }
    }

    fn applyText:void (el:EVGElement n:SceneNode) {
        if (n.kind != "text") {
            return
        }
        el.textContent = n.text.characters
        def family:string (assets.resolveFont(n.text.fontFamily))
        if ((strlen family) > 0) {
            el.setAttribute("font-family" family)
        }
        if (n.text.fontSize > 0.0) {
            el.setAttribute("font-size" ((to_string n.text.fontSize) + "px"))
        }
        if ((strlen n.text.fontWeight) > 0) {
            el.setAttribute("font-weight" n.text.fontWeight)
        }
        if (n.text.lineHeight > 0.0) {
            el.setAttribute("line-height" (to_string n.text.lineHeight))
        }
        if ((strlen n.text.align) > 0) {
            el.setAttribute("text-align" n.text.align)
        }
        if ((array_length n.fills) > 0) {
            def f:SceneFill (n.firstFill())
            if (f.kind == "solid") {
                el.setAttribute("color" (f.hex()))
            }
        }
    }

    fn applyImage:void (el:EVGElement n:SceneNode) {
        if (n.kind != "image") {
            return
        }
        def ref:string n.imageRef
        if ((strlen ref) == 0) {
            if ((array_length n.fills) > 0) {
                def imgF:SceneFill (n.firstFill())
                ref = imgF.imageRef
            }
        }
        if ((strlen ref) > 0) {
            el.src = (assets.resolveImage(ref))
        }
        el.setAttribute("object-fit" (this.fitOf(n.imageFit)))
    }

    fn applyPath:void (el:EVGElement n:SceneNode) {
        if ((strlen n.pathData) == 0) {
            return
        }
        el.setAttribute("d" n.pathData)
        if ((array_length n.fills) == 0) {
            el.setAttribute("fill" "none")
        }
        if n.evenOdd {
            el.setAttribute("fill-rule" "evenodd")
        }
    }

    fn applyLayout:void (el:EVGElement n:SceneNode) {
        if ((n.layout.isFlex()) == false) {
            return
        }
        el.setAttribute("display" "flex")
        if (n.layout.mode == "row") {
            el.setAttribute("flex-direction" "row")
        }
        if (n.layout.mode == "column") {
            el.setAttribute("flex-direction" "column")
        }
        if (n.layout.gap > 0.0) {
            el.setAttribute("gap" ((to_string n.layout.gap) + "px"))
        }
        if ((((n.layout.padL > 0.0) || (n.layout.padR > 0.0)) || (n.layout.padT > 0.0)) || (n.layout.padB > 0.0)) {
            def p:string ((to_string n.layout.padT) + "px " + (to_string n.layout.padR) + "px " + (to_string n.layout.padB) + "px " + (to_string n.layout.padL) + "px")
            el.setAttribute("padding" p)
        }
        if ((strlen n.layout.justify) > 0) {
            el.setAttribute("justify-content" (this.justifyCss(n.layout.justify)))
        }
        if ((strlen n.layout.alignItems) > 0) {
            el.setAttribute("align-items" (this.alignCss(n.layout.alignItems)))
        }
    }

    fn justifyCss:string (v:string) {
        if (v == "start") {
            return "flex-start"
        }
        if (v == "end") {
            return "flex-end"
        }
        return v
    }

    fn alignCss:string (v:string) {
        if (v == "start") {
            return "flex-start"
        }
        if (v == "end") {
            return "flex-end"
        }
        return v
    }

    fn applyDebug:void (el:EVGElement n:SceneNode) {
        if (debug == false) {
            return
        }
        ; outline is not in the EVG CSS subset — id is enough for the overlay
        el.id = n.id
    }

    fn dump:string (el:EVGElement) {
        return (this.dumpInner(el 0))
    }

    fn dumpInner:string (el:EVGElement depth:int) {
        def pad:string ""
        def i:int 0
        while (i < depth) {
            pad = (pad + "  ")
            i = (i + 1)
        }
        def s:string (pad + "<" + el.tagName)
        if ((strlen el.id) > 0) {
            s = (s + " id=\"" + el.id + "\"")
        }
        if ((strlen el.position) > 0) {
            s = (s + " position=\"" + el.position + "\"")
        }
        if el.left.isSet {
            s = (s + " left=\"" + (to_string el.left.value) + "px\"")
        }
        if el.top.isSet {
            s = (s + " top=\"" + (to_string el.top.value) + "px\"")
        }
        if el.width.isSet {
            s = (s + " width=\"" + (to_string el.width.value) + "px\"")
        }
        if el.height.isSet {
            s = (s + " height=\"" + (to_string el.height.value) + "px\"")
        }
        if el.backgroundColor.isSet {
            def hex:string (el.backgroundColor.toHexString())
            s = (s + " background=\"" + hex + "\"")
        }
        if ((strlen el.svgPath) > 0) {
            s = (s + " d=\"" + el.svgPath + "\"")
        }
        if ((strlen el.textContent) > 0) {
            s = (s + ">" + el.textContent + "</" + el.tagName + ">\n")
            return s
        }
        if ((array_length el.children) == 0) {
            return (s + " />\n")
        }
        s = (s + ">\n")
        def c:int 0
        while (c < (array_length el.children)) {
            def ch:EVGElement (itemAt el.children c)
            s = (s + (this.dumpInner(ch (depth + 1))))
            c = (c + 1)
        }
        s = (s + pad + "</" + el.tagName + ">\n")
        return s
    }
}

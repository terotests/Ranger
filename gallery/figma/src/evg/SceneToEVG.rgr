; SPDX-License-Identifier: AGPL-3.0-or-later

; SceneNode → EVGElement. Reads only the format-agnostic IR.
; Viewport pan/zoom is one root transform, not per-node geometry.
;
; Every node is placed at the x/y its source stored, Auto Layout children
; included. A design file carries the positions its own layout engine
; settled on, and those are the truth: re-running the layout here with a
; different text engine and whatever fonts the page has would only drift
; from them. The layout itself (mode, gap, padding, alignment) stays on the
; SceneNode for anything that wants to re-flow.

Import "../../../evg/EVGElement.rgr"
Import "../scene/SceneNode.rgr"
Import "../scene/SceneAssets.rgr"

class SceneToEVG {
    def debug:boolean false
    def assets:SceneAssets (new SceneAssets())

    Constructor () {
    }

    fn setDebug:void (on:boolean) {
        debug = on
    }

    fn setAssets:void (a:SceneAssets) {
        assets = a
    }

    ; `page` is the node being viewed — a whole page, or one frame on it.
    ; `canvas` is the page it belongs to, whose background colour fills the
    ; viewport behind either, as it does in the editor.
    ; The page with the view on the WORLD ELEMENT: the list comes out in page
    ; coordinates, which is what every consumer had before a camera existed.
    fn buildPage:EVGElement (page:SceneNode canvas:SceneNode panX:double panY:double zoom:double) {
        return (this.buildPageIn(page canvas panX panY zoom false 0.0 0.0 0.0 0.0))
    }

    ; The page in SCENE coordinates, for a list that carries a camera.
    ;
    ; Two things the page-space version does have to move with it. The PAPER
    ; is the root's own background, and a root the size of the viewport would
    ; be a small patch of colour once the camera has multiplied it — so in
    ; scene space the root is the REGION, which is what the list was built to
    ; cover and therefore the most paper a pan can reach. And the CLIP: the
    ; root clips to the viewport, and a clip is a command like any other, so
    ; the camera would carry it away from the window it is supposed to be.
    ; The canvas clips anyway, so in scene space the root does not.
    fn buildPageScene:EVGElement (page:SceneNode canvas:SceneNode l:double t:double r:double b:double) {
        return (this.buildPageIn(page canvas 0.0 0.0 1.0 true l t r b))
    }

    fn buildPageIn:EVGElement (page:SceneNode canvas:SceneNode panX:double panY:double zoom:double scene:boolean l:double t:double r:double b:double) {
        def root (EVGElement.createDiv())
        root.setAttribute("position" "relative")
        if scene {
            root.setAttribute("position" "absolute")
            root.setAttribute("left" ((to_string l) + "px"))
            root.setAttribute("top" ((to_string t) + "px"))
            root.setAttribute("width" ((to_string (r - l)) + "px"))
            root.setAttribute("height" ((to_string (b - t)) + "px"))
            root.setAttribute("overflow" "visible")
        } {
            root.setAttribute("width" "100%")
            root.setAttribute("height" "100%")
            root.setAttribute("overflow" "hidden")
        }
        def paper:string "#f5f5f5"
        if ((array_length canvas.fills) > 0) {
            def bg:SceneFill (canvas.firstFill())
            if ((bg.kind == "solid") && bg.visible) {
                paper = (bg.hexA())
            }
        }
        root.setAttribute("background-color" paper)
        ; The pan/zoom lives on a child, not on the clipping root: a
        ; transform scales the element's own clip rectangle along with its
        ; content, so at 65% the page showed only the top-left 65% of the
        ; viewport and cut every frame off at the same line.
        def world (EVGElement.createDiv())
        world.setAttribute("position" "absolute")
        world.setAttribute("transform-origin" "0 0")
        if scene {
            ; The scene's own origin, wherever the region starts. No
            ; transform: the camera on the list is the view now.
            world.setAttribute("left" ((to_string (0.0 - l)) + "px"))
            world.setAttribute("top" ((to_string (0.0 - t)) + "px"))
            world.setAttribute("width" "1px")
            world.setAttribute("height" "1px")
            world.setAttribute("overflow" "visible")
        } {
            world.setAttribute("left" "0px")
            world.setAttribute("top" "0px")
            world.setAttribute("width" "100%")
            world.setAttribute("height" "100%")
            world.setAttribute("transform" (SceneToEVG.viewTransform(panX panY zoom)))
        }
        def kids:[EVGElement]
        if (page.sourceType == "CANVAS") {
            kids = (this.emitKids(page))
        } {
            def only:EVGElement (this.emit(page))
            push kids only
        }
        def i:int 0
        while (i < (array_length kids)) {
            def kid:EVGElement (itemAt kids i)
            world.addChild(kid)
            i = (i + 1)
        }
        root.addChild(world)
        return root
    }

    ; The pan and the zoom, as the world element wears them. Written here
    ; and nowhere else, because a view change re-writes this attribute on a
    ; page that is already built rather than building another one.
    sfn viewTransform:string (panX:double panY:double zoom:double) {
        return ("translate(" + (to_string panX) + "px, " + (to_string panY) + "px) scale(" + (to_string zoom) + ")")
    }

    fn emitKids:[EVGElement] (n:SceneNode) {
        def out:[EVGElement]
        def i:int 0
        while (i < (array_length n.children)) {
            def ch:SceneNode (itemAt n.children i)
            push out (this.emit(ch))
            i = (i + 1)
        }
        return out
    }

    fn emit:EVGElement (n:SceneNode) {
        def el:EVGElement (this.createEl(n))
        el.id = n.id
        this.applyBox(el n)
        this.applyFill(el n)
        this.applyStroke(el n)
        this.applyRadius(el n)
        this.applyOpacity(el n)
        this.applyClip(el n)
        this.applyShadow(el n)
        this.applyBackdrop(el n)
        this.applyXf(el n)
        this.applyText(el n)
        this.applyImage(el n)
        this.applyPath(el n)
        this.applyDebug(el n)
        def kids:[EVGElement] (this.emitKids(n))
        def i:int 0
        while (i < (array_length kids)) {
            def kid:EVGElement (itemAt kids i)
            el.addChild(kid)
            i = (i + 1)
        }
        ; The sides go on last, over the content, which is where a border
        ; is: a row's rule is drawn on top of the cell, not under it.
        def bars:[EVGElement] (this.sideBars(n))
        def bi:int 0
        while (bi < (array_length bars)) {
            el.addChild((itemAt bars bi))
            bi = (bi + 1)
        }
        return el
    }

    fn createEl:EVGElement (n:SceneNode) {
        if (n.kind == "text") {
            if (n.text.hasOutline()) {
                return (EVGElement.createPath())
            }
            return (EVGElement.createSpan())
        }
        if (n.kind == "image") {
            return (EVGElement.createImg())
        }
        if (this.isPathKind(n.kind)) {
            return (EVGElement.createPath())
        }
        return (EVGElement.createDiv())
    }

    ; Painted as a path: vectors, and text that brought its own outlines.
    fn paintsAsPath:boolean (n:SceneNode) {
        if (this.isPathKind(n.kind)) {
            return true
        }
        if (n.kind == "text") {
            return (n.text.hasOutline())
        }
        return false
    }

    fn applyBox:void (el:EVGElement n:SceneNode) {
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((to_string n.x) + "px"))
        el.setAttribute("top" ((to_string n.y) + "px"))
        def w:double n.w
        def h:double n.h
        if (this.paintsAsPath(n)) {
            ; A path is fitted into its box through a viewBox. With none
            ; declared, EVG synthesises one from the path's own bounds, which
            ; stretches an icon to the node and centres a zero-height line
            ; into nothing. The box the outline was AUTHORED in makes the
            ; path's user units the pixels it was written in, one to one.
            ;
            ; Which is the node's own size until the node is resized, and
            ; then it is not — and that difference is a stretch: the outline
            ; is mapped from the box it was drawn in into the box the node
            ; now has. Fitted with `meet` it would keep its shape and sit
            ; letterboxed in the bigger frame, which is a sticky made wider
            ; with a white wedge down one side of it.
            def vbw:double n.pathW
            def vbh:double n.pathH
            if (vbw < 0.000001) {
                vbw = w
            }
            if (vbh < 0.000001) {
                vbh = h
            }
            if (w < 1.0) {
                w = 1.0
            }
            if (h < 1.0) {
                h = 1.0
            }
            if (vbw < 1.0) {
                vbw = 1.0
            }
            if (vbh < 1.0) {
                vbh = 1.0
            }
            el.setAttribute("viewBox" ("0 0 " + (to_string vbw) + " " + (to_string vbh)))
            def off:double ((fabs (vbw - w)) + (fabs (vbh - h)))
            if (off > 0.01) {
                el.setAttribute("preserve-aspect-ratio" "none")
            }
        }
        if (w > 0.0) {
            el.setAttribute("width" ((to_string w) + "px"))
        }
        if (h > 0.0) {
            el.setAttribute("height" ((to_string h) + "px"))
        }
    }

    fn applyFill:void (el:EVGElement n:SceneNode) {
        if (n.kind == "text") {
            ; A text fill is the ink colour, set by applyText. As a background
            ; it painted a box the size of the node in the text's own colour,
            ; with the glyphs invisible on top of it.
            return
        }
        if ((array_length n.fills) == 0) {
            return
        }
        def f:SceneFill (n.firstFill())
        if (f.visible == false) {
            return
        }
        if (f.kind == "solid") {
            if (this.isPathKind(n.kind)) {
                el.setAttribute("fill" (f.hexA()))
            } {
                el.setAttribute("background-color" (f.hexA()))
            }
            return
        }
        if (f.kind == "gradient") {
            ; The same two colours and the same direction whatever the shape
            ; is. A gradient used to cross the list as a BOX, so a vector
            ; had to choose between the shading and its own outline, and it
            ; kept the outline and took the two ends mixed into one colour.
            ; The command carries the rings AND the stops now, so a shaded
            ; pill is a pill and is shaded.
            if (this.isPathKind(n.kind)) {
                el.setAttribute("fill" (f.hexA()))
            }
            el.setAttribute("gradient-from" (f.hexA()))
            el.setAttribute("gradient-to" (f.gradHexA()))
            el.setAttribute("gradient-dir" (to_string f.gradDir))
            return
        }
        if (f.kind == "image") {
            if (n.kind == "image") {
                el.src = (assets.resolveImage(f.imageRef))
                el.setAttribute("object-fit" (this.fitOf(f.imageFit)))
                this.applyCrop(el f)
            } {
                el.setAttribute("background-color" "#cccccc")
            }
        }
    }

    fn isPathKind:boolean (kind:string) {
        if (kind == "path") {
            return true
        }
        if (kind == "ellipse") {
            return true
        }
        if (kind == "line") {
            return true
        }
        return false
    }

    fn fitOf:string (mode:string) {
        if (mode == "FIT") {
            return "contain"
        }
        if (mode == "contain") {
            return "contain"
        }
        if (mode == "TILE") {
            return "cover"
        }
        return "cover"
    }

    fn applyStroke:void (el:EVGElement n:SceneNode) {
        if ((array_length n.strokes) == 0) {
            return
        }
        ; The outline the file brought is a child of this element and is
        ; already the stroke, drawn exactly. A border here would be a
        ; second one.
        if n.strokeIsGeometry {
            return
        }
        def s:SceneStroke (n.firstStroke())
        if (s.visible == false) {
            return
        }
        if (this.isPathKind(n.kind)) {
            el.setAttribute("stroke" (s.hex()))
            el.setAttribute("stroke-width" (to_string s.weight))
            if (s.lineCap != "butt") {
                el.setAttribute("stroke-linecap" s.lineCap)
            }
            if (s.lineJoin != "miter") {
                el.setAttribute("stroke-linejoin" s.lineJoin)
            }
            if ((strlen s.dash) > 0) {
                el.setAttribute("stroke-dasharray" s.dash)
            }
            return
        }
        if (n.kind == "text") {
            return
        }
        ; Four weights are four bars, drawn below as children — one
        ; border-width could only be one of them.
        if s.perSide {
            return
        }
        el.setAttribute("border-width" ((to_string s.weight) + "px"))
        el.setAttribute("border-color" (s.hex()))
        el.setAttribute("border-style" "solid")
    }

    ; A stroke with a weight per side, as one bar per side.
    ;
    ; A table row with a rule under it and nothing else, a card open on
    ; one edge: Figma gives each side its own weight, and an EVG border
    ; has one. Drawn at the single `strokeWeight` the node also carries,
    ; a row with a hairline under it came out boxed on all four sides —
    ; which is not a near miss, it is a different drawing.
    ;
    ; `strokeAlign` decides where the bars sit: INSIDE puts them in the
    ; box, OUTSIDE beyond it, CENTER astride the edge. The one factor
    ; below is that choice, so the four bars cannot disagree about it.
    ; The corners overlap, which costs nothing — the bars are one colour.
    ;
    ; They are children of the element, so a clipping frame cuts an
    ; outside bar that Figma would leave whole. The reader only takes
    ; this path when the weights differ AND the corners are square, which
    ; is the table and the divider, and those align inside.
    fn sideBars:[EVGElement] (n:SceneNode) {
        def out:[EVGElement]
        if ((array_length n.strokes) == 0) {
            return out
        }
        if n.strokeIsGeometry {
            return out
        }
        def s:SceneStroke (n.firstStroke())
        if ((s.perSide && s.visible) == false) {
            return out
        }
        if ((this.isPathKind(n.kind)) || (n.kind == "text")) {
            return out
        }
        def f:double 0.5
        if (s.align == "inside") {
            f = 0.0
        }
        if (s.align == "outside") {
            f = 1.0
        }
        def x0:double (0.0 - (s.wLeft * f))
        def y0:double (0.0 - (s.wTop * f))
        def bw:double ((n.w + (s.wLeft * f)) + (s.wRight * f))
        def bh:double ((n.h + (s.wTop * f)) + (s.wBottom * f))
        push out (this.bar(n s "top" x0 y0 bw s.wTop))
        push out (this.bar(n s "bottom" x0 (n.h - (s.wBottom * (1.0 - f))) bw s.wBottom))
        push out (this.bar(n s "left" x0 y0 s.wLeft bh))
        push out (this.bar(n s "right" (n.w - (s.wRight * (1.0 - f))) y0 s.wRight bh))
        return out
    }

    fn bar:EVGElement (n:SceneNode s:SceneStroke side:string x:double y:double w:double h:double) {
        def el:EVGElement (EVGElement.createDiv())
        el.id = ((n.id + ":border-") + side)
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((to_string x) + "px"))
        el.setAttribute("top" ((to_string y) + "px"))
        ; A side with no weight is a bar with no size, which draws nothing
        ; and keeps the four in step with the four the file names.
        el.setAttribute("width" ((to_string (SceneToEVG.atLeastZero(w))) + "px"))
        el.setAttribute("height" ((to_string (SceneToEVG.atLeastZero(h))) + "px"))
        el.setAttribute("background" (s.hex()))
        return el
    }

    sfn atLeastZero:double (v:double) {
        if (v < 0.0) {
            return 0.0
        }
        return v
    }

    fn applyRadius:void (el:EVGElement n:SceneNode) {
        if ((n.radius.any()) == false) {
            return
        }
        if n.radius.uniform {
            el.setAttribute("border-radius" ((to_string n.radius.tl) + "px"))
            return
        }
        def v:string ((to_string n.radius.tl) + "px " + (to_string n.radius.tr) + "px " + (to_string n.radius.br) + "px " + (to_string n.radius.bl) + "px")
        el.setAttribute("border-radius" v)
    }

    ; Only the node's own opacity fades the element (and so its children).
    ; A translucent PAINT is folded into its colour by applyFill instead.
    fn applyOpacity:void (el:EVGElement n:SceneNode) {
        if (n.opacity < 0.999) {
            el.setAttribute("opacity" (to_string n.opacity))
        }
        if (n.visible == false) {
            el.setAttribute("display" "none")
        }
    }

    fn applyClip:void (el:EVGElement n:SceneNode) {
        if n.clip {
            el.setAttribute("overflow" "hidden")
        }
    }

    fn applyShadow:void (el:EVGElement n:SceneNode) {
        if ((n.hasShadow()) == false) {
            return
        }
        ; A SHADOW IS THE SHAPE OF WHAT THE NODE DRAWS, and the list draws
        ; one as a rounded box. A node that paints nothing itself lends its
        ; box to the shadow — which is exactly right for a FigJam sticky,
        ; whose square body arrives as a child path, and wrong for a rounded
        ; pill, which would sit under a square halo the size of its frame.
        ; A square halo under a pill is worse than no halo, so where the
        ; body is not a box the shadow is not written at all.
        if ((this.paintsOwnBox(n)) == false) {
            if ((this.bodyIsBox(n)) == false) {
                return
            }
        }
        def e:SceneEffect (n.firstShadow())
        el.setAttribute("shadow-radius" (to_string e.blur))
        ; WITH ITS ALPHA. A FigJam sticky's shadow is black at a tenth, and
        ; written as #000000 it is black at one — a note with a slab under it
        ; rather than a note lifted off the page.
        el.setAttribute("shadow-color" (SceneFill.rgbaHex(e.r e.g e.b e.a)))
        el.setAttribute("shadow-offset-x" (to_string e.x))
        el.setAttribute("shadow-offset-y" (to_string e.y))
    }

    ; Does the node's own rectangle get painted? A fill on a container is
    ; the box; a path or a picture is its own shape and the box is only
    ; where it sits.
    fn paintsOwnBox:boolean (n:SceneNode) {
        if (this.paintsAsPath(n)) {
            return false
        }
        if (n.kind == "image") {
            return false
        }
        if ((array_length n.fills) == 0) {
            return false
        }
        def f:SceneFill (n.firstFill())
        return f.visible
    }

    ; Is what this node draws a rectangle the size of its box? The body of
    ; an expanded container arrives as its first child, and a sticky's is
    ; `M0 0L240 0L240 240L0 240Z` — corners and straight lines, filling the
    ; box. A curve anywhere in it means the shape is not the box.
    fn bodyIsBox:boolean (n:SceneNode) {
        if ((array_length n.children) == 0) {
            return false
        }
        def body:SceneNode (itemAt n.children 0)
        if (body.kind != "path") {
            return false
        }
        if (((fabs body.x) > 0.5) || ((fabs body.y) > 0.5)) {
            return false
        }
        if (((fabs (body.w - n.w)) > 0.5) || ((fabs (body.h - n.h)) > 0.5)) {
            return false
        }
        return (SceneToEVG.isStraightPath(body.pathData))
    }

    ; Only moves and lines. One curve command and the outline is not a box.
    sfn isStraightPath:boolean (d:string) {
        if ((strlen d) == 0) {
            return false
        }
        def i:int 0
        while (i < (strlen d)) {
            def c:int (charAt d i)
            ; C c S s Q q T t A a — every curve and arc spelling there is.
            if (((c == 67) || (c == 99)) || (((c == 83) || (c == 115)) || ((c == 81) || (c == 113)))) {
                return false
            }
            if (((c == 84) || (c == 116)) || ((c == 65) || (c == 97))) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    fn applyBackdrop:void (el:EVGElement n:SceneNode) {
        def r:double (n.backdropBlur())
        if (r > 0.0) {
            el.setAttribute("backdrop-filter" ("blur(" + (to_string r) + "px)"))
        }
    }

    fn applyXf:void (el:EVGElement n:SceneNode) {
        if (n.hasXf == false) {
            return
        }
        def deg:double (n.xf.rotationDeg())
        def mirrored:boolean (n.xf.isMirrored())
        if ((((deg > 0.05) || (deg < (0.0 - 0.05)))) || mirrored) {
            ; Figma rotates about the node's own origin, and the translation
            ; it stored is where that origin landed.
            el.setAttribute("transform-origin" "0 0")
            ; A mirrored layer is a turn AND a flip — its matrix reverses
            ; handedness, which no angle can. Written the way the two
            ; compose, the flip first: M = R(theta) · diag(1, -1).
            def spec:string ("rotate(" + (to_string deg) + "deg)")
            if mirrored {
                spec = (spec + " scale(1, -1)")
            }
            el.setAttribute("transform" spec)
        }
    }

    fn applyText:void (el:EVGElement n:SceneNode) {
        if (n.kind != "text") {
            return
        }
        def ink:string ""
        if ((array_length n.fills) > 0) {
            def f:SceneFill (n.firstFill())
            if (f.visible && (f.kind == "solid")) {
                ink = (f.hexA())
            }
        }
        if (n.text.hasOutline()) {
            ; The glyphs the editor shaped, as one path. No font lookup, no
            ; line breaking, no letter-spacing gap: the outlines already sit
            ; where the designer saw them.
            el.setAttribute("d" n.text.outline)
            if ((strlen ink) > 0) {
                el.setAttribute("fill" ink)
            }
            return
        }
        el.textContent = n.text.characters
        def family:string (assets.resolveFont(n.text.fontFamily))
        if ((strlen family) > 0) {
            el.setAttribute("font-family" family)
        }
        if (n.text.fontSize > 0.0) {
            el.setAttribute("font-size" ((to_string n.text.fontSize) + "px"))
        }
        if ((strlen n.text.fontWeight) > 0) {
            el.setAttribute("font-weight" n.text.fontWeight)
        }
        if (n.text.fontStyle == "italic") {
            el.setAttribute("font-style" "italic")
        }
        if (n.text.lineHeight > 0.0) {
            el.setAttribute("line-height" (to_string n.text.lineHeight))
        }
        if (n.text.paragraphSpacing != 0.0) {
            el.setAttribute("paragraph-spacing" ((to_string n.text.paragraphSpacing) + "px"))
        }
        if (n.text.letterSpacing != 0.0) {
            el.setAttribute("letter-spacing" ((to_string n.text.letterSpacing) + "px"))
        }
        if ((strlen n.text.align) > 0) {
            el.setAttribute("text-align" n.text.align)
        }
        if ((strlen ink) > 0) {
            el.setAttribute("color" ink)
        }
    }

    fn applyImage:void (el:EVGElement n:SceneNode) {
        if (n.kind != "image") {
            return
        }
        def ref:string n.imageRef
        if ((strlen ref) == 0) {
            if ((array_length n.fills) > 0) {
                def imgF:SceneFill (n.firstFill())
                if imgF.visible {
                    ref = imgF.imageRef
                }
            }
        }
        if ((strlen ref) > 0) {
            el.src = (assets.resolveImage(ref))
        }
        el.setAttribute("object-fit" (this.fitOf(n.imageFit)))
        if ((array_length n.fills) > 0) {
            def cf:SceneFill (n.firstFill())
            if (cf.kind == "image") {
                this.applyCrop(el cf)
            }
        }
    }

    ; The paint's crop rectangle, as the window the element shows. Figma
    ; keeps it on the fill and it is not the node's transform: two boxes of
    ; one screenshot, cropped to its two halves, are the same bitmap and the
    ; same size and differ only here. Dropping it drew the same picture
    ; twice.
    fn applyCrop:void (el:EVGElement f:SceneFill) {
        if (f.imageCropped == false) {
            return
        }
        def v:string ((to_string f.cropX) + " " + (to_string f.cropY))
        v = (v + " " + (to_string f.cropW) + " " + (to_string f.cropH))
        el.setAttribute("image-view-box" v)
    }

    fn applyPath:void (el:EVGElement n:SceneNode) {
        if (n.kind == "text") {
            return
        }
        if ((strlen n.pathData) == 0) {
            return
        }
        el.setAttribute("d" n.pathData)
        if ((array_length n.fills) == 0) {
            el.setAttribute("fill" "none")
        }
        if n.evenOdd {
            el.setAttribute("fill-rule" "evenodd")
        }
    }

    fn applyDebug:void (el:EVGElement n:SceneNode) {
        if (debug == false) {
            return
        }
        ; outline is not in the EVG CSS subset — id is enough for the overlay
        el.id = n.id
    }

    fn dump:string (el:EVGElement) {
        return (this.dumpInner(el 0))
    }

    fn dumpInner:string (el:EVGElement depth:int) {
        def pad:string ""
        def i:int 0
        while (i < depth) {
            pad = (pad + "  ")
            i = (i + 1)
        }
        def s:string (pad + "<" + el.tagName)
        if ((strlen el.id) > 0) {
            s = (s + " id=\"" + el.id + "\"")
        }
        if ((strlen el.position) > 0) {
            s = (s + " position=\"" + el.position + "\"")
        }
        if el.left.isSet {
            s = (s + " left=\"" + (to_string el.left.value) + "px\"")
        }
        if el.top.isSet {
            s = (s + " top=\"" + (to_string el.top.value) + "px\"")
        }
        if el.width.isSet {
            s = (s + " width=\"" + (to_string el.width.value) + "px\"")
        }
        if el.height.isSet {
            s = (s + " height=\"" + (to_string el.height.value) + "px\"")
        }
        if el.backgroundColor.isSet {
            def hex:string (el.backgroundColor.toHexString())
            s = (s + " background=\"" + hex + "\"")
        }
        if el.fillColor.isSet {
            s = (s + " fill=\"" + (el.fillColor.toHexString()) + "\"")
        }
        if ((strlen el.svgPath) > 0) {
            s = (s + " d=\"" + el.svgPath + "\"")
        }
        if ((strlen el.textContent) > 0) {
            s = (s + ">" + el.textContent + "</" + el.tagName + ">\n")
            return s
        }
        if ((array_length el.children) == 0) {
            return (s + " />\n")
        }
        s = (s + ">\n")
        def c:int 0
        while (c < (array_length el.children)) {
            def ch:EVGElement (itemAt el.children c)
            s = (s + (this.dumpInner(ch (depth + 1))))
            c = (c + 1)
        }
        s = (s + pad + "</" + el.tagName + ">\n")
        return s
    }
}

; Browser facade. The page fetches bytes (or the user picks a file) and
; this class parses them and answers an EVG display list.

Import "../src/FigApp.rgr"

class FigWeb {
    def app:FigApp (new FigApp())

    Constructor () {
    }

    fn openBytes:boolean (data:buffer name:string) {
        return (app.openBytes(data name))
    }

    fn openSample:boolean () {
        return (app.openSample())
    }

    fn openClipboardSample:boolean () {
        return (app.openClipboardSample())
    }

    ; The fig-kiwi bytes behind the open document — canvas.fig, or the paste.
    fn canvasBytes:buffer () {
        return app.doc.canvasBytes
    }

    fn ok:boolean () {
        return app.ok
    }

    fn error:string () {
        return app.err
    }

    fn scene:string () {
        return (app.sceneJson())
    }

    ; The frame as typed arrays — what the page paints from. `scene()` is
    ; the same picture as text, kept for readers that want it that way.
    fn sceneBin:EVGSceneBinary () {
        return (app.sceneBinary())
    }

    fn sceneGraph:string () {
        return (app.sceneGraphJson())
    }

    fn evgDump:string () {
        return (app.evgText())
    }

    fn stats:string () {
        return (app.statsJson())
    }

    fn pages:string () {
        return (app.pagesJson())
    }

    fn frames:string () {
        return (app.framesJson())
    }

    fn tree:string () {
        return (app.treeJson())
    }

    fn props:string () {
        return (app.propsJson())
    }

    ; The selected layer, small enough to re-read on every keystroke.
    fn inspect:string () {
        return (app.inspectJson())
    }

    ; Editing the scene graph. Nothing is written back to the file.
    fn editRect:void (x:double y:double w:double h:double) {
        app.editRect(x y w h)
    }

    fn editOpacity:void (v:double) {
        app.editOpacity(v)
    }

    fn editVisible:void (on:boolean) {
        app.editVisible(on)
    }

    fn editRadius:void (v:double) {
        app.editRadius(v)
    }

    fn editFill:void (hex:string) {
        app.editFill(hex)
    }

    fn editStroke:void (hex:string weight:double) {
        app.editStroke(hex weight)
    }

    fn editText:void (text:string) {
        app.editText(text)
    }

    fn revertEdits:void () {
        app.revertEdits()
    }

    fn editCount:int () {
        return (app.editCount())
    }

    fn warnings:string () {
        return (app.warningsJson())
    }

    ; Fields this file carries that the converter never reads.
    fn unread:string () {
        return (app.unreadJson())
    }

    ; Nodes per Figma type, and how many of them draw nothing.
    fn census:string () {
        return (app.censusJson())
    }

    fn pageCount:int () {
        return (app.pageCount())
    }

    fn pageIndex:int () {
        return app.pageIndex
    }

    fn setPage:void (i:int) {
        app.setPage(i)
    }

    fn setFrame:void (i:int) {
        app.setFrame(i)
    }

    fn frameIndex:int () {
        return app.frameIndex
    }

    fn select:void (id:string) {
        app.select(id)
    }

    fn selected:string () {
        return app.selected
    }

    fn hit:string (x:double y:double) {
        return (app.hit(x y))
    }

    ; The view as a camera on the list rather than a transform on the tree.
    ; A pan then costs three numbers and the painter's uniform instead of a
    ; walk of the whole board. See gallery/evg/PLAN_VIEW_TRANSFORM.md.
    fn setCamera:void (on:boolean) {
        app.setCamera(on)
    }

    fn setView:void (x:double y:double sc:double) {
        app.setView(x y sc)
    }

    fn setViewport:void (w:double h:double) {
        app.setViewport(w h)
    }

    fn fit:void () {
        app.fit()
        app.rebuild()
    }

    fn zoom100:void () {
        app.zoom100()
    }

    fn setDebug:void (on:boolean) {
        app.setDebug(on)
    }

    fn debug:boolean () {
        return app.debug
    }

    fn viewX:double () {
        return app.panX
    }

    fn viewY:double () {
        return app.panY
    }

    fn viewScale:double () {
        return app.zoom
    }

    fn imageCount:int () {
        return (app.imageCount())
    }

    fn imageName:string (i:int) {
        return (app.imageName(i))
    }

    fn imageBytes:buffer (name:string) {
        return (app.imageBytes(name))
    }

    fn setImageUrl:void (ref:string url:string) {
        app.setImageUrl(ref url)
    }

    fn fileName:string () {
        return app.doc.fileName
    }
}

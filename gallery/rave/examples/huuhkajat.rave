.4 307 L 160.6 307 M 142.4 320 L 156.7 320' fill='none' stroke='#f7f4ea' stroke-width='3.2'/><path d='M 101.8 310.9 C 94.1 306 78 312.3 78 320 C 78 329.8 94.1 334 101.8 327.7 L 101.8 320.7 L 92.7 320.7' fill='none' stroke='#f7f4ea' stroke-width='3.2'/></svg>">
    <media below="md" style="height: 240px"/>
    <media from="lg" style="height: 420px"/>
  </path>
  <div name="Katsomot" repeat="stands" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px">
    <media below="md" style="grid-template-columns: 1fr 1fr; gap: 8px"/>
    <media from="lg" style="grid-template-columns: repeat(7, 1fr)"/>
    <a class="pcard" label="{name}">
      <media below="md" style="flex-direction: row; align-items: stretch"/>
      <div class="card-head">
        <media below="md" style="width: 48px; padding: 8px; justify-content: center"/>
        <span class="num">{letter}</span>
        <span class="role">{kind}
          <media below="md" style="display: none"/>
        </span>
      </div>
      <div class="card-body">
        <media below="md" style="padding: 8px 10px; flex-grow: 1; min-width: 0; gap: 2px"/>
        <h2 class="subtitle">{name}</h2>
        <p class="muted">{gate}</p>
        <div class="meta">
          <media below="md" style="display: none"/>
          <span class="meta-n">{seats}</span>
        </div>
      </div>
      <on click="navigate" arg="/stadion/{id}"/>
    </a>
  </div>
</page>

<page name="Katsomo" source="stands" sourceKey="id" style="gap: 16px">
  <a class="back">← Pohjapiirros
    <on click="navigate" arg="/stadion"/>
  </a>
  <section class="banner" name="Katsomo" label="{name}">
    <media below="md" style="flex-direction: column; align-items: flex-start; padding: 20px; gap: 16px"/>
    <div class="shirt-xl">
      <media below="md" style="width: 80px; height: 80px"/>
      <span class="shirt-fin">KATSOMO</span>
      <span class="letter-xl">{letter}
        <media below="md" style="font-size: 40px"/>
      </span>
    </div>
    <div name="Nimi" style="flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; flex-grow: 1">
      <p class="kicker-gold">{kind}</p>
      <div class="goldline"></div>
      <h1 class="banner-name">{name}</h1>
      <p class="banner-meta">Portti {gate}</p>
    </div>
  </section>
  <div name="Tilastot" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px">
    <media below="md" style="grid-template-columns: repeat(3, 1fr); gap: 8px"/>
    <section class="stat" label="Paikkoja">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">PAIKKAA</p>
        <p class="stat-n">{seats}</p>
      </div>
    </section>
    <section class="stat" label="Tyyppi">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">TYYPPI</p>
        <p class="stat-n">{kind}
          <media below="md" style="font-size: 16px"/>
        </p>
      </div>
    </section>
    <section class="stat" label="Portti">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">PORTTI</p>
        <p class="stat-n">{gate}
          <media below="md" style="font-size: 16px"/>
        </p>
      </div>
    </section>
  </div>
  <section class="stat" name="Teksti" label="Katsomo">
    <div class="goldbar"></div>
    <div class="stat-body">
      <p class="kicker">NÄKYMÄ</p>
      <p class="bio">{note}</p>
    </div>
  </section>
</page>

<route path="/" title="Joukkue" page="Joukkue" layout="Shell"/>
<route path="/pelaajat" title="Pelaajat" page="Pelaajat" layout="Shell"/>
<route path="/pelaajat/:id" title="Pelaaja" page="Pelaaja" layout="Shell"/>
<route path="/stadion" title="Stadion" page="Stadion" layout="Shell"/>
<route path="/stadion/:id" title="Katsomo" page="Katsomo" layout="Shell"/>

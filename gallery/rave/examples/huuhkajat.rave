<app name="Huuhkajat" targets="web tablet mobile" nav="topbar"/>
<breakpoint name="sm" min="0"/>
<breakpoint name="md" min="768"/>
<breakpoint name="lg" min="1024"/>
<var name="bg" value="#efe8d6"/>
<var name="panel" value="#fbf6ea"/>
<var name="ink" value="#102018"/>
<var name="muted" value="#3a4e44"/>
<var name="pitch" value="#0e3d2a"/>
<var name="pitch-mid" value="#145c38"/>
<var name="pitch-ink" value="#f6f1e3"/>
<var name="line" value="#d4cbb6"/>
<var name="gold" value="#c9a227"/>
<style class="mark">width: 28px; height: 28px; border-radius: 999px; border: 1px solid var(--gold); color: var(--pitch-ink); align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.04em</style>
<style class="brand">font-weight: 700; font-size: 16px; letter-spacing: 0.18em; color: var(--pitch-ink)</style>
<style class="brand-sub">font-size: 10px; letter-spacing: 0.16em; color: var(--gold)</style>
<style class="navlink">padding: 8px 12px; border-radius: 4px; color: var(--pitch-ink); cursor: pointer; font-size: 13px; letter-spacing: 0.04em</style>
<style class="navlink" below="md">padding: 6px 8px; font-size: 12px</style>
<style class="title">font-size: 36px; font-weight: 700; color: var(--ink); letter-spacing: -0.02em</style>
<style class="subtitle">font-size: 16px; font-weight: 700; color: var(--ink)</style>
<style class="muted">color: var(--muted)</style>
<style class="kicker">font-size: 11px; font-weight: 700; letter-spacing: 0.16em; color: var(--muted)</style>
<style class="kicker-gold">font-size: 11px; font-weight: 700; letter-spacing: 0.18em; color: var(--gold)</style>
<style class="hero">background-color: var(--pitch); color: var(--pitch-ink); padding: 28px; border-radius: 4px; gap: 10px</style>
<style class="hero-title">font-size: 40px; font-weight: 700; color: var(--pitch-ink); letter-spacing: -0.03em</style>
<style class="hero-copy">color: var(--pitch-ink); font-size: 15px; line-height: 1.45</style>
<style class="goldline">width: 48px; height: 3px; background-color: var(--gold)</style>
<style class="match">flex-direction: row; align-items: center; gap: 16px; padding: 10px 14px; border: 1px solid var(--gold); border-radius: 4px; width: fit-content</style>
<style class="match-k">font-size: 11px; font-weight: 700; letter-spacing: 0.14em; color: var(--gold)</style>
<style class="match-t">color: var(--pitch-ink); font-size: 14px</style>
<style class="tile">width: 52px; height: 52px; background-color: var(--pitch); color: var(--gold); align-items: center; justify-content: center; font-size: 18px; font-weight: 700; border-radius: 4px; cursor: pointer; border: 1px solid var(--gold)</style>
<style class="stat">flex-direction: row; align-items: stretch; background-color: var(--panel); border: 1px solid var(--line); border-radius: 4px</style>
<style class="goldbar">width: 4px; background-color: var(--gold)</style>
<style class="stat-body">padding: 14px 16px; gap: 2px; flex-grow: 1; min-width: 0</style>
<style class="stat-n">font-size: 28px; font-weight: 700; color: var(--pitch); letter-spacing: -0.03em</style>
<style class="section-h">flex-direction: row; align-items: baseline; justify-content: space-between; gap: 12px</style>
<style class="pcard">flex-direction: column; align-items: stretch; background-color: var(--panel); border: 1px solid var(--line); border-radius: 4px; cursor: pointer; overflow: hidden</style>
<style class="card-head">flex-direction: row; align-items: center; justify-content: space-between; padding: 12px 16px; background-color: var(--pitch)</style>
<style class="num">font-size: 28px; font-weight: 700; color: var(--gold); letter-spacing: -0.04em</style>
<style class="role">font-size: 10px; font-weight: 700; letter-spacing: 0.16em; color: var(--pitch-ink)</style>
<style class="card-body">padding: 14px 16px; gap: 6px</style>
<style class="meta">flex-direction: row; align-items: center; gap: 12px</style>
<style class="meta-n">font-size: 13px; font-weight: 700; color: var(--pitch)</style>
<style class="back">width: fit-content; color: var(--pitch); cursor: pointer; font-weight: 700; font-size: 13px; letter-spacing: 0.04em</style>
<style class="bio">line-height: 1.55; font-size: 15px; color: var(--ink)</style>
<style class="banner">flex-direction: row; align-items: center; gap: 24px; padding: 28px; background-color: var(--pitch); border-radius: 4px</style>
<style class="shirt-xl">width: 112px; height: 112px; border-radius: 4px; background-color: var(--pitch-mid); color: var(--gold); border: 2px solid var(--gold); align-items: center; justify-content: center; gap: 2px</style>
<style class="shirt-fin">font-size: 10px; font-weight: 700; letter-spacing: 0.18em; color: var(--gold)</style>
<style class="shirt-num">font-size: 44px; font-weight: 700; color: var(--gold); letter-spacing: -0.04em</style>
<style class="banner-name">font-size: 36px; font-weight: 700; color: var(--pitch-ink); letter-spacing: -0.03em</style>
<style class="banner-meta">color: var(--pitch-ink); font-size: 15px</style>
<style class="plan">width: 100%; height: 400px</style>
<style class="letter-xl">font-size: 56px; font-weight: 700; color: var(--gold); letter-spacing: -0.04em</style>

<collection name="players" fields="id name number position club caps goals age bio">
  <row id="1" name="Lukas Hradecky" number="1" position="Maalivahti" club="Bayer Leverkusen" caps="94" goals="0" age="35" bio="Huuhkajien kapteeni. Seisoo linjalla rauhallisena ja puhuu puolustuksen kasaan."/>
  <row id="2" name="Nikolai Alho" number="17" position="Puolustaja" club="Asteras Tripolis" caps="42" goals="2" age="32" bio="Oikea laitapuolustaja, joka nousee mukaan hyökkäyksiin eikä säästele metrejä."/>
  <row id="3" name="Robert Ivanov" number="4" position="Puolustaja" club="Eintracht Braunschweig" caps="38" goals="1" age="31" bio="Keskuspuolustaja. Voittaa ilmapallot ja antaa ensimmäisen syötön eteenpäin."/>
  <row id="4" name="Glen Kamara" number="6" position="Keskikenttä" club="Al-Shabab" caps="64" goals="2" age="29" bio="Pelintekijä keskellä. Pitää pallon, katkaisee syötöt ja avaa pelin yhdellä kosketuksella."/>
  <row id="5" name="Kaan Kairinen" number="14" position="Keskikenttä" club="Sparta Praha" caps="21" goals="1" age="26" bio="Syöttösuunta eteen. Pitää tempon ja hakee tilan kymmenen ja kuuden välistä."/>
  <row id="6" name="Teemu Pukki" number="10" position="Hyökkääjä" club="HJK" caps="121" goals="42" age="35" bio="Maajoukkueen maalintekijä. Liikkuu selän taakse ja viimeistelee ensimmäisellä kosketuksella."/>
  <row id="7" name="Joel Pohjanpalo" number="20" position="Hyökkääjä" club="Venezia" caps="78" goals="17" age="31" bio="Kärki joka voittaa kaksinkamppailut. Pukin rinnalla tai yksin keulassa."/>
  <row id="8" name="Oliver Antman" number="7" position="Hyökkääjä" club="Go Ahead Eagles" caps="18" goals="6" age="24" bio="Laita joka vie pallon linjan taa. Nuorin tässä kokoonpanossa, ja näkyy."/>
</collection>

<collection name="stands" fields="id letter name seats kind gate note">
  <row id="a" letter="A" name="Pääkatsomo" seats="7 200" kind="Etelä" gate="A1–A8" note="Oranssi lohko kentän etelälaidalla. Suora näkymä keskikentälle, katos päällä."/>
  <row id="b" letter="B" name="Itäkatsomo" seats="4 800" kind="Perhe" gate="B1–B4" note="Sisempi itäkaarre. Perhepaikat, juoksuradan takana, lähellä kenttää."/>
  <row id="c" letter="C" name="Itäkaarre" seats="4 200" kind="Vieras" gate="C1–C3" note="Ulompi itäkaarre. Vieraslohko kaarteen päässä, avoin taivas."/>
  <row id="d" letter="D" name="Pohjoinen" seats="3 600" kind="Alakatsomo" gate="D1–D4" note="Sisempi pohjoinen. Lähellä kenttää, D:n portaikot vievät E:hen."/>
  <row id="e" letter="E" name="Pohjoiskaarre" seats="6 400" kind="Yläkatsomo" gate="E1–E8" note="Ulompi pohjoinen. Pitkä suora, paras näkymä koko kentälle ylhäältä."/>
  <row id="f" letter="F" name="VIP" seats="2 800" kind="Aitio" gate="F1–F2" note="Sisempi länsi. Aitiot, lehdistö ja tornin puoli."/>
  <row id="g" letter="G" name="Länsikaarre" seats="7 200" kind="Kotikatsomo" gate="G1–G8" note="Ulompi länsi. Huuhkajien laulukuoro kiertää kaarteen ympäri."/>
</collection>

<layout name="Shell" style="width: 100%; height: 100%; background-color: var(--bg); color: var(--ink); font-size: 14px">
  <header name="Header" label="Ylätunniste" style="flex-direction: column; height: 63px; background-color: var(--pitch)">
    <div name="Yläpalkki" style="flex-direction: row; align-items: center; justify-content: space-between; height: 60px; padding: 0 24px">
      <media below="md" style="padding: 0 12px"/>
      <div name="Tunnus" style="flex-direction: row; align-items: center; gap: 12px">
        <div class="mark">H</div>
        <div name="Nimi" style="gap: 1px">
          <span class="brand">HUUHKAJAT</span>
          <span class="brand-sub">SUOMEN PALLOLIITTO · 1907
            <media below="md" style="display: none"/>
          </span>
        </div>
      </div>
      <nav name="Main navigation" label="Päävalikko" style="flex-direction: row; gap: 4px">
        <a class="navlink">Joukkue
          <on click="navigate" arg="/"/>
        </a>
        <a class="navlink">Pelaajat
          <on click="navigate" arg="/pelaajat"/>
        </a>
        <a class="navlink">Stadion
          <on click="navigate" arg="/stadion"/>
        </a>
      </nav>
    </div>
    <div name="Kultaviiva" style="height: 3px; width: 100%; background-color: var(--gold)"></div>
  </header>
  <main name="Main" label="Sisältö" style="padding: 24px; gap: 24px; flex-grow: 1; min-height: 0; overflow: hidden">
    <media below="md" style="padding: 16px; gap: 16px"/>
    <slot/>
  </main>
</layout>

<page name="Joukkue" style="gap: 20px">
  <media below="md" style="gap: 12px"/>
  <section class="hero" name="Hero" label="Johdanto">
    <media below="md" style="padding: 20px; gap: 8px"/>
    <p class="kicker-gold">SUOMEN A-MAAJOUKKUE</p>
    <div class="goldline"></div>
    <h1 class="hero-title">Huuhkajat
      <media below="md" style="font-size: 32px"/>
    </h1>
    <p class="hero-copy">Kahdeksan nimeä avaukseen. Kapteeni, maalintekijä, pelintekijä.</p>
    <div class="match" name="Seuraava ottelu" label="Seuraava ottelu">
      <span class="match-k">SEURAAVA</span>
      <span class="match-t">Slovenia · 14.10. · Helsinki</span>
    </div>
  </section>
  <div name="Luvut" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px">
    <media below="md" style="grid-template-columns: repeat(3, 1fr); gap: 8px"/>
    <section class="stat" label="Otteluita yhdessä">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">OTTELUT</p>
        <p class="stat-n">476</p>
      </div>
    </section>
    <section class="stat" label="Maaleja">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">MAALIT</p>
        <p class="stat-n">71</p>
      </div>
    </section>
    <section class="stat" label="Seuroja">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">SEURAT</p>
        <p class="stat-n">8</p>
      </div>
    </section>
  </div>
  <div class="section-h" name="Osasto">
    <h2 class="subtitle">Avauskokoonpano</h2>
    <p class="kicker">K · KAPTEENI</p>
  </div>
  <div name="Nostot" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px">
    <media below="md" style="grid-template-columns: 1fr"/>
    <a class="pcard" name="Pukki" label="Teemu Pukki">
      <media below="md" style="flex-direction: row; align-items: stretch"/>
      <div class="card-head">
        <media below="md" style="width: 64px; padding: 10px; justify-content: center"/>
        <span class="num">10</span>
        <span class="role">MAALINTEKIJÄ
          <media below="md" style="display: none"/>
        </span>
      </div>
      <div class="card-body">
        <h3 class="subtitle">Teemu Pukki</h3>
        <p class="muted">Hyökkääjä · HJK Helsinki</p>
        <div class="meta">
          <span class="meta-n">121 ott</span>
          <span class="meta-n">42 maal</span>
        </div>
      </div>
      <on click="navigate" arg="/pelaajat/6"/>
    </a>
    <a class="pcard" name="Hradecky" label="Lukas Hradecky">
      <media below="md" style="flex-direction: row; align-items: stretch"/>
      <div class="card-head">
        <media below="md" style="width: 64px; padding: 10px; justify-content: center"/>
        <span class="num">1</span>
        <span class="role">KAPTEENI
          <media below="md" style="display: none"/>
        </span>
      </div>
      <div class="card-body">
        <h3 class="subtitle">Lukas Hradecky</h3>
        <p class="muted">Maalivahti · Bayer Leverkusen</p>
        <div class="meta">
          <span class="meta-n">94 ott</span>
          <span class="meta-n">0 maal</span>
        </div>
      </div>
      <on click="navigate" arg="/pelaajat/1"/>
    </a>
    <a class="pcard" name="Kamara" label="Glen Kamara">
      <media below="md" style="flex-direction: row; align-items: stretch"/>
      <div class="card-head">
        <media below="md" style="width: 64px; padding: 10px; justify-content: center"/>
        <span class="num">6</span>
        <span class="role">PELINTEKIJÄ
          <media below="md" style="display: none"/>
        </span>
      </div>
      <div class="card-body">
        <h3 class="subtitle">Glen Kamara</h3>
        <p class="muted">Keskikenttä · Al-Shabab</p>
        <div class="meta">
          <span class="meta-n">64 ott</span>
          <span class="meta-n">2 maal</span>
        </div>
      </div>
      <on click="navigate" arg="/pelaajat/4"/>
    </a>
  </div>
  <div name="Paidat" style="gap: 10px">
    <media below="md" style="display: none"/>
    <p class="kicker">KOKO AVAUS · 4–3–3</p>
    <div name="Numerot" style="flex-direction: row; gap: 8px">
      <a class="tile" label="Hradecky 1">1
        <on click="navigate" arg="/pelaajat/1"/>
      </a>
      <a class="tile" label="Alho 17">17
        <on click="navigate" arg="/pelaajat/2"/>
      </a>
      <a class="tile" label="Ivanov 4">4
        <on click="navigate" arg="/pelaajat/3"/>
      </a>
      <a class="tile" label="Kamara 6">6
        <on click="navigate" arg="/pelaajat/4"/>
      </a>
      <a class="tile" label="Kairinen 14">14
        <on click="navigate" arg="/pelaajat/5"/>
      </a>
      <a class="tile" label="Pukki 10">10
        <on click="navigate" arg="/pelaajat/6"/>
      </a>
      <a class="tile" label="Pohjanpalo 20">20
        <on click="navigate" arg="/pelaajat/7"/>
      </a>
      <a class="tile" label="Antman 7">7
        <on click="navigate" arg="/pelaajat/8"/>
      </a>
    </div>
  </div>
</page>

<page name="Pelaajat" style="gap: 16px">
  <media below="md" style="gap: 8px"/>
  <div name="Otsikko" style="gap: 6px">
    <p class="kicker">KOKOONPANO · 4–3–3
      <media below="md" style="display: none"/>
    </p>
    <h1 class="title">Pelaajat
      <media below="md" style="font-size: 24px"/>
    </h1>
    <p class="muted">Numero, paikka, seura, ottelut ja maalit.
      <media below="md" style="display: none"/>
    </p>
  </div>
  <div name="Lista" repeat="players" style="display: grid; grid-template-columns: 1fr; gap: 8px">
    <media below="md" style="gap: 6px"/>
    <media from="md" style="grid-template-columns: repeat(2, 1fr); gap: 12px"/>
    <media from="lg" style="grid-template-columns: repeat(4, 1fr)"/>
    <a class="pcard" label="{name}">
      <media below="md" style="flex-direction: row; align-items: stretch"/>
      <div class="card-head">
        <media below="md" style="width: 52px; padding: 8px; justify-content: center"/>
        <span class="num">{number}</span>
        <span class="role">{position}
          <media below="md" style="display: none"/>
        </span>
      </div>
      <div class="card-body">
        <media below="md" style="padding: 8px 12px; flex-grow: 1; min-width: 0; gap: 2px"/>
        <h2 class="subtitle">{name}</h2>
        <p class="muted">{club}</p>
        <div class="meta">
          <media below="md" style="display: none"/>
          <span class="meta-n">{caps} ott</span>
          <span class="meta-n">{goals} maal</span>
        </div>
      </div>
      <on click="navigate" arg="/pelaajat/{id}"/>
    </a>
  </div>
</page>

<page name="Pelaaja" source="players" sourceKey="id" style="gap: 20px">
  <a class="back">← Koko avaus
    <on click="navigate" arg="/pelaajat"/>
  </a>
  <section class="banner" name="Paita" label="{name}">
    <media below="md" style="flex-direction: column; align-items: flex-start; padding: 20px; gap: 16px"/>
    <div class="shirt-xl">
      <media below="md" style="width: 80px; height: 80px"/>
      <span class="shirt-fin">FIN</span>
      <span class="shirt-num">{number}
        <media below="md" style="font-size: 32px"/>
      </span>
    </div>
    <div name="Nimi" style="flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; flex-grow: 1">
      <p class="kicker-gold">{position}</p>
      <div class="goldline"></div>
      <h1 class="banner-name">{name}</h1>
      <p class="banner-meta">{club}</p>
    </div>
  </section>
  <div name="Tilastot" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px">
    <media below="md" style="grid-template-columns: repeat(3, 1fr); gap: 8px"/>
    <section class="stat" label="Ottelut">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">OTTELUT</p>
        <p class="stat-n">{caps}</p>
      </div>
    </section>
    <section class="stat" label="Maalit">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">MAALIT</p>
        <p class="stat-n">{goals}</p>
      </div>
    </section>
    <section class="stat" label="Ikä">
      <div class="goldbar"></div>
      <div class="stat-body">
        <p class="kicker">IKÄ</p>
        <p class="stat-n">{age}</p>
      </div>
    </section>
  </div>
  <section class="stat" name="Teksti" label="Pelissä">
    <div class="goldbar"></div>
    <div class="stat-body">
      <p class="kicker">PELISSÄ</p>
      <p class="bio">{bio}</p>
    </div>
  </section>
</page>

<page name="Stadion" style="gap: 16px">
  <media below="md" style="gap: 10px"/>
  <div name="Otsikko" style="gap: 4px">
    <p class="kicker">HELSINKI · TÖÖLÖ · 1938</p>
    <h1 class="title">Olympiastadion
      <media below="md" style="font-size: 24px"/>
    </h1>
  </div>
  <div name="Luvut" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px">
    <media below="md" style="grid-template-columns: repeat(3, 1fr); gap: 8px"/>
    <section class="stat" label="Paikkoja">
      <div class="goldbar"></div>
      <div class="stat-body">
        <media below="md" style="padding: 10px 10px"/>
        <p class="kicker">PAIKKAA</p>
        <p class="stat-n">36 200
          <media below="md" style="font-size: 20px"/>
        </p>
      </div>
    </section>
    <section class="stat" label="Katsomoita">
      <div class="goldbar"></div>
      <div class="stat-body">
        <media below="md" style="padding: 10px 10px"/>
        <p class="kicker">KATSOMOT</p>
        <p class="stat-n">7
          <media below="md" style="font-size: 20px"/>
        </p>
      </div>
    </section>
    <section class="stat" label="Seuraava ottelu">
      <div class="goldbar"></div>
      <div class="stat-body">
        <media below="md" style="padding: 10px 10px"/>
        <p class="kicker">14.10.</p>
        <p class="stat-n">SLO
          <media below="md" style="font-size: 20px"/>
        </p>
      </div>
    </section>
  </div>

; =============================================================================
; RaveJson — a small JSON value, read and written in Ranger
; =============================================================================
; `app.rave.json` has to open on every target the runtime compiles to, so the
; parser is plain Ranger over a string rather than a host's JSON object. It is
; strict enough for what `RaveApp.toJson` writes and forgiving about
; whitespace, which is all a document format needs.
; =============================================================================

class RaveJv {
    ; obj | arr | str | num | bool | null
    def kind:string "null"
    def str:string ""
    def num:double 0.0
    def flag:boolean false
    def keys:[string]
    def vals:[RaveJv]
    def items:[RaveJv]

    Constructor () {
    }

    fn isObj:boolean () {
        return (kind == "obj")
    }

    fn isArr:boolean () {
        return (kind == "arr")
    }

    fn has:boolean (key:string) {
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn get:RaveJv (key:string) {
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                def v:RaveJv (itemAt vals i)
                return v
            }
            i = (i + 1)
        }
        def none (new RaveJv())
        return none
    }

    fn s:string (key:string) {
        def v:RaveJv (this.get(key))
        return v.str
    }

    fn n:double (key:string) {
        def v:RaveJv (this.get(key))
        return v.num
    }

    fn i:int (key:string) {
        def v:RaveJv (this.get(key))
        return (to_int v.num)
    }

    fn b:boolean (key:string) {
        def v:RaveJv (this.get(key))
        return v.flag
    }

    fn a:RaveJv (key:string) {
        return (this.get(key))
    }

    fn count:int () {
        return (array_length items)
    }

    fn at:RaveJv (index:int) {
        def v:RaveJv (itemAt items index)
        return v
    }

    fn put:void (key:string v:RaveJv) {
        push keys key
        push vals v
    }
}

class RaveJsonParser {
    def src:string ""
    def pos:int 0
    def failed:boolean false

    Constructor (s:string) {
        src = s
    }

    fn peek:int () {
        if (pos >= (strlen src)) {
            return 0
        }
        return (charAt src pos)
    }

    fn ws:void () {
        def go:boolean true
        while go {
            def c:int (this.peek())
            if ((c == 32) || (c == 10) || (c == 13) || (c == 9)) {
                pos = (pos + 1)
            } {
                go = false
            }
        }
    }

    fn value:RaveJv () {
        this.ws()
        def v (new RaveJv())
        def c:int (this.peek())
        if (c == 123) {
            return (this.object())
        }
        if (c == 91) {
            return (this.array())
        }
        if (c == 34) {
            v.kind = "str"
            v.str = (this.string())
            return v
        }
        if (c == 116) {
            pos = (pos + 4)
            v.kind = "bool"
            v.flag = true
            return v
        }
        if (c == 102) {
            pos = (pos + 5)
            v.kind = "bool"
            v.flag = false
            return v
        }
        if (c == 110) {
            pos = (pos + 4)
            return v
        }
        return (this.number())
    }

    fn object:RaveJv () {
        def v (new RaveJv())
        v.kind = "obj"
        pos = (pos + 1)
        this.ws()
        if ((this.peek()) == 125) {
            pos = (pos + 1)
            return v
        }
        def go:boolean true
        while go {
            this.ws()
            if ((this.peek()) != 34) {
                failed = true
                return v
            }
            def key:string (this.string())
            this.ws()
            if ((this.peek()) != 58) {
                failed = true
                return v
            }
            pos = (pos + 1)
            def child:RaveJv (this.value())
            v.put(key child)
            this.ws()
            def c:int (this.peek())
            if (c == 44) {
                pos = (pos + 1)
            } {
                if (c == 125) {
                    pos = (pos + 1)
                }
                go = false
                if (c != 125) {
                    failed = true
                }
            }
        }
        return v
    }

    fn array:RaveJv () {
        def v (new RaveJv())
        v.kind = "arr"
        pos = (pos + 1)
        this.ws()
        if ((this.peek()) == 93) {
            pos = (pos + 1)
            return v
        }
        def go:boolean true
        while go {
            def child:RaveJv (this.value())
            push v.items child
            this.ws()
            def c:int (this.peek())
            if (c == 44) {
                pos = (pos + 1)
            } {
                if (c == 93) {
                    pos = (pos + 1)
                }
                go = false
                if (c != 93) {
                    failed = true
                }
            }
        }
        return v
    }

    sfn hexVal:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return ((c - 97) + 10)
        }
        if ((c >= 65) && (c <= 70)) {
            return ((c - 65) + 10)
        }
        return 0
    }

    fn string:string () {
        pos = (pos + 1)
        def out:string ""
        def go:boolean true
        while go {
            if (pos >= (strlen src)) {
                failed = true
                return out
            }
            def c:int (charAt src pos)
            if (c == 34) {
                pos = (pos + 1)
                go = false
            } {
                if (c == 92) {
                    pos = (pos + 1)
                    def e:int (charAt src pos)
                    if (e == 110) {
                        out = (out + "\n")
                    } {
                        if (e == 116) {
                            out = (out + "\t")
                        } {
                            if (e == 114) {
                                out = (out + "\r")
                            } {
                                if (e == 117) {
                                    def code:int 0
                                    def k:int 1
                                    while (k <= 4) {
                                        code = ((code * 16) + (RaveJsonParser.hexVal((charAt src (pos + k)))))
                                        k = (k + 1)
                                    }
                                    pos = (pos + 4)
                                    out = (out + (strfromcode code))
                                } {
                                    out = (out + (strfromcode e))
                                }
                            }
                        }
                    }
                    pos = (pos + 1)
                } {
                    out = (out + (strfromcode c))
                    pos = (pos + 1)
                }
            }
        }
        return out
    }

    fn number:RaveJv () {
        def v (new RaveJv())
        v.kind = "num"
        def neg:boolean false
        if ((this.peek()) == 45) {
            neg = true
            pos = (pos + 1)
        }
        def whole:double 0.0
        def go:boolean true
        while go {
            def c:int (this.peek())
            if ((c >= 48) && (c <= 57)) {
                whole = ((whole * 10.0) + (to_double (c - 48)))
                pos = (pos + 1)
            } {
                go = false
            }
        }
        if ((this.peek()) == 46) {
            pos = (pos + 1)
            def scale:double 0.1
            def more:boolean true
            while more {
                def c2:int (this.peek())
                if ((c2 >= 48) && (c2 <= 57)) {
                    whole = (whole + ((to_double (c2 - 48)) * scale))
                    scale = (scale * 0.1)
                    pos = (pos + 1)
                } {
                    more = false
                }
            }
        }
        if (neg) {
            whole = (0.0 - whole)
        }
        v.num = whole
        return v
    }
}

class RaveJson {

    sfn parse:RaveJv (s:string) {
        def p (new RaveJsonParser(s))
        def v:RaveJv (p.value())
        if p.failed {
            def bad (new RaveJv())
            return bad
        }
        return v
    }

    ; A JSON string literal, quotes included.
    sfn q:string (v:string) {
        def out:string "\""
        def i:int 0
        while (i < (strlen v)) {
            def ch:int (charAt v i)
            if (ch == 34) {
                out = (out + "\\\"")
            } {
                if (ch == 92) {
                    out = (out + "\\\\")
                } {
                    if (ch == 10) {
                        out = (out + "\\n")
                    } {
                        if (ch == 13) {
                            out = (out + "\\r")
                        } {
                            if (ch == 9) {
                                out = (out + "\\t")
                            } {
                                if (ch < 32) {
                                    out = (out + " ")
                                } {
                                    out = (out + (strfromcode ch))
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (out + "\"")
    }

    sfn bool:string (v:boolean) {
        if v {
            return "true"
        }
        return "false"
    }

    sfn strArr:string (items:[string]) {
        def out:string "["
        def i:int 0
        while (i < (array_length items)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + (RaveJson.q((itemAt items i))))
            i = (i + 1)
        }
        return (out + "]")
    }
}

; =============================================================================
; RaveKit — what the Components pane offers
; =============================================================================
; Each entry makes a node tree in the document's own vocabulary — a Button is
; a `button` with the `btn` class, a Card a `section.card` with a heading
; and a paragraph — so what is dropped is already accessible, already styled
; by the shared rules the theme carries, and already runs. The kit is the
; shadcn/ui list; what gallery/ui has a controller for is bound at run time
; in later stages.
; =============================================================================

Import "RaveDoc.rgr"

class RaveKit {

    sfn kinds:[string] () {
        def out:[string]
        push out "Container"
        push out "Section"
        push out "Heading"
        push out "Text"
        push out "Button"
        push out "Link"
        push out "Input"
        push out "Card"
        push out "Image"
        push out "Navigation"
        push out "Form"
        push out "List"
        push out "Select"
        push out "Tabs"
        push out "Dialog"
        push out "Toggle"
        return out
    }

    ; A kit instance: a node the runtime binds to a gallery/ui controller.
    sfn instance:RaveNode (app:RaveApp component:string name:string) {
        def n:RaveNode (app.newNode("div" name))
        n.kind = "instance"
        n.component = component
        return n
    }

    ; A tab of a Tabs instance: its name is the tab, its children the panel.
    sfn tab:RaveNode (app:RaveApp tabs:RaveNode title:string) {
        def t:RaveNode (tabs.add((app.newNode("div" title))))
        app.style(t "gap" "12px")
        return t
    }

    sfn option:RaveNode (app:RaveApp sel:RaveNode text:string) {
        return (sel.add((app.newText("li" text))))
    }

    sfn isKind:boolean (kind:string) {
        def all:[string] (RaveKit.kinds())
        def i:int 0
        while (i < (array_length all)) {
            if ((itemAt all i) == kind) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Whether a node can hold children the editor may drop into it.
    sfn isContainer:boolean (n:RaveNode) {
        def t:string n.tag
        if (t == "div") { return true }
        if (t == "section") { return true }
        if (t == "header") { return true }
        if (t == "footer") { return true }
        if (t == "main") { return true }
        if (t == "aside") { return true }
        if (t == "nav") { return true }
        if (t == "form") { return true }
        if (t == "ul") { return true }
        if (t == "li") { return true }
        return false
    }

    ; A labelled input: the label is what a reader hears, the placeholder
    ; what a sighted person sees in the empty box. The input is a kit
    ; instance, so in Run it takes typing.
    sfn field:RaveNode (app:RaveApp label:string placeholder:string) {
        def f:RaveNode (app.newNode("div" label))
        f.addClass("field")
        def lab:RaveNode (f.add((app.newText("label" label))))
        lab.addClass("muted")
        def input:RaveNode (f.add((RaveKit.instance(app "Input" label))))
        input.tag = "input"
        input.addClass("input")
        input.label = label
        input.placeholder = placeholder
        return f
    }

    sfn create:RaveNode (app:RaveApp kind:string) {
        if (kind == "Section") {
            def s:RaveNode (app.newNode("section" "Section"))
            s.label = "Section"
            app.style(s "gap" "16px")
            app.style(s "padding" "16px")
            return s
        }
        if (kind == "Heading") {
            def h:RaveNode (app.newText("h2" "Heading"))
            h.addClass("title")
            return h
        }
        if (kind == "Text") {
            def p:RaveNode (app.newText("p" "Text. Select it and type to change what it says."))
            return p
        }
        if (kind == "Button") {
            def b:RaveNode (app.newText("button" "Button"))
            b.addClass("btn")
            app.style(b "width" "fit-content")
            return b
        }
        if (kind == "Link") {
            def a:RaveNode (app.newText("a" "Link"))
            a.addClass("navlink")
            app.style(a "width" "fit-content")
            return a
        }
        if (kind == "Input") {
            return (RaveKit.field(app "Label" "Type here"))
        }
        if (kind == "Card") {
            def c:RaveNode (app.newNode("section" "Card"))
            c.addClass("card")
            c.label = "Card"
            def h3:RaveNode (c.add((app.newText("h3" "Card title"))))
            h3.addClass("subtitle")
            def body:RaveNode (c.add((app.newText("p" "What this card is about."))))
            body.addClass("muted")
            return c
        }
        if (kind == "Image") {
            def img:RaveNode (app.newNode("img" "Image"))
            img.alt = "Image"
            app.style(img "width" "100%")
            app.style(img "height" "160px")
            app.style(img "background-color" "var(--panel)")
            app.style(img "border-radius" "var(--radius)")
            return img
        }
        if (kind == "Navigation") {
            def nav:RaveNode (app.newNode("nav" "Navigation"))
            nav.label = "Navigation"
            app.style(nav "flex-direction" "row")
            app.style(nav "gap" "4px")
            def l1:RaveNode (nav.add((app.newText("a" "First"))))
            l1.addClass("navlink")
            def l2:RaveNode (nav.add((app.newText("a" "Second"))))
            l2.addClass("navlink")
            return nav
        }
        if (kind == "Form") {
            def f:RaveNode (app.newNode("form" "Form"))
            f.label = "Form"
            app.style(f "gap" "12px")
            app.style(f "max-width" "480px")
            f.add((RaveKit.field(app "Name" "Your name")))
            def go:RaveNode (f.add((app.newText("button" "Submit"))))
            go.addClass("btn")
            app.style(go "width" "fit-content")
            return f
        }
        if (kind == "Select") {
            def sel:RaveNode (RaveKit.instance(app "Select" "Select"))
            sel.label = "Choice"
            RaveKit.option(app sel "First")
            RaveKit.option(app sel "Second")
            RaveKit.option(app sel "Third")
            return sel
        }
        if (kind == "Tabs") {
            def tabs:RaveNode (RaveKit.instance(app "Tabs" "Tabs"))
            def a:RaveNode (RaveKit.tab(app tabs "First"))
            a.add((app.newText("p" "The first panel.")))
            def b:RaveNode (RaveKit.tab(app tabs "Second"))
            b.add((app.newText("p" "The second panel.")))
            return tabs
        }
        if (kind == "Dialog") {
            def dlg:RaveNode (RaveKit.instance(app "Dialog" "Dialog title"))
            dlg.text = "Open dialog"
            dlg.add((app.newText("p" "What the dialog asks.")))
            def ok:RaveNode (dlg.add((app.newText("button" "Continue"))))
            ok.addClass("btn")
            app.style(ok "width" "fit-content")
            return dlg
        }
        if (kind == "Toggle") {
            def tg:RaveNode (RaveKit.instance(app "Toggle" "Toggle"))
            tg.text = "Toggle"
            return tg
        }
        if (kind == "List") {
            def ul:RaveNode (app.newNode("ul" "List"))
            app.style(ul "gap" "4px")
            ul.add((app.newText("li" "First item")))
            ul.add((app.newText("li" "Second item")))
            ul.add((app.newText("li" "Third item")))
            return ul
        }
        def d:RaveNode (app.newNode("div" "Container"))
        app.style(d "gap" "16px")
        app.style(d "padding" "16px")
        return d
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RaveImport — a Figma file, read as an application
; =============================================================================
; A `.fig` file is a tree of boxes at absolute coordinates. A Rave document is
; routes, layouts and flex. Nothing in the file says which of its rectangles is
; a header and which is a button, so this reads the file the way a person does:
; by what things are called, where they sit, and what they are made of.
;
; THE THREE THINGS IT WORKS OUT ----------------------------------------------
;
;   the layout    A Figma frame with auto-layout already IS a flex box, and
;                 that is taken as it stands. A frame without one is a pile of
;                 absolute rectangles, and those are cut into rows and columns
;                 by an XY cut: find a horizontal line no child crosses, and
;                 the children above and below it are two items of a column;
;                 no such line, try a vertical one and get a row; neither, and
;                 the children really do overlap, so they stay absolute and the
;                 report says so. A band with more than one child becomes a
;                 container of its own and is cut the other way, which is how
;                 a flat pile becomes a tree.
;
;   the meaning   A name is the strongest evidence there is — a designer who
;                 called a layer "Header" meant it — so names are read first,
;                 and shape decides the rest: the top strip of a screen is a
;                 header, a tall narrow column beside a wide one is a sidebar,
;                 a rounded box with one line of text in it is a button, a box
;                 with a border and a grey line of text is an input. Every
;                 guess that was not certain is written down.
;
;   the structure One top-level frame is one route. When several frames agree
;                 about a child — same name, same box — that child is the same
;                 furniture drawn on every screen, so it is lifted into a
;                 layout with a slot where the screens differ. That is the
;                 difference between importing five pictures and importing an
;                 application.
;
; What it does NOT do: it never invents. A rule it writes is a measurement
; from the file; a guess it makes is in the report with the reason.
; =============================================================================

Import "RaveDoc.rgr"
Import "RavePatterns.rgr"
Import "../../figma/src/scene/SceneNode.rgr"

class RaveImportNote {
    ; layout | guess | absolute | dropped
    def kind:string "guess"
    def nodeName:string ""
    def detail:string ""

    Constructor (k:string n:string d:string) {
        kind = k
        nodeName = n
        detail = d
    }

    fn line:string () {
        return (kind + "  " + nodeName + " — " + detail)
    }
}

class RaveImportReport {
    def frames:int 0
    def nodes:int 0
    ; containers whose flex came from the file's own auto-layout
    def auto:int 0
    ; containers whose flex was worked out from where the boxes sit
    def inferred:int 0
    ; containers whose children overlap, so they stayed absolute
    def absolute:int 0
    ; containers a cut turned into a tree
    def grouped:int 0
    def notes:[RaveImportNote]

    Constructor () {
    }

    fn note:void (kind:string name:string detail:string) {
        push notes (new RaveImportNote(kind name detail))
    }

    fn noteCount:int () {
        return (array_length notes)
    }

    fn noteAt:string (i:int) {
        def n:RaveImportNote (itemAt notes i)
        return (n.line())
    }

    fn summary:string () {
        return ((to_string frames) + " screens · " + (to_string nodes) + " nodes · "
            + (to_string auto) + " auto-layout · " + (to_string inferred) + " inferred · "
            + (to_string grouped) + " grouped · " + (to_string absolute) + " absolute")
    }
}

class RaveImport {
    def app:RaveApp (new RaveApp("Imported"))
    def report:RaveImportReport (new RaveImportReport())
    ; The frame being converted, so a child can ask how big the screen is.
    def frameW:double 0.0
    def frameH:double 0.0

    Constructor () {
    }

    ; --- numbers ---------------------------------------------------------------

    sfn round1:double (v:double) {
        def scaled:double (v * 10.0)
        def i:int (to_int (scaled + 0.5))
        if (scaled < 0.0) {
            i = (to_int (scaled - 0.5))
        }
        return ((to_double i) / 10.0)
    }

    ; A length as CSS. Whole numbers stay whole, because "16px" is what a
    ; designer typed and "16.0px" is what a float printer says.
    sfn px:string (v:double) {
        def r:double (RaveImport.round1(v))
        def whole:int (to_int r)
        if ((RaveImport.round1((to_double whole))) == r) {
            return ((to_string whole) + "px")
        }
        return ((to_string r) + "px")
    }

    sfn num:string (v:double) {
        def r:double (RaveImport.round1(v))
        def whole:int (to_int r)
        if ((RaveImport.round1((to_double whole))) == r) {
            return (to_string whole)
        }
        return (to_string r)
    }

    sfn same:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        return (d <= 1.0)
    }

    sfn maxOf:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }

    sfn minOf:double (a:double b:double) {
        if (a < b) {
            return a
        }
        return b
    }

    ; --- words -----------------------------------------------------------------

    sfn lower:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if ((c >= 65) && (c <= 90)) {
                c = (c + 32)
            }
            out = (out + (strfromcode c))
            i = (i + 1)
        }
        return out
    }

    sfn hasWord:boolean (haystack:string needle:string) {
        return ((indexOf (RaveImport.lower(haystack)) needle) >= 0)
    }

    ; A layer name as a path: "Sign in" becomes "/sign-in".
    sfn slug:string (s:string) {
        def low:string (RaveImport.lower(s))
        def out:string ""
        def dash:boolean false
        def i:int 0
        while (i < (strlen low)) {
            def c:int (charAt low i)
            def ok:boolean (((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57)))
            if ok {
                if (dash && ((strlen out) > 0)) {
                    out = (out + "-")
                }
                dash = false
                out = (out + (strfromcode c))
            } {
                dash = true
            }
            i = (i + 1)
        }
        return out
    }

    ; --- the XY cut ------------------------------------------------------------

    ; The children in order along one axis. Insertion sort over an index
    ; array, because a scene node is not something to shuffle about.
    sfn order:[int] (kids:[SceneNode] horizontal:boolean) {
        def out:[int]
        def i:int 0
        while (i < (array_length kids)) {
            def k:SceneNode (itemAt kids i)
            def key:double k.y
            if horizontal {
                key = k.x
            }
            def at:int (array_length out)
            def j:int 0
            def placed:boolean false
            while ((j < (array_length out)) && (placed == false)) {
                def other:SceneNode (itemAt kids (itemAt out j))
                def okey:double other.y
                if horizontal {
                    okey = other.x
                }
                if (key < okey) {
                    at = j
                    placed = true
                }
                j = (j + 1)
            }
            push out 0
            def m:int ((array_length out) - 1)
            while (m > at) {
                set out m (itemAt out (m - 1))
                m = (m - 1)
            }
            set out at i
            i = (i + 1)
        }
        return out
    }

    sfn startOf:double (k:SceneNode horizontal:boolean) {
        if horizontal {
            return k.x
        }
        return k.y
    }

    sfn endOf:double (k:SceneNode horizontal:boolean) {
        if horizontal {
            return (k.x + k.w)
        }
        return (k.y + k.h)
    }

    ; Which band each position in `order` falls into. A band ends where no
    ; child crosses the line: the sweep keeps the furthest edge seen so far,
    ; and a child starting past it opens a new band.
    sfn bandsOf:[int] (kids:[SceneNode] ord:[int] horizontal:boolean) {
        def out:[int]
        def band:int 0
        def edge:double 0.0
        def i:int 0
        while (i < (array_length ord)) {
            def k:SceneNode (itemAt kids (itemAt ord i))
            def s:double (RaveImport.startOf(k horizontal))
            def e:double (RaveImport.endOf(k horizontal))
            if (i == 0) {
                edge = e
            } {
                if (s >= (edge - 0.5)) {
                    band = (band + 1)
                    edge = e
                } {
                    edge = (RaveImport.maxOf(edge e))
                }
            }
            push out band
            i = (i + 1)
        }
        return out
    }

    sfn bandCount:[int] (bands:[int]) {
        def out:[int]
        def i:int 0
        while (i < (array_length bands)) {
            def b:int (itemAt bands i)
            while ((array_length out) <= b) {
                push out 0
            }
            set out b ((itemAt out b) + 1)
            i = (i + 1)
        }
        return out
    }

    ; --- what a box is ---------------------------------------------------------

    ; The first run of text anywhere under a node, and how many there are.
    ; A button is a box with ONE line in it; a card has several.
    sfn textIn:string (n:SceneNode) {
        if (n.kind == "text") {
            return n.text.characters
        }
        def i:int 0
        while (i < (array_length n.children)) {
            def c:SceneNode (itemAt n.children i)
            def got:string (RaveImport.textIn(c))
            if ((strlen got) > 0) {
                return got
            }
            i = (i + 1)
        }
        return ""
    }

    sfn textCount:int (n:SceneNode) {
        if (n.kind == "text") {
            if ((strlen n.text.characters) > 0) {
                return 1
            }
            return 0
        }
        def total:int 0
        def i:int 0
        while (i < (array_length n.children)) {
            total = (total + (RaveImport.textCount((itemAt n.children i))))
            i = (i + 1)
        }
        return total
    }

    sfn firstText:SceneNode (n:SceneNode) {
        if (n.kind == "text") {
            return n
        }
        def i:int 0
        while (i < (array_length n.children)) {
            def c:SceneNode (itemAt n.children i)
            def got:SceneNode (RaveImport.firstText(c))
            if (got.kind == "text") {
                return got
            }
            i = (i + 1)
        }
        def none (new SceneNode())
        return none
    }

    sfn hasFill:boolean (n:SceneNode) {
        def f:SceneFill (n.firstFill())
        if (f.visible == false) {
            return false
        }
        return ((f.a * f.opacity) > 0.02)
    }

    sfn hasStroke:boolean (n:SceneNode) {
        return ((array_length n.strokes) > 0)
    }

    sfn isPicture:boolean (n:SceneNode) {
        if ((strlen n.imageRef) > 0) {
            return true
        }
        def f:SceneFill (n.firstFill())
        if (f.visible && (f.kind == "image")) {
            return true
        }
        return false
    }

    ; The children worth carrying over: something that is on the screen and
    ; has a size. A hidden layer is not a design decision anyone wants
    ; imported, and a zero box draws nothing.
    sfn liveChildren:[SceneNode] (n:SceneNode) {
        def out:[SceneNode]
        def i:int 0
        while (i < (array_length n.children)) {
            def c:SceneNode (itemAt n.children i)
            if (c.visible && ((c.w > 0.5) && (c.h > 0.5))) {
                push out c
            }
            i = (i + 1)
        }
        return out
    }

    ; The tag a text run becomes: Figma has one text node and HTML has six,
    ; and size with weight is what tells them apart.
    sfn textTag:string (n:SceneNode) {
        def size:double n.text.fontSize
        def bold:boolean false
        if ((n.text.fontWeight == "600") || (n.text.fontWeight == "700")) {
            bold = true
        }
        if (n.text.fontWeight == "800") { bold = true }
        if (n.text.fontWeight == "900") { bold = true }
        if (size >= 30.0) { return "h1" }
        if (size >= 22.0) { return "h2" }
        if ((size >= 17.0) && bold) { return "h3" }
        if (size >= 17.0) { return "p" }
        if (bold) { return "h4" }
        return "p"
    }

    ; The name is the strongest evidence in the file: a layer somebody called
    ; "Header" is a header, and no arithmetic about where it sits beats that.
    sfn byName:string (name:string) {
        if (RaveImport.hasWord(name "header")) { return "header" }
        if (RaveImport.hasWord(name "topbar")) { return "header" }
        if (RaveImport.hasWord(name "top bar")) { return "header" }
        if (RaveImport.hasWord(name "appbar")) { return "header" }
        if (RaveImport.hasWord(name "footer")) { return "footer" }
        if (RaveImport.hasWord(name "sidebar")) { return "aside" }
        if (RaveImport.hasWord(name "side bar")) { return "aside" }
        if (RaveImport.hasWord(name "sidenav")) { return "aside" }
        if (RaveImport.hasWord(name "navigation")) { return "nav" }
        if (RaveImport.hasWord(name "navbar")) { return "nav" }
        if (RaveImport.hasWord(name "tabbar")) { return "nav" }
        if (RaveImport.hasWord(name "tab bar")) { return "nav" }
        if (RaveImport.hasWord(name "button")) { return "button" }
        if (RaveImport.hasWord(name "btn")) { return "button" }
        if (RaveImport.hasWord(name "input")) { return "input" }
        if (RaveImport.hasWord(name "textfield")) { return "input" }
        if (RaveImport.hasWord(name "text field")) { return "input" }
        if (RaveImport.hasWord(name "search")) { return "input" }
        if (RaveImport.hasWord(name "card")) { return "section" }
        if (RaveImport.hasWord(name "main")) { return "main" }
        if (RaveImport.hasWord(name "content")) { return "main" }
        if (RaveImport.hasWord(name "form")) { return "form" }
        return ""
    }

    ; What a container becomes. `hint` is where the parent's cut put it —
    ; top, bottom, left, right or nothing — and `structural` says it is one
    ; of the screen's own bands rather than something deep inside a card.
    fn guess:string (n:SceneNode hint:string structural:boolean) {
        def named:string (RaveImport.byName(n.name))
        if ((strlen named) > 0) {
            return named
        }
        if (RaveImport.isPicture(n)) {
            report.note("guess" n.name "a picture fill, so an img")
            return "img"
        }
        def texts:int (RaveImport.textCount(n))
        def rounded:boolean (n.radius.any())
        def filled:boolean (RaveImport.hasFill(n))
        def stroked:boolean (RaveImport.hasStroke(n))

        ; A rounded, filled box with one line in it, no bigger than a button
        if (((texts == 1) && rounded) && (filled && ((n.h >= 24.0) && (n.h <= 72.0)))) {
            if (n.w <= 360.0) {
                report.note("guess" n.name ("rounded, filled, one line, " + (RaveImport.num(n.w)) + "×" + (RaveImport.num(n.h)) + " — a button"))
                return "button"
            }
        }
        ; A bordered box with one line in it, at field height
        if (((texts == 1) && stroked) && ((n.h >= 28.0) && (n.h <= 64.0))) {
            report.note("guess" n.name "a bordered box with one line at field height — an input")
            return "input"
        }
        if structural {
            if (((hint == "top") && (n.h <= 160.0)) && (n.h >= 24.0)) {
                report.note("guess" n.name ("the top band of the screen, " + (RaveImport.num(n.h)) + " tall — a header"))
                return "header"
            }
            if (((hint == "bottom") && (n.h <= 160.0)) && (n.h >= 24.0)) {
                report.note("guess" n.name ("the bottom band of the screen — a footer"))
                return "footer"
            }
            if (((hint == "left") && (n.w <= 380.0)) && (n.h >= (frameH * 0.5))) {
                report.note("guess" n.name ("a tall column down the left, " + (RaveImport.num(n.w)) + " wide — a sidebar"))
                return "aside"
            }
            if (hint == "main") {
                return "main"
            }
        }
        ; A box that is drawn — a border or a fill with a corner — and holds
        ; more than one thing is a card, in every design system there is.
        if ((texts >= 2) && (stroked || (filled && rounded))) {
            report.note("guess" n.name "drawn, with more than one thing in it — a section")
            return "section"
        }
        return "div"
    }

    ; --- style -----------------------------------------------------------------

    fn paint:void (target:RaveNode n:SceneNode) {
        def f:SceneFill (n.firstFill())
        if (f.visible && (f.kind == "solid")) {
            if ((f.a * f.opacity) > 0.004) {
                app.style(target "background-color" (f.hexA()))
            }
        }
        if ((array_length n.strokes) > 0) {
            def s:SceneStroke (itemAt n.strokes 0)
            def weight:double s.weight
            if s.perSide {
                ; EVG has `border` and no per-side shorthand, so the heaviest
                ; side stands for the box and the report says what was lost.
                weight = (RaveImport.maxOf((RaveImport.maxOf(s.wTop s.wRight)) (RaveImport.maxOf(s.wBottom s.wLeft))))
                report.note("dropped" n.name "a border with a weight per side became one border")
            }
            if (weight > 0.0) {
                app.style(target "border" ((RaveImport.px(weight)) + " solid " + (s.hex())))
            }
        }
        if (n.radius.any()) {
            if n.radius.uniform {
                app.style(target "border-radius" (RaveImport.px(n.radius.tl)))
            } {
                app.style(target "border-radius" (((RaveImport.px(n.radius.tl)) + " " + (RaveImport.px(n.radius.tr))) + " " + ((RaveImport.px(n.radius.br)) + " " + (RaveImport.px(n.radius.bl)))))
            }
        }
        if ((array_length n.effects) > 0) {
            report.note("dropped" n.name "an effect — shadows and blurs are not imported")
        }
    }

    fn paintText:void (target:RaveNode n:SceneNode) {
        app.style(target "font-size" (RaveImport.px(n.text.fontSize)))
        if (n.text.fontWeight != "400") {
            app.style(target "font-weight" n.text.fontWeight)
        }
        if (n.text.lineHeight > 0.0) {
            app.style(target "line-height" (RaveImport.px(n.text.lineHeight)))
        }
        if (n.text.align != "left") {
            app.style(target "text-align" n.text.align)
        }
        def f:SceneFill (n.firstFill())
        if (f.visible && (f.kind == "solid")) {
            app.style(target "color" (f.hexA()))
        }
    }

    ; --- size and space --------------------------------------------------------

    ; A box as wide as the space it is in is written `100%`, not as the
    ; pixels it happened to measure: that one substitution is what makes an
    ; imported screen reflow at all instead of being a photograph.
    fn sizeOf:void (target:RaveNode n:SceneNode availW:double container:boolean) {
        if (RaveImport.same(n.w availW)) {
            app.style(target "width" "100%")
        } {
            app.style(target "width" (RaveImport.px(n.w)))
        }
        if (n.kind == "text") {
            return
        }
        if container {
            app.style(target "min-height" (RaveImport.px(n.h)))
        } {
            app.style(target "height" (RaveImport.px(n.h)))
        }
    }

    fn padTo:void (host:RaveNode top:double right:double bottom:double left:double) {
        if ((((top < 0.5) && (right < 0.5)) && (bottom < 0.5)) && (left < 0.5)) {
            return
        }
        def t:double (RaveImport.maxOf(top 0.0))
        def r:double (RaveImport.maxOf(right 0.0))
        def b:double (RaveImport.maxOf(bottom 0.0))
        def l:double (RaveImport.maxOf(left 0.0))
        app.style(host "padding" ((((RaveImport.px(t)) + " " + (RaveImport.px(r))) + " ") + ((RaveImport.px(b)) + " " + (RaveImport.px(l)))))
    }

    ; --- the container that could not be cut -----------------------------------

    fn absoluteInto:void (host:RaveNode kids:[SceneNode] originX:double originY:double structural:boolean availW:double) {
        report.absolute = (report.absolute + 1)
        app.style(host "position" "relative")
        def i:int 0
        while (i < (array_length kids)) {
            def k:SceneNode (itemAt kids i)
            def child:RaveNode (host.add((this.convert(k "" false availW))))
            app.style(child "position" "absolute")
            app.style(child "left" (RaveImport.px(k.x - originX)))
            app.style(child "top" (RaveImport.px(k.y - originY)))
            i = (i + 1)
        }
    }

    ; --- the cut ---------------------------------------------------------------

    ; Lay `kids` into `host` as flex. `originX/Y` is where the host's content
    ; box sits in the children's own coordinates; `forced` is the axis a band
    ; must be cut along, because a band of a column is a row.
    fn fillContainer:void (host:RaveNode kids:[SceneNode] originX:double originY:double boxW:double boxH:double forced:string structural:boolean) {
        def count:int (array_length kids)
        if (count == 0) {
            return
        }
        if (count == 1) {
            def only:SceneNode (itemAt kids 0)
            this.padTo(host (only.y - originY) ((originX + boxW) - (only.x + only.w)) ((originY + boxH) - (only.y + only.h)) (only.x - originX))
            def inner:double (RaveImport.minOf(only.w boxW))
            host.add((this.convert(only "" structural inner)))
            return
        }

        def ordV:[int] (RaveImport.order(kids false))
        def bandsV:[int] (RaveImport.bandsOf(kids ordV false))
        def cntV:[int] (RaveImport.bandCount(bandsV))
        def ordH:[int] (RaveImport.order(kids true))
        def bandsH:[int] (RaveImport.bandsOf(kids ordH true))
        def cntH:[int] (RaveImport.bandCount(bandsH))
        def canV:boolean ((array_length cntV) >= 2)
        def canH:boolean ((array_length cntH) >= 2)

        def horizontal:boolean false
        def ok:boolean false
        if (forced == "row") {
            if canH {
                horizontal = true
                ok = true
            }
        }
        if (forced == "column") {
            if canV {
                ok = true
            }
        }
        if (ok == false) {
            ; Reading order first: a page is a column of things until the
            ; boxes say otherwise.
            if canV {
                horizontal = false
                ok = true
            } {
                if canH {
                    horizontal = true
                    ok = true
                }
            }
        }
        if (ok == false) {
            this.absoluteInto(host kids originX originY structural boxW)
            return
        }
        report.inferred = (report.inferred + 1)

        def ord:[int] ordV
        def bands:[int] bandsV
        def counts:[int] cntV
        if horizontal {
            ord = ordH
            bands = bandsH
            counts = cntH
        }
        def nb:int (array_length counts)

        ; the bounding box of every band
        def bx0:[double]
        def by0:[double]
        def bx1:[double]
        def by1:[double]
        def b:int 0
        while (b < nb) {
            push bx0 1000000.0
            push by0 1000000.0
            push bx1 (0.0 - 1000000.0)
            push by1 (0.0 - 1000000.0)
            b = (b + 1)
        }
        def p:int 0
        while (p < (array_length ord)) {
            def k:SceneNode (itemAt kids (itemAt ord p))
            def at:int (itemAt bands p)
            set bx0 at (RaveImport.minOf((itemAt bx0 at) k.x))
            set by0 at (RaveImport.minOf((itemAt by0 at) k.y))
            set bx1 at (RaveImport.maxOf((itemAt bx1 at) (k.x + k.w)))
            set by1 at (RaveImport.maxOf((itemAt by1 at) (k.y + k.h)))
            p = (p + 1)
        }

        ; padding is the space the outermost boxes left round themselves
        def crossMin:double 1000000.0
        def crossMax:double (0.0 - 1000000.0)
        def bb:int 0
        while (bb < nb) {
            if horizontal {
                crossMin = (RaveImport.minOf(crossMin (itemAt by0 bb)))
                crossMax = (RaveImport.maxOf(crossMax (itemAt by1 bb)))
            } {
                crossMin = (RaveImport.minOf(crossMin (itemAt bx0 bb)))
                crossMax = (RaveImport.maxOf(crossMax (itemAt bx1 bb)))
            }
            bb = (bb + 1)
        }
        def padTop:double 0.0
        def padRight:double 0.0
        def padBottom:double 0.0
        def padLeft:double 0.0
        if horizontal {
            app.style(host "flex-direction" "row")
            padLeft = ((itemAt bx0 0) - originX)
            padRight = ((originX + boxW) - (itemAt bx1 (nb - 1)))
            padTop = (crossMin - originY)
            padBottom = ((originY + boxH) - crossMax)
        } {
            padTop = ((itemAt by0 0) - originY)
            padBottom = ((originY + boxH) - (itemAt by1 (nb - 1)))
            padLeft = (crossMin - originX)
            padRight = ((originX + boxW) - crossMax)
        }
        this.padTo(host padTop padRight padBottom padLeft)
        def contentW:double ((boxW - padLeft) - padRight)
        def contentH:double ((boxH - padTop) - padBottom)

        ; the gap is the smallest space between two bands; anything more is
        ; that band's own margin, so the drawing is kept exactly
        def gap:double 1000000.0
        def g:int 0
        while (g < (nb - 1)) {
            def space:double 0.0
            if horizontal {
                space = ((itemAt bx0 (g + 1)) - (itemAt bx1 g))
            } {
                space = ((itemAt by0 (g + 1)) - (itemAt by1 g))
            }
            gap = (RaveImport.minOf(gap space))
            g = (g + 1)
        }
        if (gap < 0.0) {
            gap = 0.0
        }
        if (gap > 0.5) {
            app.style(host "gap" (RaveImport.px(gap)))
        }
        app.style(host "align-items" "flex-start")

        ; and now the bands themselves
        def tallest:int 0
        def biggest:double 0.0
        def t:int 0
        while (t < nb) {
            def size:double ((itemAt by1 t) - (itemAt by0 t))
            if horizontal {
                size = ((itemAt bx1 t) - (itemAt bx0 t))
            }
            if (size > biggest) {
                biggest = size
                tallest = t
            }
            t = (t + 1)
        }

        def band:int 0
        while (band < nb) {
            def items:[SceneNode]
            def q:int 0
            while (q < (array_length ord)) {
                if ((itemAt bands q) == band) {
                    push items (itemAt kids (itemAt ord q))
                }
                q = (q + 1)
            }
            def bw:double ((itemAt bx1 band) - (itemAt bx0 band))
            def bh:double ((itemAt by1 band) - (itemAt by0 band))
            def hint:string ""
            if structural {
                if horizontal {
                    if (band == 0) { hint = "left" }
                    if (band == tallest) { hint = "main" }
                } {
                    if (band == 0) { hint = "top" }
                    if (band == (nb - 1)) { hint = "bottom" }
                    if (band == tallest) { hint = "main" }
                }
            }
            def placed:RaveNode (app.newNode("div" "Group"))
            if ((array_length items) == 1) {
                def avail:double contentW
                if horizontal {
                    avail = bw
                }
                placed = (this.convert((itemAt items 0) hint structural avail))
            } {
                report.grouped = (report.grouped + 1)
                def wrapName:string "Row"
                def inner:string "row"
                if horizontal {
                    wrapName = "Column"
                    inner = "column"
                }
                placed = (app.newNode("div" wrapName))
                this.fillContainer(placed items (itemAt bx0 band) (itemAt by0 band) bw bh inner false)
                if horizontal {
                    app.style(placed "width" (RaveImport.px(bw)))
                } {
                    if (RaveImport.same(bw contentW)) {
                        app.style(placed "width" "100%")
                    } {
                        app.style(placed "width" (RaveImport.px(bw)))
                    }
                }
            }
            host.add(placed)

            ; what this band asked for beyond the shared gap
            if (band > 0) {
                def space2:double 0.0
                if horizontal {
                    space2 = ((itemAt bx0 band) - (itemAt bx1 (band - 1)))
                } {
                    space2 = ((itemAt by0 band) - (itemAt by1 (band - 1)))
                }
                def extra:double (space2 - gap)
                if (extra > 0.5) {
                    if horizontal {
                        app.style(placed "margin-left" (RaveImport.px(extra)))
                    } {
                        app.style(placed "margin-top" (RaveImport.px(extra)))
                    }
                }
            }
            ; and where it sits across the axis
            def offset:double 0.0
            if horizontal {
                offset = ((itemAt by0 band) - (originY + padTop))
            } {
                offset = ((itemAt bx0 band) - (originX + padLeft))
            }
            if (offset > 0.5) {
                if horizontal {
                    app.style(placed "margin-top" (RaveImport.px(offset)))
                } {
                    app.style(placed "margin-left" (RaveImport.px(offset)))
                }
            }
            band = (band + 1)
        }
    }

    ; --- a frame that already knows its own layout -----------------------------

    sfn justifyOf:string (s:string) {
        if (s == "center") { return "center" }
        if (s == "end") { return "flex-end" }
        if (s == "space-between") { return "space-between" }
        return "flex-start"
    }

    sfn alignOf:string (s:string) {
        if (s == "center") { return "center" }
        if (s == "end") { return "flex-end" }
        if (s == "stretch") { return "stretch" }
        return "flex-start"
    }

    ; Figma auto-layout IS flex, so it is taken as it stands rather than
    ; guessed at. This is the half of a file that imports exactly.
    fn fromAutoLayout:void (host:RaveNode n:SceneNode kids:[SceneNode] structural:boolean) {
        report.auto = (report.auto + 1)
        def L:SceneLayout n.layout
        def horizontal:boolean (L.mode == "row")
        if horizontal {
            app.style(host "flex-direction" "row")
        }
        if (L.gap > 0.5) {
            app.style(host "gap" (RaveImport.px(L.gap)))
        }
        this.padTo(host L.padT L.padR L.padB L.padL)
        app.style(host "justify-content" (RaveImport.justifyOf(L.justify)))
        app.style(host "align-items" (RaveImport.alignOf(L.alignItems)))
        def contentW:double ((n.w - L.padL) - L.padR)
        def i:int 0
        while (i < (array_length kids)) {
            def k:SceneNode (itemAt kids i)
            def hint:string ""
            if structural {
                if ((i == 0) && (horizontal == false)) { hint = "top" }
                if ((i == ((array_length kids) - 1)) && (horizontal == false)) { hint = "bottom" }
                if ((i == 0) && horizontal) { hint = "left" }
            }
            def avail:double contentW
            if horizontal {
                avail = k.w
            }
            def child:RaveNode (host.add((this.convert(k hint structural avail))))
            if (k.layout.grow > 0.0) {
                app.style(child "flex-grow" (RaveImport.num(k.layout.grow)))
            }
            if k.layout.fillW {
                if (horizontal == false) {
                    app.style(child "width" "100%")
                }
            }
            i = (i + 1)
        }
    }

    ; --- a node ----------------------------------------------------------------

    fn convert:RaveNode (n:SceneNode hint:string structural:boolean availW:double) {
        report.nodes = (report.nodes + 1)
        if (n.kind == "text") {
            def t:RaveNode (app.newText((RaveImport.textTag(n)) n.text.characters))
            t.name = n.name
            this.paintText(t n)
            this.sizeOf(t n availW false)
            return t
        }
        def tag:string (this.guess(n hint structural))
        if ((tag == "button") || (tag == "input")) {
            def one:RaveNode (app.newNode(tag n.name))
            def words:string (RaveImport.textIn(n))
            if (tag == "input") {
                one.placeholder = words
                one.label = n.name
            } {
                one.text = words
                ; A button drawn as an icon has no words. Its layer name is
                ; the only name it has, and a button with no name at all is
                ; the one thing the lint will not forgive.
                if ((strlen words) == 0) {
                    one.label = n.name
                    report.note("guess" n.name "a button with no words — named from the layer")
                }
            }
            def tn:SceneNode (RaveImport.firstText(n))
            if (tn.kind == "text") {
                this.paintText(one tn)
            }
            this.paint(one n)
            this.sizeOf(one n availW true)
            app.style(one "align-items" "center")
            app.style(one "justify-content" "center")
            return one
        }
        def node:RaveNode (app.newNode(tag n.name))
        if (tag == "header") { node.label = n.name }
        if (tag == "footer") { node.label = n.name }
        if (tag == "aside") { node.label = n.name }
        if (tag == "nav") { node.label = n.name }
        if (tag == "main") { node.label = n.name }
        if (tag == "section") { node.label = n.name }
        if (tag == "form") { node.label = n.name }
        if (tag == "img") {
            node.alt = n.name
            node.src = n.imageRef
        }
        this.paint(node n)
        this.sizeOf(node n availW true)
        if (tag == "img") {
            return node
        }
        def kids:[SceneNode] (RaveImport.liveChildren(n))
        if ((array_length kids) == 0) {
            return node
        }
        ; A wrapper that fills the whole screen is scaffolding, not
        ; structure — Figma files are full of them — so the hints go THROUGH
        ; it to the bands that really are the screen's own. Anything smaller
        ; ends the inheritance: the top box inside a card is the top of a
        ; card, not the header of a page.
        def inherit:boolean false
        if structural {
            if ((RaveImport.same(n.w frameW)) && (RaveImport.same(n.h frameH))) {
                inherit = true
            }
        }
        if (n.layout.isFlex()) {
            this.fromAutoLayout(node n kids inherit)
        } {
            this.fillContainer(node kids 0.0 0.0 n.w n.h "" inherit)
        }
        return node
    }

    ; --- the screens -----------------------------------------------------------

    ; A page's frames, which are the screens. Anything on a canvas that is
    ; not a frame is a loose sketch, not an application, and is skipped with
    ; a note rather than dropped in silence.
    fn screensOf:[SceneNode] (doc:SceneDocument) {
        def out:[SceneNode]
        def p:int 0
        while (p < (array_length doc.pages)) {
            def page:SceneNode (itemAt doc.pages p)
            def i:int 0
            while (i < (array_length page.children)) {
                def f:SceneNode (itemAt page.children i)
                if (f.visible && ((f.w > 40.0) && (f.h > 40.0))) {
                    ; A frame comes through as a container; a loose rectangle
                    ; or a stray line on the canvas is a sketch, not a screen.
                    if (f.kind == "container") {
                        push out f
                    } {
                        report.note("dropped" f.name "on the canvas but not a frame, so not a screen")
                    }
                }
                i = (i + 1)
            }
            p = (p + 1)
        }
        return out
    }

    ; The widths the file was drawn at, as the project's targets.
    fn targetsFor:void (frames:[SceneNode]) {
        def web:boolean false
        def desktop:boolean false
        def tablet:boolean false
        def mobile:boolean false
        def i:int 0
        while (i < (array_length frames)) {
            def f:SceneNode (itemAt frames i)
            if (f.w >= 1700.0) { desktop = true }
            if ((f.w >= 1100.0) && (f.w < 1700.0)) { web = true }
            if ((f.w >= 600.0) && (f.w < 1100.0)) { tablet = true }
            if (f.w < 600.0) { mobile = true }
            i = (i + 1)
        }
        if desktop { push app.targets "desktop" }
        if web { push app.targets "web" }
        if tablet { push app.targets "tablet" }
        if mobile { push app.targets "mobile" }
        if ((array_length app.targets) == 0) {
            push app.targets "web"
        }
    }

    ; --- the shared furniture --------------------------------------------------

    ; Figma files are full of a frame holding one box the same size as
    ; itself, holding another. None of those is structure, and comparing
    ; screens at that level answers "they all have a Container" — which is
    ; true and useless. This walks down to the first box that actually holds
    ; more than one thing.
    sfn bodyOf:SceneNode (f:SceneNode) {
        def at:SceneNode f
        def guard:int 0
        while (guard < 6) {
            def kids:[SceneNode] (RaveImport.liveChildren(at))
            if ((array_length kids) != 1) {
                return at
            }
            def only:SceneNode (itemAt kids 0)
            if (((RaveImport.same(only.w at.w)) && (RaveImport.same(only.h at.h))) && (only.kind == "container")) {
                at = only
            } {
                return at
            }
            guard = (guard + 1)
        }
        return at
    }

    ; A child every screen agrees about is the same thing drawn on each of
    ; them. "The same" is the name, the width, the height and the left edge —
    ; and EITHER the same distance from the top OR the same distance from the
    ; bottom, because a tab bar is at the bottom of screens that are not the
    ; same height and is still the same tab bar.
    sfn agreesAcross:boolean (frames:[SceneNode] want:SceneNode fromBottom:double) {
        def i:int 0
        while (i < (array_length frames)) {
            def body:SceneNode (RaveImport.bodyOf((itemAt frames i)))
            def found:boolean false
            def j:int 0
            while (j < (array_length body.children)) {
                def c:SceneNode (itemAt body.children j)
                if (c.name == want.name) {
                    def sized:boolean (((RaveImport.same(c.w want.w)) && (RaveImport.same(c.h want.h))) && (RaveImport.same(c.x want.x)))
                    if sized {
                        def gap:double (body.h - (c.y + c.h))
                        if ((RaveImport.same(c.y want.y)) || (RaveImport.same(gap fromBottom))) {
                            found = true
                        }
                    }
                }
                j = (j + 1)
            }
            if (found == false) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; Which of the first screen's children are furniture. Answers an empty
    ; list when there is one screen, or when every child agrees — a set of
    ; screens that are identical is one screen, not a layout.
    fn sharedNames:[string] (frames:[SceneNode]) {
        def out:[string]
        if ((array_length frames) < 2) {
            return out
        }
        def first:SceneNode (RaveImport.bodyOf((itemAt frames 0)))
        def kids:[SceneNode] (RaveImport.liveChildren(first))
        def i:int 0
        while (i < (array_length kids)) {
            def c:SceneNode (itemAt kids i)
            if (RaveImport.agreesAcross(frames c (first.h - (c.y + c.h)))) {
                push out c.name
            }
            i = (i + 1)
        }
        if ((array_length out) == (array_length kids)) {
            clear out
        }
        return out
    }

    sfn isNamed:boolean (names:[string] name:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; --- the document ----------------------------------------------------------

    fn pathFor:string (name:string first:boolean) {
        if first {
            return "/"
        }
        def s:string (RaveImport.slug(name))
        if ((strlen s) == 0) {
            return ("/screen-" + (to_string (array_length app.routes)))
        }
        def want:string ("/" + s)
        if ((app.hasRoute(want)) == false) {
            return want
        }
        return (want + "-" + (to_string (array_length app.routes)))
    }

    ; The frame's own ground and size, on whatever node stands for the
    ; screen — the page, or the layout when there is one.
    fn dressScreen:void (target:RaveNode f:SceneNode) {
        this.paint(target f)
        app.style(target "width" "100%")
        app.style(target "min-height" "100%")
        app.style(target "max-width" (RaveImport.px(f.w)))
    }

    ; One Figma document, as an application.
    fn run:RaveApp (doc:SceneDocument) {
        def title:string doc.name
        if ((strlen title) == 0) {
            title = "Imported"
        }
        app = (new RaveApp(title))
        report = (new RaveImportReport())
        RavePatterns.breakpoints(app)
        RavePatterns.theme(app)

        def frames:[SceneNode] (this.screensOf(doc))
        this.targetsFor(frames)
        if ((array_length frames) == 0) {
            report.note("dropped" title "no frames on any page — nothing to import")
            def home:RaveNode (app.newPage("Home"))
            app.addRoute("/" "Home" home 0)
            return app
        }

        def shared:[string] (this.sharedNames(frames))
        def layoutId:int 0
        if ((array_length shared) > 0) {
            def first:SceneNode (itemAt frames 0)
            def body0:SceneNode (RaveImport.bodyOf(first))
            frameW = first.w
            frameH = first.h
            def lay:RaveNode (app.newLayout("Shell"))
            this.dressScreen(lay first)
            if (body0.id != first.id) {
                ; the scaffolding's own ground and flex, folded into the one
                ; node that replaces the whole chain
                this.paint(lay body0)
            }
            def furniture:[SceneNode]
            def kids0:[SceneNode] (RaveImport.liveChildren(body0))
            ; The space the screens differ over, as a box of its own: put it
            ; in with the furniture and the cut works out the gaps and the
            ; padding with the content area already in place, which is what
            ; makes the slot land between the header and the tab bar rather
            ; than after both of them.
            def sx0:double 1000000.0
            def sy0:double 1000000.0
            def sx1:double (0.0 - 1000000.0)
            def sy1:double (0.0 - 1000000.0)
            def own:int 0
            def i:int 0
            while (i < (array_length kids0)) {
                def c:SceneNode (itemAt kids0 i)
                if (RaveImport.isNamed(shared c.name)) {
                    push furniture c
                } {
                    own = (own + 1)
                    sx0 = (RaveImport.minOf(sx0 c.x))
                    sy0 = (RaveImport.minOf(sy0 c.y))
                    sx1 = (RaveImport.maxOf(sx1 (c.x + c.w)))
                    sy1 = (RaveImport.maxOf(sy1 (c.y + c.h)))
                }
                i = (i + 1)
            }
            def marker:SceneNode (new SceneNode())
            if (own > 0) {
                marker.id = "rave:content"
                marker.name = "Content"
                marker.kind = "container"
                marker.x = sx0
                marker.y = sy0
                marker.w = (sx1 - sx0)
                marker.h = (sy1 - sy0)
                marker.visible = true
                push furniture marker
            }
            if (body0.layout.isFlex()) {
                this.fromAutoLayout(lay body0 furniture true)
            } {
                this.fillContainer(lay furniture 0.0 0.0 body0.w body0.h "" true)
            }
            ; and the box that stood for the content becomes the slot itself,
            ; keeping every rule the cut wrote for it
            def s:int 0
            while (s < (array_length lay.children)) {
                def child:RaveNode (itemAt lay.children s)
                if (child.name == "Content") {
                    child.kind = "slot"
                    app.style(child "flex-grow" "1")
                    app.style(child "min-height" "0")
                }
                s = (s + 1)
            }
            layoutId = lay.id
            def word:string " child is"
            if ((array_length shared) != 1) {
                word = " children are"
            }
            report.note("layout" "Shell" ((to_string (array_length shared)) + word + " in the same place on every screen — lifted into a layout, with a slot where the screens differ"))
        }

        def n:int 0
        while (n < (array_length frames)) {
            def f:SceneNode (itemAt frames n)
            frameW = f.w
            frameH = f.h
            report.frames = (report.frames + 1)
            def page:RaveNode (app.newPage(f.name))
            def kids:[SceneNode] (RaveImport.liveChildren(f))
            if (layoutId > 0) {
                def bodyN:SceneNode (RaveImport.bodyOf(f))
                kids = (RaveImport.liveChildren(bodyN))
                ; only the part that is this screen's own
                def own:[SceneNode]
                def k:int 0
                while (k < (array_length kids)) {
                    def c:SceneNode (itemAt kids k)
                    if ((RaveImport.isNamed(shared c.name)) == false) {
                        push own c
                    }
                    k = (k + 1)
                }
                app.style(page "width" "100%")
                app.style(page "min-width" "0")
                this.fillContainer(page own 0.0 0.0 f.w f.h "" true)
            } {
                this.dressScreen(page f)
                if (f.layout.isFlex()) {
                    this.fromAutoLayout(page f kids true)
                } {
                    this.fillContainer(page kids 0.0 0.0 f.w f.h "" true)
                }
            }
            def path:string (this.pathFor(f.name (n == 0)))
            app.addRoute(path f.name page layoutId)
            n = (n + 1)
        }
        return app
    }

    sfn fromScene:RaveApp (doc:SceneDocument) {
        def imp (new RaveImport())
        return (imp.run(doc))
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RaveText — the document as markup a person, or a model, can write
; =============================================================================
; `app.rave.json` is what the editor saves: every node with its id, every rule
; as an object. It is a poor thing to hand a language model and a worse thing
; to ask one to produce — most of its bytes are ids nobody typed, and one wrong
; id makes a document that opens as something else.
;
; So the exchange format is markup, and it is shaped like HTML on purpose:
;
;   <page name="Dashboard" style="gap: 24px">
;     <h1 class="title">Dashboard</h1>
;     <div name="Cards" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px">
;       <media below="md" style="grid-template-columns: 1fr"/>
;       <section class="card" label="Revenue">
;         <h3 class="subtitle">Revenue</h3>
;         <p class="muted">Where the money came from this month.</p>
;       </section>
;     </div>
;     <button class="btn">Go to settings<on click="navigate" arg="/settings"/></button>
;   </page>
;
; THE FIRST VERSION OF THIS WAS INDENTATION-BASED and it was wrong for one
; reason: an answer copied through a chat window comes back with its leading
; spaces gone, and a format whose tree IS its indentation then has no tree at
; all — two hundred error lines and nothing to do about them. Closing tags say
; what is inside what no matter what happens to the whitespace. The parser
; ignores indentation entirely; the writer still emits it, to be read.
;
; There are no ids anywhere in it, so a document written out, read back and
; written again is the same text — which is both the round-trip test and the
; reason something that has never seen this codebase can edit one.
; =============================================================================

Import "RaveDoc.rgr"
Import "../../evg/EVGStyleSheet.rgr"

class RaveTextError {
    def line:int 0
    def text:string ""
    def why:string ""

    Constructor (l:int t:string w:string) {
        line = l
        text = t
        why = w
    }

    fn message:string () {
        def what:string text
        if ((strlen what) > 60) {
            what = ((substring what 0 59) + "…")
        }
        if ((strlen what) == 0) {
            return ("line " + (to_string line) + ": " + why)
        }
        return ("line " + (to_string line) + ": " + why + " — " + what)
    }
}

class RaveText {

    ; --- writing ---------------------------------------------------------------

    sfn esc:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (c == 38) {
                out = (out + "&amp;")
            } {
                if (c == 60) {
                    out = (out + "&lt;")
                } {
                    if (c == 62) {
                        out = (out + "&gt;")
                    } {
                        if (c == 34) {
                            out = (out + "&quot;")
                        } {
                            if (c == 10) {
                                out = (out + " ")
                            } {
                                out = (out + (strfromcode c))
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn attr:string (key:string value:string) {
        if ((strlen value) == 0) {
            return ""
        }
        return (" " + key + "=\"" + (RaveText.esc(value)) + "\"")
    }

    sfn pad:string (depth:int) {
        def out:string ""
        def i:int 0
        while (i < depth) {
            out = (out + "  ")
            i = (i + 1)
        }
        return out
    }

    ; A class rule that belongs to one node — `.n12` — rather than a shared one.
    sfn isNodeClass:boolean (cls:string) {
        return ((RaveApp.idOfElement(cls)) > 0)
    }

    sfn declsText:string (r:RaveRule) {
        def out:string ""
        def i:int 0
        while (i < (array_length r.decls)) {
            def d:RaveDecl (itemAt r.decls i)
            if (i > 0) {
                out = (out + "; ")
            }
            out = (out + d.name + ": " + d.value)
            i = (i + 1)
        }
        return out
    }

    ; A media query as the attributes that say it: `below="md"`, `from="md"`,
    ; or the query itself when it is neither.
    sfn mediaAttrs:string (app:RaveApp media:string) {
        def i:int 0
        while (i < (array_length app.breakpoints)) {
            def b:RaveBreakpoint (itemAt app.breakpoints i)
            if ((app.from(b.name)) == media) {
                return (RaveText.attr("from" b.name))
            }
            if ((app.below(b.name)) == media) {
                return (RaveText.attr("below" b.name))
            }
            i = (i + 1)
        }
        return (RaveText.attr("query" media))
    }

    sfn classText:string (n:RaveNode) {
        def out:string ""
        def i:int 0
        while (i < (array_length n.classes)) {
            if (i > 0) {
                out = (out + " ")
            }
            out = (out + (itemAt n.classes i))
            i = (i + 1)
        }
        return out
    }

    sfn tagOf:string (n:RaveNode) {
        if (n.kind == "slot") {
            return "slot"
        }
        if (n.kind == "toast") {
            return "toast"
        }
        return n.tag
    }

    ; Everything about a node except what is inside it.
    sfn nodeAttrs:string (app:RaveApp n:RaveNode) {
        def out:string (RaveText.attr("class" (RaveText.classText(n))))
        if ((n.name != n.text) && (n.name != n.tag)) {
            out = (out + (RaveText.attr("name" n.name)))
        }
        out = (out + (RaveText.attr("label" n.label)))
        out = (out + (RaveText.attr("placeholder" n.placeholder)))
        out = (out + (RaveText.attr("alt" n.alt)))
        out = (out + (RaveText.attr("src" n.src)))
        out = (out + (RaveText.attr("role" n.role)))
        out = (out + (RaveText.attr("state" n.state)))
        out = (out + (RaveText.attr("bind" n.bind)))
        out = (out + (RaveText.attr("repeat" n.repeat)))
        out = (out + (RaveText.attr("source" n.source)))
        out = (out + (RaveText.attr("sourceKey" n.sourceKey)))
        out = (out + (RaveText.attr("overlay" n.overlay)))
        out = (out + (RaveText.attr("component" n.component)))
        out = (out + (RaveText.attr("variant" n.variant)))
        if (n.kind == "conditional") {
            out = (out + (RaveText.attr("when" n.condition)))
        }
        def cls:string (n.cls())
        if (app.hasRule(cls "")) {
            def r:RaveRule (app.rule(cls ""))
            if ((array_length r.decls) > 0) {
                out = (out + (RaveText.attr("style" (RaveText.declsText(r)))))
            }
        }
        return out
    }

    ; The `<media/>` lines for one node or page: the same class at other widths.
    sfn mediaChildren:string (app:RaveApp n:RaveNode depth:int) {
        def out:string ""
        def cls:string (n.cls())
        def i:int 0
        while (i < (array_length app.styles)) {
            def r:RaveRule (itemAt app.styles i)
            if ((r.cls == cls) && ((strlen r.media) > 0)) {
                if ((array_length r.decls) > 0) {
                    out = (out + (RaveText.pad(depth)) + "<media" + (RaveText.mediaAttrs(app r.media))
                        + (RaveText.attr("style" (RaveText.declsText(r)))) + "/>\n")
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn actionChildren:string (n:RaveNode depth:int) {
        def out:string ""
        def i:int 0
        while (i < (array_length n.actions)) {
            def a:RaveAction (itemAt n.actions i)
            out = (out + (RaveText.pad(depth)) + "<on" + (RaveText.attr(a.on a.kind))
                + (RaveText.attr("arg" a.arg)) + "/>\n")
            i = (i + 1)
        }
        return out
    }

    sfn nodeXml:string (app:RaveApp n:RaveNode depth:int) {
        def tag:string (RaveText.tagOf(n))
        def head:string ((RaveText.pad(depth)) + "<" + tag + (RaveText.nodeAttrs(app n)))
        def inner:string ((RaveText.mediaChildren(app n (depth + 1))) + (RaveText.actionChildren(n (depth + 1))))
        def kids:string ""
        def i:int 0
        while (i < (array_length n.children)) {
            kids = (kids + (RaveText.nodeXml(app (itemAt n.children i) (depth + 1))))
            i = (i + 1)
        }
        def words:string (RaveText.esc(n.text))
        if (((strlen inner) == 0) && ((strlen kids) == 0)) {
            if ((strlen words) == 0) {
                return (head + "/>\n")
            }
            return (head + ">" + words + "</" + tag + ">\n")
        }
        return (head + ">" + words + "\n" + inner + kids + (RaveText.pad(depth)) + "</" + tag + ">\n")
    }

    ; One subtree on its own, for handing a model a single node to rework.
    sfn writeNode:string (app:RaveApp n:RaveNode) {
        return (RaveText.nodeXml(app n 0))
    }

    sfn writeChildren:string (app:RaveApp n:RaveNode depth:int) {
        def out:string ""
        def i:int 0
        while (i < (array_length n.children)) {
            out = (out + (RaveText.nodeXml(app (itemAt n.children i) depth)))
            i = (i + 1)
        }
        return out
    }

    ; A page as its own block, the way the AI menu asks for one back.
    sfn writePage:string (app:RaveApp page:RaveNode) {
        def out:string ("<page" + (RaveText.attr("name" page.name)) + (RaveText.rootAttrs(app page)) + ">\n")
        out = (out + (RaveText.mediaChildren(app page 1)))
        out = (out + (RaveText.writeChildren(app page 1)))
        return (out + "</page>\n")
    }

    ; What a page or a layout carries beyond its name: its own rule, and the
    ; few node attributes a page root may have.
    sfn rootAttrs:string (app:RaveApp n:RaveNode) {
        def out:string (RaveText.attr("class" (RaveText.classText(n))))
        out = (out + (RaveText.attr("source" n.source)))
        out = (out + (RaveText.attr("sourceKey" n.sourceKey)))
        out = (out + (RaveText.attr("repeat" n.repeat)))
        def cls:string (n.cls())
        if (app.hasRule(cls "")) {
            def r:RaveRule (app.rule(cls ""))
            if ((array_length r.decls) > 0) {
                out = (out + (RaveText.attr("style" (RaveText.declsText(r)))))
            }
        }
        return out
    }

    sfn writeApp:string (app:RaveApp) {
        def out:string ("<app" + (RaveText.attr("name" app.name)))
        if ((array_length app.targets) > 0) {
            def t:string ""
            def ti:int 0
            while (ti < (array_length app.targets)) {
                if (ti > 0) {
                    t = (t + " ")
                }
                t = (t + (itemAt app.targets ti))
                ti = (ti + 1)
            }
            out = (out + (RaveText.attr("targets" t)))
        }
        out = (out + (RaveText.attr("nav" app.nav)))
        if app.authEnabled {
            out = (out + " auth=\"on\"" + (RaveText.attr("login" app.loginRoute)) + (RaveText.attr("after" app.afterLogin)))
        }
        out = (out + "/>\n")
        def b:int 0
        while (b < (array_length app.breakpoints)) {
            def bp:RaveBreakpoint (itemAt app.breakpoints b)
            out = (out + "<breakpoint" + (RaveText.attr("name" bp.name)) + (RaveText.attr("min" (to_string bp.minWidth))) + "/>\n")
            b = (b + 1)
        }
        def v:int 0
        while (v < (array_length app.vars)) {
            def vr:RaveVar (itemAt app.vars v)
            out = (out + "<var" + (RaveText.attr("name" vr.name)) + (RaveText.attr("value" vr.value)) + "/>\n")
            v = (v + 1)
        }
        def s:int 0
        while (s < (array_length app.styles)) {
            def r:RaveRule (itemAt app.styles s)
            if ((RaveText.isNodeClass(r.cls)) == false) {
                if ((array_length r.decls) > 0) {
                    def head:string ("<style" + (RaveText.attr("class" r.cls)))
                    if ((strlen r.media) > 0) {
                        head = (head + (RaveText.mediaAttrs(app r.media)))
                    }
                    out = (out + head + ">" + (RaveText.esc((RaveText.declsText(r)))) + "</style>\n")
                }
            }
            s = (s + 1)
        }
        def d:int 0
        while (d < (array_length app.data)) {
            def coll:RaveCollection (itemAt app.data d)
            def fields:string ""
            def f:int 0
            while (f < (array_length coll.fields)) {
                def fld:RaveField (itemAt coll.fields f)
                if (f > 0) {
                    fields = (fields + " ")
                }
                fields = (fields + fld.name)
                f = (f + 1)
            }
            out = (out + "<collection" + (RaveText.attr("name" coll.name)) + (RaveText.attr("fields" fields)) + ">\n")
            def rw:int 0
            while (rw < (array_length coll.rows)) {
                def row:RaveRow (itemAt coll.rows rw)
                def line:string "  <row"
                def k:int 0
                while (k < (array_length row.keys)) {
                    line = (line + (RaveText.attr((itemAt row.keys k) (itemAt row.values k))))
                    k = (k + 1)
                }
                out = (out + line + "/>\n")
                rw = (rw + 1)
            }
            out = (out + "</collection>\n")
            d = (d + 1)
        }
        def l:int 0
        while (l < (array_length app.layouts)) {
            def lay:RaveNode (itemAt app.layouts l)
            def head2:string ("\n<layout" + (RaveText.attr("name" lay.name)))
            if (lay.parentLayout > 0) {
                if (app.hasNode(lay.parentLayout)) {
                    def par:RaveNode (app.node(lay.parentLayout))
                    head2 = (head2 + (RaveText.attr("inside" par.name)))
                }
            }
            out = (out + head2 + (RaveText.rootAttrs(app lay)) + ">\n")
            out = (out + (RaveText.mediaChildren(app lay 1)))
            out = (out + (RaveText.writeChildren(app lay 1)))
            out = (out + "</layout>\n")
            l = (l + 1)
        }
        def p:int 0
        while (p < (array_length app.pages)) {
            def pg:RaveNode (itemAt app.pages p)
            out = (out + "\n" + (RaveText.writePage(app pg)))
            p = (p + 1)
        }
        out = (out + "\n")
        def rt:int 0
        while (rt < (array_length app.routes)) {
            def route:RaveRoute (itemAt app.routes rt)
            def line2:string ("<route" + (RaveText.attr("path" route.path)) + (RaveText.attr("title" route.title)))
            if (app.hasNode(route.pageId)) {
                def pgn:RaveNode (app.node(route.pageId))
                line2 = (line2 + (RaveText.attr("page" pgn.name)))
            }
            if (route.layoutId > 0) {
                if (app.hasNode(route.layoutId)) {
                    def lgn:RaveNode (app.node(route.layoutId))
                    line2 = (line2 + (RaveText.attr("layout" lgn.name)))
                }
            }
            if route.protected {
                line2 = (line2 + " protected=\"yes\"")
            }
            out = (out + line2 + "/>\n")
            rt = (rt + 1)
        }
        return out
    }
    sfn copyRules:void (src:RaveApp dst:RaveApp fromCls:string toCls:string) {
        def i:int 0
        while (i < (array_length src.styles)) {
            def r:RaveRule (itemAt src.styles i)
            if (r.cls == fromCls) {
                def into:RaveRule (dst.rule(toCls r.media))
                def d:int 0
                while (d < (array_length r.decls)) {
                    def decl:RaveDecl (itemAt r.decls d)
                    into.set(decl.name decl.value)
                    d = (d + 1)
                }
            }
            i = (i + 1)
        }
    }

    sfn copyNode:RaveNode (src:RaveApp dst:RaveApp n:RaveNode) {
        def made:RaveNode (dst.newNode(n.tag n.name))
        made.kind = n.kind
        made.text = n.text
        made.src = n.src
        made.alt = n.alt
        made.label = n.label
        made.placeholder = n.placeholder
        made.condition = n.condition
        made.component = n.component
        made.variant = n.variant
        made.repeat = n.repeat
        made.source = n.source
        made.sourceKey = n.sourceKey
        made.overlay = n.overlay
        made.bind = n.bind
        made.role = n.role
        made.state = n.state
        def c:int 0
        while (c < (array_length n.classes)) {
            made.addClass((itemAt n.classes c))
            c = (c + 1)
        }
        def a:int 0
        while (a < (array_length n.actions)) {
            def act:RaveAction (itemAt n.actions a)
            made.on(act.kind act.arg)
            a = (a + 1)
        }
        RaveText.copyRules(src dst (n.cls()) (made.cls()))
        def k:int 0
        while (k < (array_length n.children)) {
            made.add((RaveText.copyNode(src dst (itemAt n.children k))))
            k = (k + 1)
        }
        return made
    }

    ; The shared classes, tokens and collections a fragment brought with it.
    sfn mergeShared:void (src:RaveApp dst:RaveApp) {
        def i:int 0
        while (i < (array_length src.styles)) {
            def r:RaveRule (itemAt src.styles i)
            if ((RaveText.isNodeClass(r.cls)) == false) {
                def into:RaveRule (dst.rule(r.cls r.media))
                def d:int 0
                while (d < (array_length r.decls)) {
                    def decl:RaveDecl (itemAt r.decls d)
                    into.set(decl.name decl.value)
                    d = (d + 1)
                }
            }
            i = (i + 1)
        }
        def v:int 0
        while (v < (array_length src.vars)) {
            def vr:RaveVar (itemAt src.vars v)
            dst.setVar(vr.name vr.value)
            v = (v + 1)
        }
        def c:int 0
        while (c < (array_length src.data)) {
            def coll:RaveCollection (itemAt src.data c)
            if ((dst.hasCollection(coll.name)) == false) {
                def into2:RaveCollection (dst.addCollection(coll.name))
                def f:int 0
                while (f < (array_length coll.fields)) {
                    def fld:RaveField (itemAt coll.fields f)
                    into2.addField(fld.name fld.label)
                    f = (f + 1)
                }
                def rw:int 0
                while (rw < (array_length coll.rows)) {
                    def row:RaveRow (itemAt coll.rows rw)
                    push into2.rows (row.copy())
                    rw = (rw + 1)
                }
                into2.nextKey = coll.nextKey
            }
            c = (c + 1)
        }
    }

    ; --- the format, described ------------------------------------------------
    ; What goes into the prompt beside the document. It is written here rather
    ; than kept in a file the editor would have to load, because a prompt that
    ; does not match the parser is worse than no prompt: what the model is told
    ; and what the reader accepts have to be the same text.

    sfn spec:string () {
        def s:string "RAVE MARKUP\n"
        s = (s + "===========\n\n")
        s = (s + "A Rave document is an application — routes, layouts, pages, and a\n")
        s = (s + "stylesheet with real breakpoints — written as HTML-shaped markup.\n")
        s = (s + "Closing tags say what is inside what, so whitespace does not matter.\n")
        s = (s + "There are no ids: the reader makes them.\n\n")

        s = (s + "THE DOCUMENT\n")
        s = (s + "  <app name=\"Acme\" targets=\"web tablet mobile\" nav=\"sidebar\"\n")
        s = (s + "       auth=\"on\" login=\"/login\" after=\"/dashboard\"/>\n")
        s = (s + "  <breakpoint name=\"md\" min=\"768\"/>          a name and the width it starts at\n")
        s = (s + "  <var name=\"ink\" value=\"#09090b\"/>          a token, used as var(--ink)\n")
        s = (s + "  <style class=\"btn\">height: 36px; color: var(--ink)</style>\n")
        s = (s + "  <style class=\"btn\" from=\"md\">height: 40px</style>\n")
        s = (s + "  <collection name=\"items\" fields=\"id title status\">\n")
        s = (s + "    <row id=\"1\" title=\"First\" status=\"Draft\"/>\n")
        s = (s + "  </collection>\n")
        s = (s + "  <layout name=\"Shell\" style=\"…\"> … </layout>      `inside=\"Other\"` nests one\n")
        s = (s + "  <page name=\"Dashboard\" style=\"…\"> … </page>\n")
        s = (s + "  <route path=\"/dashboard\" title=\"Dashboard\" page=\"Dashboard\"\n")
        s = (s + "         layout=\"Shell\" protected=\"yes\"/>\n\n")

        s = (s + "THE ELEMENTS ON A PAGE\n")
        s = (s + "  div span p h1 h2 h3 h4 header footer nav main aside section\n")
        s = (s + "  form label input button a img ul li slot toast\n\n")
        s = (s + "  Words are the element's content: <h1 class=\"title\">Dashboard</h1>\n")
        s = (s + "  A <slot/> is where a route's page goes inside its layout. Every\n")
        s = (s + "  layout needs exactly one.\n\n")

        s = (s + "THE ATTRIBUTES ANY ELEMENT MAY HAVE\n")
        s = (s + "  class=\"a b\"         shared classes, defined by <style class=\"a\">\n")
        s = (s + "  style=\"…\"           this element's own rule — CSS declarations\n")
        s = (s + "  name=\"…\"            what it is called in the Layers pane\n")
        s = (s + "  label=\"…\"           its accessible name, when the words do not give one\n")
        s = (s + "  placeholder=\"…\"     an input's grey text\n")
        s = (s + "  alt=\"…\" src=\"…\"     an image's\n")
        s = (s + "  role=\"…\" state=\"…\"  an ARIA role the tag does not imply, and\n")
        s = (s + "                      checked|unchecked|selected|unselected|expanded|collapsed\n")
        s = (s + "  when=\"authenticated\"|\"unauthenticated\"   on the page only when the\n")
        s = (s + "                      session is\n")
        s = (s + "  repeat=\"items\"      its children are drawn once per row of that\n")
        s = (s + "                      collection; {field} in any text under it is that row's\n")
        s = (s + "  source=\"items\" sourceKey=\"id\"   the subtree is about the one row the\n")
        s = (s + "                      route's :id names — use with <route path=\"/items/:id\">\n")
        s = (s + "  bind=\"title\"        an input writes that field when `create` runs\n")
        s = (s + "  overlay=\"create\"    a dialog: on the page only while it is open, and a\n")
        s = (s + "                      modal while it is. Open it with <on click=\"open\" arg=\"create\"/>\n\n")

        s = (s + "TWO CHILDREN THAT ARE NOT ELEMENTS ON THE PAGE\n")
        s = (s + "  <media below=\"md\" style=\"…\"/>     this element's rule below a breakpoint\n")
        s = (s + "  <media from=\"md\" style=\"…\"/>      …and at it and above\n")
        s = (s + "  <media query=\"(min-width: 768px) and (max-width: 1023px)\" style=\"…\"/>\n")
        s = (s + "  <on click=\"navigate\" arg=\"/settings\"/>\n")
        s = (s + "      click=\"login|logout|back|open|close|create|remove|toast\"\n")
        s = (s + "      e.g. <on click=\"toast\" arg=\"Item created\"/>, <on click=\"remove\" arg=\"items/{id}\"/>\n\n")

        s = (s + "THE CSS THE ENGINE UNDERSTANDS — anything else is dropped, loudly\n")
        s = (s + "  display flex grid block · flex-direction row column · flex-wrap\n")
        s = (s + "  justify-content align-items align-self flex-grow flex-shrink flex-basis\n")
        s = (s + "  gap row-gap column-gap\n")
        s = (s + "  grid-template-columns grid-template-rows grid-template-areas grid-area\n")
        s = (s + "    grid-column grid-row grid-auto-flow   (px, fr, %, repeat(N, …), minmax)\n")
        s = (s + "  width height min-width max-width min-height max-height\n")
        s = (s + "  padding margin (and their -top/-right/-bottom/-left)\n")
        s = (s + "  position relative absolute fixed · left top right bottom · z-index\n")
        s = (s + "  overflow visible hidden scroll\n")
        s = (s + "  background-color color opacity cursor\n")
        s = (s + "  border (one shorthand: `1px solid #e4e4e7`) · border-radius\n")
        s = (s + "  font-size font-weight font-family line-height letter-spacing text-align\n")
        s = (s + "  Units: px % vw vh em rem, and fit-content. var(--token) anywhere.\n\n")
        s = (s + "  NOT UNDERSTOOD, so do not write them: calc(), aspect-ratio, min-content,\n")
        s = (s + "  max-content, repeat(auto-fit|auto-fill, …), box-shadow, text-shadow,\n")
        s = (s + "  transition, transform, filter, float, the per-side border shorthands\n")
        s = (s + "  (border-top and friends — only `border`), reversed flex directions,\n")
        s = (s + "  and every selector other than a class.\n\n")

        s = (s + "ACCESSIBILITY IS CHECKED, so\n")
        s = (s + "  every input has a label, every img an alt, every button words or a\n")
        s = (s + "  label, headings go down one level at a time, and text reaches 4.5:1\n")
        s = (s + "  against what it sits on.\n")
        return s
    }

    sfn scopeWord:string (scope:string) {
        if (scope == "page") {
            return "page"
        }
        if (scope == "node") {
            return "node"
        }
        return "document"
    }

    sfn prompt:string (app:RaveApp scope:string body:string ask:string) {
        def word:string (RaveText.scopeWord(scope))
        def out:string "You are editing one Rave application document.\n"
        out = (out + "Rave is a visual editor whose documents ARE applications: routes,\n")
        out = (out + "layouts, pages and a stylesheet with real breakpoints, drawn by an\n")
        out = (out + "engine that is strict about what CSS it understands. Read the format\n")
        out = (out + "below, then do what is asked at the end.\n\n")
        out = (out + "--------------------------------------------------------------------\n")
        out = (out + (RaveText.spec()))
        out = (out + "\n--------------------------------------------------------------------\n")
        out = (out + "THE " + (RaveText.lowerWord(word)) + " AS IT STANDS\n")
        out = (out + "--------------------------------------------------------------------\n\n")
        out = (out + body)
        out = (out + "\n--------------------------------------------------------------------\n")
        out = (out + "WHAT I WANT\n")
        out = (out + "--------------------------------------------------------------------\n\n")
        if ((strlen (trim ask)) == 0) {
            out = (out + "(say here what should change)\n")
        } {
            out = (out + (trim ask) + "\n")
        }
        out = (out + "\n--------------------------------------------------------------------\n")
        out = (out + "ANSWER WITH\n")
        out = (out + "--------------------------------------------------------------------\n\n")
        if (word == "document") {
            out = (out + "The WHOLE document in the markup above, from <app/> to the last\n")
            out = (out + "<route/>. Keep the pages, layouts and routes that are there unless I\n")
            out = (out + "asked you to change them.\n")
        }
        if (word == "page") {
            out = (out + "The WHOLE <page>…</page>, with its name attribute unchanged. New\n")
            out = (out + "shared classes and tokens may come with it as <style class=\"…\">…</style>\n")
            out = (out + "and <var …/> before it. Do not write routes, layouts or other pages.\n")
        }
        if (word == "node") {
            out = (out + "The WHOLE element, its own tag outermost. New shared classes and\n")
            out = (out + "tokens may come with it as <style class=\"…\">…</style> and <var …/>\n")
            out = (out + "before it. Nothing else.\n")
        }
        out = (out + "\nNo prose, no explanation, no code fences — the answer is pasted\n")
        out = (out + "straight back into the editor, and anything that is not the markup is\n")
        out = (out + "an error with the line it was on.\n")
        return out
    }

    sfn lowerWord:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if ((c >= 97) && (c <= 122)) {
                c = (c - 32)
            }
            out = (out + (strfromcode c))
            i = (i + 1)
        }
        return out
    }
}

; =============================================================================
; RaveTextReader — the same markup, backwards
; =============================================================================
; A scanner rather than a parser: find a `<`, read the tag and its attributes,
; and everything between tags is words. Indentation is not read at all, and a
; close tag that does not match what is open closes what it can and says so,
; because an answer from somewhere else is exactly the case where "it did not
; work" is not a useful thing to be told.
; =============================================================================

class RaveTextReader {
    def app:RaveApp (new RaveApp(""))
    def errors:[RaveTextError]
    def sheet:EVGStyleSheet (new EVGStyleSheet())
    def src:string ""
    def pos:int 0
    def lineNo:int 1
    ; errors past the few that are kept
    def more:int 0
    ; the elements that are open, innermost last
    def openTags:[string]
    def openIds:[int]
    ; the page or layout being filled, and the fragment's throwaway page
    def rootId:int 0
    def holderId:int 0
    def fragment:boolean false
    ; layouts that named a parent, and pages and layouts by name
    def pendingChild:[string]
    def pendingParent:[string]
    def names:[string]
    def ids:[int]
    def routeTexts:[string]
    def routeLines:[int]
    ; What the answer turned out to be, which is not always what was asked
    ; for: a whole document pasted while the menu is on one page, or one page
    ; pasted while it is on the document. Both are worth saying plainly
    ; instead of reporting as ten missing routes.
    def sawRoute:boolean false
    def sawLayout:boolean false
    def pageCount:int 0
    ; the attributes of the tag just read
    def attrKeys:[string]
    def attrVals:[string]
    def tagName:string ""
    def selfClosing:boolean false
    ; the breakpoints of the document a fragment is going into
    def seedNames:[string]
    def seedMins:[int]

    Constructor () {
    }

    ; --- what went wrong -------------------------------------------------------

    ; An answer that is wrong is usually wrong the same way on every line, and
    ; two hundred copies of one mistake is a wall, not a report. The first few
    ; are kept and the rest are counted.
    fn fail:void (text:string why:string) {
        if ((array_length errors) >= 6) {
            more = (more + 1)
            return
        }
        push errors (new RaveTextError(lineNo text why))
    }

    fn errorCount:int () {
        return (array_length errors)
    }

    fn errorAt:string (i:int) {
        def e:RaveTextError (itemAt errors i)
        return (e.message())
    }

    fn moreCount:int () {
        return more
    }

    ; An answer that is a whole application: it has routes, or a layout, or
    ; more than one page. Asked of a fragment read, it means the person
    ; pasted the document while the menu was on one page of it.
    fn looksWhole:boolean () {
        if sawRoute {
            return true
        }
        if sawLayout {
            return true
        }
        return (pageCount > 1)
    }

    ; And the other way: one page and no routes, pasted as a document.
    fn looksLikeOnePage:boolean () {
        if sawRoute {
            return false
        }
        return (pageCount <= 1)
    }

    fn totalErrors:int () {
        return ((array_length errors) + more)
    }

    fn useBreakpointsOf:void (other:RaveApp) {
        clear seedNames
        clear seedMins
        def i:int 0
        while (i < (array_length other.breakpoints)) {
            def b:RaveBreakpoint (itemAt other.breakpoints i)
            push seedNames b.name
            push seedMins b.minWidth
            i = (i + 1)
        }
    }

    ; --- the scanner -----------------------------------------------------------

    sfn isSpace:boolean (c:int) {
        return (((c == 32) || (c == 9)) || ((c == 10) || (c == 13)))
    }

    sfn isNameChar:boolean (c:int) {
        if ((c >= 97) && (c <= 122)) { return true }
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 48) && (c <= 57)) { return true }
        if (c == 45) { return true }
        if (c == 95) { return true }
        return false
    }

    fn take:int () {
        def c:int (charAt src pos)
        if (c == 10) {
            lineNo = (lineNo + 1)
        }
        pos = (pos + 1)
        return c
    }

    fn peek:int () {
        if (pos >= (strlen src)) {
            return 0
        }
        return (charAt src pos)
    }

    fn peekAt:int (n:int) {
        if ((pos + n) >= (strlen src)) {
            return 0
        }
        return (charAt src (pos + n))
    }

    fn skipSpace:void () {
        while (pos < (strlen src)) {
            if (RaveTextReader.isSpace((this.peek()))) {
                this.take()
            } {
                return
            }
        }
    }

    ; `&amp;` and the other four, back into what they stand for.
    sfn unescape:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (c == 38) {
                def name:string ""
                def j:int (i + 1)
                def closed:boolean false
                while ((j < (strlen s)) && (closed == false)) {
                    def e:int (charAt s j)
                    if (e == 59) {
                        closed = true
                    } {
                        if ((strlen name) > 8) {
                            j = (strlen s)
                        } {
                            name = (name + (strfromcode e))
                            j = (j + 1)
                        }
                    }
                }
                if closed {
                    if (name == "amp") { out = (out + "&") }
                    if (name == "lt") { out = (out + "<") }
                    if (name == "gt") { out = (out + ">") }
                    if (name == "quot") { out = (out + "\"") }
                    if (name == "apos") { out = (out + "'") }
                    if (name == "#39") { out = (out + "'") }
                    if (name == "nbsp") { out = (out + " ") }
                    i = (j + 1)
                } {
                    out = (out + "&")
                    i = (i + 1)
                }
            } {
                out = (out + (strfromcode c))
                i = (i + 1)
            }
        }
        return out
    }

    ; Whitespace between tags is layout, not words: runs collapse to one space
    ; and a run that is only whitespace is nothing at all.
    sfn tidyText:string (s:string) {
        def out:string ""
        def space:boolean false
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (RaveTextReader.isSpace(c)) {
                space = true
            } {
                if (space && ((strlen out) > 0)) {
                    out = (out + " ")
                }
                space = false
                out = (out + (strfromcode c))
            }
            i = (i + 1)
        }
        return out
    }

    fn readName:string () {
        def out:string ""
        while (pos < (strlen src)) {
            def c:int (this.peek())
            if (RaveTextReader.isNameChar(c)) {
                out = (out + (strfromcode c))
                this.take()
            } {
                return out
            }
        }
        return out
    }

    ; A tag, from just after the `<`. Leaves `tagName`, the attributes and
    ; `selfClosing` behind, and the cursor just past the `>`.
    fn readTag:void () {
        clear attrKeys
        clear attrVals
        selfClosing = false
        tagName = (this.readName())
        def go:boolean true
        while go {
            this.skipSpace()
            def c:int (this.peek())
            if (c == 0) {
                go = false
            } {
                if (c == 62) {
                    this.take()
                    go = false
                } {
                    if (c == 47) {
                        this.take()
                        selfClosing = true
                    } {
                        def key:string (this.readName())
                        if ((strlen key) == 0) {
                            ; something that is not an attribute: step over it
                            ; rather than spin
                            this.take()
                        } {
                            def value:string ""
                            this.skipSpace()
                            if ((this.peek()) == 61) {
                                this.take()
                                this.skipSpace()
                                def q:int (this.peek())
                                if ((q == 34) || (q == 39)) {
                                    this.take()
                                    def raw:string ""
                                    def reading:boolean true
                                    while reading {
                                        def v:int (this.peek())
                                        if (v == 0) {
                                            reading = false
                                        } {
                                            if (v == q) {
                                                this.take()
                                                reading = false
                                            } {
                                                raw = (raw + (strfromcode (this.take())))
                                            }
                                        }
                                    }
                                    value = (RaveTextReader.unescape(raw))
                                } {
                                    def bare:string ""
                                    def reading2:boolean true
                                    while reading2 {
                                        def v2:int (this.peek())
                                        if (((v2 == 0) || (v2 == 62)) || (RaveTextReader.isSpace(v2))) {
                                            reading2 = false
                                        } {
                                            bare = (bare + (strfromcode (this.take())))
                                        }
                                    }
                                    value = (RaveTextReader.unescape(bare))
                                }
                            } {
                                value = "yes"
                            }
                            push attrKeys key
                            push attrVals value
                        }
                    }
                }
            }
        }
    }

    fn hasAttr:boolean (key:string) {
        def i:int 0
        while (i < (array_length attrKeys)) {
            if ((itemAt attrKeys i) == key) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn get:string (key:string) {
        def i:int 0
        while (i < (array_length attrKeys)) {
            if ((itemAt attrKeys i) == key) {
                return (itemAt attrVals i)
            }
            i = (i + 1)
        }
        return ""
    }

    ; Everything up to `</name>`, taken as it stands — what a <style> holds.
    fn rawUntilClose:string (name:string) {
        def out:string ""
        def go:boolean true
        while go {
            if (pos >= (strlen src)) {
                go = false
            } {
                if ((this.peek()) == 60) {
                    if ((this.peekAt(1)) == 47) {
                        def save:int pos
                        this.take()
                        this.take()
                        def what:string (this.readName())
                        this.skipSpace()
                        if ((this.peek()) == 62) {
                            this.take()
                        }
                        if (what == name) {
                            return out
                        }
                        out = (out + (substring src save pos))
                    } {
                        out = (out + (strfromcode (this.take())))
                    }
                } {
                    out = (out + (strfromcode (this.take())))
                }
            }
        }
        return out
    }

    ; --- what the tags mean -----------------------------------------------------

    sfn knownTag:boolean (tag:string) {
        if (tag == "div") { return true }
        if (tag == "span") { return true }
        if (tag == "p") { return true }
        if (tag == "h1") { return true }
        if (tag == "h2") { return true }
        if (tag == "h3") { return true }
        if (tag == "h4") { return true }
        if (tag == "header") { return true }
        if (tag == "footer") { return true }
        if (tag == "nav") { return true }
        if (tag == "main") { return true }
        if (tag == "aside") { return true }
        if (tag == "section") { return true }
        if (tag == "form") { return true }
        if (tag == "label") { return true }
        if (tag == "input") { return true }
        if (tag == "button") { return true }
        if (tag == "a") { return true }
        if (tag == "img") { return true }
        if (tag == "ul") { return true }
        if (tag == "li") { return true }
        if (tag == "slot") { return true }
        if (tag == "toast") { return true }
        return false
    }

    fn applyDecls:void (cls:string media:string css:string) {
        if ((strlen (trim css)) == 0) {
            return
        }
        def decls:[EVGStyleDecl] (sheet.parseDeclarations(css))
        def r:RaveRule (app.rule(cls media))
        def i:int 0
        while (i < (array_length decls)) {
            def d:EVGStyleDecl (itemAt decls i)
            r.set(d.name d.value)
            i = (i + 1)
        }
    }

    ; `below="md"`, `from="md"` or `query="…"`, as the query the sheet wants.
    fn mediaOfAttrs:string () {
        if (this.hasAttr("below")) {
            return (app.below((this.get("below"))))
        }
        if (this.hasAttr("from")) {
            return (app.from((this.get("from"))))
        }
        return (this.get("query"))
    }

    fn setAttr:void (n:RaveNode key:string value:string) {
        if (key == "name") {
            n.name = value
            return
        }
        if (key == "class") {
            def at:string ""
            def i:int 0
            while (i <= (strlen value)) {
                def c:int 32
                if (i < (strlen value)) {
                    c = (charAt value i)
                }
                if (RaveTextReader.isSpace(c)) {
                    if ((strlen at) > 0) {
                        n.addClass(at)
                        at = ""
                    }
                } {
                    at = (at + (strfromcode c))
                }
                i = (i + 1)
            }
            return
        }
        if (key == "style") {
            this.applyDecls((n.cls()) "" value)
            return
        }
        if (key == "label") {
            n.label = value
            return
        }
        if (key == "placeholder") {
            n.placeholder = value
            return
        }
        if (key == "alt") {
            n.alt = value
            return
        }
        if (key == "src") {
            n.src = value
            return
        }
        if (key == "role") {
            n.role = value
            return
        }
        if (key == "state") {
            n.state = value
            return
        }
        if (key == "bind") {
            n.bind = value
            return
        }
        if (key == "repeat") {
            n.repeat = value
            return
        }
        if (key == "source") {
            n.source = value
            return
        }
        if (key == "sourceKey") {
            n.sourceKey = value
            return
        }
        if (key == "overlay") {
            n.overlay = value
            n.kind = "overlay"
            if ((strlen n.label) == 0) {
                n.label = value
            }
            return
        }
        if (key == "component") {
            n.component = value
            n.kind = "instance"
            return
        }
        if (key == "variant") {
            n.variant = value
            return
        }
        if (key == "when") {
            n.kind = "conditional"
            n.condition = value
            n.name = value
            return
        }
        this.fail(("<" + tagName + " " + key + "=…>") ("`" + key + "` is not an attribute this markup has"))
    }

    fn makeNode:RaveNode () {
        def real:string tagName
        if (tagName == "slot") {
            real = "div"
        }
        if (tagName == "toast") {
            real = "span"
        }
        def n:RaveNode (app.newNode(real tagName))
        if (tagName == "slot") {
            n.kind = "slot"
            n.name = "Content"
        }
        if (tagName == "toast") {
            n.kind = "toast"
            n.name = "Toast"
        }
        def i:int 0
        while (i < (array_length attrKeys)) {
            this.setAttr(n (itemAt attrKeys i) (itemAt attrVals i))
            i = (i + 1)
        }
        return n
    }

    ; --- the stack --------------------------------------------------------------

    fn openNode:void (name:string id:int) {
        push openTags name
        push openIds id
    }

    fn currentId:int () {
        def n:int (array_length openIds)
        if (n == 0) {
            return rootId
        }
        return (itemAt openIds (n - 1))
    }

    fn closeTag:void (name:string) {
        def n:int (array_length openTags)
        if (n == 0) {
            return
        }
        def at:int (0 - 1)
        def i:int (n - 1)
        while ((i >= 0) && (at < 0)) {
            if ((itemAt openTags i) == name) {
                at = i
            }
            i = (i - 1)
        }
        if (at < 0) {
            this.fail(("</" + name + ">") ("nothing called `" + name + "` was open here"))
            return
        }
        while ((array_length openTags) > at) {
            removeLast openTags
            removeLast openIds
        }
    }

    fn addText:void (words:string) {
        def tidy:string (RaveTextReader.tidyText((RaveTextReader.unescape(words))))
        if ((strlen tidy) == 0) {
            return
        }
        def id:int (this.currentId())
        if (id == 0) {
            return
        }
        def n:RaveNode (app.node(id))
        if ((strlen n.text) == 0) {
            n.text = tidy
            if ((n.name == n.tag) || ((strlen n.name) == 0)) {
                n.name = tidy
            }
        } {
            n.text = (n.text + " " + tidy)
        }
    }

    ; --- the document -----------------------------------------------------------

    fn startBlock:RaveNode (isLayout:boolean) {
        def name:string (this.get("name"))
        if ((strlen name) == 0) {
            name = "Untitled"
        }
        def root:RaveNode (app.newPage(name))
        if isLayout {
            ; a layout is not a page: take the one that was just made back out
            removeLast app.pages
            root = (app.newLayout(name))
        }
        rootId = root.id
        clear openTags
        clear openIds
        push names name
        push ids root.id
        def i:int 0
        while (i < (array_length attrKeys)) {
            def key:string (itemAt attrKeys i)
            if ((key != "name") && (key != "inside")) {
                this.setAttr(root key (itemAt attrVals i))
            }
            i = (i + 1)
        }
        if isLayout {
            if (this.hasAttr("inside")) {
                push pendingChild name
                push pendingParent (this.get("inside"))
            }
        }
        return root
    }

    fn readRoute:void (text:string) {
        def path:string (this.get("path"))
        def title:string (this.get("title"))
        def pageId:int (RaveTextReader.idNamed(names ids (this.get("page"))))
        def layoutId:int 0
        if (this.hasAttr("layout")) {
            layoutId = (RaveTextReader.idNamed(names ids (this.get("layout"))))
            if (layoutId == 0) {
                this.fail(text ("no layout called " + (this.get("layout"))))
            }
        }
        if (pageId == 0) {
            this.fail(text ("no page called " + (this.get("page"))))
            return
        }
        def r (new RaveRoute(path title pageId layoutId))
        r.protected = (this.hasAttr("protected"))
        push app.routes r
    }

    sfn idNamed:int (names:[string] ids:[int] want:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == want) {
                return (itemAt ids i)
            }
            i = (i + 1)
        }
        return 0
    }

    ; A page or a node on its own, the way the AI menu asks for one back.
    fn readFragment:RaveApp (text:string) {
        fragment = true
        def out:RaveApp (this.readDoc(text))
        fragment = false
        return out
    }

    fn readDoc:RaveApp (text:string) {
        app = (new RaveApp("Untitled"))
        clear errors
        clear openTags
        clear openIds
        clear pendingChild
        clear pendingParent
        clear names
        clear ids
        clear routeTexts
        clear routeLines
        sawRoute = false
        sawLayout = false
        pageCount = 0
        src = text
        pos = 0
        lineNo = 1
        more = 0
        rootId = 0
        holderId = 0
        def sb:int 0
        while (sb < (array_length seedNames)) {
            app.addBreakpoint((itemAt seedNames sb) (itemAt seedMins sb))
            sb = (sb + 1)
        }
        if fragment {
            ; a page for the answer to land in; the caller takes what is on it
            def holder:RaveNode (app.newPage("_fragment"))
            holderId = holder.id
            rootId = holderId
        }
        def routeAttrKeys:[string]
        def collName:string ""
        def go:boolean true
        while go {
            if (pos >= (strlen src)) {
                go = false
            } {
                def c:int (this.peek())
                if (c != 60) {
                    def words:string ""
                    while ((pos < (strlen src)) && ((this.peek()) != 60)) {
                        words = (words + (strfromcode (this.take())))
                    }
                    this.addText(words)
                } {
                    ; a comment
                    if (((this.peekAt(1)) == 33) && ((this.peekAt(2)) == 45)) {
                        while ((pos < (strlen src)) && ((this.peek()) != 62)) {
                            this.take()
                        }
                        if (pos < (strlen src)) {
                            this.take()
                        }
                    } {
                        if ((this.peekAt(1)) == 47) {
                            this.take()
                            this.take()
                            def closing:string (this.readName())
                            this.skipSpace()
                            if ((this.peek()) == 62) {
                                this.take()
                            }
                            if (((closing == "page") || (closing == "layout")) || (closing == "collection")) {
                                if (fragment == false) {
                                    rootId = 0
                                }
                                clear openTags
                                clear openIds
                            } {
                                this.closeTag(closing)
                            }
                        } {
                            this.take()
                            def where:int lineNo
                            this.readTag()
                            def tag:string tagName
                            if ((strlen tag) == 0) {
                                this.fail("<>" "a `<` with no tag after it")
                                continue
                            }
                            if (tag == "app") {
                                app.name = (this.get("name"))
                                def targets:string (this.get("targets"))
                                def at:string ""
                                def ti:int 0
                                while (ti <= (strlen targets)) {
                                    def tc:int 32
                                    if (ti < (strlen targets)) {
                                        tc = (charAt targets ti)
                                    }
                                    if (RaveTextReader.isSpace(tc)) {
                                        if ((strlen at) > 0) {
                                            push app.targets at
                                            at = ""
                                        }
                                    } {
                                        at = (at + (strfromcode tc))
                                    }
                                    ti = (ti + 1)
                                }
                                if (this.hasAttr("nav")) {
                                    app.nav = (this.get("nav"))
                                }
                                if (this.hasAttr("auth")) {
                                    app.authEnabled = ((this.get("auth")) != "off")
                                }
                                if (this.hasAttr("login")) {
                                    app.loginRoute = (this.get("login"))
                                }
                                if (this.hasAttr("after")) {
                                    app.afterLogin = (this.get("after"))
                                }
                                continue
                            }
                            if (tag == "breakpoint") {
                                app.addBreakpoint((this.get("name")) (?? (str2int (this.get("min"))) 0))
                                continue
                            }
                            if (tag == "var") {
                                app.setVar((this.get("name")) (this.get("value")))
                                continue
                            }
                            if (tag == "style") {
                                def cls:string (this.get("class"))
                                if ((strlen cls) > 0) {
                                    if ((charAt cls 0) == 46) {
                                        cls = (substring cls 1 (strlen cls))
                                    }
                                }
                                def media:string (this.mediaOfAttrs())
                                def body:string (this.get("style"))
                                if (selfClosing == false) {
                                    body = (RaveTextReader.unescape((this.rawUntilClose("style"))))
                                }
                                if ((strlen cls) == 0) {
                                    this.fail("<style>" "a style with no class= to put it on")
                                } {
                                    this.applyDecls(cls media body)
                                }
                                continue
                            }
                            if (tag == "collection") {
                                collName = (this.get("name"))
                                def coll:RaveCollection (app.addCollection(collName))
                                def fields:string (this.get("fields"))
                                def fat:string ""
                                def fi:int 0
                                while (fi <= (strlen fields)) {
                                    def fc:int 32
                                    if (fi < (strlen fields)) {
                                        fc = (charAt fields fi)
                                    }
                                    if (RaveTextReader.isSpace(fc)) {
                                        if ((strlen fat) > 0) {
                                            coll.addField(fat fat)
                                            fat = ""
                                        }
                                    } {
                                        fat = (fat + (strfromcode fc))
                                    }
                                    fi = (fi + 1)
                                }
                                continue
                            }
                            if (tag == "row") {
                                if ((strlen collName) == 0) {
                                    this.fail("<row/>" "a row outside any collection")
                                    continue
                                }
                                def coll2:RaveCollection (app.collection(collName))
                                def row:RaveRow (coll2.addRow())
                                def ri:int 0
                                while (ri < (array_length attrKeys)) {
                                    row.set((itemAt attrKeys ri) (itemAt attrVals ri))
                                    ri = (ri + 1)
                                }
                                continue
                            }
                            if (tag == "route") {
                                sawRoute = true
                                push routeTexts (this.routeText())
                                push routeLines where
                                continue
                            }
                            if ((tag == "page") || (tag == "layout")) {
                                if (tag == "layout") {
                                    sawLayout = true
                                } {
                                    pageCount = (pageCount + 1)
                                }
                                if fragment {
                                    ; the answer brought its own page or layout
                                    ; tag: fill the holder from it instead of
                                    ; making a second one
                                    def hold:RaveNode (app.node(holderId))
                                    def hi:int 0
                                    while (hi < (array_length attrKeys)) {
                                        def hkey:string (itemAt attrKeys hi)
                                        if ((hkey != "name") && (hkey != "inside")) {
                                            this.setAttr(hold hkey (itemAt attrVals hi))
                                        }
                                        hi = (hi + 1)
                                    }
                                    clear openTags
                                    clear openIds
                                    rootId = holderId
                                    continue
                                }
                                this.startBlock((tag == "layout"))
                                continue
                            }
                            if (tag == "media") {
                                def owner:int (this.currentId())
                                if (owner == 0) {
                                    this.fail("<media/>" "a media rule with nothing to put it on")
                                    continue
                                }
                                def on:RaveNode (app.node(owner))
                                this.applyDecls((on.cls()) (this.mediaOfAttrs()) (this.get("style")))
                                continue
                            }
                            if (tag == "on") {
                                def owner2:int (this.currentId())
                                if (owner2 == 0) {
                                    this.fail("<on/>" "an action with nothing to put it on")
                                    continue
                                }
                                def an:RaveNode (app.node(owner2))
                                def kind:string (this.get("click"))
                                if ((strlen kind) == 0) {
                                    kind = (this.get("action"))
                                }
                                if ((strlen kind) == 0) {
                                    this.fail("<on/>" "an action that does not say what it does")
                                    continue
                                }
                                an.on(kind (this.get("arg")))
                                continue
                            }
                            if ((RaveTextReader.knownTag(tag)) == false) {
                                lineNo = where
                                this.fail(("<" + tag + ">") ("`" + tag + "` is not an element this markup has"))
                                continue
                            }
                            if (rootId == 0) {
                                lineNo = where
                                this.fail(("<" + tag + ">") "an element outside any page or layout")
                                continue
                            }
                            def made:RaveNode (this.makeNode())
                            def parent:RaveNode (app.node((this.currentId())))
                            parent.add(made)
                            if (selfClosing == false) {
                                this.openNode(tag made.id)
                            }
                        }
                    }
                }
            }
        }

        ; a layout that named the layout it sits inside
        def pc:int 0
        while (pc < (array_length pendingChild)) {
            def childId:int (RaveTextReader.idNamed(names ids (itemAt pendingChild pc)))
            def parentId:int (RaveTextReader.idNamed(names ids (itemAt pendingParent pc)))
            if ((childId > 0) && (parentId > 0)) {
                def cn:RaveNode (app.node(childId))
                cn.parentLayout = parentId
            } {
                this.fail(((itemAt pendingChild pc) + " inside " + (itemAt pendingParent pc)) "one of those layouts does not exist")
            }
            pc = (pc + 1)
        }
        ; and the routes, once every page and layout has a name to find
        def rl:int 0
        while (rl < (array_length routeTexts)) {
            lineNo = (itemAt routeLines rl)
            this.replayRoute((itemAt routeTexts rl))
            rl = (rl + 1)
        }
        return app
    }

    ; A route is read after everything else, so its attributes are kept as the
    ; text of the tag and read again at the end.
    fn routeText:string () {
        def out:string "<route"
        def i:int 0
        while (i < (array_length attrKeys)) {
            out = (out + " " + (itemAt attrKeys i) + "=\"" + (itemAt attrVals i) + "\"")
            i = (i + 1)
        }
        return (out + "/>")
    }

    fn replayRoute:void (text:string) {
        def keepSrc:string src
        def keepPos:int pos
        src = text
        pos = 1
        this.readTag()
        this.readRoute(text)
        src = keepSrc
        pos = keepPos
    }
}

; A Figma file, read as a Rave application.
;   node gallery/rave/bin/rave_import_cli.js <file.fig> [out.rave.json]
;
; Prints what it worked out and what it guessed, builds the result at every
; width the file was drawn at, and says whether the engine rejected anything
; and whether the accessibility lint has an objection. An import that draws
; is not the same as an import that is right, and this is how the difference
; is read without opening a browser.

Import "../../figma/src/FigParser.rgr"
Import "../../figma/src/convert/FigToScene.rgr"
Import "RaveImport.rgr"
Import "RaveText.rgr"
Import "RaveRuntime.rgr"

class RaveImportCli {

    sfn dirOf:string (path:string) {
        def at:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        if (at < 0) {
            return "."
        }
        return (substring path 0 at)
    }

    sfn nameOf:string (path:string) {
        def at:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        return (substring path (at + 1) (strlen path))
    }

    sfn main:void () {
        def n:int (shell_arg_cnt)
        if (n < 1) {
            print "usage: rave_import_cli <file.fig> [out.rave.json]"
            return
        }
        def first:string (shell_arg 0)
        if (first == "spec") {
            print (RaveText.spec())
            return
        }
        ; `read` and `readpage` take markup back the way the AI menu does, and
        ; say what the reader made of it. The same two doors, on a file.
        if ((first == "read") || (first == "readpage")) {
            if (n < 2) {
                print "usage: rave_import_cli read|readpage <file.rave>"
                return
            }
            def mpath:string (shell_arg 1)
            def markup@(optional):string (read_file (RaveImportCli.dirOf(mpath)) (RaveImportCli.nameOf(mpath)))
            if (null? markup) {
                print ("cannot read " + mpath)
                return
            }
            def reader (new RaveTextReader())
            def got:RaveApp (new RaveApp(""))
            if (first == "readpage") {
                got = (reader.readFragment((unwrap markup)))
            } {
                got = (reader.readDoc((unwrap markup)))
            }
            if (first == "readpage") {
                if (reader.looksWhole()) {
                    print "this is a whole document, not one page — read it with `read`"
                }
            }
            print ("errors " + (to_string (reader.totalErrors())))
            def ei:int 0
            while (ei < (reader.errorCount())) {
                print ("  " + (reader.errorAt(ei)))
                ei = (ei + 1)
            }
            print ("name " + got.name + " · routes " + (to_string (array_length got.routes))
                + " · layouts " + (to_string (array_length got.layouts))
                + " · pages " + (to_string (array_length got.pages))
                + " · styles " + (to_string (array_length got.styles)))
            def ri:int 0
            while (ri < (array_length got.routes)) {
                def rr:RaveRoute (itemAt got.routes ri)
                print ("  " + rr.path + "  " + rr.title)
                ri = (ri + 1)
            }
            if ((array_length got.routes) > 0) {
                def rtc (new RaveRuntime(got))
                print ("stylesheet errors " + (to_string (rtc.styleErrorCount())))
                rtc.addView("wide" 1440.0 900.0 false)
                def warn:int (rtc.layoutWarningCount(0))
                def problems:[string] (rtc.lint(0))
                print ("rejected " + (to_string warn) + " · a11y " + (to_string (array_length problems)))
                def wi:int 0
                while (wi < warn) {
                    print ("  rejected: " + (rtc.layoutWarning(0 wi)))
                    wi = (wi + 1)
                }
            }
            return
        }
        def asText:boolean false
        def at:int 0
        if (first == "text") {
            asText = true
            at = 1
        }
        if (n < (at + 1)) {
            print "usage: rave_import_cli [text] <file.fig> [out.rave.json]"
            return
        }
        def path:string (shell_arg at)
        def bytes:buffer (buffer_read_file (RaveImportCli.dirOf(path)) (RaveImportCli.nameOf(path)))
        def parser (new FigParser())
        def doc:FigDoc (parser.parseBytes(bytes (RaveImportCli.nameOf(path))))
        if (doc.ok == false) {
            print ("error: " + doc.err)
            return
        }
        def conv (new FigToScene())
        def scene:SceneDocument (conv.convertDoc(doc))
        def imp (new RaveImport())
        def app:RaveApp (imp.run(scene))

        if asText {
            print (RaveText.writeApp(app))
            return
        }
        print ("=== " + app.name + " ===")
        print (imp.report.summary())
        print ("routes " + (to_string (array_length app.routes)) + " · layouts " + (to_string (array_length app.layouts)) + " · pages " + (to_string (array_length app.pages)))
        def r:int 0
        while (r < (array_length app.routes)) {
            def route:RaveRoute (itemAt app.routes r)
            print ("  " + route.path + "   " + route.title)
            r = (r + 1)
        }
        print ""
        def i:int 0
        while (i < (imp.report.noteCount())) {
            print ("  " + (imp.report.noteAt(i)))
            i = (i + 1)
        }

        ; and now: does it draw?
        print ""
        def rt (new RaveRuntime(app))
        print ("stylesheet errors " + (to_string (rt.styleErrorCount())))
        def e:int 0
        while (e < (rt.styleErrorCount())) {
            print ("  " + (rt.styleError(e)))
            e = (e + 1)
        }
        rt.addView("wide" 1440.0 900.0 false)
        rt.addView("phone" 390.0 844.0 true)
        def v:int 0
        while (v < 2) {
            def warn:int (rt.layoutWarningCount(v))
            def problems:[string] (rt.lint(v))
            print ("view " + (to_string v) + ": rejected " + (to_string warn) + " · a11y " + (to_string (array_length problems)))
            def w:int 0
            while (w < warn) {
                print ("    rejected: " + (rt.layoutWarning(v w)))
                w = (w + 1)
            }
            def p:int 0
            while (p < (array_length problems)) {
                print ("    a11y: " + (itemAt problems p))
                p = (p + 1)
            }
            v = (v + 1)
        }

        if (n >= (at + 2)) {
            def out:string (shell_arg (at + 1))
            write_file "." out (app.toJson())
            print ("")
            print ("wrote " + out)
        }
    }
}

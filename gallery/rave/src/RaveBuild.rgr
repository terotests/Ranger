; =============================================================================
; RaveBuild — a route, as EVG elements
; =============================================================================
; The one place that knows how a `RaveNode` becomes an element. A route's
; layout is built with the page spliced into its slot; a conditional node is
; built only when the session allows it; a tag chooses a role and whether the
; thing takes focus, the way HTML does. Every element carries the node's own
; id, so the hit test, the accessibility tree and the focus walk all speak
; the document's ids.
;
; Nothing here is styled: `rv`, `n<id>` and the shared classes are put on the
; element, and the stylesheet the document emitted does the rest.
; =============================================================================

Import "RaveDoc.rgr"
Import "RaveAuth.rgr"
Import "RaveBind.rgr"
Import "../../ui/src/UiTree.rgr"
Import "../../evg/EVGElement.rgr"

class RaveBuild {
    def app:RaveApp (new RaveApp(""))
    def auth:RaveAuth (new RaveAuth())
    ; The page the layout's slot receives while a route is being built.
    def pageId:int 0
    ; The view's controllers, when a route is built to RUN. Without one a
    ; kit instance is drawn as its closed, resting shape.
    def bind@(optional):RaveBind

    Constructor (a:RaveApp au:RaveAuth) {
        app = a
        auth = au
    }

    ; --- a route --------------------------------------------------------------

    fn page:EVGElement (r:RaveRoute) {
        def root:EVGElement (EVGElement.createDiv())
        root.id = "page"
        root.className = "rv rv-page"
        root.role = "group"
        root.a11yLabel = r.title
        pageId = r.pageId
        if (r.layoutId > 0) {
            def lay:RaveNode (app.node(r.layoutId))
            root.addChild((this.element(lay)))
        } {
            def pg:RaveNode (app.node(r.pageId))
            root.addChild((this.element(pg)))
        }
        return root
    }

    ; --- a node ---------------------------------------------------------------

    fn classesOf:string (n:RaveNode) {
        def s:string ("rv " + (n.cls()))
        def i:int 0
        while (i < (array_length n.classes)) {
            s = (s + " " + (itemAt n.classes i))
            i = (i + 1)
        }
        if (n.kind == "instance") {
            s = (s + " cmp-" + n.component)
            if ((strlen n.variant) > 0) {
                s = (s + " cmp-" + n.component + "-" + n.variant)
            }
        }
        return s
    }

    sfn isTextTag:boolean (tag:string) {
        if (tag == "h1") { return true }
        if (tag == "h2") { return true }
        if (tag == "h3") { return true }
        if (tag == "h4") { return true }
        if (tag == "p") { return true }
        if (tag == "span") { return true }
        if (tag == "label") { return true }
        return false
    }

    sfn headingLevel:int (tag:string) {
        if (tag == "h1") { return 1 }
        if (tag == "h2") { return 2 }
        if (tag == "h3") { return 3 }
        if (tag == "h4") { return 4 }
        return 0
    }

    ; The role a tag implies. "" is decoration: not in the accessible tree.
    sfn roleOf:string (tag:string) {
        if (tag == "header") { return "banner" }
        if (tag == "nav") { return "navigation" }
        if (tag == "main") { return "main" }
        if (tag == "aside") { return "region" }
        if (tag == "section") { return "region" }
        if (tag == "footer") { return "region" }
        if (tag == "form") { return "form" }
        if (tag == "button") { return "button" }
        if (tag == "a") { return "link" }
        if (tag == "img") { return "img" }
        if (tag == "input") { return "textbox" }
        if (tag == "ul") { return "list" }
        if (tag == "li") { return "listitem" }
        if (tag == "p") { return "paragraph" }
        if (tag == "span") { return "text" }
        if (tag == "label") { return "text" }
        if ((RaveBuild.headingLevel(tag)) > 0) { return "heading" }
        return ""
    }

    sfn takesFocus:boolean (tag:string) {
        if (tag == "button") { return true }
        if (tag == "a") { return true }
        if (tag == "input") { return true }
        return false
    }

    ; A text node: the element IS the text.
    fn textElement:EVGElement (n:RaveNode) {
        def e:EVGElement (EVGElement.createDiv())
        e.id = (n.elementId())
        e.className = ("rv-t " + (n.cls()))
        def i:int 0
        while (i < (array_length n.classes)) {
            e.className = (e.className + " " + (itemAt n.classes i))
            i = (i + 1)
        }
        e.elementType = 1
        e.textContent = n.text
        e.role = (RaveBuild.roleOf(n.tag))
        def lvl:int (RaveBuild.headingLevel(n.tag))
        if (lvl > 0) {
            e.a11yLevel = lvl
        }
        if ((strlen n.label) > 0) {
            e.a11yLabel = n.label
        }
        return e
    }

    fn element:EVGElement (n:RaveNode) {
        if ((n.kind == "instance") && (RaveBind.isKit(n.component))) {
            if bind {
                return (this.instance(n))
            }
        }
        if (RaveBuild.isTextTag(n.tag)) {
            if ((n.hasChildren()) == false) {
                return (this.textElement(n))
            }
        }
        def e:EVGElement (EVGElement.createDiv())
        if (n.tag == "img") {
            e = (EVGElement.createImg())
            e.src = n.src
            e.alt = n.alt
        }
        e.id = (n.elementId())
        e.className = (this.classesOf(n))
        e.role = (RaveBuild.roleOf(n.tag))
        if ((strlen n.label) > 0) {
            e.a11yLabel = n.label
        }
        if ((n.tag == "img") && ((strlen n.alt) > 0)) {
            e.a11yLabel = n.alt
        }
        if (RaveBuild.takesFocus(n.tag)) {
            e.a11yFocusable = true
            ; A button or a link is named by its caption. The caption element
            ; itself is hidden from the reader so the name is said once.
            if (((strlen n.label) == 0) && ((strlen n.text) > 0)) {
                e.a11yLabel = n.text
            }
        }
        if (n.tag == "input") {
            e.a11yValue = n.text
            if ((strlen n.text) == 0) {
                def hint:EVGElement (EVGElement.createDiv())
                hint.elementType = 1
                hint.textContent = n.placeholder
                hint.className = "rv-t rv-placeholder"
                hint.a11yHidden = true
                e.addChild(hint)
            } {
                def val:EVGElement (EVGElement.createDiv())
                val.elementType = 1
                val.textContent = n.text
                val.className = "rv-t rv-value"
                val.a11yHidden = true
                e.addChild(val)
            }
        } {
            ; A container with words of its own: a button's caption, a link's
            ; text, a list item. The caption is hidden from the reader because
            ; the box already carries the name from its content.
            if ((strlen n.text) > 0) {
                def cap:EVGElement (EVGElement.createDiv())
                cap.elementType = 1
                cap.textContent = n.text
                cap.className = "rv-t rv-cap"
                if (RaveBuild.takesFocus(n.tag)) {
                    cap.a11yHidden = true
                } {
                    cap.role = "text"
                }
                e.addChild(cap)
            }
        }
        if (n.kind == "slot") {
            if (pageId > 0) {
                def pg:RaveNode (app.node(pageId))
                e.addChild((this.element(pg)))
            }
        }
        def i:int 0
        while (i < (array_length n.children)) {
            def c:RaveNode (itemAt n.children i)
            if (this.shown(c)) {
                e.addChild((this.element(c)))
            }
            i = (i + 1)
        }
        return e
    }

    ; --- kit instances --------------------------------------------------------

    fn childrenInto:void (host:EVGElement n:RaveNode) {
        def i:int 0
        while (i < (array_length n.children)) {
            def c:RaveNode (itemAt n.children i)
            if (this.shown(c)) {
                host.addChild((this.element(c)))
            }
            i = (i + 1)
        }
    }

    ; A kit node becomes its controller's tree: the controller builds its
    ; own shape, the document's children go where the body belongs, and the
    ; node's classes ride along so the sheet can address it.
    fn instance:EVGElement (n:RaveNode) {
        def b:RaveBind (unwrap bind)
        def id:string (n.elementId())
        if (n.component == "Dialog") {
            def d:DialogCtl (b.dialog(id))
            d.name = n.text
            d.title = n.name
            d.build()
            if d.open {
                def content:EVGElement (unwrap d.contentEl)
                UiTree.clearChildren(content)
                content.addChild((unwrap d.titleEl))
                def body:EVGElement (EVGElement.createDiv())
                body.className = ("rv " + (n.cls()) + "-body")
                body.setAttribute("gap" "12px")
                this.childrenInto(body n)
                content.addChild(body)
                content.addChild((unwrap d.closeEl))
            }
            RaveBind.decorate(d)
            def root:EVGElement (unwrap d.rootEl)
            UiTree.addClass(root (n.cls()))
            return root
        }
        if (n.component == "Tabs") {
            def t:TabsCtl (b.tabsOf(id))
            clear t.items
            def i:int 0
            while (i < (array_length n.children)) {
                def tab:RaveNode (itemAt n.children i)
                t.addItem((tab.elementId()) tab.name "" false)
                i = (i + 1)
            }
            if ((array_length n.children) > 0) {
                def first:RaveNode (itemAt n.children 0)
                if ((strlen t.value) == 0) {
                    t.value = (first.elementId())
                }
            }
            t.build()
            def j:int 0
            while (j < (array_length n.children)) {
                def tab2:RaveNode (itemAt n.children j)
                if ((tab2.elementId()) == t.value) {
                    def it:UiItem (itemAt t.items j)
                    def panel:EVGElement (unwrap it.contentEl)
                    UiTree.clearChildren(panel)
                    panel.setAttribute("gap" "12px")
                    this.childrenInto(panel tab2)
                }
                j = (j + 1)
            }
            RaveBind.decorate(t)
            def root2:EVGElement (unwrap t.rootEl)
            UiTree.addClass(root2 (n.cls()))
            return root2
        }
        if (n.component == "Select") {
            def sel:SelectCtl (b.select(id))
            clear sel.items
            def k:int 0
            while (k < (array_length n.children)) {
                def opt:RaveNode (itemAt n.children k)
                sel.addItem((opt.elementId()) opt.text false)
                k = (k + 1)
            }
            if ((array_length n.children) > 0) {
                def first2:RaveNode (itemAt n.children 0)
                if ((strlen sel.value) == 0) {
                    sel.value = (first2.elementId())
                }
            }
            sel.name = n.label
            sel.build()
            RaveBind.decorate(sel)
            def root3:EVGElement (unwrap sel.rootEl)
            UiTree.addClass(root3 (n.cls()))
            return root3
        }
        if (n.component == "Input") {
            def inp:InputCtl (b.input(id))
            inp.name = n.label
            inp.placeholder = n.placeholder
            inp.build()
            RaveBind.decorate(inp)
            ; The glyphs and the caret are the field's drawing, not its name:
            ; an input with no label is unnamed even while it shows a
            ; placeholder, which is what a reader would find too.
            def glyphs:EVGElement (unwrap inp.textEl)
            glyphs.a11yHidden = true
            def caret:EVGElement (unwrap inp.caretEl)
            caret.a11yHidden = true
            def root4:EVGElement (unwrap inp.rootEl)
            UiTree.addClass(root4 (n.cls()))
            return root4
        }
        if (n.component == "Button") {
            def bt:ButtonCtl (b.button(id))
            bt.name = n.text
            bt.variant = n.variant
            if ((strlen bt.variant) == 0) {
                bt.variant = "default"
            }
            bt.build()
            RaveBind.decorate(bt)
            def root6:EVGElement (unwrap bt.rootEl)
            UiTree.addClass(root6 (n.cls()))
            return root6
        }
        if (n.component == "Sheet") {
            def sh:SheetCtl (b.sheet(id))
            sh.name = n.text
            sh.title = n.name
            if ((strlen n.variant) > 0) {
                sh.side = n.variant
            }
            sh.build()
            if sh.open {
                def scontent:EVGElement (unwrap sh.contentEl)
                UiTree.clearChildren(scontent)
                scontent.addChild((unwrap sh.titleEl))
                def sbody:EVGElement (EVGElement.createDiv())
                sbody.className = ("rv " + (n.cls()) + "-body")
                sbody.setAttribute("gap" "12px")
                sbody.setAttribute("flex-grow" "1")
                this.childrenInto(sbody n)
                scontent.addChild(sbody)
                scontent.addChild((unwrap sh.closeEl))
            }
            RaveBind.decorate(sh)
            def root7:EVGElement (unwrap sh.rootEl)
            UiTree.addClass(root7 (n.cls()))
            return root7
        }
        if (n.component == "Card") {
            def cd:CardCtl (b.card(id))
            cd.title = n.name
            cd.name = n.name
            cd.body = n.text
            cd.footer = n.label
            cd.build()
            ; the document's children go into the content, after the words
            def ccontent:EVGElement (unwrap cd.contentEl)
            if ((array_length n.children) > 0) {
                UiTree.clearChildren(ccontent)
                ccontent.elementType = 0
                ccontent.textContent = ""
                if ((strlen n.text) > 0) {
                    def lead:EVGElement (EVGElement.createDiv())
                    lead.elementType = 1
                    lead.textContent = n.text
                    lead.role = "paragraph"
                    lead.className = "rv-t ui-card-lead"
                    ccontent.addChild(lead)
                }
                ccontent.setAttribute("gap" "12px")
                this.childrenInto(ccontent n)
            }
            RaveBind.decorate(cd)
            def root8:EVGElement (unwrap cd.rootEl)
            UiTree.addClass(root8 (n.cls()))
            return root8
        }
        if (n.component == "Command") {
            def cm:CommandCtl (b.command(id))
            cm.name = n.text
            clear cm.items
            def q:int 0
            while (q < (array_length n.children)) {
                def opt:RaveNode (itemAt n.children q)
                cm.addItem((opt.elementId()) opt.text false)
                q = (q + 1)
            }
            if ((strlen n.placeholder) > 0) {
                cm.placeholder = n.placeholder
            }
            cm.build()
            RaveBind.decorate(cm)
            def root9:EVGElement (unwrap cm.rootEl)
            UiTree.addClass(root9 (n.cls()))
            return root9
        }
        if (n.component == "Sidebar") {
            def sbar:SidebarCtl (b.sidebar(id))
            sbar.name = n.label
            clear sbar.items
            def w:int 0
            while (w < (array_length n.children)) {
                def place:RaveNode (itemAt n.children w)
                sbar.addItem((place.elementId()) place.text false)
                w = (w + 1)
            }
            sbar.build()
            RaveBind.decorate(sbar)
            def root10:EVGElement (unwrap sbar.rootEl)
            UiTree.addClass(root10 (n.cls()))
            return root10
        }
        def tg:ToggleCtl (b.toggle(id))
        tg.name = n.text
        tg.build()
        RaveBind.decorate(tg)
        def root5:EVGElement (unwrap tg.rootEl)
        UiTree.addClass(root5 (n.cls()))
        return root5
    }

    fn shown:boolean (n:RaveNode) {
        if (n.kind == "conditional") {
            return (auth.allows(n.condition))
        }
        return true
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RaveEditor — Rafi's chrome, over an application instead of a picture
; =============================================================================
; The same rails, tree, stage, inspector, toolbar and strip Rafi draws — every
; one an EVG element laid out by EVGLayout and painted by the same WebGL
; painter the stage is — with three differences, which are the whole product:
;
;   LEFT RAIL    Routes / Components / Layers, not Pages / Layers
;   STAGE        one route at several widths at once, from ONE tree
;   TOP          Design | Run: the same document, running
;
; The stage is the runtime's scene drawn through a camera; the chrome is
; painted over it with the clear switched off, exactly as Rafi paints its
; board. Selection is structural — a node, highlighted in every viewport —
; and the gestures are reorder, reparent and insert, because a flex/grid
; layout has nothing to drag by the corner.
;
; Everything a click can mean goes through `press(id)`, everything a key can
; mean through `keyWith`, and typing through `typeChar`: the headless check
; drives the whole editor through those three doors.
; =============================================================================

Import "RaveDoc.rgr"
Import "RaveRuntime.rgr"
Import "RavePatterns.rgr"
Import "RaveOps.rgr"
Import "RaveKit.rgr"
Import "RaveImport.rgr"
Import "RaveText.rgr"
Import "../../figma/src/FigParser.rgr"
Import "../../figma/src/convert/FigToScene.rgr"
Import "RaveA11y.rgr"
Import "RaveCss.rgr"
Import "RaveBuild.rgr"
Import "RaveFields.rgr"
Import "../../ui/src/InputCtl.rgr"
Import "../../evg/EVGTextEngine.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGA11yFromTree.rgr"
Import "../../evg/EVGHitTest.rgr"

class RaveEditor {
    def doc:RaveApp (new RaveApp("app"))
    def rt@(optional):RaveRuntime
    def edit@(optional):RaveEdit
    def sheet@(optional):EVGStyleSheet
    def layout@(optional):EVGLayout
    def root@(optional):EVGElement
    def boardEl@(optional):EVGElement
    def builtW:double 0.0
    def builtH:double 0.0
    def dirty:boolean true
    def pageW:double 1440.0
    def pageH:double 860.0
    def hovered:string ""
    def pressed:string ""
    def focused:string ""

    ; design | run
    def mode:string "design"
    ; routes | components | layers
    def leftPane:string "layers"
    ; design | css | a11y
    def rightPane:string "design"
    ; the selected node, 0 for none
    def selected:int 0
    ; the inspector's breakpoint: base | sm | md | lg
    def bp:string "base"
    def folded:[string:boolean]
    ; the camera over the scene, relative to the board's corner
    def viewX:double 40.0
    def viewY:double 40.0
    def zoom:double 0.5
    def needFit:boolean true
    ; the board's box, read back from the layout every frame
    def bx:double 0.0
    def by:double 0.0
    def bw:double 0.0
    def bh:double 0.0
    ; the view the keyboard talks to in Run, and the one the A11y pane shows
    def activeView:int 0
    ; the field being edited: "field:<prop>", "node:<kind>", "css:<i>"
    def editing:string ""
    ; text | length — how the field is edited
    def editKind:string ""
    ; the text model while editing: value, caret, anchor, word motion —
    ; gallery/ui's own, so a caret here behaves as one in a form does
    def input:InputCtl (new InputCtl())
    ; the unit half of a length field
    def unit:string ""
    ; the value before this edit, for Escape
    def editOriginal:string ""
    ; bumped per edit so live changes coalesce into one undo step
    def session:int 0
    ; the choice list that is open, and the row the keys are on
    def openMenu:string ""
    def menuActive:int 0
    ; a drag in progress: selecting text in a field, or dragging a track
    def textDrag:string ""
    def scrub:string ""
    ; a node picked up for a drop
    def dragging:int 0
    def showTabOrder:boolean false
    ; --- File → New, as a sheet rather than a blank canvas ---------------------
    ; Four questions, and the answer is an application from RavePatterns. The
    ; sheet is over the editor rather than beside it because nothing else is
    ; answerable while it is up.
    def wizardOpen:boolean false
    def wizName:string "Untitled"
    def wizAuth:boolean true
    ; sidebar | topbar | tabs | none
    def wizNav:string "sidebar"
    ; dashboard | marketing | masterdetail | crud | settings | empty
    def wizStart:string "dashboard"
    ; What the last Figma import worked out, and what it had to guess. Kept
    ; because an import is a reading of somebody's file and the reading is
    ; the thing worth checking.
    def importReport:RaveImportReport (new RaveImportReport())
    ; --- the AI menu -----------------------------------------------------------
    ; There is no service call anywhere in Rave. The menu writes a prompt — the
    ; format, the thing as it stands, and what is wanted — to be pasted
    ; somewhere else, and reads back a document in the same format. A person
    ; is the transport, which is why the prompt has to say everything and the
    ; reader has to be strict.
    def aiOpen:boolean false
    ; document | page | node
    def aiScope:string "document"
    def aiAsk:string ""
    def aiStatus:string ""
    def aiErrors:[string]
    ; errors past the few the sheet shows
    def aiMore:int 0
    def wizWeb:boolean true
    def wizDesktop:boolean false
    def wizTablet:boolean true
    def wizMobile:boolean true
    def lastKey:string ""
    def status:string "ready"
    ; the a11y problems of the active view, gathered once per frame
    def problems:[string]

    Constructor () {
        this.newProject("Acme")
    }

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s
    }

    ; --- the document ---------------------------------------------------------

    fn adopt:void (app:RaveApp) {
        this.adoptWith(app false)
    }

    ; `fromTargets` opens the stage on the widths the wizard was asked for
    ; instead of the three a document arrives with.
    fn adoptWith:void (app:RaveApp fromTargets:boolean) {
        doc = app
        def r (new RaveRuntime(app))
        if fromTargets {
            this.viewsForTargets(r)
        } {
            r.addView("desktop" 1440.0 900.0 false)
            r.addView("tablet" 768.0 1024.0 true)
            r.addView("phone" 390.0 844.0 true)
        }
        rt = r
        def e (new RaveEdit(app))
        edit = e
        selected = 0
        def fresh:[string:boolean]
        folded = fresh
        editing = ""
        dragging = 0
        activeView = 0
        needFit = true
        status = app.name
        dirty = true
    }

    fn newProject:void (name:string) {
        this.adopt((RavePatterns.saasStarter(name)))
    }

    fn openJson:boolean (text:string) {
        def app:RaveApp (RaveApp.fromJson(text))
        if (app.isEmpty()) {
            status = "not a Rave document"
            dirty = true
            return false
        }
        this.adopt(app)
        return true
    }

    fn saveJson:string () {
        return (doc.toJson())
    }

    fn runtime:RaveRuntime () {
        return (unwrap rt)
    }

    fn editor:RaveEdit () {
        return (unwrap edit)
    }

    fn currentRoute:RaveRoute () {
        def r:RaveRuntime (unwrap rt)
        return (doc.routeAt((r.path())))
    }

    fn path:string () {
        def r:RaveRuntime (unwrap rt)
        return (r.path())
    }

    fn selectedId:string () {
        if (selected == 0) {
            return ""
        }
        return ("n" + (to_string selected))
    }

    fn modeNow:string () {
        return mode
    }

    fn setPageSize:void (w:double h:double) {
        if ((w == pageW) && (h == pageH)) {
            return
        }
        pageW = w
        pageH = h
        dirty = true
    }

    ; --- the new-project wizard -------------------------------------------------------

    fn openWizard:boolean () {
        this.commitEdit()
        this.closeMenu()
        wizardOpen = true
        wizName = "Untitled"
        dirty = true
        return true
    }

    fn closeWizard:boolean () {
        if (wizardOpen == false) {
            return false
        }
        if (editing == "wiz:name") {
            this.cancelEdit()
        }
        wizardOpen = false
        dirty = true
        return true
    }

    fn wizardTargets:[string] () {
        def out:[string]
        if wizWeb { push out "web" }
        if wizDesktop { push out "desktop" }
        if wizTablet { push out "tablet" }
        if wizMobile { push out "mobile" }
        if ((array_length out) == 0) {
            push out "web"
        }
        return out
    }

    ; The viewports the stage opens with follow the targets that were ticked,
    ; so the first thing on the screen is the widths this project is for.
    fn viewsForTargets:void (r:RaveRuntime) {
        this.viewsFrom(r (this.wizardTargets()))
    }

    fn viewsFrom:void (r:RaveRuntime targets:[string]) {
        def i:int 0
        while (i < (array_length targets)) {
            def t:string (itemAt targets i)
            if (t == "desktop") { r.addView("desktop" 1920.0 1080.0 false) }
            if (t == "web") { r.addView("web" 1440.0 900.0 false) }
            if (t == "tablet") { r.addView("tablet" 768.0 1024.0 true) }
            if (t == "mobile") { r.addView("phone" 390.0 844.0 true) }
            i = (i + 1)
        }
        if ((r.viewCount()) == 0) {
            r.addView("web" 1440.0 900.0 false)
        }
    }

    ; --- File → Import ---------------------------------------------------------

    ; A `.fig` file, read as an application. The bytes come from the page's
    ; file picker; everything after that is RaveImport's reading of them, and
    ; the report it wrote is what the Import tab shows.
    fn importFig:boolean (bytes:buffer name:string) {
        def parser (new FigParser())
        def doc:FigDoc (parser.parseBytes(bytes name))
        if (doc.ok == false) {
            status = ("not a Figma file: " + doc.err)
            dirty = true
            return false
        }
        def conv (new FigToScene())
        def scene:SceneDocument (conv.convertDoc(doc))
        def imp (new RaveImport())
        def app:RaveApp (imp.run(scene))
        if (app.isEmpty()) {
            status = "nothing in that file to import"
            dirty = true
            return false
        }
        importReport = imp.report
        this.adoptImported(app)
        status = (imp.report.summary())
        if ((importReport.noteCount()) > 0) {
            rightPane = "import"
        }
        return true
    }

    fn adoptImported:void (app:RaveApp) {
        doc = app
        def r (new RaveRuntime(app))
        this.viewsFrom(r app.targets)
        rt = r
        def e (new RaveEdit(app))
        edit = e
        selected = 0
        def fresh:[string:boolean]
        folded = fresh
        editing = ""
        dragging = 0
        activeView = 0
        needFit = true
        dirty = true
    }

    fn importNoteCount:int () {
        return (importReport.noteCount())
    }

    fn importNoteAt:string (i:int) {
        return (importReport.noteAt(i))
    }

    fn importSummary:string () {
        return (importReport.summary())
    }

    fn wizardPress:boolean (what:string) {
        if (what == "cancel") {
            return (this.closeWizard())
        }
        if (what == "create") {
            def name:string (trim wizName)
            if ((strlen name) == 0) {
                name = "Untitled"
            }
            def app:RaveApp (RavePatterns.fromChoices(name wizStart wizNav wizAuth (this.wizardTargets())))
            wizardOpen = false
            this.adoptWith(app true)
            return true
        }
        if (what == "auth") {
            wizAuth = (wizAuth == false)
            dirty = true
            return true
        }
        if (what == "name") {
            return (this.startEdit("wiz:name"))
        }
        if (RaveEditor.hasPrefix(what "nav:")) {
            wizNav = (RaveEditor.tail(what 4))
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(what "start:")) {
            wizStart = (RaveEditor.tail(what 6))
            dirty = true
            return true
        }
        if (what == "t:web") {
            wizWeb = (wizWeb == false)
            dirty = true
            return true
        }
        if (what == "t:desktop") {
            wizDesktop = (wizDesktop == false)
            dirty = true
            return true
        }
        if (what == "t:tablet") {
            wizTablet = (wizTablet == false)
            dirty = true
            return true
        }
        if (what == "t:mobile") {
            wizMobile = (wizMobile == false)
            dirty = true
            return true
        }
        return false
    }

    ; --- the AI menu ------------------------------------------------------------

    fn openAi:boolean () {
        this.commitEdit()
        this.closeMenu()
        aiOpen = true
        aiStatus = ""
        clear aiErrors
        if ((this.hasSelection()) == false) {
            if (aiScope == "node") {
                aiScope = "page"
            }
        }
        dirty = true
        return true
    }

    fn closeAi:boolean () {
        if (aiOpen == false) {
            return false
        }
        if (editing == "ai:ask") {
            this.commitEdit()
        }
        aiOpen = false
        dirty = true
        return true
    }

    ; The thing the prompt is about, in the format the prompt describes.
    fn aiBody:string () {
        if (aiScope == "node") {
            if (this.hasSelection()) {
                return (RaveText.writeNode(doc (this.selectedNode())))
            }
            return ""
        }
        if (aiScope == "page") {
            def route:RaveRoute (this.currentRoute())
            if (doc.hasNode(route.pageId)) {
                return (RaveText.writePage(doc (doc.node(route.pageId))))
            }
            return ""
        }
        return (RaveText.writeApp(doc))
    }

    ; What goes on the clipboard.
    fn aiPrompt:string () {
        return (RaveText.prompt(doc aiScope (this.aiBody()) aiAsk))
    }

    fn aiErrorCount:int () {
        return (array_length aiErrors)
    }

    fn aiErrorAt:string (i:int) {
        return (itemAt aiErrors i)
    }

    fn aiNote:string () {
        return aiStatus
    }

    ; Whether the page should hand a paste over: only while the sheet is up.
    fn aiIsOpen:boolean () {
        return aiOpen
    }

    fn takeErrors:void (reader:RaveTextReader) {
        clear aiErrors
        aiMore = (reader.moreCount())
        def i:int 0
        while (i < (reader.errorCount())) {
            push aiErrors (reader.errorAt(i))
            i = (i + 1)
        }
    }

    ; A response, read back. A document with a single error is refused
    ; outright: half-applying something that came from elsewhere is how a
    ; document quietly stops being the one that was designed.
    fn applyAiText:boolean (text:string) {
        clear aiErrors
        aiMore = 0
        aiStatus = ""
        if ((strlen (trim text)) == 0) {
            push aiErrors "nothing was pasted"
            dirty = true
            return false
        }
        if (aiScope == "document") {
            def reader (new RaveTextReader())
            def parsed:RaveApp (reader.readDoc(text))
            this.takeErrors(reader)
            if ((reader.errorCount()) > 0) {
                dirty = true
                return false
            }
            if (parsed.isEmpty()) {
                if (reader.looksLikeOnePage()) {
                    ; the answer is one page, and the menu is on the document:
                    ; say so and put the menu where the answer belongs, so the
                    ; same paste works the second time
                    aiScope = "page"
                    push aiErrors "that answer is one page, not a whole document — About is now set to This page, so paste it again"
                } {
                    push aiErrors "that document has no routes, so there is nothing to show"
                }
                dirty = true
                return false
            }
            this.adopt(parsed)
            aiOpen = false
            aiStatus = "the document was replaced"
            status = aiStatus
            return true
        }
        def reader2 (new RaveTextReader())
        ; the answer is read against THIS document's breakpoints, so `<media
        ; below="md"/>` in it means the same width it means everywhere else
        reader2.useBreakpointsOf(doc)
        def frag:RaveApp (reader2.readFragment(text))
        if (reader2.looksWhole()) {
            ; A WHOLE DOCUMENT, PASTED INTO ONE PAGE. Reading it as a page
            ; produces an error for every route that cannot find a page that
            ; was never made — ten complaints about a mistake that is one
            ; sentence. Say the sentence, and put the menu where the answer
            ; belongs so the same paste lands the second time.
            clear aiErrors
            aiMore = 0
            aiScope = "document"
            push aiErrors "that answer is a whole document — About is now set to The whole document, so paste it again"
            dirty = true
            return false
        }
        this.takeErrors(reader2)
        if ((reader2.errorCount()) > 0) {
            dirty = true
            return false
        }
        if ((array_length frag.pages) == 0) {
            push aiErrors "nothing in that answer was a node"
            dirty = true
            return false
        }
        def holder:RaveNode (itemAt frag.pages 0)
        def incoming:[RaveNode] holder.children
        if ((array_length incoming) == 0) {
            push aiErrors "that answer had no nodes in it"
            dirty = true
            return false
        }
        def e:RaveEdit (unwrap edit)
        RaveText.mergeShared(frag doc)
        if (aiScope == "node") {
            if ((this.hasSelection()) == false) {
                push aiErrors "nothing is selected, so there is no node to replace"
                dirty = true
                return false
            }
            def old:int selected
            def parent:int (doc.parentOf(old))
            if (parent == 0) {
                push aiErrors "a page or a layout is not replaced one node at a time — use Page or Document"
                dirty = true
                return false
            }
            def at:int (doc.indexIn(parent old))
            e.begin()
            e.remove(old)
            def made:int 0
            def i:int 0
            while (i < (array_length incoming)) {
                def copy:RaveNode (RaveText.copyNode(frag doc (itemAt incoming i)))
                e.insert(copy parent (at + i))
                made = copy.id
                i = (i + 1)
            }
            e.end()
            selected = made
            aiOpen = false
            aiStatus = ((to_string (array_length incoming)) + " nodes replaced the selection")
            status = aiStatus
            this.changed()
            return true
        }
        ; the page
        def route:RaveRoute (this.currentRoute())
        if ((doc.hasNode(route.pageId)) == false) {
            push aiErrors "this route has no page"
            dirty = true
            return false
        }
        def page:RaveNode (doc.node(route.pageId))
        ; the answer's own page rule becomes this page's
        RaveText.copyRules(frag doc (holder.cls()) (page.cls()))
        e.begin()
        while ((array_length page.children) > 0) {
            def gone:RaveNode (itemAt page.children 0)
            e.remove(gone.id)
        }
        def j:int 0
        while (j < (array_length incoming)) {
            def copy2:RaveNode (RaveText.copyNode(frag doc (itemAt incoming j)))
            e.insert(copy2 page.id (0 - 1))
            j = (j + 1)
        }
        e.end()
        selected = 0
        aiOpen = false
        aiStatus = ((to_string (array_length incoming)) + " nodes replaced the page")
        status = aiStatus
        this.changed()
        return true
    }

    fn aiPress:boolean (what:string) {
        if (what == "open") {
            return (this.openAi())
        }
        if (what == "close") {
            return (this.closeAi())
        }
        if (what == "copied") {
            clear aiErrors
            aiStatus = "prompt copied — paste it where you like, then bring the answer back"
            dirty = true
            return true
        }
        if (what == "ask") {
            return (this.startEdit("ai:ask"))
        }
        if (RaveEditor.hasPrefix(what "scope:")) {
            def which:string (RaveEditor.tail(what 6))
            if ((which == "node") && ((this.hasSelection()) == false)) {
                clear aiErrors
                push aiErrors "select a node on the stage or in Layers first"
                dirty = true
                return true
            }
            aiScope = which
            clear aiErrors
            dirty = true
            return true
        }
        ; copy and paste are the page's business: a canvas has no clipboard
        return false
    }

    ; --- the breakpoint the inspector edits ------------------------------------------

    fn mediaFor:string (key:string) {
        if (key == "sm") {
            return (doc.below("md"))
        }
        if (key == "md") {
            return ((doc.from("md")) + " and " + (doc.below("lg")))
        }
        if (key == "lg") {
            return (doc.from("lg"))
        }
        return ""
    }

    fn media:string () {
        return (this.mediaFor(bp))
    }

    fn keyForMedia:string (m:string) {
        if (m == (this.mediaFor("sm"))) { return "sm" }
        if (m == (this.mediaFor("md"))) { return "md" }
        if (m == (this.mediaFor("lg"))) { return "lg" }
        if ((strlen m) == 0) { return "base" }
        return m
    }

    ; --- input ----------------------------------------------------------------

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn hover:boolean (px:double py:double) {
        def id:string (this.hitId(px py))
        if (id == hovered) {
            return false
        }
        hovered = id
        return true
    }

    fn pointerDown:boolean (px:double py:double) {
        return (this.pointerDownWith(px py false))
    }

    ; A press with Shift: inside a field's text it extends the selection to
    ; the point, the way it does in a form.
    fn pointerDownWith:boolean (px:double py:double shift:boolean) {
        def id:string (this.hitId(px py))
        if ((strlen id) == 0) {
            if ((strlen openMenu) > 0) {
                this.closeMenu()
                return true
            }
            return false
        }
        if (id == "board") {
            if ((strlen openMenu) > 0) {
                this.closeMenu()
            }
            return (this.clickBoard(px py))
        }
        if (RaveEditor.hasPrefix(id "in:")) {
            def fid:string (RaveEditor.tail(id 3))
            if (editing != fid) {
                this.startEdit(fid)
            }
            this.caretAt(fid px shift)
            textDrag = fid
            return true
        }
        if (RaveEditor.hasPrefix(id "track:")) {
            def fid2:string (RaveEditor.tail(id 6))
            if (editing != fid2) {
                this.startEdit(fid2)
            }
            scrub = fid2
            this.scrubTo(px)
            return true
        }
        return (this.press(id))
    }

    ; The pointer moved with the button down: a selection being dragged out,
    ; or a track thumb being pulled.
    fn pointerMove:boolean (px:double py:double) {
        if ((strlen textDrag) > 0) {
            this.caretAt(textDrag px true)
            return true
        }
        if ((strlen scrub) > 0) {
            this.scrubTo(px)
            return true
        }
        return false
    }

    fn pointerUp:boolean () {
        def had:boolean (((strlen textDrag) > 0) || ((strlen scrub) > 0))
        textDrag = ""
        scrub = ""
        return had
    }

    fn findChromeEl@(optional):EVGElement (el:EVGElement id:string) {
        if (el.id == id) {
            def found@(optional):EVGElement el
            return found
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            def kid@(optional):EVGElement (this.findChromeEl((el.getChild(i)) id))
            if kid {
                return kid
            }
            i = (i + 1)
        }
        def miss@(optional):EVGElement
        return miss
    }

    fn textEngine:EVGTextEngine () {
        this.laidOut()
        def lay:EVGLayout (unwrap layout)
        return (lay.getTextEngine())
    }

    ; Put the caret where a press landed in the field's text, measured with
    ; the engine that paints it.
    fn caretAt:void (fid:string px:double extend:boolean) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (this.findChromeEl(r ("in:" + fid)))
        if (null? found) {
            return
        }
        def box:EVGElement (unwrap found)
        def eng:EVGTextEngine (this.textEngine())
        def at:int (input.indexAtX(eng (px - box.calculatedX)))
        input.placeCaret(at extend)
        dirty = true
    }

    ; The track under a length field: the pointer's fraction across it is
    ; the value, snapped to the unit's step.
    fn scrubTo:void (px:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (this.findChromeEl(r ("track:" + scrub)))
        if (null? found) {
            return
        }
        def box:EVGElement (unwrap found)
        if (box.calculatedWidth < 1.0) {
            return
        }
        def frac:double ((px - box.calculatedX) / box.calculatedWidth)
        if (frac < 0.0) { frac = 0.0 }
        if (frac > 1.0) { frac = 1.0 }
        def prop:string (RaveEditor.propOf(scrub))
        def top:double (RaveFields.trackMax(unit prop))
        def step:double (RaveFields.trackStep(unit))
        def v:double ((frac * top) / step)
        v = ((to_double (to_int (v + 0.5))) * step)
        input.setValue((RaveFields.fromNumber(v)))
        input.placeCaret((strlen input.value) false)
        this.applyLength()
    }

    fn sceneX:double (px:double) {
        return (((px - bx) - viewX) / zoom)
    }

    fn sceneY:double (py:double) {
        return (((py - by) - viewY) / zoom)
    }

    ; A click on the stage: in Run it is the app's, in Design it selects the
    ; node under it — or drops the node being carried onto it.
    fn clickBoard:boolean (px:double py:double) {
        def r:RaveRuntime (unwrap rt)
        def sx:double (this.sceneX(px))
        def sy:double (this.sceneY(py))
        def vi:int (r.viewAt(sx sy))
        if (vi >= 0) {
            activeView = vi
        }
        if (mode == "run") {
            def did:boolean (r.pressAtScene(sx sy))
            dirty = true
            return true
        }
        def id:string (r.sceneHit(sx sy))
        def nid:int (RaveApp.idOfElement(id))
        if (dragging > 0) {
            return (this.dropOn(nid))
        }
        this.select(nid)
        return true
    }

    ; The host's drop after a pointer drag on the stage.
    fn dropAt:boolean (px:double py:double) {
        if (dragging == 0) {
            return false
        }
        def r:RaveRuntime (unwrap rt)
        def id:string (r.sceneHit((this.sceneX(px)) (this.sceneY(py))))
        return (this.dropOn((RaveApp.idOfElement(id))))
    }

    fn select:void (nid:int) {
        if (nid > 0) {
            if ((doc.hasNode(nid)) == false) {
                nid = 0
            }
        }
        if (nid != selected) {
            this.commitEdit()
            this.closeMenu()
        }
        selected = nid
        dirty = true
    }

    fn panBy:void (dx:double dy:double) {
        viewX = (viewX + dx)
        viewY = (viewY + dy)
        dirty = true
    }

    fn wheel:boolean (px:double py:double dy:double) {
        if (this.insideBoard(px py) == false) {
            return false
        }
        def k:double 1.1
        if (dy > 0.0) {
            k = (1.0 / 1.1)
        }
        this.zoomAt(px py (zoom * k))
        return true
    }

    fn zoomAt:void (px:double py:double want:double) {
        def z:double want
        if (z < 0.05) {
            z = 0.05
        }
        if (z > 4.0) {
            z = 4.0
        }
        def lx:double (px - bx)
        def ly:double (py - by)
        def sx:double ((lx - viewX) / zoom)
        def sy:double ((ly - viewY) / zoom)
        zoom = z
        viewX = (lx - (sx * zoom))
        viewY = (ly - (sy * zoom))
        dirty = true
    }

    fn insideBoard:boolean (px:double py:double) {
        if ((px < bx) || (px > (bx + bw))) {
            return false
        }
        if ((py < by) || (py > (by + bh))) {
            return false
        }
        return true
    }

    ; Every viewport on the stage at once, with room for their labels.
    fn fit:void () {
        this.laidOut()
        if (bw < 1.0) {
            return
        }
        def r:RaveRuntime (unwrap rt)
        r.ensure()
        def zx:double ((bw - 48.0) / r.sceneW)
        def zy:double ((bh - 72.0) / r.sceneH)
        def z:double zx
        if (zy < z) {
            z = zy
        }
        if (z > 1.0) {
            z = 1.0
        }
        if (z < 0.05) {
            z = 0.05
        }
        zoom = z
        viewX = ((bw - (r.sceneW * zoom)) * 0.5)
        viewY = 40.0
        needFit = false
        dirty = true
    }

    fn zoom100:void () {
        this.zoomAt((bx + (bw * 0.5)) (by + (bh * 0.5)) 1.0)
    }

    ; --- commands -------------------------------------------------------------

    sfn hasPrefix:boolean (s:string p:string) {
        if ((strlen s) < (strlen p)) {
            return false
        }
        return ((substring s 0 (strlen p)) == p)
    }

    sfn tail:string (s:string n:int) {
        return (substring s n (strlen s))
    }

    sfn tailInt:int (s:string n:int) {
        def digits:string (substring s n (strlen s))
        def value:int 0
        def i:int 0
        while (i < (strlen digits)) {
            def c:int (charAt digits i)
            if ((c < 48) || (c > 57)) {
                return 0
            }
            value = ((value * 10) + (c - 48))
            i = (i + 1)
        }
        return value
    }

    fn press:boolean (id:string) {
        def r:RaveRuntime (unwrap rt)
        if (RaveEditor.hasPrefix(id "tab:")) {
            def which:string (RaveEditor.tail(id 4))
            if ((which == "routes") || (which == "components") || (which == "layers")) {
                leftPane = which
            } {
                rightPane = which
            }
            dirty = true
            return true
        }
        if (id == "mode:design") {
            mode = "design"
            dirty = true
            return true
        }
        if (id == "mode:run") {
            mode = "run"
            this.cancelEdit()
            dragging = 0
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(id "route:")) {
            def to:string (RaveEditor.tail(id 6))
            if (mode == "run") {
                r.navigate(to)
            } {
                r.jump(to)
            }
            selected = 0
            dirty = true
            return true
        }
        if (id == "nav:back") {
            def moved:boolean (r.back())
            dirty = true
            return moved
        }
        if (id == "auth:toggle") {
            r.setLoggedIn((r.auth.loggedIn == false))
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(id "theme:")) {
            def t:string (RaveEditor.tail(id 6))
            if (t == "light") {
                t = ""
            }
            r.setTheme(t)
            dirty = true
            return true
        }
        if (id == "a11y:taborder") {
            showTabOrder = (showTabOrder == false)
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(id "vp:")) {
            activeView = (RaveEditor.tailInt(id 3))
            dirty = true
            return true
        }
        if (id == "zoom:in") {
            this.zoomAt((bx + (bw * 0.5)) (by + (bh * 0.5)) (zoom * 1.25))
            return true
        }
        if (id == "zoom:out") {
            this.zoomAt((bx + (bw * 0.5)) (by + (bh * 0.5)) (zoom / 1.25))
            return true
        }
        if (id == "zoom:100") {
            this.zoom100()
            return true
        }
        if (id == "fit") {
            this.fit()
            return true
        }
        if (id == "file:new") {
            return (this.openWizard())
        }
        if (RaveEditor.hasPrefix(id "wiz:")) {
            return (this.wizardPress((RaveEditor.tail(id 4))))
        }
        if (RaveEditor.hasPrefix(id "ai:")) {
            return (this.aiPress((RaveEditor.tail(id 3))))
        }
        ; the tree
        if (RaveEditor.hasPrefix(id "tree:")) {
            def nid:int (RaveEditor.tailInt(id 5))
            if (dragging > 0) {
                return (this.dropOn(nid))
            }
            this.select(nid)
            return true
        }
        if (RaveEditor.hasPrefix(id "fold:")) {
            def fid:string (RaveEditor.tail(id 5))
            if (this.isFolded(fid)) {
                set folded fid false
            } {
                set folded fid true
            }
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(id "pick:")) {
            dragging = (RaveEditor.tailInt(id 5))
            status = "carrying a node: click where it goes"
            dirty = true
            return true
        }
        if (id == "dropcancel") {
            dragging = 0
            status = doc.name
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(id "drop:")) {
            return (this.dropBefore((RaveEditor.tailInt(id 5))))
        }
        if (RaveEditor.hasPrefix(id "dropin:")) {
            return (this.dropInto((RaveEditor.tailInt(id 7))))
        }
        ; editing the tree
        if (RaveEditor.hasPrefix(id "add:")) {
            return (this.addKind((RaveEditor.tail(id 4))))
        }
        if (id == "del") { return (this.deleteSelected()) }
        if (id == "dup") { return (this.duplicateSelected()) }
        if (id == "wrap") { return (this.wrapSelected()) }
        if (id == "up") { return (this.nudge((0 - 1))) }
        if (id == "down") { return (this.nudge(1)) }
        if (id == "out") { return (this.moveOut()) }
        if (id == "in") { return (this.moveIn()) }
        if (id == "undo") { return (this.undo()) }
        if (id == "redo") { return (this.redo()) }
        ; the inspector
        if (RaveEditor.hasPrefix(id "bp:")) {
            bp = (RaveEditor.tail(id 3))
            this.cancelEdit()
            dirty = true
            return true
        }
        if (RaveEditor.hasPrefix(id "opt:")) {
            return (this.pick((RaveEditor.tailInt(id 4))))
        }
        if (RaveEditor.hasPrefix(id "field:")) {
            if ((this.fieldKind(id)) == "choice") {
                return (this.toggleMenu(id))
            }
            if (this.startEdit(id)) {
                input.selectAll()
                dirty = true
                return true
            }
            return false
        }
        if (RaveEditor.hasPrefix(id "node:")) {
            if (this.startEdit(id)) {
                input.selectAll()
                dirty = true
                return true
            }
            return false
        }
        if (RaveEditor.hasPrefix(id "css:")) {
            if (this.startEdit(id)) {
                input.placeCaret((strlen input.value) false)
                dirty = true
                return true
            }
            return false
        }
        if (RaveEditor.hasPrefix(id "unit:")) {
            def fid:string (RaveEditor.tail(id 5))
            if (editing != fid) {
                this.startEdit(fid)
            }
            return (this.toggleMenu(id))
        }
        if (RaveEditor.hasPrefix(id "dec:")) {
            return (this.stepField((RaveEditor.tail(id 4)) (0.0 - 1.0)))
        }
        if (RaveEditor.hasPrefix(id "inc:")) {
            return (this.stepField((RaveEditor.tail(id 4)) 1.0))
        }
        if (id == "menu:close") {
            this.closeMenu()
            return true
        }
        if (RaveEditor.hasPrefix(id "clear:")) {
            return (this.clearProp((RaveEditor.tail(id 6))))
        }
        if (id == "commit") {
            return (this.commitEdit())
        }
        if (id == "cancel") {
            this.cancelEdit()
            return true
        }
        return false
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        lastKey = k
        if ((strlen openMenu) > 0) {
            return (this.menuKey(k))
        }
        if ((strlen editing) > 0) {
            return (this.editKey(k shift ctrl))
        }
        if aiOpen {
            if (k == "Escape") {
                return (this.closeAi())
            }
            return false
        }
        ; Nothing behind the sheet is answerable while it is up, in either
        ; mode: Escape puts it away, Enter takes the answers.
        if wizardOpen {
            if (k == "Escape") {
                return (this.closeWizard())
            }
            if (k == "Enter") {
                return (this.wizardPress("create"))
            }
            return false
        }
        if (mode == "run") {
            def r:RaveRuntime (unwrap rt)
            def did:boolean (r.keyWith(activeView k shift ctrl))
            if did {
                lastKey = (k + " → " + (r.focusedId(activeView)))
                dirty = true
            } {
                lastKey = (k + " (not handled)")
            }
            return did
        }
        if (k == "Escape") {
            if (dragging > 0) {
                return (this.press("dropcancel"))
            }
            this.select(0)
            return true
        }
        if ((k == "Delete") || (k == "Backspace")) {
            return (this.deleteSelected())
        }
        if (ctrl && (k == "z")) {
            if shift {
                return (this.redo())
            }
            return (this.undo())
        }
        if (ctrl && (k == "y")) {
            return (this.redo())
        }
        if (ctrl && (k == "d")) {
            return (this.duplicateSelected())
        }
        if (ctrl && (k == "g")) {
            return (this.wrapSelected())
        }
        if (ctrl && (k == "ArrowUp")) {
            return (this.nudge((0 - 1)))
        }
        if (ctrl && (k == "ArrowDown")) {
            return (this.nudge(1))
        }
        if (ctrl && (k == "ArrowLeft")) {
            return (this.moveOut())
        }
        if (ctrl && (k == "ArrowRight")) {
            return (this.moveIn())
        }
        if ((k == "1") && shift) {
            return (this.press("fit"))
        }
        if (k == "0") {
            return (this.press("zoom:100"))
        }
        if ((k == "+") || (k == "=")) {
            return (this.press("zoom:in"))
        }
        if ((k == "-") || (k == "_")) {
            return (this.press("zoom:out"))
        }
        return false
    }

    fn typeChar:boolean (ch:string) {
        if ((strlen openMenu) > 0) {
            return false
        }
        if ((strlen editing) == 0) {
            return false
        }
        def before:string input.value
        if ((input.typeChar("f" ch)) == false) {
            return false
        }
        ; A number half filters what it takes: a letter typed at it changes
        ; nothing, and says so, rather than landing in the value as "24p".
        if (input.value == before) {
            return false
        }
        if (editKind == "length") {
            this.applyLength()
        }
        dirty = true
        return true
    }

    ; A key in a field: the text model takes the caret, the selection and
    ; the edits; a length field also steps on the arrows and applies live.
    fn editKey:boolean (k:string shift:boolean ctrl:boolean) {
        if (k == "Enter") {
            return (this.commitEdit())
        }
        if (k == "Escape") {
            this.cancelEdit()
            return true
        }
        if (k == "Tab") {
            this.commitEdit()
            return true
        }
        if (editKind == "length") {
            if ((k == "ArrowUp") || (k == "ArrowDown")) {
                def dir:double 1.0
                if (k == "ArrowDown") {
                    dir = (0.0 - 1.0)
                }
                if shift {
                    dir = (dir * 10.0)
                }
                return (this.stepField(editing dir))
            }
        }
        def known:boolean false
        if (k == "ArrowLeft") { known = true }
        if (k == "ArrowRight") { known = true }
        if (k == "Home") { known = true }
        if (k == "End") { known = true }
        if (k == "Backspace") { known = true }
        if (k == "Delete") { known = true }
        if ((k == "a") && ctrl) { known = true }
        if ((ctrl == false) && ((strlen k) == 1)) { known = true }
        if (known == false) {
            return false
        }
        input.keyDownWith("f" k shift ctrl)
        if (editKind == "length") {
            this.applyLength()
        }
        dirty = true
        return true
    }

    ; --- choice lists -------------------------------------------------------------------

    fn menuOptions:[string] () {
        if (RaveEditor.hasPrefix(openMenu "unit:")) {
            return (RaveFields.units((RaveEditor.propOf((RaveEditor.tail(openMenu 5))))))
        }
        def prop:string (RaveEditor.propOf(openMenu))
        if (prop == "action") {
            return (this.actionChoices())
        }
        return (RaveFields.options(prop))
    }

    ; What the open list's field says right now, to mark the row.
    fn menuCurrent:string () {
        if (RaveEditor.hasPrefix(openMenu "unit:")) {
            return unit
        }
        def prop:string (RaveEditor.propOf(openMenu))
        if (prop == "action") {
            def n:RaveNode (this.selectedNode())
            return (this.actionText(n))
        }
        return (this.valueOf(prop))
    }

    fn toggleMenu:boolean (id:string) {
        if (openMenu == id) {
            this.closeMenu()
            return true
        }
        if ((this.hasSelection()) == false) {
            return false
        }
        openMenu = id
        def opts:[string] (this.menuOptions())
        menuActive = (RaveFields.positionOf(opts (this.menuCurrent())))
        if (menuActive < 0) {
            menuActive = 0
        }
        dirty = true
        return true
    }

    fn closeMenu:void () {
        if ((strlen openMenu) > 0) {
            openMenu = ""
            dirty = true
        }
    }

    fn menuKey:boolean (k:string) {
        if (k == "Escape") {
            this.closeMenu()
            return true
        }
        def opts:[string] (this.menuOptions())
        def n:int (array_length opts)
        if (k == "ArrowDown") {
            menuActive = (menuActive + 1)
            if (menuActive >= n) {
                menuActive = 0
            }
            dirty = true
            return true
        }
        if (k == "ArrowUp") {
            menuActive = (menuActive - 1)
            if (menuActive < 0) {
                menuActive = (n - 1)
            }
            dirty = true
            return true
        }
        if ((k == "Enter") || (k == " ")) {
            return (this.pick(menuActive))
        }
        return false
    }

    ; A row of the open list was chosen.
    fn pick:boolean (i:int) {
        if ((strlen openMenu) == 0) {
            return false
        }
        def opts:[string] (this.menuOptions())
        if ((i < 0) || (i >= (array_length opts))) {
            return false
        }
        def chosen:string (itemAt opts i)
        def which:string openMenu
        openMenu = ""
        dirty = true
        if (RaveEditor.hasPrefix(which "unit:")) {
            unit = chosen
            if ((unit == "auto") == false) {
                if ((strlen input.value) == 0) {
                    input.setValue("0")
                }
            }
            this.applyLength()
            return true
        }
        def prop:string (RaveEditor.propOf(which))
        if (prop == "action") {
            return (this.setActionText(chosen))
        }
        return (this.setStyle(prop chosen))
    }

    ; --- length fields --------------------------------------------------------------------

    ; The number half plus the unit half, applied live and coalesced into
    ; the session's one undo step.
    fn applyLength:boolean () {
        if ((strlen editing) == 0) {
            return false
        }
        def prop:string (RaveEditor.propOf(editing))
        if ((strlen prop) == 0) {
            return false
        }
        def text:string ""
        if (unit == "auto") {
            text = "auto"
        } {
            if ((strlen input.value) > 0) {
                text = ((RaveFields.fromNumber((RaveFields.toNumber(input.value)))) + unit)
            }
        }
        def e:RaveEdit (unwrap edit)
        def n:RaveNode (this.selectedNode())
        def did:boolean (e.setDeclLive((n.cls()) (this.media()) prop text session))
        this.styleChanged()
        return did
    }

    fn stepField:boolean (fid:string dir:double) {
        if (editing != fid) {
            if ((this.startEdit(fid)) == false) {
                return false
            }
        }
        if (editKind != "length") {
            return false
        }
        if (unit == "auto") {
            unit = (itemAt (RaveFields.units((RaveEditor.propOf(fid)))) 0)
        }
        def step:double (RaveFields.trackStep(unit))
        def v:double ((RaveFields.toNumber(input.value)) + (dir * step))
        def prop:string (RaveEditor.propOf(fid))
        if ((v < 0.0) && (prop != "margin")) {
            v = 0.0
        }
        input.setValue((RaveFields.fromNumber(v)))
        input.placeCaret((strlen input.value) false)
        this.applyLength()
        return true
    }

    sfn propOf:string (fid:string) {
        if (RaveEditor.hasPrefix(fid "field:")) {
            return (RaveEditor.tail(fid 6))
        }
        return ""
    }

    ; choice | length | text, for a field id and the value it holds now.
    fn fieldKind:string (fid:string) {
        def prop:string (RaveEditor.propOf(fid))
        if ((strlen prop) == 0) {
            return "text"
        }
        if (RaveFields.isChoice(prop)) {
            return "choice"
        }
        if (RaveFields.isLength(prop)) {
            def v:string (this.valueOf(prop))
            if ((strlen v) == 0) {
                return "length"
            }
            def parsed:RaveLength (RaveFields.parse(v (RaveFields.units(prop))))
            if parsed.ok {
                return "length"
            }
        }
        return "text"
    }

    ; --- editing the tree -------------------------------------------------------------

    fn selectedNode:RaveNode () {
        return (doc.node(selected))
    }

    fn hasSelection:boolean () {
        if (selected == 0) {
            return false
        }
        return (doc.hasNode(selected))
    }

    fn changed:void () {
        def r:RaveRuntime (unwrap rt)
        r.invalidate()
        dirty = true
    }

    fn styleChanged:void () {
        def r:RaveRuntime (unwrap rt)
        r.reloadStyles()
        dirty = true
    }

    ; A kit component goes into the selected container, or after the selected
    ; node, or at the end of the current page.
    fn addKind:boolean (kind:string) {
        if ((RaveKit.isKind(kind)) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def made:RaveNode (RaveKit.create(doc kind))
        def parent:int 0
        def at:int (0 - 1)
        if (this.hasSelection()) {
            def sel:RaveNode (this.selectedNode())
            if ((RaveKit.isContainer(sel)) && (sel.kind != "slot")) {
                parent = selected
            } {
                parent = (doc.parentOf(selected))
                if (parent > 0) {
                    at = ((doc.indexIn(parent selected)) + 1)
                }
            }
        }
        if (parent == 0) {
            def route:RaveRoute (this.currentRoute())
            parent = route.pageId
        }
        e.insert(made parent at)
        selected = made.id
        ; An overlay is on the page only while it is the one that is open, so
        ; a dialog that was just dropped would otherwise vanish the moment it
        ; landed. Open it: what was dropped is what is on the stage.
        if (made.kind == "overlay") {
            def r:RaveRuntime (unwrap rt)
            r.openDialog(made.overlay)
        }
        if (made.kind == "toast") {
            def r2:RaveRuntime (unwrap rt)
            r2.toastText = "Something happened"
            r2.invalidate()
        }
        status = (kind + " added")
        this.changed()
        return true
    }

    fn deleteSelected:boolean () {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def parent:int (doc.parentOf(selected))
        if ((e.remove(selected)) == false) {
            status = "a page or a layout cannot be deleted"
            dirty = true
            return false
        }
        selected = parent
        status = "deleted"
        this.changed()
        return true
    }

    fn duplicateSelected:boolean () {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def made:int (e.duplicate(selected))
        if (made == 0) {
            return false
        }
        selected = made
        status = "duplicated"
        this.changed()
        return true
    }

    fn wrapSelected:boolean () {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def made:int (e.wrap(selected))
        if (made == 0) {
            return false
        }
        selected = made
        status = "wrapped in a container"
        this.changed()
        return true
    }

    fn nudge:boolean (by:int) {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def parent:int (doc.parentOf(selected))
        if (parent == 0) {
            return false
        }
        def at:int (doc.indexIn(parent selected))
        def to:int (at + by)
        if (by > 0) {
            to = (to + 1)
        }
        if ((e.move(selected parent to)) == false) {
            return false
        }
        this.changed()
        return true
    }

    ; Out of its parent, to just after it.
    fn moveOut:boolean () {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def parent:int (doc.parentOf(selected))
        if (parent == 0) {
            return false
        }
        def grand:int (doc.parentOf(parent))
        if (grand == 0) {
            return false
        }
        if ((e.move(selected grand ((doc.indexIn(grand parent)) + 1))) == false) {
            return false
        }
        this.changed()
        return true
    }

    ; Into the sibling before it, as its last child.
    fn moveIn:boolean () {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def parent:int (doc.parentOf(selected))
        if (parent == 0) {
            return false
        }
        def at:int (doc.indexIn(parent selected))
        if (at == 0) {
            return false
        }
        def p:RaveNode (doc.node(parent))
        def prev:RaveNode (itemAt p.children (at - 1))
        if ((RaveKit.isContainer(prev)) == false) {
            return false
        }
        if ((e.moveInto(selected prev.id)) == false) {
            return false
        }
        this.changed()
        return true
    }

    fn dropOn:boolean (nid:int) {
        if (nid == 0) {
            return (this.press("dropcancel"))
        }
        def target:RaveNode (doc.node(nid))
        if ((RaveKit.isContainer(target)) && (target.kind != "slot")) {
            return (this.dropInto(nid))
        }
        return (this.dropBefore(nid))
    }

    fn dropBefore:boolean (nid:int) {
        if (dragging == 0) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def moved:boolean (e.moveBefore(dragging nid))
        selected = dragging
        dragging = 0
        status = doc.name
        this.changed()
        return moved
    }

    fn dropInto:boolean (nid:int) {
        if (dragging == 0) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def moved:boolean (e.moveInto(dragging nid))
        selected = dragging
        dragging = 0
        status = doc.name
        this.changed()
        return moved
    }

    fn undo:boolean () {
        def e:RaveEdit (unwrap edit)
        if ((e.undo()) == false) {
            return false
        }
        this.cancelEdit()
        if (selected > 0) {
            if ((doc.parentOf(selected)) == 0) {
                if ((doc.isRoot(selected)) == false) {
                    selected = 0
                }
            }
        }
        status = "undone"
        this.styleChanged()
        return true
    }

    fn redo:boolean () {
        def e:RaveEdit (unwrap edit)
        if ((e.redo()) == false) {
            return false
        }
        this.cancelEdit()
        status = "redone"
        this.styleChanged()
        return true
    }

    ; --- editing values ----------------------------------------------------------------

    fn valueOf:string (prop:string) {
        if ((this.hasSelection()) == false) {
            return ""
        }
        def n:RaveNode (this.selectedNode())
        if (prop == "action") {
            return (this.actionText(n))
        }
        return (doc.styleOf(n (this.media()) prop))
    }

    fn nodeValue:string (kind:string) {
        if ((this.hasSelection()) == false) {
            return ""
        }
        def n:RaveNode (this.selectedNode())
        if (kind == "name") { return n.name }
        if (kind == "text") { return n.text }
        if (kind == "label") { return n.label }
        if (kind == "placeholder") { return n.placeholder }
        return ""
    }

    ; The current rule's declarations, for the CSS tab.
    fn currentRule:RaveRule () {
        def n:RaveNode (this.selectedNode())
        return (doc.rule((n.cls()) (this.media())))
    }

    fn startEdit:boolean (id:string) {
        ; The wizard's name field is about the sheet, not about a node, so it
        ; is the one field that does not need a selection behind it.
        if ((id != "wiz:name") && (id != "ai:ask")) {
            if ((this.hasSelection()) == false) {
                return false
            }
        }
        if (editing == id) {
            return true
        }
        this.commitEdit()
        this.closeMenu()
        editing = id
        session = (session + 1)
        input.tid = "f"
        input.fontFamily = "Inter"
        input.fontSize = 12.0
        if (RaveEditor.hasPrefix(id "css:")) {
            input.fontFamily = "Menlo"
            input.fontSize = 11.0
        }
        def v:string ""
        if (id == "wiz:name") {
            v = wizName
        }
        if (id == "ai:ask") {
            v = aiAsk
        }
        if (RaveEditor.hasPrefix(id "field:")) {
            v = (this.valueOf((RaveEditor.tail(id 6))))
        }
        if (RaveEditor.hasPrefix(id "node:")) {
            v = (this.nodeValue((RaveEditor.tail(id 5))))
        }
        if (RaveEditor.hasPrefix(id "css:")) {
            def which:string (RaveEditor.tail(id 4))
            if (which != "new") {
                def r:RaveRule (this.currentRule())
                def i:int (RaveEditor.tailInt(id 4))
                if (i < (array_length r.decls)) {
                    def d:RaveDecl (itemAt r.decls i)
                    v = (d.name + ": " + d.value)
                }
            }
        }
        editOriginal = v
        editKind = (this.fieldKind(id))
        if (editKind == "choice") {
            editKind = "text"
        }
        if (editKind == "length") {
            def prop:string (RaveEditor.propOf(id))
            def units:[string] (RaveFields.units(prop))
            def parsed:RaveLength (RaveFields.parse(v units))
            input.kind = "number"
            input.setValue("")
            input.setValue(parsed.number)
            unit = parsed.unit
            if (parsed.ok == false) {
                unit = (itemAt units 0)
            }
        } {
            input.kind = "text"
            input.setValue("")
            input.setValue(v)
        }
        input.placeCaret((strlen input.value) false)
        dirty = true
        return true
    }

    ; Escape: a text field forgets what was typed; a length field, which
    ; applied every step as it went, is put back where it started and the
    ; undo step it was building is dropped.
    fn cancelEdit:void () {
        if ((strlen editing) == 0) {
            return
        }
        if (editKind == "length") {
            def prop:string (RaveEditor.propOf(editing))
            def e:RaveEdit (unwrap edit)
            def n:RaveNode (this.selectedNode())
            e.setDeclLive((n.cls()) (this.media()) prop editOriginal session)
            e.dropTopIfNoop()
            this.styleChanged()
        }
        editing = ""
        editKind = ""
        textDrag = ""
        scrub = ""
        dirty = true
    }

    ; Enter, Tab, or leaving the field: a text field's value is committed
    ; now; a length field has already been applied and only closes.
    fn commitEdit:boolean () {
        if ((strlen editing) == 0) {
            return false
        }
        def id:string editing
        def kind:string editKind
        def value:string (trim input.value)
        editing = ""
        editKind = ""
        textDrag = ""
        scrub = ""
        dirty = true
        if (id == "wiz:name") {
            wizName = value
            return true
        }
        if (id == "ai:ask") {
            aiAsk = value
            return true
        }
        if ((this.hasSelection()) == false) {
            return false
        }
        if (kind == "length") {
            def e0:RaveEdit (unwrap edit)
            e0.dropTopIfNoop()
            return true
        }
        if (RaveEditor.hasPrefix(id "field:")) {
            return (this.setStyle((RaveEditor.tail(id 6)) value))
        }
        if (RaveEditor.hasPrefix(id "node:")) {
            def e:RaveEdit (unwrap edit)
            def did:boolean (e.setField(selected (RaveEditor.tail(id 5)) value))
            this.changed()
            return did
        }
        if (RaveEditor.hasPrefix(id "css:")) {
            return (this.commitCss((RaveEditor.tail(id 4)) value))
        }
        return false
    }

    ; One property of the selected node's rule at the inspector's breakpoint.
    ; An empty value removes the declaration.
    fn setStyle:boolean (prop:string value:string) {
        if ((this.hasSelection()) == false) {
            return false
        }
        def e:RaveEdit (unwrap edit)
        def n:RaveNode (this.selectedNode())
        def did:boolean (e.setDecl((n.cls()) (this.media()) prop value))
        this.styleChanged()
        return did
    }

    fn clearProp:boolean (prop:string) {
        return (this.setStyle(prop ""))
    }

    ; A line of the CSS tab: "name: value" is parsed the way the engine parses
    ; a sheet, so what is typed is what the engine will read. An emptied line
    ; removes the declaration it was.
    fn commitCss:boolean (which:string value:string) {
        def r:RaveRule (this.currentRule())
        def oldName:string ""
        if (which != "new") {
            def i:int (RaveEditor.tailInt(("css:" + which) 4))
            if (i < (array_length r.decls)) {
                def d:RaveDecl (itemAt r.decls i)
                oldName = d.name
            }
        }
        def s:EVGStyleSheet (unwrap sheet)
        def decls:[EVGStyleDecl] (s.parseDeclarations(value))
        def e:RaveEdit (unwrap edit)
        def n:RaveNode (this.selectedNode())
        e.begin()
        def touched:boolean false
        if ((strlen oldName) > 0) {
            def keeps:boolean false
            def j:int 0
            while (j < (array_length decls)) {
                def d2:EVGStyleDecl (itemAt decls j)
                if (d2.name == oldName) {
                    keeps = true
                }
                j = (j + 1)
            }
            if (keeps == false) {
                e.setDecl((n.cls()) (this.media()) oldName "")
                touched = true
            }
        }
        def k:int 0
        while (k < (array_length decls)) {
            def d3:EVGStyleDecl (itemAt decls k)
            if ((strlen d3.name) > 0) {
                e.setDecl((n.cls()) (this.media()) d3.name d3.value)
                touched = true
            }
            k = (k + 1)
        }
        e.end()
        this.styleChanged()
        return touched
    }

    fn actionChoices:[string] () {
        def out:[string]
        push out ""
        def i:int 0
        while (i < (array_length doc.routes)) {
            def r:RaveRoute (itemAt doc.routes i)
            push out ("navigate " + r.path)
            i = (i + 1)
        }
        push out "login"
        push out "logout"
        push out "back"
        return out
    }

    fn actionText:string (n:RaveNode) {
        if ((array_length n.actions) == 0) {
            return ""
        }
        def a:RaveAction (itemAt n.actions 0)
        if ((strlen a.arg) > 0) {
            return (a.kind + " " + a.arg)
        }
        return a.kind
    }

    ; "navigate /settings" → the node's one click action.
    fn setActionText:boolean (choice:string) {
        def kind:string choice
        def arg:string ""
        def sp:int (indexOf choice " ")
        if (sp > 0) {
            kind = (substring choice 0 sp)
            arg = (substring choice (sp + 1) (strlen choice))
        }
        def e:RaveEdit (unwrap edit)
        def did:boolean (e.setAction(selected kind arg))
        this.changed()
        return did
    }

    ; --- the frame ------------------------------------------------------------------

    fn rebuild:void () {
        root = (this.buildPage())
        dirty = false
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn readBoard:void () {
        if boardEl {
            def be:EVGElement (unwrap boardEl)
            bx = be.calculatedX
            by = be.calculatedY
            bw = be.calculatedWidth
            bh = be.calculatedHeight
        }
    }

    fn laidOut:EVGLayout () {
        if (dirty || (null? root)) {
            this.gather()
            this.rebuild()
        }
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        if (null? layout) {
            def fresh (new EVGLayout())
            fresh.setPageSize(pageW pageH)
            layout = fresh
        }
        def lay:EVGLayout (unwrap layout)
        lay.setPageSize(pageW pageH)
        lay.layout(r)
        this.readBoard()
        ; The overlays on the stage are placed against a board the layout has
        ; only now measured: one more pass when its size moved.
        if ((RaveEditor.differs(builtW bw)) || (RaveEditor.differs(builtH bh))) {
            builtW = bw
            builtH = bh
            if needFit {
                this.fit()
            }
            this.rebuild()
            def r2:EVGElement (unwrap root)
            this.markStates(r2)
            s.applyTree(r2 "")
            lay.layout(r2)
            this.readBoard()
        }
        return lay
    }

    sfn differs:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        return (d > 0.5)
    }

    ; What the A11y pane and the tree's warning marks read: the lint of the
    ; active view plus the contrast walk, once per frame.
    fn gather:void () {
        def r:RaveRuntime (unwrap rt)
        clear problems
        def lint:[string] (r.lint(activeView))
        def i:int 0
        while (i < (array_length lint)) {
            push problems (itemAt lint i)
            i = (i + 1)
        }
        def page:EVGElement (r.pageOf(activeView))
        def contrast:[string] (RaveA11y.contrast(page))
        def j:int 0
        while (j < (array_length contrast)) {
            push problems (itemAt contrast j)
            j = (j + 1)
        }
    }

    fn problemCount:int () {
        this.laidOut()
        return (array_length problems)
    }

    fn problemAt:string (i:int) {
        this.laidOut()
        return (itemAt problems i)
    }

    ; THE STAGE FIRST, THEN THE CHROME OVER IT: the runtime's scene through
    ; the camera, on a page the size of the window.
    fn boardJson:string () {
        this.laidOut()
        def r:RaveRuntime (unwrap rt)
        if (bw < 1.0) {
            return "{\"width\":0,\"height\":0,\"list\":{\"cmds\":[]}}"
        }
        return (r.sceneListJson(pageW pageH (viewX + bx) (viewY + by) zoom))
    }

    fn chromeList:EVGDisplayList () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def chrome (new EVGDisplayList())
        chrome.setTextEngine((lay.getTextEngine()))
        chrome.build(r)
        return chrome
    }

    fn displayListJson:string () {
        def dl:EVGDisplayList (this.chromeList())
        def body:string (dl.toJson())
        return ("{\"width\":" + (to_string (to_int pageW)) + ",\"height\":" + (to_string (to_int pageH)) + ",\"list\":" + body + "}")
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Rave" generation focusId))
        return (t.toJson())
    }

    ; Where a chrome element is, in window pixels — a field's text box, a
    ; track — so a headless check can press it where a pointer would.
    fn chromeBoxJson:string (id:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (this.findChromeEl(r id))
        if (null? found) {
            return "[]"
        }
        def e:EVGElement (unwrap found)
        return ("[" + (to_string e.calculatedX) + "," + (to_string e.calculatedY) + "," + (to_string e.calculatedWidth) + "," + (to_string e.calculatedHeight) + "]")
    }

    fn chromeLeft:double (id:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (this.findChromeEl(r id))
        if (null? found) {
            return 0.0
        }
        def e:EVGElement (unwrap found)
        return e.calculatedX
    }

    fn chromeTop:double (id:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (this.findChromeEl(r id))
        if (null? found) {
            return 0.0
        }
        def e:EVGElement (unwrap found)
        return e.calculatedY
    }

    fn chromeWidth:double (id:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (this.findChromeEl(r id))
        if (null? found) {
            return 0.0
        }
        def e:EVGElement (unwrap found)
        return e.calculatedWidth
    }

    fn boardBoxJson:string () {
        this.laidOut()
        return ("[" + (to_string bx) + "," + (to_string by) + "," + (to_string bw) + "," + (to_string bh) + "]")
    }

    ; A node's box in one viewport, in WINDOW pixels: where a pointer would
    ; have to press to select it.
    fn stageBoxJson:string (view:int id:string) {
        this.laidOut()
        def r:RaveRuntime (unwrap rt)
        def x:double (((r.leftOf(view id)) * zoom) + viewX + bx)
        def y:double (((r.topOf(view id)) * zoom) + viewY + by)
        def w:double ((r.widthOf(view id)) * zoom)
        def h:double ((r.heightOf(view id)) * zoom)
        return ("[" + (to_string x) + "," + (to_string y) + "," + (to_string w) + "," + (to_string h) + "]")
    }

    fn stageCentreX:double (view:int id:string) {
        this.laidOut()
        def r:RaveRuntime (unwrap rt)
        return ((((r.leftOf(view id)) + ((r.widthOf(view id)) * 0.5)) * zoom) + viewX + bx)
    }

    fn stageCentreY:double (view:int id:string) {
        this.laidOut()
        def r:RaveRuntime (unwrap rt)
        return ((((r.topOf(view id)) + ((r.heightOf(view id)) * 0.5)) * zoom) + viewY + by)
    }

    ; --- the page -------------------------------------------------------------

    fn buildPage:EVGElement () {
        def page:EVGElement (RaveEditor.box("ra-page" "" "" ""))
        page.addChild((this.topBar()))
        def main:EVGElement (RaveEditor.box("ra-main" "" "" ""))
        main.addChild((this.leftRail()))
        main.addChild((this.stage()))
        main.addChild((this.rightRail()))
        page.addChild(main)
        page.addChild((this.footer()))
        if wizardOpen {
            page.addChild((this.wizardSheet()))
        }
        if aiOpen {
            page.addChild((this.aiSheet()))
        }
        return page
    }

    ; --- the AI sheet -----------------------------------------------------------

    fn aiSheet:EVGElement () {
        def scrim:EVGElement (RaveEditor.box("ra-wiz-scrim" "ai:close" "" ""))
        def sheet:EVGElement (RaveEditor.box("ra-wiz ra-ai" "" "dialog" "Ask an AI"))
        sheet.a11yModal = true
        sheet.addChild((RaveEditor.txt("ra-wiz-title" "Ask an AI")))
        def lead:EVGElement (RaveEditor.box("ra-wiz-row" "" "" ""))
        lead.addChild((RaveEditor.quiet("ra-note-t" "Copy the prompt, paste it into whatever you use, paste the answer back.")))
        lead.addChild((RaveEditor.quiet("ra-note-t" "Nothing here talks to a service — you are the wire.")))
        sheet.addChild(lead)

        def scopeRow:EVGElement (this.wizRow("About"))
        def sset:EVGElement (RaveEditor.box("ra-wiz-opts" "" "radiogroup" "About"))
        sset.addChild((this.wizChoice("ai:scope:document" "The whole document" (aiScope == "document") true)))
        sset.addChild((this.wizChoice("ai:scope:page" "This page" (aiScope == "page") true)))
        def nodeLabel:string "The selected node"
        if (this.hasSelection()) {
            def sel:RaveNode (this.selectedNode())
            nodeLabel = ("The selected " + sel.tag)
        }
        sset.addChild((this.wizChoice("ai:scope:node" nodeLabel (aiScope == "node") true)))
        scopeRow.addChild(sset)
        sheet.addChild(scopeRow)

        def askRow:EVGElement (this.wizRow("What should change"))
        def askCls:string "ra-f ra-f-wide"
        if (editing == "ai:ask") {
            askCls = (askCls + " ra-f-edit")
        }
        def shown:string aiAsk
        if ((strlen shown) == 0) {
            shown = "e.g. two cards per row on a tablet, and a Save button under the form"
        }
        def askField:EVGElement (RaveEditor.box(askCls "ai:ask" "button" ("What should change. " + aiAsk)))
        askField.addChild((this.textBox("ai:ask" shown "ra-f-val")))
        askRow.addChild(askField)
        sheet.addChild(askRow)

        def sizeRow:EVGElement (RaveEditor.box("ra-wiz-row" "" "" ""))
        def body:string (this.aiBody())
        sizeRow.addChild((RaveEditor.quiet("ra-note-t" ((to_string (strlen body)) + " characters of " + (RaveText.scopeWord(aiScope)) + ", " + (to_string (strlen (this.aiPrompt()))) + " of prompt"))))
        sheet.addChild(sizeRow)

        if ((array_length aiErrors) > 0) {
            def errs:EVGElement (RaveEditor.box("ra-ai-errs" "" "list" "What was wrong with the answer"))
            def total:int ((array_length aiErrors) + aiMore)
            def head:string ((to_string total) + " lines could not be read")
            if (total == 1) {
                head = "one line could not be read"
            }
            errs.addChild((RaveEditor.txt("ra-ai-head" head)))
            def shown:int (array_length aiErrors)
            if (shown > 4) {
                shown = 4
            }
            def i:int 0
            while (i < shown) {
                errs.addChild((RaveEditor.txt("ra-ai-err" (RaveEditor.cut((itemAt aiErrors i) 84)))))
                i = (i + 1)
            }
            def rest:int (total - shown)
            if (rest > 0) {
                errs.addChild((RaveEditor.txt("ra-ai-more" ("…and " + (to_string rest) + " more"))))
            }
            sheet.addChild(errs)
        } {
            if ((strlen aiStatus) > 0) {
                sheet.addChild((RaveEditor.txt("ra-note-t" aiStatus)))
            }
        }

        def acts:EVGElement (RaveEditor.box("ra-wiz-acts" "" "" ""))
        acts.addChild((RaveEditor.quiet("ra-note-t" "⌘V / Ctrl+V pastes an answer straight in")))
        acts.addChild((RaveEditor.box("ra-spacer" "" "" "")))
        acts.addChild((RaveEditor.button("ai:close" "Close" "ra-btn" "ra-btn-t")))
        acts.addChild((RaveEditor.button("ai:copy" "Copy prompt" "ra-btn" "ra-btn-t")))
        acts.addChild((RaveEditor.button("ai:paste" "Paste box" "ra-btn ra-btn-go" "ra-btn-t")))
        sheet.addChild(acts)
        scrim.addChild(sheet)
        return scrim
    }

    ; --- File → New -----------------------------------------------------------

    ; One row of the sheet: a question on the left, its answers on the right.
    fn wizRow:EVGElement (label:string) {
        def row:EVGElement (RaveEditor.box("ra-wiz-row" "" "group" label))
        row.addChild((RaveEditor.quiet("ra-wiz-lab" label)))
        return row
    }

    ; A choice that says whether it is the one taken. Radios and tick boxes
    ; differ only in what the state is called, so they are the same element
    ; with the right ARIA on it.
    fn wizChoice:EVGElement (id:string label:string on:boolean radio:boolean) {
        def cls:string "ra-wiz-opt"
        if on {
            cls = "ra-wiz-opt ra-wiz-opt-on"
        }
        def role:string "checkbox"
        if radio {
            role = "radio"
        }
        def e:EVGElement (RaveEditor.box(cls id role label))
        e.a11yFocusable = true
        ; the tri-state: 2 is yes, 1 is no — never a boolean, so a reader is
        ; not told about a checkbox that is not one
        e.a11yChecked = 1
        if on {
            e.a11yChecked = 2
        }
        def mark:string "○"
        if radio {
            if on { mark = "◉" }
        } {
            mark = "☐"
            if on { mark = "☑" }
        }
        e.addChild((RaveEditor.quiet("ra-wiz-mark" mark)))
        e.addChild((RaveEditor.quiet("ra-wiz-opt-t" label)))
        return e
    }

    fn wizardSheet:EVGElement () {
        def scrim:EVGElement (RaveEditor.box("ra-wiz-scrim" "wiz:cancel" "" ""))
        def sheet:EVGElement (RaveEditor.box("ra-wiz" "" "dialog" "New project"))
        sheet.a11yModal = true
        sheet.addChild((RaveEditor.txt("ra-wiz-title" "New project")))

        def nameRow:EVGElement (this.wizRow("Name"))
        def nameCls:string "ra-f ra-f-wide"
        if (editing == "wiz:name") {
            nameCls = (nameCls + " ra-f-edit")
        }
        def nameField:EVGElement (RaveEditor.box(nameCls "wiz:name" "button" ("Name " + wizName)))
        nameField.addChild((this.textBox("wiz:name" wizName "ra-f-val")))
        nameRow.addChild(nameField)
        sheet.addChild(nameRow)

        def targets:EVGElement (this.wizRow("Targets"))
        def tset:EVGElement (RaveEditor.box("ra-wiz-opts" "" "group" "Targets"))
        tset.addChild((this.wizChoice("wiz:t:web" "Web" wizWeb false)))
        tset.addChild((this.wizChoice("wiz:t:desktop" "Desktop" wizDesktop false)))
        tset.addChild((this.wizChoice("wiz:t:tablet" "Tablet" wizTablet false)))
        tset.addChild((this.wizChoice("wiz:t:mobile" "Mobile" wizMobile false)))
        targets.addChild(tset)
        sheet.addChild(targets)

        def sign:EVGElement (this.wizRow("Sign-in"))
        def sset:EVGElement (RaveEditor.box("ra-wiz-opts" "" "radiogroup" "Sign-in"))
        sset.addChild((this.wizChoice("wiz:auth" "Yes — a login page and protected routes" wizAuth true)))
        sset.addChild((this.wizChoice("wiz:auth" "No" (wizAuth == false) true)))
        sign.addChild(sset)
        sheet.addChild(sign)

        def nav:EVGElement (this.wizRow("Navigation"))
        def nset:EVGElement (RaveEditor.box("ra-wiz-opts" "" "radiogroup" "Navigation"))
        nset.addChild((this.wizChoice("wiz:nav:sidebar" "Sidebar" (wizNav == "sidebar") true)))
        nset.addChild((this.wizChoice("wiz:nav:topbar" "Top bar" (wizNav == "topbar") true)))
        nset.addChild((this.wizChoice("wiz:nav:tabs" "Tabs" (wizNav == "tabs") true)))
        nset.addChild((this.wizChoice("wiz:nav:none" "None" (wizNav == "none") true)))
        nav.addChild(nset)
        sheet.addChild(nav)

        def start:EVGElement (this.wizRow("Start from"))
        def stset:EVGElement (RaveEditor.box("ra-wiz-opts" "" "radiogroup" "Start from"))
        stset.addChild((this.wizChoice("wiz:start:dashboard" "Dashboard Shell" (wizStart == "dashboard") true)))
        stset.addChild((this.wizChoice("wiz:start:marketing" "Marketing + App" (wizStart == "marketing") true)))
        stset.addChild((this.wizChoice("wiz:start:masterdetail" "Master / Detail" (wizStart == "masterdetail") true)))
        stset.addChild((this.wizChoice("wiz:start:crud" "CRUD" (wizStart == "crud") true)))
        stset.addChild((this.wizChoice("wiz:start:settings" "Settings Layout" (wizStart == "settings") true)))
        stset.addChild((this.wizChoice("wiz:start:empty" "Empty" (wizStart == "empty") true)))
        start.addChild(stset)
        sheet.addChild(start)

        def acts:EVGElement (RaveEditor.box("ra-wiz-acts" "" "" ""))
        acts.addChild((RaveEditor.button("wiz:cancel" "Cancel" "ra-btn" "ra-btn-t")))
        acts.addChild((RaveEditor.button("wiz:create" "Create" "ra-btn ra-btn-go" "ra-btn-t")))
        sheet.addChild(acts)

        scrim.addChild(sheet)
        return scrim
    }


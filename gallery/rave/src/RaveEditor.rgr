        bar.addChild((RaveEditor.button("redo" "Redo" "ra-btn" "ra-btn-t")))
        bar.addChild((RaveEditor.box("ra-sep" "" "" "")))
        bar.addChild((RaveEditor.button("file:new" "New" "ra-btn" "ra-btn-t")))
        bar.addChild((RaveEditor.button("file:open" "Open…" "ra-btn" "ra-btn-t")))
        bar.addChild((RaveEditor.button("file:import" "Import .fig" "ra-btn" "ra-btn-t")))
        bar.addChild((RaveEditor.button("ai:open" "AI…" "ra-btn" "ra-btn-t")))

    ; --- left rail ------------------------------------------------------------

    fn leftRail:EVGElement () {
        def rail:EVGElement (RaveEditor.box("ra-rail ra-rail-left" "" "" ""))
        def tabs:EVGElement (RaveEditor.box("ra-tabrow" "" "tablist" "Left pane"))
        tabs.addChild((this.tab("tab:routes" "Routes" (leftPane == "routes"))))
        tabs.addChild((this.tab("tab:components" "Components" (leftPane == "components"))))
        tabs.addChild((this.tab("tab:layers" "Layers" (leftPane == "layers"))))
        rail.addChild(tabs)
        def scroll:EVGElement (RaveEditor.box("ra-scroll" "" "" ""))
        if (leftPane == "routes") {
            this.routesPane(scroll)
        }
        if (leftPane == "components") {
            this.componentsPane(scroll)
        }
        if (leftPane == "layers") {
            this.layersPane(scroll)
        }
        rail.addChild(scroll)
        return rail
    }

    fn routesPane:void (host:EVGElement) {
        def r:RaveRuntime (unwrap rt)
        host.addChild((this.cap("ROUTES" (to_string (array_length doc.routes)))))
        def list:EVGElement (RaveEditor.box("ra-pages" "" "list" "Routes"))
        def i:int 0
        while (i < (array_length doc.routes)) {
            def route:RaveRoute (itemAt doc.routes i)
            def cls:string "ra-pagerow"
            if (route.path == (r.path())) {
                cls = "ra-pagerow ra-pagerow-on"
            }
            def row:EVGElement (RaveEditor.box(cls ("route:" + route.path) "button" (route.path + " " + route.title)))
            def glyph:string "○"
            if route.protected {
                glyph = "🔒"
            }
            row.addChild((RaveEditor.quiet("ra-page-ic" glyph)))
            row.addChild((RaveEditor.quiet("ra-page-nm" route.path)))
            row.addChild((RaveEditor.box("ra-spacer" "" "" "")))
            row.addChild((RaveEditor.quiet("ra-page-ti" (RaveEditor.cut(route.title 14)))))
            list.addChild(row)
            i = (i + 1)
        }
        host.addChild(list)
        host.addChild((this.cap("LAYOUTS" (to_string (array_length doc.layouts)))))
        def lays:EVGElement (RaveEditor.box("ra-pages" "" "list" "Layouts"))
        def j:int 0
        while (j < (array_length doc.layouts)) {
            def l:RaveNode (itemAt doc.layouts j)
            def cls2:string "ra-pagerow"
            if (l.id == selected) {
                cls2 = "ra-pagerow ra-pagerow-on"
            }
            def row2:EVGElement (RaveEditor.box(cls2 ("tree:" + (to_string l.id)) "button" l.name))
            row2.addChild((RaveEditor.quiet("ra-page-ic" "▦")))
            row2.addChild((RaveEditor.quiet("ra-page-nm" (RaveEditor.cut(l.name 22)))))
            lays.addChild(row2)
            j = (j + 1)
        }
        host.addChild(lays)
        def note:EVGElement (RaveEditor.box("ra-props-box" "" "" ""))
        if doc.authEnabled {
            note.addChild((RaveEditor.txt("ra-props" ("sign-in at " + doc.loginRoute + ", then " + doc.afterLogin))))
        } {
            note.addChild((RaveEditor.txt("ra-props" "no sign-in in this app")))
        }
        host.addChild(note)
    }

    fn componentsPane:void (host:EVGElement) {
        def kinds:[string] (RaveKit.kinds())
        host.addChild((this.cap("COMPONENTS" (to_string (array_length kinds)))))
        def list:EVGElement (RaveEditor.box("ra-pages" "" "list" "Components"))
        def group:string ""
        def i:int 0
        while (i < (array_length kinds)) {
            def k:string (itemAt kinds i)
            def g:string (RaveKit.groupOf(k))
            if (g != group) {
                group = g
                list.addChild((RaveEditor.quiet("ra-group" g)))
            }
            def row:EVGElement (RaveEditor.box("ra-pagerow" ("add:" + k) "button" ("Add " + k)))
            row.addChild((RaveEditor.quiet("ra-page-ic" "+")))
            row.addChild((RaveEditor.quiet("ra-page-nm" k)))
            list.addChild(row)
            i = (i + 1)
        }
        host.addChild(list)
        def note:EVGElement (RaveEditor.box("ra-props-box" "" "" ""))
        note.addChild((RaveEditor.txt("ra-props" "goes into the selected container,")))
        note.addChild((RaveEditor.txt("ra-props" "or after the selected node")))
        host.addChild(note)
    }

    fn layersPane:void (host:EVGElement) {
        def route:RaveRoute (this.currentRoute())
        host.addChild((this.cap("LAYERS" route.path)))
        def tools:EVGElement (RaveEditor.box("ra-treetools" "" "toolbar" "Layer tools"))
        tools.addChild((RaveEditor.button("up" "↑" "ra-tool-s" "ra-tool-t")))
        tools.addChild((RaveEditor.button("down" "↓" "ra-tool-s" "ra-tool-t")))
        tools.addChild((RaveEditor.button("out" "←" "ra-tool-s" "ra-tool-t")))
        tools.addChild((RaveEditor.button("in" "→" "ra-tool-s" "ra-tool-t")))
        tools.addChild((RaveEditor.button("wrap" "Wrap" "ra-tool-s" "ra-tool-t")))
        tools.addChild((RaveEditor.button("dup" "Dup" "ra-tool-s" "ra-tool-t")))
        tools.addChild((RaveEditor.button("del" "Del" "ra-tool-s" "ra-tool-t")))
        host.addChild(tools)
        if (dragging > 0) {
            def carry:EVGElement (RaveEditor.box("ra-carry" "" "status" "Carrying"))
            def d:RaveNode (doc.node(dragging))
            carry.addChild((RaveEditor.txt("ra-carry-t" ("carrying " + (RaveEditor.cut(d.name 14))))))
            carry.addChild((RaveEditor.button("dropcancel" "✕" "ra-tool-s" "ra-tool-t")))
            host.addChild(carry)
        }
        host.addChild((this.tree(route)))
    }

    ; The route's layout with the page spliced into the slot, the way the
    ; runtime builds it, so the tree reads the way the stage looks.
    fn tree:EVGElement (route:RaveRoute) {
        def box:EVGElement (RaveEditor.box("ra-tree" "" "tree" "Layers"))
        def shown:int 0
        if (route.layoutId > 0) {
            shown = (this.treeRows(box (doc.node(route.layoutId)) route.pageId 0 shown))
        } {
            shown = (this.treeRows(box (doc.node(route.pageId)) 0 0 shown))
        }
        return box
    }

    sfn glyph:string (n:RaveNode) {
        if (n.kind == "slot") { return "◇" }
        if (n.kind == "conditional") { return "?" }
        def t:string n.tag
        if (t == "button") { return "▭" }
        if (t == "input") { return "▤" }
        if (t == "img") { return "▨" }
        if (t == "a") { return "↗" }
        if ((t == "h1") || (t == "h2") || (t == "h3") || (t == "h4")) { return "H" }
        if ((t == "p") || (t == "span") || (t == "label")) { return "T" }
        if ((t == "header") || (t == "footer") || (t == "main") || (t == "aside") || (t == "nav") || (t == "section") || (t == "form")) { return "▦" }
        return "▢"
    }

    fn treeRows:int (host:EVGElement n:RaveNode pageId:int depth:int shown:int) {
        if (shown >= 400) {
            return shown
        }
        def cls:string "ra-treerow"
        if (n.id == selected) {
            cls = "ra-treerow ra-treerow-on"
        }
        if (n.id == dragging) {
            cls = (cls + " ra-treerow-carry")
        }
        def row:EVGElement (RaveEditor.box(cls "" "" ""))
        def pad:double (to_double (depth * 11))
        row.setAttribute("padding-left" ((to_string pad) + "px"))

        def kids:int (array_length n.children)
        if ((n.kind == "slot") && (pageId > 0)) {
            kids = (kids + 1)
        }
        def fid:string (to_string n.id)
        def fold:EVGElement (RaveEditor.box("ra-fold" "" "" ""))
        if (kids > 0) {
            fold.id = ("fold:" + fid)
            fold.role = "button"
            fold.a11yLabel = ("fold " + n.name)
            if (this.isFolded(fid)) {
                fold.addChild((RaveEditor.quiet("ra-fold-t" "▸")))
            } {
                fold.addChild((RaveEditor.quiet("ra-fold-t" "▾")))
            }
        }
        row.addChild(fold)

        def pickCls:string "ra-pick"
        if (doc.isRoot(n.id)) {
            pickCls = "ra-pick ra-pick-root"
        }
        def label:string n.name
        if ((strlen label) == 0) {
            label = n.tag
        }
        def pick:EVGElement (RaveEditor.box(pickCls ("tree:" + fid) "treeitem" label))
        pick.addChild((RaveEditor.quiet("ra-ty" (RaveEditor.glyph(n)))))
        pick.addChild((RaveEditor.txt("ra-nm" (RaveEditor.cut(label (24 - (depth * 2)))))))
        def warns:int (RaveA11y.countFor(problems ("n" + fid)))
        if (warns > 0) {
            pick.addChild((RaveEditor.quiet("ra-warn" "⚠")))
        }
        row.addChild(pick)
        if ((doc.isRoot(n.id)) == false) {
            row.addChild((RaveEditor.button(("pick:" + fid) "⋮" "ra-into" "ra-into")))
        }
        host.addChild(row)
        shown = (shown + 1)

        if (this.isFolded(fid)) {
            return shown
        }
        if ((n.kind == "slot") && (pageId > 0)) {
            shown = (this.treeRows(host (doc.node(pageId)) 0 (depth + 1) shown))
        }
        def i:int 0
        while ((i < (array_length n.children)) && (shown < 400)) {
            def c:RaveNode (itemAt n.children i)
            shown = (this.treeRows(host c pageId (depth + 1) shown))
            i = (i + 1)
        }
        return shown
    }

    fn isFolded:boolean (id:string) {
        def had@(optional):boolean (get folded id)
        if (null? had) {
            return false
        }
        return (unwrap had)
    }

    ; --- stage ----------------------------------------------------------------

    fn stage:EVGElement () {
        def r:RaveRuntime (unwrap rt)
        def st:EVGElement (RaveEditor.box("ra-stage" "" "" ""))
        def board:EVGElement (RaveEditor.box("ra-board" "board" "img" "The stage"))
        ; Labels over each viewport and a box round the selection in each,
        ; in window pixels, from the boxes the LAST layout read.
        if (bw > 1.0) {
            r.ensure()
            def i:int 0
            while (i < (r.viewCount())) {
                def v:RaveView (r.view(i))
                def lx:double ((v.offsetX * zoom) + viewX)
                def ly:double ((v.offsetY * zoom) + viewY)
                def label:EVGElement (RaveEditor.box("ra-vplabel" ("vp:" + (to_string i)) "button" (v.name + " " + (to_string (to_int v.width)))))
                if (i == activeView) {
                    label.className = "ra-vplabel ra-vplabel-on"
                }
                label.setAttribute("left" ((to_string lx) + "px"))
                label.setAttribute("top" ((to_string (ly - 22.0)) + "px"))
                label.addChild((RaveEditor.quiet("ra-vplabel-t" (v.name + " · " + (to_string (to_int v.width))))))
                board.addChild(label)
                if ((mode == "design") && (selected > 0)) {
                    def sid:string ("n" + (to_string selected))
                    if (r.hasEl(i sid)) {
                        def sel:EVGElement (RaveEditor.box("ra-selbox" "" "" ""))
                        sel.a11yHidden = true
                        sel.setAttribute("left" ((to_string (((r.leftOf(i sid)) * zoom) + viewX)) + "px"))
                        sel.setAttribute("top" ((to_string (((r.topOf(i sid)) * zoom) + viewY)) + "px"))
                        sel.setAttribute("width" ((to_string ((r.widthOf(i sid)) * zoom)) + "px"))
                        sel.setAttribute("height" ((to_string ((r.heightOf(i sid)) * zoom)) + "px"))
                        board.addChild(sel)
                    }
                }
                i = (i + 1)
            }
            if showTabOrder {
                this.tabOrderBadges(board)
            }
        }
        def bar:EVGElement (this.toolbar())
        board.addChild(bar)
        boardEl = board
        st.addChild(board)
        return st
    }

    fn tabOrderBadges:void (board:EVGElement) {
        def r:RaveRuntime (unwrap rt)
        def page:EVGElement (r.pageOf(activeView))
        def order:[string] (RaveA11y.tabOrder(page))
        def i:int 0
        while (i < (array_length order)) {
            def id:string (itemAt order i)
            def badge:EVGElement (RaveEditor.box("ra-tabbadge" "" "" ""))
            badge.a11yHidden = true
            badge.setAttribute("left" ((to_string (((r.leftOf(activeView id)) * zoom) + viewX)) + "px"))
            badge.setAttribute("top" ((to_string ((((r.topOf(activeView id)) * zoom) + viewY) - 9.0)) + "px"))
            badge.addChild((RaveEditor.quiet("ra-tabbadge-t" (to_string (i + 1)))))
            board.addChild(badge)
            i = (i + 1)
        }
    }

    fn toolbar:EVGElement () {
        def bar:EVGElement (RaveEditor.box("ra-toolbar" "" "toolbar" "Stage tools"))
        def w:double 300.0
        def left:double ((bw - w) * 0.5)
        if (left < 8.0) {
            left = 8.0
        }
        def top:double (bh - 54.0)
        if (top < 8.0) {
            top = 8.0
        }
        bar.setAttribute("left" ((to_string left) + "px"))
        bar.setAttribute("top" ((to_string top) + "px"))
        bar.setAttribute("width" ((to_string w) + "px"))
        bar.addChild((this.tool("zoom:out" "−" false "")))
        bar.addChild((this.tool("zoom:100" (RaveEditor.pct(zoom)) false "ra-zoomlab")))
        bar.addChild((this.tool("zoom:in" "+" false "")))
        bar.addChild((this.tool("fit" "Fit" false "")))
        bar.addChild((RaveEditor.box("ra-tool-sep" "" "" "")))
        bar.addChild((this.tool("a11y:taborder" "Tab order" showTabOrder "")))
        return bar
    }

    fn tool:EVGElement (id:string label:string on:boolean extra:string) {
        def cls:string "ra-tool"
        if on {
            cls = "ra-tool ra-tool-on"
        }
        if ((strlen extra) > 0) {
            cls = (cls + " " + extra)
        }
        def b:EVGElement (RaveEditor.box(cls id "button" label))
        b.addChild((RaveEditor.quiet("ra-tool-t" label)))
        return b
    }

    ; --- right rail -----------------------------------------------------------

    fn rightRail:EVGElement () {
        def rail:EVGElement (RaveEditor.box("ra-rail ra-rail-right" "" "" ""))
        def tabs:EVGElement (RaveEditor.box("ra-tabrow" "" "tablist" "Inspector"))
        tabs.addChild((this.tab("tab:design" "Design" (rightPane == "design"))))
        tabs.addChild((this.tab("tab:css" "CSS" (rightPane == "css"))))
        tabs.addChild((this.tab("tab:a11y" "A11y" (rightPane == "a11y"))))
        ; The Import tab is there only when there is an import to read about.
        if ((importReport.noteCount()) > 0) {
            tabs.addChild((this.tab("tab:import" "Import" (rightPane == "import"))))
        }
        tabs.addChild((RaveEditor.box("ra-spacer" "" "" "")))
        tabs.addChild((RaveEditor.quiet("ra-zoomread" (RaveEditor.pct(zoom)))))
        rail.addChild(tabs)
        def scroll:EVGElement (RaveEditor.box("ra-scroll" "" "" ""))
        if (rightPane == "design") {
            this.designPane(scroll)
        }
        if (rightPane == "css") {
            this.cssPane(scroll)
        }
        if (rightPane == "a11y") {
            this.a11yPane(scroll)
        }
        if (rightPane == "import") {
            this.importPane(scroll)
        }
        rail.addChild(scroll)
        return rail
    }

    ; What the import made of the file: the counts, then every guess and
    ; every thing it could not carry over, in the order it met them. A
    ; reading of somebody else's file is worth nothing if it cannot be
    ; checked, so it is written down rather than merely applied.
    fn importPane:void (host:EVGElement) {
        host.addChild((this.cap("IMPORT" (to_string (importReport.noteCount())))))
        def head:EVGElement (RaveEditor.box("ra-props-box" "" "" ""))
        head.addChild((RaveEditor.txt("ra-props" (importReport.summary()))))
        host.addChild(head)
        def list:EVGElement (RaveEditor.box("ra-pages" "" "list" "Import notes"))
        def i:int 0
        while (i < (importReport.noteCount())) {
            def note:RaveImportNote (itemAt importReport.notes i)
            def row:EVGElement (RaveEditor.box("ra-noterow" "" "listitem" (note.line())))
            def mark:string "?"
            if (note.kind == "dropped") { mark = "!" }
            if (note.kind == "layout") { mark = "▤" }
            row.addChild((RaveEditor.quiet("ra-page-ic" mark)))
            def body:EVGElement (RaveEditor.box("ra-notebody" "" "" ""))
            body.addChild((RaveEditor.quiet("ra-page-nm" (RaveEditor.cut(note.nodeName 22)))))
            body.addChild((RaveEditor.quiet("ra-note-t" note.detail)))
            row.addChild(body)
            list.addChild(row)
            i = (i + 1)
        }
        host.addChild(list)
    }

    fn nothingSelected:void (host:EVGElement) {
        def box:EVGElement (RaveEditor.box("ra-props-box" "" "" ""))
        box.addChild((RaveEditor.txt("ra-props" "click a node on the stage")))
        box.addChild((RaveEditor.txt("ra-props" "or a row in Layers")))
        box.addChild((RaveEditor.txt("ra-props" "drag to pan, scroll to zoom")))
        host.addChild(box)
    }

    fn inspectorHead:EVGElement (n:RaveNode) {
        def head:EVGElement (RaveEditor.box("ra-insp-head" "" "" ""))
        def kind:string n.tag
        if (n.kind != "element") {
            kind = n.kind
        }
        head.addChild((RaveEditor.quiet("ra-kindlab" kind)))
        head.addChild((RaveEditor.txt("ra-insp-nm" (RaveEditor.cut(n.name 18)))))
        head.addChild((RaveEditor.box("ra-spacer" "" "" "")))
        head.addChild((RaveEditor.quiet("ra-eye" ("." + (n.cls())))))
        return head
    }

    fn bpRow:EVGElement () {
        def row:EVGElement (RaveEditor.box("ra-chips" "" "tablist" "Breakpoint"))
        row.addChild((this.chip("bp:base" "base" (bp == "base"))))
        row.addChild((this.chip("bp:sm" "<768" (bp == "sm"))))
        row.addChild((this.chip("bp:md" "768–1023" (bp == "md"))))
        row.addChild((this.chip("bp:lg" "≥1024" (bp == "lg"))))
        return row
    }

    fn chip:EVGElement (id:string label:string on:boolean) {
        def cls:string "ra-chip"
        if on {
            cls = "ra-chip ra-chip-on"
        }
        def c:EVGElement (RaveEditor.box(cls id "tab" label))
        c.addChild((RaveEditor.quiet("ra-chip-t" label)))
        return c
    }

    fn designPane:void (host:EVGElement) {
        if ((this.hasSelection()) == false) {
            this.nothingSelected(host)
            return
        }
        def n:RaveNode (this.selectedNode())
        def insp:EVGElement (RaveEditor.box("ra-insp" "" "" ""))
        insp.addChild((this.inspectorHead(n)))

        def node:EVGElement (this.section("NODE"))
        def nr:EVGElement (RaveEditor.box("ra-fields" "" "" ""))
        this.addNodeField(nr "name" "Name")
        if ((strlen n.text) > 0) {
            this.addNodeField(nr "text" "Text")
        } {
            if ((n.tag == "button") || (n.tag == "a") || (RaveBuild.isTextTag(n.tag))) {
                this.addNodeField(nr "text" "Text")
            }
        }
        this.addNodeField(nr "label" "Label")
        if (n.tag == "input") {
            this.addNodeField(nr "placeholder" "Placeholder")
        }
        node.addChild(nr)
        insp.addChild(node)

        def bps:EVGElement (this.section("BREAKPOINT"))
        bps.addChild((this.bpRow()))
        insp.addChild(bps)

        def lay:EVGElement (this.section("LAYOUT"))
        def l1:EVGElement (RaveEditor.box("ra-fields" "" "" ""))
        this.addField(l1 "display" "Layout")
        def disp:string (this.valueOf("display"))
        if (disp == "grid") {
            this.addField(l1 "grid-template-columns" "Columns")
            this.addField(l1 "grid-template-rows" "Rows")
        } {
            this.addField(l1 "flex-direction" "Direction")
            this.addField(l1 "flex-wrap" "Wrap")
            this.addField(l1 "justify-content" "Justify")
            this.addField(l1 "align-items" "Align")
        }
        this.addField(l1 "gap" "Gap")
        this.addField(l1 "padding" "Padding")
        this.addField(l1 "margin" "Margin")
        lay.addChild(l1)
        insp.addChild(lay)

        def size:EVGElement (this.section("SIZE"))
        def s1:EVGElement (RaveEditor.box("ra-fields" "" "" ""))
        this.addField(s1 "width" "Width")
        this.addField(s1 "height" "Height")
        this.addField(s1 "min-width" "Min W")
        this.addField(s1 "max-width" "Max W")
        this.addField(s1 "flex-grow" "Grow")
        this.addField(s1 "align-self" "Self")
        size.addChild(s1)
        insp.addChild(size)

        def pos:EVGElement (this.section("POSITION"))
        def p1:EVGElement (RaveEditor.box("ra-fields" "" "" ""))
        this.addField(p1 "position" "Position")
        this.addField(p1 "overflow" "Overflow")
        pos.addChild(p1)
        insp.addChild(pos)

        def look:EVGElement (this.section("LOOK"))
        def k1:EVGElement (RaveEditor.box("ra-fields" "" "" ""))
        this.addField(k1 "background-color" "Fill")
        this.addField(k1 "color" "Text")
        this.addField(k1 "font-size" "Size")
        this.addField(k1 "font-weight" "Weight")
        this.addField(k1 "border" "Border")
        this.addField(k1 "border-radius" "Radius")
        look.addChild(k1)
        insp.addChild(look)

        def resp:EVGElement (this.section("RESPONSIVE"))
        def medias:[string] (doc.mediaOf((n.cls())))
        if ((array_length medias) == 0) {
            resp.addChild((RaveEditor.txt("ra-note" "no rules yet — pick a breakpoint and set a value")))
        }
        def mi:int 0
        while (mi < (array_length medias)) {
            def m:string (itemAt medias mi)
            def key:string (this.keyForMedia(m))
            def rule:RaveRule (doc.rule((n.cls()) m))
            def line:string ""
            def di:int 0
            while ((di < (array_length rule.decls)) && (di < 3)) {
                def d:RaveDecl (itemAt rule.decls di)
                if (di > 0) {
                    line = (line + "; ")
                }
                line = (line + d.name + ": " + d.value)
                di = (di + 1)
            }
            if ((array_length rule.decls) > 3) {
                line = (line + " …")
            }
            def row:EVGElement (RaveEditor.box("ra-resp" ("bp:" + key) "button" (key + " " + line)))
            def keyLabel:string key
            if (key == "base") { keyLabel = "base" }
            if (key == "sm") { keyLabel = "<768" }
            if (key == "md") { keyLabel = "768–1023" }
            if (key == "lg") { keyLabel = "≥1024" }
            row.addChild((RaveEditor.quiet("ra-resp-k" keyLabel)))
            row.addChild((RaveEditor.quiet("ra-resp-v" (RaveEditor.cut(line 30)))))
            resp.addChild(row)
            mi = (mi + 1)
        }
        insp.addChild(resp)

        def act:EVGElement (this.section("ACTIONS"))
        def a1:EVGElement (RaveEditor.box("ra-fields" "" "" ""))
        this.addField(a1 "action" "click →")
        act.addChild(a1)
        insp.addChild(act)

        def ax:EVGElement (this.section("ACCESSIBILITY"))
        def role:string (RaveBuild.roleOf(n.tag))
        if ((strlen role) == 0) {
            role = "decoration"
        }
        ax.addChild((RaveEditor.txt("ra-props" ("role: " + role))))
        def own:int 0
        def pi:int 0
        while (pi < (array_length problems)) {
            def p:string (itemAt problems pi)
            if ((RaveA11y.nodeOf(p)) == (n.elementId())) {
                ax.addChild((RaveEditor.txt("ra-warnline" (RaveEditor.cut((RaveA11y.messageOf(p)) 40)))))
                own = (own + 1)
            }
            pi = (pi + 1)
        }
        if (own == 0) {
            ax.addChild((RaveEditor.txt("ra-okline" "no warnings on this node")))
        }
        insp.addChild(ax)
        host.addChild(insp)
    }

    ; --- fields -------------------------------------------------------------------------
    ; Three kinds, decided by `RaveFields` and by the value: a choice opens a
    ; list under itself; a length is a number half and a unit half with a
    ; − track + row under it while it is edited; anything else is a text
    ; field with a caret and a selection.

    fn engineNow:EVGTextEngine () {
        if (null? layout) {
            def fresh (new EVGLayout())
            fresh.setPageSize(pageW pageH)
            layout = fresh
        }
        def lay:EVGLayout (unwrap layout)
        return (lay.getTextEngine())
    }

    ; The text box of a field: its value, and while it is being edited the
    ; selection behind the glyphs and the caret between them, both measured
    ; with the engine that paints them.
    fn textBox:EVGElement (fid:string shown:string cls:string) {
        def box:EVGElement (RaveEditor.box("ra-f-in" ("in:" + fid) "" ""))
        if (editing == fid) {
            def eng:EVGTextEngine (this.engineNow())
            if (input.hasSelection()) {
                def x0:double (input.caretXAt(eng (input.selStart())))
                def x1:double (input.caretXAt(eng (input.selEnd())))
                def sel:EVGElement (RaveEditor.box("ra-f-sel" "" "" ""))
                sel.a11yHidden = true
                sel.setAttribute("left" ((to_string x0) + "px"))
                sel.setAttribute("width" ((to_string (x1 - x0)) + "px"))
                box.addChild(sel)
            }
            box.addChild((RaveEditor.quiet(cls input.value)))
            def car:EVGElement (RaveEditor.box("ra-f-caret" "" "" ""))
            car.a11yHidden = true
            car.setAttribute("left" ((to_string (input.caretXAt(eng input.caret))) + "px"))
            box.addChild(car)
        } {
            box.addChild((RaveEditor.quiet(cls shown)))
        }
        return box
    }

    fn addField:void (host:EVGElement prop:string label:string) {
        def fid:string ("field:" + prop)
        def kind:string (this.fieldKind(fid))
        if (kind == "choice") {
            host.addChild((this.choiceField(fid label (this.valueOf(prop)))))
        }
        if (kind == "length") {
            host.addChild((this.lengthField(fid label)))
        }
        if (kind == "text") {
            host.addChild((this.textField(fid label false)))
        }
        this.addFieldExtras(host fid)
    }

    fn addNodeField:void (host:EVGElement kind:string label:string) {
        def fid:string ("node:" + kind)
        host.addChild((this.textField(fid label true)))
        this.addFieldExtras(host fid)
    }

    ; What sits under a field: the − track + row of a length being edited,
    ; and the open list of a choice or a unit.
    fn addFieldExtras:void (host:EVGElement fid:string) {
        if ((editing == fid) && (editKind == "length")) {
            host.addChild((this.helperRow(fid)))
        }
        if ((openMenu == fid) || (openMenu == ("unit:" + fid))) {
            host.addChild((this.menu()))
        }
    }

    fn choiceField:EVGElement (fid:string label:string value:string) {
        def shown:string value
        if ((strlen shown) == 0) {
            shown = "–"
        }
        def cls:string "ra-f ra-f-half"
        if ((strlen label) > 8) {
            cls = "ra-f ra-f-wide"
        }
        if (openMenu == fid) {
            cls = (cls + " ra-f-open")
        }
        def f:EVGElement (RaveEditor.box(cls fid "button" (label + " " + shown)))
        f.a11yHasPopup = "listbox"
        f.addChild((RaveEditor.quiet("ra-f-lab" label)))
        f.addChild((RaveEditor.quiet("ra-f-val" (RaveEditor.cut(shown 14)))))
        f.addChild((RaveEditor.quiet("ra-f-ar" "▾")))
        return f
    }

    fn lengthField:EVGElement (fid:string label:string) {
        def prop:string (RaveEditor.propOf(fid))
        def units:[string] (RaveFields.units(prop))
        def number:string "–"
        def u:string (itemAt units 0)
        if (editing == fid) {
            u = unit
        } {
            def v:string (this.valueOf(prop))
            def parsed:RaveLength (RaveFields.parse(v units))
            if parsed.ok {
                u = parsed.unit
                if (parsed.unit != "auto") {
                    number = parsed.number
                }
            }
        }
        def cls:string "ra-f ra-f-half"
        if (editing == fid) {
            cls = "ra-f ra-f-half ra-f-edit"
        }
        def f:EVGElement (RaveEditor.box(cls fid "button" (label + " " + number + " " + u)))
        f.addChild((RaveEditor.quiet("ra-f-lab" label)))
        f.addChild((this.textBox(fid number "ra-f-val")))
        if ((array_length units) > 1) {
            def uShown:string u
            if ((strlen uShown) == 0) {
                uShown = "—"
            }
            def chipCls:string "ra-f-unit"
            if (openMenu == ("unit:" + fid)) {
                chipCls = "ra-f-unit ra-f-open"
            }
            def chip:EVGElement (RaveEditor.box(chipCls ("unit:" + fid) "button" ("unit " + uShown)))
            chip.a11yHasPopup = "listbox"
            chip.addChild((RaveEditor.quiet("ra-f-unit-t" uShown)))
            chip.addChild((RaveEditor.quiet("ra-f-ar" "▾")))
            f.addChild(chip)
        }
        return f
    }

    fn textField:EVGElement (fid:string label:string wide:boolean) {
        def value:string ""
        if (RaveEditor.hasPrefix(fid "field:")) {
            value = (this.valueOf((RaveEditor.propOf(fid))))
        } {
            value = (this.nodeValue((RaveEditor.tail(fid 5))))
        }
        def shown:string value
        if ((strlen shown) == 0) {
            shown = "–"
        }
        def cls:string "ra-f ra-f-half"
        if wide {
            cls = "ra-f ra-f-wide"
        }
        if (editing == fid) {
            cls = (cls + " ra-f-edit")
        }
        def f:EVGElement (RaveEditor.box(cls fid "button" (label + " " + value)))
        f.addChild((RaveEditor.quiet("ra-f-lab" label)))
        f.addChild((this.textBox(fid shown "ra-f-val")))
        return f
    }

    ; − [ track ] + : the number nudged by the unit's step, or dragged.
    fn helperRow:EVGElement (fid:string) {
        def prop:string (RaveEditor.propOf(fid))
        def row:EVGElement (RaveEditor.box("ra-f-help" "" "" ""))
        row.addChild((RaveEditor.button(("dec:" + fid) "−" "ra-tool-s" "ra-tool-t")))
        def track:EVGElement (RaveEditor.box("ra-f-track" ("track:" + fid) "slider" (prop + " slider")))
        def top:double (RaveFields.trackMax(unit prop))
        def v:double (RaveFields.toNumber(input.value))
        def pct:double ((v / top) * 100.0)
        if (pct < 0.0) { pct = 0.0 }
        if (pct > 100.0) { pct = 100.0 }
        track.a11yHasValue = true
        track.a11yValueNow = (to_int v)
        track.a11yHasRange = true
        track.a11yValueMin = 0
        track.a11yValueMax = (to_int top)
        def range:EVGElement (RaveEditor.box("ra-f-range" "" "" ""))
        range.setAttribute("width" ((to_string pct) + "%"))
        track.addChild(range)
        row.addChild(track)
        row.addChild((RaveEditor.button(("inc:" + fid) "+" "ra-tool-s" "ra-tool-t")))
        def hint:string ("↑↓ ±" + (RaveFields.fromNumber((RaveFields.trackStep(unit)))) + " · shift ×10")
        row.addChild((RaveEditor.quiet("ra-f-hint" hint)))
        return row
    }

    ; The open list, under the field it belongs to.
    fn menu:EVGElement () {
        def box:EVGElement (RaveEditor.box("ra-menu" "" "listbox" "Options"))
        def opts:[string] (this.menuOptions())
        def cur:string (this.menuCurrent())
        def i:int 0
        while (i < (array_length opts)) {
            def o:string (itemAt opts i)
            def shown:string o
            if ((strlen shown) == 0) {
                shown = "—"
            }
            def cls:string "ra-opt"
            if (i == menuActive) {
                cls = "ra-opt ra-opt-on"
            }
            def row:EVGElement (RaveEditor.box(cls ("opt:" + (to_string i)) "option" shown))
            if (o == cur) {
                row.a11ySelected = 2
                row.addChild((RaveEditor.quiet("ra-opt-tick" "✓")))
            } {
                row.addChild((RaveEditor.quiet("ra-opt-tick" "")))
            }
            row.addChild((RaveEditor.quiet("ra-opt-t" shown)))
            box.addChild(row)
            i = (i + 1)
        }
        return box
    }

    ; The CSS tab: the selected node's rule at the inspector's breakpoint,
    ; one editable line per declaration, and the rest of its rules as text.
    fn cssPane:void (host:EVGElement) {
        if ((this.hasSelection()) == false) {
            this.nothingSelected(host)
            return
        }
        def n:RaveNode (this.selectedNode())
        def insp:EVGElement (RaveEditor.box("ra-insp" "" "" ""))
        insp.addChild((this.inspectorHead(n)))
        def bps:EVGElement (this.section("BREAKPOINT"))
        bps.addChild((this.bpRow()))
        insp.addChild(bps)
        def sec:EVGElement (this.section("RULE"))
        def m:string (this.media())
        if ((strlen m) > 0) {
            sec.addChild((RaveEditor.txt("ra-code ra-code-dim" ("@media " + m + " {"))))
        }
        sec.addChild((RaveEditor.txt("ra-code" ("." + (n.cls()) + " {"))))
        def r:RaveRule (doc.rule((n.cls()) m))
        def i:int 0
        while (i < (array_length r.decls)) {
            def d:RaveDecl (itemAt r.decls i)
            def id:string ("css:" + (to_string i))
            def cls:string "ra-codeline"
            if (editing == id) {
                cls = "ra-codeline ra-f-edit"
            }
            def row:EVGElement (RaveEditor.box(cls id "button" (d.name + " " + d.value)))
            row.addChild((RaveEditor.quiet("ra-code" "  ")))
            row.addChild((this.textBox(id (d.name + ": " + d.value + ";") "ra-code")))
            sec.addChild(row)
            i = (i + 1)
        }
        def addCls:string "ra-codeline ra-codeline-add"
        if (editing == "css:new") {
            addCls = "ra-codeline ra-f-edit"
        }
        def add:EVGElement (RaveEditor.box(addCls "css:new" "button" "add a declaration"))
        add.addChild((RaveEditor.quiet("ra-code" "  ")))
        add.addChild((this.textBox("css:new" "+ declaration" "ra-code")))
        sec.addChild(add)
        sec.addChild((RaveEditor.txt("ra-code" "}")))
        if ((strlen m) > 0) {
            sec.addChild((RaveEditor.txt("ra-code ra-code-dim" "}")))
        }
        insp.addChild(sec)

        def all:EVGElement (this.section("EVERY RULE OF THIS NODE"))
        def text:string (RaveCss.nodeText(doc n))
        def lines:[string] (RaveEditor.split(text))
        def j:int 0
        while ((j < (array_length lines)) && (j < 40)) {
            def ln:string (itemAt lines j)
            if ((strlen ln) > 0) {
                all.addChild((RaveEditor.txt("ra-code ra-code-dim" (RaveEditor.cut(ln 40)))))
            }
            j = (j + 1)
        }
        insp.addChild(all)
        host.addChild(insp)
    }

    ; The A11y tab: the active view's accessibility tree beside the layer
    ; tree, and every problem the lint and the contrast walk found.
    fn a11yPane:void (host:EVGElement) {
        def r:RaveRuntime (unwrap rt)
        def v:RaveView (r.view(activeView))
        def insp:EVGElement (RaveEditor.box("ra-insp" "" "" ""))
        def head:EVGElement (this.section("ACCESSIBILITY TREE"))
        head.addChild((RaveEditor.txt("ra-note" ("as a reader hears " + v.name + " · " + (to_string (to_int v.width))))))
        def toggle:EVGElement (this.tool("a11y:taborder" "Show tab order on the stage" showTabOrder ""))
        head.addChild(toggle)
        insp.addChild(head)

        def t:EVGA11yTree (r.a11yTree(activeView))
        def treeBox:EVGElement (RaveEditor.box("ra-tree" "" "tree" "Accessibility tree"))
        def depths:[string:int]
        def i:int 0
        while ((i < (array_length t.nodes)) && (i < 300)) {
            def an:EVGA11yNode (itemAt t.nodes i)
            def depth:int 0
            if ((strlen an.parentId) > 0) {
                def pd@(optional):int (get depths an.parentId)
                if (null? pd) {
                    depth = 1
                } {
                    depth = ((unwrap pd) + 1)
                }
            }
            set depths an.id depth
            def row:EVGElement (RaveEditor.box("ra-treerow" "" "" ""))
            row.setAttribute("padding-left" ((to_string (depth * 9)) + "px"))
            def pickId:string ""
            def ours:int (RaveApp.idOfElement(an.id))
            if (ours > 0) {
                pickId = ("tree:" + (to_string ours))
            }
            def cls:string "ra-pick"
            if ((ours > 0) && (ours == selected)) {
                cls = "ra-pick ra-pick-on"
            }
            def pick:EVGElement (RaveEditor.box(cls pickId "treeitem" ((EVGA11yRole.ariaName(an.role)) + " " + an.name)))
            pick.addChild((RaveEditor.quiet("ra-ty" (RaveEditor.cut((EVGA11yRole.ariaName(an.role)) 9)))))
            pick.addChild((RaveEditor.txt("ra-nm" (RaveEditor.cut(an.name (22 - depth))))))
            if an.focusable {
                pick.addChild((RaveEditor.quiet("ra-focusable" "⇥")))
            }
            row.addChild(pick)
            treeBox.addChild(row)
            i = (i + 1)
        }
        insp.addChild(treeBox)

        def probs:EVGElement (this.section("PROBLEMS"))
        if ((array_length problems) == 0) {
            probs.addChild((RaveEditor.txt("ra-okline" "nothing to fix on this page")))
        }
        def j:int 0
        while ((j < (array_length problems)) && (j < 60)) {
            def p:string (itemAt problems j)
            def who:string (RaveA11y.nodeOf(p))
            def rowId:string ""
            def nid:int (RaveApp.idOfElement(who))
            if (nid > 0) {
                rowId = ("tree:" + (to_string nid))
            }
            def row:EVGElement (RaveEditor.box("ra-problem" rowId "button" p))
            row.addChild((RaveEditor.quiet("ra-warn" "⚠")))
            def label:string (RaveA11y.messageOf(p))
            if (nid > 0) {
                def n:RaveNode (doc.node(nid))
                label = (n.name + ": " + label)
            }
            row.addChild((RaveEditor.quiet("ra-warnline" (RaveEditor.cut(label 38)))))
            probs.addChild(row)
            j = (j + 1)
        }
        insp.addChild(probs)
        host.addChild(insp)
    }

    fn section:EVGElement (title:string) {
        def s:EVGElement (RaveEditor.box("ra-section" "" "" ""))
        s.addChild((RaveEditor.quiet("ra-h3" title)))
        return s
    }

    fn cap:EVGElement (title:string n:string) {
        def c:EVGElement (RaveEditor.box("ra-cap" "" "" ""))
        c.addChild((RaveEditor.quiet("ra-cap-t" title)))
        if ((strlen n) > 0) {
            c.addChild((RaveEditor.box("ra-spacer" "" "" "")))
            c.addChild((RaveEditor.quiet("ra-cap-n" n)))
        }
        return c
    }

    fn tab:EVGElement (id:string label:string on:boolean) {
        def cls:string "ra-tab"
        if on {
            cls = "ra-tab ra-tab-on"
        }
        def t:EVGElement (RaveEditor.box(cls id "tab" label))
        t.addChild((RaveEditor.quiet("ra-tab-t" label)))
        return t
    }

    ; --- footer ---------------------------------------------------------------

    fn footer:EVGElement () {
        def r:RaveRuntime (unwrap rt)
        def e:RaveEdit (unwrap edit)
        def f:EVGElement (RaveEditor.box("ra-footer" "" "status" "Status"))
        f.addChild((RaveEditor.quiet("ra-foot-status" (RaveEditor.cut(status 30)))))
        f.addChild((RaveEditor.quiet("ra-foot-t" mode)))
        f.addChild((RaveEditor.quiet("ra-foot-b" (r.path()))))
        f.addChild((RaveEditor.quiet("ra-foot-t" "views")))
        f.addChild((RaveEditor.quiet("ra-foot-b" (to_string (r.viewCount())))))
        f.addChild((RaveEditor.quiet("ra-foot-t" "a11y")))
        f.addChild((RaveEditor.quiet("ra-foot-b" (to_string (array_length problems)))))
        f.addChild((RaveEditor.quiet("ra-foot-t" "rejected")))
        f.addChild((RaveEditor.quiet("ra-foot-b" (to_string (r.layoutWarningCount(0))))))
        f.addChild((RaveEditor.quiet("ra-foot-t" "undo")))
        f.addChild((RaveEditor.quiet("ra-foot-b" (to_string (e.history.depth())))))
        if (mode == "run") {
            f.addChild((RaveEditor.quiet("ra-foot-t" "key")))
            f.addChild((RaveEditor.quiet("ra-foot-b" (RaveEditor.cut(lastKey 24)))))
        }
        return f
    }

    ; --- what a headless check asks -------------------------------------------

    fn treeIdsJson:string () {
        this.laidOut()
        def route:RaveRoute (this.currentRoute())
        def ids:[string]
        if (route.layoutId > 0) {
            this.treeIds((doc.node(route.layoutId)) route.pageId ids)
        } {
            this.treeIds((doc.node(route.pageId)) 0 ids)
        }
        def out:string "["
        def k:int 0
        while (k < (array_length ids)) {
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + "\"" + (itemAt ids k) + "\"")
            k = (k + 1)
        }
        return (out + "]")
    }

    fn treeIds:void (n:RaveNode pageId:int ids:[string]) {
        if ((array_length ids) >= 400) {
            return
        }
        push ids ("n" + (to_string n.id))
        if (this.isFolded((to_string n.id))) {
            return
        }
        if ((n.kind == "slot") && (pageId > 0)) {
            this.treeIds((doc.node(pageId)) 0 ids)
        }
        def i:int 0
        while (i < (array_length n.children)) {
            this.treeIds((itemAt n.children i) pageId ids)
            i = (i + 1)
        }
    }

    ; --- element helpers ------------------------------------------------------

    sfn box:EVGElement (cls:string id:string role:string label:string) {
        def e:EVGElement (EVGElement.createDiv())
        e.className = cls
        e.id = id
        e.role = role
        e.a11yLabel = label
        if ((role == "button") || (role == "tab") || (role == "treeitem")) {
            if ((strlen id) > 0) {
                e.a11yFocusable = true
            }
        }
        return e
    }

    sfn txt:EVGElement (cls:string s:string) {
        def e:EVGElement (EVGElement.createDiv())
        e.className = cls
        e.elementType = 1
        e.textContent = s
        e.role = "text"
        return e
    }

    sfn quiet:EVGElement (cls:string s:string) {
        def e:EVGElement (RaveEditor.txt(cls s))
        e.role = ""
        e.a11yHidden = true
        return e
    }

    sfn button:EVGElement (id:string label:string cls:string txtCls:string) {
        def b:EVGElement (RaveEditor.box(cls id "button" label))
        b.addChild((RaveEditor.quiet(txtCls label)))
        return b
    }

    sfn cut:string (s:string n:int) {
        if ((strlen s) <= n) {
            return s
        }
        if (n < 2) {
            return s
        }
        return ((substring s 0 (n - 1)) + "…")
    }

    sfn pct:string (z:double) {
        return ((to_string (to_int ((z * 100.0) + 0.5))) + "%")
    }

    sfn split:[string] (text:string) {
        def out:[string]
        def cur:string ""
        def i:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 10) {
                push out cur
                cur = ""
            } {
                cur = (cur + (strfromcode c))
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            push out cur
        }
        return out
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RavePatterns — application patterns, as code
; =============================================================================
; A new project is not a blank canvas. `Dashboard Shell` is a layout with a
; header, a sidebar, a main area and a footer, four routes that share it, and
; the breakpoints at which the sidebar folds away; `Auth Flow` adds a login
; route, marks the rest protected, and wires `Login` and `Logout`. They are
; Ranger functions rather than a template format so they are tested like
; code: built, run, navigated logged in and out, linted at every width.
; =============================================================================

Import "RaveDoc.rgr"

class RavePatterns {

    ; --- the shared look -----------------------------------------------------------

    sfn theme:void (app:RaveApp) {
        app.setVar("bg" "#ffffff")
        app.setVar("panel" "#fafafa")
        app.setVar("ink" "#09090b")
        app.setVar("muted" "#71717a")
        app.setVar("accent" "#2563eb")
        app.setVar("accent-ink" "#ffffff")
        app.setVar("line" "#e4e4e7")
        app.setVar("radius" "8px")

        app.shared("btn" "flex-direction" "row")
        app.shared("btn" "align-items" "center")
        app.shared("btn" "justify-content" "center")
        app.shared("btn" "height" "36px")
        app.shared("btn" "padding" "0 16px")
        app.shared("btn" "border-radius" "var(--radius)")
        app.shared("btn" "background-color" "var(--accent)")
        app.shared("btn" "color" "var(--accent-ink)")
        app.shared("btn" "font-size" "14px")
        app.shared("btn" "cursor" "pointer")
        app.shared("btn-ghost" "background-color" "transparent")
        app.shared("btn-ghost" "color" "var(--ink)")

        app.shared("card" "background-color" "var(--bg)")
        app.shared("card" "border" "1px solid var(--line)")
        app.shared("card" "border-radius" "var(--radius)")
        app.shared("card" "padding" "16px")
        app.shared("card" "gap" "8px")

        app.shared("field" "gap" "6px")
        app.shared("input" "height" "36px")
        app.shared("input" "padding" "0 12px")
        app.shared("input" "justify-content" "center")
        app.shared("input" "border" "1px solid var(--line)")
        app.shared("input" "border-radius" "var(--radius)")
        app.shared("input" "background-color" "var(--bg)")
        app.shared("rv-placeholder" "color" "var(--muted)")

        app.shared("title" "font-size" "24px")
        app.shared("title" "font-weight" "700")
        app.shared("subtitle" "font-size" "16px")
        app.shared("subtitle" "font-weight" "600")
        app.shared("muted" "color" "var(--muted)")
        app.shared("brand" "font-weight" "700")
        app.shared("brand" "font-size" "16px")

        app.shared("navlink" "padding" "8px 12px")
        app.shared("navlink" "border-radius" "var(--radius)")
        app.shared("navlink" "color" "var(--ink)")
        app.shared("navlink" "cursor" "pointer")
    }

    sfn breakpoints:void (app:RaveApp) {
        app.addBreakpoint("sm" 0)
        app.addBreakpoint("md" 768)
        app.addBreakpoint("lg" 1024)
        app.addBreakpoint("xl" 1440)
    }

    ; A labelled input: the label is what a reader hears, the placeholder
    ; what a sighted person sees in the empty box.
    sfn field:RaveNode (app:RaveApp parent:RaveNode label:string placeholder:string) {
        def f:RaveNode (parent.add((app.newNode("div" label))))
        f.addClass("field")
        def lab:RaveNode (f.add((app.newText("label" label))))
        lab.addClass("muted")
        def input:RaveNode (f.add((app.newNode("input" label))))
        input.addClass("input")
        input.label = label
        input.placeholder = placeholder
        return f
    }

    sfn button:RaveNode (app:RaveApp parent:RaveNode text:string) {
        def b:RaveNode (parent.add((app.newText("button" text))))
        b.addClass("btn")
        return b
    }

    ; --- Dashboard Shell -----------------------------------------------------------

    sfn dashboardShell:RaveApp (name:string) {
        def app (new RaveApp(name))
        push app.targets "web"
        push app.targets "tablet"
        push app.targets "mobile"
        app.nav = "sidebar"
        RavePatterns.breakpoints(app)
        RavePatterns.theme(app)

        ; the layout
        def shell:RaveNode (app.newLayout("Dashboard Shell"))
        app.style(shell "width" "100%")
        app.style(shell "height" "100%")
        app.style(shell "background-color" "var(--bg)")
        app.style(shell "color" "var(--ink)")
        app.style(shell "font-size" "14px")

        def header:RaveNode (shell.add((app.newNode("header" "Header"))))
        app.style(header "flex-direction" "row")
        app.style(header "align-items" "center")
        app.style(header "justify-content" "space-between")
        app.style(header "height" "56px")
        app.style(header "padding" "0 24px")
        app.style(header "border" "1px solid var(--line)")
        def brand:RaveNode (header.add((app.newText("span" name))))
        brand.addClass("brand")
        def tools:RaveNode (header.add((app.newNode("div" "Header tools"))))
        app.style(tools "flex-direction" "row")
        app.style(tools "align-items" "center")
        app.style(tools "gap" "8px")
        def whenIn:RaveNode (tools.add((app.newConditional("authenticated"))))
        app.style(whenIn "flex-direction" "row")
        app.style(whenIn "gap" "8px")
        def logout:RaveNode (RavePatterns.button(app whenIn "Log out"))
        logout.addClass("btn-ghost")
        logout.on("logout" "")
        def whenOut:RaveNode (tools.add((app.newConditional("unauthenticated"))))
        def signIn:RaveNode (RavePatterns.button(app whenOut "Sign in"))
        signIn.on("navigate" "/login")

        def body:RaveNode (shell.add((app.newNode("div" "Body"))))
        app.style(body "display" "grid")
        app.style(body "grid-template-columns" "240px 1fr")
        app.style(body "grid-template-rows" "1fr")
        app.style(body "flex-grow" "1")
        app.style(body "min-height" "0")
        app.styleAt(body (app.below("md")) "grid-template-columns" "1fr")

        def sidebar:RaveNode (body.add((app.newNode("aside" "Sidebar"))))
        sidebar.label = "Sidebar"
        app.style(sidebar "padding" "16px")
        app.style(sidebar "gap" "4px")
        app.style(sidebar "border" "1px solid var(--line)")
        app.style(sidebar "background-color" "var(--panel)")
        app.styleAt(sidebar (app.below("md")) "display" "none")
        def nav:RaveNode (sidebar.add((app.newNode("nav" "Main navigation"))))
        nav.label = "Main navigation"
        app.style(nav "gap" "4px")
        def l1:RaveNode (nav.add((app.newText("a" "Dashboard"))))
        l1.addClass("navlink")
        l1.on("navigate" "/dashboard")
        def l2:RaveNode (nav.add((app.newText("a" "Settings"))))
        l2.addClass("navlink")
        l2.on("navigate" "/settings")
        def l3:RaveNode (nav.add((app.newText("a" "Profile"))))
        l3.addClass("navlink")
        l3.on("navigate" "/profile")

        def main:RaveNode (body.add((app.newNode("main" "Main"))))
        app.style(main "padding" "24px")
        app.style(main "gap" "24px")
        app.style(main "min-width" "0")
        def slot:RaveNode (main.add((app.newSlot())))
        app.style(slot "gap" "24px")

        def footer:RaveNode (shell.add((app.newNode("footer" "Footer"))))
        footer.label = "Footer"
        app.style(footer "height" "40px")
        app.style(footer "padding" "0 24px")
        app.style(footer "justify-content" "center")
        app.style(footer "border" "1px solid var(--line)")
        def fine:RaveNode (footer.add((app.newText("span" ("© " + name)))))
        fine.addClass("muted")

        ; the pages
        def home:RaveNode (app.newPage("Home"))
        app.style(home "gap" "16px")
        def h1:RaveNode (home.add((app.newText("h1" ("Welcome to " + name)))))
        h1.addClass("title")
        def lead:RaveNode (home.add((app.newText("p" "This is the application shell. Everything on it already runs."))))
        lead.addClass("muted")
        def go:RaveNode (RavePatterns.button(app home "Go to dashboard"))
        go.on("navigate" "/dashboard")
        app.style(go "width" "fit-content")

        def dash:RaveNode (app.newPage("Dashboard"))
        app.style(dash "gap" "24px")
        def dh:RaveNode (dash.add((app.newText("h1" "Dashboard"))))
        dh.addClass("title")
        def cards:RaveNode (dash.add((app.newNode("div" "Cards"))))
        app.style(cards "display" "grid")
        app.style(cards "grid-template-columns" "repeat(3, 1fr)")
        app.style(cards "gap" "24px")
        app.styleAt(cards (app.below("md")) "grid-template-columns" "1fr")
        app.styleAt(cards ((app.from("md")) + " and " + (app.below("lg"))) "grid-template-columns" "repeat(2, 1fr)")
        RavePatterns.card(app cards "Revenue" "Where the money came from this month.")
        RavePatterns.card(app cards "Users" "Who signed up, and who came back.")
        RavePatterns.card(app cards "Activity" "What happened, most recent first.")

        def settings:RaveNode (app.newPage("Settings"))
        app.style(settings "gap" "16px")
        def sh:RaveNode (settings.add((app.newText("h1" "Settings"))))
        sh.addClass("title")
        def form:RaveNode (settings.add((app.newNode("form" "Settings form"))))
        form.label = "Settings"
        app.style(form "gap" "12px")
        app.style(form "max-width" "480px")
        RavePatterns.field(app form "Display name" "Your name")
        RavePatterns.field(app form "Email" "you@example.com")
        def save:RaveNode (RavePatterns.button(app form "Save changes"))
        app.style(save "width" "fit-content")

        def profile:RaveNode (app.newPage("Profile"))
        app.style(profile "gap" "16px")
        def ph:RaveNode (profile.add((app.newText("h1" "Profile"))))
        ph.addClass("title")
        def pp:RaveNode (profile.add((app.newText("p" "Who you are, as the application sees you."))))
        pp.addClass("muted")

        ; the routes
        app.addRoute("/" "Home" home shell.id)
        app.addRoute("/dashboard" "Dashboard" dash shell.id)
        app.addRoute("/settings" "Settings" settings shell.id)
        app.addRoute("/profile" "Profile" profile shell.id)
        return app
    }

    sfn card:RaveNode (app:RaveApp parent:RaveNode title:string body:string) {
        def c:RaveNode (parent.add((app.newNode("section" title))))
        c.addClass("card")
        c.label = title
        def h:RaveNode (c.add((app.newText("h3" title))))
        h.addClass("subtitle")
        def p:RaveNode (c.add((app.newText("p" body))))
        p.addClass("muted")
        return c
    }

    ; --- Master / Detail -------------------------------------------------------------

    ; The look the rows share.
    sfn listTheme:void (app:RaveApp) {
        app.shared("list" "gap" "12px")
        app.shared("item" "flex-direction" "column")
        app.shared("item" "gap" "4px")
        app.shared("item" "padding" "12px 16px")
        app.shared("item" "border" "1px solid var(--line)")
        app.shared("item" "border-radius" "var(--radius)")
        app.shared("item" "background-color" "var(--bg)")
        app.shared("item" "color" "var(--ink)")
        app.shared("item" "cursor" "pointer")
        app.shared("badge" "width" "fit-content")
        app.shared("badge" "padding" "2px 8px")
        app.shared("badge" "border-radius" "999px")
        app.shared("badge" "background-color" "var(--panel)")
        app.shared("badge" "border" "1px solid var(--line)")
        app.shared("badge" "font-size" "12px")
        app.shared("badge" "color" "var(--muted)")
    }

    ; The five rows the pattern ships with: something to look at on the first
    ; screen, and something for the detail route to be about.
    sfn seedItems:RaveCollection (app:RaveApp) {
        def coll:RaveCollection (app.addCollection("items"))
        coll.addField("id" "Id")
        coll.addField("title" "Title")
        coll.addField("status" "Status")
        coll.addField("summary" "Summary")
        def a:RaveRow (coll.addRow())
        a.set("title" "Onboarding email")
        a.set("status" "Draft")
        a.set("summary" "The first message a new account gets.")
        def b:RaveRow (coll.addRow())
        b.set("title" "Quarterly invoice")
        b.set("status" "Sent")
        b.set("summary" "What the account owes for the quarter just closed.")
        def c:RaveRow (coll.addRow())
        c.set("title" "Retention report")
        c.set("status" "In review")
        c.set("summary" "Who came back this month, and who did not.")
        def d:RaveRow (coll.addRow())
        d.set("title" "Pricing change")
        d.set("status" "Draft")
        d.set("summary" "The new plan table, and who it moves.")
        def e:RaveRow (coll.addRow())
        e.set("title" "Support backlog")
        e.set("status" "Done")
        e.set("summary" "Every ticket older than a week, and its owner.")
        return coll
    }

    ; The list, as nodes. It is built twice — once for the list route, once
    ; for the detail route's left column — because an instance of a component
    ; is not yet expanded at build time; the rows themselves are one
    ; collection, so the two lists can never disagree.
    sfn itemList:RaveNode (app:RaveApp parent:RaveNode) {
        def list:RaveNode (parent.add((app.newNode("div" "Item list"))))
        list.addClass("list")
        list.repeat = "items"
        list.label = "Items"
        def item:RaveNode (list.add((app.newNode("a" "Item"))))
        item.addClass("item")
        item.label = "{title}"
        item.on("navigate" "/items/{id}")
        def t:RaveNode (item.add((app.newText("h3" "{title}"))))
        t.addClass("subtitle")
        def st:RaveNode (item.add((app.newText("span" "{status}"))))
        st.addClass("badge")
        return list
    }

    ; A list route and a detail route over one collection: `/items` and
    ; `/items/:id`. The detail route is two columns on a desktop and one on a
    ; phone, where the list becomes a `Back` link instead.
    sfn withMasterDetail:void (app:RaveApp) {
        RavePatterns.listTheme(app)
        RavePatterns.seedItems(app)

        def list:RaveNode (app.newPage("Items"))
        app.style(list "gap" "16px")
        def lh:RaveNode (list.add((app.newText("h1" "Items"))))
        lh.addClass("title")
        RavePatterns.itemList(app list)

        def detail:RaveNode (app.newPage("Item"))
        detail.source = "items"
        detail.sourceKey = "id"
        app.style(detail "display" "grid")
        app.style(detail "grid-template-columns" "320px 1fr")
        app.style(detail "gap" "24px")
        app.styleAt(detail (app.below("md")) "grid-template-columns" "1fr")

        def side:RaveNode (detail.add((app.newNode("aside" "Item list column"))))
        side.label = "Items"
        app.style(side "gap" "12px")
        app.style(side "min-width" "0")
        app.styleAt(side (app.below("md")) "display" "none")
        RavePatterns.itemList(app side)

        def pane:RaveNode (detail.add((app.newNode("section" "Item detail"))))
        pane.label = "{title}"
        app.style(pane "gap" "12px")
        app.style(pane "min-width" "0")
        def back:RaveNode (pane.add((app.newText("a" "← Back to items"))))
        back.addClass("navlink")
        back.on("navigate" "/items")
        app.style(back "display" "none")
        app.style(back "width" "fit-content")
        app.styleAt(back (app.below("md")) "display" "flex")
        def dh:RaveNode (pane.add((app.newText("h1" "{title}"))))
        dh.addClass("title")
        def ds:RaveNode (pane.add((app.newText("span" "{status}"))))
        ds.addClass("badge")
        def dp:RaveNode (pane.add((app.newText("p" "{summary}"))))
        dp.addClass("muted")

        def shellId:int 0
        if ((array_length app.routes) > 0) {
            def first:RaveRoute (itemAt app.routes 0)
            shellId = first.layoutId
        }
        app.addRoute("/items" "Items" list shellId)
        app.addRoute("/items/:id" "Item" detail shellId)

        ; and a way in from the shell's own navigation
        def navId:int (app.idOfNamed("nav" "Main navigation"))
        if (navId > 0) {
            def nav:RaveNode (app.node(navId))
            def link:RaveNode (nav.add((app.newText("a" "Items"))))
            link.addClass("navlink")
            link.on("navigate" "/items")
        }
    }

    ; --- Settings Layout ----------------------------------------------------------------

    ; A layout inside the shell: a tab list down the left and the panel the
    ; tab names on the right, stacking into one column on a phone. The three
    ; panels are pages of their own, so each tab is a route somebody can link
    ; to and come back to.
    sfn withSettingsLayout:void (app:RaveApp) {
        app.shared("tablist" "gap" "4px")
        app.shared("tab" "padding" "8px 12px")
        app.shared("tab" "border-radius" "var(--radius)")
        app.shared("tab" "color" "var(--ink)")
        app.shared("tab" "cursor" "pointer")

        def settingsRoute:RaveRoute (app.routeAt("/settings"))
        def shellId:int settingsRoute.layoutId

        def lay:RaveNode (app.newLayout("Settings Layout"))
        lay.parentLayout = shellId
        app.style(lay "gap" "16px")
        app.style(lay "min-width" "0")
        def h1:RaveNode (lay.add((app.newText("h1" "Settings"))))
        h1.addClass("title")
        def split:RaveNode (lay.add((app.newNode("div" "Settings body"))))
        app.style(split "display" "grid")
        app.style(split "grid-template-columns" "200px 1fr")
        app.style(split "gap" "24px")
        app.styleAt(split (app.below("md")) "grid-template-columns" "1fr")

        def tabs:RaveNode (split.add((app.newNode("nav" "Settings sections"))))
        tabs.label = "Settings sections"
        tabs.addClass("tablist")
        app.styleAt(tabs (app.below("md")) "flex-direction" "row")
        app.styleAt(tabs (app.below("md")) "flex-wrap" "wrap")
        def t1:RaveNode (tabs.add((app.newText("a" "Account"))))
        t1.addClass("tab")
        t1.on("navigate" "/settings")
        def t2:RaveNode (tabs.add((app.newText("a" "Notifications"))))
        t2.addClass("tab")
        t2.on("navigate" "/settings/notifications")
        def t3:RaveNode (tabs.add((app.newText("a" "Billing"))))
        t3.addClass("tab")
        t3.on("navigate" "/settings/billing")

        def panel:RaveNode (split.add((app.newNode("section" "Settings panel"))))
        panel.label = "Settings"
        app.style(panel "gap" "16px")
        app.style(panel "min-width" "0")
        panel.add((app.newSlot()))

        ; the page that was at /settings becomes the first tab's panel, minus
        ; the heading the layout now carries
        def account:RaveNode (app.node(settingsRoute.pageId))
        def oldHeading:int (app.findIn(account "h1" "Settings"))
        if (oldHeading > 0) {
            app.detach(oldHeading)
        }
        settingsRoute.layoutId = lay.id

        def notif:RaveNode (app.newPage("Notifications"))
        app.style(notif "gap" "12px")
        def nh:RaveNode (notif.add((app.newText("h2" "Notifications"))))
        nh.addClass("subtitle")
        def nform:RaveNode (notif.add((app.newNode("form" "Notification settings"))))
        nform.label = "Notifications"
        app.style(nform "gap" "12px")
        app.style(nform "max-width" "480px")
        RavePatterns.field(app nform "Email digest" "Weekly")
        RavePatterns.field(app nform "Product news" "Off")
        def nsave:RaveNode (RavePatterns.button(app nform "Save changes"))
        app.style(nsave "width" "fit-content")

        def billing:RaveNode (app.newPage("Billing"))
        app.style(billing "gap" "12px")
        def bh:RaveNode (billing.add((app.newText("h2" "Billing"))))
        bh.addClass("subtitle")
        def bp:RaveNode (billing.add((app.newText("p" "The plan this account is on, and what it costs."))))
        bp.addClass("muted")
        RavePatterns.card(app billing "Team plan" "€49 a month, billed yearly.")

        app.addRoute("/settings/notifications" "Notifications" notif lay.id)
        app.addRoute("/settings/billing" "Billing" billing lay.id)
        def i:int 0
        while (i < (array_length app.routes)) {
            def r:RaveRoute (itemAt app.routes i)
            if ((r.path == "/settings/notifications") || (r.path == "/settings/billing")) {
                r.protected = settingsRoute.protected
            }
            i = (i + 1)
        }
    }

    ; --- Marketing + App ------------------------------------------------------------------

    ; Every `navigate` in the document that named one path now names another.
    sfn renameNavigation:void (app:RaveApp n:RaveNode from:string to:string) {
        def i:int 0
        while (i < (array_length n.actions)) {
            def a:RaveAction (itemAt n.actions i)
            if ((a.kind == "navigate") && (a.arg == from)) {
                a.arg = to
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length n.children)) {
            def c:RaveNode (itemAt n.children j)
            RavePatterns.renameNavigation(app c from to)
            j = (j + 1)
        }
    }

    sfn renameEverywhere:void (app:RaveApp from:string to:string) {
        def i:int 0
        while (i < (array_length app.layouts)) {
            RavePatterns.renameNavigation(app (itemAt app.layouts i) from to)
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length app.pages)) {
            RavePatterns.renameNavigation(app (itemAt app.pages j) from to)
            j = (j + 1)
        }
    }

    ; The whole application moves under a prefix, links and all. `/` becomes
    ; `/app`, `/dashboard` becomes `/app/dashboard`, and every button that
    ; named the old path names the new one.
    sfn moveUnder:void (app:RaveApp prefix:string) {
        def froms:[string]
        def tos:[string]
        def i:int 0
        while (i < (array_length app.routes)) {
            def r:RaveRoute (itemAt app.routes i)
            def from:string r.path
            def to:string (prefix + from)
            if (from == "/") {
                to = prefix
            }
            push froms from
            push tos to
            r.path = to
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length froms)) {
            RavePatterns.renameEverywhere(app (itemAt froms j) (itemAt tos j))
            j = (j + 1)
        }
        if (app.afterLogin == "/") {
            app.afterLogin = prefix
        }
    }

    ; A public front on a top bar, in front of an application on the shell.
    sfn withMarketing:void (app:RaveApp) {
        app.shared("hero" "gap" "16px")
        app.shared("hero" "padding" "64px 24px")
        app.shared("hero" "align-items" "center")
        app.shared("display" "font-size" "40px")
        app.shared("display" "font-weight" "700")

        def top:RaveNode (app.newLayout("Marketing Layout"))
        app.style(top "width" "100%")
        app.style(top "height" "100%")
        app.style(top "background-color" "var(--bg)")
        app.style(top "color" "var(--ink)")
        app.style(top "font-size" "14px")

        def bar:RaveNode (top.add((app.newNode("header" "Top bar"))))
        app.style(bar "flex-direction" "row")
        app.style(bar "align-items" "center")
        app.style(bar "justify-content" "space-between")
        app.style(bar "height" "56px")
        app.style(bar "padding" "0 24px")
        app.style(bar "border" "1px solid var(--line)")
        def brand:RaveNode (bar.add((app.newText("span" app.name))))
        brand.addClass("brand")
        def links:RaveNode (bar.add((app.newNode("nav" "Site navigation"))))
        links.label = "Site navigation"
        app.style(links "flex-direction" "row")
        app.style(links "align-items" "center")
        app.style(links "gap" "8px")
        def home:RaveNode (links.add((app.newText("a" "Home"))))
        home.addClass("navlink")
        home.on("navigate" "/")
        def pricing:RaveNode (links.add((app.newText("a" "Pricing"))))
        pricing.addClass("navlink")
        pricing.on("navigate" "/pricing")
        def toApp:RaveNode (RavePatterns.button(app links "Open the app"))
        toApp.on("navigate" "/app/dashboard")

        def body:RaveNode (top.add((app.newNode("main" "Main"))))
        app.style(body "flex-grow" "1")
        app.style(body "min-height" "0")
        app.style(body "padding" "24px")
        body.add((app.newSlot()))

        def foot:RaveNode (top.add((app.newNode("footer" "Footer"))))
        foot.label = "Footer"
        app.style(foot "height" "40px")
        app.style(foot "padding" "0 24px")
        app.style(foot "justify-content" "center")
        app.style(foot "border" "1px solid var(--line)")
        def fine:RaveNode (foot.add((app.newText("span" ("© " + app.name)))))
        fine.addClass("muted")

        def front:RaveNode (app.newPage("Front page"))
        front.addClass("hero")
        def h1:RaveNode (front.add((app.newText("h1" ("Everything " + app.name + " does, on one page")))))
        h1.addClass("display")
        def lead:RaveNode (front.add((app.newText("p" "Designed in Rave, and already running."))))
        lead.addClass("muted")
        def cta:RaveNode (RavePatterns.button(app front "Start now"))
        cta.on("navigate" "/app/dashboard")

        def plans:RaveNode (app.newPage("Pricing"))
        app.style(plans "gap" "24px")
        def ph:RaveNode (plans.add((app.newText("h1" "Pricing"))))
        ph.addClass("title")
        def grid:RaveNode (plans.add((app.newNode("div" "Plans"))))
        app.style(grid "display" "grid")
        app.style(grid "grid-template-columns" "repeat(3, 1fr)")
        app.style(grid "gap" "24px")
        app.styleAt(grid (app.below("md")) "grid-template-columns" "1fr")
        RavePatterns.card(app grid "Solo" "€9 a month. One seat, every feature.")
        RavePatterns.card(app grid "Team" "€49 a month. Ten seats and shared projects.")
        RavePatterns.card(app grid "Company" "Let us talk. Single sign-on and a contract.")

        app.addRoute("/" "Home" front top.id)
        app.addRoute("/pricing" "Pricing" plans top.id)
    }

    ; --- CRUD --------------------------------------------------------------------------

    sfn crudTheme:void (app:RaveApp) {
        app.shared("scrim" "position" "fixed")
        app.shared("scrim" "left" "0px")
        app.shared("scrim" "top" "0px")
        app.shared("scrim" "right" "0px")
        app.shared("scrim" "bottom" "0px")
        app.shared("scrim" "align-items" "center")
        app.shared("scrim" "justify-content" "center")
        app.shared("scrim" "padding" "24px")
        app.shared("scrim" "background-color" "rgba(9, 9, 11, 0.45)")

        app.shared("dialog" "width" "420px")
        app.shared("dialog" "max-width" "100%")
        app.shared("dialog" "gap" "16px")
        app.shared("dialog" "padding" "24px")
        app.shared("dialog" "background-color" "var(--bg)")
        app.shared("dialog" "color" "var(--ink)")
        app.shared("dialog" "border" "1px solid var(--line)")
        app.shared("dialog" "border-radius" "var(--radius)")

        app.shared("actions" "flex-direction" "row")
        app.shared("actions" "gap" "8px")
        app.shared("actions" "justify-content" "flex-end")

        app.shared("btn-danger" "background-color" "#b91c1c")
        app.shared("btn-danger" "color" "#ffffff")

        app.shared("toast" "position" "fixed")
        app.shared("toast" "left" "24px")
        app.shared("toast" "bottom" "24px")
        app.shared("toast" "padding" "12px 16px")
        app.shared("toast" "border-radius" "var(--radius)")
        app.shared("toast" "background-color" "var(--ink)")
        app.shared("toast" "color" "var(--bg)")
        app.shared("toast" "font-size" "14px")
    }

    ; A field whose input writes a collection field when `Create` runs.
    sfn boundField:RaveNode (app:RaveApp parent:RaveNode label:string placeholder:string field:string) {
        def f:RaveNode (RavePatterns.field(app parent label placeholder))
        def inputId:int (app.findIn(f "input" label))
        if (inputId > 0) {
            def input:RaveNode (app.node(inputId))
            input.bind = field
        }
        return f
    }

    ; Create and Delete over the Master / Detail routes: a dialog that makes
    ; a row out of what was typed into it, an alert dialog that asks before a
    ; row goes, and a toast that says which happened. `withMasterDetail` has
    ; to have run first — this is the pattern the plan composes, not a
    ; separate application.
    sfn withCrud:void (app:RaveApp) {
        RavePatterns.crudTheme(app)

        ; --- the list route gains a New item button and its dialog ---------------
        def listRoute:RaveRoute (app.routeAt("/items"))
        def list:RaveNode (app.node(listRoute.pageId))
        def bar:RaveNode (app.newNode("div" "List actions"))
        app.style(bar "flex-direction" "row")
        app.style(bar "align-items" "center")
        app.style(bar "justify-content" "space-between")
        app.style(bar "gap" "16px")
        def heading:int (app.findIn(list "h1" "Items"))
        if (heading > 0) {
            app.detach(heading)
            bar.add((app.node(heading)))
        }
        def newBtn:RaveNode (RavePatterns.button(app bar "New item"))
        newBtn.on("open" "create")
        app.attach(list.id bar.id 0)

        def scrim:RaveNode (list.add((app.newOverlay("create" "New item"))))
        scrim.addClass("scrim")
        def panel:RaveNode (scrim.add((app.newNode("section" "New item"))))
        panel.addClass("dialog")
        panel.label = "New item"
        def ph:RaveNode (panel.add((app.newText("h2" "New item"))))
        ph.addClass("title")
        def pform:RaveNode (panel.add((app.newNode("form" "New item form"))))
        pform.label = "New item"
        app.style(pform "gap" "12px")
        RavePatterns.boundField(app pform "Title" "What it is called" "title")
        RavePatterns.boundField(app pform "Summary" "What it is about" "summary")
        def pacts:RaveNode (panel.add((app.newNode("div" "New item actions"))))
        pacts.addClass("actions")
        def cancel:RaveNode (RavePatterns.button(app pacts "Cancel"))
        cancel.addClass("btn-ghost")
        cancel.on("close" "")
        def make:RaveNode (RavePatterns.button(app pacts "Create"))
        make.on("create" "items")
        make.on("close" "")
        make.on("toast" "Item created")

        ; --- the detail route gains Delete and its confirmation ------------------
        def paneId:int (app.idOfNamed("section" "Item detail"))
        def pane:RaveNode (app.node(paneId))
        def dacts:RaveNode (pane.add((app.newNode("div" "Item actions"))))
        dacts.addClass("actions")
        app.style(dacts "justify-content" "flex-start")
        def del:RaveNode (RavePatterns.button(app dacts "Delete"))
        del.addClass("btn-danger")
        del.on("open" "confirm")

        def ask:RaveNode (pane.add((app.newOverlay("confirm" "Delete this item?"))))
        ask.addClass("scrim")
        def askPanel:RaveNode (ask.add((app.newNode("section" "Delete this item?"))))
        askPanel.addClass("dialog")
        askPanel.label = "Delete this item?"
        def ah:RaveNode (askPanel.add((app.newText("h2" "Delete this item?"))))
        ah.addClass("title")
        def ap:RaveNode (askPanel.add((app.newText("p" "\"{title}\" goes, and nothing brings it back."))))
        ap.addClass("muted")
        def aacts:RaveNode (askPanel.add((app.newNode("div" "Confirm actions"))))
        aacts.addClass("actions")
        def keep:RaveNode (RavePatterns.button(app aacts "Keep it"))
        keep.addClass("btn-ghost")
        keep.on("close" "")
        def gone:RaveNode (RavePatterns.button(app aacts "Delete"))
        gone.addClass("btn-danger")
        gone.on("remove" "items/{id}")
        gone.on("close" "")
        gone.on("toast" "Item deleted")
        gone.on("navigate" "/items")

        ; --- and the shell says which of them happened ---------------------------
        def shellId:int listRoute.layoutId
        if (shellId > 0) {
            def shell:RaveNode (app.node(shellId))
            def toast:RaveNode (shell.add((app.newToast())))
            toast.addClass("toast")
        }
    }

    ; --- Auth Flow -----------------------------------------------------------------

    ; Adds `/login` on its own centred layout, protects every route but the
    ; landing page and the login page, and sends a fresh login to the
    ; dashboard.
    sfn withAuth:void (app:RaveApp) {
        app.authEnabled = true
        app.loginRoute = "/login"
        app.afterLogin = "/dashboard"

        def authLayout:RaveNode (app.newLayout("Auth Layout"))
        app.style(authLayout "width" "100%")
        app.style(authLayout "height" "100%")
        app.style(authLayout "align-items" "center")
        app.style(authLayout "justify-content" "center")
        app.style(authLayout "background-color" "var(--panel)")
        app.style(authLayout "color" "var(--ink)")
        app.style(authLayout "font-size" "14px")
        def slot:RaveNode (authLayout.add((app.newSlot())))
        app.style(slot "width" "360px")
        app.style(slot "max-width" "100%")
        app.styleAt(slot (app.below("md")) "width" "100%")
        app.styleAt(slot (app.below("md")) "padding" "16px")

        def login:RaveNode (app.newPage("Login"))
        login.addClass("card")
        app.style(login "gap" "16px")
        app.style(login "padding" "24px")
        def h1:RaveNode (login.add((app.newText("h1" "Sign in"))))
        h1.addClass("title")
        def form:RaveNode (login.add((app.newNode("form" "Sign-in form"))))
        form.label = "Sign in"
        app.style(form "gap" "12px")
        RavePatterns.field(app form "Email" "you@example.com")
        RavePatterns.field(app form "Password" "••••••••")
        def go:RaveNode (RavePatterns.button(app form "Sign in"))
        go.on("login" "")
        def back:RaveNode (login.add((app.newText("a" "Back to the front page"))))
        back.addClass("muted")
        back.on("navigate" "/")

        app.addRoute("/login" "Sign in" login authLayout.id)
        def i:int 0
        while (i < (array_length app.routes)) {
            def r:RaveRoute (itemAt app.routes i)
            if ((r.path != "/") && (r.path != "/login")) {
                r.protected = true
            }
            i = (i + 1)
        }
    }

    ; The wizard's answer for the default choices: a dashboard app that signs in.
    sfn saasStarter:RaveApp (name:string) {
        def app:RaveApp (RavePatterns.dashboardShell(name))
        RavePatterns.withAuth(app)
        return app
    }

    ; Dashboard Shell with a list and a detail route on it.
    sfn masterDetail:RaveApp (name:string) {
        def app:RaveApp (RavePatterns.dashboardShell(name))
        RavePatterns.withMasterDetail(app)
        RavePatterns.withAuth(app)
        return app
    }

    ; Dashboard Shell with the settings routes on a layout of their own.
    sfn settingsLayout:RaveApp (name:string) {
        def app:RaveApp (RavePatterns.dashboardShell(name))
        RavePatterns.withSettingsLayout(app)
        RavePatterns.withAuth(app)
        return app
    }

    ; A public front page and a private application, in one document.
    sfn marketingApp:RaveApp (name:string) {
        def app:RaveApp (RavePatterns.dashboardShell(name))
        RavePatterns.moveUnder(app "/app")
        RavePatterns.withMarketing(app)
        RavePatterns.withAuth(app)
        ; the front page and the price list are the public half
        def i:int 0
        while (i < (array_length app.routes)) {
            def r:RaveRoute (itemAt app.routes i)
            if ((r.path == "/") || (r.path == "/pricing")) {
                r.protected = false
            }
            i = (i + 1)
        }
        app.afterLogin = "/app/dashboard"
        return app
    }

    ; Master / Detail, and the two things a reader does to the rows.
    sfn crud:RaveApp (name:string) {
        def app:RaveApp (RavePatterns.dashboardShell(name))
        RavePatterns.withMasterDetail(app)
        RavePatterns.withCrud(app)
        RavePatterns.withAuth(app)
        return app
    }
}

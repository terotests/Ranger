; ==============================================================================
; ErazerLayout.rgr — layout groups from Erazer primitives, not screenshot pixels
; ==============================================================================
;
; Erazer already has bounding boxes and a widget type. This module turns a
; set of those primitives into em-normalised geometry features and ranks
; candidate groups with a two-layer MLP (list / form / toolbar / …).
;
; Grouping stays heuristic. The net only says what a candidate is. A user
; label on a selection is one training point, then augmentation turns it
; into many. Custom class names grow the output layer.
; ==============================================================================

Import "ErazerTypes.rgr"

class ErazerLayoutBox {
    def type:string "label"
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def fontSize:double 14.0
    def index:int 0

    Constructor () {
    }

    sfn of:ErazerLayoutBox (type:string x:double y:double w:double h:double fontSize:double) {
        def b (new ErazerLayoutBox())
        b.type = type
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.fontSize = fontSize
        return b
    }

    fn copy:ErazerLayoutBox () {
        def b:ErazerLayoutBox (ErazerLayoutBox.of(type x y w h fontSize))
        b.index = index
        return b
    }

    fn maxX:double () {
        return (x + w)
    }

    fn maxY:double () {
        return (y + h)
    }

    fn cx:double () {
        return (x + (w * 0.5))
    }

    fn cy:double () {
        return (y + (h * 0.5))
    }
}

class ErazerLayoutSet {
    def boxes:[ErazerLayoutBox]

    Constructor () {
        def b:[ErazerLayoutBox]
        boxes = b
    }

    sfn of:ErazerLayoutSet (boxes:[ErazerLayoutBox]) {
        def s (new ErazerLayoutSet())
        s.boxes = boxes
        return s
    }
}

class ErazerLayoutGuess {
    def type:string "other"
    def confidence:double 0.0
    def axis:string "vertical"
    def items:int 0
    def alignment:string "start"
    def spacingMean:double 0.0
    def spacingVar:double 0.0
    def pattern:string ""
    def members:[int]
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0

    Constructor () {
        def m:[int]
        members = m
    }
}

; Hand-crafted geometry. 40 doubles, scale-free as far as em + relative coords go.
class ErazerLayoutFeat {

    Constructor () {
    }

    sfn featCount:int () {
        return 40
    }

    sfn absD:double (v:double) {
        if (v < 0.0) {
            return (0.0 - v)
        }
        return v
    }

    sfn minD:double (a:double b:double) {
        if (a < b) {
            return a
        }
        return b
    }

    sfn maxD:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }

    sfn clamp01:double (v:double) {
        if (v < 0.0) {
            return 0.0
        }
        if (v > 1.0) {
            return 1.0
        }
        return v
    }

    ; x / (1+|x|) → (-1, 1), so a 12em gap and a 40em gap stay in range.
    sfn squash:double (v:double) {
        def a:double (ErazerLayoutFeat.absD(v))
        if (v < 0.0) {
            return ((0.0 - a) / (1.0 + a))
        }
        return (v / (1.0 + v))
    }

    sfn zeros:[double] (n:int) {
        def a:[double]
        def i:int 0
        while (i < n) {
            push a 0.0
            i = (i + 1)
        }
        return a
    }

    sfn meanOf:double (xs:[double]) {
        def n:int (array_length xs)
        if (n <= 0) {
            return 0.0
        }
        def s:double 0.0
        def i:int 0
        while (i < n) {
            s = (s + (itemAt xs i))
            i = (i + 1)
        }
        return (s / (to_double n))
    }

    sfn stdOf:double (xs:[double]) {
        def n:int (array_length xs)
        if (n < 2) {
            return 0.0
        }
        def mu:double (ErazerLayoutFeat.meanOf(xs))
        def acc:double 0.0
        def i:int 0
        while (i < n) {
            def d:double ((itemAt xs i) - mu)
            acc = (acc + (d * d))
            i = (i + 1)
        }
        def var:double (acc / (to_double n))
        if (var <= 0.0) {
            return 0.0
        }
        return (sqrt var)
    }

    sfn medianOf:double (xs:[double]) {
        def n:int (array_length xs)
        if (n <= 0) {
            return 0.0
        }
        def a:[double]
        def i:int 0
        while (i < n) {
            push a (itemAt xs i)
            i = (i + 1)
        }
        def p:int 1
        while (p < n) {
            def j:int p
            while (j > 0) {
                def cur:double (itemAt a j)
                def prev:double (itemAt a (j - 1))
                if (cur < prev) {
                    set a j prev
                    set a (j - 1) cur
                    j = (j - 1)
                } {
                    j = 0
                }
            }
            p = (p + 1)
        }
        def mid:int (idiv n 2)
        if (((n - ((idiv n 2) * 2)) == 0) && (mid > 0)) {
            return ((((itemAt a (mid - 1)) + (itemAt a mid))) * 0.5)
        }
        return (itemAt a mid)
    }

    sfn isWidget:boolean (role:string) {
        if (role == "label") {
            return true
        }
        if (role == "text") {
            return true
        }
        if (role == "checkbox") {
            return true
        }
        if (role == "button") {
            return true
        }
        if (role == "textfield") {
            return true
        }
        if (role == "icon") {
            return true
        }
        if (role == "tab") {
            return true
        }
        if (role == "menuitem") {
            return true
        }
        if (role == "slider") {
            return true
        }
        if (role == "sliderthumb") {
            return true
        }
        return false
    }

    sfn typeBucket:int (t:string) {
        if ((t == "label") || (t == "text") || (t == "menuitem")) {
            return 0
        }
        if (t == "checkbox") {
            return 1
        }
        if ((t == "panel") || (t == "form") || (t == "card")) {
            return 2
        }
        if (t == "icon") {
            return 3
        }
        if ((t == "button") || (t == "tab")) {
            return 4
        }
        if ((t == "textfield") || (t == "slider")) {
            return 5
        }
        return 6
    }

    sfn boxFromNode:ErazerLayoutBox (n:ErazerNode) {
        def font:double (to_double n.fontSize)
        if (font < 1.0) {
            font = 14.0
        }
        def role:string n.role
        if (role == "text") {
            role = "label"
        }
        return (ErazerLayoutBox.of(role (to_double n.x) (to_double n.y) (to_double n.w) (to_double n.h) font))
    }

    sfn collectFrom:void (n:ErazerNode pageW:int pageH:int out:[ErazerLayoutBox]) {
        def take:boolean (ErazerLayoutFeat.isWidget(n.role))
        if (take == false) {
            if ((n.role == "panel") || (n.role == "form") || (n.role == "menu")) {
                if ((n.w >= 28) && (n.h >= 28)) {
                    def area:int (n.w * n.h)
                    def pageA:int (pageW * pageH)
                    if ((pageA <= 0) || (area < (idiv (pageA * 45) 100))) {
                        take = true
                    }
                }
            }
        }
        if take {
            if (n.role != "page") {
                def b:ErazerLayoutBox (ErazerLayoutFeat.boxFromNode(n))
                b.index = (array_length out)
                n.boxId = (b.index + 1)
                push out b
            }
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            ErazerLayoutFeat.collectFrom(k pageW pageH out)
            i = (i + 1)
        }
    }

    sfn collectTree:[ErazerLayoutBox] (root:ErazerNode pageW:int pageH:int) {
        def out:[ErazerLayoutBox]
        ErazerLayoutFeat.collectFrom(root pageW pageH out)
        return out
    }

    sfn baseEm:double (boxes:[ErazerLayoutBox]) {
        def fonts:[double]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            if (b.fontSize > 1.0) {
                push fonts b.fontSize
            }
            i = (i + 1)
        }
        if ((array_length fonts) == 0) {
            return 14.0
        }
        def med:double (ErazerLayoutFeat.medianOf(fonts))
        if (med < 4.0) {
            return 14.0
        }
        return med
    }

    sfn sortedYX:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < (array_length boxes)) {
            push out (itemAt boxes i)
            i = (i + 1)
        }
        def n:int (array_length out)
        def a:int 1
        while (a < n) {
            def j:int a
            while (j > 0) {
                def cur:ErazerLayoutBox (itemAt out j)
                def prev:ErazerLayoutBox (itemAt out (j - 1))
                def doSwap:boolean false
                if (cur.y < prev.y) {
                    doSwap = true
                }
                if ((cur.y == prev.y) && (cur.x < prev.x)) {
                    doSwap = true
                }
                if doSwap {
                    set out j prev
                    set out (j - 1) cur
                    j = (j - 1)
                } {
                    j = 0
                }
            }
            a = (a + 1)
        }
        return out
    }

    sfn copyBoxes:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            push out (b.copy())
            i = (i + 1)
        }
        return out
    }

    sfn memberSig:string (boxes:[ErazerLayoutBox]) {
        def ids:[int]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            push ids b.index
            i = (i + 1)
        }
        def n:int (array_length ids)
        def a:int 1
        while (a < n) {
            def j:int a
            while (j > 0) {
                def cur:int (itemAt ids j)
                def prev:int (itemAt ids (j - 1))
                if (cur < prev) {
                    set ids j prev
                    set ids (j - 1) cur
                    j = (j - 1)
                } {
                    j = 0
                }
            }
            a = (a + 1)
        }
        def s:string ""
        def k:int 0
        while (k < n) {
            if (k > 0) {
                s = (s + ",")
            }
            s = (s + (to_string (itemAt ids k)))
            k = (k + 1)
        }
        return s
    }

    ; 40-d vector. Relative coords + em gaps, not raw pixels.
    sfn features:[double] (boxes:[ErazerLayoutBox]) {
        def f:[double] (ErazerLayoutFeat.zeros(40))
        def n:int (array_length boxes)
        if (n <= 0) {
            return f
        }
        def em:double (ErazerLayoutFeat.baseEm(boxes))
        if (em < 1.0) {
            em = 14.0
        }
        def xs:[double]
        def ys:[double]
        def ws:[double]
        def hs:[double]
        def cxs:[double]
        def cys:[double]
        def rxs:[double]
        def minX:double 0.0
        def minY:double 0.0
        def maxX:double 0.0
        def maxY:double 0.0
        def i:int 0
        while (i < n) {
            def b:ErazerLayoutBox (itemAt boxes i)
            if (i == 0) {
                minX = b.x
                minY = b.y
                maxX = (b.maxX())
                maxY = (b.maxY())
            }
            minX = (ErazerLayoutFeat.minD(minX b.x))
            minY = (ErazerLayoutFeat.minD(minY b.y))
            maxX = (ErazerLayoutFeat.maxD(maxX (b.maxX())))
            maxY = (ErazerLayoutFeat.maxD(maxY (b.maxY())))
            push xs b.x
            push ys b.y
            push ws b.w
            push hs b.h
            push cxs (b.cx())
            push cys (b.cy())
            i = (i + 1)
        }
        def gw:double (ErazerLayoutFeat.maxD(1.0 (maxX - minX)))
        def gh:double (ErazerLayoutFeat.maxD(1.0 (maxY - minY)))
        def j:int 0
        while (j < n) {
            def b2:ErazerLayoutBox (itemAt boxes j)
            push rxs ((b2.x - minX) / gw)
            j = (j + 1)
        }
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def vGaps:[double]
        def hGaps:[double]
        def leftHits:double 0.0
        def widthRatios:[double]
        def heightRatios:[double]
        def overlapH:double 0.0
        def pairN:int 0
        def p:int 0
        while (p < (n - 1)) {
            def a:ErazerLayoutBox (itemAt ordered p)
            def b:ErazerLayoutBox (itemAt ordered (p + 1))
            def vg:double (b.y - (a.maxY()))
            if (vg < 0.0) {
                vg = 0.0
            }
            push vGaps vg
            def hg:double 0.0
            if (b.x >= (a.maxX())) {
                hg = (b.x - (a.maxX()))
            } {
                if (a.x >= (b.maxX())) {
                    hg = (a.x - (b.maxX()))
                }
            }
            push hGaps hg
            def dx:double (ErazerLayoutFeat.absD((a.x - b.x)))
            if (dx <= (0.35 * em)) {
                leftHits = (leftHits + 1.0)
            }
            def wr:double 1.0
            def aw:double (ErazerLayoutFeat.maxD(1.0 a.w))
            def bw:double (ErazerLayoutFeat.maxD(1.0 b.w))
            wr = ((ErazerLayoutFeat.minD(aw bw)) / (ErazerLayoutFeat.maxD(aw bw)))
            push widthRatios wr
            def ah:double (ErazerLayoutFeat.maxD(1.0 a.h))
            def bh:double (ErazerLayoutFeat.maxD(1.0 b.h))
            push heightRatios ((ErazerLayoutFeat.minD(ah bh)) / (ErazerLayoutFeat.maxD(ah bh)))
            def left:double (ErazerLayoutFeat.maxD(a.x b.x))
            def right:double (ErazerLayoutFeat.minD((a.maxX()) (b.maxX())))
            def ov:double (right - left)
            if (ov < 0.0) {
                ov = 0.0
            }
            def minW:double (ErazerLayoutFeat.minD(a.w b.w))
            if (minW < 1.0) {
                minW = 1.0
            }
            overlapH = (overlapH + (ov / minW))
            pairN = (pairN + 1)
            p = (p + 1)
        }
        def typeN:[double] (ErazerLayoutFeat.zeros(7))
        def t:int 0
        while (t < n) {
            def bx:ErazerLayoutBox (itemAt boxes t)
            def tb:int (ErazerLayoutFeat.typeBucket(bx.type))
            def cur:double (itemAt typeN tb)
            set typeN tb (cur + 1.0)
            t = (t + 1)
        }
        def nn:double (to_double n)
        def dominant:double 0.0
        def u:int 0
        while (u < 7) {
            def tv:double (itemAt typeN u)
            if (tv > dominant) {
                dominant = tv
            }
            u = (u + 1)
        }
        def medX:double (ErazerLayoutFeat.medianOf(xs))
        def medY:double (ErazerLayoutFeat.medianOf(ys))
        def sameCol:double 0.0
        def sameRow:double 0.0
        def s:int 0
        while (s < n) {
            def b3:ErazerLayoutBox (itemAt boxes s)
            if ((ErazerLayoutFeat.absD((b3.x - medX))) <= (0.35 * em)) {
                sameCol = (sameCol + 1.0)
            }
            if ((ErazerLayoutFeat.absD((b3.y - medY))) <= (0.35 * em)) {
                sameRow = (sameRow + 1.0)
            }
            s = (s + 1)
        }
        def minCx:double (ErazerLayoutFeat.medianOf(cxs))
        def maxCx:double minCx
        def minCy:double (ErazerLayoutFeat.medianOf(cys))
        def maxCy:double minCy
        def c:int 0
        while (c < n) {
            def cxv:double (itemAt cxs c)
            def cyv:double (itemAt cys c)
            minCx = (ErazerLayoutFeat.minD(minCx cxv))
            maxCx = (ErazerLayoutFeat.maxD(maxCx cxv))
            minCy = (ErazerLayoutFeat.minD(minCy cyv))
            maxCy = (ErazerLayoutFeat.maxD(maxCy cyv))
            c = (c + 1)
        }
        def xSpan:double (maxCx - minCx)
        def ySpan:double (maxCy - minCy)
        def vMean:double (ErazerLayoutFeat.meanOf(vGaps))
        def vStd:double (ErazerLayoutFeat.stdOf(vGaps))
        def hMean:double (ErazerLayoutFeat.meanOf(hGaps))
        def hStd:double (ErazerLayoutFeat.stdOf(hGaps))
        def wMean:double (ErazerLayoutFeat.meanOf(ws))
        def hMeanB:double (ErazerLayoutFeat.meanOf(hs))
        def wCv:double 0.0
        if (wMean > 0.001) {
            wCv = ((ErazerLayoutFeat.stdOf(ws)) / wMean)
        }
        def hCv:double 0.0
        if (hMeanB > 0.001) {
            hCv = ((ErazerLayoutFeat.stdOf(hs)) / hMeanB)
        }
        def pairPat:double (ErazerLayoutFeat.pairScore(ordered em))
        def pairDen:double 1.0
        if (pairN > 0) {
            pairDen = (to_double pairN)
        }
        def item3:double 0.0
        if (n >= 3) {
            item3 = 1.0
        }
        def item5:double 0.0
        if (n >= 5) {
            item5 = 1.0
        }
        def axis:double 0.0
        def spanSum:double ((xSpan + ySpan) + 1.0)
        axis = ((ySpan - xSpan) / spanSum)
        def gAspect:double (gw / gh)
        set f 0 (ErazerLayoutFeat.clamp01((nn / 12.0)))
        set f 1 (ErazerLayoutFeat.squash((gAspect - 1.0)))
        set f 2 (ErazerLayoutFeat.squash(((gw / em) / 20.0)))
        set f 3 (ErazerLayoutFeat.squash(((gh / em) / 20.0)))
        set f 4 (ErazerLayoutFeat.squash(((ErazerLayoutFeat.stdOf(xs)) / em)))
        set f 5 (ErazerLayoutFeat.squash(((ErazerLayoutFeat.stdOf(ys)) / em)))
        set f 6 (ErazerLayoutFeat.squash(wCv))
        set f 7 (ErazerLayoutFeat.squash(hCv))
        set f 8 (ErazerLayoutFeat.squash(((vMean / em) / 3.0)))
        set f 9 (ErazerLayoutFeat.squash((vStd / em)))
        set f 10 (ErazerLayoutFeat.squash(((hMean / em) / 3.0)))
        set f 11 (ErazerLayoutFeat.squash((hStd / em)))
        set f 12 (1.0 / (1.0 + (vStd / em)))
        set f 13 (1.0 / (1.0 + (hStd / em)))
        set f 14 (sameCol / nn)
        set f 15 (sameRow / nn)
        if (pairN > 0) {
            set f 16 (leftHits / pairDen)
        }
        set f 17 (1.0 / (1.0 + wCv))
        set f 18 ((itemAt typeN 0) / nn)
        set f 19 ((itemAt typeN 1) / nn)
        set f 20 ((itemAt typeN 2) / nn)
        set f 21 ((itemAt typeN 3) / nn)
        set f 22 ((itemAt typeN 4) / nn)
        set f 23 ((itemAt typeN 5) / nn)
        set f 24 (dominant / nn)
        set f 25 pairPat
        set f 26 (ErazerLayoutFeat.clamp01((overlapH / pairDen)))
        set f 27 (ErazerLayoutFeat.meanOf(widthRatios))
        set f 28 (ErazerLayoutFeat.meanOf(heightRatios))
        set f 29 item3
        set f 30 item5
        set f 31 (ErazerLayoutFeat.squash(axis))
        set f 32 (ErazerLayoutFeat.squash((0.0 - axis)))
        set f 33 (ErazerLayoutFeat.meanOf(rxs))
        set f 34 (ErazerLayoutFeat.squash((ErazerLayoutFeat.stdOf(rxs))))
        def rights:[double]
        def ri:int 0
        while (ri < n) {
            def rb:ErazerLayoutBox (itemAt boxes ri)
            push rights (rb.maxX())
            ri = (ri + 1)
        }
        set f 35 (ErazerLayoutFeat.squash(((ErazerLayoutFeat.stdOf(cxs)) / em)))
        set f 36 (ErazerLayoutFeat.squash(((ErazerLayoutFeat.stdOf(rights)) / em)))
        def gapCv:double 0.0
        if (vMean > 0.001) {
            gapCv = (vStd / vMean)
        }
        set f 37 (ErazerLayoutFeat.squash(gapCv))
        def mix:double 0.0
        if ((((itemAt typeN 3) > 0.0) && ((itemAt typeN 0) > 0.0))) {
            mix = 1.0
        }
        set f 38 mix
        def sym:double (ErazerLayoutFeat.absD(((itemAt f 4) - (itemAt f 36))))
        set f 39 (1.0 / (1.0 + sym))
        return f
    }

    ; Repeating multi-type rows (label+checkbox, icon+label, …).
    sfn pairScore:double (ordered:[ErazerLayoutBox] em:double) {
        def n:int (array_length ordered)
        if (n < 4) {
            return 0.0
        }
        def rowStart:[int]
        push rowStart 0
        def i:int 1
        while (i < n) {
            def prev:ErazerLayoutBox (itemAt ordered (i - 1))
            def cur:ErazerLayoutBox (itemAt ordered i)
            if ((ErazerLayoutFeat.absD((cur.y - prev.y))) > (0.45 * em)) {
                push rowStart i
            }
            i = (i + 1)
        }
        def nRows:int (array_length rowStart)
        if (nRows < 2) {
            return 0.0
        }
        def sigs:[string]
        def r:int 0
        while (r < nRows) {
            def a:int (itemAt rowStart r)
            def b:int n
            if (r < (nRows - 1)) {
                b = (itemAt rowStart (r + 1))
            }
            def sig:string ""
            def k:int a
            while (k < b) {
                def box:ErazerLayoutBox (itemAt ordered k)
                if ((strlen sig) > 0) {
                    sig = (sig + "+")
                }
                sig = (sig + box.type)
                k = (k + 1)
            }
            push sigs sig
            r = (r + 1)
        }
        def best:int 0
        def a2:int 0
        while (a2 < (array_length sigs)) {
            def s0:string (itemAt sigs a2)
            def cnt:int 0
            def b2:int 0
            while (b2 < (array_length sigs)) {
                if ((itemAt sigs b2) == s0) {
                    cnt = (cnt + 1)
                }
                b2 = (b2 + 1)
            }
            if (cnt > best) {
                best = cnt
            }
            a2 = (a2 + 1)
        }
        def sBest:string (itemAt sigs 0)
        def look:int 0
        while (look < (array_length sigs)) {
            def cand:string (itemAt sigs look)
            def cnt2:int 0
            def z:int 0
            while (z < (array_length sigs)) {
                if ((itemAt sigs z) == cand) {
                    cnt2 = (cnt2 + 1)
                }
                z = (z + 1)
            }
            if (cnt2 == best) {
                sBest = cand
                look = (array_length sigs)
            } {
                look = (look + 1)
            }
        }
        if ((indexOf sBest "+") < 0) {
            return 0.0
        }
        return ((to_double best) / (to_double nRows))
    }

    sfn describe:ErazerLayoutGuess (boxes:[ErazerLayoutBox] type:string confidence:double) {
        def g (new ErazerLayoutGuess())
        g.type = type
        g.confidence = confidence
        g.items = (array_length boxes)
        if ((array_length boxes) <= 0) {
            return g
        }
        def em:double (ErazerLayoutFeat.baseEm(boxes))
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def minX:double 0.0
        def minY:double 0.0
        def maxX:double 0.0
        def maxY:double 0.0
        def xs:[double]
        def rights:[double]
        def cxs:[double]
        def vGaps:[double]
        def hGaps:[double]
        def i:int 0
        while (i < (array_length ordered)) {
            def b:ErazerLayoutBox (itemAt ordered i)
            push g.members b.index
            if (i == 0) {
                minX = b.x
                minY = b.y
                maxX = (b.maxX())
                maxY = (b.maxY())
            }
            minX = (ErazerLayoutFeat.minD(minX b.x))
            minY = (ErazerLayoutFeat.minD(minY b.y))
            maxX = (ErazerLayoutFeat.maxD(maxX (b.maxX())))
            maxY = (ErazerLayoutFeat.maxD(maxY (b.maxY())))
            push xs b.x
            push rights (b.maxX())
            push cxs (b.cx())
            if (i > 0) {
                def prev:ErazerLayoutBox (itemAt ordered (i - 1))
                def vg:double (b.y - (prev.maxY()))
                if (vg < 0.0) {
                    vg = 0.0
                }
                push vGaps vg
                def hg:double 0.0
                if (b.x >= (prev.maxX())) {
                    hg = (b.x - (prev.maxX()))
                }
                push hGaps hg
            }
            i = (i + 1)
        }
        def cy:[double]
        def cx:[double]
        def qi:int 0
        while (qi < (array_length ordered)) {
            def qb:ErazerLayoutBox (itemAt ordered qi)
            push cy (qb.cy())
            push cx (qb.cx())
            qi = (qi + 1)
        }
        def yVar:double (ErazerLayoutFeat.stdOf(cy))
        def xVar:double (ErazerLayoutFeat.stdOf(cx))
        def vMean:double (ErazerLayoutFeat.meanOf(vGaps))
        def hMean:double (ErazerLayoutFeat.meanOf(hGaps))
        g.x = minX
        g.y = minY
        g.w = (maxX - minX)
        g.h = (maxY - minY)
        if ((yVar >= xVar) || (vMean >= hMean)) {
            g.axis = "vertical"
            g.spacingMean = (vMean / em)
            g.spacingVar = ((ErazerLayoutFeat.stdOf(vGaps)) / em)
        } {
            g.axis = "horizontal"
            g.spacingMean = (hMean / em)
            g.spacingVar = ((ErazerLayoutFeat.stdOf(hGaps)) / em)
        }
        def leftStd:double (ErazerLayoutFeat.stdOf(xs))
        def rightStd:double (ErazerLayoutFeat.stdOf(rights))
        def cenStd:double (ErazerLayoutFeat.stdOf(cxs))
        g.alignment = "start"
        def tol:double (0.35 * em)
        if ((rightStd < leftStd) && (rightStd <= tol) && (leftStd > tol)) {
            g.alignment = "end"
        }
        if ((cenStd < leftStd) && (cenStd < rightStd) && (leftStd > tol) && (rightStd > tol)) {
            g.alignment = "center"
        }
        g.pattern = (ErazerLayoutFeat.patternOf(ordered em))
        return g
    }

    sfn patternOf:string (ordered:[ErazerLayoutBox] em:double) {
        def n:int (array_length ordered)
        if (n <= 0) {
            return ""
        }
        def rowStart:[int]
        push rowStart 0
        def i:int 1
        while (i < n) {
            def prev:ErazerLayoutBox (itemAt ordered (i - 1))
            def cur:ErazerLayoutBox (itemAt ordered i)
            if ((ErazerLayoutFeat.absD((cur.y - prev.y))) > (0.45 * em)) {
                push rowStart i
            }
            i = (i + 1)
        }
        def a:int 0
        def b:int n
        if ((array_length rowStart) > 1) {
            b = (itemAt rowStart 1)
        }
        def out:string ""
        def k:int a
        while (k < b) {
            def box:ErazerLayoutBox (itemAt ordered k)
            if ((strlen out) > 0) {
                out = (out + ",")
            }
            out = (out + box.type)
            k = (k + 1)
        }
        return out
    }

    sfn nearAlign:boolean (a:ErazerLayoutBox b:ErazerLayoutBox em:double vertical:boolean) {
        if vertical {
            def dx:double (ErazerLayoutFeat.absD((a.x - b.x)))
            def dcx:double (ErazerLayoutFeat.absD(((a.cx()) - (b.cx()))))
            if ((dx <= (0.45 * em)) || (dcx <= (0.5 * em))) {
                def wr:double ((ErazerLayoutFeat.minD(a.w b.w)) / (ErazerLayoutFeat.maxD(1.0 (ErazerLayoutFeat.maxD(a.w b.w)))))
                if (wr >= 0.52) {
                    return true
                }
            }
            return false
        }
        def dy:double (ErazerLayoutFeat.absD((a.y - b.y)))
        def dcy:double (ErazerLayoutFeat.absD(((a.cy()) - (b.cy()))))
        if ((dy <= (0.45 * em)) || (dcy <= (0.5 * em))) {
            def hr:double ((ErazerLayoutFeat.minD(a.h b.h)) / (ErazerLayoutFeat.maxD(1.0 (ErazerLayoutFeat.maxD(a.h b.h)))))
            if (hr >= 0.52) {
                return true
            }
        }
        return false
    }

    sfn clusterAxis:[ErazerLayoutSet] (boxes:[ErazerLayoutBox] vertical:boolean) {
        def out:[ErazerLayoutSet]
        def n:int (array_length boxes)
        if (n < 2) {
            return out
        }
        def em:double (ErazerLayoutFeat.baseEm(boxes))
        def used:[int]
        def u:int 0
        while (u < n) {
            push used 0
            u = (u + 1)
        }
        def i:int 0
        while (i < n) {
            def mark:int (itemAt used i)
            if (mark == 0) {
                def seed:ErazerLayoutBox (itemAt boxes i)
                def grp:[ErazerLayoutBox]
                push grp seed
                set used i 1
                def j:int 0
                while (j < n) {
                    def om:int (itemAt used j)
                    if (om == 0) {
                        def other:ErazerLayoutBox (itemAt boxes j)
                        if (ErazerLayoutFeat.nearAlign(seed other em vertical)) {
                            push grp other
                            set used j 1
                        }
                    }
                    j = (j + 1)
                }
                if ((array_length grp) >= 2) {
                    push out (ErazerLayoutSet.of(grp))
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn pairRowSets:[ErazerLayoutSet] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutSet]
        def n:int (array_length boxes)
        if (n < 4) {
            return out
        }
        def em:double (ErazerLayoutFeat.baseEm(boxes))
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def score:double (ErazerLayoutFeat.pairScore(ordered em))
        if (score >= 0.66) {
            push out (ErazerLayoutSet.of(ordered))
        }
        return out
    }

    sfn candidates:[ErazerLayoutSet] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutSet]
        def seen:[string:int]
        def n:int (array_length boxes)
        if (n < 2) {
            return out
        }
        if (n <= 16) {
            ErazerLayoutFeat.addCand(out seen (ErazerLayoutSet.of(boxes)))
        }
        def vert:[ErazerLayoutSet] (ErazerLayoutFeat.clusterAxis(boxes true))
        def horz:[ErazerLayoutSet] (ErazerLayoutFeat.clusterAxis(boxes false))
        def pairs:[ErazerLayoutSet] (ErazerLayoutFeat.pairRowSets(boxes))
        def i:int 0
        while (i < (array_length vert)) {
            ErazerLayoutFeat.addCand(out seen (itemAt vert i))
            i = (i + 1)
        }
        def h:int 0
        while (h < (array_length horz)) {
            ErazerLayoutFeat.addCand(out seen (itemAt horz h))
            h = (h + 1)
        }
        def p:int 0
        while (p < (array_length pairs)) {
            ErazerLayoutFeat.addCand(out seen (itemAt pairs p))
            p = (p + 1)
        }
        return out
    }

    sfn addCand:void (out:[ErazerLayoutSet] seen:[string:int] cand:ErazerLayoutSet) {
        if ((array_length cand.boxes) < 2) {
            return
        }
        def sig:string (ErazerLayoutFeat.memberSig(cand.boxes))
        if (has seen sig) {
            return
        }
        set seen sig 1
        push out cand
    }

    sfn augment:[ErazerLayoutSet] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutSet]
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.copyBoxes(boxes))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleGaps(boxes 0.9))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleGaps(boxes 1.1))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleSizes(boxes 0.9 1.0))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleSizes(boxes 1.1 1.0))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleFont(boxes 0.85))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleFont(boxes 1.15))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.shiftAll(boxes 3.0 -2.0))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.scaleAll(boxes 1.25))))
        def n:int (array_length boxes)
        if (n >= 4) {
            push out (ErazerLayoutSet.of((ErazerLayoutFeat.dropLast(boxes))))
        }
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.addClone(boxes))))
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.nudgeOne(boxes 2.5))))
        return out
    }

    sfn asColumn:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def out:[ErazerLayoutBox]
        def n:int (array_length ordered)
        if (n <= 0) {
            return out
        }
        def head:ErazerLayoutBox (itemAt ordered 0)
        def x:double head.x
        def y:double head.y
        def i:int 0
        while (i < n) {
            def b:ErazerLayoutBox (itemAt ordered i)
            def c:ErazerLayoutBox (b.copy())
            c.x = x
            c.y = y
            y = (y + (c.h + 8.0))
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn hardNegatives:[ErazerLayoutSet] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutSet]
        def g:ErazerLayoutGuess (ErazerLayoutFeat.describe(boxes "tmp" 0.0))
        if (g.axis == "vertical") {
            push out (ErazerLayoutSet.of((ErazerLayoutFeat.asRow(boxes))))
        } {
            push out (ErazerLayoutSet.of((ErazerLayoutFeat.asColumn(boxes))))
        }
        push out (ErazerLayoutSet.of((ErazerLayoutFeat.withOutlier(boxes))))
        return out
    }

    sfn scaleGaps:[ErazerLayoutBox] (boxes:[ErazerLayoutBox] k:double) {
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def out:[ErazerLayoutBox]
        def n:int (array_length ordered)
        if (n <= 0) {
            return out
        }
            def head:ErazerLayoutBox (itemAt ordered 0)
            def originY:double head.y
            def originX:double head.x
        def i:int 0
        while (i < n) {
            def b:ErazerLayoutBox (itemAt ordered i)
            def c:ErazerLayoutBox (b.copy())
            c.y = (originY + ((b.y - originY) * k))
            c.x = (originX + ((b.x - originX) * k))
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn scaleSizes:[ErazerLayoutBox] (boxes:[ErazerLayoutBox] wk:double hk:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            def c:ErazerLayoutBox (b.copy())
            c.w = (b.w * wk)
            c.h = (b.h * hk)
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn scaleFont:[ErazerLayoutBox] (boxes:[ErazerLayoutBox] k:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            def c:ErazerLayoutBox (b.copy())
            c.fontSize = (b.fontSize * k)
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn shiftAll:[ErazerLayoutBox] (boxes:[ErazerLayoutBox] dx:double dy:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            def c:ErazerLayoutBox (b.copy())
            c.x = (b.x + dx)
            c.y = (b.y + dy)
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn scaleAll:[ErazerLayoutBox] (boxes:[ErazerLayoutBox] k:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < (array_length boxes)) {
            def b:ErazerLayoutBox (itemAt boxes i)
            def c:ErazerLayoutBox (b.copy())
            c.x = (b.x * k)
            c.y = (b.y * k)
            c.w = (b.w * k)
            c.h = (b.h * k)
            c.fontSize = (b.fontSize * k)
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn dropLast:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def out:[ErazerLayoutBox]
        def n:int (array_length ordered)
        def i:int 0
        while (i < (n - 1)) {
            def b:ErazerLayoutBox (itemAt ordered i)
            push out (b.copy())
            i = (i + 1)
        }
        return out
    }

    sfn addClone:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def out:[ErazerLayoutBox] (ErazerLayoutFeat.copyBoxes(ordered))
        def n:int (array_length ordered)
        if (n <= 0) {
            return out
        }
        def tail:ErazerLayoutBox (itemAt ordered (n - 1))
        def extra:ErazerLayoutBox (tail.copy())
        def gap:double tail.h
        if (n >= 2) {
            def prev:ErazerLayoutBox (itemAt ordered (n - 2))
            gap = (tail.y - prev.y)
        }
        extra.y = (tail.y + gap)
        extra.index = (tail.index + 1)
        push out extra
        return out
    }

    sfn nudgeOne:[ErazerLayoutBox] (boxes:[ErazerLayoutBox] amount:double) {
        def out:[ErazerLayoutBox] (ErazerLayoutFeat.copyBoxes(boxes))
        def n:int (array_length out)
        if (n <= 0) {
            return out
        }
        def mid:int (idiv n 2)
        def b:ErazerLayoutBox (itemAt out mid)
        b.x = (b.x + amount)
        return out
    }

    sfn asRow:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def ordered:[ErazerLayoutBox] (ErazerLayoutFeat.sortedYX(boxes))
        def out:[ErazerLayoutBox]
        def n:int (array_length ordered)
        if (n <= 0) {
            return out
        }
        def head:ErazerLayoutBox (itemAt ordered 0)
        def x:double head.x
        def y:double head.y
        def i:int 0
        while (i < n) {
            def b:ErazerLayoutBox (itemAt ordered i)
            def c:ErazerLayoutBox (b.copy())
            c.x = x
            c.y = y
            x = (x + (c.w + 8.0))
            push out c
            i = (i + 1)
        }
        return out
    }

    sfn withOutlier:[ErazerLayoutBox] (boxes:[ErazerLayoutBox]) {
        def out:[ErazerLayoutBox] (ErazerLayoutFeat.copyBoxes(boxes))
        def n:int (array_length boxes)
        if (n <= 0) {
            return out
        }
        def tail:ErazerLayoutBox (itemAt boxes (n - 1))
        def extra:ErazerLayoutBox (tail.copy())
        extra.x = ((tail.maxX()) + 80.0)
        extra.y = (tail.y + 6.0)
        extra.type = "icon"
        extra.index = (tail.index + 91)
        push out extra
        return out
    }
}

class ErazerLayoutNet {
    def inSize:int 40
    def hidSize:int 32
    def outSize:int 8
    def w1:[double]
    def b1:[double]
    def w2:[double]
    def b2:[double]
    def classNames:[string]
    def classIndex:[string:int]
    def rng:int 1
    def rngD:double 0.137
    def stepsDone:int 0
    def memX:[double]
    def memY:[int]
    def memCount:int 0
    def memCap:int 96

    Constructor () {
        def a:[double]
        w1 = a
        def bb:[double]
        b1 = bb
        def c:[double]
        w2 = c
        def d:[double]
        b2 = d
        def names:[string]
        classNames = names
        def mx:[double]
        memX = mx
        def my:[int]
        memY = my
        this.initFresh()
    }

    fn rnd01:double () {
        rngD = ((rngD * 1.13001) + 0.137)
        def guard:int 0
        while ((rngD >= 1.0) && (guard < 8)) {
            rngD = (rngD - 1.0)
            guard = (guard + 1)
        }
        if (rngD < 0.0) {
            rngD = (rngD + 1.0)
        }
        return rngD
    }

    fn expD:double (x:double) {
        def v:double x
        def invert:boolean false
        if (v < 0.0) {
            invert = true
            v = (0.0 - v)
        }
        if (v > 16.0) {
            v = 16.0
        }
        def term:double 1.0
        def sum:double 1.0
        def n:int 1
        while (n < 18) {
            term = ((term * v) / (to_double n))
            sum = (sum + term)
            n = (n + 1)
        }
        if invert {
            return (1.0 / sum)
        }
        return sum
    }

    fn tanhD:double (x:double) {
        if (x > 8.0) {
            return 1.0
        }
        if (x < (0.0 - 8.0)) {
            return (0.0 - 1.0)
        }
        def e2:double (this.expD((x + x)))
        return ((e2 - 1.0) / (e2 + 1.0))
    }

    fn randArr:[double] (n:int scale:double) {
        def arr:[double]
        def i:int 0
        while (i < n) {
            def v:double ((((this.rnd01()) * 2.0) - 1.0) * scale)
            push arr v
            i = (i + 1)
        }
        return arr
    }

    fn initFresh:void () {
        rng = 1
        rngD = 0.137
        inSize = (ErazerLayoutFeat.featCount())
        hidSize = 32
        def names:[string]
        push names "list"
        push names "form"
        push names "toolbar"
        push names "card"
        push names "nav"
        push names "property_row"
        push names "grid"
        push names "other"
        classNames = names
        def idx:[string:int]
        classIndex = idx
        def c:int 0
        while (c < (array_length classNames)) {
            set classIndex (itemAt classNames c) c
            c = (c + 1)
        }
        outSize = (array_length classNames)
        def s1:double (sqrt (6.0 / (to_double (inSize + hidSize))))
        def s2:double (sqrt (6.0 / (to_double (hidSize + outSize))))
        w1 = (this.randArr((inSize * hidSize) s1))
        b1 = (this.randArr(hidSize 0.01))
        w2 = (this.randArr((hidSize * outSize) s2))
        b2 = (this.randArr(outSize 0.01))
        stepsDone = 0
        def mx:[double]
        memX = mx
        def my:[int]
        memY = my
        memCount = 0
    }

    fn classId:int (name:string) {
        if (has classIndex name) {
            def v@(optional):int (get classIndex name)
            return (?? v 7)
        }
        return (outSize - 1)
    }

    fn ensureClass:int (name:string) {
        if ((strlen name) < 1) {
            return (this.classId("other"))
        }
        if (has classIndex name) {
            return (this.classId(name))
        }
        if (outSize >= 24) {
            return (this.classId("other"))
        }
        def newOut:int (outSize + 1)
        def nw:[double]
        def i:int 0
        def oldN:int (array_length w2)
        while (i < oldN) {
            push nw (itemAt w2 i)
            i = (i + 1)
        }
        def s2:double 0.08
        def j:int 0
        while (j < hidSize) {
            def v:double ((((this.rnd01()) * 2.0) - 1.0) * s2)
            push nw v
            j = (j + 1)
        }
        w2 = nw
        push b2 0.0
        push classNames name
        set classIndex name outSize
        outSize = newOut
        return (outSize - 1)
    }

    fn forward:[double] (x:[double]) {
        def h:[double] (ErazerLayoutFeat.zeros(hidSize))
        def j:int 0
        while (j < hidSize) {
            def z:double (itemAt b1 j)
            def i:int 0
            while (i < inSize) {
                def xv:double 0.0
                if (i < (array_length x)) {
                    xv = (itemAt x i)
                }
                def wt:double (itemAt w1 ((j * inSize) + i))
                z = (z + (wt * xv))
                i = (i + 1)
            }
            set h j (this.tanhD(z))
            j = (j + 1)
        }
        def logits:[double] (ErazerLayoutFeat.zeros(outSize))
        def k:int 0
        def mx:double 0.0
        while (k < outSize) {
            def z2:double (itemAt b2 k)
            def hj:int 0
            while (hj < hidSize) {
                def wv:double (itemAt w2 ((k * hidSize) + hj))
                z2 = (z2 + (wv * (itemAt h hj)))
                hj = (hj + 1)
            }
            set logits k z2
            if (k == 0) {
                mx = z2
            }
            if (z2 > mx) {
                mx = z2
            }
            k = (k + 1)
        }
        def probs:[double] (ErazerLayoutFeat.zeros(outSize))
        def sum:double 0.0
        def p:int 0
        while (p < outSize) {
            def e:double (this.expD(((itemAt logits p) - mx)))
            set probs p e
            sum = (sum + e)
            p = (p + 1)
        }
        if (sum < 0.0000001) {
            sum = 0.0000001
        }
        def q:int 0
        while (q < outSize) {
            set probs q ((itemAt probs q) / sum)
            q = (q + 1)
        }
        return probs
    }

    ; Also returns hidden activations for the backward pass via hOut.
    fn trainOne:void (x:[double] y:int lr:double) {
        def h:[double] (ErazerLayoutFeat.zeros(hidSize))
        def j:int 0
        while (j < hidSize) {
            def z:double (itemAt b1 j)
            def i:int 0
            while (i < inSize) {
                def xv:double 0.0
                if (i < (array_length x)) {
                    xv = (itemAt x i)
                }
                z = (z + ((itemAt w1 ((j * inSize) + i)) * xv))
                i = (i + 1)
            }
            set h j (this.tanhD(z))
            j = (j + 1)
        }
        def logits:[double] (ErazerLayoutFeat.zeros(outSize))
        def k:int 0
        def mx:double 0.0
        while (k < outSize) {
            def z2:double (itemAt b2 k)
            def hj:int 0
            while (hj < hidSize) {
                z2 = (z2 + ((itemAt w2 ((k * hidSize) + hj)) * (itemAt h hj)))
                hj = (hj + 1)
            }
            set logits k z2
            if (k == 0) {
                mx = z2
            }
            if (z2 > mx) {
                mx = z2
            }
            k = (k + 1)
        }
        def probs:[double] (ErazerLayoutFeat.zeros(outSize))
        def sum:double 0.0
        def p:int 0
        while (p < outSize) {
            def e:double (this.expD(((itemAt logits p) - mx)))
            set probs p e
            sum = (sum + e)
            p = (p + 1)
        }
        if (sum < 0.0000001) {
            sum = 0.0000001
        }
        def q:int 0
        while (q < outSize) {
            set probs q ((itemAt probs q) / sum)
            q = (q + 1)
        }
        def dz2:[double] (ErazerLayoutFeat.zeros(outSize))
        def d:int 0
        while (d < outSize) {
            def g:double (itemAt probs d)
            if (d == y) {
                g = (g - 1.0)
            }
            set dz2 d g
            d = (d + 1)
        }
        def dh:[double] (ErazerLayoutFeat.zeros(hidSize))
        def k2:int 0
        while (k2 < outSize) {
            def gk:double (itemAt dz2 k2)
            def hj:int 0
            while (hj < hidSize) {
                def idx:int ((k2 * hidSize) + hj)
                def wv:double (itemAt w2 idx)
                def hv:double (itemAt h hj)
                set dh hj ((itemAt dh hj) + (wv * gk))
                set w2 idx (wv - (lr * (gk * hv)))
                hj = (hj + 1)
            }
            set b2 k2 ((itemAt b2 k2) - (lr * gk))
            k2 = (k2 + 1)
        }
        def j2:int 0
        while (j2 < hidSize) {
            def hv:double (itemAt h j2)
            def dz1:double ((itemAt dh j2) * (1.0 - (hv * hv)))
            set b1 j2 ((itemAt b1 j2) - (lr * dz1))
            def i2:int 0
            while (i2 < inSize) {
                def xv:double 0.0
                if (i2 < (array_length x)) {
                    xv = (itemAt x i2)
                }
                def idx1:int ((j2 * inSize) + i2)
                set w1 idx1 ((itemAt w1 idx1) - (lr * (dz1 * xv)))
                i2 = (i2 + 1)
            }
            j2 = (j2 + 1)
        }
        stepsDone = (stepsDone + 1)
    }

    fn predict:ErazerLayoutGuess (boxes:[ErazerLayoutBox]) {
        def n:int (array_length boxes)
        if (n < 2) {
            def miss (new ErazerLayoutGuess())
            miss.type = "other"
            miss.confidence = 0.0
            miss.items = n
            return miss
        }
        def x:[double] (ErazerLayoutFeat.features(boxes))
        def p:[double] (this.forward(x))
        def best:int 0
        def bestP:double (itemAt p 0)
        def k:int 1
        while (k < outSize) {
            def pk:double (itemAt p k)
            if (pk > bestP) {
                bestP = pk
                best = k
            }
            k = (k + 1)
        }
        def name:string "other"
        if (best < (array_length classNames)) {
            name = (itemAt classNames best)
        }
        return (ErazerLayoutFeat.describe(boxes name bestP))
    }

    fn remember:void (x:[double] y:int) {
        if (memCount >= memCap) {
            def nx:[double]
            def ny:[int]
            def drop:int 8
            def i:int drop
            while (i < memCount) {
                def k:int 0
                while (k < inSize) {
                    push nx (itemAt memX (((i * inSize) + k)))
                    k = (k + 1)
                }
                push ny (itemAt memY i)
                i = (i + 1)
            }
            memX = nx
            memY = ny
            memCount = (memCount - drop)
        }
        def j:int 0
        while (j < inSize) {
            def xv:double 0.0
            if (j < (array_length x)) {
                xv = (itemAt x j)
            }
            push memX xv
            j = (j + 1)
        }
        push memY y
        memCount = (memCount + 1)
    }

    fn replay:void (lr:double) {
        def i:int 0
        while (i < memCount) {
            def x:[double]
            def k:int 0
            while (k < inSize) {
                push x (itemAt memX (((i * inSize) + k)))
                k = (k + 1)
            }
            def y:int (itemAt memY i)
            this.trainOne(x y lr)
            i = (i + 1)
        }
    }

    fn fitAll:void (groups:[ErazerLayoutSet] labels:[string] epochs:int) {
        def n:int (array_length groups)
        def e:int 0
        def lr:double 0.07
        while (e < epochs) {
            def i:int 0
            while (i < n) {
                def grp:ErazerLayoutSet (itemAt groups i)
                def lab:string "other"
                if (i < (array_length labels)) {
                    lab = (itemAt labels i)
                }
                def y:int (this.ensureClass(lab))
                if ((array_length grp.boxes) >= 2) {
                    def x:[double] (ErazerLayoutFeat.features(grp.boxes))
                    this.trainOne(x y lr)
                    if (e == 0) {
                        this.remember(x y)
                    }
                }
                i = (i + 1)
            }
            e = (e + 1)
        }
        this.replay(0.05)
    }

    fn teach:void (boxes:[ErazerLayoutBox] label:string epochs:int) {
        def y:int (this.ensureClass(label))
        def otherId:int (this.ensureClass("other"))
        def pos:[ErazerLayoutSet] (ErazerLayoutFeat.augment(boxes))
        def neg:[ErazerLayoutSet] (ErazerLayoutFeat.hardNegatives(boxes))
        def e:int 0
        def lr:double 0.08
        while (e < epochs) {
            def i:int 0
            while (i < (array_length pos)) {
                def grp:ErazerLayoutSet (itemAt pos i)
                if ((array_length grp.boxes) >= 2) {
                    def x:[double] (ErazerLayoutFeat.features(grp.boxes))
                    this.trainOne(x y lr)
                    if (e == 0) {
                        this.remember(x y)
                    }
                }
                i = (i + 1)
            }
            def n:int 0
            while (n < (array_length neg)) {
                def ng:ErazerLayoutSet (itemAt neg n)
                if ((array_length ng.boxes) >= 2) {
                    def x2:[double] (ErazerLayoutFeat.features(ng.boxes))
                    this.trainOne(x2 otherId lr)
                    if (e == 0) {
                        this.remember(x2 otherId)
                    }
                }
                n = (n + 1)
            }
            this.replay(0.04)
            e = (e + 1)
        }
    }

    fn nms:[ErazerLayoutGuess] (xs:[ErazerLayoutGuess]) {
        def n:int (array_length xs)
        def order:[int]
        def i:int 0
        while (i < n) {
            push order i
            i = (i + 1)
        }
        def a:int 1
        while (a < n) {
            def j:int a
            while (j > 0) {
                def cur:int (itemAt order j)
                def prev:int (itemAt order (j - 1))
                def gc:ErazerLayoutGuess (itemAt xs cur)
                def gp:ErazerLayoutGuess (itemAt xs prev)
                if (gc.confidence > gp.confidence) {
                    set order j prev
                    set order (j - 1) cur
                    j = (j - 1)
                } {
                    j = 0
                }
            }
            a = (a + 1)
        }
        def kept:[ErazerLayoutGuess]
        def k:int 0
        while (k < n) {
            def idx:int (itemAt order k)
            def g:ErazerLayoutGuess (itemAt xs idx)
            def ok:boolean true
            def t:int 0
            while (t < (array_length kept)) {
                def other:ErazerLayoutGuess (itemAt kept t)
                def ov:double (this.memberOverlap(g other))
                if (ov >= 0.6) {
                    ok = false
                    t = (array_length kept)
                } {
                    t = (t + 1)
                }
            }
            if ok {
                push kept g
            }
            k = (k + 1)
        }
        return kept
    }

    fn memberOverlap:double (a:ErazerLayoutGuess b:ErazerLayoutGuess) {
        def na:int (array_length a.members)
        def nb:int (array_length b.members)
        if ((na <= 0) || (nb <= 0)) {
            return 0.0
        }
        def hit:int 0
        def i:int 0
        while (i < na) {
            def id:int (itemAt a.members i)
            def j:int 0
            while (j < nb) {
                if ((itemAt b.members j) == id) {
                    hit = (hit + 1)
                    j = nb
                } {
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
        def den:int na
        if (nb < den) {
            den = nb
        }
        if (den <= 0) {
            return 0.0
        }
        return ((to_double hit) / (to_double den))
    }

    fn scan:[ErazerLayoutGuess] (boxes:[ErazerLayoutBox]) {
        def cands:[ErazerLayoutSet] (ErazerLayoutFeat.candidates(boxes))
        def raw:[ErazerLayoutGuess]
        def i:int 0
        while (i < (array_length cands)) {
            def grp:ErazerLayoutSet (itemAt cands i)
            def g:ErazerLayoutGuess (this.predict(grp.boxes))
            if ((g.confidence >= 0.34) && (g.type != "other")) {
                push raw g
            }
            i = (i + 1)
        }
        return (this.nms(raw))
    }

    fn seedFromSynthetics:void () {
        def em:double 16.0
        def groups:[ErazerLayoutSet]
        def labels:[string]
        this.addSeed(groups labels (this.synthList(4 em)) "list")
        this.addSeed(groups labels (this.synthList(5 em)) "list")
        this.addSeed(groups labels (this.synthForm(em)) "form")
        this.addSeed(groups labels (this.synthToolbar(4 em)) "toolbar")
        this.addSeed(groups labels (this.synthNav(em)) "nav")
        this.addSeed(groups labels (this.synthRows(em)) "property_row")
        this.addSeed(groups labels (this.synthGrid(em)) "grid")
        this.addSeed(groups labels (this.synthCard(em)) "card")
        this.fitAll(groups labels 10)
    }

    fn addSeed:void (groups:[ErazerLayoutSet] labels:[string] boxes:[ErazerLayoutBox] label:string) {
        def pos:[ErazerLayoutSet] (ErazerLayoutFeat.augment(boxes))
        def i:int 0
        while (i < (array_length pos)) {
            push groups (itemAt pos i)
            push labels label
            i = (i + 1)
        }
        def neg:[ErazerLayoutSet] (ErazerLayoutFeat.hardNegatives(boxes))
        def n:int 0
        while (n < (array_length neg)) {
            push groups (itemAt neg n)
            push labels "other"
            n = (n + 1)
        }
    }

    fn synthList:[ErazerLayoutBox] (n:int em:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < n) {
            def y:double ((to_double i) * (em * 1.6))
            def b:ErazerLayoutBox (ErazerLayoutBox.of("label" 0.0 y (8.2 * em) (1.1 * em) em))
            b.index = i
            push out b
            i = (i + 1)
        }
        return out
    }

    fn synthForm:[ErazerLayoutBox] (em:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < 2) {
            def y:double ((to_double i) * (em * 4.4))
            def lab:ErazerLayoutBox (ErazerLayoutBox.of("label" 0.0 y (6.0 * em) (1.1 * em) em))
            lab.index = (i * 2)
            def field:ErazerLayoutBox (ErazerLayoutBox.of("textfield" 0.0 (y + (1.5 * em)) (16.0 * em) (2.0 * em) em))
            field.index = ((i * 2) + 1)
            push out lab
            push out field
            i = (i + 1)
        }
        def btn:ErazerLayoutBox (ErazerLayoutBox.of("button" (10.0 * em) (9.2 * em) (6.0 * em) (2.0 * em) em))
        btn.index = 4
        push out btn
        return out
    }

    fn synthToolbar:[ErazerLayoutBox] (n:int em:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < n) {
            def x:double ((to_double i) * (em * 5.2))
            def b:ErazerLayoutBox (ErazerLayoutBox.of("button" x 0.0 (4.4 * em) (2.2 * em) em))
            b.index = i
            push out b
            i = (i + 1)
        }
        return out
    }

    fn synthNav:[ErazerLayoutBox] (em:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < 4) {
            def y:double ((to_double i) * (em * 2.2))
            def ic:ErazerLayoutBox (ErazerLayoutBox.of("icon" 0.0 y (1.2 * em) (1.2 * em) em))
            ic.index = (i * 2)
            def lab:ErazerLayoutBox (ErazerLayoutBox.of("label" (1.6 * em) y (5.0 * em) (1.2 * em) em))
            lab.index = ((i * 2) + 1)
            push out ic
            push out lab
            i = (i + 1)
        }
        return out
    }

    fn synthRows:[ErazerLayoutBox] (em:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < 3) {
            def y:double ((to_double i) * (em * 2.0))
            def lab:ErazerLayoutBox (ErazerLayoutBox.of("label" 0.0 y (8.0 * em) (1.1 * em) em))
            lab.index = (i * 2)
            def ck:ErazerLayoutBox (ErazerLayoutBox.of("checkbox" (10.0 * em) y (1.1 * em) (1.1 * em) em))
            ck.index = ((i * 2) + 1)
            push out lab
            push out ck
            i = (i + 1)
        }
        return out
    }

    fn synthGrid:[ErazerLayoutBox] (em:double) {
        def out:[ErazerLayoutBox]
        def i:int 0
        while (i < 3) {
            def x:double ((to_double i) * (em * 9.0))
            def b:ErazerLayoutBox (ErazerLayoutBox.of("panel" x 0.0 (8.0 * em) (7.0 * em) em))
            b.index = i
            push out b
            i = (i + 1)
        }
        return out
    }

    fn synthCard:[ErazerLayoutBox] (em:double) {
        def out:[ErazerLayoutBox]
        def panel:ErazerLayoutBox (ErazerLayoutBox.of("panel" 0.0 0.0 (12.0 * em) (10.0 * em) em))
        panel.index = 0
        def title:ErazerLayoutBox (ErazerLayoutBox.of("label" (0.8 * em) (0.8 * em) (10.0 * em) (1.3 * em) em))
        title.index = 1
        def body:ErazerLayoutBox (ErazerLayoutBox.of("label" (0.8 * em) (2.6 * em) (9.0 * em) (1.1 * em) em))
        body.index = 2
        def btn:ErazerLayoutBox (ErazerLayoutBox.of("button" (0.8 * em) (7.2 * em) (4.5 * em) (1.8 * em) em))
        btn.index = 3
        push out panel
        push out title
        push out body
        push out btn
        return out
    }

    fn dumpWeights:string () {
        def s:string ("v1 " + (to_string inSize) + " " + (to_string hidSize) + " " + (to_string outSize) + " ")
        def i:int 0
        while (i < (array_length classNames)) {
            if (i > 0) {
                s = (s + ",")
            }
            s = (s + (itemAt classNames i))
            i = (i + 1)
        }
        s = (s + " ")
        s = (s + (this.dumpArr(w1)))
        s = (s + " ")
        s = (s + (this.dumpArr(b1)))
        s = (s + " ")
        s = (s + (this.dumpArr(w2)))
        s = (s + " ")
        s = (s + (this.dumpArr(b2)))
        return s
    }

    fn dumpArr:string (arr:[double]) {
        def s:string ""
        def i:int 0
        while (i < (array_length arr)) {
            if (i > 0) {
                s = (s + ",")
            }
            s = (s + (to_string (itemAt arr i)))
            i = (i + 1)
        }
        return s
    }

    fn loadWeights:boolean (raw:string) {
        def parts:[string] (this.splitSpace(raw))
        if ((array_length parts) < 9) {
            return false
        }
        if ((itemAt parts 0) != "v1") {
            return false
        }
        def ins:int (this.parseIntTok((itemAt parts 1)))
        def hid:int (this.parseIntTok((itemAt parts 2)))
        def outs:int (this.parseIntTok((itemAt parts 3)))
        if ((ins != inSize) || (hid != hidSize)) {
            return false
        }
        def names:[string] (this.splitComma((itemAt parts 4)))
        if ((array_length names) != outs) {
            return false
        }
        def nw1:[double] (this.parseCsv((itemAt parts 5)))
        def nb1:[double] (this.parseCsv((itemAt parts 6)))
        def nw2:[double] (this.parseCsv((itemAt parts 7)))
        def nb2:[double] (this.parseCsv((itemAt parts 8)))
        if ((array_length nw1) != (ins * hid)) {
            return false
        }
        if ((array_length nb1) != hid) {
            return false
        }
        if ((array_length nw2) != (hid * outs)) {
            return false
        }
        if ((array_length nb2) != outs) {
            return false
        }
        w1 = nw1
        b1 = nb1
        w2 = nw2
        b2 = nb2
        classNames = names
        outSize = outs
        def idx:[string:int]
        classIndex = idx
        def c:int 0
        while (c < outs) {
            set classIndex (itemAt names c) c
            c = (c + 1)
        }
        return true
    }

    fn parseIntTok:int (s:string) {
        def v:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def d:int (indexOf "0123456789" (substring s i (i + 1)))
            if (d < 0) {
                i = n
            } {
                v = ((v * 10) + d)
                i = (i + 1)
            }
        }
        return v
    }

    fn parseNum:double (s:string) {
        def n:int (strlen s)
        def i:int 0
        def sign:double 1.0
        if (n > 0) {
            if ((substring s 0 1) == "-") {
                sign = (0.0 - 1.0)
                i = 1
            }
        }
        def ip:double 0.0
        while (i < n) {
            def ch:string (substring s i (i + 1))
            if (ch == ".") {
                i = n
            } {
                def d:int (indexOf "0123456789" ch)
                if (d < 0) {
                    i = n
                } {
                    ip = ((ip * 10.0) + (to_double d))
                    i = (i + 1)
                }
            }
        }
        def dot:int (indexOf s ".")
        def frac:double 0.0
        if (dot >= 0) {
            def scale:double 0.1
            def j:int (dot + 1)
            while (j < n) {
                def d2:int (indexOf "0123456789" (substring s j (j + 1)))
                if (d2 < 0) {
                    j = n
                } {
                    frac = (frac + (scale * (to_double d2)))
                    scale = (scale * 0.1)
                    j = (j + 1)
                }
            }
        }
        def value:double (sign * (ip + frac))
        ; A host writing a weight smaller than 1e-6 writes it as "8.4e-7".
        ; Without this the exponent was dropped and the weight came back as
        ; 8.4 — a saved model silently loaded as a different model.
        def epos:int (indexOf s "e")
        if (epos < 0) {
            epos = (indexOf s "E")
        }
        if (epos >= 0) {
            def esign:double 1.0
            def k:int (epos + 1)
            if (k < n) {
                def ec:string (substring s k (k + 1))
                if (ec == "-") {
                    esign = (0.0 - 1.0)
                    k = (k + 1)
                } {
                    if (ec == "+") {
                        k = (k + 1)
                    }
                }
            }
            def ev:int 0
            while (k < n) {
                def d3:int (indexOf "0123456789" (substring s k (k + 1)))
                if (d3 < 0) {
                    k = n
                } {
                    ev = ((ev * 10) + d3)
                    k = (k + 1)
                }
            }
            if (ev > 60) {
                ev = 60
            }
            def mul:double 1.0
            def t:int 0
            while (t < ev) {
                mul = (mul * 10.0)
                t = (t + 1)
            }
            if (esign < 0.0) {
                value = (value / mul)
            } {
                value = (value * mul)
            }
        }
        return value
    }

    fn parseCsv:[double] (s:string) {
        def parts:[string] (this.splitComma(s))
        def out:[double]
        def i:int 0
        while (i < (array_length parts)) {
            def tok:string (itemAt parts i)
            if ((strlen tok) > 0) {
                push out (this.parseNum(tok))
            }
            i = (i + 1)
        }
        return out
    }

    fn splitSpace:[string] (s:string) {
        def out:[string]
        def cur:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:string (substring s i (i + 1))
            if (ch == " ") {
                if ((strlen cur) > 0) {
                    push out cur
                    cur = ""
                }
            } {
                cur = (cur + ch)
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            push out cur
        }
        return out
    }

    fn toJson:string (boxes:[ErazerLayoutBox] guesses:[ErazerLayoutGuess]) {
        def s:string "{\"boxes\":["
        def i:int 0
        while (i < (array_length boxes)) {
            if (i > 0) {
                s = (s + ",")
            }
            def b:ErazerLayoutBox (itemAt boxes i)
            s = (s + "{\"i\":" + (to_string b.index))
            s = (s + ",\"type\":\"" + b.type + "\"")
            s = (s + ",\"x\":" + (to_string b.x))
            s = (s + ",\"y\":" + (to_string b.y))
            s = (s + ",\"w\":" + (to_string b.w))
            s = (s + ",\"h\":" + (to_string b.h))
            s = (s + ",\"fontSize\":" + (to_string b.fontSize) + "}")
            i = (i + 1)
        }
        s = (s + "],\"groups\":[")
        def g:int 0
        while (g < (array_length guesses)) {
            if (g > 0) {
                s = (s + ",")
            }
            def u:ErazerLayoutGuess (itemAt guesses g)
            s = (s + (this.guessJson(u)))
            g = (g + 1)
        }
        s = (s + "]}")
        return s
    }

    fn guessJson:string (u:ErazerLayoutGuess) {
        def s:string "{\"type\":\""
        s = (s + u.type + "\"")
        s = (s + ",\"confidence\":" + (to_string u.confidence))
        s = (s + ",\"axis\":\"" + u.axis + "\"")
        s = (s + ",\"items\":" + (to_string u.items))
        s = (s + ",\"alignment\":\"" + u.alignment + "\"")
        s = (s + ",\"spacing\":{\"mean\":" + (to_string u.spacingMean))
        s = (s + ",\"unit\":\"em\",\"variance\":" + (to_string u.spacingVar) + "}")
        s = (s + ",\"pattern\":[")
        def parts:[string] (this.splitComma(u.pattern))
        def p:int 0
        while (p < (array_length parts)) {
            if (p > 0) {
                s = (s + ",")
            }
            s = (s + "\"" + (itemAt parts p) + "\"")
            p = (p + 1)
        }
        s = (s + "],\"members\":[")
        def m:int 0
        while (m < (array_length u.members)) {
            if (m > 0) {
                s = (s + ",")
            }
            s = (s + (to_string (itemAt u.members m)))
            m = (m + 1)
        }
        s = (s + "],\"x\":" + (to_string u.x))
        s = (s + ",\"y\":" + (to_string u.y))
        s = (s + ",\"w\":" + (to_string u.w))
        s = (s + ",\"h\":" + (to_string u.h) + "}")
        return s
    }

    fn splitComma:[string] (s:string) {
        def out:[string]
        if ((strlen s) == 0) {
            return out
        }
        def cur:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:string (substring s i (i + 1))
            if (ch == ",") {
                push out cur
                cur = ""
            } {
                cur = (cur + ch)
            }
            i = (i + 1)
        }
        push out cur
        return out
    }

    sfn shared:ErazerLayoutNet () {
        def store:ErazerLayoutStore (ErazerLayoutStore.__singleton())
        return store.ensureSeeded()
    }

    sfn current:ErazerLayoutNet () {
        def store:ErazerLayoutStore (ErazerLayoutStore.__singleton())
        return store.ensure()
    }

    sfn adoptWeights:boolean (raw:string) {
        def store:ErazerLayoutStore (ErazerLayoutStore.__singleton())
        def n:ErazerLayoutNet (store.ensure())
        if (n.loadWeights(raw)) {
            store.seeded = true
            return true
        }
        return false
    }

    sfn boxesFromTree:[ErazerLayoutBox] (root:ErazerNode pageW:int pageH:int) {
        return (ErazerLayoutFeat.collectTree(root pageW pageH))
    }

    sfn boxesFromList:[ErazerLayoutBox] (type:string xs:[double] ys:[double] ws:[double] hs:[double] font:double) {
        def out:[ErazerLayoutBox]
        def n:int (array_length xs)
        def i:int 0
        while (i < n) {
            def b:ErazerLayoutBox (ErazerLayoutBox.of(type (itemAt xs i) (itemAt ys i) (itemAt ws i) (itemAt hs i) font))
            b.index = i
            push out b
            i = (i + 1)
        }
        return out
    }
}

class ErazerLayoutStore @singleton(true) {
    def net@(optional):ErazerLayoutNet
    def seeded:boolean false

    Constructor () {
    }

    fn ensure:ErazerLayoutNet () {
        if net {
            def kept:ErazerLayoutNet (unwrap net)
            return kept
        }
        def created (new ErazerLayoutNet())
        net = created
        return created
    }

    fn ensureSeeded:ErazerLayoutNet () {
        def n:ErazerLayoutNet (this.ensure())
        if (seeded == false) {
            n.seedFromSynthetics()
            seeded = true
        }
        return n
    }
}

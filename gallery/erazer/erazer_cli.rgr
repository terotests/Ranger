; ==============================================================================
; erazer_cli.rgr — bitmap UI screenshot → EVG JSON from a command line
; ==============================================================================
;
;   npm run erazer -- in.png out.evg.json
;   npm run erazer -- in.png out.evg.json --overlay out.svg
;
; PNG and JPEG are decoded by the same Ranger decoders the tracer uses, so the
; compiled program is one file with nothing to install.
; ==============================================================================

Import "Erazer.rgr"
Import "../game_engine/v2/imaging/png/PNGDecoder.rgr"
Import "../pdf_writer/src/jpeg/JPEGDecoder.rgr"
Import "../pdf_writer/src/jpeg/ProgressiveJPEGDecoder.rgr"

class ErazerCli {

    Constructor () {
    }

    sfn m@(main):void () {
        def cli (new ErazerCli())
        cli.run()
    }

    sfn lastSepOf:int (path:string) {
        def n:int (strlen path)
        def i:int (n - 1)
        while (i >= 0) {
            def ch:string (substring path i (i + 1))
            if ((ch == "/") || (ch == "\\")) {
                return i
            }
            i = (i - 1)
        }
        return (0 - 1)
    }

    sfn dirOf:string (path:string) {
        def sep:int (ErazerCli.lastSepOf(path))
        if (sep < 0) {
            return "."
        }
        return (substring path 0 sep)
    }

    sfn fileOf:string (path:string) {
        def sep:int (ErazerCli.lastSepOf(path))
        if (sep < 0) {
            return path
        }
        return (substring path (sep + 1) (strlen path))
    }

    sfn digitOf:int (ch:string) {
        return (indexOf "0123456789" ch)
    }

    sfn parseInt:int (s:string) {
        def n:int (strlen s)
        def i:int 0
        def v:int 0
        while (i < n) {
            def d:int (ErazerCli.digitOf((substring s i (i + 1))))
            if (d < 0) {
                i = n
            } {
                v = ((v * 10) + d)
                i = (i + 1)
            }
        }
        return v
    }

    sfn parseBool:boolean (s:string) {
        if (s == "0") {
            return false
        }
        if (s == "false") {
            return false
        }
        if (s == "no") {
            return false
        }
        if (s == "off") {
            return false
        }
        return true
    }

    sfn looksBoolean:boolean (s:string) {
        return ((indexOf "|0|1|true|false|yes|no|on|off|" ("|" + s + "|")) >= 0)
    }

    sfn isSwitch:boolean (name:string) {
        if (name == "ocr") {
            return true
        }
        if (name == "vectorizeIcons") {
            return true
        }
        return false
    }

    sfn isProgressiveJpeg:boolean (bytes:buffer) {
        def n:int (buffer_length bytes)
        def i:int 0
        while (i < (n - 1)) {
            def b:int (buffer_get bytes i)
            if (b == 255) {
                def marker:int (buffer_get bytes (i + 1))
                if (marker == 194) {
                    return true
                }
                if (marker == 192) {
                    return false
                }
                if (marker == 193) {
                    return false
                }
            }
            i = (i + 1)
        }
        return false
    }

    fn decodeImage:ImageBuffer (bytes:buffer dir:string file:string) {
        def n:int (buffer_length bytes)
        def fail (new ImageBuffer())
        fail.init(1 1)
        if (n < 4) {
            return fail
        }
        def b0:int (buffer_get bytes 0)
        def b1:int (buffer_get bytes 1)
        if ((b0 == 137) && (b1 == 80)) {
            def png (new PNGDecoder())
            return (png.decodeBytes(bytes))
        }
        if ((b0 == 255) && (b1 == 216)) {
            if (ErazerCli.isProgressiveJpeg(bytes)) {
                def prog (new ProgressiveJPEGDecoder())
                return (prog.decode(dir file))
            }
            def jpg (new JPEGDecoder())
            jpg.quiet = true
            return (jpg.decodeBytes(bytes))
        }
        return fail
    }

    fn printUsage:void () {
        print "erazer — bitmap UI screenshot to EVG layout"
        print ""
        print "  erazer <input.png|.jpg> <output.evg.json> [options]"
        print ""
        print "  --overlay <path>     write a labelled SVG of the detected boxes"
        print "  --outline            print the widget tree"
        print "  --ocr true|false     read 5×7 atlas characters (default true)"
        print "  --vectorizeIcons     trace icons with EvgBitmapTracer (default true)"
        print "  --colorTol <n>       per-channel join tolerance (default 20)"
    }

    fn applyOption:boolean (o:ErazerOptions name:string value:string) {
        if (name == "ocr") {
            o.ocr = (ErazerCli.parseBool(value))
            return true
        }
        if (name == "vectorizeIcons") {
            o.vectorizeIcons = (ErazerCli.parseBool(value))
            return true
        }
        if (name == "colorTol") {
            o.colorTol = (ErazerCli.parseInt(value))
            return true
        }
        if (name == "minArea") {
            o.minArea = (ErazerCli.parseInt(value))
            return true
        }
        return false
    }

    fn run:void () {
        def argCount:int (shell_arg_cnt)
        if (argCount < 1) {
            this.printUsage()
            return
        }
        def options:ErazerOptions (ErazerOptions.defaults())
        def positional:[string]
        def overlayPath:string ""
        def wantOutline:boolean false
        def wantHelp:boolean false
        def bad:boolean false
        def i:int 0
        while (i < argCount) {
            def arg:string (shell_arg i)
            if ((arg == "-h") || (arg == "--help")) {
                wantHelp = true
            } {
                if ((indexOf arg "--") == 0) {
                    def body:string (substring arg 2 (strlen arg))
                    def name:string body
                    def value:string ""
                    def haveValue:boolean false
                    def eq:int (indexOf body "=")
                    if (eq >= 0) {
                        name = (substring body 0 eq)
                        value = (substring body (eq + 1) (strlen body))
                        haveValue = true
                    }
                    if (name == "outline") {
                        wantOutline = true
                    } {
                        def isFlag:boolean (ErazerCli.isSwitch(name))
                        if (haveValue == false) {
                            if ((i + 1) < argCount) {
                                def peek:string (shell_arg (i + 1))
                                def peekIsOption:boolean ((indexOf peek "--") == 0)
                                def take:boolean false
                                if (peekIsOption == false) {
                                    take = true
                                    if isFlag {
                                        take = (ErazerCli.looksBoolean(peek))
                                    }
                                }
                                if take {
                                    value = peek
                                    haveValue = true
                                    i = (i + 1)
                                }
                            }
                        }
                        if ((haveValue == false) && isFlag) {
                            value = "true"
                            haveValue = true
                        }
                        if (name == "overlay") {
                            if haveValue {
                                overlayPath = value
                            } {
                                print "--overlay needs a path"
                                bad = true
                            }
                        } {
                            if haveValue {
                                def ok:boolean (this.applyOption(options name value))
                                if (ok == false) {
                                    print ("unknown option --" + name)
                                    bad = true
                                }
                            } {
                                print (("--" + name) + " needs a value")
                                bad = true
                            }
                        }
                    }
                } {
                    push positional arg
                }
            }
            i = (i + 1)
        }
        if wantHelp {
            this.printUsage()
            return
        }
        def pn:int (array_length positional)
        if (pn != 2) {
            if (bad == false) {
                print "an input path and an output path are both needed"
            }
            bad = true
        }
        if bad {
            print ""
            this.printUsage()
            return
        }
        def inputPath:string (itemAt positional 0)
        def outputPath:string (itemAt positional 1)
        def inDir:string (ErazerCli.dirOf(inputPath))
        def inFile:string (ErazerCli.fileOf(inputPath))
        if ((file_exists inDir inFile) == false) {
            print ("no such file: " + inputPath)
            return
        }
        def bytes:buffer (buffer_read_file inDir inFile)
        if ((buffer_length bytes) == 0) {
            print ("cannot read " + inputPath)
            return
        }
        def image:ImageBuffer (this.decodeImage(bytes inDir inFile))
        if (((image.width) < 2) && ((image.height) < 2)) {
            print ("not a PNG or JPEG this build can decode: " + inputPath)
            return
        }
        def doc:ErazerDoc (Erazer.fromImageBuffer(image options))
        def outDir:string (ErazerCli.dirOf(outputPath))
        def outFile:string (ErazerCli.fileOf(outputPath))
        write_file outDir outFile doc.json
        if ((strlen overlayPath) > 0) {
            def ovDir:string (ErazerCli.dirOf(overlayPath))
            def ovFile:string (ErazerCli.fileOf(overlayPath))
            write_file ovDir ovFile doc.overlaySvg
        }
        print (((((outputPath + "  ") + (to_string doc.width)) + "x") + (to_string doc.height)))
        print (("  buttons=" + (to_string (doc.root.roleCount("button")))) + " fields=" + (to_string (doc.root.roleCount("textfield"))) + " icons=" + (to_string (doc.root.roleCount("icon"))))
        if wantOutline {
            print doc.outline
        }
    }
}

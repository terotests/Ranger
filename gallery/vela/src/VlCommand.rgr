; ==============================================================================
; VlCommand.rgr — the scene as a flat list of drawing commands.
; ==============================================================================
; This is the seam a renderer plugs into, and it exists BEFORE any renderer on
; purpose: the EVG backend is waiting on richer SVG-path support, and a command
; list can be built, tested and diffed as text in the meantime. When the backend
; lands it consumes this list; it does not walk the scene itself, and nothing in
; here knows what EVG, SVG or PDF are.
;
; What the layer is responsible for:
;   * flattening the group tree, so a command carries ABSOLUTE coordinates
;   * turning the encode channels into the geometry a renderer draws: a rect is
;     x/y/width/height, a rule is a segment, a symbol is a centre and a size
;   * filling in the defaults the reference applies when a channel is absent
;     (a rect with no fill is not painted; a text with no font size is 11)
;
; What it is NOT responsible for: text measurement, path flattening, colour
; parsing, clipping strategy, or anything else that depends on the output
; device. Those belong to the backend.
; ==============================================================================

Import "VlJson.rgr"
Import "VlScene.rgr"
Import "VlShape.rgr"
Import "../../evg/PathBuilder.rgr"

; op: "rect" | "line" | "text" | "path" | "symbol" | "image" | "group-begin" | "group-end"
class VlDrawCommand {
    def op:string "rect"
    def markType:string ""
    ; What the scene called this mark — "mark" for data, "axis-grid",
    ; "axis-label", "frame" and so on for the chrome. A backend that themes a
    ; chart needs to tell a gridline from a bar, and the colour cannot tell it:
    ; both are whatever the specification said.
    def role:string ""

    def x:double 0.0
    def y:double 0.0
    def width:double 0.0
    def height:double 0.0
    ; line/rule endpoints
    def x2:double 0.0
    def y2:double 0.0

    def fill:string ""
    def hasFill:boolean false
    def fillOpacity:double 1.0
    def stroke:string ""
    def hasStroke:boolean false
    ; A stroke the specification NAMED but gave no width. It paints nothing —
    ; the picture is the same either way — but the reference writes it out, and
    ; a comparison that reads every attribute is the whole point of the
    ; harness, so it is written out here too.
    def strokeNamed:boolean false
    def strokeWidth:double 1.0
    def strokeOpacity:double 1.0
    def opacity:double 1.0
    ; The dash pattern as the specification wrote it, and the shape of a
    ; stroke's ends. Both change what is on the page and neither is a colour,
    ; so neither belongs to a theme.
    def strokeDash:string ""
    def strokeCap:string ""

    ; A rectangle's corners, clockwise from the top left. Named separately
    ; because a bar in a stack rounds only the end that is exposed.
    def cornerTL:double 0.0
    def cornerTR:double 0.0
    def cornerBR:double 0.0
    def cornerBL:double 0.0

    def text:string ""
    def font:string "sans-serif"
    def fontSize:double 11.0
    def fontWeight:string ""
    def align:string "left"
    def baseline:string "alphabetic"
    def angle:double 0.0
    ; A label nudged off its anchor. Small, and the only thing that puts a
    ; value label clear of the bar it belongs to.
    def dx:double 0.0
    def dy:double 0.0

    ; SVG path data, in the command's own coordinate space. Set for `path`
    ; commands and for a symbol whose shape is not a plain circle.
    def pathData:string ""
    def shape:string "circle"
    def size:double 64.0
    def url:string ""

    ; A polyline or polygon carries its vertices here as a flat x,y,x,y… list
    ; rather than as a path string: a line mark is a list of points, and turning
    ; it into path syntax is the backend's decision, not this layer's.
    def points:[double]
    ; A TRAIL's width at each of those vertices. The ribbon's outline is worked
    ; out from the two together, and it is worked out by the BACKEND rather
    ; than here, so that the shape can be placed at the plot's origin like
    ; every other one. Built into path syntax up here it had nowhere to put
    ; that origin, and every trail was drawn against the left edge of the page.
    def widths:[double]
    def interpolate:string "linear"
    ; What a cardinal or catmull-rom curve is asked to do with its tangents.
    ; The reference's defaults differ per interpolation, so the command carries
    ; whether one was given rather than a number that might be a default.
    def tension:double 0.0
    def hasTension:boolean false

    ; An arc is a wedge: a centre, two angles and two radii. Angles are the
    ; reference's — radians, clockwise, zero pointing UP — and a backend has to
    ; turn them into whatever its own drawing model wants.
    def startAngle:double 0.0
    def endAngle:double 0.0
    def innerRadius:double 0.0
    def outerRadius:double 0.0
}

class VlCommandList {
    def commands:[VlDrawCommand]

    fn count:int () {
        return (array_length commands)
    }

    ; A stable text form, one command per line: readable in a diff, and the
    ; artifact a renderer test can pin before any renderer exists.
    fn asText:string () {
        def out:string ""
        for commands cmd:VlDrawCommand idx {
            out = (out + (VlCommandList.commandText(cmd)))
            out = (out + (strfromcode 10))
        }
        return out
    }

    sfn commandText:string (cmd:VlDrawCommand) {
        def out:string cmd.op
        if (cmd.op == "rect") {
            out = ((((((out + " x=") + (VlJson.formatNumber(cmd.x 3))) + " y=") + (VlJson.formatNumber(cmd.y 3))) + " w=") + (VlJson.formatNumber(cmd.width 3)))
            out = ((out + " h=") + (VlJson.formatNumber(cmd.height 3)))
        }
        if (cmd.op == "line") {
            out = ((((((out + " x=") + (VlJson.formatNumber(cmd.x 3))) + " y=") + (VlJson.formatNumber(cmd.y 3))) + " x2=") + (VlJson.formatNumber(cmd.x2 3)))
            out = ((out + " y2=") + (VlJson.formatNumber(cmd.y2 3)))
        }
        if (cmd.op == "text") {
            out = ((((((out + " x=") + (VlJson.formatNumber(cmd.x 3))) + " y=") + (VlJson.formatNumber(cmd.y 3))) + " size=") + (VlJson.formatNumber(cmd.fontSize 3)))
            out = ((((out + " align=") + cmd.align) + " text=") + cmd.text)
        }
        if (cmd.op == "symbol") {
            out = ((((((out + " x=") + (VlJson.formatNumber(cmd.x 3))) + " y=") + (VlJson.formatNumber(cmd.y 3))) + " size=") + (VlJson.formatNumber(cmd.size 3)))
            out = ((out + " shape=") + cmd.shape)
        }
        if (cmd.op == "path") {
            out = ((out + " d=") + cmd.pathData)
        }
        if ((cmd.op == "polyline") || (cmd.op == "polygon")) {
            out = ((out + " points=") + (VlCommandList.pointsText(cmd)))
        }
        if (cmd.op == "arc") {
            out = ((((((out + " x=") + (VlJson.formatNumber(cmd.x 3))) + " y=") + (VlJson.formatNumber(cmd.y 3))) + " r=") + (VlJson.formatNumber(cmd.innerRadius 3)))
            out = ((((((out + "..") + (VlJson.formatNumber(cmd.outerRadius 3))) + " a=") + (VlJson.formatNumber(cmd.startAngle 4))) + "..") + (VlJson.formatNumber(cmd.endAngle 4)))
        }
        if (cmd.hasFill) {
            out = ((out + " fill=") + cmd.fill)
        }
        if (cmd.hasStroke) {
            out = ((((out + " stroke=") + cmd.stroke) + " strokeWidth=") + (VlJson.formatNumber(cmd.strokeWidth 3)))
        }
        if (cmd.opacity != 1.0) {
            out = ((out + " opacity=") + (VlJson.formatNumber(cmd.opacity 3)))
        }
        return out
    }

    sfn pointsText:string (cmd:VlDrawCommand) {
        def out:string ""
        def total:int (array_length cmd.points)
        def k:int 0
        while (k < total) {
            if (k > 0) {
                if ((k % 2) == 0) {
                    out = (out + " ")
                } {
                    out = (out + ",")
                }
            }
            out = (out + (VlJson.formatNumber((itemAt cmd.points k) 3)))
            k = (k + 1)
        }
        return out
    }
}

; Walks a scene and produces the command list. Group offsets accumulate, so a
; command's coordinates are absolute even though the scene's are not.
class VlSceneCommands {

    sfn build:VlCommandList (root:VlSceneMark) {
        def list (new VlCommandList())
        VlSceneCommands.walkMark(list root 0.0 0.0)
        return list
    }

    sfn walkMark:void (list:VlCommandList mark:VlSceneMark offsetX:double offsetY:double) {
        ; A line or an area is ONE shape built from every item, not one shape
        ; per item — the items are its vertices.
        if (mark.markType == "line") {
            VlSceneCommands.emitLine(list mark offsetX offsetY)
            return
        }
        if (mark.markType == "area") {
            VlSceneCommands.emitArea(list mark offsetX offsetY)
            return
        }
        ; A trail is a line whose width is read from the data, so it is a
        ; filled shape rather than a stroked one — and one shape, like a line.
        if (mark.markType == "trail") {
            VlSceneCommands.emitTrail(list mark offsetX offsetY)
            return
        }
        for mark.items item:VlSceneItem idx {
            if (mark.markType == "group") {
                VlSceneCommands.emitGroup(list mark item offsetX offsetY)
            } {
                VlSceneCommands.emitItem(list mark item offsetX offsetY)
            }
        }
    }

    ; The vertices of a line mark, in item order.
    sfn emitLine:void (list:VlCommandList mark:VlSceneMark offsetX:double offsetY:double) {
        def count:int (array_length mark.items)
        if (count == 0) {
            return
        }
        def cmd (new VlDrawCommand())
        cmd.op = "polyline"
        cmd.markType = mark.markType
        cmd.role = mark.role
        for mark.items item:VlSceneItem idx {
            push cmd.points (offsetX + (item.number("x")))
            push cmd.points (offsetY + (item.number("y")))
        }
        def first:VlSceneItem (itemAt mark.items 0)
        VlSceneCommands.applyCurve(cmd first)
        VlSceneCommands.applyStyle(cmd first)
        push list.commands cmd
    }

    ; A trail: the vertices, each with the width the data gave it. The shape
    ; is built once, here, from the geometry every backend shares, and handed
    ; on as path data — the same road a Vega `path` mark takes.
    sfn emitTrail:void (list:VlCommandList mark:VlSceneMark offsetX:double offsetY:double) {
        def count:int (array_length mark.items)
        if (count == 0) {
            return
        }
        def cmd (new VlDrawCommand())
        cmd.op = "trail"
        cmd.markType = mark.markType
        cmd.role = mark.role
        cmd.x = 0.0
        cmd.y = 0.0
        for mark.items item:VlSceneItem idx {
            push cmd.points (offsetX + (item.number("x")))
            push cmd.points (offsetY + (item.number("y")))
            def wide:double 1.0
            if (item.has("size")) {
                wide = (item.number("size"))
            }
            push cmd.widths wide
        }
        def first:VlSceneItem (itemAt mark.items 0)
        VlSceneCommands.applyStyle(cmd first)
        push list.commands cmd
    }

    ; An area is the band between each item's y and its y2 (or x and x2 for a
    ; horizontal area): the tops in order, then the baseline back again, which
    ; closes the polygon.
    sfn emitArea:void (list:VlCommandList mark:VlSceneMark offsetX:double offsetY:double) {
        def count:int (array_length mark.items)
        if (count == 0) {
            return
        }
        def cmd (new VlDrawCommand())
        cmd.op = "polygon"
        cmd.markType = mark.markType
        cmd.role = mark.role
        def horizontal:boolean false
        def first:VlSceneItem (itemAt mark.items 0)
        if (first.has("x2")) {
            horizontal = true
        }
        for mark.items item:VlSceneItem idx {
            push cmd.points (offsetX + (item.number("x")))
            push cmd.points (offsetY + (item.number("y")))
        }
        def k:int (count - 1)
        while (k >= 0) {
            def item:VlSceneItem (itemAt mark.items k)
            if horizontal {
                push cmd.points (offsetX + (item.number("x2")))
                push cmd.points (offsetY + (item.number("y")))
            } {
                push cmd.points (offsetX + (item.number("x")))
                push cmd.points (offsetY + (item.number("y2")))
            }
            k = (k - 1)
        }
        VlSceneCommands.applyCurve(cmd first)
        VlSceneCommands.applyStyle(cmd first)
        push list.commands cmd
    }

    ; Which curve joins the points, and how hard it is pulled. The reference's
    ; tension defaults are per-interpolation rather than global — 0 for a
    ; cardinal, 0.5 for a catmull-rom — so an unstated tension is filled in from
    ; the curve's own default and not from a single number that would be wrong
    ; for one of them.
    sfn applyCurve:void (cmd:VlDrawCommand item:VlSceneItem) {
        if (item.has("interpolate")) {
            cmd.interpolate = (item.text("interpolate"))
        }
        if (item.has("tension")) {
            cmd.tension = (item.number("tension"))
            cmd.hasTension = true
            return
        }
        if (cmd.interpolate == "catmull-rom") {
            cmd.tension = 0.5
        } {
            cmd.tension = 0.0
        }
    }

    sfn emitGroup:void (list:VlCommandList mark:VlSceneMark item:VlSceneItem offsetX:double offsetY:double) {
        def gx:double (offsetX + (item.number("x")))
        def gy:double (offsetY + (item.number("y")))

        ; A group that paints paints its own rectangle first — the chart
        ; background, and the frame around a cell.
        ;
        ; "Paints" means a fill or a stroke that is actually drawn. A group
        ; styled `fill: transparent` with no stroke — which is what a chart with
        ; no plotting frame carries — asks for nothing to be drawn, and emitting
        ; the rectangle anyway handed a backend a shape it could style: the pie
        ; chart came out inside a box because the theme's stylesheet found a
        ; frame to stroke.
        if ((item.has("fill")) || (item.has("stroke"))) {
            def bg (new VlDrawCommand())
            bg.op = "rect"
            bg.markType = "group"
            bg.role = mark.role
            ; A stroked frame is nudged onto the half pixel. A one-pixel line
            ; centred on a whole coordinate straddles two rows of pixels and is
            ; drawn as two rows of half-strength grey; moved half a pixel it
            ; lands inside one row and comes out as the crisp line it was meant
            ; to be. The reference does this for every group it strokes, which
            ; is why its frames look sharper than the ones here did.
            def nudge:double (VlSceneCommands.strokeNudge(item))
            bg.x = (gx + nudge)
            bg.y = (gy + nudge)
            bg.width = (item.number("width"))
            bg.height = (item.number("height"))
            VlSceneCommands.applyStyle(bg item)
            if (bg.hasFill || bg.hasStroke) {
                push list.commands bg
            }
        }

        def begin (new VlDrawCommand())
        begin.op = "group-begin"
        begin.markType = "group"
        begin.x = gx
        begin.y = gy
        begin.width = (item.number("width"))
        begin.height = (item.number("height"))
        push list.commands begin

        for item.marks child:VlSceneMark ci {
            VlSceneCommands.walkMark(list child gx gy)
        }

        def end (new VlDrawCommand())
        end.op = "group-end"
        end.markType = "group"
        push list.commands end
    }

    ; `cornerRadius` sets all four; a named corner overrides its own. The
    ; fallback order is the reference's and it is not symmetric: an unstated
    ; bottom-left follows the top-RIGHT, so a bar rounded at one end by two
    ; values rounds the diagonal pair.
    sfn applyCorners:void (cmd:VlDrawCommand item:VlSceneItem) {
        def all:double 0.0
        if (item.has("cornerRadius")) {
            all = (item.number("cornerRadius"))
        }
        def tl:double all
        def tr:double all
        def br:double all
        if (item.has("cornerRadiusTopLeft")) {
            tl = (item.number("cornerRadiusTopLeft"))
        }
        if (item.has("cornerRadiusTopRight")) {
            tr = (item.number("cornerRadiusTopRight"))
        }
        if (item.has("cornerRadiusBottomRight")) {
            br = (item.number("cornerRadiusBottomRight"))
        }
        def bl:double tr
        if (item.has("cornerRadiusBottomLeft")) {
            bl = (item.number("cornerRadiusBottomLeft"))
        }
        cmd.cornerTL = tl
        cmd.cornerTR = tr
        cmd.cornerBR = br
        cmd.cornerBL = bl
    }

    ; Half a pixel, but only for a stroke thin enough for it to matter: the
    ; correction is `0.5 - |strokeWidth - 1|`, which is a half at width one and
    ; tapers to nothing by width 0.5 or 1.5. A thick border covers whole pixels
    ; on its own and does not want moving.
    sfn strokeNudge:double (item:VlSceneItem) {
        if (item.has("strokeOffset")) {
            return (item.number("strokeOffset"))
        }
        if (! (item.has("stroke"))) {
            return 0.0
        }
        if ((item.text("stroke")) == "transparent") {
            return 0.0
        }
        def sw:double 1.0
        if (item.has("strokeWidth")) {
            sw = (item.number("strokeWidth"))
        }
        if ((sw <= 0.5) || (sw >= 1.5)) {
            return 0.0
        }
        def off:double (sw - 1.0)
        if (off < 0.0) {
            off = (0.0 - off)
        }
        return (0.5 - off)
    }

    sfn emitItem:void (list:VlCommandList mark:VlSceneMark item:VlSceneItem offsetX:double offsetY:double) {
        ; A gradient is not a colour, and no target here paints one. It is drawn
        ; as its own stops instead — one flat band per pair — which every
        ; backend can already do and which reads as a ramp at the size a legend
        ; bar is. The bands are the reference's own stop colours, so the two
        ; agree at every offset even though one interpolates and one steps.
        if (item.has("gradientStops")) {
            VlSceneCommands.emitGradient(list mark item offsetX offsetY)
            return
        }
        def cmd (new VlDrawCommand())
        cmd.markType = mark.markType
        cmd.role = mark.role

        if (mark.markType == "rect") {
            cmd.op = "rect"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            cmd.width = (item.number("width"))
            cmd.height = (item.number("height"))
            ; A negative extent is a rectangle drawn from the other corner.
            if (cmd.width < 0.0) {
                cmd.x = (cmd.x + cmd.width)
                cmd.width = (0.0 - cmd.width)
            }
            if (cmd.height < 0.0) {
                cmd.y = (cmd.y + cmd.height)
                cmd.height = (0.0 - cmd.height)
            }
            VlSceneCommands.applyCorners(cmd item)
        }
        if (mark.markType == "rule") {
            cmd.op = "line"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            cmd.x2 = cmd.x
            cmd.y2 = cmd.y
            if (item.has("x2")) {
                cmd.x2 = (offsetX + (item.number("x2")))
            }
            if (item.has("y2")) {
                cmd.y2 = (offsetY + (item.number("y2")))
            }
        }
        if (mark.markType == "text") {
            cmd.op = "text"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            ; A label on a pie is placed in POLAR coordinates: x and y are the
            ; centre of the chart, and the label stands `radius` away from it
            ; at `theta` round. Zero is straight up and the angle runs
            ; clockwise, which is how a pie is read.
            if (item.has("radius")) {
                def r:double (item.number("radius"))
                def a:double (item.number("theta"))
                cmd.x = (cmd.x + (r * (sin a)))
                cmd.y = (cmd.y - (r * (cos a)))
            }
            cmd.text = (item.text("text"))
            cmd.fontSize = 11.0
            if (item.has("fontSize")) {
                cmd.fontSize = (item.number("fontSize"))
            }
            if (item.has("font")) {
                cmd.font = (item.text("font"))
            }
            if (item.has("fontWeight")) {
                cmd.fontWeight = (item.text("fontWeight"))
            }
            if (item.has("align")) {
                cmd.align = (item.text("align"))
            }
            if (item.has("baseline")) {
                cmd.baseline = (item.text("baseline"))
            }
            if (item.has("angle")) {
                cmd.angle = (item.number("angle"))
            }
            if (item.has("dx")) {
                cmd.dx = (item.number("dx"))
            }
            if (item.has("dy")) {
                cmd.dy = (item.number("dy"))
            }
        }
        if (mark.markType == "symbol") {
            cmd.op = "symbol"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            cmd.size = 64.0
            if (item.has("size")) {
                cmd.size = (item.number("size"))
            }
            if (item.has("shape")) {
                cmd.shape = (item.text("shape"))
            }
        }
        if (mark.markType == "path") {
            cmd.op = "path"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            cmd.pathData = (item.text("path"))
        }
        if (mark.markType == "arc") {
            cmd.op = "arc"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            cmd.startAngle = (item.number("startAngle"))
            cmd.endAngle = (item.number("endAngle"))
            cmd.innerRadius = (item.number("innerRadius"))
            cmd.outerRadius = (item.number("outerRadius"))
        }
        if (mark.markType == "image") {
            cmd.op = "image"
            cmd.x = (offsetX + (item.number("x")))
            cmd.y = (offsetY + (item.number("y")))
            cmd.width = (item.number("width"))
            cmd.height = (item.number("height"))
            cmd.url = (item.text("url"))
        }

        VlSceneCommands.applyStyle(cmd item)
        push list.commands cmd
    }

    ; The bands of a gradient-filled rectangle, bottom to top: a legend's ramp
    ; runs from the domain's low end at the FOOT of the bar to its high end at
    ; the top, which is why the first stop is drawn last.
    sfn emitGradient:void (list:VlCommandList mark:VlSceneMark item:VlSceneItem offsetX:double offsetY:double) {
        def stops:VlJson (item.props.get("gradientStops"))
        def total:int (stops.count())
        if (total < 2) {
            return
        }
        def x:double (offsetX + (item.number("x")))
        def y:double (offsetY + (item.number("y")))
        def w:double (item.number("width"))
        def h:double (item.number("height"))
        def k:int 0
        while (k < (total - 1)) {
            def from:double (stops.at(k).doubleOr("offset" 0.0))
            def to:double (stops.at((k + 1)).doubleOr("offset" 1.0))
            def band (new VlDrawCommand())
            band.op = "rect"
            band.markType = mark.markType
            band.role = mark.role
            band.x = x
            band.y = (y + (h * (1.0 - to)))
            band.width = w
            band.height = (h * (to - from))
            band.fill = (stops.at(k).stringOr("color" ""))
            band.hasFill = true
            if (item.has("opacity")) {
                band.opacity = (item.number("opacity"))
            }
            push list.commands band
            k = (k + 1)
        }
        ; The outline, if the bar has one, is drawn once around the whole bar
        ; rather than around every band.
        if (item.has("stroke")) {
            def frame (new VlDrawCommand())
            frame.op = "rect"
            frame.markType = mark.markType
            frame.role = mark.role
            frame.x = x
            frame.y = y
            frame.width = w
            frame.height = h
            VlSceneCommands.applyStyle(frame item)
            frame.hasFill = false
            if frame.hasStroke {
                push list.commands frame
            }
        }
    }

    ; The style channels are shared by every mark type, and "absent" is not the
    ; same as "zero": a rect with no fill is not painted at all, so the flag is
    ; what a backend reads, not the colour string.
    sfn applyStyle:void (cmd:VlDrawCommand item:VlSceneItem) {
        if (item.has("fill")) {
            def fill:string (item.text("fill"))
            if (fill != "transparent") {
                cmd.fill = fill
                cmd.hasFill = true
            }
        }
        if (item.has("stroke")) {
            def stroke:string (item.text("stroke"))
            ; `"stroke": ""` is a chart asking for no outline at all — a view
            ; with no frame round it — and it is not a colour. Painted anyway,
            ; the frame was half a pixel off the plot on every side and the
            ; page grew by one.
            if ((strlen stroke) == 0) {
                stroke = "transparent"
            }
            if (stroke != "transparent") {
                cmd.stroke = stroke
                cmd.hasStroke = true
                cmd.strokeNamed = true
                cmd.strokeWidth = 1.0
            }
        }
        if (item.has("strokeWidth")) {
            cmd.strokeWidth = (item.number("strokeWidth"))
            if (cmd.strokeWidth <= 0.0) {
                cmd.hasStroke = false
            }
        }
        if (item.has("fillOpacity")) {
            cmd.fillOpacity = (item.number("fillOpacity"))
        }
        if (item.has("strokeOpacity")) {
            cmd.strokeOpacity = (item.number("strokeOpacity"))
        }
        if (item.has("opacity")) {
            cmd.opacity = (item.number("opacity"))
        }
        ; A dash pattern is a list of lengths; it reaches a backend as the text
        ; an SVG attribute wants, which is also what the reference writes.
        if (item.has("strokeDash")) {
            cmd.strokeDash = (VlSceneCommands.dashText((item.props.get("strokeDash"))))
        }
        if (item.has("strokeCap")) {
            cmd.strokeCap = (item.text("strokeCap"))
        }
    }

    sfn dashText:string (value:VlJson) {
        if (value.isString()) {
            return (value.str)
        }
        def out:string ""
        def total:int (value.count())
        def k:int 0
        while (k < total) {
            if (k > 0) {
                out = (out + ",")
            }
            def part:VlJson (value.at(k))
            out = (out + (VlJson.formatNumber(part.num 3)))
            k = (k + 1)
        }
        return out
    }
}

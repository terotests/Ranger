; ==============================================================================
; VlViewBox.rgr — how big the picture is.
; ==============================================================================
; The page was sized from what the AXES asked for: the plot, plus each axis'
; extent, plus the padding. That is most of the answer and it is not the
; answer, because plenty of ink is not an axis extent. A bottom axis' last
; label sticks out to the RIGHT of the plot, and its extent only ever described
; how far it reached DOWN. A point drawn at the edge of the scale is a circle
; whose left half is outside. A legend, a title, a facet's row header.
;
; The reference sizes a view from the BOUNDS of everything drawn — union the
; lot, see how far it escapes the plot on each side, and grow the page by that
; much:
;
;     left  = ceil(-bounds.x1)      right  = ceil(bounds.x2 - plotWidth)
;     top   = ceil(-bounds.y1)      bottom = ceil(bounds.y2 - plotHeight)
;
; each clamped at zero, and the origin is where the plot then sits. Forty-two of
; the eighty charts in the suite came out a different size than the reference's
; because this was missing, and one of them by fifteen pixels.
;
; The bounds rules below are the reference's own, and two of them are worth
; stating because neither is obvious:
;
;   * a GROUP counts its own box whenever it has a width or a height, painted
;     or not — an unpainted scope group still reserves the plot it contains
;   * a stroked PATH is expanded by the miter allowance, four times half the
;     stroke width, because a generic path may have a spike at a vertex. A
;     rectangle and a rule are not: they have no spikes, so they expand by half
;     the stroke and no more.
; ==============================================================================

Import "VlScene.rgr"
Import "VlBounds.rgr"
Import "VlText.rgr"
Import "VlShape.rgr"
Import "../../evg/PathBuilder.rgr"

class VlViewBox {

    ; The four numbers a renderer needs, in the order width, height, originX,
    ; originY. Computed together because each depends on the same bounds, and a
    ; caller that asked for them separately would walk the scene four times.
    sfn measure:[double] (rootItem:VlSceneItem plotWidth:double plotHeight:double padding:double) {
        def bounds (new VlBounds())
        bounds.set(0.0 0.0 plotWidth plotHeight)
        for rootItem.marks child:VlSceneMark ci {
            bounds.union((VlViewBox.ofMark(child)))
        }

        def left:double (VlViewBox.overhang((0.0 - bounds.x1)))
        def top:double (VlViewBox.overhang((0.0 - bounds.y1)))
        def right:double (VlViewBox.overhang((bounds.x2 - plotWidth)))
        def bottom:double (VlViewBox.overhang((bounds.y2 - plotHeight)))

        def out:[double]
        push out (((plotWidth + left) + right) + (padding * 2.0))
        push out (((plotHeight + top) + bottom) + (padding * 2.0))
        push out (left + padding)
        push out (top + padding)
        return out
    }

    ; How far past an edge something reaches, in whole pixels. Never negative:
    ; a drawing that stops short of the plot does not shrink the page.
    sfn overhang:double (v:double) {
        if (v <= 0.0) {
            return 0.0
        }
        return (to_double (ceil v))
    }

    ; --------------------------------------------------------------- per mark ---
    sfn ofMark:VlBounds (mark:VlSceneMark) {
        def out (new VlBounds())
        ; A line or an area is ONE shape over every item, so its bounds are the
        ; curve's and not the union of a box per point.
        if ((mark.markType == "line") || (mark.markType == "area")) {
            return (VlViewBox.ofCurve(mark))
        }
        for mark.items item:VlSceneItem idx {
            if (VlViewBox.drawn(item)) {
                if (mark.role == "axis") {
                    out.union((VlViewBox.ofAxis(item)))
                } {
                    out.union((VlViewBox.ofItem(mark.markType item)))
                }
            }
        }
        return out
    }

    ; An axis does not take the room its parts happen to occupy. The reference
    ; rebuilds the box from the TICKS and the LABELS only, and then squares it
    ; off against the scale's range; the grid and the domain line are left out
    ; on purpose.
    ;
    ; Leaving out the domain is the whole of the difference. A bottom axis'
    ; domain line sits ON the plot's lower edge and is a stroke, so half its
    ; width hangs below — and a page grown by that half pixel is a page one
    ; whole pixel taller than the reference's, which is what every chart here
    ; was. The line is drawn; it just does not get to make the page bigger.
    sfn ofAxis:VlBounds (item:VlSceneItem) {
        def box (new VlBounds())
        for item.marks child:VlSceneMark ci {
            if ((child.role == "axis-tick") || (child.role == "axis-label")) {
                box.union((VlViewBox.ofMark(child)))
            }
        }

        def orient:string (item.text("orient"))
        def range:double (item.number("range"))
        def reach:double 0.0
        if (orient == "top") { reach = (0.0 - box.y1) }
        if (orient == "left") { reach = (0.0 - box.x1) }
        if (orient == "right") { reach = box.x2 }
        if (orient == "bottom") { reach = box.y2 }
        if (! box.isSet) {
            reach = 0.0
        }
        def extent:double (VlViewBox.clampExtent(reach item))

        if (orient == "top") {
            box.add(0.0 (0.0 - extent))
            box.add(range 0.0)
        }
        if (orient == "left") {
            box.add((0.0 - extent) 0.0)
            box.add(0.0 range)
        }
        if (orient == "right") {
            box.add(0.0 0.0)
            box.add(extent range)
        }
        if (orient == "bottom") {
            box.add(0.0 0.0)
            box.add(range extent)
        }

        for item.marks child2:VlSceneMark ci2 {
            if (child2.role == "axis-title") {
                box.union((VlViewBox.ofMark(child2)))
            }
        }
        VlViewBox.strokeExpand(box item false)

        ; The group's own position carries the half pixel that puts a tick on a
        ; crisp line; the BOX it contributes does not, so it is taken back here.
        def delta:double 0.5
        if (item.has("translate")) {
            delta = (item.number("translate"))
        }
        box.translate(((item.number("x")) - delta) ((item.number("y")) - delta))
        return box
    }

    sfn clampExtent:double (reach:double item:VlSceneItem) {
        def out:double reach
        if (item.has("maxExtent")) {
            def maxExtent:double (item.number("maxExtent"))
            if (out > maxExtent) {
                out = maxExtent
            }
        }
        if (item.has("minExtent")) {
            def minExtent:double (item.number("minExtent"))
            if (out < minExtent) {
                out = minExtent
            }
        }
        return out
    }

    ; An item the encoder hid takes no room. The reference checks the same
    ; thing when it strokes, and a hidden axis label that still reserved space
    ; was one of the differences this found.
    sfn drawn:boolean (item:VlSceneItem) {
        if (item.has("opacity")) {
            if ((item.number("opacity")) <= 0.0) {
                return false
            }
        }
        return true
    }

    sfn ofItem:VlBounds (markType:string item:VlSceneItem) {
        if (markType == "group") {
            return (VlViewBox.ofGroup(item))
        }
        if (markType == "text") {
            return (VlViewBox.ofText(item))
        }
        if ((markType == "rect") || (markType == "image")) {
            def box (new VlBounds())
            def x:double (item.number("x"))
            def y:double (item.number("y"))
            box.set(x y (x + (item.number("width"))) (y + (item.number("height"))))
            VlViewBox.strokeExpand(box item false)
            return box
        }
        if (markType == "rule") {
            def box (new VlBounds())
            def x:double (item.number("x"))
            def y:double (item.number("y"))
            def x2:double x
            def y2:double y
            if (item.has("x2")) { x2 = (item.number("x2")) }
            if (item.has("y2")) { y2 = (item.number("y2")) }
            box.add(x y)
            box.add(x2 y2)
            VlViewBox.strokeExpand(box item false)
            return box
        }
        ; symbol, arc and path are all drawn as an outline about the item's own
        ; position, so all three are measured from the geometry the renderer
        ; would produce and then moved there.
        def builder (new PathBuilder())
        if (markType == "symbol") {
            def size:double 64.0
            if (item.has("size")) { size = (item.number("size")) }
            def shape:string "circle"
            if (item.has("shape")) { shape = (item.text("shape")) }
            VlShape.appendSymbol(builder shape size 0.0 0.0)
        }
        if (markType == "arc") {
            VlShape.appendArc(builder 0.0 0.0 (item.number("startAngle")) (item.number("endAngle")) (item.number("innerRadius")) (item.number("outerRadius")))
        }
        if (markType == "path") {
            builder.addPathData((item.text("path")))
        }
        def box:VlBounds (VlViewBox.ofBuilder(builder))
        VlViewBox.strokeExpand(box item true)
        box.translate((item.number("x")) (item.number("y")))
        return box
    }

    sfn ofCurve:VlBounds (mark:VlSceneMark) {
        def out (new VlBounds())
        def count:int (array_length mark.items)
        if (count == 0) {
            return out
        }
        def first:VlSceneItem (itemAt mark.items 0)
        def interpolate:string "linear"
        if (first.has("interpolate")) {
            interpolate = (first.text("interpolate"))
        }
        def tension:double 0.0
        if (interpolate == "catmull-rom") { tension = 0.5 }
        if (first.has("tension")) { tension = (first.number("tension")) }

        def pts:[double]
        for mark.items item:VlSceneItem idx {
            push pts (item.number("x"))
            push pts (item.number("y"))
        }
        def builder (new PathBuilder())
        VlShape.appendCurve(builder pts interpolate tension false)
        ; An area also covers the band back to its baseline.
        if (mark.markType == "area") {
            def horizontal:boolean (first.has("x2"))
            def back:[double]
            def k:int (count - 1)
            while (k >= 0) {
                def item:VlSceneItem (itemAt mark.items k)
                if horizontal {
                    push back (item.number("x2"))
                    push back (item.number("y"))
                } {
                    push back (item.number("x"))
                    push back (item.number("y2"))
                }
                k = (k - 1)
            }
            VlShape.appendCurve(builder back interpolate tension false)
        }
        out = (VlViewBox.ofBuilder(builder))
        VlViewBox.strokeExpand(out first true)
        return out
    }

    sfn ofGroup:VlBounds (item:VlSceneItem) {
        def out (new VlBounds())
        for item.marks child:VlSceneMark ci {
            out.union((VlViewBox.ofMark(child)))
        }
        ; A group with a size reserves it whether or not it paints one: an
        ; unpainted scope group still stands for the plot inside it.
        def w:double (item.number("width"))
        def h:double (item.number("height"))
        if ((w != 0.0) || (h != 0.0)) {
            out.add(0.0 0.0)
            out.add(w h)
        }
        VlViewBox.strokeExpand(out item false)
        out.translate((item.number("x")) (item.number("y")))
        return out
    }

    ; A label's box, turned about its anchor if the label is turned. The corners
    ; are rotated rather than the box, because a rotated box's bounds are the
    ; bounds of its four corners and nothing simpler is correct.
    sfn ofText:VlBounds (item:VlSceneItem) {
        def fontSize:double 11.0
        if (item.has("fontSize")) { fontSize = (item.number("fontSize")) }
        def align:string "left"
        if (item.has("align")) { align = (item.text("align")) }
        def baseline:string "alphabetic"
        if (item.has("baseline")) { baseline = (item.text("baseline")) }
        def x:double (item.number("x"))
        def y:double (item.number("y"))

        ; The reference's own construction, in its own order. The nudge is
        ; folded into the box; the ROTATION is about the un-nudged anchor,
        ; which is a difference of a whole label for anything both nudged and
        ; turned.
        def h:double fontSize
        def w:double (VlText.estimateWidth((item.text("text")) fontSize))
        def dx:double 0.0
        if (item.has("dx")) { dx = (item.number("dx")) }
        def dy:double 0.0
        if (item.has("dy")) { dy = (item.number("dy")) }
        dy = ((dy + (VlBounds.baselineOffset(baseline h))) - (VlBounds.roundHalfUp((0.8 * h))))
        if (align == "center") {
            dx = (dx - (w / 2.0))
        }
        if (align == "right") {
            dx = (dx - w)
        }
        dx = (dx + x)
        dy = (dy + y)
        def box (new VlBounds())
        box.set(dx dy (dx + w) (dy + h))

        def angle:double 0.0
        if (item.has("angle")) { angle = (item.number("angle")) }
        if (angle == 0.0) {
            return box
        }
        def radians:double ((angle * 3.141592653589793) / 180.0)
        def cosA:double (cos radians)
        def sinA:double (sin radians)
        ; The reference's own expression, term for term. A quarter turn has no
        ; exact cosine in binary — cos(-pi/2) is 6.1e-17, not 0 — so a rotated
        ; box lands a few atoms away from where the arithmetic says, and the
        ; page is sized by the CEILING of that. Writing the same expression a
        ; different way rounds somewhere else and can cost a whole pixel.
        ;
        ; It still does not always agree, and the reason is not arithmetic: the
        ; reference lays an axis title out by MOVING it — it bounds the title
        ; where it first put it and then translates the box — so its residue is
        ; the residue of a position the title no longer has. That is a property
        ; of its layout order rather than of the geometry, and reproducing it
        ; would mean reproducing the order. See the README.
        def out (new VlBounds())
        VlViewBox.addRotated(out box.x1 box.y1 x y cosA sinA)
        VlViewBox.addRotated(out box.x1 box.y2 x y cosA sinA)
        VlViewBox.addRotated(out box.x2 box.y1 x y cosA sinA)
        VlViewBox.addRotated(out box.x2 box.y2 x y cosA sinA)
        return out
    }

    ; Rotated about the anchor, as an offset from it. Algebraically the same as
    ; the reference's own expression and numerically not — which of the two
    ; lands on the reference's pixel depends on the chart, because the number
    ; it is being compared against carries a residue of its own. This form
    ; agrees on every chart in the suite but one.
    sfn addRotated:void (out:VlBounds px:double py:double cx:double cy:double cosA:double sinA:double) {
        def dx:double (px - cx)
        def dy:double (py - cy)
        out.add((cx + ((dx * cosA) - (dy * sinA))) (cy + ((dx * sinA) + (dy * cosA))))
    }

    sfn ofBuilder:VlBounds (builder:PathBuilder) {
        def out (new VlBounds())
        def b:PathBounds (builder.bounds())
        if (builder.isEmpty()) {
            return out
        }
        out.set(b.minX b.minY b.maxX b.maxY)
        return out
    }

    ; A stroke is centred on the path, so it reaches half its width to either
    ; side — except at a corner, where a miter join runs out to the miter limit.
    ; The reference allows for that on any generic path and not on a rectangle
    ; or a rule, which have no corner that can spike.
    sfn strokeExpand:void (box:VlBounds item:VlSceneItem miter:boolean) {
        if (! (item.has("stroke"))) {
            return
        }
        if ((item.text("stroke")) == "transparent") {
            return
        }
        if (item.has("opacity")) {
            if ((item.number("opacity")) == 0.0) {
                return
            }
        }
        if (item.has("strokeOpacity")) {
            if ((item.number("strokeOpacity")) == 0.0) {
                return
            }
        }
        def sw:double 1.0
        if (item.has("strokeWidth")) {
            sw = (item.number("strokeWidth"))
        }
        def e:double (sw / 2.0)
        if (item.has("strokeCap")) {
            if ((item.text("strokeCap")) == "square") {
                e = (1.4142135623730951 * (sw / 2.0))
            }
        }
        if miter {
            def limit:double 4.0
            if (item.has("strokeMiterLimit")) {
                limit = (item.number("strokeMiterLimit"))
            }
            def spike:double (limit * (sw / 2.0))
            if (spike > e) {
                e = spike
            }
        }
        box.expand(e)
    }
}

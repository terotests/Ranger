; ==============================================================================
; VlMath.rgr — the logarithm and power the Ranger operator set does not have.
; ==============================================================================
; Ranger's built-in maths is sin/cos/tan/asin/acos/atan2/sqrt/floor/ceil/fabs.
; There is no `log`, `exp` or `pow`, and three parts of a chart engine need
; them: the bin transform picks its step by a logarithm, a log scale is one by
; definition, and a pow/sqrt scale raises to an arbitrary exponent.
;
; `ln` is computed by range reduction plus the atanh series, which converges
; fast because the reduced argument is close to 1:
;
;   ln(x) = k·ln(2) + ln(m),  x = m·2^k, m in [1, 2)
;   ln(m) = 2·(z + z³/3 + z⁵/5 + …),  z = (m-1)/(m+1)
;
; `exp` is the Taylor series after reducing by ln(2), and `pow` is exp(y·ln x)
; with the integer exponents special-cased so that pow(10, 3) is exactly 1000
; rather than 999.9999999999998 — a chart's tick labels are read by people, and
; that difference is visible.
; ==============================================================================

class VlMath {
    sfn ln2:double () {
        return 0.6931471805599453
    }

    ; ln for x > 0. Zero and negatives answer 0, which is not the mathematical
    ; result; every caller here guards its argument, and there is no NaN literal
    ; to return instead.
    sfn ln:double (x:double) {
        if (x <= 0.0) {
            return 0.0
        }
        def m:double x
        def k:int 0
        while (m >= 2.0) {
            m = (m / 2.0)
            k = (k + 1)
        }
        while (m < 1.0) {
            m = (m * 2.0)
            k = (k - 1)
        }
        def z:double ((m - 1.0) / (m + 1.0))
        def z2:double (z * z)
        def term:double z
        def sum:double z
        def n:int 1
        while (n < 30) {
            term = (term * z2)
            def denom:double (to_double ((2 * n) + 1))
            def add:double (term / denom)
            sum = (sum + add)
            n = (n + 1)
        }
        return (((to_double k) * (VlMath.ln2())) + (2.0 * sum))
    }

    sfn log10:double (x:double) {
        return ((VlMath.ln(x)) / 2.302585092994046)
    }

    sfn exp:double (x:double) {
        if (x == 0.0) {
            return 1.0
        }
        def negative:boolean (x < 0.0)
        def v:double x
        if negative {
            v = (0.0 - v)
        }
        ; v = k·ln2 + r, with |r| <= ln2/2, so the series needs few terms.
        def k:int (floor ((v / (VlMath.ln2())) + 0.5))
        def r:double (v - ((to_double k) * (VlMath.ln2())))
        def term:double 1.0
        def sum:double 1.0
        def n:int 1
        while (n < 20) {
            term = ((term * r) / (to_double n))
            sum = (sum + term)
            n = (n + 1)
        }
        def scale:double 1.0
        def i:int 0
        while (i < k) {
            scale = (scale * 2.0)
            i = (i + 1)
        }
        def out:double (sum * scale)
        if negative {
            return (1.0 / out)
        }
        return out
    }

    ; An integer exponent multiplies rather than going through exp/ln, so the
    ; common cases stay exact.
    ; The inverse error function, to the coefficients the reference uses —
    ; Giles' rational approximation as Apache Commons Math ports it. A Q-Q plot
    ; against a normal distribution is drawn straight through this, and the
    ; whole point of copying the coefficients rather than deriving something
    ; equivalent is that the two answers agree to more places than a pixel can
    ; show.
    sfn erfInverse:double (x:double) {
        ; The logarithm's argument has to be computed as (1 - x)(1 + x): read
        ; as 1 - x*x it loses its precision near either end.
        def w:double (0.0 - (VlMath.ln(((1.0 - x) * (1.0 + x)))))
        if (w < 6.25) {
            w = (w - 3.125)
            def p:double -0.000000000000000000003644412064017819699584560640352476161994235076335351967611285439740953506770893000066280364990234375
            p = (-0.0000000000000000001685059138182016589004601583225132260686568374910248159330439232661547066527418792247772216796875 + (p * w))
            p = (0.0000000000000000012858480715256400167202130966442821622028154227769677041270934836347805685363709926605224609375 + (p * w))
            p = (0.0000000000000000111578776780251809597186231590774193200589727278178482638981705576952663250267505645751953125 + (p * w))
            p = (-0.00000000000000013331716628546209060243613518422509474975606587159038252110576650011353194713592529296875 + (p * w))
            p = (0.0000000000000000209727678759685616367305090639463496900030538110104583182646820205263793468475341796875 + (p * w))
            p = (0.000000000000006637638134358323832484839351542300984730681813472674690501662553288042545318603515625 + (p * w))
            p = (-0.0000000000000405456627297520686393407614479654744335068543292788234566614846698939800262451171875 + (p * w))
            p = (-0.00000000000008151934197605472152216072481181073359807372213925447113069822080433368682861328125 + (p * w))
            p = (0.00000000000263350931530823229770980228623225051498568660690580145455896854400634765625 + (p * w))
            p = (-0.00000000001297513325345353249801193548086010866142447905957624243455938994884490966796875 + (p * w))
            p = (-0.000000000054154120542946279316952992124417740234243456853846510057337582111358642578125 + (p * w))
            p = (0.00000000105121227332153228502383693148368448699869759366265498101711273193359375 + (p * w))
            p = (-0.000000004112633980346983697591752536515397054017739719711244106292724609375 + (p * w))
            p = (-0.000000029070369957882005086354906321123581225407406236627139151096343994140625 + (p * w))
            p = (0.00000042347877827932403518350150915805496509847216657362878322601318359375 + (p * w))
            p = (-0.00000136546920008346786451253369876202015120725263841450214385986328125 + (p * w))
            p = (-0.00001388252336278646871937751672287930659877019934356212615966796875 + (p * w))
            p = (0.0001867342080340571352 + (p * w))
            p = (-0.00074070253416626697512 + (p * w))
            p = (-0.0060336708714301490533 + (p * w))
            p = (0.24015818242558961693 + (p * w))
            p = (1.6536545626831027356 + (p * w))
            return (p * x)
        }
        if (w < 16.0) {
            w = ((sqrt w) - 3.25)
            def p:double 0.00000000221373769217757870488572972630415824912830657922313548624515533447265625
            p = (0.0000000907565619388853909789256703584403584983419932541437447071075439453125 + (p * w))
            p = (-0.00000027517406297064545428143170387180749258959622238762676715850830078125 + (p * w))
            p = (0.0000000182396292143892277554321069803211496918038392323069274425506591796875 + (p * w))
            p = (0.000001502740396890982762658048495219009765833106939680874347686767578125 + (p * w))
            p = (-0.0000040138675269815459690429630679187056330192717723548412322998046875 + (p * w))
            p = (0.0000029234449089955446044494617729991858823268557898700237274169921875 + (p * w))
            p = (0.000012475304481671778723274844613566614270894206129014492034912109375 + (p * w))
            p = (-0.000047318229009055733980983193820435417364933528006076812744140625 + (p * w))
            p = (0.00006828485145957317544763987005040917210862971842288970947265625 + (p * w))
            p = (0.0000240311103870978939986598199585188240234856493771076202392578125 + (p * w))
            p = (-0.0003550375203628474796 + (p * w))
            p = (0.00095328937973738049703 + (p * w))
            p = (-0.0016882755560235047313 + (p * w))
            p = (0.0024914420961078508066 + (p * w))
            p = (-0.0037512085075692412107 + (p * w))
            p = (0.005370914553590063617 + (p * w))
            p = (1.0052589676941592334 + (p * w))
            p = (3.0838856104922207635 + (p * w))
            return (p * x)
        }
        w = ((sqrt w) - 5.0)
        def p:double -0.0000000000271099206164385732433582954228079597326639404997195015312172472476959228515625
        p = (-0.000000000255564181699652520546823860689961659120594816840821295045316219329833984375 + (p * w))
        p = (0.0000000015076572693500548082839886112889275782134035353010403923690319061279296875 + (p * w))
        p = (-0.00000000378946544012673699374215089004901135805170042658573947846889495849609375 + (p * w))
        p = (0.000000007615701208078339380449597894630342498345498825074173510074615478515625 + (p * w))
        p = (-0.000000014960026627149240478396007014705304527524276636540889739990234375 + (p * w))
        p = (0.000000029147953450901080826447825215808062893074747989885509014129638671875 + (p * w))
        p = (-0.000000067711997758452339497942345895864502125505168805830180644989013671875 + (p * w))
        p = (0.0000002290048222802665471719446056708680004021516651846468448638916015625 + (p * w))
        p = (-0.0000009929827294231700253869347949642332196162897162139415740966796875 + (p * w))
        p = (0.0000045260625972231537038586828003428053079915116541087627410888671875 + (p * w))
        p = (-0.000019681778105531670566667734600940775635535828769207000732421875 + (p * w))
        p = (0.000075995277030017761138967757883477815994410775601863861083984375 + (p * w))
        p = (-0.00021503011930044477347 + (p * w))
        p = (-0.00013871931833623122026 + (p * w))
        p = (1.0103004648645343977 + (p * w))
        p = (4.8499064014085844221 + (p * w))
        return (p * x)
    }

    ; The value a standard normal distribution stands at, at a given
    ; probability — the probit. Two of anything is a quarter of the way in.
    sfn probit:double (p:double) {
        if (p <= 0.0) {
            return 0.0
        }
        if (p >= 1.0) {
            return 0.0
        }
        return (1.4142135623730951 * (VlMath.erfInverse(((2.0 * p) - 1.0))))
    }

    sfn pow:double (base:double exponent:double) {
        def rounded:double (to_double (floor (exponent + 0.5)))
        if (rounded == exponent) {
            return (VlMath.powInt(base (floor (exponent + 0.5))))
        }
        if (base <= 0.0) {
            return 0.0
        }
        return (VlMath.exp((exponent * (VlMath.ln(base)))))
    }

    sfn powInt:double (base:double exponent:int) {
        def n:int exponent
        def negative:boolean false
        if (n < 0) {
            negative = true
            n = (0 - n)
        }
        def out:double 1.0
        def k:int 0
        while (k < n) {
            out = (out * base)
            k = (k + 1)
        }
        if negative {
            if (out == 0.0) {
                return 0.0
            }
            return (1.0 / out)
        }
        return out
    }
}

; ==============================================================================
; VlScale.rgr — the scale family: band, point, linear, ordinal.
; ==============================================================================
; A scale maps a data value to a visual one. Vega delegates this to d3-scale
; through vega-scale; this is an independent implementation of the same
; behaviour, written so the numbers agree — the tick algorithm in particular is
; d3's `tickIncrement`, which is what decides whether an axis reads 0,20,40,60,80
; or 0,25,50,75,100, and any difference there shows up in every chart.
;
; One class holds every scale type rather than a type per subclass: a scale is
; data in Vega (it is a JSON object with a `type` field), the set is closed, and
; a single class keeps the cross-target output free of dispatch differences.
;
; The awkward ones are here too. `log` maps, nices and ticks like d3's, and its
; labels follow the reference's rule that a log axis prints only the ticks near
; the front of each decade. `pow` raises the magnitude and keeps the sign.
; `time` maps like a linear scale — an instant is a number — and hands its ticks
; to the calendar in VlTime, because months are not all the same length.
; ==============================================================================

Import "VlJson.rgr"
Import "VlMath.rgr"
Import "VlTime.rgr"
Import "VlFormat.rgr"

class VlScaleTick {
    def value:double 0.0
    def label:string ""
}

class VlScale {
    ; "band" | "point" | "linear" | "log" | "pow" | "sqrt" | "time" | "ordinal"
    def scaleType:string "linear"
    def name:string ""
    ; A log scale's base. Ten unless the spec says otherwise; the tick algorithm
    ; below treats a whole-number base differently from a fractional one, which
    ; is d3's own distinction and not a shortcut.
    def logBase:double 10.0
    ; A power scale's exponent. `sqrt` is the same scale with the exponent a
    ; half, which is what a bubble's radius or a radial chart's is written as.
    def powExponent:double 1.0
    ; Which wall clock a `time` scale reads. UTC unless the runtime was given a
    ; zone; a `utc` scale keeps this one whatever the runtime was told, because
    ; that is what asking for a `utc` scale means.
    def zone:VlTimeZone (new VlTimeZone())

    ; Quantitative domain / range.
    def domainMin:double 0.0
    def domainMax:double 1.0
    def rangeMin:double 0.0
    def rangeMax:double 1.0
    def clamp:boolean false

    ; Discrete domain (band, point, ordinal) and its lookup.
    def domainValues:[string]
    def domainIndex:[string:int]

    ; Ordinal output values.
    def rangeValues:[string]
    ; Whether those values are a RAMP rather than a list: a continuous scheme
    ; handed to an ordinal scale is sampled along, not taken in turn.
    def rampRange:boolean false
    ; A DISCRETIZING scale cuts a number into bands and answers one output per
    ; band: `quantize` cuts the domain into equal pieces, `quantile` cuts the
    ; DATA into pieces with the same number of readings in each, and
    ; `threshold` is told where to cut. All three are the same lookup once the
    ; cuts are known, so only the cutting differs.
    def thresholds:[double]
    ; The outputs of a discretizing scale when they are numbers rather than
    ; colours — the sizes a bubble takes, one per band.
    def rangeNumbers:[double]
    ; Every reading, for a `quantile` scale: it cuts the DATA rather than the
    ; domain, so it needs the readings themselves and not their extent.
    def sampleValues:[double]
    ; Where the middle of the range sits in the domain, when the chart said.
    def domainMid:double 0.0
    def hasDomainMid:boolean false

    ; Bin boundaries, when the scale was built for binned data. An axis over a
    ; binned scale labels the bins, not an arbitrary tick count.
    def binValues:[double]

    ; Band/point layout.
    def paddingInner:double 0.0
    def paddingOuter:double 0.0
    def align:double 0.5
    def round:boolean false
    ; When stepSet the range is derived from a step size rather than the other
    ; way round — `"range": {"step": …}`, which is how Vega-Lite sizes a chart
    ; from its data instead of the other way round.
    def stepSet:boolean false
    def stepValue:double 20.0

    ; Computed by layout().
    def bandStart:double 0.0
    def bandStep:double 0.0
    def bandWidth:double 0.0

    ; ---------------------------------------------------------------- domain --
    fn setNumericDomain:void (lo:double hi:double) {
        domainMin = lo
        domainMax = hi
    }

    fn setNumericRange:void (lo:double hi:double) {
        rangeMin = lo
        rangeMax = hi
    }

    ; A CONTINUOUS scale's `padding` is not a share of a band: it is pixels of
    ; room at each end, which is how a bar chart with negative values keeps its
    ; longest bar off the frame. The reference leaves the RANGE alone and
    ; widens the domain instead — by however much data those pixels would have
    ; held — so that the plot is still the plot and the axis still runs from
    ; edge to edge. Read as a band's padding it reached nothing at all.
    fn padDomain:void (by:double) {
        if (by <= 0.0) {
            return
        }
        def span:double (rangeMax - rangeMin)
        if (span < 0.0) {
            span = (0.0 - span)
        }
        if (span <= (2.0 * by)) {
            return
        }
        ; Room at the ends is room ON THE PAGE, so how much of the domain it
        ; is worth depends on how the domain reaches the page. A log scale
        ; spaces its values by their logarithms, so five pixels at each end of
        ; one is five pixels' worth of LOGARITHM — padded as if the spacing
        ; were even, an axis of four decades grew to eight.
        if (scaleType == "log") {
            if ((domainMin > 0.0) && (domainMax > 0.0)) {
                def lo:double (VlMath.ln(domainMin))
                def hi:double (VlMath.ln(domainMax))
                def spread:double (hi - lo)
                def step:double ((spread * by) / (span - (2.0 * by)))
                domainMin = (VlMath.exp((lo - step)))
                domainMax = (VlMath.exp((hi + step)))
                return
            }
        }
        def reach:double (domainMax - domainMin)
        def grow:double ((reach * by) / (span - (2.0 * by)))
        domainMin = (domainMin - grow)
        domainMax = (domainMax + grow)
        ; A time scale's domain is a pair of INSTANTS, and an instant is a
        ; whole number of milliseconds: the reference hands the widened ends
        ; back as dates, which drops the fraction. Kept, the fraction is worth
        ; a ten-thousandth of a pixel — and a ten-thousandth of a pixel either
        ; side of a half is the difference between a gridline drawn here and
        ; one drawn a pixel over.
        if ((scaleType == "time") || (scaleType == "utc")) {
            domainMin = (VlScale.wholeMillis(domainMin))
            domainMax = (VlScale.wholeMillis(domainMax))
        }
    }

    sfn wholeMillis:double (v:double) {
        if (v < 0.0) {
            return (0.0 - (to_double (floor (0.0 - v))))
        }
        return (to_double (floor v))
    }

    fn isDiscrete:boolean () {
        return (((scaleType == "band") || (scaleType == "point")) || (scaleType == "ordinal"))
    }

    fn addDomainValue:void (value:string) {
        if (! (has domainIndex value)) {
            set domainIndex value (array_length domainValues)
            push domainValues value
        }
    }

    fn domainCount:int () {
        return (array_length domainValues)
    }

    fn indexOfValue:int (value:string) {
        if (has domainIndex value) {
            return (unwrap (get domainIndex value))
        }
        return -1
    }

    ; --------------------------------------------------------- band / point --
    ; d3-scale's band layout, which vega-scale uses unchanged. `point` is a band
    ; with no inner width, so it shares every line of this.
    fn layout:void () {
        def n:int (array_length domainValues)
        def inner:double paddingInner
        if (scaleType == "point") {
            inner = 1.0
        }
        def start:double rangeMin
        def stop:double rangeMax
        def reverse:boolean (stop < start)
        if reverse {
            def swap:double start
            start = stop
            stop = swap
        }
        def slots:double (((to_double n) - inner) + (paddingOuter * 2.0))
        if (slots < 1.0) {
            slots = 1.0
        }
        def step:double 0.0
        if stepSet {
            step = stepValue
            stop = (start + (step * slots))
            ; A step does not stay a step. The reference sizes the PLOT from
            ; the step — `bandspace(...) * step` — and then lays the scale out
            ; inside the plot it got, dividing that width back by the same
            ; number of slots. The division does not always give the step back:
            ; twenty over four fifths is fifty exactly, and six hundred and
            ; sixty over thirteen point two is a hair under it. Keeping the
            ; step as stated put every band a hair too far right, and a tick
            ; that should have rounded down rounded up.
            step = ((stop - start) / slots)
        } {
            step = ((stop - start) / slots)
        }
        if round {
            step = (to_double (floor step))
        }
        def used:double (step * ((to_double n) - inner))
        start = (start + (((stop - start) - used) * align))
        def width:double (step * (1.0 - inner))
        if round {
            start = (to_double (floor (start + 0.5)))
            width = (to_double (floor (width + 0.5)))
        }
        bandStart = start
        bandStep = step
        bandWidth = width
        if reverse {
            ; d3 lays the bands out low-to-high and then reverses the values, so
            ; the first domain entry sits at the far end and the walk runs back.
            bandStart = (start + (step * ((to_double n) - 1.0)))
            bandStep = (0.0 - step)
        }
    }

    ; The full extent a band scale occupies with the current step — what
    ; `bandspace() * step` computes in a Vega signal.
    fn bandSpace:double () {
        def n:int (array_length domainValues)
        def inner:double paddingInner
        if (scaleType == "point") {
            inner = 1.0
        }
        def slots:double (((to_double n) - inner) + (paddingOuter * 2.0))
        if (slots < 1.0) {
            slots = 1.0
        }
        return slots
    }

    fn bandwidth:double () {
        return bandWidth
    }

    fn step:double () {
        return bandStep
    }

    ; ---------------------------------------------------------------- mapping --
    fn mapIndex:double (index:int) {
        return (bandStart + (bandStep * (to_double index)))
    }

    fn mapDiscrete:double (value:string) {
        def idx:int (this.indexOfValue(value))
        if (idx < 0) {
            return 0.0
        }
        return (this.mapIndex(idx))
    }

    fn isLog:boolean () {
        return (scaleType == "log")
    }

    fn isPow:boolean () {
        return ((scaleType == "pow") || (scaleType == "sqrt"))
    }

    ; A time scale maps like a linear one — an instant is a number of
    ; milliseconds — and differs only in where its ticks fall and what they are
    ; called, because months and years are not a fixed number of milliseconds.
    fn isTime:boolean () {
        return ((scaleType == "time") || (scaleType == "utc"))
    }

    ; A power scale's own exponent: `sqrt` names one rather than stating it.
    fn exponent:double () {
        if (scaleType == "sqrt") {
            return 0.5
        }
        return powExponent
    }

    ; The transform a power scale interpolates in. Negative values keep their
    ; sign — d3 raises the magnitude and puts the sign back, so a domain that
    ; crosses zero still runs the right way.
    fn powTransform:double (value:double) {
        def k:double (this.exponent())
        if (value < 0.0) {
            return (0.0 - (VlMath.pow((0.0 - value) k)))
        }
        return (VlMath.pow(value k))
    }

    ; Where a value sits between the domain's ends, from 0 to 1. A log scale
    ; interpolates the LOGARITHMS, which is the whole of what makes it one; the
    ; base cancels in the ratio, so a natural log serves every base.
    ; A domain with no width at all is not an error and not zero: every value in
    ; it is at the MIDDLE of the range, which is d3's rule and the only one that
    ; reads. A heat map of a count where every cell counts one is exactly this —
    ; mapping it to zero paints the whole table the palest colour the scheme has
    ; and says "all lowest" about numbers that are all the same.
    ; Where a value sits between the domain's ENDS, taking no notice of any
    ; point named in the middle. That is how the reference places a colour
    ; ramp's labels: it builds a fresh scale from the two ends alone, so the
    ; labels are spread evenly along the bar even where the colours are not.
    fn endFraction:double (value:double) {
        def saved:boolean hasDomainMid
        hasDomainMid = false
        def out:double (this.fraction(value))
        hasDomainMid = saved
        return out
    }

    fn fraction:double (value:double) {
        ; A scale may name a value that has to land in the MIDDLE of its range
        ; however far from the middle of its domain it is. That is what a
        ; diverging colour ramp is for — nothing above zero should be drawn in
        ; the colour that means nothing at all — and it makes the mapping two
        ; straight lines rather than one.
        if hasDomainMid {
            if ((value <= domainMid) && (domainMid > domainMin)) {
                return (0.5 * ((value - domainMin) / (domainMid - domainMin)))
            }
            if ((value >= domainMid) && (domainMax > domainMid)) {
                return (0.5 + (0.5 * ((value - domainMid) / (domainMax - domainMid))))
            }
        }
        if (this.isLog()) {
            if (value <= 0.0) {
                return 0.0
            }
            def lo:double (VlMath.ln(domainMin))
            def hi:double (VlMath.ln(domainMax))
            if (hi == lo) {
                return 0.5
            }
            return (((VlMath.ln(value)) - lo) / (hi - lo))
        }
        if (this.isPow()) {
            def lo:double (this.powTransform(domainMin))
            def hi:double (this.powTransform(domainMax))
            if (hi == lo) {
                return 0.5
            }
            return (((this.powTransform(value)) - lo) / (hi - lo))
        }
        def span:double (domainMax - domainMin)
        if (span == 0.0) {
            return 0.5
        }
        return ((value - domainMin) / span)
    }

    fn mapNumber:double (value:double) {
        ; A discretizing scale whose outputs are numbers answers the one its
        ; band names, not a point on a line.
        if (this.isDiscretizing()) {
            def total:int (array_length rangeNumbers)
            if (total > 0) {
                def band:int (to_int (this.bandOf(value)))
                if (band >= total) {
                    band = (total - 1)
                }
                if (band < 0) {
                    band = 0
                }
                return (itemAt rangeNumbers band)
            }
        }
        def t:double (this.fraction(value))
        if clamp {
            if (t < 0.0) {
                t = 0.0
            }
            if (t > 1.0) {
                t = 1.0
            }
        }
        return (rangeMin + (t * (rangeMax - rangeMin)))
    }

    ; The one entry point the encoder uses: a scale takes whatever the datum
    ; holds and answers a number.
    fn mapValue:double (v:VlJson) {
        if ((scaleType == "band") || (scaleType == "point")) {
            return (this.mapDiscrete((VlJson.domainKey(v))))
        }
        return (this.mapNumber((v.asDouble())))
    }

    ; A CONTINUOUS scale whose range is a colour ramp: the value's position in
    ; the domain picks a place along the ramp, and the two colours it falls
    ; between are mixed in proportion. The reference interpolates the same way —
    ; piecewise and in plain RGB, one segment per pair of adjacent colours —
    ; and rounds each channel, so `rgb(94, 192, 191)` is arrived at rather than
    ; approached.
    ; How far along the ramp a value is. This is NOT `fraction`, and the
    ; difference is one bit: a POSITION scale divides by the span, and a
    ; sequential COLOUR scale multiplies by one over it. The two disagree in
    ; the last place, and a channel that lands on a half then rounds the other
    ; way — thirteen of three hundred and sixty-one wind directions came out a
    ; count off in one channel, which is invisible and wrong.
    fn rampFraction:double (value:double) {
        if hasDomainMid {
            return (this.fraction(value))
        }
        def lo:double domainMin
        def hi:double domainMax
        def at:double value
        if (this.isLog()) {
            if (value <= 0.0) {
                return 0.0
            }
            lo = (VlMath.ln(domainMin))
            hi = (VlMath.ln(domainMax))
            at = (VlMath.ln(value))
        } {
            if (this.isPow()) {
                lo = (this.powTransform(domainMin))
                hi = (this.powTransform(domainMax))
                at = (this.powTransform(value))
            }
        }
        if (hi == lo) {
            return 0.5
        }
        def reciprocal:double (1.0 / (hi - lo))
        return ((at - lo) * reciprocal)
    }

    ; Whether this scale answers in BANDS rather than continuously.
    fn isDiscretizing:boolean () {
        return (((scaleType == "quantize") || (scaleType == "quantile")) || (scaleType == "threshold"))
    }

    ; Which band a number falls in: the count of cuts at or below it, which is
    ; what makes the first band everything under the first cut and the last
    ; everything from the last cut up.
    fn bandOf:double (value:double) {
        def n:int (array_length thresholds)
        def k:int 0
        while (k < n) {
            if (value < (itemAt thresholds k)) {
                return (to_double k)
            }
            k = (k + 1)
        }
        return (to_double n)
    }

    ; How many bands there are, which is one more than the number of cuts.
    fn bandCount:int () {
        return ((array_length thresholds) + 1)
    }

    fn mapRamp:string (value:double) {
        def n:int (array_length rangeValues)
        if (n == 0) {
            return ""
        }
        if (n == 1) {
            return (itemAt rangeValues 0)
        }
        ; A band answers ONE colour, and where the outputs came from a scheme
        ; it is the scheme sampled once per band — the same (i+1)/(n+1) an
        ; ordinal scale samples by, which keeps both ends of a ramp out of the
        ; picture where they are nearly black and nearly white.
        if (this.isDiscretizing()) {
            def band:int (to_int (this.bandOf(value)))
            def bands:int (this.bandCount())
            if rampRange {
                return (this.colourAt(((to_double (band + 1)) / (to_double (bands + 1)))))
            }
            if (band >= n) {
                band = (n - 1)
            }
            return (itemAt rangeValues band)
        }
        return (this.colourAt((this.rampFraction(value))))
    }

    ; The colour a fraction of the way along the ramp, mixed in plain RGB one
    ; segment per pair of adjacent stops — which is how the reference does it,
    ; rounding each channel so that `rgb(94, 192, 191)` is arrived at rather
    ; than approached.
    fn colourAt:string (at:double) {
        def n:int (array_length rangeValues)
        if (n == 0) {
            return ""
        }
        if (n == 1) {
            return (itemAt rangeValues 0)
        }
        def t:double at
        if (t < 0.0) {
            t = 0.0
        }
        if (t > 1.0) {
            t = 1.0
        }
        def scaled:double (t * (to_double (n - 1)))
        def i:int (floor scaled)
        if (i > (n - 2)) {
            i = (n - 2)
        }
        def local:double (scaled - (to_double i))
        def a:string (itemAt rangeValues i)
        def b:string (itemAt rangeValues (i + 1))
        def r:int (VlScale.mixChannel((VlScale.hexChannel(a 0)) (VlScale.hexChannel(b 0)) local))
        def g:int (VlScale.mixChannel((VlScale.hexChannel(a 1)) (VlScale.hexChannel(b 1)) local))
        def bl:int (VlScale.mixChannel((VlScale.hexChannel(a 2)) (VlScale.hexChannel(b 2)) local))
        return ((((((("rgb(" + (VlJson.intToText(r))) + ", ") + (VlJson.intToText(g))) + ", ") + (VlJson.intToText(bl))) + ")"))
    }

    sfn mixChannel:int (from:int to:int t:double) {
        def v:double ((to_double from) + (((to_double to) - (to_double from)) * t))
        return (floor (v + 0.5))
    }

    ; One channel of a "#rrggbb" colour, as a number. Anything else answers
    ; zero: a ramp is written by this project, not by a document.
    sfn hexChannel:int (colour:string index:int) {
        def start:int (1 + (index * 2))
        if ((strlen colour) < (start + 2)) {
            return 0
        }
        return (((VlScale.hexDigit((charAt colour start))) * 16) + (VlScale.hexDigit((charAt colour (start + 1)))))
    }

    sfn hexDigit:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return ((c - 97) + 10)
        }
        if ((c >= 65) && (c <= 70)) {
            return ((c - 65) + 10)
        }
        return 0
    }

    fn mapOrdinal:string (v:VlJson) {
        def total:int (array_length rangeValues)
        if (total == 0) {
            return ""
        }
        def idx:int (this.indexOfValue((VlJson.domainKey(v))))
        if (idx < 0) {
            idx = 0
        }
        ; A CONTINUOUS scheme handed to an ordinal scale is not a list of
        ; colours to take in turn: it is a ramp, and the categories are spread
        ; ALONG it — the reference samples it at (i+1)/(n+1), which keeps both
        ; ends of the ramp out of the picture where they are nearly black and
        ; nearly white. Taken in turn instead, eight decades of carbon dioxide
        ; came out in eight shades of the same near-black.
        if rampRange {
            def n:int (array_length domainValues)
            if (n > 0) {
                return (this.colourAt(((to_double (idx + 1)) / (to_double (n + 1)))))
            }
        }
        return (itemAt rangeValues (idx % total))
    }

    ; ------------------------------------------------------------------ nice --
    ; d3's nice: extend the domain outward to the tick step, repeating until the
    ; step stops changing. Vega applies it whenever a spec says `"nice": true`,
    ; which Vega-Lite emits for every quantitative scale.
    fn niceDomain:void (count:int) {
        def start:double domainMin
        def stop:double domainMax
        if (start == stop) {
            return
        }
        ; A log domain is extended to whole powers of the base — [19, 91]
        ; becomes [10, 100] — rather than to a tick step, because its ticks are
        ; not evenly spaced and there is no step to round to.
        ; A time domain nices to the boundary of whatever unit its ticks step
        ; by: a monthly axis starts on the first of a month, not on whatever
        ; day the data happened to begin.
        if (this.isTime()) {
            def unit:string (VlTime.unitOfTicks((this.timeTicks(count))))
            domainMin = (VlTime.floorTo(start unit zone))
            def end:double (VlTime.floorTo(stop unit zone))
            if (end < stop) {
                end = (VlTime.addUnit(end unit zone))
            }
            domainMax = end
            return
        }
        if (this.isLog()) {
            if (start > 0.0) {
                domainMin = (VlMath.pow(logBase (to_double (floor (this.logOf(start))))))
                domainMax = (VlMath.pow(logBase (to_double (ceil (this.logOf(stop))))))
            }
            return
        }
        def prestep:double 0.0
        def go:boolean true
        def guard:int 0
        while (go && (guard < 12)) {
            guard = (guard + 1)
            def step:double (VlScale.tickIncrement(start stop count))
            if (step == prestep) {
                go = false
            } {
                if (step == 0.0) {
                    go = false
                } {
                    if (step > 0.0) {
                        start = ((to_double (floor (start / step))) * step)
                        stop = ((to_double (ceil (stop / step))) * step)
                    } {
                        start = ((to_double (ceil (start * step))) / step)
                        stop = ((to_double (floor (stop * step))) / step)
                    }
                    prestep = step
                }
            }
        }
        domainMin = start
        domainMax = stop
    }

    fn logOf:double (value:double) {
        if (value <= 0.0) {
            return 0.0
        }
        return ((VlMath.ln(value)) / (VlMath.ln(logBase)))
    }

    ; ----------------------------------------------------------------- ticks --
    fn ticks:[double] (count:int) {
        return (this.ticksAbove(count 0.0))
    }

    ; The same, with a floor under the step. Only a time scale has anything to
    ; do with it: `tickMinStep` says a month is the finest thing worth ticking.
    fn ticksAbove:[double] (count:int minStep:double) {
        if (this.isLog()) {
            return (this.logTicks(count))
        }
        if (this.isTime()) {
            return (this.timeTicksAbove(count minStep))
        }
        return (VlScale.linearTicks(domainMin domainMax count))
    }

    ; The calendar decides these, not arithmetic. The two ends of its interval
    ; table — finer than a second, longer than a year — fall back on the linear
    ; tick algorithm, which is computed here and handed over so that the date
    ; layer knows about the calendar and nothing else.
    fn timeTicks:[double] (count:int) {
        return (this.timeTicksAbove(count 0.0))
    }

    fn timeTicksAbove:[double] (count:int minStep:double) {
        def n:int count
        if (n < 1) {
            n = 1
        }
        def msStep:double (VlScale.tickIncrement(domainMin domainMax n))
        def yearStep:double (VlScale.tickIncrement((domainMin / (VlTime.msPerYear())) (domainMax / (VlTime.msPerYear())) n))
        return (VlTime.ticks(domainMin domainMax n msStep yearStep zone minStep))
    }

    ; The ticks a LOG scale asks for, which are not evenly spaced: every whole
    ; multiple inside each decade — 10, 20 … 90, 100 — as long as the domain
    ; spans fewer decades than the tick count asked for. Past that there is no
    ; room for the multiples and the decades themselves are ticked instead, and
    ; if a narrow domain produces too few ticks either way, d3 falls back to
    ; ordinary linear ones. All three cases are its `scale.ticks`.
    fn logTicks:[double] (count:int) {
        def out:[double]
        def u:double domainMin
        def v:double domainMax
        def reverse:boolean (v < u)
        if reverse {
            def swap:double u
            u = v
            v = swap
        }
        if (u <= 0.0) {
            ; A log domain that reaches zero or below has no logarithm. d3
            ; reflects a wholly negative domain; a domain that straddles zero is
            ; undefined for both. Neither is generated by Vega-Lite, and a wrong
            ; answer here would be silent, so this gives none.
            return out
        }
        def n:int count
        if (n < 1) {
            n = 1
        }
        def i:double (this.logOf(u))
        def j:double (this.logOf(v))
        def wholeBase:boolean ((logBase - (to_double (floor logBase))) == 0.0)
        if (wholeBase && ((j - i) < (to_double n))) {
            def p:int (floor i)
            def pEnd:int (ceil j)
            def steps:int (floor logBase)
            while (p <= pEnd) {
                def decade:double (VlMath.pow(logBase (to_double p)))
                def k:int 1
                def stop:boolean false
                while ((k < steps) && (! stop)) {
                    def t:double ((to_double k) * decade)
                    if (t > v) {
                        stop = true
                    } {
                        if (! (t < u)) {
                            push out t
                        }
                    }
                    k = (k + 1)
                }
                p = (p + 1)
            }
            if (((array_length out) * 2) < n) {
                out = (VlScale.linearTicks(u v n))
            }
        } {
            def span:int n
            if ((j - i) < (to_double n)) {
                span = (floor (j - i))
            }
            def powers:[double] (VlScale.linearTicks(i j span))
            for powers e:double idx {
                push out (VlMath.pow(logBase e))
            }
        }
        if reverse {
            return (VlScale.reversed(out))
        }
        return out
    }

    sfn reversed:[double] (values:[double]) {
        def out:[double]
        def k:int ((array_length values) - 1)
        while (k >= 0) {
            push out (itemAt values k)
            k = (k - 1)
        }
        return out
    }

    sfn linearTicks:[double] (from:double to:double count:int) {
        def out:[double]
        def start:double from
        def stop:double to
        if (start == stop) {
            push out start
            return out
        }
        def reverse:boolean (stop < start)
        if reverse {
            def swap:double start
            start = stop
            stop = swap
        }
        def step:double (VlScale.tickIncrement(start stop count))
        if (step == 0.0) {
            return out
        }
        if (step > 0.0) {
            def i0:int (ceil (start / step))
            def i1:int (floor (stop / step))
            def i:int i0
            while (i <= i1) {
                push out ((to_double i) * step)
                i = (i + 1)
            }
        } {
            def i0:int (floor (start * step))
            def i1:int (ceil (stop * step))
            def i:int i0
            while (i >= i1) {
                push out ((to_double i) / step)
                i = (i - 1)
            }
        }
        if reverse {
            return (VlScale.reversed(out))
        }
        return out
    }

    ; d3-array's tickIncrement, with the two constants it compares against
    ; (sqrt(50) and sqrt(10)) written out because the operator set has no `pow`.
    ; A negative answer means "the step is 1/-answer", which is how d3 keeps the
    ; sub-1 steps exact instead of accumulating 0.1 error.
    sfn tickIncrement:double (start:double stop:double count:int) {
        def n:int count
        if (n < 1) {
            n = 1
        }
        def step:double ((stop - start) / (to_double n))
        if (step <= 0.0) {
            return 0.0
        }
        def power:int (VlScale.floorLog10(step))
        def error:double (step / (VlScale.pow10(power)))
        def factor:double 1.0
        if (error >= 7.0710678118654755) {
            factor = 10.0
        } {
            if (error >= 3.1622776601683795) {
                factor = 5.0
            } {
                if (error >= 1.4142135623730951) {
                    factor = 2.0
                }
            }
        }
        if (power >= 0) {
            return (factor * (VlScale.pow10(power)))
        }
        return (0.0 - ((VlScale.pow10((0 - power))) / factor))
    }

    ; floor(log10(x)) for x > 0 by repeated scaling: the operator set has no
    ; `log`, and an integer exponent is all the tick algorithm ever needs.
    sfn floorLog10:int (x:double) {
        if (x <= 0.0) {
            return 0
        }
        def v:double x
        def p:int 0
        while (v >= 10.0) {
            v = (v / 10.0)
            p = (p + 1)
        }
        while (v < 1.0) {
            v = (v * 10.0)
            p = (p - 1)
        }
        return p
    }

    sfn pow10:double (n:int) {
        def out:double 1.0
        def k:int 0
        if (n >= 0) {
            while (k < n) {
                out = (out * 10.0)
                k = (k + 1)
            }
            return out
        }
        def m:int (0 - n)
        while (k < m) {
            out = (out / 10.0)
            k = (k + 1)
        }
        return out
    }

    ; The label Vega prints for a tick with no explicit format: the shortest
    ; decimal that still names the value.
    sfn tickLabel:string (value:double) {
        return (VlJson.withMinusSign((VlJson.formatNumber(value 6))))
    }

    ; A log axis does not label every tick it draws. With ten ticks to a decade
    ; there is no room, so the reference keeps the ones near the front of each
    ; decade and blanks the rest: 10, 20 … 80 are printed and 90 is not. The
    ; test is d3's, and `k` is how many it has room for — the tick count the
    ; axis asked for, spread over the ticks that came back.
    ;
    ; The label itself is grouped rather than shortened: a thousand is "1,000",
    ; not "1k". That is the reference's `formatFloat`, which is a plain grouped
    ; decimal with the trailing zeroes trimmed.
    fn logLabels:[string] (values:[double] count:int) {
        def out:[string]
        def total:int (array_length values)
        def k:double 1.0
        if (total > 0) {
            k = ((logBase * (to_double count)) / (to_double total))
            if (k < 1.0) {
                k = 1.0
            }
        }
        for values v:double idx {
            if (this.logLabelShown(v k)) {
                push out (VlScale.groupedLabel(v))
            } {
                push out ""
            }
        }
        return out
    }

    fn logLabelShown:boolean (value:double k:double) {
        if (value <= 0.0) {
            return false
        }
        def decade:double (VlMath.pow(logBase (to_double (floor ((this.logOf(value)) + 0.5)))))
        if (decade == 0.0) {
            return false
        }
        def i:double (value / decade)
        ; A value just below a power of the base — 90 against 100 — divides to
        ; less than one, and is counted as the ninth step of the decade below.
        if ((i * logBase) < (logBase - 0.5)) {
            i = (i * logBase)
        }
        return (i <= (k + 0.000000001))
    }

    ; A number with its integer digits grouped in threes, which is what the
    ; reference prints on a log axis.
    sfn groupedLabel:string (value:double) {
        def text:string (VlJson.formatSignificant(value 12))
        def sign:string ""
        def body:string text
        if ((strlen text) > 0) {
            if ((substring text 0 1) == "-") {
                sign = "-"
                body = (substring text 1 (strlen text))
            }
        }
        def dot:int -1
        def n:int (strlen body)
        def scan:int 0
        while (scan < n) {
            if ((substring body scan (scan + 1)) == ".") {
                dot = scan
            }
            scan = (scan + 1)
        }
        def whole:string body
        def rest:string ""
        if (dot >= 0) {
            whole = (substring body 0 dot)
            rest = (substring body dot n)
        }
        def grouped:string ""
        def digits:int (strlen whole)
        def i:int 0
        while (i < digits) {
            def left:int (digits - i)
            if (i > 0) {
                if ((left % 3) == 0) {
                    grouped = (grouped + ",")
                }
            }
            grouped = (grouped + (substring whole i (i + 1)))
            i = (i + 1)
        }
        def out:string ((sign + grouped) + rest)
        return (VlJson.withMinusSign(out))
    }

    ; A tick SET is formatted to one shared precision, chosen from the step —
    ; which is why an axis stepping by 0.5 reads 0.0, 0.5, 1.0 and not 0, 0.5,
    ; 1. Formatting each value on its own gives a ragged axis and disagrees
    ; with the reference.
    sfn tickLabels:[string] (values:[double]) {
        def out:[string]
        def decimals:int (VlScale.tickDecimals(values))
        for values v:double idx {
            out = (VlScale.appendLabel(out v decimals))
        }
        return out
    }

    ; A tick's text when the specification named no format. The reference's own
    ; default is `,` — thousands are grouped — and it applies to every guide it
    ; draws. Nothing in the curated suite has an axis that reaches a thousand,
    ; so this was missing for as long as there was nothing to notice it: a
    ; count axis read 15000 where the reference reads 15,000, and the label is
    ; then a different WIDTH, which moves the axis, which moves the plot, which
    ; changes the size of the page.
    sfn appendLabel:[string] (out:[string] value:double decimals:int) {
        def text:string (VlJson.formatNumber(value decimals))
        if (decimals > 0) {
            text = (VlScale.padDecimals(text decimals))
        }
        push out (VlJson.withMinusSign((VlFormat.group(text))))
        return out
    }

    ; The decimals the smallest gap in the set needs: a step of 0.5 needs one,
    ; a step of 10 needs none.
    sfn tickDecimals:int (values:[double]) {
        def total:int (array_length values)
        if (total < 2) {
            return 0
        }
        def step:double 0.0
        def k:int 1
        while (k < total) {
            def gap:double ((itemAt values k) - (itemAt values (k - 1)))
            if (gap < 0.0) {
                gap = (0.0 - gap)
            }
            if (gap > 0.0) {
                if ((step == 0.0) || (gap < step)) {
                    step = gap
                }
            }
            k = (k + 1)
        }
        return (VlScale.decimalsForStep((VlScale.cleanStep(step))))
    }

    ; The gap between two ticks, as the tick algorithm meant it rather than as
    ; the arithmetic left it. Ticks are whole multiples of a step, so a gap is
    ; that step — but 0.7 minus 0.6000000000000001 is 0.09999999999999987, and
    ; asked how many decimals THAT needs the answer is two. The reference never
    ; subtracts: it takes the step straight from the tick algorithm and prints
    ; a tenth as one decimal. Rounding the gap to six significant figures says
    ; the same thing without changing how ticks are found.
    sfn cleanStep:double (step:double) {
        if (step <= 0.0) {
            return step
        }
        def power:int (VlScale.floorLog10(step))
        def scaled:double (step / (VlScale.pow10(power)))
        scaled = ((to_double (floor ((scaled * 100000.0) + 0.5))) / 100000.0)
        return (scaled * (VlScale.pow10(power)))
    }

    ; How many decimals a step needs: half needs one, ten needs none.
    sfn decimalsForStep:int (step:double) {
        if (step == 0.0) {
            return 0
        }
        def decimals:int 0
        def scaled:double step
        while ((scaled < 1.0) && (decimals < 10)) {
            scaled = (scaled * 10.0)
            decimals = (decimals + 1)
        }
        return decimals
    }

    ; A BINNED axis draws its ticks on the bin edges and formats them to the
    ; precision the requested tick COUNT would have needed. Those are different
    ; numbers and the reference uses the second: ten bins an integer apart are
    ; labelled "1.0", "2.0" because a chart two hundred pixels wide asks for a
    ; tick every ten, and twenty ticks over that domain is a step of a half.
    sfn binLabels:[string] (values:[double] lo:double hi:double count:int) {
        ; `tickIncrement` answers d3's own encoding: a positive number is the
        ; step, and a NEGATIVE one means the step is its reciprocal — that is
        ; how a step of a half comes back as -2 without ever being written as
        ; a fraction. Reading the sign off and taking the magnitude would say
        ; two where the answer is a half, and the precision would come out
        ; zero where it should be one.
        def increment:double (VlScale.tickIncrement(lo hi count))
        def step:double increment
        if (increment < 0.0) {
            step = (1.0 / (0.0 - increment))
        }
        def decimals:int (VlScale.decimalsForStep(step))
        def out:[string]
        for values v:double idx {
            out = (VlScale.appendLabel(out v decimals))
        }
        return out
    }

    ; Zero-fills so every label in the set shows the same number of decimals.
    sfn padDecimals:string (text:string decimals:int) {
        def dot:int -1
        def n:int (strlen text)
        def k:int 0
        while (k < n) {
            if ((substring text k (k + 1)) == ".") {
                dot = k
            }
            k = (k + 1)
        }
        def out:string text
        def have:int 0
        if (dot < 0) {
            out = (out + ".")
        } {
            have = ((n - dot) - 1)
        }
        def pad:int have
        while (pad < decimals) {
            out = (out + "0")
            pad = (pad + 1)
        }
        return out
    }
}

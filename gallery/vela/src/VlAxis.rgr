; ==============================================================================
; VlAxis.rgr — an axis specification becomes ordinary marks.
; ==============================================================================
; There is no axis primitive in a scene. An axis is a group holding rules and
; text: grid lines, tick marks, labels, the domain line and a title. That is how
; the reference builds one, and following it exactly is what lets a renderer
; stay a renderer — it draws rules and text and never learns what a tick is.
;
; None of it needs path support, which is why axes land before any drawing
; backend: a bar chart with axes is rectangles, straight lines and text.
;
; The numbers below (tick size 5, label padding 2, title padding 4, the greys)
; are the reference's axis defaults. A spec that states its own wins.
; ==============================================================================

Import "VlJson.rgr"
Import "VlScale.rgr"
Import "VlScene.rgr"
Import "VlText.rgr"
Import "VlBounds.rgr"
Import "VlFormat.rgr"
Import "VlTime.rgr"

class VlAxisTickValue {
    def value:VlJson (new VlJson)
    def position:double 0.0
    ; Where the LABEL goes, which is not always where the tick goes. The axis
    ; group is translated by half a pixel so that its one-pixel rules land on a
    ; device pixel instead of straddling two; a text label wants the true
    ; position instead, so on a discrete scale it takes that half pixel back.
    ; The reference does the same, and only for band and point scales — a
    ; continuous axis puts both at the same place.
    def labelPosition:double 0.0
    def label:string ""
}

class VlAxis {
    ; Defaults, overridable per axis by the spec.
    def tickSize:double 5.0
    def tickWidth:double 1.0
    def tickColor:string "#888"
    def labelPadding:double 2.0
    def labelFontSize:double 10.0
    def labelFont:string "sans-serif"
    def labelColor:string "#000"
    def labelLimit:double 180.0
    def domainColor:string "#888"
    def domainWidth:double 1.0
    def gridColor:string "#ddd"
    def gridWidth:double 1.0
    def gridOpacity:double 1.0
    def titlePadding:double 4.0
    def titleFontSize:double 11.0
    def titleColor:string "#000"
    def titleFontWeight:string "bold"
    def bandPosition:double 0.5
    ; A tick is a one-pixel line, so its position is rounded — the reference's
    ; `tickRound`, on by default. Labels are not rounded: text has no pixel
    ; grid to align to.
    def tickRound:boolean true
    ; A label within `labelFlush` pixels of the end of the scale's range is
    ; pulled inside the plot instead of hanging over its edge. The threshold
    ; matters: `true` means ONE pixel, not "the first and last label", so a last
    ; tick that does not land exactly on the range end is still centred.
    def labelFlushSet:boolean false
    def labelFlushThreshold:double 1.0
    ; How labels that would collide are thinned: "" not at all, "parity" by
    ; hiding every second one until they fit, "greedy" by hiding each one that
    ; runs into the last one kept. Vega-Lite asks for greedy on a log axis,
    ; where the ticks are unevenly spaced and halving removes the wrong ones.
    def labelOverlapMode:string ""
    ; Opacities are stroke opacities, and only exist when a spec sets them: the
    ; reference leaves `opacity` at 1 and puts the number on `strokeOpacity`,
    ; which is a different thing to a renderer that strokes and fills.
    def gridOpacitySet:boolean false
    ; A dash pattern belongs to the guide that asked for it. It reached nothing
    ; before: `gridDash` was read from the specification, stored nowhere, and a
    ; dashed grid came out solid. The scene comparison could not see it either,
    ; because a dash is an ARRAY and the comparison only looked at channels
    ; whose value was a single number or string.
    def gridDash:VlJson (new VlJson)
    def gridDashSet:boolean false
    def tickDash:VlJson (new VlJson)
    def tickDashSet:boolean false
    def domainDash:VlJson (new VlJson)
    def domainDashSet:boolean false
    def tickOpacitySet:boolean false
    def tickOpacity:double 1.0
    def domainOpacitySet:boolean false
    def domainOpacity:double 1.0
    ; A spec may turn the labels and say how they should then sit. Vega-Lite
    ; emits all three together when it rotates labels to fit.
    def labelAngle:double 0.0
    def labelAlign:string ""
    def labelBaseline:string ""
    def minExtent:double 0.0
    def maxExtent:double 200.0
    ; A specification may name the number format its labels use — `".0%"` on a
    ; normalized bar chart. Without one a tick SET shares a precision chosen
    ; from its own step, which is the reference's behaviour for an unformatted
    ; axis and a different rule entirely.
    def labelFormat:string ""
    def labelFormatSet:boolean false

    ; Filled in by build(), read by the layout step.
    def labelExtent:double 0.0
    def totalExtent:double 0.0

    fn readConfig:void (adef:VlJson) {
        tickSize = (adef.doubleOr("tickSize" tickSize))
        labelPadding = (adef.doubleOr("labelPadding" labelPadding))
        labelFontSize = (adef.doubleOr("labelFontSize" labelFontSize))
        titlePadding = (adef.doubleOr("titlePadding" titlePadding))
        titleFontSize = (adef.doubleOr("titleFontSize" titleFontSize))
        bandPosition = (adef.doubleOr("bandPosition" bandPosition))
        minExtent = (adef.doubleOr("minExtent" minExtent))
        maxExtent = (adef.doubleOr("maxExtent" maxExtent))
        tickColor = (adef.stringOr("tickColor" tickColor))
        labelColor = (adef.stringOr("labelColor" labelColor))
        labelFont = (adef.stringOr("labelFont" labelFont))
        domainColor = (adef.stringOr("domainColor" domainColor))
        gridColor = (adef.stringOr("gridColor" gridColor))
        titleColor = (adef.stringOr("titleColor" titleColor))
        titleFontWeight = (adef.stringOr("titleFontWeight" titleFontWeight))
        tickWidth = (adef.doubleOr("tickWidth" tickWidth))
        domainWidth = (adef.doubleOr("domainWidth" domainWidth))
        gridWidth = (adef.doubleOr("gridWidth" gridWidth))
        gridOpacity = (adef.doubleOr("gridOpacity" gridOpacity))
        tickRound = (adef.boolOr("tickRound" tickRound))
        gridOpacitySet = (adef.has("gridOpacity"))
        gridDashSet = (adef.has("gridDash"))
        if gridDashSet {
            gridDash = (adef.get("gridDash"))
        }
        tickDashSet = (adef.has("tickDash"))
        if tickDashSet {
            tickDash = (adef.get("tickDash"))
        }
        domainDashSet = (adef.has("domainDash"))
        if domainDashSet {
            domainDash = (adef.get("domainDash"))
        }
        tickOpacitySet = (adef.has("tickOpacity"))
        tickOpacity = (adef.doubleOr("tickOpacity" tickOpacity))
        domainOpacitySet = (adef.has("domainOpacity"))
        domainOpacity = (adef.doubleOr("domainOpacity" domainOpacity))
        labelFormatSet = (adef.has("format"))
        labelFormat = (adef.stringOr("format" ""))
        this.readFlush((adef.get("labelFlush")))
        this.readOverlap((adef.get("labelOverlap")))
        labelAngle = (adef.doubleOr("labelAngle" labelAngle))
        labelAlign = (adef.stringOr("labelAlign" labelAlign))
        labelBaseline = (adef.stringOr("labelBaseline" labelBaseline))
    }

    ; `labelFlush` is a threshold in pixels, and `true` is the number one — the
    ; reference passes it straight into a numeric comparison. A spec may state
    ; the threshold instead, and zero is a real threshold ("only a label exactly
    ; on the end"), so the flag records that it was given at all.
    fn readFlush:void (v:VlJson) {
        if (v.isBool()) {
            labelFlushSet = (v.asBool())
            labelFlushThreshold = 1.0
            return
        }
        if (v.isNumber()) {
            labelFlushSet = true
            labelFlushThreshold = v.num
        }
    }

    fn readOverlap:void (v:VlJson) {
        if (v.isBool()) {
            labelOverlapMode = ""
            if (v.asBool()) {
                labelOverlapMode = "parity"
            }
            return
        }
        if (v.isString()) {
            labelOverlapMode = (v.asString())
        }
    }

    ; Which end of the range a position is close enough to. The reference's
    ; `flush()`: the nearer end wins, and only if it is within the threshold.
    fn flushSide:string (position:double rangeFrom:double rangeTo:double) {
        if (! labelFlushSet) {
            return ""
        }
        def lo:double rangeFrom
        def hi:double rangeTo
        if (hi < lo) {
            def swap:double lo
            lo = hi
            hi = swap
        }
        def toStart:double (position - lo)
        if (toStart < 0.0) {
            toStart = (0.0 - toStart)
        }
        def toEnd:double (hi - position)
        if (toEnd < 0.0) {
            toEnd = (0.0 - toEnd)
        }
        if ((toStart < toEnd) && (toStart <= labelFlushThreshold)) {
            return "start"
        }
        if (toEnd <= labelFlushThreshold) {
            return "end"
        }
        return ""
    }

    ; Labels turned on their side take their WIDTH out of the axis' extent
    ; rather than their height, which is what pushes a rotated-label axis
    ; further from the plot and moves its title with it.
    fn labelsAreTurned:boolean () {
        def a:double labelAngle
        if (a < 0.0) {
            a = (0.0 - a)
        }
        if (a == 0.0) {
            return false
        }
        if (a == 180.0) {
            return false
        }
        return true
    }

    sfn roundTo:double (v:double) {
        return (to_double (floor (v + 0.5)))
    }

    ; --------------------------------------------------------------- ticks ----
    ; A band or point scale is labelled by its domain; a quantitative one by the
    ; tick algorithm. `bandPosition` centres a band's label under its band.
    sfn tickValues:[VlAxisTickValue] (sc:VlScale tickCount:int bandPosition:double format:string) {
        def out:[VlAxisTickValue]
        ; A binned scale is labelled at its bin boundaries. Asking the tick
        ; algorithm instead gives a tick count that has nothing to do with the
        ; bins the data was actually put in.
        if ((array_length sc.binValues) > 0) {
            def labels:[string] (VlAxis.labelSet(sc.binValues format))
            if ((strlen format) == 0) {
                labels = (VlScale.binLabels(sc.binValues sc.domainMin sc.domainMax tickCount))
            }
            for sc.binValues v:double idx {
                def tvb (new VlAxisTickValue())
                tvb.value = (VlJson.numberValue(v))
                tvb.position = (sc.mapNumber(v))
                tvb.labelPosition = tvb.position
                tvb.label = (itemAt labels idx)
                push out tvb
            }
            return out
        }
        if ((sc.scaleType == "band") || ((sc.scaleType == "point") || (sc.scaleType == "ordinal"))) {
            for sc.domainValues name:string idx {
                def tv (new VlAxisTickValue())
                tv.value = (VlJson.stringValue(name))
                tv.position = ((sc.mapIndex(idx)) + ((sc.bandwidth()) * bandPosition))
                ; A BAND's label takes back the half pixel the axis group was
                ; offset by, because a band's own positions are whole numbers
                ; and the label wants to sit on one. A POINT scale's are not —
                ; nine points across two hundred pixels land on 11.111, 33.333,
                ; 55.555 — so there is no half pixel to take back, and taking
                ; one anyway moves the label off its own point and rounds the
                ; tick to the wrong pixel.
                tv.labelPosition = tv.position
                if (sc.scaleType == "band") {
                    tv.labelPosition = (tv.position - 0.5)
                }
                tv.label = name
                push out tv
            }
            return out
        }
        def values:[double] (sc.ticks(tickCount))
        ; A log axis labels only some of the ticks it draws, and formats those
        ; with grouped digits rather than to one shared precision — its ticks
        ; have no shared step to take a precision from.
        def labels:[string] (VlAxis.labelSet(values format))
        if (sc.isLog()) {
            labels = (sc.logLabels(values tickCount))
        }
        ; A date is named, not numbered: the finest unit an instant is not
        ; already on decides what to call it, which is why a January tick reads
        ; as its year while its neighbours read as their months.
        if (sc.isTime()) {
            if ((strlen format) == 0) {
                clear labels
                for values v:double vi {
                    push labels (VlTime.multiFormat(v sc.zone))
                }
            }
        }
        for values v:double idx {
            def tv (new VlAxisTickValue())
            tv.value = (VlJson.numberValue(v))
            tv.position = (sc.mapNumber(v))
            tv.labelPosition = tv.position
            tv.label = (itemAt labels idx)
            push out tv
        }
        return out
    }

    ; The text of a tick set. A specification's own format applies to each value
    ; on its own; without one the set shares a precision chosen from its step,
    ; which is why an unformatted axis reads 0.0, 0.5, 1.0 rather than 0, 0.5, 1.
    sfn labelSet:[string] (values:[double] format:string) {
        if ((strlen format) == 0) {
            return (VlScale.tickLabels(values))
        }
        def out:[string]
        for values v:double idx {
            push out (VlFormat.apply(v format))
        }
        return out
    }

    ; --------------------------------------------------------------- build ----
    ; `gridRange` is how far a grid line reaches — the extent of the OTHER axis'
    ; scale, which is why a spec names a `gridScale`.
    fn build:VlSceneMark (adef:VlJson sc:VlScale ticks:[VlAxisTickValue] gridFrom:double gridTo:double chartWidth:double chartHeight:double) {
        this.readConfig(adef)

        def orient:string (adef.stringOr("orient" "left"))
        def vertical:boolean ((orient == "left") || (orient == "right"))
        def range:double chartHeight
        if (! vertical) {
            range = chartWidth
        }

        def mark (new VlSceneMark())
        mark.markType = "group"
        mark.role = "axis"
        def group:VlSceneItem (mark.addItem())
        group.setString("orient" orient)
        group.setNumber("offset" 0.0)
        group.setNumber("position" 0.0)
        group.setNumber("titlePadding" titlePadding)
        group.setNumber("minExtent" minExtent)
        group.setNumber("maxExtent" maxExtent)
        group.setNumber("range" range)
        if labelFormatSet {
            group.setString("format" labelFormat)
        }

        ; Half-pixel translate: a one-pixel line drawn on an integer coordinate
        ; straddles two device pixels and comes out grey. The reference offsets
        ; the whole axis group by 0.5 for the same reason.
        def gx:double 0.5
        def gy:double 0.5
        if (orient == "bottom") {
            gy = (chartHeight + 0.5)
        }
        if (orient == "right") {
            gx = (chartWidth + 0.5)
        }
        group.setNumber("x" gx)
        group.setNumber("y" gy)

        def wantGrid:boolean (adef.boolOr("grid" false))
        def wantTicks:boolean (adef.boolOr("ticks" true))
        def wantLabels:boolean (adef.boolOr("labels" true))
        def wantDomain:boolean (adef.boolOr("domain" true))
        def title:string (adef.stringOr("title" ""))

        if wantGrid {
            push group.marks (this.buildGrid(ticks vertical gridFrom gridTo))
        }
        if wantTicks {
            push group.marks (this.buildTicks(ticks orient vertical))
        }

        ; The labels decide the axis' extent, so their width is measured even
        ; when the marks are not built.
        def labels:[string]
        for ticks tv:VlAxisTickValue ti {
            push labels tv.label
        }
        def widest:double (VlText.widestLabel(labels labelFontSize))
        labelExtent = 0.0
        if wantLabels {
            ; The ends a flushed label is measured against are the scale's own
            ; range, which for a discrete scale is the plot's extent rather
            ; than the band positions.
            def flushFrom:double sc.rangeMin
            def flushTo:double sc.rangeMax
            if ((sc.scaleType == "band") || (sc.scaleType == "point")) {
                flushFrom = 0.0
                flushTo = range
            }
            def labelMark:VlSceneMark (this.buildLabels(ticks orient vertical flushFrom flushTo))
            push group.marks labelMark
            ; A label that was thinned away takes up no room: the widest one is
            ; the widest DRAWN one, measured after the overlap pass rather than
            ; before it. A binned axis is where this shows — its last edge is
            ; the widest label it has and often the first one to go, and
            ; counting it reserves eight pixels nothing is printed in.
            widest = (VlAxis.widestVisible(labelMark labelFontSize widest))
            def turned:boolean (this.labelsAreTurned())
            if vertical {
                def alongV:double widest
                if turned {
                    alongV = labelFontSize
                }
                labelExtent = ((tickSize + labelPadding) + alongV)
            } {
                def alongH:double labelFontSize
                if turned {
                    alongH = widest
                }
                labelExtent = ((tickSize + labelPadding) + alongH)
            }
        } {
            if wantTicks {
                labelExtent = tickSize
            }
        }

        if wantDomain {
            def domainFrom:double 0.0
            def domainTo:double range
            if ((sc.scaleType == "band") || (sc.scaleType == "point")) {
                domainFrom = 0.0
                domainTo = range
            } {
                domainFrom = sc.rangeMin
                domainTo = sc.rangeMax
            }
            push group.marks (this.buildDomain(orient vertical domainFrom domainTo))
        }
        totalExtent = labelExtent
        if ((strlen title) > 0) {
            push group.marks (this.buildTitle(title orient vertical range))
            totalExtent = ((labelExtent + titlePadding) + titleFontSize)
        }
        return mark
    }

    ; A grid line crosses the plot from one end of the OTHER scale's range to
    ; the other. Which end is which is not a convention to pick: it follows the
    ; crossing scale's own range, so an inverted y range and an ascending band
    ; range draw their grid lines in opposite directions — and the reference
    ; records that difference.
    fn buildGrid:VlSceneMark (ticks:[VlAxisTickValue] vertical:boolean gridFrom:double gridTo:double) {
        def mark (new VlSceneMark())
        mark.markType = "rule"
        mark.role = "axis-grid"
        for ticks tv:VlAxisTickValue idx {
            def item:VlSceneItem (mark.addItem())
            item.setNumber("opacity" 1.0)
            if gridOpacitySet {
                item.setNumber("strokeOpacity" gridOpacity)
            }
            item.setString("stroke" gridColor)
            item.setNumber("strokeWidth" gridWidth)
            if gridDashSet {
                item.setValue("strokeDash" gridDash)
            }
            def at:double tv.labelPosition
            if tickRound {
                at = (VlAxis.roundTo(at))
            }
            if vertical {
                item.setNumber("x" gridFrom)
                item.setNumber("y" at)
                item.setNumber("x2" gridTo)
            } {
                item.setNumber("x" at)
                item.setNumber("y" gridFrom)
                item.setNumber("y2" gridTo)
            }
        }
        return mark
    }

    fn buildTicks:VlSceneMark (ticks:[VlAxisTickValue] orient:string vertical:boolean) {
        def mark (new VlSceneMark())
        mark.markType = "rule"
        mark.role = "axis-tick"
        def sign:double 1.0
        if ((orient == "left") || (orient == "top")) {
            sign = -1.0
        }
        for ticks tv:VlAxisTickValue idx {
            def item:VlSceneItem (mark.addItem())
            item.setNumber("opacity" 1.0)
            if tickOpacitySet {
                item.setNumber("strokeOpacity" tickOpacity)
            }
            item.setString("stroke" tickColor)
            item.setNumber("strokeWidth" tickWidth)
            if tickDashSet {
                item.setValue("strokeDash" tickDash)
            }
            def at:double tv.labelPosition
            if tickRound {
                at = (VlAxis.roundTo(at))
            }
            if vertical {
                item.setNumber("y" at)
                item.setNumber("x" 0.0)
                item.setNumber("x2" (sign * tickSize))
            } {
                item.setNumber("y" 0.0)
                item.setNumber("y2" (sign * tickSize))
                item.setNumber("x" at)
            }

        }
        return mark
    }

    fn buildLabels:VlSceneMark (ticks:[VlAxisTickValue] orient:string vertical:boolean flushFrom:double flushTo:double) {
        def mark (new VlSceneMark())
        mark.markType = "text"
        mark.role = "axis-label"
        def away:double (tickSize + labelPadding)
        for ticks tv:VlAxisTickValue idx {
            def item:VlSceneItem (mark.addItem())
            item.setString("fill" labelColor)
            item.setString("font" labelFont)
            item.setNumber("fontSize" labelFontSize)
            item.setNumber("opacity" 1.0)
            item.setNumber("angle" labelAngle)
            item.setNumber("limit" labelLimit)
            item.setString("text" tv.label)
            if vertical {
                item.setNumber("y" tv.labelPosition)
                if (orient == "left") {
                    item.setNumber("x" (0.0 - away))
                    item.setString("align" "right")
                } {
                    item.setNumber("x" away)
                    item.setString("align" "left")
                }
                def baseline:string "middle"
                def sideV:string (this.flushSide(tv.position flushFrom flushTo))
                if (sideV == "start") {
                    baseline = "top"
                }
                if (sideV == "end") {
                    baseline = "bottom"
                }
                item.setString("baseline" baseline)
                if ((strlen labelAlign) > 0) {
                    item.setString("align" labelAlign)
                }
                if ((strlen labelBaseline) > 0) {
                    item.setString("baseline" labelBaseline)
                }
            } {
                item.setNumber("x" tv.labelPosition)
                if (orient == "bottom") {
                    item.setNumber("y" away)
                    item.setString("baseline" "top")
                } {
                    item.setNumber("y" (0.0 - away))
                    item.setString("baseline" "bottom")
                }
                def align:string "center"
                def side:string (this.flushSide(tv.position flushFrom flushTo))
                if (side == "start") {
                    align = "left"
                }
                if (side == "end") {
                    align = "right"
                }
                item.setString("align" align)
                ; A turned label is anchored by its own end rather than its
                ; middle, and it hangs beside the tick rather than under it.
                ; Which end depends on which way it was turned: reading upward
                ; puts the last character nearest the axis, reading downward
                ; puts the first one there.
                if ((VlAxis.turnedQuarter(labelAngle)) != 0) {
                    if ((VlAxis.turnedQuarter(labelAngle)) > 0) {
                        item.setString("align" "left")
                    } {
                        item.setString("align" "right")
                    }
                    item.setString("baseline" "middle")
                }
                if ((strlen labelAlign) > 0) {
                    item.setString("align" labelAlign)
                }
                if ((strlen labelBaseline) > 0) {
                    item.setString("baseline" labelBaseline)
                }
            }
        }
        if ((strlen labelOverlapMode) > 0) {
            this.hideOverlappingLabels(mark)
        }
        return mark
    }

    ; Labels that would print on top of each other are hidden rather than
    ; overprinted, in one of the reference's two strategies:
    ;
    ;   parity  hide every second one, look again, repeat. Evenly spaced ticks
    ;           stay evenly spaced.
    ;   greedy  keep the first, then hide each label that runs into the last one
    ;           kept. Vega-Lite asks for this on a log axis, where the ticks are
    ;           unevenly spaced and halving would drop the readable ones and
    ;           keep the crowded ones.
    ;
    ; A label with nothing in it takes part in neither: it has no box to collide
    ; with, and it must not be spent as one of the hidden ones. That matters on
    ; a log axis, where most of the labels are deliberately blank already.
    ;
    ; The flush alignment has already moved the end labels inward by then, and
    ; it has to: pulling the last label back over the axis is often what makes
    ; it collide with its neighbour in the first place.
    ; Which way a label was turned, as -1, 0 or 1. Vega measures the angle
    ; clockwise from level and wraps it into a full turn first, so 270 and -90
    ; are the same quarter turn and 360 is none at all.
    sfn turnedQuarter:int (angle:double) {
        def a:double angle
        while (a < 0.0) {
            a = (a + 360.0)
        }
        while (! (a < 360.0)) {
            a = (a - 360.0)
        }
        if (a == 0.0) {
            return 0
        }
        if (a == 180.0) {
            return 0
        }
        if (a < 180.0) {
            return 1
        }
        return -1
    }

    ; The widest label still being drawn. A mark with nothing hidden answers the
    ; same number it was given, so an axis that never thinned pays nothing.
    sfn widestVisible:double (mark:VlSceneMark fontSize:double whenEmpty:double) {
        def shown:[string]
        for mark.items item:VlSceneItem idx {
            if ((item.number("opacity")) > 0.0) {
                push shown (item.text("text"))
            }
        }
        if ((array_length shown) == 0) {
            return whenEmpty
        }
        return (VlText.widestLabel(shown fontSize))
    }

    fn hideOverlappingLabels:void (mark:VlSceneMark) {
        def visible:[int]
        for mark.items item:VlSceneItem idx {
            if ((strlen (item.text("text"))) > 0) {
                push visible idx
            }
        }
        if ((array_length visible) < 3) {
            return
        }
        def lastOfAll:int (itemAt visible ((array_length visible) - 1))
        if (labelOverlapMode == "greedy") {
            this.thinGreedy(mark visible)
            return
        }
        def go:boolean true
        def guard:int 0
        while (go && (guard < 16)) {
            guard = (guard + 1)
            if ((array_length visible) < 3) {
                go = false
            } {
                if (this.labelsOverlap(mark visible)) {
                    def kept:[int]
                    for visible index:int position {
                        if (((position % 2) == 0)) {
                            push kept index
                        } {
                            def hidden:VlSceneItem (itemAt mark.items index)
                            hidden.setNumber("opacity" 0.0)
                        }
                    }
                    visible = kept
                } {
                    go = false
                }
            }
        }
        ; When halving has taken an axis down to two labels or fewer, the END of
        ; the scale must be one of them. Two labels that are not the first and
        ; the last do not read as an axis — they read as two arbitrary values —
        ; so the reference gives up the last SURVIVOR and shows the last label
        ; instead. Four labels of which none may touch is the case: parity keeps
        ; the first and third, and the reference keeps the first and fourth.
        if ((array_length visible) < 3) {
            def endItem:VlSceneItem (itemAt mark.items lastOfAll)
            if ((endItem.number("opacity")) == 0.0) {
                if ((array_length visible) > 1) {
                    def giveUp:VlSceneItem (itemAt mark.items (itemAt visible ((array_length visible) - 1)))
                    giveUp.setNumber("opacity" 0.0)
                }
                endItem.setNumber("opacity" 1.0)
            }
        }
    }

    fn thinGreedy:void (mark:VlSceneMark visible:[int]) {
        def keptBox (new VlBounds())
        def first:boolean true
        for visible index:int position {
            def item:VlSceneItem (itemAt mark.items index)
            def box:VlBounds (this.labelBox(item))
            if first {
                keptBox = box
                first = false
            } {
                if (VlAxis.boxesOverlap(keptBox box)) {
                    item.setNumber("opacity" 0.0)
                } {
                    keptBox = box
                }
            }
        }
    }

    ; A label's box, as the renderer would draw it — the same measurement the
    ; legend's rows are laid out with, so an axis and a legend agree on how big
    ; a piece of text is.
    fn labelBox:VlBounds (item:VlSceneItem) {
        return (VlBounds.ofText((item.text("text")) (item.number("fontSize")) (item.text("align")) (item.text("baseline")) (item.number("x")) (item.number("y"))))
    }

    ; The reference's intersection test, which is strict: boxes that merely
    ; touch do not overlap, and a gap in EITHER axis is enough to separate them.
    sfn boxesOverlap:boolean (a:VlBounds b:VlBounds) {
        if ((b.x1 - a.x2) >= 0.0) {
            return false
        }
        if ((a.x1 - b.x2) >= 0.0) {
            return false
        }
        if ((b.y1 - a.y2) >= 0.0) {
            return false
        }
        if ((a.y1 - b.y2) >= 0.0) {
            return false
        }
        return true
    }

    fn labelsOverlap:boolean (mark:VlSceneMark visible:[int]) {
        def previous (new VlBounds())
        def havePrevious:boolean false
        for visible index:int position {
            def box:VlBounds (this.labelBox((itemAt mark.items index)))
            if havePrevious {
                if (VlAxis.boxesOverlap(previous box)) {
                    return true
                }
            }
            previous = box
            havePrevious = true
        }
        return false
    }

    ; The domain line spans the scale's RANGE, in the direction the range runs.
    ; A y axis over [300, 0] draws from 300 to 0; a band axis over [0, 180]
    ; draws the other way, and the reference records the difference.
    fn buildDomain:VlSceneMark (orient:string vertical:boolean rangeFrom:double rangeTo:double) {
        def mark (new VlSceneMark())
        mark.markType = "rule"
        mark.role = "axis-domain"
        def item:VlSceneItem (mark.addItem())
        item.setNumber("opacity" 1.0)
        if domainOpacitySet {
            item.setNumber("strokeOpacity" domainOpacity)
        }
        item.setString("stroke" domainColor)
        item.setNumber("strokeWidth" domainWidth)
        if domainDashSet {
            item.setValue("strokeDash" domainDash)
        }
        if vertical {
            item.setNumber("x" 0.0)
            item.setNumber("y" rangeFrom)
            item.setNumber("y2" rangeTo)
        } {
            item.setNumber("x" rangeFrom)
            item.setNumber("x2" rangeTo)
            item.setNumber("y" 0.0)
        }
        return mark
    }

    ; The title sits beyond the labels, and on a vertical axis it is turned on
    ; its side — which is the one place the label WIDTH, not just its height,
    ; changes where something is drawn.
    fn buildTitle:VlSceneMark (title:string orient:string vertical:boolean range:double) {
        def mark (new VlSceneMark())
        mark.markType = "text"
        mark.role = "axis-title"
        def item:VlSceneItem (mark.addItem())
        item.setString("fill" titleColor)
        item.setString("font" labelFont)
        item.setNumber("fontSize" titleFontSize)
        item.setString("fontWeight" titleFontWeight)
        item.setNumber("opacity" 1.0)
        item.setString("align" "center")
        ; `auto` marks a title the runtime placed itself rather than one the
        ; spec positioned, which is what the reference records here.
        item.setValue("auto" (VlJson.boolValue(true)))
        item.setString("text" title)
        def away:double (labelExtent + titlePadding)
        if vertical {
            item.setNumber("y" (range / 2.0))
            if (orient == "left") {
                item.setNumber("x" (0.0 - away))
                item.setNumber("angle" -90.0)
            } {
                item.setNumber("x" away)
                item.setNumber("angle" 90.0)
            }
            item.setString("baseline" "bottom")
        } {
            item.setNumber("x" (range / 2.0))
            item.setNumber("angle" 0.0)
            if (orient == "bottom") {
                item.setNumber("y" away)
                item.setString("baseline" "top")
            } {
                item.setNumber("y" (0.0 - away))
                item.setString("baseline" "bottom")
            }
        }
        return mark
    }
}

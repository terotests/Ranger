; ==============================================================================
; VlJson.rgr — JSON value model and parser for the Vela runtime.
; ==============================================================================
; Pure Ranger, no host JSON: the same tree on every target, which is what makes
; a scene comparison against the reference implementation mean anything. The
; parser is adapted from gallery/game_engine/v2/model3d/GltfJson.rgr; the value
; type carries the extra bits a chart spec needs (ordered object keys are kept
; so that a re-serialised spec is stable, and a number remembers whether it was
; written as an integer so `5` does not come back as `5.0`).
;
; Named VlJson rather than Json to avoid a case-insensitive filename clash with
; lib/JSON.rgr when a native target builds on macOS or Windows.
; ==============================================================================

class VlJson {
    ; kind: 0 null, 1 bool, 2 number, 3 string, 4 array, 5 object
    def kind:int 0
    def num:double 0.0
    def b:boolean false
    def str:string ""
    def arr:[VlJson]
    def keys:[string]
    def members:[string:VlJson]
    ; A number that was written without a fraction or exponent prints back
    ; without one. JSON has one number type; the text does not.
    def isInt:boolean false

    fn isNull:boolean () {
        return (kind == 0)
    }
    fn isBool:boolean () {
        return (kind == 1)
    }
    fn isNumber:boolean () {
        return (kind == 2)
    }
    fn isString:boolean () {
        return (kind == 3)
    }
    fn isArray:boolean () {
        return (kind == 4)
    }
    fn isObject:boolean () {
        return (kind == 5)
    }
    fn isDefined:boolean () {
        return (kind != 0)
    }

    ; --- scalar access --------------------------------------------------------
    fn asInt:int () {
        return (to_int num)
    }
    fn asDouble:double () {
        if (kind == 2) {
            return num
        }
        if (kind == 1) {
            if b {
                return 1.0
            }
            return 0.0
        }
        if (kind == 3) {
            def d@(optional):double (str2double str)
            if d {
                return (unwrap d)
            }
        }
        return 0.0
    }
    fn asString:string () {
        if (kind == 3) {
            return str
        }
        if (kind == 2) {
            return (VlJson.numberToText(num isInt))
        }
        if (kind == 1) {
            if b {
                return "true"
            }
            return "false"
        }
        return ""
    }
    fn asBool:boolean () {
        if (kind == 1) {
            return b
        }
        if (kind == 2) {
            return (num != 0.0)
        }
        if (kind == 3) {
            return ((strlen str) > 0)
        }
        return false
    }

    ; --- array access ---------------------------------------------------------
    fn count:int () {
        return (array_length arr)
    }
    fn at:VlJson (index:int) {
        if (index < 0) {
            return (VlJson.nullValue())
        }
        if (index >= (array_length arr)) {
            return (VlJson.nullValue())
        }
        return (itemAt arr index)
    }

    ; --- object access --------------------------------------------------------
    fn has:boolean (key:string) {
        return (has members key)
    }
    fn get:VlJson (key:string) {
        if (has members key) {
            return (unwrap (get members key))
        }
        return (VlJson.nullValue())
    }
    fn intOr:int (key:string dflt:int) {
        if (has members key) {
            def v:VlJson (unwrap (get members key))
            if (v.kind == 2) {
                return (to_int v.num)
            }
        }
        return dflt
    }
    fn doubleOr:double (key:string dflt:double) {
        if (has members key) {
            def v:VlJson (unwrap (get members key))
            if (v.kind == 2) {
                return v.num
            }
        }
        return dflt
    }
    fn stringOr:string (key:string dflt:string) {
        if (has members key) {
            def v:VlJson (unwrap (get members key))
            if (v.kind == 3) {
                return v.str
            }
        }
        return dflt
    }
    fn boolOr:boolean (key:string dflt:boolean) {
        if (has members key) {
            def v:VlJson (unwrap (get members key))
            if (v.kind == 1) {
                return v.b
            }
        }
        return dflt
    }
    fn setMember:void (key:string value:VlJson) {
        if (! (has members key)) {
            push keys key
        }
        set members key value
    }

    ; --- construction ---------------------------------------------------------
    sfn nullValue:VlJson () {
        def v:VlJson (new VlJson)
        return v
    }
    sfn boolValue:VlJson (value:boolean) {
        def v:VlJson (new VlJson)
        v.kind = 1
        v.b = value
        return v
    }
    sfn numberValue:VlJson (value:double) {
        def v:VlJson (new VlJson)
        v.kind = 2
        v.num = value
        return v
    }
    sfn intValue:VlJson (value:int) {
        def v:VlJson (new VlJson)
        v.kind = 2
        v.num = (to_double value)
        v.isInt = true
        return v
    }
    sfn stringValue:VlJson (value:string) {
        def v:VlJson (new VlJson)
        v.kind = 3
        v.str = value
        return v
    }
    sfn arrayValue:VlJson () {
        def v:VlJson (new VlJson)
        v.kind = 4
        return v
    }
    sfn objectValue:VlJson () {
        def v:VlJson (new VlJson)
        v.kind = 5
        return v
    }

    ; --- number text ----------------------------------------------------------
    ; One place decides how a number reaches the output, because the golden
    ; files and the scene comparison both read it. An integral value prints
    ; without a fraction; everything else prints at most `maxDecimals` digits
    ; with the trailing zeroes removed, so 0.1 + 0.2 does not print as
    ; 0.30000000000000004 on one target and 0.3 on another.
    sfn numberToText:string (value:double wasInt:boolean) {
        return (VlJson.formatNumber(value 6))
    }

    ; The same number to a count of SIGNIFICANT digits rather than decimals,
    ; which is what a formatter with no specifier does: the reference prints a
    ; mean of 56.5555555555556 as "56.5555555556" — twelve digits in all, not
    ; twelve after the point.
    sfn formatSignificant:string (value:double digits:int) {
        def m:double value
        if (m < 0.0) {
            m = (0.0 - m)
        }
        def whole:int 1
        while (m >= 10.0) {
            m = (m / 10.0)
            whole = (whole + 1)
        }
        def decimals:int (digits - whole)
        if (decimals < 0) {
            decimals = 0
        }
        return (VlJson.formatNumber(value decimals))
    }

    ; A number a PERSON reads is written with the typographic minus sign
    ; (U+2212), not the hyphen: that is what d3's number formatting emits and
    ; what the reference's axis labels carry. A number a MACHINE reads — JSON,
    ; path data, a stylesheet — must keep the hyphen, so this is applied at the
    ; label boundary and nowhere else.
    sfn withMinusSign:string (text:string) {
        if ((strlen text) == 0) {
            return text
        }
        if ((substring text 0 1) == "-") {
            return ((strfromcode 8722) + (substring text 1 (strlen text)))
        }
        return text
    }

    ; The whole part goes through `floor`, which every target narrows to its own
    ; int, so a magnitude past what an int holds everywhere falls back to the
    ; target's own formatting rather than printing a wrapped number. Chart
    ; geometry never reaches it; a data value could, and a visibly
    ; target-specific string is better than a silently wrong one.
    sfn formatNumber:string (value:double maxDecimals:int) {
        def v:double value
        ; A number that is not one. Nothing here can print an infinity — the
        ; big-number path looks for the highest power of ten in it and never
        ; finds one — so the loop ran until the process ran out of memory. An
        ; expression that divides by a category name is all it takes.
        if (! (value == value)) {
            return "NaN"
        }
        ; An infinity is the only non-zero number that is unchanged by halving,
        ; which is an exact test and not a threshold — a chart of large numbers
        ; is not an infinity and must not be printed as one.
        if (v == 0.0) {
            return "0"
        }
        if ((value * 0.5) == value) {
            if (value > 0.0) {
                return "Infinity"
            }
            return "-Infinity"
        }
        def neg:boolean false
        if (v < 0.0) {
            neg = true
            v = (0.0 - v)
        }
        ; Past a thousand million the whole part no longer fits an int, and the
        ; old answer here was `to_string`, which is the one thing this file
        ; exists to avoid: JavaScript writes 1327017600000 and C++ writes
        ; 1.3270176e+12 for the same double. Any ordinal domain built from
        ; large numbers was therefore labelled differently on the two targets —
        ; a chart whose categories are INSTANTS is the ordinary way to hit it,
        ; and every one of its labels came out as the epoch in C++ because
        ; nothing could read the number back.
        if (v >= 1000000000.0) {
            ; `floor` answers an INT, which is exactly the type this value does
            ; not fit, so the digits come out of the double itself: the highest
            ; power of ten first, subtracting as it goes. What is left when the
            ; ones place has been taken is the fraction.
            def place:double 1.0
            while ((v / place) >= 10.0) {
                place = (place * 10.0)
            }
            def big:string ""
            def rest:double v
            while (place >= 1.0) {
                big = (big + (VlJson.digitChar((VlJson.digitAt(rest place)))))
                rest = (rest - ((to_double (VlJson.digitAt(rest place))) * place))
                place = (place / 10.0)
            }
            def tail:string (VlJson.fractionDigits(rest maxDecimals))
            if ((strlen tail) > 0) {
                big = ((big + ".") + tail)
            }
            if neg {
                return ("-" + big)
            }
            return big
        }
        ; The scale is a DOUBLE, and nothing here is ever allowed to become an
        ; int larger than a digit. Twelve significant digits of a two-digit
        ; number is ten decimals, so the scale is 10^10 — which a 32-bit int
        ; does not hold. JavaScript has no such int and got the right answer;
        ; C++ wrapped 10^10 to 1410065408 and printed 54.5 as "54.0705032704".
        ; A double carries every power of ten this can reach exactly, and
        ; integer arithmetic below 2^53 is exact in one, so the digits are
        ; taken from the top a place at a time and each `floor` sees a value
        ; below ten.
        def scale:double 1.0
        def k:int 0
        while (k < maxDecimals) {
            scale = (scale * 10.0)
            k = (k + 1)
        }
        def whole:int (floor v)
        def frac:double (v - (to_double whole))
        ; Half up, then truncated place by place — which is the same number as
        ; flooring the scaled fraction, without ever forming it as an integer.
        def units:double ((frac * scale) + 0.5)
        if (! (units < scale)) {
            whole = (whole + 1)
            units = 0.0
        }
        def out:string (VlJson.intToText(whole))
        def fracText:string ""
        def place:double scale
        def rest:double units
        def i:int 0
        while (i < maxDecimals) {
            place = (place / 10.0)
            def digit:int (floor (rest / place))
            rest = (rest - ((to_double digit) * place))
            fracText = (fracText + (VlJson.digitChar(digit)))
            i = (i + 1)
        }
        def end:int (strlen fracText)
        def stop:boolean false
        while ((end > 0) && (! stop)) {
            if ((substring fracText (end - 1) end) == "0") {
                end = (end - 1)
            } {
                stop = true
            }
        }
        if (end > 0) {
            out = ((out + ".") + (substring fracText 0 end))
        }
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; One digit of a double at a given place, clamped so that a value a hair
    ; over its own place cannot ask for a tenth digit.
    sfn digitAt:int (rest:double place:double) {
        def digit:int (floor (rest / place))
        if (digit > 9) {
            return 9
        }
        if (digit < 0) {
            return 0
        }
        return digit
    }

    ; The digits after the point, trailing zeros dropped. Empty for a whole
    ; number, which is what leaves 1327017600000 without a ".0" after it.
    sfn fractionDigits:string (frac:double maxDecimals:int) {
        def out:string ""
        def rest:double frac
        def place:double 0.1
        def i:int 0
        while (i < maxDecimals) {
            def digit:int (VlJson.digitAt(rest place))
            out = (out + (VlJson.digitChar(digit)))
            rest = (rest - ((to_double digit) * place))
            place = (place / 10.0)
            i = (i + 1)
        }
        def end:int (strlen out)
        def stop:boolean false
        while ((end > 0) && (! stop)) {
            if ((substring out (end - 1) end) == "0") {
                end = (end - 1)
            } {
                stop = true
            }
        }
        return (substring out 0 end)
    }

    ; Non-negative int to text without the target's own number formatting,
    ; which differs (1e21, 1.0, 1) between JavaScript, Python and C++ for the
    ; same value.
    sfn intToText:string (value:int) {
        if (value <= 0) {
            return "0"
        }
        def v:int value
        def digits:string ""
        while (v > 0) {
            def next:int (idiv v 10)
            def digit:int (v - (next * 10))
            digits = ((VlJson.digitChar(digit)) + digits)
            v = next
        }
        return digits
    }

    sfn digitChar:string (d:int) {
        if (d <= 0) {
            return "0"
        }
        if (d == 1) {
            return "1"
        }
        if (d == 2) {
            return "2"
        }
        if (d == 3) {
            return "3"
        }
        if (d == 4) {
            return "4"
        }
        if (d == 5) {
            return "5"
        }
        if (d == 6) {
            return "6"
        }
        if (d == 7) {
            return "7"
        }
        if (d == 8) {
            return "8"
        }
        return "9"
    }
}

class VlJsonParser {
    def s:string ""
    def i:int 0
    def n:int 0
    def ok:boolean true
    def err:string ""

    fn parse:VlJson (text:string) {
        s = text
        i = 0
        n = (strlen text)
        ok = true
        err = ""
        def v:VlJson (this.parseValue())
        return v
    }

    fn isWs:boolean (c:int) {
        if (c == 32) {
            return true
        }
        if (c == 9) {
            return true
        }
        if (c == 10) {
            return true
        }
        if (c == 13) {
            return true
        }
        return false
    }

    fn skipWs:void () {
        def go:boolean true
        while go {
            if (i >= n) {
                go = false
            } {
                def c:int (charAt s i)
                if (this.isWs(c)) {
                    i = (i + 1)
                } {
                    go = false
                }
            }
        }
    }

    fn isNumChar:boolean (c:int) {
        if (c == 45) {
            return true
        }
        if (c == 43) {
            return true
        }
        if (c == 46) {
            return true
        }
        if (c == 101) {
            return true
        }
        if (c == 69) {
            return true
        }
        if (c >= 48) {
            if (c <= 57) {
                return true
            }
        }
        return false
    }

    fn fail:void (msg:string) {
        if ok {
            ok = false
            err = msg
        }
    }

    fn parseValue:VlJson () {
        this.skipWs()
        if (i >= n) {
            this.fail("unexpected end of input")
            return (VlJson.nullValue())
        }
        def c:int (charAt s i)
        if (c == 123) {
            return (this.parseObject())
        }
        if (c == 91) {
            return (this.parseArray())
        }
        if (c == 34) {
            return (this.parseString())
        }
        if (c == 116) {
            return (this.parseKeyword("true" 1 true))
        }
        if (c == 102) {
            return (this.parseKeyword("false" 1 false))
        }
        if (c == 110) {
            return (this.parseKeyword("null" 0 false))
        }
        return (this.parseNumber())
    }

    fn parseKeyword:VlJson (word:string kind:int bval:boolean) {
        def wl:int (strlen word)
        def matched:boolean true
        def k:int 0
        while (k < wl) {
            if ((i + k) >= n) {
                matched = false
                k = wl
            } {
                if ((charAt s (i + k)) != (charAt word k)) {
                    matched = false
                    k = wl
                } {
                    k = (k + 1)
                }
            }
        }
        def v:VlJson (new VlJson)
        if matched {
            i = (i + wl)
            v.kind = kind
            v.b = bval
        } {
            this.fail("invalid literal, expected " + word)
        }
        return v
    }

    fn parseNumber:VlJson () {
        def start:int i
        def sawFraction:boolean false
        def go:boolean true
        while go {
            if (i >= n) {
                go = false
            } {
                def c:int (charAt s i)
                if (this.isNumChar(c)) {
                    if (c == 46) {
                        sawFraction = true
                    }
                    if (c == 101) {
                        sawFraction = true
                    }
                    if (c == 69) {
                        sawFraction = true
                    }
                    i = (i + 1)
                } {
                    go = false
                }
            }
        }
        def v:VlJson (new VlJson)
        if (i > start) {
            def sub:string (substring s start i)
            def d@(optional):double (str2double sub)
            v.kind = 2
            v.isInt = (! sawFraction)
            if d {
                v.num = (unwrap d)
            } {
                this.fail("invalid number: " + sub)
            }
        } {
            this.fail("expected value")
        }
        return v
    }

    fn hexDigit:int (c:int) {
        if (c >= 48) {
            if (c <= 57) {
                return (c - 48)
            }
        }
        if (c >= 97) {
            if (c <= 102) {
                return ((c - 97) + 10)
            }
        }
        if (c >= 65) {
            if (c <= 70) {
                return ((c - 65) + 10)
            }
        }
        return 0
    }

    fn readRawString:string () {
        ; assumes the current char is the opening quote
        i = (i + 1)
        def out:string ""
        def go:boolean true
        while go {
            if (i >= n) {
                this.fail("unterminated string")
                go = false
            } {
                def c:int (charAt s i)
                if (c == 34) {
                    i = (i + 1)
                    go = false
                } {
                    if (c == 92) {
                        i = (i + 1)
                        if (i >= n) {
                            this.fail("unterminated escape")
                            go = false
                        } {
                            def e:int (charAt s i)
                            out = (out + (this.decodeEscape(e)))
                            i = (i + 1)
                        }
                    } {
                        out = (out + (substring s i (i + 1)))
                        i = (i + 1)
                    }
                }
            }
        }
        return out
    }

    fn decodeEscape:string (e:int) {
        if (e == 34) {
            return (strfromcode 34)
        }
        if (e == 92) {
            return (strfromcode 92)
        }
        if (e == 47) {
            return (strfromcode 47)
        }
        if (e == 98) {
            return (strfromcode 8)
        }
        if (e == 102) {
            return (strfromcode 12)
        }
        if (e == 110) {
            return (strfromcode 10)
        }
        if (e == 114) {
            return (strfromcode 13)
        }
        if (e == 116) {
            return (strfromcode 9)
        }
        if (e == 117) {
            def cp:int 0
            def k:int 0
            while (k < 4) {
                def hc:int (charAt s ((i + 1) + k))
                cp = ((cp * 16) + (this.hexDigit(hc)))
                k = (k + 1)
            }
            i = (i + 4)
            return (strfromcode cp)
        }
        return (strfromcode e)
    }

    fn parseString:VlJson () {
        def v:VlJson (new VlJson)
        v.kind = 3
        v.str = (this.readRawString())
        return v
    }

    fn parseArray:VlJson () {
        def v:VlJson (new VlJson)
        v.kind = 4
        i = (i + 1)
        this.skipWs()
        if (i < n) {
            if ((charAt s i) == 93) {
                i = (i + 1)
                return v
            }
        }
        def go:boolean true
        while go {
            def item:VlJson (this.parseValue())
            push v.arr item
            this.skipWs()
            if (i >= n) {
                this.fail("unterminated array")
                go = false
            } {
                def c:int (charAt s i)
                if (c == 44) {
                    i = (i + 1)
                    this.skipWs()
                } {
                    if (c == 93) {
                        i = (i + 1)
                        go = false
                    } {
                        this.fail("expected ',' or ']' in array")
                        go = false
                    }
                }
            }
            if (ok == false) {
                go = false
            }
        }
        return v
    }

    fn parseObject:VlJson () {
        def v:VlJson (new VlJson)
        v.kind = 5
        i = (i + 1)
        this.skipWs()
        if (i < n) {
            if ((charAt s i) == 125) {
                i = (i + 1)
                return v
            }
        }
        def go:boolean true
        while go {
            this.skipWs()
            if (i >= n) {
                this.fail("unterminated object")
                go = false
            } {
                if ((charAt s i) != 34) {
                    this.fail("expected string key in object")
                    go = false
                } {
                    def key:string (this.readRawString())
                    this.skipWs()
                    if (i >= n) {
                        this.fail("expected ':' in object")
                        go = false
                    } {
                        if ((charAt s i) != 58) {
                            this.fail("expected ':' in object")
                            go = false
                        } {
                            i = (i + 1)
                            def val:VlJson (this.parseValue())
                            v.setMember(key val)
                            this.skipWs()
                            if (i >= n) {
                                this.fail("unterminated object")
                                go = false
                            } {
                                def c:int (charAt s i)
                                if (c == 44) {
                                    i = (i + 1)
                                } {
                                    if (c == 125) {
                                        i = (i + 1)
                                        go = false
                                    } {
                                        this.fail("expected ',' or '}' in object")
                                        go = false
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (ok == false) {
                go = false
            }
        }
        return v
    }
}

; Writes a value back as JSON text. Object members keep the order they were
; read or set in, so a spec that goes in and comes out again is comparable as
; text, and the scene dump the parity harness reads is stable.
class VlJsonWriter {
    ; How many decimals a number is written with. Six everywhere a chart is
    ; written — a scene is measured in pixels and six decimals is far past what
    ; any of them mean — but a SPECIFICATION may carry a constant that has to
    ; survive intact, such as a full turn in radians, so the writer that emits
    ; one asks for more.
    def decimals:int 6

    fn write:string (v:VlJson) {
        return (this.writeValue(v 0 false))
    }
    fn writePretty:string (v:VlJson) {
        return (this.writeValue(v 0 true))
    }

    fn indent:string (depth:int) {
        def out:string ""
        def k:int 0
        while (k < depth) {
            out = (out + "  ")
            k = (k + 1)
        }
        return out
    }

    fn writeValue:string (v:VlJson depth:int pretty:boolean) {
        if (v.kind == 0) {
            return "null"
        }
        if (v.kind == 1) {
            if v.b {
                return "true"
            }
            return "false"
        }
        if (v.kind == 2) {
            return (VlJson.formatNumber(v.num decimals))
        }
        if (v.kind == 3) {
            return (this.quote(v.str))
        }
        if (v.kind == 4) {
            return (this.writeArray(v depth pretty))
        }
        return (this.writeObject(v depth pretty))
    }

    fn writeArray:string (v:VlJson depth:int pretty:boolean) {
        def total:int (array_length v.arr)
        if (total == 0) {
            return "[]"
        }
        def out:string "["
        def k:int 0
        while (k < total) {
            if (k > 0) {
                out = (out + ",")
            }
            if pretty {
                out = ((out + (strfromcode 10)) + (this.indent((depth + 1))))
            }
            def item:VlJson (itemAt v.arr k)
            out = (out + (this.writeValue(item (depth + 1) pretty)))
            k = (k + 1)
        }
        if pretty {
            out = (((out + (strfromcode 10)) + (this.indent(depth))) + "]")
        } {
            out = (out + "]")
        }
        return out
    }

    fn writeObject:string (v:VlJson depth:int pretty:boolean) {
        def total:int (array_length v.keys)
        if (total == 0) {
            return "{}"
        }
        def out:string "{"
        def k:int 0
        while (k < total) {
            def key:string (itemAt v.keys k)
            if (k > 0) {
                out = (out + ",")
            }
            if pretty {
                out = ((out + (strfromcode 10)) + (this.indent((depth + 1))))
            }
            out = ((out + (this.quote(key))) + ":")
            if pretty {
                out = (out + " ")
            }
            def item:VlJson (v.get(key))
            out = (out + (this.writeValue(item (depth + 1) pretty)))
            k = (k + 1)
        }
        if pretty {
            out = (((out + (strfromcode 10)) + (this.indent(depth))) + "}")
        } {
            out = (out + "}")
        }
        return out
    }

    fn quote:string (s:string) {
        def out:string (strfromcode 34)
        def total:int (strlen s)
        def k:int 0
        while (k < total) {
            def c:int (charAt s k)
            if (c == 34) {
                out = ((out + (strfromcode 92)) + (strfromcode 34))
            } {
                if (c == 92) {
                    out = ((out + (strfromcode 92)) + (strfromcode 92))
                } {
                    if (c == 10) {
                        out = ((out + (strfromcode 92)) + "n")
                    } {
                        if (c == 13) {
                            out = ((out + (strfromcode 92)) + "r")
                        } {
                            if (c == 9) {
                                out = ((out + (strfromcode 92)) + "t")
                            } {
                                out = (out + (substring s k (k + 1)))
                            }
                        }
                    }
                }
            }
            k = (k + 1)
        }
        return (out + (strfromcode 34))
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; VlChart.rgr — Vela's own chart API: marks and channels, in Ranger.
; ==============================================================================
; Vela runs a specification. Until now the only way to hand it one was to write
; that specification out as JSON — which is what `gallery/datagrid` does, in
; three hundred lines of string concatenation, quote by escaped quote. This is
; the other front door: an API that a program calls, which builds the same
; Vega-Lite value the parser would have produced.
;
;     def data (VlDataset.create())
;     data.row().str("region" "North").num("sales" 120.0)
;     data.row().str("region" "South").num("sales"  93.0)
;
;     def chart (VlChart.create(data))
;     chart.size(300 200)
;     chart.bar().x("region").y("sales")
;
;     def spec:VlJson (chart.toSpec())    ; → VlCompile → VlRuntime → a picture
;
; Four ideas are borrowed, and it is worth saying which from where:
;
;   * **the fluent surface is not the engine** (AntV G2). Every call writes into
;     a specification; `toSpec` hands that specification over and the API is
;     done. Nothing here computes a scale, a layout or a pixel — the runtime
;     that already does all three is the only thing that draws.
;   * **a view's encoding is inherited by its marks** (G2 again). `chart.x(…)`
;     is said once and every mark added to the chart reads it, so a line and
;     the points on top of it are two marks and one set of axes rather than two
;     charts. Inheritance is resolved HERE, at emit time: each layer comes out
;     carrying its channels in full, because a spec that states everything is
;     one the compiler already handles and one a person can read in a diff.
;   * **a channel need not state its type** (Observable Plot). A column of
;     numbers is quantitative, a column of ISO dates is temporal, anything else
;     is nominal — read off the data rather than asked for. A field the data
;     does not have is an ERROR rather than a guess: `errors` is non-empty and
;     the caller can say so instead of drawing an empty axis.
;   * **the data is a value beside the chart, not a thing inside it**
;     (Apache ECharts). `VlDataset` is built once and can be given to several
;     charts; a spreadsheet's selection becomes one dataset and a dashboard's
;     six panels read it.
;
; What this file deliberately does NOT do: draw, measure, scale, lay out, or
; know what a pixel is. It imports `VlJson` and nothing else, so the API layer
; cannot grow a dependency on the runtime by accident — and a caller that wants
; the runtime imports it directly, exactly as one that hands it parsed JSON
; does.
; ==============================================================================

Import "VlJson.rgr"

; ------------------------------------------------------------------------------
; One row, built field by field. `row()` hands one back already attached to the
; dataset, so nothing has to be pushed anywhere by the caller.
; ------------------------------------------------------------------------------
class VlDataRow {
    def obj:VlJson (VlJson.objectValue())
    def owner@(weak):VlDataset

    fn num:VlDataRow (field:string value:double) {
        obj.setMember(field (VlJson.numberValue(value)))
        return this
    } doc {
        public
        category "Data"
        description "Puts a number in one column of this row."
        param field "The column name."
        param value "The value."
        returns "This row, so columns chain."
    }
    fn whole:VlDataRow (field:string value:int) {
        obj.setMember(field (VlJson.intValue(value)))
        return this
    } doc {
        public
        category "Data"
        description "Puts a whole number in one column of this row.

A count is an integer and prints as one: 12, not 12.0. Use this rather than
`num` wherever the value counts things, or the axis labels will say so."
        param field "The column name."
        param value "The value."
        returns "This row, so columns chain."
        see num
    }
    fn str:VlDataRow (field:string value:string) {
        obj.setMember(field (VlJson.stringValue(value)))
        return this
    } doc {
        public
        category "Data"
        description "Puts text in one column of this row.

A column of text is read as a category unless every value in it parses as an
ISO date, in which case it is an instant."
        param field "The column name."
        param value "The value."
        returns "This row, so columns chain."
    }
    fn flag:VlDataRow (field:string value:boolean) {
        obj.setMember(field (VlJson.boolValue(value)))
        return this
    } doc {
        public
        category "Data"
        description "Puts true or false in one column of this row."
        param field "The column name."
        param value "The value."
        returns "This row, so columns chain."
    }
    fn json:VlDataRow (field:string value:VlJson) {
        obj.setMember(field value)
        return this
    } doc {
        public
        category "Data"
        description "Puts an already-built value in one column of this row.

The escape hatch for a column this API has no typed setter for — a nested
object a geoshape reads, or a value that came out of the parser."
        param field "The column name."
        param value "The value, as the JSON model holds it."
        returns "This row, so columns chain."
    }
    fn back:VlDataset () {
        if (!null? owner) {
            return (unwrap owner)
        }
        return (VlDataset.create())
    } doc {
        public
        category "Data"
        description "Returns to the dataset this row belongs to, so rows chain one after another."
        returns "The owning dataset, or a fresh empty one if this row was built without a dataset."
    }
} doc {
    public
    category "Data"
    description "One row of a dataset, filled column by column.

A row is handed back already attached to its dataset, so nothing has to be
pushed anywhere by the caller."
    example datasetExample
    see VlDataset
}

; ------------------------------------------------------------------------------
; A named table. Rows are JSON objects — the same values the parser produces for
; `"data": {"values": […]}` — so a dataset built here and one read off disk are
; the same thing to everything downstream.
; ------------------------------------------------------------------------------
class VlDataset {
    def rows:[VlJson]
    def name:string ""

    sfn create:VlDataset () {
        def d (new VlDataset())
        return d
    } doc {
        public
        category "Data"
        description "Builds an empty dataset."
        returns "A dataset with no rows."
    }

    fn row:VlDataRow () {
        def r (new VlDataRow())
        r.owner = this
        push rows r.obj
        return r
    } doc {
        public
        category "Data"
        description "Adds a row and hands it back, ready to be filled."
        returns "The new row, already attached to this dataset."
        see VlDataRow
    }

    fn addRow:VlDataset (row:VlJson) {
        push rows row
        return this
    } doc {
        public
        category "Data"
        description "Adds a row that was built elsewhere."
        param row "A JSON object whose members are the columns."
        returns "This dataset, so calls chain."
    }

    ; Rows as they came out of the JSON parser: a dataset can be a selection
    ; from a grid, a file somebody read, or a literal.
    fn fromValues:VlDataset (values:VlJson) {
        def i:int 0
        def n:int (values.count())
        while (i < n) {
            push rows (values.at(i))
            i = (i + 1)
        }
        return this
    } doc {
        public
        category "Data"
        description "Takes the rows of a JSON array as they came out of the parser.

A dataset built here and one read off disk are the same thing to everything
downstream, so a selection from a grid, a file somebody read and a literal all
arrive the same way."
        param values "A JSON array of row objects."
        returns "This dataset, so calls chain."
    }

    ; Column-wise filling, for a caller that holds arrays rather than records —
    ; a spreadsheet column, a series of measurements. Row `i` of every column
    ; is the same row.
    fn numbers:VlDataset (field:string values:[double]) {
        for values v:double i {
            def r:VlJson (this.rowAt(i))
            r.setMember(field (VlJson.numberValue(v)))
        }
        return this
    } doc {
        public
        category "Data"
        description "Fills one numeric column from an array, one value per row.

Column-wise filling, for a caller that holds arrays rather than records — a
spreadsheet column, a series of measurements. Row `i` of every column is the
same row, so two calls with arrays of the same length make a table."
        param field "The column name."
        param values "One value per row, in row order."
        returns "This dataset, so calls chain."
        see strings
    }
    fn strings:VlDataset (field:string values:[string]) {
        for values v:string i {
            def r:VlJson (this.rowAt(i))
            r.setMember(field (VlJson.stringValue(v)))
        }
        return this
    } doc {
        public
        category "Data"
        description "Fills one text column from an array, one value per row."
        param field "The column name."
        param values "One value per row, in row order."
        returns "This dataset, so calls chain."
        see numbers
    }

    fn rowAt:VlJson (index:int) {
        while ((array_length rows) <= index) {
            push rows (VlJson.objectValue())
        }
        return (itemAt rows index)
    } doc {
        public
        category "Data"
        description "The row at an index, growing the dataset with empty rows if it is not there yet."
        param index "A zero-based row number."
        returns "The row object, which can be written into directly."
    }

    fn count:int () {
        return (array_length rows)
    } doc {
        public
        category "Data"
        description "How many rows the dataset holds."
        returns "The row count."
    }

    fn hasField:boolean (field:string) {
        for rows r:VlJson i {
            if (r.has(field)) {
                return true
            }
        }
        return false
    } doc {
        public
        category "Data"
        description "Whether any row has this column."
        param field "The column name."
        returns "True when at least one row carries the column."
    }

    ; What kind of thing a column holds, in Vega-Lite's vocabulary. Numbers are
    ; a quantity, an ISO date is an instant, everything else is a name. Read
    ; from the rows rather than declared, because the rows are already here —
    ; and a column that is empty answers nothing, so the caller can tell "no
    ; such column" from "a column of names".
    fn fieldType:string (field:string) {
        def sawNumber:boolean false
        def sawText:boolean false
        def sawDate:boolean false
        def sawAny:boolean false
        for rows r:VlJson i {
            if (r.has(field)) {
                def v:VlJson (r.get(field))
                if (! (v.isNull())) {
                    sawAny = true
                    if (v.isNumber()) {
                        sawNumber = true
                    }
                    if (v.isString()) {
                        sawText = true
                        if (VlDataset.looksLikeDate(v.str)) {
                            sawDate = true
                        }
                    }
                }
            }
        }
        if (! sawAny) {
            return ""
        }
        if (sawText) {
            if (sawDate) {
                return "temporal"
            }
            return "nominal"
        }
        if (sawNumber) {
            return "quantitative"
        }
        return "nominal"
    } doc {
        public
        category "Data"
        description "What kind of thing a column holds, in Vega-Lite's vocabulary.

Read off the rows rather than declared: numbers are a quantity, ISO dates are
an instant, anything else is a name. A column the data does not have answers
the empty string, so a caller can tell \"no such column\" from \"a column of
names\" — which is the difference between a mistake and a chart."
        param field "The column name."
        returns "`quantitative`, `temporal`, `nominal`, or the empty string when no row has the column."
    }

    ; "2016-01-01", "2016-01-01T12:00:00Z", "2016-01". Four digits, a dash and
    ; a digit is enough to tell a date from a name and is what the data written
    ; by every tool in this repository looks like. Anything else is a name: a
    ; chart that read "Q1 2016" as an instant would put every quarter on the
    ; same tick and say nothing about it.
    sfn looksLikeDate:boolean (text:string) {
        def n:int (strlen text)
        if ((n < 6) || (n > 40)) {
            return false
        }
        def i:int 0
        while (i < 4) {
            def c:int (charAt text i)
            if ((c < 48) || (c > 57)) {
                return false
            }
            i = (i + 1)
        }
        def sep:int (charAt text 4)
        if (sep != 45) {
            return false
        }
        def d:int (charAt text 5)
        if ((d < 48) || (d > 57)) {
            return false
        }
        return true
    }

    fn toValues:VlJson () {
        def list (VlJson.arrayValue())
        for rows r:VlJson i {
            push list.arr r
        }
        def obj (VlJson.objectValue())
        obj.setMember("values" list)
        return obj
    } doc {
        public
        category "Output"
        description "The dataset as the `data` block of a specification: `{\"values\": […]}`."
        returns "A JSON object holding every row."
    }
} doc {
    public
    category "Data"
    description "A table of rows, built once and given to as many charts as want it.

Rows are JSON objects — the same values the parser produces for
`\"data\": {\"values\": […]}` — so a dataset built here and one read off disk are
the same thing to everything downstream.

The dataset is a value **beside** the chart rather than a thing inside it: a
spreadsheet's selection becomes one dataset and a dashboard's six panels read
it."
    example datasetExample
    see VlChart
}

; ------------------------------------------------------------------------------
; One mark and the channels it reads. Every setter answers the mark, so a mark
; is written as one sentence:
;
;     chart.bar().x("region").y("sales").aggregate("sum")
;
; `aggregate`, `bin`, `title` and the rest apply to the channel most recently
; named — the cursor — which is what makes that sentence read in the order it
; is thought. `on("y")` moves the cursor back to a channel already set.
; ------------------------------------------------------------------------------
class VlChartMark {
    def markType:string "point"
    ; Mark-level properties: `{"type": "line", "interpolate": "monotone"}`.
    ; Empty means the mark is written as the bare string it is.
    def props:VlJson (VlJson.objectValue())
    def enc:VlJson (VlJson.objectValue())
    def cursor:string ""
    def owner@(weak):VlChart

    fn note:void (message:string) {
        if (!null? owner) {
            def o:VlChart (unwrap owner)
            o.error(message)
        }
    }

    ; --- channels ------------------------------------------------------------
    ; Every one of these names a COLUMN. A constant goes through `valueNumber`
    ; / `valueString`, and the two are kept apart on purpose: `.color("red")`
    ; meaning a column called red and `.color("#c00")` meaning paint it red
    ; cannot both be true, and the version that guesses is the one that draws
    ; a chart nobody asked for.
    fn channel:VlChartMark (name:string field:string) {
        def ch (VlJson.objectValue())
        ch.setMember("field" (VlJson.stringValue(field)))
        enc.setMember(name ch)
        cursor = name
        return this
    } doc {
        public
        category "Channels"
        description "Sets any channel to a column by name.

The named channel becomes the cursor, so the next `aggregate`, `title` or
`type` applies to it."
        param name "The channel name, as Vega-Lite spells it."
        param field "The column name."
        returns "This mark, so calls chain."
    }
    fn x:VlChartMark (field:string) {
        return (this.channel("x" field))
    } doc {
        public
        category "Channels"
        description "Position along the horizontal axis.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn y:VlChartMark (field:string) {
        return (this.channel("y" field))
    } doc {
        public
        category "Channels"
        description "Position along the vertical axis.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn x2:VlChartMark (field:string) {
        return (this.channel("x2" field))
    } doc {
        public
        category "Channels"
        description "The far end of a horizontal interval, for a bar, an area or a rule that spans two values.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see x
    }
    fn y2:VlChartMark (field:string) {
        return (this.channel("y2" field))
    } doc {
        public
        category "Channels"
        description "The far end of a vertical interval, for a bar, an area or a rule that spans two values.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see y
    }
    fn color:VlChartMark (field:string) {
        return (this.channel("color" field))
    } doc {
        public
        category "Channels"
        description "Colour, and the legend that explains it.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn fill:VlChartMark (field:string) {
        return (this.channel("fill" field))
    } doc {
        public
        category "Channels"
        description "Fill colour, set apart from the outline.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see stroke
    }
    fn stroke:VlChartMark (field:string) {
        return (this.channel("stroke" field))
    } doc {
        public
        category "Channels"
        description "Outline colour, set apart from the fill.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see fill
    }
    fn size:VlChartMark (field:string) {
        return (this.channel("size" field))
    } doc {
        public
        category "Channels"
        description "Mark size: the area of a point, the width of a trail.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see markSize
    }
    fn shape:VlChartMark (field:string) {
        return (this.channel("shape" field))
    } doc {
        public
        category "Channels"
        description "The symbol a point is drawn as.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn opacity:VlChartMark (field:string) {
        return (this.channel("opacity" field))
    } doc {
        public
        category "Channels"
        description "How opaque the mark is.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see markOpacity
    }
    fn theta:VlChartMark (field:string) {
        return (this.channel("theta" field))
    } doc {
        public
        category "Channels"
        description "The angle an arc covers, which is what makes a pie or a donut.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see radius
    }
    fn radius:VlChartMark (field:string) {
        return (this.channel("radius" field))
    } doc {
        public
        category "Channels"
        description "How far from the centre an arc reaches.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see theta
    }
    fn detail:VlChartMark (field:string) {
        return (this.channel("detail" field))
    } doc {
        public
        category "Channels"
        description "Groups the rows without drawing anything of its own: one line per group, no legend.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn text:VlChartMark (field:string) {
        return (this.channel("text" field))
    } doc {
        public
        category "Channels"
        description "The text a label mark shows.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn order:VlChartMark (field:string) {
        return (this.channel("order" field))
    } doc {
        public
        category "Channels"
        description "The order the rows are drawn in, and the order a line joins its points.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
    }
    fn column:VlChartMark (field:string) {
        return (this.channel("column" field))
    } doc {
        public
        category "Channels"
        description "Splits the chart into side-by-side panels, one per value.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see row
    }
    fn row:VlChartMark (field:string) {
        return (this.channel("row" field))
    } doc {
        public
        category "Channels"
        description "Splits the chart into stacked panels, one per value.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see column
    }
    ; What separates the bars of a grouped bar chart, in the direction the
    ; category axis runs.
    fn xOffset:VlChartMark (field:string) {
        return (this.channel("xOffset" field))
    } doc {
        public
        category "Channels"
        description "What separates the bars of a grouped bar chart, across the horizontal axis.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see yOffset
    }
    fn yOffset:VlChartMark (field:string) {
        return (this.channel("yOffset" field))
    } doc {
        public
        category "Channels"
        description "What separates the bars of a grouped bar chart, across the vertical axis.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This mark, so channels chain."
        see xOffset
    }
    ; A count has no column to read: it is one number per group.
    fn count:VlChartMark (channel:string) {
        def ch (VlJson.objectValue())
        ch.setMember("aggregate" (VlJson.stringValue("count")))
        ch.setMember("type" (VlJson.stringValue("quantitative")))
        enc.setMember(channel ch)
        cursor = channel
        return this
    } doc {
        public
        category "Channels"
        description "Sets a channel to a count of rows: one number per group, with no column to read."
        param channel "The channel to put the count on, usually \"y\" or \"x\"."
        returns "This mark, so calls chain."
    }
    ; A channel set to a constant rather than to a column.
    fn valueNumber:VlChartMark (channel:string value:double) {
        def ch (VlJson.objectValue())
        ch.setMember("value" (VlJson.numberValue(value)))
        enc.setMember(channel ch)
        cursor = channel
        return this
    } doc {
        public
        category "Channels"
        description "Sets a channel to a constant number rather than to a column."
        param channel "The channel name."
        param value "The constant."
        returns "This mark, so calls chain."
        see valueString
    }
    fn valueString:VlChartMark (channel:string value:string) {
        def ch (VlJson.objectValue())
        ch.setMember("value" (VlJson.stringValue(value)))
        enc.setMember(channel ch)
        cursor = channel
        return this
    } doc {
        public
        category "Channels"
        description "Sets a channel to a constant string rather than to a column.

This is how a mark is painted a fixed colour: `.valueString(\"color\" \"#c00\")`.
The channel setters name columns and never constants, because a `.color(…)`
that guessed between the two would draw a chart nobody asked for."
        param channel "The channel name."
        param value "The constant."
        returns "This mark, so calls chain."
        see valueNumber
    }
    ; The whole channel, written out, for whatever this API does not cover.
    ; Vega-Lite is larger than any fluent surface over it, and an escape hatch
    ; that lands in the same specification is better than a wrapper that has to
    ; grow a method before anyone can draw anything.
    fn encodeJson:VlChartMark (channel:string definition:VlJson) {
        enc.setMember(channel definition)
        cursor = channel
        return this
    } doc {
        public
        category "Channels"
        description "Sets a whole channel from an already-built definition.

The escape hatch. Vega-Lite is larger than any fluent surface over it, and a
definition that lands in the same specification is better than waiting for this
API to grow a method."
        param channel "The channel name."
        param definition "The channel definition."
        returns "This mark, so calls chain."
    }

    ; --- the channel most recently named -------------------------------------
    fn on:VlChartMark (channel:string) {
        if (enc.has(channel)) {
            cursor = channel
        } {
            this.note(("no channel called '" + channel) + "' has been set on this mark")
        }
        return this
    } doc {
        public
        category "Channels"
        description "Moves the cursor back to a channel that is already set.

Everything that follows — `aggregate`, `title`, `scaleType` — applies to it.
A channel that was never set is reported in the chart's `errors` rather than
silently created."
        param channel "The channel name."
        returns "This mark, so calls chain."
    }
    fn cursorChannel:VlJson () {
        if ((strlen cursor) == 0) {
            this.note("a channel property was set before any channel was named")
            return (VlJson.objectValue())
        }
        return (enc.get(cursor))
    }
    fn setOnCursor:VlChartMark (key:string value:VlJson) {
        def ch:VlJson (this.cursorChannel())
        ch.setMember(key value)
        return this
    }

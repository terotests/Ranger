    fn arc:VlChartMark () {
        return (this.mark("arc"))
    } doc {
        public
        category "Marks"
        description "Adds an arc mark to the chart.

A wedge, which with `theta` is a pie and with `innerRadius` a donut."
        returns "The new mark, so its channels and properties chain."
    }
    fn label:VlChartMark () {
        return (this.mark("text"))
    } doc {
        public
        category "Marks"
        description "Adds a text mark, which draws the value of its `text` channel."
        returns "The new mark, so its channels and properties chain."
    }
    fn boxplot:VlChartMark () {
        return (this.mark("boxplot"))
    } doc {
        public
        category "Marks"
        description "Adds a boxplot mark to the chart.

A box and whiskers, computed from the rows rather than read off them."
        returns "The new mark, so its channels and properties chain."
    }
    ; The two composite marks: an interval computed from the rows rather than
    ; read off them. `extent` decides what the interval IS — "stderr" (the
    ; default), "stdev", "ci" or "iqr".
    fn errorbar:VlChartMark () {
        return (this.mark("errorbar"))
    } doc {
        public
        category "Marks"
        description "Adds an error bar: an interval computed from the rows rather than read off them.

`extent` decides what the interval is — `stderr` by default, or `stdev`, `ci`
or `iqr`."
        returns "The new mark, so its channels and properties chain."
        see errorband
    }
    fn errorband:VlChartMark () {

        return (this.propNumber("strokeWidth" value))
    } doc {
        public
        category "Mark appearance"
        description "How thick the mark's outline is drawn."
        param value "The width in pixels."
        returns "This mark, so calls chain."
    }
    ; "horizontal" | "vertical" — which way a tick lies, or which way a bar
    ; that has only one position channel runs.
    fn orient:VlChartMark (value:string) {
        return (this.propString("orient" value))
    } doc {
        public
        category "Mark appearance"
        description "Which way a tick lies, or which way a bar with only one position channel runs."

        returns "This mark, so calls chain."
    }
    ; What an interval is computed from: "stderr" | "stdev" | "ci" | "iqr".
    fn extent:VlChartMark (value:string) {
        return (this.propString("extent" value))
    } doc {
        public
        category "Mark appearance"
        description "What an interval mark is computed from."
        param value "`stderr`, `stdev`, `ci` or `iqr`."
        returns "This mark, so calls chain."
    }
    ; Back to the chart, when the next thing to say is about the view.
    fn chart:VlChart () {
        if (!null? owner) {
            return (unwrap owner)
        }
        def empty:VlDataset (VlDataset.create())
        return (VlChart.create(empty))
    } doc {
        public
        category "Marks"
        description "Returns to the chart, when the next thing to say is about the view."
        returns "The owning chart, or a fresh empty one if this mark was built without a chart."
    }
} doc {
    public
    category "Marks"
    description "One mark and the channels it reads.

Every setter answers the mark, so a mark is written as one sentence.

`aggregate`, `bin`, `title` and the rest apply to the channel most recently
named — the cursor — which is what makes that sentence read in the order it is
thought. `on` moves the cursor back to a channel already set.

A channel names a **column**. A constant goes through `valueNumber` or
`valueString`, and the two are kept apart on purpose: `.color(\"red\")` meaning a
column called red and `.color(\"#c00\")` meaning paint it red cannot both be
true, and the version that guesses is the one that draws a chart nobody asked
for."
    example markSentenceExample
    see VlChart
}

class VlChart {
    def data:VlDataset
    def marks:[VlChartMark]
    ; Channels said once for the whole view; a mark that names the same channel
    ; wins over them.
    def enc:VlJson (VlJson.objectValue())
    def cursor:string ""
    ; width, height, title, background — everything above the encoding.
    def props:VlJson (VlJson.objectValue())
    def transforms:VlJson (VlJson.arrayValue())
    def cfg:VlJson (VlJson.objectValue())
    ; What the layers must not share.
    def resolve:VlJson (VlJson.objectValue())
    ; What could not be built, said out loud. A chart that names a column its
    ; data does not have is the case this exists for: Vega-Lite would draw an
    ; empty axis and say nothing.
    def errors:[string]

    sfn create:VlChart (data:VlDataset) {
        def c (new VlChart())
        c.data = data
        return c
    } doc {
        public
        category "Marks"
        description "Builds a chart over a dataset."
        param data "The rows the chart draws."
        returns "A chart with no marks yet."
        see VlDataset
    }

    ; --- marks ---------------------------------------------------------------
    fn mark:VlChartMark (markType:string) {
        def m (new VlChartMark())
        m.markType = markType
        m.owner = this
        push marks m
        return m
    } doc {
        public
        category "Marks"
        description "Adds a mark of any type the compiler knows."
        param markType "The Vega-Lite mark name."
        returns "The new mark, so its channels and properties chain."
    }
    fn bar:VlChartMark () {
        return (this.mark("bar"))
    } doc {
        public
        category "Marks"
        description "Adds a bar mark to the chart.

A rectangle per row: the bar chart, and with `x2`/`y2` a range."
        returns "The new mark, so its channels and properties chain."
    }
    fn line:VlChartMark () {
        return (this.mark("line"))
    } doc {
        public
        category "Marks"
        description "Adds a line mark to the chart.

A line joining the rows in order."
        returns "The new mark, so its channels and properties chain."
    }
    fn area:VlChartMark () {
        return (this.mark("area"))
    } doc {
        public
        category "Marks"
        description "Adds an area mark to the chart.

A filled band between a line and a baseline."
        returns "The new mark, so its channels and properties chain."
    }
    fn point:VlChartMark () {
        return (this.mark("point"))
    } doc {
        public
        category "Marks"
        description "Adds a point mark to the chart.

One symbol per row: the scatter plot."
        returns "The new mark, so its channels and properties chain."
    }
    fn circle:VlChartMark () {
        return (this.mark("circle"))
    } doc {
        public
        category "Marks"
        description "Adds a circle mark to the chart.

A filled circle per row — `point` with the shape settled."
        returns "The new mark, so its channels and properties chain."
    }
    fn square:VlChartMark () {
        return (this.mark("square"))
    } doc {
        public
        category "Marks"
        description "Adds a square mark to the chart.

A filled square per row — `point` with the shape settled."
        returns "The new mark, so its channels and properties chain."
    }
    fn tick:VlChartMark () {
        return (this.mark("tick"))
    } doc {
        public
        category "Marks"
        description "Adds a tick mark to the chart.

A short stroke per row, across the band it sits in."
        returns "The new mark, so its channels and properties chain."
    }
    fn rule:VlChartMark () {
        return (this.mark("rule"))
    } doc {
        public
        category "Marks"
        description "Adds a rule mark to the chart.

A line at one value, spanning the plot or between `x2`/`y2`."
        returns "The new mark, so its channels and properties chain."
    }
    fn rect:VlChartMark () {
        return (this.mark("rect"))
    } doc {
        public
        category "Marks"
        description "Adds a rect mark to the chart.

A rectangle over two ranges: the heatmap."
        returns "The new mark, so its channels and properties chain."

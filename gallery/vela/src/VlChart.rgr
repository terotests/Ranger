        description "Adds an error band: the same interval as an error bar, drawn as a filled region."
        returns "The new mark, so its channels and properties chain."
        see errorbar
    }
    ; A line whose width says something: a trail thickens with its `size`.
    fn trail:VlChartMark () {
        return (this.mark("trail"))
    } doc {
        public
        category "Marks"
        description "Adds a trail mark to the chart.

A line whose width says something: a trail thickens with its `size`."
        returns "The new mark, so its channels and properties chain."
    }
    fn image:VlChartMark () {
        return (this.mark("image"))
    } doc {
        public
        category "Marks"
        description "Adds an image mark to the chart.

A picture per row, placed by its position channels."
        returns "The new mark, so its channels and properties chain."
    }
    ; A map: the shapes come from the data and the projection places them.
    fn geoshape:VlChartMark () {
        return (this.mark("geoshape"))
    } doc {
        public
        category "Marks"
        description "Adds a geoshape mark to the chart.

A map: the shapes come from the data and the projection places them."
        returns "The new mark, so its channels and properties chain."
    }
    ; The mark added last, for a caller that built one and let go of it. A
    ; chart with no marks answers a mark that belongs to nothing rather than
    ; quietly adding one: a `point` nobody asked for would draw.
    fn latest:VlChartMark () {
        def n:int (array_length marks)
        if (n > 0) {
            return (itemAt marks (n - 1))
        }
        this.error("the chart has no marks, so there is no last one")
        def loose (new VlChartMark())
        loose.owner = this
        return loose
    } doc {
        public
        category "Marks"
        description "The mark added last, for a caller that built one and let go of it.

A chart with no marks answers a mark belonging to nothing and reports it in
`errors`, rather than quietly adding a `point` nobody asked for."
        returns "The last mark added."
    }

    ; --- channels shared by every mark ---------------------------------------
    fn channel:VlChart (name:string field:string) {
        def ch (VlJson.objectValue())
        ch.setMember("field" (VlJson.stringValue(field)))
        enc.setMember(name ch)
        cursor = name
        return this
    } doc {
        public
        category "Channels"
        description "Sets a channel that every mark on this view inherits."
        param name "The channel name."
        param field "The column name."
        returns "This chart, so calls chain."
    }
    fn x:VlChart (field:string) {
        return (this.channel("x" field))
    } doc {
        public
        category "Channels"
        description "Position along the horizontal axis.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This view, so channels chain."
    }
    fn y:VlChart (field:string) {
        return (this.channel("y" field))
    } doc {
        public
        category "Channels"
        description "Position along the vertical axis.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This view, so channels chain."
    }
    fn color:VlChart (field:string) {
        return (this.channel("color" field))
    } doc {
        public
        category "Channels"
        description "Colour, and the legend that explains it.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This view, so channels chain."
    }
    fn detail:VlChart (field:string) {
        return (this.channel("detail" field))
    } doc {
        public
        category "Channels"
        description "Groups the rows without drawing anything of its own: one line per group, no legend.

Names a COLUMN, never a constant. `.color(\"red\")` means a column
called red; painting a mark red is `markColor`."
        param field "The column name."
        returns "This view, so channels chain."
    }
    fn encodeJson:VlChart (channel:string definition:VlJson) {
        enc.setMember(channel definition)
        cursor = channel
        return this
    } doc {
        public
        category "Channels"
        description "Sets a whole shared channel from an already-built definition."
        param channel "The channel name."
        param definition "The channel definition."
        returns "This chart, so calls chain."
    }
    fn on:VlChart (channel:string) {
        if (enc.has(channel)) {
            cursor = channel
        } {
            this.error(("no channel called '" + channel) + "' has been set on this view")
        }
        return this
    } doc {
        public
        category "Channels"
        description "Moves the cursor back to a shared channel that is already set."
        param channel "The channel name."
        returns "This chart, so calls chain."
    }
    fn setOnCursor:VlChart (key:string value:VlJson) {
        if ((strlen cursor) == 0) {
            this.error("a channel property was set before any channel was named")
            return this
        }
        def ch:VlJson (enc.get(cursor))
        ch.setMember(key value)
        return this
    }
    fn type:VlChart (kind:string) {
        return (this.setOnCursor("type" (VlJson.stringValue(kind))))
    } doc {
        public
        category "Channels"
        description "States what a shared channel's column holds, when the data cannot say."
        param kind "`quantitative`, `nominal`, `ordinal` or `temporal`."
        returns "This chart, so calls chain."
    }
    fn title:VlChart (label:string) {
        return (this.setOnCursor("title" (VlJson.stringValue(label))))
    } doc {
        public
        category "Scales and axes"
        description "The axis or legend label for the shared cursor channel."
        param label "The label."
        returns "This chart, so calls chain."
        see heading
    }
    fn timeUnit:VlChart (unit:string) {
        return (this.setOnCursor("timeUnit" (VlJson.stringValue(unit))))
    } doc {
        public
        category "Transforms"
        description "Which part of an instant a shared channel reads."
        param unit "The time unit."
        returns "This chart, so calls chain."
    }
    fn keepOrder:VlChart () {
        return (this.setOnCursor("sort" (VlJson.nullValue())))
    } doc {
        public
        category "Scales and axes"
        description "Keeps the order the rows arrived in for the shared cursor channel."
        returns "This chart, so calls chain."
    }

    ; --- the view itself -----------------------------------------------------
    fn size:VlChart (width:int height:int) {
        props.setMember("width" (VlJson.intValue(width)))
        props.setMember("height" (VlJson.intValue(height)))
        return this
    } doc {
        public
        category "The view"
        description "How big the plotting area is, in pixels."
        param width "The width."
        param height "The height."
        returns "This chart, so calls chain."
    }
    fn width:VlChart (value:int) {
        props.setMember("width" (VlJson.intValue(value)))
        return this
    } doc {
        public
        category "The view"
        description "How wide the plotting area is, in pixels."
        param value "The width."
        returns "This chart, so calls chain."
    }
    fn height:VlChart (value:int) {
        props.setMember("height" (VlJson.intValue(value)))
        return this
    } doc {
        public
        category "The view"
        description "How tall the plotting area is, in pixels."
        param value "The height."
        returns "This chart, so calls chain."
    }
    fn heading:VlChart (text:string) {
        props.setMember("title" (VlJson.stringValue(text)))
        return this
    } doc {
        public
        category "The view"
        description "The chart's title, drawn above the plot."
        param text "The title."
        returns "This chart, so calls chain."
        see title
    }
    fn background:VlChart (colour:string) {
        props.setMember("background" (VlJson.stringValue(colour)))
        return this
    } doc {
        public
        category "The view"
        description "The colour behind the plot."
        param colour "A CSS colour."
        returns "This chart, so calls chain."
    }
    fn propJson:VlChart (key:string value:VlJson) {
        props.setMember(key value)
        return this
    } doc {
        public
        category "The view"
        description "Sets any top-level property of the specification."
        param key "The property name."
        param value "The value."
        returns "This chart, so calls chain."
    }
    fn configJson:VlChart (config:VlJson) {
        for config.keys k:string ki {
            cfg.setMember(k (config.get(k)))
        }
        return this
    } doc {
        public
        category "The view"
        description "Merges a configuration block into the specification."
        param config "The configuration object."
        returns "This chart, so calls chain."
    }

    ; --- transforms ----------------------------------------------------------
    ; Only the two the compiler carries. Anything else is refused by name at
    ; compile time rather than dropped here, which is the same answer arriving
    ; from the layer that knows.
    fn filter:VlChart (expression:string) {
        def t (VlJson.objectValue())
        t.setMember("filter" (VlJson.stringValue(expression)))
        push transforms.arr t
        return this
    } doc {
        public
        category "Transforms"
        description "Keeps only the rows an expression accepts."
        param expression "A Vega expression over the row's columns."
        returns "This chart, so calls chain."
    }
    fn calculate:VlChart (expression:string as:string) {
        def t (VlJson.objectValue())
        t.setMember("calculate" (VlJson.stringValue(expression)))
        t.setMember("as" (VlJson.stringValue(as)))
        push transforms.arr t
        return this
    } doc {
        public
        category "Transforms"
        description "Adds a column computed from the others."
        param expression "A Vega expression over the row's columns."
        param as "The name of the new column."
        returns "This chart, so calls chain."
    }
    fn transformJson:VlChart (transform:VlJson) {
        push transforms.arr transform
        return this
    } doc {
        public
        category "Transforms"
        description "Appends an already-built transform."
        param transform "The transform definition."
        returns "This chart, so calls chain."
    }

    ; Two marks measuring different things up the same side of the plot must
    ; not share a scale: `chart.independent("y")` is what makes a Pareto chart
    ; — bars against a count, a line against a running percentage — rather than
    ; two series averaged into one axis neither of them asked for.
    fn independent:VlChart (channel:string) {
        def scales:VlJson (resolve.get("scale"))
        if (! (scales.isObject())) {
            def fresh (VlJson.objectValue())
            resolve.setMember("scale" fresh)
            scales = fresh
        }
        scales.setMember(channel (VlJson.stringValue("independent")))
        return this
    } doc {
        public
        category "Scales and axes"
        description "Stops the layers sharing one scale on a channel.

Two marks measuring different things up the same side of the plot must not
share a scale. This is what makes a Pareto chart — bars against a count, a
line against a running percentage — rather than two series averaged into one
axis neither of them asked for."
        param channel "The channel to split, usually \"y\"."
        returns "This chart, so calls chain."
    }

    ; Said once. `toSpec` may be called more than once — a caller that writes
    ; the specification out and then hands it on calls it twice — and the same
    ; missing column reported twice reads as two mistakes.
    fn error:void (message:string) {
        for errors said:string ei {
            if (said == message) {
                return
            }
        }
        push errors message
    }

    ; --- emitting the specification ------------------------------------------
    ; A deep copy, because a view's channel is inherited by every mark and each
    ; copy then has its own type filled in. Sharing one object would make two
    ; layers the same object, and a change to one of them a change to both.
    sfn copyOf:VlJson (v:VlJson) {
        if (v.isArray()) {
            def list (VlJson.arrayValue())
            def i:int 0
            def n:int (v.count())
            while (i < n) {
                def child:VlJson (v.at(i))
                push list.arr (VlChart.copyOf(child))
                i = (i + 1)
            }
            return list
        }
        if (v.isObject()) {
            def obj (VlJson.objectValue())
            for v.keys k:string ki {
                def member:VlJson (v.get(k))
                obj.setMember(k (VlChart.copyOf(member)))
            }
            return obj
        }
        return v
    }

    ; The view's channels, then the mark's own on top of them.
    fn mergedEncoding:VlJson (m:VlChartMark) {
        def out (VlJson.objectValue())
        for enc.keys k:string ki {
            def shared:VlJson (enc.get(k))
            out.setMember(k (VlChart.copyOf(shared)))
        }
        for m.enc.keys mk:string mi {
            def own:VlJson (m.enc.get(mk))
            out.setMember(mk (VlChart.copyOf(own)))
        }
        this.resolveTypes(out)
        return out
    }

    ; What a channel is, when the channel did not say. This is the whole of the
    ; Observable Plot ergonomics: a caller writes `.x("date")` and the data
    ; decides whether that is an instant or a name.
    fn resolveTypes:void (encoding:VlJson) {
        for encoding.keys k:string ki {
            def ch:VlJson (encoding.get(k))
            ; A channel may be a LIST — `tooltip` is — and every field in it
            ; is typed the same way a channel is. Skipped, a column of dates
            ; came out as a name and a tooltip printed thirteen digits.
            if (ch.isArray()) {
                def i:int 0
                def n:int (ch.count())
                while (i < n) {
                    def one:VlJson (ch.at(i))
                    if (one.isObject()) {
                        if (! (one.has("type"))) {
                            def listKind:string (this.inferType(one))
                            if ((strlen listKind) > 0) {
                                one.setMember("type" (VlJson.stringValue(listKind)))
                            }
                        }
                    }
                    i = (i + 1)
                }
            }
            if (ch.isObject()) {
                if (! (ch.has("type"))) {
                    if (! (ch.has("value"))) {
                        def kind:string (this.inferType(ch))
                        if ((strlen kind) > 0) {
                            ch.setMember("type" (VlJson.stringValue(kind)))
                        }
                    }
                }
            }
        }
    }

    fn inferType:string (ch:VlJson) {
        if (ch.has("bin")) {
            return "quantitative"
        }
        if (ch.has("timeUnit")) {
            return "temporal"
        }
        if (ch.has("aggregate")) {
            return "quantitative"
        }
        if (! (ch.has("field"))) {
            return ""
        }
        def field:string (ch.stringOr("field" ""))
        if ((data.count()) == 0) {
            return "nominal"
        }
        def kind:string (data.fieldType(field))
        if ((strlen kind) == 0) {
            this.error(("the data has no column called '" + field) + "'")
            return "nominal"
        }
        return kind
    }

    ; A mark with no properties of its own is written as the string it is —
    ; `"mark": "bar"` — because that is what a person writes and what every
    ; golden file in this repository holds.
    sfn markValue:VlJson (m:VlChartMark) {
        def n:int (array_length m.props.keys)
        if (n == 0) {
            return (VlJson.stringValue(m.markType))
        }
        def obj (VlJson.objectValue())
        obj.setMember("type" (VlJson.stringValue(m.markType)))
        for m.props.keys k:string ki {
            obj.setMember(k (m.props.get(k)))
        }
        return obj
    }

    ; The whole thing: a Vega-Lite specification, ready for VlCompile.
    fn toSpec:VlJson () {
        def out (VlJson.objectValue())
        for props.keys k:string ki {
            out.setMember(k (props.get(k)))
        }
        out.setMember("data" (data.toValues()))
        if ((transforms.count()) > 0) {
            out.setMember("transform" transforms)
        }
        def markCount:int (array_length marks)
        if (markCount == 0) {
            this.error("the chart has no marks")
            return out
        }
        if (markCount == 1) {
            def only:VlChartMark (itemAt marks 0)
            out.setMember("mark" (VlChart.markValue(only)))
            out.setMember("encoding" (this.mergedEncoding(only)))
        } {
            def layers (VlJson.arrayValue())
            for marks m:VlChartMark mi {
                def layer (VlJson.objectValue())
                layer.setMember("mark" (VlChart.markValue(m)))
                layer.setMember("encoding" (this.mergedEncoding(m)))
                push layers.arr layer
            }
            out.setMember("layer" layers)
            def resolveCount:int (array_length resolve.keys)
            if (resolveCount > 0) {
                out.setMember("resolve" resolve)
            }
        }
        def cfgCount:int (array_length cfg.keys)
        if (cfgCount > 0) {
            out.setMember("config" cfg)
        }
        return out
    } doc {
        public
        category "Output"
        example chartQuickExample
        description "The chart as a Vega-Lite specification.

One mark comes out as a plain specification; several come out as layers, each
carrying the shared channels in full — a specification that states everything
is one the compiler already handles and one a person can read in a diff.

May be called more than once. Check `errors` afterwards: a chart that names a
column its data does not have is reported here, where Vega-Lite would have
drawn an empty axis and said nothing."
        returns "A Vega-Lite specification, ready for `VlCompile`."
    }

    fn toText:string () {
        def spec:VlJson (this.toSpec())
        def w (new VlJsonWriter())
        return (w.write(spec))
    }
} doc {
    public
    category "Marks"
    description "A chart: a dataset, the channels every mark shares, how big it is, and the marks.

The fluent surface is a **writer of specifications**, not the engine. Every
call writes into a specification and `toSpec` hands that specification over;
nothing here computes a scale, a layout or a pixel. There is no path where the
API computes something the engine would have computed differently, because the
API computes nothing at all.

A channel said on the chart is inherited by every mark on it, so a line and the
points on top of it are two marks and one set of axes rather than two charts.

A channel need not state its type — the data says. A column of numbers is a
quantity, a column of ISO dates an instant, anything else a name. A field the
data does not have is an **error** rather than a guess: `errors` is non-empty
and the caller can say so instead of drawing an empty axis."
    example chartQuickExample
    example sharedChannelExample
    since "1.0"
    see VlDataset
}

; ------------------------------------------------------------------------------
; The examples the doc blocks above name.
;
; These are ordinary functions: they are compiled and type-checked with the
; rest of the file, so a signature change breaks the build rather than the
; documentation. They are left OUT of the emitted code — `-keep-examples`
; puts them back — and each doc comment carries the body rendered in its own
; target's syntax, so a Kotlin reader is shown Kotlin.
; ------------------------------------------------------------------------------
class VlChartExamples {

    sfn datasetExample:void () {
        def data (VlDataset.create())
        data.row().str("region" "North").num("sales" 120.0)
        data.row().str("region" "South").num("sales" 93.0)
    }

    sfn chartQuickExample:void () {
        def data (VlDataset.create())
        data.row().str("region" "North").num("sales" 120.0)
        data.row().str("region" "South").num("sales" 93.0)
        def chart (VlChart.create(data))
        chart.size(300 200)
        chart.bar().x("region").y("sales").aggregate("sum")
        def spec (chart.toSpec())
    }

    sfn markSentenceExample:void () {
        def data (VlDataset.create())
        data.row().str("region" "North").num("sales" 120.0)
        def chart (VlChart.create(data))
        chart.bar().x("region").y("sales").aggregate("sum").title("Total sales")
    }

    sfn sharedChannelExample:void () {
        def data (VlDataset.create())
        data.row().str("region" "North").num("sales" 120.0)
        def chart (VlChart.create(data))
        chart.x("region").y("sales").color("region")
        chart.area().markOpacity(0.35)
        chart.line()
    }
}

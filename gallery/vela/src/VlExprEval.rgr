; ==============================================================================
; VlExprEval.rgr — evaluating a parsed Vega expression.
; ==============================================================================
; The scope an expression sees is small and explicit: the current datum, the
; named signals, and the scales (so `bandwidth('x')` and `domain('x').length`
; answer). Everything else is a function from the standard set.
;
; Values are VlJson throughout rather than a second value type. An expression
; reads data that arrived as JSON and writes values that go back into a datum
; or a scene item, so a separate value union would only add two conversions per
; node. `null` doubles as "undefined" — Vega's own expression language treats
; the two the same in every test that matters here (`isValid` is the one place
; the distinction would show, and it checks for both).
; ==============================================================================

Import "VlJson.rgr"
Import "VlFormat.rgr"
Import "VlTime.rgr"
Import "VlExpr.rgr"
Import "VlScale.rgr"
Import "VlMath.rgr"
Import "VlRegex.rgr"

class VlExprScope {
    def datum:VlJson (new VlJson)
    def hasDatum:boolean false
    def parent:VlJson (new VlJson)
    def hasParent:boolean false
    def signals:[string:VlJson]
    def scales:[string:VlScale]
    ; The data sets by name, so an expression can ask how many rows one has —
    ; which is how a faceted view says how many columns it has.
    def dataSets:[string:VlJson]
    ; The wall clock the LOCAL date functions read — `year`, `hours`,
    ; `timeFormat`. Their `utc…` twins ignore it, by definition.
    def zone:VlTimeZone (new VlTimeZone())
    ; Set when a function the profile does not have is called, so a spec that
    ; needs more than this evaluator has fails loudly instead of drawing
    ; something subtly wrong.
    def missing:[string]

    fn setDatum:void (row:VlJson) {
        datum = row
        hasDatum = true
    }
    ; `parent` is the datum of the GROUP an expression is being evaluated
    ; inside, which is how a faceted column's header names the value its column
    ; stands for.
    fn setData:void (name:string rows:VlJson) {
        set dataSets name rows
    }
    fn dataOf:VlJson (name:string) {
        if (has dataSets name) {
            return (unwrap (get dataSets name))
        }
        return (VlJson.arrayValue())
    }
    fn setParent:void (row:VlJson) {
        parent = row
        hasParent = true
    }
    fn clearParent:void () {
        hasParent = false
    }
    fn setSignal:void (name:string value:VlJson) {
        set signals name value
    }
    fn signal:VlJson (name:string) {
        if (has signals name) {
            return (unwrap (get signals name))
        }
        return (VlJson.nullValue())
    }
    fn hasSignal:boolean (name:string) {
        return (has signals name)
    }
    fn setScale:void (name:string sc:VlScale) {
        set scales name sc
    }
    fn scale:VlScale (name:string) {
        if (has scales name) {
            return (unwrap (get scales name))
        }
        def empty (new VlScale())
        return empty
    }
    fn hasScale:boolean (name:string) {
        return (has scales name)
    }
    fn noteMissing:void (name:string) {
        push missing name
    }
}

class VlExprEval {

    ; ------------------------------------------------------------ truthiness --
    sfn truthy:boolean (v:VlJson) {
        if (v.kind == 0) {
            return false
        }
        if (v.kind == 1) {
            return v.b
        }
        if (v.kind == 2) {
            return (v.num != 0.0)
        }
        if (v.kind == 3) {
            return ((strlen v.str) > 0)
        }
        return true
    }

    ; An index into a string, kept inside it — JavaScript's `substring` clamps
    ; rather than throwing, and a spec relies on that.
    sfn clampIndex:int (at:int length:int) {
        if (at < 0) { return 0 }
        if (at > length) { return length }
        return at
    }

    sfn shiftCase:string (text:string upper:boolean) {
        def out:string ""
        def n:int (strlen text)
        def k:int 0
        while (k < n) {
            def c:int (charAt text k)
            if upper {
                if ((c >= 97) && (c <= 122)) { c = (c - 32) }
            } {
                if ((c >= 65) && (c <= 90)) { c = (c + 32) }
            }
            out = (out + (strfromcode c))
            k = (k + 1)
        }
        return out
    }

    sfn looseEquals:boolean (a:VlJson b:VlJson) {
        if ((a.kind == 0) || (b.kind == 0)) {
            return ((a.kind == 0) && (b.kind == 0))
        }
        if ((a.kind == 3) && (b.kind == 3)) {
            return (a.str == b.str)
        }
        if ((a.kind == 1) || (b.kind == 1)) {
            return ((VlExprEval.truthy(a)) == (VlExprEval.truthy(b)))
        }
        if ((a.kind == 3) || (b.kind == 3)) {
            ; JavaScript compares a string against a number by coercing the
            ; string, which is what a `datum.x == 5` in a spec expects.
            if ((a.kind == 2) || (b.kind == 2)) {
                return ((a.asDouble()) == (b.asDouble()))
            }
            return ((a.asString()) == (b.asString()))
        }
        return ((a.asDouble()) == (b.asDouble()))
    }

    ; --------------------------------------------------------------- eval ----
    sfn eval:VlJson (node:VlExprNode scope:VlExprScope) {
        if (node.kind == 0) {
            return node.value
        }
        if (node.kind == 1) {
            return (VlExprEval.evalIdentifier(node scope))
        }
        if (node.kind == 2) {
            return (VlExprEval.evalMember(node scope))
        }
        if (node.kind == 3) {
            return (VlExprEval.evalCall(node scope))
        }
        if (node.kind == 4) {
            return (VlExprEval.evalUnary(node scope))
        }
        if (node.kind == 5) {
            return (VlExprEval.evalBinary(node scope))
        }
        if (node.kind == 6) {
            return (VlExprEval.evalLogical(node scope))
        }
        if (node.kind == 7) {
            def cond:VlJson (VlExprEval.eval((itemAt node.children 0) scope))
            if (VlExprEval.truthy(cond)) {
                return (VlExprEval.eval((itemAt node.children 1) scope))
            }
            return (VlExprEval.eval((itemAt node.children 2) scope))
        }
        if (node.kind == 8) {
            def arr:VlJson (VlJson.arrayValue())
            for node.children child:VlExprNode idx {
                push arr.arr (VlExprEval.eval(child scope))
            }
            return arr
        }
        if (node.kind == 9) {
            def obj:VlJson (VlJson.objectValue())
            def total:int (array_length node.children)
            def k:int 0
            while (k < total) {
                def key:string (itemAt node.keys k)
                def child:VlExprNode (itemAt node.children k)
                obj.setMember(key (VlExprEval.eval(child scope)))
                k = (k + 1)
            }
            return obj
        }
        return (VlJson.nullValue())
    }

    sfn evalIdentifier:VlJson (node:VlExprNode scope:VlExprScope) {
        if (node.name == "datum") {
            if scope.hasDatum {
                return scope.datum
            }
            return (VlJson.nullValue())
        }
        if (node.name == "parent") {
            if scope.hasParent {
                return scope.parent
            }
            return (VlJson.nullValue())
        }
        if (node.name == "PI") {
            return (VlJson.numberValue(3.141592653589793))
        }
        if (node.name == "E") {
            return (VlJson.numberValue(2.718281828459045))
        }
        if (scope.hasSignal((node.name))) {
            return (scope.signal((node.name)))
        }
        return (VlJson.nullValue())
    }

    sfn evalMember:VlJson (node:VlExprNode scope:VlExprScope) {
        def target:VlJson (VlExprEval.eval((itemAt node.children 0) scope))
        def key:string ""
        if node.computed {
            def keyVal:VlJson (VlExprEval.eval((itemAt node.children 1) scope))
            if (target.kind == 4) {
                def idx:int (to_int (keyVal.asDouble()))
                return (target.at(idx))
            }
            ; A STRING indexes too: `datum.label[0]` is how a chart keeps a
            ; month's initial, and read as a member lookup on a string it
            ; answered nothing and the whole name stayed.
            if (target.kind == 3) {
                if (keyVal.isNumber()) {
                    def at:int (to_int keyVal.num)
                    if ((at >= 0) && (at < (strlen target.str))) {
                        return (VlJson.stringValue((substring target.str at (at + 1))))
                    }
                    return (VlJson.nullValue())
                }
            }
            key = (keyVal.asString())
        } {
            key = node.name
        }
        if (key == "length") {
            if (target.kind == 4) {
                return (VlJson.intValue((target.count())))
            }
            if (target.kind == 3) {
                return (VlJson.intValue((strlen target.str)))
            }
        }
        if (target.kind == 5) {
            return (target.get(key))
        }
        return (VlJson.nullValue())
    }

    sfn evalUnary:VlJson (node:VlExprNode scope:VlExprScope) {
        def v:VlJson (VlExprEval.eval((itemAt node.children 0) scope))
        if (node.op == "!") {
            return (VlJson.boolValue((! (VlExprEval.truthy(v)))))
        }
        if (node.op == "-") {
            return (VlJson.numberValue((0.0 - (v.asDouble()))))
        }
        return (VlJson.numberValue((v.asDouble())))
    }

    sfn evalLogical:VlJson (node:VlExprNode scope:VlExprScope) {
        def left:VlJson (VlExprEval.eval((itemAt node.children 0) scope))
        if (node.op == "&&") {
            def leftTruthy:boolean (VlExprEval.truthy(left))
            if (! leftTruthy) {
                return left
            }
            return (VlExprEval.eval((itemAt node.children 1) scope))
        }
        if (VlExprEval.truthy(left)) {
            return left
        }
        return (VlExprEval.eval((itemAt node.children 1) scope))
    }

    ; A value glued onto a string, the way the language this expression is
    ; written in glues it: a MISSING value reads as "null" and not as nothing.
    ; A text mark that names a column with gaps in it prints "null" over the
    ; bar with no category, which is what the reference draws there.
    sfn asText:string (v:VlJson) {
        if (v.kind == 0) {
            return "null"
        }
        return (v.asString())
    }

    sfn evalBinary:VlJson (node:VlExprNode scope:VlExprScope) {
        def a:VlJson (VlExprEval.eval((itemAt node.children 0) scope))
        def b:VlJson (VlExprEval.eval((itemAt node.children 1) scope))
        def op:string node.op

        if (op == "+") {
            ; `+` concatenates when either side is a string, which is how every
            ; generated `description` signal builds its text.
            if ((a.kind == 3) || (b.kind == 3)) {
                return (VlJson.stringValue(((VlExprEval.asText(a)) + (VlExprEval.asText(b)))))
            }
            return (VlJson.numberValue(((a.asDouble()) + (b.asDouble()))))
        }
        if (op == "-") {
            return (VlJson.numberValue(((a.asDouble()) - (b.asDouble()))))
        }
        if (op == "*") {
            return (VlJson.numberValue(((a.asDouble()) * (b.asDouble()))))
        }
        if (op == "/") {
            return (VlJson.numberValue(((a.asDouble()) / (b.asDouble()))))
        }
        if (op == "%") {
            def x:double (a.asDouble())
            def y:double (b.asDouble())
            if (y == 0.0) {
                return (VlJson.numberValue(0.0))
            }
            def q:double (to_double (to_int (x / y)))
            return (VlJson.numberValue((x - (q * y))))
        }
        if ((op == "==") || (op == "===")) {
            if (op == "===") {
                if (a.kind != b.kind) {
                    return (VlJson.boolValue(false))
                }
            }
            return (VlJson.boolValue((VlExprEval.looseEquals(a b))))
        }
        if ((op == "!=") || (op == "!==")) {
            if (op == "!==") {
                if (a.kind != b.kind) {
                    return (VlJson.boolValue(true))
                }
            }
            return (VlJson.boolValue((! (VlExprEval.looseEquals(a b)))))
        }
        ; Relational operators compare strings as strings and everything else
        ; as numbers, matching the JavaScript rule the spec authors write to.
        if ((a.kind == 3) && (b.kind == 3)) {
            def cmp:int (VlExprEval.compareStrings((a.str) (b.str)))
            if (op == "<") {
                return (VlJson.boolValue((cmp < 0)))
            }
            if (op == "<=") {
                return (VlJson.boolValue((cmp <= 0)))
            }
            if (op == ">") {
                return (VlJson.boolValue((cmp > 0)))
            }
            return (VlJson.boolValue((cmp >= 0)))
        }
        def x:double (a.asDouble())
        def y:double (b.asDouble())
        if (op == "<") {
            return (VlJson.boolValue((x < y)))
        }
        if (op == "<=") {
            return (VlJson.boolValue((x <= y)))
        }
        if (op == ">") {
            return (VlJson.boolValue((x > y)))
        }
        return (VlJson.boolValue((x >= y)))
    }

    sfn compareStrings:int (a:string b:string) {
        def la:int (strlen a)
        def lb:int (strlen b)
        def limit:int la
        if (lb < limit) {
            limit = lb
        }
        def k:int 0
        while (k < limit) {
            def ca:int (charAt a k)
            def cb:int (charAt b k)
            if (ca < cb) {
                return -1
            }
            if (ca > cb) {
                return 1
            }
            k = (k + 1)
        }
        if (la < lb) {
            return -1
        }
        if (la > lb) {
            return 1
        }
        return 0
    }

    ; --------------------------------------------------------------- calls ----
    ; What a time function was handed, as an instant. A number is one already;
    ; a string is a date that nothing has parsed yet, which is what a column
    ; read straight out of a JSON file holds.
    sfn instantOf:double (v:VlJson) {
        if (v.isString()) {
            ; A string of digits is a NUMBER of milliseconds rather than a
            ; written date — which is what a band scale's domain holds, since a
            ; band keeps its categories as names. Parsed as a date it answered
            ; the epoch, so every label on an axis of days looked like the
            ; first of January.
            if (VlExprEval.looksNumeric((v.asString()))) {
                return (v.asDouble())
            }
            return (VlTime.parseDate((v.asString())))
        }
        return (v.asDouble())
    }

    sfn looksNumeric:boolean (text:string) {
        def n:int (strlen text)
        if (n == 0) {
            return false
        }
        def k:int 0
        if ((substring text 0 1) == "-") {
            k = 1
        }
        if (k >= n) {
            return false
        }
        while (k < n) {
            def c:int (charAt text k)
            if ((c < 48) || (c > 57)) {
                return false
            }
            k = (k + 1)
        }
        return true
    }

    sfn evalCall:VlJson (node:VlExprNode scope:VlExprScope) {
        def name:string node.name
        def argc:int (array_length node.children)
        def a0:VlJson (VlJson.nullValue())
        def a1:VlJson (VlJson.nullValue())
        def a2:VlJson (VlJson.nullValue())
        if (argc > 0) {
            a0 = (VlExprEval.eval((itemAt node.children 0) scope))
        }
        if (argc > 1) {
            a1 = (VlExprEval.eval((itemAt node.children 1) scope))
        }
        if (argc > 2) {
            a2 = (VlExprEval.eval((itemAt node.children 2) scope))
        }

        ; --- dates ---
        ; The first argument as an INSTANT, for the functions that take one.
        ; A chart hands them whatever the column holds, which is very often the
        ; date as written because nothing has parsed it yet; read as a number a
        ; written date is zero, and `year(datum.Year)` answered 1970 for every
        ; row of a file that spans a decade.
        def when:double (VlExprEval.instantOf(a0))
        ; An instant is a number of milliseconds. `toDate` is what a
        ; specification calls on a temporal field before anything scales it, and
        ; a chart's dates arrive as ISO strings.
        if (name == "toDate") {
            if (a0.isNumber()) {
                return a0
            }
            if (a0.isString()) {
                return (VlJson.numberValue((VlTime.parseDate((a0.asString())))))
            }
            return (VlJson.nullValue())
        }
        if (name == "datetime") {
            def dp (new VlTimeParts())
            dp.year = (a0.asInt())
            dp.month = ((a1.asInt()) + 1)
            dp.day = 1
            if (a2.isNumber()) {
                dp.day = (a2.asInt())
            }
            def rest:int (array_length node.children)
            if (rest > 3) {
                dp.hours = ((VlExprEval.eval((itemAt node.children 3) scope)).asInt())
            }
            if (rest > 4) {
                dp.minutes = ((VlExprEval.eval((itemAt node.children 4) scope)).asInt())
            }
            if (rest > 5) {
                dp.seconds = ((VlExprEval.eval((itemAt node.children 5) scope)).asInt())
            }
            return (VlJson.numberValue((VlTime.msOf(dp scope.zone))))
        }
        ; `time(d)` is the instant a date stands for, as a number. Everything
        ; here already IS a number of milliseconds, so it is the value with a
        ; written date parsed on the way through.
        if (name == "time") {
            return (VlJson.numberValue(when))
        }
        if (name == "timeFormat") {
            return (VlJson.stringValue((VlTime.format(when (a1.asString()) scope.zone))))
        }
        if (name == "utcFormat") {
            return (VlJson.stringValue((VlTime.format(when (a1.asString()) (VlTimeZone.utc())))))
        }
        if (name == "year") {
            return (VlJson.intValue(((VlTime.partsOf(when scope.zone)).year)))
        }
        if (name == "month") {
            return (VlJson.intValue((((VlTime.partsOf(when scope.zone)).month) - 1)))
        }
        if (name == "date") {
            return (VlJson.intValue(((VlTime.partsOf(when scope.zone)).day)))
        }
        if (name == "hours") {
            return (VlJson.intValue(((VlTime.partsOf(when scope.zone)).hours)))
        }
        if (name == "minutes") {
            return (VlJson.intValue(((VlTime.partsOf(when scope.zone)).minutes)))
        }
        if (name == "seconds") {
            return (VlJson.intValue(((VlTime.partsOf(when scope.zone)).seconds)))
        }
        if (name == "day") {
            return (VlJson.intValue(((VlTime.partsOf(when scope.zone)).weekday)))
        }

        ; --- type tests ---
        if (name == "isValid") {
            if (a0.kind == 0) {
                return (VlJson.boolValue(false))
            }
            if (a0.kind == 2) {
                return (VlJson.boolValue((! (VlExprEval.isNaN((a0.num))))))
            }
            return (VlJson.boolValue(true))
        }
        if (name == "isFinite") {
            return (VlJson.boolValue((VlExprEval.isFiniteNumber((a0.asDouble())))))
        }
        if (name == "isNaN") {
            return (VlJson.boolValue((VlExprEval.isNaN((a0.asDouble())))))
        }
        if (name == "isArray") {
            return (VlJson.boolValue((a0.kind == 4)))
        }
        if (name == "isBoolean") {
            return (VlJson.boolValue((a0.kind == 1)))
        }
        if (name == "isNumber") {
            return (VlJson.boolValue((a0.kind == 2)))
        }
        if (name == "isString") {
            return (VlJson.boolValue((a0.kind == 3)))
        }
        if (name == "isObject") {
            return (VlJson.boolValue((a0.kind == 5)))
        }
        if (name == "isDefined") {
            return (VlJson.boolValue((a0.kind != 0)))
        }
        ; An instant is a NUMBER here — milliseconds since the epoch, which is
        ; what the date parse leaves behind — so nothing is ever a date object
        ; and the answer is always no. The reference asks this beside a
        ; finiteness test (`isDate(d) || (isValid(d) && isFinite(+d))`), and
        ; the other half of that answers correctly for a number.
        ; `timeOffset('month', d, -1)` is the instant a whole unit before or
        ; after another — a calendar question, not an arithmetic one, since a
        ; month is not a fixed number of milliseconds. The reference asks it
        ; when it places a bar over the unit its row belongs to.
        if (name == "timeOffset") {
            def unit:string (a0.asString())
            def when:double (a1.asDouble())
            def steps:int 1
            if (a2.isDefined()) {
                steps = (to_int (a2.asDouble()))
            }
            def back:boolean (steps < 0)
            def count:int steps
            if back {
                count = (0 - steps)
            }
            def at:double when
            def k:int 0
            while (k < count) {
                if back {
                    ; A step BACK is the start of the unit before this one,
                    ; which is where the instant a millisecond earlier falls.
                    ; The reference only ever asks this of an instant already
                    ; floored to its unit, so that is the whole of it.
                    at = (VlTime.floorTo((at - 1.0) unit scope.zone))
                } {
                    at = (VlTime.addUnit(at unit scope.zone))
                }
                k = (k + 1)
            }
            return (VlJson.numberValue(at))
        }
        if (name == "isDate") {
            return (VlJson.boolValue(false))
        }
        ; Whether a value falls within a pair of bounds, either way round —
        ; the ends are included, which is how a brush covers what it touches.
        if (name == "inrange") {
            def span:VlJson a1
            if (span.kind != 4) {
                return (VlJson.boolValue(false))
            }
            if ((span.count()) < 2) {
                return (VlJson.boolValue(false))
            }
            def lo:double (span.at(0).asDouble())
            def hi:double (span.at(1).asDouble())
            if (hi < lo) {
                def swap:double lo
                lo = hi
                hi = swap
            }
            def v:double (a0.asDouble())
            return (VlJson.boolValue(((v >= lo) && (v <= hi))))
        }

        ; --- math ---
        if (name == "abs") {
            def v:double (a0.asDouble())
            if (v < 0.0) {
                v = (0.0 - v)
            }
            return (VlJson.numberValue(v))
        }
        if (name == "ceil") {
            return (VlJson.numberValue((to_double (ceil (a0.asDouble())))))
        }
        if (name == "floor") {
            return (VlJson.numberValue((to_double (floor (a0.asDouble())))))
        }
        if (name == "round") {
            return (VlJson.numberValue((to_double (floor ((a0.asDouble()) + 0.5)))))
        }
        if (name == "sqrt") {
            return (VlJson.numberValue((sqrt (a0.asDouble()))))
        }
        ; The circle functions, which a chart uses to draw a wave or to place
        ; something round a centre by hand.
        if (name == "sin") {
            return (VlJson.numberValue((sin (a0.asDouble()))))
        }
        if (name == "cos") {
            return (VlJson.numberValue((cos (a0.asDouble()))))
        }
        if (name == "tan") {
            return (VlJson.numberValue(((sin (a0.asDouble())) / (cos (a0.asDouble())))))
        }
        if (name == "atan2") {
            return (VlJson.numberValue((atan2 (a0.asDouble()) (a1.asDouble()))))
        }
        if (name == "exp") {
            return (VlJson.numberValue((VlMath.exp((a0.asDouble())))))
        }
        if (name == "log") {
            return (VlJson.numberValue((VlMath.ln((a0.asDouble())))))
        }
        if (name == "pow") {
            return (VlJson.numberValue((VlMath.pow((a0.asDouble()) (a1.asDouble())))))
        }
        if (name == "max") {
            return (VlExprEval.extremum(node scope true))
        }
        if (name == "min") {
            return (VlExprEval.extremum(node scope false))
        }
        if (name == "clamp") {
            def v:double (a0.asDouble())
            def lo:double (a1.asDouble())
            def hi:double (a2.asDouble())
            if (v < lo) {
                v = lo
            }
            if (v > hi) {
                v = hi
            }
            return (VlJson.numberValue(v))
        }
        if (name == "span") {
            if (a0.kind == 4) {
                def cnt:int (a0.count())
                if (cnt < 2) {
                    return (VlJson.numberValue(0.0))
                }
                return (VlJson.numberValue(((a0.at((cnt - 1)).asDouble()) - (a0.at(0).asDouble()))))
            }
            return (VlJson.numberValue(0.0))
        }

        ; --- strings and arrays ---
        if (name == "data") {
            return (scope.dataOf((a0.asString())))
        }
        if (name == "length") {
            if (a0.kind == 4) {
                return (VlJson.intValue((a0.count())))
            }
            return (VlJson.intValue((strlen (a0.asString()))))
        }
        ; The format string a set of time units labels itself with. The
        ; reference's own compiler writes this into an axis rather than the
        ; string it produces, so a specification compiled by the official
        ; Vega-Lite cannot be RUN here without it.
        ;
        ; The second argument overrides individual entries, which is how
        ; Vega-Lite states that a year and a month together read "Jan 2012"
        ; rather than "2012 Jan".
        if (name == "timeUnitSpecifier") {
            def units:[string]
            if (a0.kind == 4) {
                def uc:int (a0.count())
                def uk:int 0
                while (uk < uc) {
                    def oneUnit:VlJson (a0.at(uk))
                    push units (oneUnit.asString())
                    uk = (uk + 1)
                }
            } {
                push units (a0.asString())
            }
            def total:int (array_length units)
            def text:string ""
            def start:int 0
            def guard:int 0
            while ((start < total) && (guard < 16)) {
                guard = (guard + 1)
                def end:int total
                def matched:boolean false
                while ((end > start) && (! matched)) {
                    def key:string ""
                    def kk:int start
                    while (kk < end) {
                        if (kk > start) {
                            key = (key + "-")
                        }
                        key = (key + (itemAt units kk))
                        kk = (kk + 1)
                    }
                    def piece:string ""
                    if (argc > 1) {
                        if (a1.has(key)) {
                            piece = (a1.stringOr(key ""))
                        }
                    }
                    if ((strlen piece) == 0) {
                        piece = (VlTime.specifierFor(key))
                    }
                    if ((strlen piece) > 0) {
                        text = (text + piece)
                        start = end
                        matched = true
                    } {
                        end = (end - 1)
                    }
                }
                if (! matched) {
                    start = (start + 1)
                }
            }
            return (VlJson.stringValue((VlTime.trimEnd(text))))
        }

        ; Where a value sits in a list, or -1. A stack whose order was declared
        ; rather than derived is sorted by exactly this: the segment's place in
        ; the colour scale's own domain.
        if (name == "indexof") {
            if (a0.kind == 4) {
                def total:int (a0.count())
                def wanted:string (a1.asString())
                def at:int 0
                while (at < total) {
                    def entry:VlJson (a0.at(at))
                    if ((entry.asString()) == wanted) {
                        return (VlJson.intValue(at))
                    }
                    at = (at + 1)
                }
                return (VlJson.intValue((0 - 1)))
            }
            return (VlJson.intValue((indexOf (a0.asString()) (a1.asString()))))
        }
        if (name == "join") {
            def sep:string ","
            if (argc > 1) {
                sep = (a1.asString())
            }
            def out:string ""
            def cnt:int (a0.count())
            def k:int 0
            while (k < cnt) {
                if (k > 0) {
                    out = (out + sep)
                }
                out = (out + (a0.at(k).asString()))
                k = (k + 1)
            }
            return (VlJson.stringValue(out))
        }
        if (name == "toString") {
            return (VlJson.stringValue((a0.asString())))
        }
        ; --- strings ---
        if (name == "substring") {
            def text:string (a0.asString())
            def n:int (strlen text)
            def from:int (VlExprEval.clampIndex((to_int (a1.asDouble())) n))
            def to:int n
            if (argc > 2) {
                to = (VlExprEval.clampIndex((to_int (a2.asDouble())) n))
            }
            if (from > to) {
                def swap:int from
                from = to
                to = swap
            }
            return (VlJson.stringValue((substring text from to)))
        }
        ; --- regular expressions ---
        ; `regexp(pattern, flags)` compiles one and `test(re, string)` asks
        ; whether it occurs. The compiled expression is carried as an object
        ; rather than as a string, so that a pattern and a string that happens
        ; to look like one cannot be confused.
        if (name == "regexp") {
            def re (VlJson.objectValue())
            re.setMember("__regexp" (VlJson.stringValue((a0.asString()))))
            def flags:string ""
            if (argc > 1) {
                flags = (a1.asString())
            }
            re.setMember("__flags" (VlJson.stringValue(flags)))
            return re
        }
        if (name == "test") {
            def engine (new VlRegex())
            def flags2:string ""
            def source:string (a0.asString())
            if (a0.isObject()) {
                source = (a0.stringOr("__regexp" ""))
                flags2 = (a0.stringOr("__flags" ""))
            }
            engine.compile(source flags2)
            if (! engine.ok) {
                scope.noteMissing(engine.why)
                return (VlJson.boolValue(false))
            }
            def against:string ""
            if (argc > 1) {
                against = (a1.asString())
            }
            return (VlJson.boolValue((engine.test(against))))
        }
        if (name == "upper") {
            return (VlJson.stringValue((VlExprEval.shiftCase((a0.asString()) true))))
        }
        if (name == "lower") {
            return (VlJson.stringValue((VlExprEval.shiftCase((a0.asString()) false))))
        }
        if (name == "toNumber") {
            if (a0.kind == 0) {
                return (VlJson.nullValue())
            }
            return (VlJson.numberValue((a0.asDouble())))
        }
        if (name == "toBoolean") {
            if (a0.kind == 0) {
                return (VlJson.nullValue())
            }
            return (VlJson.boolValue((VlExprEval.truthy(a0))))
        }
        if (name == "format") {
            return (VlJson.stringValue((VlExprEval.formatNumber((a0.asDouble()) (a1.asString())))))
        }

        ; --- scale-aware ---
        if (name == "bandwidth") {
            def sc:VlScale (scope.scale((a0.asString())))
            return (VlJson.numberValue((sc.bandwidth())))
        }
        if (name == "domain") {
            def sc:VlScale (scope.scale((a0.asString())))
            def out:VlJson (VlJson.arrayValue())
            if ((sc.scaleType == "band") || ((sc.scaleType == "point") || (sc.scaleType == "ordinal"))) {
                for sc.domainValues dv:string dvi {
                    push out.arr (VlJson.stringValue(dv))
                }
            } {
                push out.arr (VlJson.numberValue((sc.domainMin)))
                push out.arr (VlJson.numberValue((sc.domainMax)))
            }
            return out
        }
        if (name == "range") {
            def sc:VlScale (scope.scale((a0.asString())))
            def out:VlJson (VlJson.arrayValue())
            push out.arr (VlJson.numberValue((sc.rangeMin)))
            push out.arr (VlJson.numberValue((sc.rangeMax)))
            return out
        }
        if (name == "scale") {
            def sc:VlScale (scope.scale((a0.asString())))
            return (VlJson.numberValue((sc.mapValue(a1))))
        }
        if (name == "bandspace") {
            ; bandspace(count, paddingInner, paddingOuter)
            def cnt:double (a0.asDouble())
            def inner:double (a1.asDouble())
            def outer:double (a2.asDouble())
            def slots:double ((cnt - inner) + (outer * 2.0))
            if (slots < 1.0) {
                slots = 1.0
            }
            return (VlJson.numberValue(slots))
        }
        if (name == "if") {
            if (VlExprEval.truthy(a0)) {
                return a1
            }
            return a2
        }

        scope.noteMissing(name)
        return (VlJson.nullValue())
    }

    sfn extremum:VlJson (node:VlExprNode scope:VlExprScope wantMax:boolean) {
        def total:int (array_length node.children)
        def best:double 0.0
        def have:boolean false
        def k:int 0
        while (k < total) {
            def v:VlJson (VlExprEval.eval((itemAt node.children k) scope))
            def d:double (v.asDouble())
            if (! have) {
                best = d
                have = true
            } {
                if wantMax {
                    if (d > best) {
                        best = d
                    }
                } {
                    if (d < best) {
                        best = d
                    }
                }
            }
            k = (k + 1)
        }
        if (! have) {
            return (VlJson.nullValue())
        }
        return (VlJson.numberValue(best))
    }

    ; A double is NaN when it does not equal itself, and finite when zeroing it
    ; gives zero — an infinity times zero is NaN, which fails the comparison.
    ; The Ranger operator set has no isnan/isfinite, and both identities hold on
    ; every target that uses IEEE doubles.
    sfn isNaN:boolean (v:double) {
        return (v != v)
    }

    sfn isFiniteNumber:boolean (v:double) {
        def zeroed:double (v * 0.0)
        return (zeroed == 0.0)
    }

    ; d3-format, only as far as the specs here need: an empty specifier prints
    ; the shortest decimal, and `.<n>f` fixes the decimals. Anything else falls
    ; back to the empty behaviour rather than pretending to support it.
    ; `format(value, spec)` — the specification's own number formatting, which
    ; is d3's specifier grammar and not a keyword. VlFormat reads it.
    sfn formatNumber:string (value:double spec:string) {
        return (VlFormat.apply(value spec))
    }

    sfn fixedDecimals:string (value:double digits:int) {
        def text:string (VlJson.formatNumber(value digits))
        if (digits <= 0) {
            return text
        }
        def dot:int -1
        def n:int (strlen text)
        def k:int 0
        while (k < n) {
            if ((substring text k (k + 1)) == ".") {
                dot = k
            }
            k = (k + 1)
        }
        if (dot < 0) {
            def pad:string "."
            def p:int 0
            while (p < digits) {
                pad = (pad + "0")
                p = (p + 1)
            }
            return (text + pad)
        }
        def have:int ((n - dot) - 1)
        def out:string text
        def q:int have
        while (q < digits) {
            out = (out + "0")
            q = (q + 1)
        }
        return out
    }
}

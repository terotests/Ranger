; ==============================================================================
; VlCompile.rgr — Vega-Lite in, Vega out.
; ==============================================================================
; Vela runs Vega. Vega-Lite is the shorthand nearly everyone actually writes,
; and turning one into the other was, until this file, the last thing in the
; pipeline still done by the official JavaScript. That mattered less than it
; sounds — it is an authoring step, not a runtime one, the way compiling a .rgr
; to a .cpp is — but it did mean a native binary could RUN any Vega
; specification and not ACCEPT a Vega-Lite one.
;
; What the compiler is, stripped of the vocabulary: a set of decisions about
; defaults. Vega-Lite says "a bar chart of a against b"; Vega needs to be told
; that `a` is a band scale with an inner padding of 0.1, that `b` is stacked
; even though nobody asked for a stack, that the bars are #4c78a8, that the
; y axis gets a grid and the x axis does not, and that a bar is a `rect` whose
; width is `max(0.25, bandwidth('x'))`. Every one of those is a decision the
; reference makes, and this file is those decisions written down.
;
; How it is checked is the important part. The output is NOT compared with the
; official compiler's JSON — two compilers may reach the same chart by different
; specifications, and holding this to the other one's spelling would be testing
; the wrong thing. It is compared by DRAWING it: the same Vega-Lite source goes
; through this compiler into Vela, and through the official compiler into
; official Vega, and the two scenes must agree mark for mark. That is the same
; standard the rest of the runtime is held to, and it is the standard that
; matters — the chart, not the paperwork.
;
; Scope, stated rather than implied. A single view is one mark over one encoding
; block; the four ways a chart can be more than one chart are all built —
; layering, faceting (by row, by column, or wrapped onto a computed grid),
; concatenation, and the box plot, which is a composite mark. What is not built
; is an `errorbar`, an `errorband`, and the top-level `facet` operator; each of
; those refuses out loud rather than drawing something else.
; ==============================================================================

Import "VlJson.rgr"
Import "VlTime.rgr"
Import "VlRegex.rgr"

; One entry of the `encoding` block, read once so the rest of the file asks
; questions of a field rather than of a JSON object.
class VlChannel {
    def name:string ""
    def field:string ""
    ; "quantitative" | "nominal" | "ordinal" | "temporal"
    def kind:string "quantitative"
    def aggregate:string ""
    ; `"aggregate": {"argmax": "US Gross"}` picks the ROW with the largest
    ; value of one column and reads another off it. The op is the key and the
    ; column it ranks by is the value, which is a different column from the
    ; one the channel measures.
    def argField:string ""
    def timeUnit:string ""
    ; The unit spelled out: "yearmonth" is ["year", "month"].
    def timeUnits:[string]
    def hasBin:boolean false
    ; How many bins the binning was asked for. It is part of the NAME the
    ; binned field carries — `bin_maxbins_60_x` — so a spec that asks for
    ; sixty and a spec that asks for the default ten do not collide.
    def maxbins:int 10
    ; The data ARRIVED binned: the field is already a bin's start and another
    ; channel carries its end, so there is nothing to compute and nothing to
    ; rename — only a scale that has to be told where the edges are.
    def binnedAlready:boolean false
    def binStep:double 0.0
    def hasValue:boolean false
    ; The channel states a constant AND names a field inside a condition: the
    ; selected rows are painted by the field, everything else by the constant.
    ; It needs the scale and the key a field-encoded channel has, and it keeps
    ; the constant as what the unselected rows show.
    def conditional:boolean false
    ; `{"datum": "US Gross"}` is a constant that goes THROUGH the scale rather
    ; than round it: every mark in the layer is painted the colour that name
    ; maps to, and the name is one of the scale's categories. It is how a
    ; repeated chart tells its copies apart.
    def hasDatum:boolean false
    def value:VlJson (new VlJson)
    def defined:boolean false
    def stack:string ""
    def def0:VlJson (new VlJson)

    ; Does this channel have anything to say about a mark's paint or size? A
    ; channel written only as a CONDITION —
    ;
    ;   "color": {"condition": {"test": …, "value": "#aaa"}}
    ;
    ; names no field and states no value, so there is nothing to build a scale
    ; from and nothing for a legend to be a key to: the condition decides the
    ; colour and the mark's own default is what shows otherwise. Read as an
    ; encoded channel it produced a scale with no domain, a legend with no
    ; title, and thirty-three pixels of empty page beside the chart.
    fn encodes:boolean () {
        if (! defined) {
            return false
        }
        if hasDatum {
            return true
        }
        if hasValue {
            return conditional
        }
        return ((strlen (this.outField())) > 0)
    }

    ; The name the field carries after the transforms have run: `sum_b` once it
    ; is aggregated, `bin_maxbins_10_b` once it is binned.
    fn outField:string () {
        ; A time unit renames the field it reads: `month` over `date` becomes
        ; `month_date`, which is what the scales, the marks and the axis all
        ; then refer to.
        if ((strlen timeUnit) > 0) {
            if ((strlen aggregate) == 0) {
                return ((timeUnit + "_") + field)
            }
        }
        if ((strlen aggregate) > 0) {
            if (aggregate == "count") {
                return "__count"
            }
            if ((strlen argField) > 0) {
                return ((((aggregate + "_") + argField) + "[\"") + field) + "\"]"
            }
            return ((aggregate + "_") + field)
        }
        if hasBin {
            def prefix:string (this.binPrefix())
            return (prefix + field)
        }
        return field
    }

    ; Binned, however it came to be: computed here or already binned upstream.
    ; A grid is drawn between numbers and a bin's edges ARE its ticks, so an
    ; axis of bins has no grid either way.
    fn isBinned:boolean () {
        return (hasBin || binnedAlready)
    }

    ; A binned field is TWO fields: where the bin starts and where it ends.
    fn binEndField:string () {
        def prefix:string (this.binPrefix())
        return ((prefix + field) + "_end")
    }

    fn binPrefix:string () {
        return (("bin_maxbins_" + (VlJson.intToText(maxbins))) + "_")
    }

    ; The SIGNAL the bin transform publishes its boundaries under. Not the
    ; field name: a signal is an identifier in an expression, and half the
    ; interesting columns in the world are called things like "IMDB Rating".
    ; The field keeps its space; the signal does not get one.
    fn binSignal:string () {
        def prefix:string (this.binPrefix())
        return (prefix + (VlCompile.varName(field)))
    }

    fn isDiscrete:boolean () {
        if (hasBin) {
            return false
        }
        return ((kind == "nominal") || (kind == "ordinal"))
    }

    fn isContinuous:boolean () {
        return (! (this.isDiscrete()))
    }

    ; What the axis and the legend call it: "Sum of b", "b (binned)", "Count of
    ; records" — the reference's own title rules.
    fn title:string () {
        ; A channel may name itself, and the name it gives wins over anything
        ; derived from the field.
        def stated:string (def0.stringOr("title" ""))
        if ((strlen stated) > 0) {
            return stated
        }
        if ((strlen timeUnit) > 0) {
            if ((strlen aggregate) == 0) {
                ; The unit is written as one word and READ as its parts, so an
                ; axis of `yearmonth` is titled "date (year-month)" — the
                ; reference hyphenates it, and a title is a string a person is
                ; meant to read.
                def spelled:string ""
                for timeUnits part:string pi {
                    if (pi > 0) { spelled = (spelled + "-") }
                    spelled = (spelled + part)
                }
                if ((strlen spelled) == 0) { spelled = timeUnit }
                return ((field + " (") + (spelled + ")"))
            }
        }
        if (aggregate == "count") {
            return "Count of Records"
        }
        ; An arg-op is named for what it PICKS, not for the operation: the
        ; budget of the film with the largest gross is "Production Budget for
        ; max US Gross", which reads as the sentence it is.
        if ((strlen argField) > 0) {
            def direction:string "max"
            if (aggregate == "argmin") {
                direction = "min"
            }
            return ((((field + " for ") + direction) + " ") + argField)
        }
        if ((strlen aggregate) > 0) {
            return (((VlChannel.capitalise(aggregate)) + " of ") + field)
        }
        if hasBin {
            return (field + " (binned)")
        }
        return field
    }

    sfn capitalise:string (text:string) {
        if ((strlen text) == 0) {
            return text
        }
        def head:string (substring text 0 1)
        def code:int (charAt head 0)
        if ((code >= 97) && (code <= 122)) {
            head = (strfromcode (code - 32))
        }
        return (head + (substring text 1 (strlen text)))
    }
}

class VlCompile {
    def errors:[string]
    def warnings:[string]
    def channels:[VlChannel]
    def source:VlJson (new VlJson)
    ; The WHOLE specification, as opposed to the piece of it this compiler was
    ; handed. A parameter is declared once and read anywhere — a layered chart
    ; brushes in one layer and paints by the selection in another — and a piece
    ; that only knows its own half of the tree cannot find it. Every child is
    ; given this, so the search is over the chart rather than over the layer.
    def rootSource:VlJson (new VlJson)
    def markName:string "point"
    def markDef:VlJson (new VlJson)
    def stackField:string ""
    def stackOffset:string "zero"
    def dataName:string "source_0"
    ; A layered chart compiles each layer on its own and then merges them, so
    ; each layer needs its own names and has to be told the scale types the
    ; merge settled on — a text label sits on a BAND scale when it is layered
    ; over a bar chart, and on a point scale when it is not.
    def dataLabel:string "data_0"
    def markLabel:string "marks"
    def forcedTypes:[string:string]
    ; A pane of a concatenation names its scales and its own size signal apart
    ; from its neighbours', and shares whichever dimension runs across the join:
    ; panes side by side are all the same height, panes stacked are all the same
    ; width.
    def prefix:string ""
    ; What the two dimensions are called. A chart's own are `width` and
    ; `height`; a pane of a concatenation names the one that varies after
    ; itself; every cell of a trellis is `child_width` by `child_height`.
    def widthSignal:string "width"
    def heightSignal:string "height"
    ; Where this compiler sits in a nest of layers — "" at the top, "0" for the
    ; first layer, "01" for the second layer of the first. It only has to be
    ; unique, and it is what makes it so.
    def layerPath:string ""
    ; Set on the compiler that draws one PANEL of a trellis, so that it does not
    ; try to build the trellis again.
    def insidePanel:boolean false

    ; ------------------------------------------------------------------------
    fn fail:void (msg:string) {
        push errors msg
    }

    ; The whole of a specification, compiled. `compile` is called again for
    ; every layer and every pane, so the things that belong to the CHART rather
    ; than to a piece of it are attached here instead of in there.
    ;
    ; The configuration is one of them. A heat map writes `"config": {"axis":
    ; {"tickBand": "extent"}}` and means it for every axis in the chart; the
    ; reference copies the block into the Vega it emits and lets the runtime
    ; merge it into each axis. Dropping it here left the runtime with no way to
    ; know, and the ticks sat under the cells rather than between them.
    fn compileSpec:VlJson (src:VlJson) {
        def out:VlJson (this.compile(src))
        if (! (out.isObject())) {
            return out
        }
        def cfg:VlJson (src.get("config"))
        if ((cfg.isObject()) && (!(out.has("config")))) {
            out.setMember("config" (VlCompile.vegaConfig(cfg)))
        }
        return out
    }

    sfn viewSizing:boolean (key:string) {
        if (key == "step") { return true }
        if (key == "continuousWidth") { return true }
        if (key == "continuousHeight") { return true }
        if (key == "discreteWidth") { return true }
        if (key == "discreteHeight") { return true }
        return false
    }

    ; The mark types a chart may configure by name. Each is a Vega style with
    ; the same name, which is where the marks that use it look.
    sfn markConfigName:boolean (key:string) {
        if (key == "area") { return true }
        if (key == "bar") { return true }
        if (key == "circle") { return true }
        if (key == "line") { return true }
        if (key == "point") { return true }
        if (key == "rect") { return true }
        if (key == "rule") { return true }
        if (key == "square") { return true }
        if (key == "text") { return true }
        if (key == "tick") { return true }
        if (key == "trail") { return true }
        if (key == "arc") { return true }
        if (key == "image") { return true }
        if (key == "geoshape") { return true }
        return false
    }

    ; A configuration block, in the words Vega uses. Most of it passes straight
    ; through, but `view` is Vega-Lite's name for the plotting rectangle and
    ; Vega's name for it is the `cell` style — so what a chart says about its
    ; view is said again as a style, which is where the runtime looks for it.
    sfn vegaConfig:VlJson (cfg:VlJson) {
        def out (VlJson.objectValue())
        def style:VlJson (cfg.get("style"))
        def styles (VlJson.objectValue())
        if (style.isObject()) {
            for style.keys sk:string ski {
                styles.setMember(sk (style.get(sk)))
            }
        }
        ; Everything a chart says about ONE KIND OF MARK is a style under that
        ; mark's name. `config: {"area": {"interpolate": "monotone"}}` is every
        ; area in the chart drawn as a smooth curve, and written under its own
        ; name nothing looked for it there.
        for cfg.keys k:string ki {
            if (k == "view") {
                ; folded in below
            } {
            if (k == "style") {
                ; already taken
            } {
            if (k == "title") {
                ; A chart's title configuration is the `group-title` style,
                ; which is what a title mark is drawn in. Left under its own
                ; name a chart that asked for a twelve-point heading got the
                ; default thirteen.
                def heading (VlJson.objectValue())
                def before:VlJson (styles.get("group-title"))
                if (before.isObject()) {
                    for before.keys bk:string bki {
                        heading.setMember(bk (before.get(bk)))
                    }
                }
                def stated:VlJson (cfg.get("title"))
                if (stated.isObject()) {
                    for stated.keys tk:string tki {
                        heading.setMember(tk (stated.get(tk)))
                    }
                }
                styles.setMember("group-title" heading)
            } {
            if (VlCompile.markConfigName(k)) {
                def named (VlJson.objectValue())
                def had:VlJson (styles.get(k))
                if (had.isObject()) {
                    for had.keys hk:string hki {
                        named.setMember(hk (had.get(hk)))
                    }
                }
                def given:VlJson (cfg.get(k))
                if (given.isObject()) {
                    for given.keys gk:string gki {
                        named.setMember(gk (given.get(gk)))
                    }
                }
                styles.setMember(k named)
            } {
                out.setMember(k (cfg.get(k)))
            }
            }
            }
            }
        }
        def view:VlJson (cfg.get("view"))
        if (! (view.isObject())) {
            if ((array_length styles.keys) > 0) {
                out.setMember("style" styles)
            }
            return out
        }
        def cell (VlJson.objectValue())
        def existing:VlJson (styles.get("cell"))
        if (existing.isObject()) {
            for existing.keys ek:string eki {
                cell.setMember(ek (existing.get(ek)))
            }
        }
        for view.keys vk:string vki {
            ; …except the ones that are not properties of a rectangle at all.
            ; A view's `step` is how wide one band of a discrete scale is and
            ; its continuous sizes are how big a plot is when nobody said —
            ; sizes the compiler has already used, and which mean nothing to
            ; something drawing a box.
            if (! (VlCompile.viewSizing(vk))) {
                cell.setMember(vk (view.get(vk)))
            }
        }
        styles.setMember("cell" cell)
        out.setMember("style" styles)
        return out
    }

    ; Whether a specification names a facet channel of its own, which is what
    ; makes it a trellis however it is composed inside.
    sfn spansFacet:boolean (src:VlJson) {
        def encoding:VlJson (src.get("encoding"))
        if (! (encoding.isObject())) {
            return false
        }
        if (encoding.has("row")) { return true }
        if (encoding.has("column")) { return true }
        return (encoding.has("facet"))
    }

    fn compile:VlJson (src:VlJson) {
        source = src
        if (! (rootSource.isObject())) {
            rootSource = src
        }
        clear errors
        clear channels

        if (src.has("layer")) {
            ; …unless the whole stack is one panel of a trellis. A facet
            ; channel written above a stack of layers repeats the stack, and
            ; taken the other way round each layer repeated the trellis: five
            ; data sets and five domains all called the same thing, one
            ; silently replacing the next.
            if (! insidePanel) {
                if (VlCompile.spansFacet(src)) {
                    this.readEncoding()
                    return (this.compileFacet(src))
                }
            }
            return (this.compileLayers(src))
        }
        ; A trellis may be written as an OPERATOR — a `facet` block over a
        ; `spec` — rather than as a channel of the encoding. The two mean the
        ; same thing, and the channel form is the one everything below here
        ; understands, so the operator is rewritten into it.
        if (src.has("facet")) {
            if (src.has("spec")) {
                return (this.compile((VlCompile.facetAsChannel(src))))
            }
            this.fail("a top-level facet operator needs a spec to repeat")
        }
        if (src.has("hconcat")) {
            return (this.compileConcat(src "hconcat" true))
        }
        if (src.has("vconcat")) {
            return (this.compileConcat(src "vconcat" false))
        }
        ; `concat` is neither across nor down: it wraps at `columns`, and with
        ; no column count it is a single row.
        if (src.has("concat")) {
            return (this.compileConcat(src "concat" true))
        }
        ; A REPEATED specification is one chart drawn once per name in a list,
        ; with `{"repeat": …}` standing where the column name goes. It is not a
        ; composition of its own: expanded, it IS a layered, concatenated or
        ; gridded chart, and every one of those is already compiled here.
        if (src.has("repeat")) {
            def spread:VlJson (VlCompile.expandRepeat(src))
            if (spread.isObject()) {
                return (this.compile(spread))
            }
            this.fail("a repeated specification needs a `spec` and a list of fields")
        }
        this.readMark()
        this.readEncoding()
        ; A trellis is one chart drawn many times. It is recognised from the
        ; ENCODING rather than from a keyword, which is how Vega-Lite spells it.
        if ((array_length (this.facetFields())) > 0) {
            if (! insidePanel) {
                return (this.compileFacet(src))
            }
        }
        clear channels
        ; A composite mark is not a mark: it is several marks over several
        ; derived data sets, which is why it is expanded rather than encoded.
        if ((markName == "errorbar") || (markName == "errorband")) {
            this.fail(("an " + markName) + " is not compiled here")
        }
        this.readEncoding()





        if ((array_length errors) > 0) {
            return (VlJson.objectValue())
        }
        if (markName == "boxplot") {
            return (this.compileBoxplot(src))
        }
        ; `point: true` on a line is not a property of the line: it is a second
        ; mark drawn over it, which is a layer under another name.
        if ((VlCompile.overlayAsked(markDef "point")) || (VlCompile.overlayAsked(markDef "line"))) {
            return (this.compileLayers((VlCompile.withOverlayLayers(src markDef))))
        }
        this.decideStack()

        def out:VlJson (VlJson.objectValue())
        out.setMember("$schema" (VlJson.stringValue("https://vega.github.io/schema/vega/v6.json")))
        if (src.has("description")) {
            out.setMember("description" (src.get("description")))
        }
        ; The chart's own title, which Vega draws as a block of its own above
        ; the plot rather than as a mark inside it.
        if (src.has("title")) {
            def given:VlJson (src.get("title"))
            def titleBlock (VlJson.objectValue())
            if (given.isString()) {
                titleBlock.setMember("text" given)
            } {
                if (given.isObject()) {
                    for given.keys tk:string tki {
                        titleBlock.setMember(tk (given.get(tk)))
                    }
                }
            }
            if (titleBlock.has("text")) {
                if (! (titleBlock.has("frame"))) {
                    titleBlock.setMember("frame" (VlJson.stringValue("group")))
                }
                out.setMember("title" titleBlock)
            }
        }
        def background:VlJson (src.get("background"))
        if (background.isDefined()) {
            out.setMember("background" background)
        } {
            out.setMember("background" (VlJson.stringValue("white")))
        }
        out.setMember("padding" (VlJson.numberValue(5.0)))

        ; A discrete axis sizes the plot rather than the other way round: the
        ; chart is as wide as its bands need, which is a signal over the band
        ; count, and the spec then carries no width at all.
        def signals:VlJson (VlJson.arrayValue())
        this.sizeAndSignals(out signals)

        ; The frame around a plotting rectangle belongs to a chart with axes.
        ; A pie has none, so it is a plain view and nothing is drawn round it.
        def frame:string "cell"
        if (markName == "arc") {
            frame = "view"
        }
        out.setMember("style" (VlJson.stringValue(frame)))
        out.setMember("data" (this.buildData()))
        if ((signals.count()) > 0) {
            out.setMember("signals" signals)
        }
        out.setMember("marks" (this.withBrushes((this.buildMarks()))))
        out.setMember("scales" (this.buildScales()))
        def axes:VlJson (this.buildAxes())
        if ((axes.count()) > 0) {
            out.setMember("axes" axes)
        }
        def legends:VlJson (this.buildLegends())
        if ((legends.count()) > 0) {
            out.setMember("legends" legends)
        }
        return out
    }

    ; ------------------------------------------------------------- repeat ---
    ; `repeat` names a list and `spec` is drawn once per entry, with every
    ; `{"repeat": "<key>"}` in it replaced by that entry. Which composition the
    ; copies become is what the list is keyed by:
    ;
    ;   {"layer": […]}            one plot, the copies drawn over each other
    ;   {"column": […]}           side by side
    ;   {"row": […]}              stacked
    ;   {"row": …, "column": …}   a grid, rows of columns
    ;   […] with "columns": n     a wrapped grid of the same shape
    sfn expandRepeat:VlJson (src:VlJson) {
        def spec:VlJson (src.get("spec"))
        if (! (spec.isObject())) {
            return (VlJson.nullValue())
        }
        def repeat:VlJson (src.get("repeat"))
        def out (VlJson.objectValue())
        for src.keys key:string ki {
            if ((key != "repeat") && (key != "spec")) {
                out.setMember(key (src.get(key)))
            }
        }
        ; A plain list of names is a WRAPPED concatenation: one flat row of
        ; panes that folds at `columns`, which the concatenation itself knows
        ; how to do. Built as rows of rows instead, the outer list inherited
        ; the column count meant for the inner one and the grid came out on
        ; its side.
        if (repeat.isArray()) {
            out.setMember("concat" (VlCompile.repeatRow(spec repeat "repeat")))
            VlCompile.alignRepeat(out)
            return out
        }
        if (! (repeat.isObject())) {
            return (VlJson.nullValue())
        }
        if (repeat.has("layer")) {
            out.setMember("layer" (VlCompile.repeatRow(spec (repeat.get("layer")) "layer")))
            return out
        }
        def rows:VlJson (repeat.get("row"))
        def cols:VlJson (repeat.get("column"))
        if ((rows.isArray()) && (cols.isArray())) {
            def stacked (VlJson.arrayValue())
            def r:int 0
            while (r < (rows.count())) {
                def band (VlJson.objectValue())
                def acrossOne (VlJson.arrayValue())
                def c:int 0
                while (c < (cols.count())) {
                    def cell:VlJson (VlCompile.substituteRepeat(spec "row" (rows.at(r).asString())))
                    cell = (VlCompile.substituteRepeat(cell "column" (cols.at(c).asString())))
                    push acrossOne.arr cell
                    c = (c + 1)
                }
                band.setMember("hconcat" acrossOne)
                push stacked.arr band
                r = (r + 1)
            }
            out.setMember("vconcat" stacked)
            return out
        }
        if (rows.isArray()) {
            out.setMember("vconcat" (VlCompile.repeatRow(spec rows "row")))
            VlCompile.alignRepeat(out)
            return out
        }
        if (cols.isArray()) {
            out.setMember("hconcat" (VlCompile.repeatRow(spec cols "column")))
            VlCompile.alignRepeat(out)
            return out
        }
        return (VlJson.nullValue())
    }

    ; A repeated grid lines its copies up on one pitch unless the
    ; specification asked for something else.
    sfn alignRepeat:void (out:VlJson) {
        if (out.has("align")) {
            return
        }
        out.setMember("align" (VlJson.stringValue("all")))
    }

    sfn repeatRow:VlJson (spec:VlJson values:VlJson key:string) {
        def out (VlJson.arrayValue())
        def k:int 0
        while (k < (values.count())) {
            push out.arr (VlCompile.substituteRepeat(spec key (values.at(k).asString())))
            k = (k + 1)
        }
        return out
    }

    ; A wrapped grid: as many panes across as `columns` allows, then a new row.
    sfn repeatGrid:VlJson (spec:VlJson values:VlJson key:string wide:int) {
        def out (VlJson.arrayValue())
        def total:int (values.count())
        def k:int 0
        while (k < total) {
            def band (VlJson.objectValue())
            def across (VlJson.arrayValue())
            def c:int 0
            while ((c < wide) && (k < total)) {
                push across.arr (VlCompile.substituteRepeat(spec key (values.at(k).asString())))
                k = (k + 1)
                c = (c + 1)
            }
            band.setMember("hconcat" across)
            push out.arr band
        }
        return out
    }

    ; Every `{"repeat": key}` in the tree, replaced by the name it stands for.
    ; An object with nothing else in it IS the placeholder; one that has other
    ; members is a channel definition that happens to contain one.
    sfn substituteRepeat:VlJson (node:VlJson key:string value:string) {
        if (node.isArray()) {
            def list (VlJson.arrayValue())
            def k:int 0
            while (k < (node.count())) {
                push list.arr (VlCompile.substituteRepeat((node.at(k)) key value))
                k = (k + 1)
            }
            return list
        }
        if (! (node.isObject())) {
            return node
        }
        if (node.has("repeat")) {
            if ((array_length node.keys) == 1) {
                if ((node.stringOr("repeat" "")) == key) {
                    return (VlJson.stringValue(value))
                }
                return node
            }
        }
        def out (VlJson.objectValue())
        for node.keys k2:string ki2 {
            out.setMember(k2 (VlCompile.substituteRepeat((node.get(k2)) key value)))
        }
        return out
    }

    ; --------------------------------------------------------------- layers ---
    ; Several marks over one pair of axes. Each layer is a whole chart on its
    ; own — its own data pipeline, its own marks, its own idea of what its
    ; scales should be — so each is compiled by its own compiler and the
    ; results are merged.
    ;
    ; The merge is not a concatenation. Two things have to be decided ACROSS the
    ; layers before any of them can be compiled: what type each shared scale is,
    ; and what its domain covers. A label layered over bars sits on the bars'
    ; BAND scale, and on its own it would have asked for a point scale — so the
    ; types are settled first, in a pass that reads the marks and encodings and
    ; nothing else, and handed to every layer before it compiles.
    fn compileLayers:VlJson (src:VlJson) {
        def layers:VlJson (src.get("layer"))
        if (! (layers.isArray())) {
            this.fail("layer is not an array")
            return (VlJson.objectValue())
        }
        def total:int (layers.count())

        ; A band anywhere makes the shared scale a band: a mark that fills its
        ; band needs one, and a mark that does not is happy to sit on it.
        def bandX:boolean false
        def bandY:boolean false
        def probeIndex:int 0
        while (probeIndex < total) {
            def probe (new VlCompile())
            probe.rootSource = rootSource
            probe.source = (VlCompile.mergeSpec(src (layers.at(probeIndex))))
            probe.readMark()
            probe.readEncoding()
            for probe.channels ch:VlChannel ci {
                if ((probe.scaleTypeFor(ch)) == "band") {
                    if (ch.name == "x") {
                        bandX = true
                    }
                    if (ch.name == "y") {
                        bandY = true
                    }
                }
            }
            probeIndex = (probeIndex + 1)
        }

        def out (VlJson.objectValue())
        def data (VlJson.arrayValue())
        def marks (VlJson.arrayValue())
        def scales (VlJson.arrayValue())
        def scaleNames:[string]
        def domains:[string:VlJson]
        def signals (VlJson.arrayValue())
        def signalNames:[string:int]
        def axes (VlJson.arrayValue())
        def sourceText:[string]
        def axisKeys:[string:int]
        def legends (VlJson.arrayValue())
        def legendNames:[string:int]
        def titles:[string:string]
        def askedTitles:[string:string]
        def first:boolean true

        def index:int 0
        while (index < total) {
            def child (new VlCompile())
            child.rootSource = rootSource
            ; A layer inside a layer names its data and its marks after the
            ; whole path down to it. Named after its own index alone, the
            ; second layer of the first layer and the second layer of the chart
            ; were both "data_1", and one silently replaced the other.
            child.layerPath = (layerPath + (VlJson.intToText(index)))
            ; Where the layered chart itself sits: a pane of a concatenation
            ; names its scales, its data and its size after the pane. A layer
            ; that did not inherit that named its scales `x` and `y` like every
            ; other pane's, and asked for a width signal nothing defined —
            ; three plots on top of each other, all one default wide.
            child.prefix = prefix
            child.widthSignal = widthSignal
            child.heightSignal = heightSignal
            child.insidePanel = insidePanel
            child.dataLabel = ((prefix + "data_") + child.layerPath)
            child.markLabel = (((prefix + "layer_") + child.layerPath) + "_marks")
            if bandX {
                set child.forcedTypes "x" "band"
            }
            if bandY {
                set child.forcedTypes "y" "band"
            }
            def piece:VlJson (child.compile((VlCompile.mergeSpec(src (layers.at(index))))))
            for child.errors e:string ei {
                this.fail(e)
            }
            if ((array_length child.errors) == 0) {
                for (this.independentChannels()) apart:string ai {
                    def own:string ((("layer_" + (VlJson.intToText(index))) + "_") + apart)
                    VlCompile.renameOneScale((piece.get("scales")) (this.sname(apart)) own)
                    VlCompile.renameOneScale((piece.get("marks")) (this.sname(apart)) own)
                    VlCompile.renameOneScale((piece.get("axes")) (this.sname(apart)) own)
                    VlCompile.renameOneScale((piece.get("legends")) (this.sname(apart)) own)
                    ; The second of two axes measuring different things up the
                    ; same plot stands on the OTHER side of it — that is what
                    ; makes a dual-axis chart readable — and it rules no grid,
                    ; because the plot already has one from the first.
                    if (index > 0) {
                        VlCompile.sideAxes((piece.get("axes")) own apart)
                    }
                }
                if first {
                    ; Everything the chart is as a whole — its size, its
                    ; background, its frame — belongs to the first layer, which
                    ; is the one whose axes and titles the reference keeps.
                    for piece.keys key:string ki {
                        if ((((((key == "data") || (key == "marks")) || (key == "scales")) || (key == "signals")) || (key == "axes")) || (key == "legends")) {
                            ; merged below
                        } {
                            out.setMember(key (piece.get(key)))
                        }
                    }
                    def pieceData:VlJson (piece.get("data"))
                    push data.arr (pieceData.at(0))
                    push sourceText (VlCompile.sourceKey((pieceData.at(0))))
                    first = false
                } {
                    ; A layer may bring its OWN data — an annotation drawn over
                    ; a chart of something else — and that is a second source,
                    ; not a second copy of the first. Dropped, the layer read
                    ; the rows below it and drew the wrong thing; kept under
                    ; the same name it replaced them.
                    def ownData:VlJson (piece.get("data"))
                    def own:VlJson (ownData.at(0))
                    def key:string (VlCompile.sourceKey(own))
                    def at:int -1
                    def si:int 0
                    while (si < (array_length sourceText)) {
                        if ((itemAt sourceText si) == key) {
                            at = si
                        }
                        si = (si + 1)
                    }
                    if (at < 0) {
                        at = (array_length sourceText)
                        push sourceText key
                        own.setMember("name" (VlJson.stringValue(("source_" + (VlJson.intToText(at))))))
                        push data.arr own
                    }
                    def renamed:string ("source_" + (VlJson.intToText(at)))
                    VlCompile.renameSource(ownData renamed)
                    ; …and the marks that read it. A layer whose data needs no
                    ; transforming reads the source itself, so renaming only
                    ; the data sets left the marks pointing at the layer below.
                    VlCompile.renameSourceRefs((piece.get("marks")) renamed)
                }
                ; An axis belongs to a SCALE, and the scales are shared down
                ; the stack, so a layer that reads a column the one below it
                ; did not still needs an axis for it. Keeping the first layer's
                ; axes alone, a chart whose first layer is a band of shaded
                ; years and whose second is the line through them was drawn
                ; with no vertical axis at all.
                VlCompile.mergeAxes(axes axisKeys (piece.get("axes")))
                def pieceData2:VlJson (piece.get("data"))
                def di:int 1
                while (di < (pieceData2.count())) {
                    push data.arr (pieceData2.at(di))
                    di = (di + 1)
                }
                def pieceMarks:VlJson (piece.get("marks"))
                def mi:int 0
                while (mi < (pieceMarks.count())) {
                    push marks.arr (pieceMarks.at(mi))
                    mi = (mi + 1)
                }
                VlCompile.mergeSignals(signals signalNames (piece.get("signals")))
                VlCompile.mergeScales(scales scaleNames domains (piece.get("scales")))
                VlCompile.mergeLegends(legends legendNames (piece.get("legends")))
                ; Titles come from layers that STATED one. A layer that merely
                ; happens to read another column contributes its field name to
                ; nothing: the reference emits one axis per scale, the first
                ; layer's, and a chart of `previous_sum` and `sum` is titled
                ; "Amount" and not "Amount, sum, center".
                ; What the LAYER states includes what it inherited: a chart
                ; that names its y axis once, in the shared encoding, has named
                ; it for every layer. Read from the layer alone, nothing was
                ; stated anywhere and the axis was titled after both columns.
                VlCompile.collectAxisTitles(titles askedTitles (piece.get("axes")) (VlCompile.statedTitles((VlCompile.mergeSpec(src (layers.at(index)))))))
            }
            index = (index + 1)
        }
        VlCompile.applyMergedDomains(scales scaleNames domains)
        ; A grid runs across the OTHER scale, and which other scale there is
        ; may only become clear once every layer has been compiled: a chart
        ; whose lower layer is a band of shaded years learns about its vertical
        ; scale from the line drawn over it.
        VlCompile.crossGrids(axes)
        VlCompile.mergeAxisTitles(axes titles askedTitles)
        this.resizeAcrossLayers(out src layers bandX bandY)

        out.setMember("data" data)
        if ((signals.count()) > 0) {
            out.setMember("signals" signals)
        }
        out.setMember("marks" marks)
        out.setMember("scales" scales)
        if ((axes.count()) > 0) {
            out.setMember("axes" axes)
        }
        if ((legends.count()) > 0) {
            out.setMember("legends" legends)
        }
        return out
    }


    ; ---------------------------------------------------------------- boxplot ---
    ; A box plot is not a mark: it is five marks over eight derived data sets,
    ; and Vega-Lite calls that a COMPOSITE mark. Written as a layered
    ; specification it would be unreadable, and it would still need the exact
    ; quartile pipeline below, so it is expanded here instead — the same thing
    ; the reference does, and for the same reason.
    ;
    ; The pipeline is the interesting half. Quartiles are computed twice, over
    ; different rows and for different purposes: once JOINED BACK onto every row
    ; so that each row can be compared with its own group's hinges — which is
    ; what decides whether it is an outlier — and once as an aggregate, which is
    ; what the box is drawn from. The whiskers are then the extremes of the rows
    ; that survived the outlier test, which is why they stop at real data rather
    ; than at a computed fence.
    fn compileBoxplot:VlJson (src:VlJson) {
        def x:VlChannel (this.channel("x"))
        def y:VlChannel (this.channel("y"))
        if (! (x.defined)) {
            this.fail("a box plot needs an x and a y channel")
            return (VlJson.objectValue())
        }
        if (! (y.defined)) {
            this.fail("a box plot needs an x and a y channel")
            return (VlJson.objectValue())
        }
        if (! ((x.isDiscrete()) && (y.isContinuous()))) {
            this.fail("only a vertical box plot over a discrete axis is compiled here")
            return (VlJson.objectValue())
        }
        def dim:string x.field
        def f:string y.field
        def lower:string ("lower_box_" + f)
        def upper:string ("upper_box_" + f)
        def mid:string ("mid_box_" + f)
        def lowWhisker:string ("lower_whisker_" + f)
        def highWhisker:string ("upper_whisker_" + f)
        def minF:string ("min_" + f)
        def maxF:string ("max_" + f)

        def out (VlJson.objectValue())
        out.setMember("$schema" (VlJson.stringValue("https://vega.github.io/schema/vega/v6.json")))
        out.setMember("background" (VlJson.stringValue("white")))
        out.setMember("padding" (VlJson.numberValue(5.0)))
        def heightGiven:VlJson (src.get("height"))
        if (heightGiven.isNumber()) {
            out.setMember("height" heightGiven)
        } {
            out.setMember("height" (VlJson.numberValue(300.0)))
        }
        out.setMember("style" (VlJson.stringValue("cell")))

        ; --- the eight data sets ---
        def data (VlJson.arrayValue())
        def source (VlJson.objectValue())
        source.setMember("name" (VlJson.stringValue("source_0")))
        def srcData:VlJson (src.get("data"))
        if (srcData.has("values")) {
            source.setMember("values" (srcData.get("values")))
        }
        push data.arr source

        ; Every row, told its own group's quartiles.
        def d1 (VlJson.objectValue())
        d1.setMember("name" (VlJson.stringValue("data_1")))
        d1.setMember("source" (VlJson.stringValue("source_0")))
        def t1 (VlJson.arrayValue())
        def join (VlJson.objectValue())
        join.setMember("type" (VlJson.stringValue("joinaggregate")))
        join.setMember("as" (VlCompile.stringList2(lower upper)))
        join.setMember("ops" (VlCompile.stringList2("q1" "q3")))
        join.setMember("fields" (VlCompile.stringList2(f f)))
        join.setMember("groupby" (VlCompile.stringList1(dim)))
        push t1.arr join
        d1.setMember("transform" t1)
        push data.arr d1

        def fence:string (VlCompile.fenceExpr(f lower upper))
        def inside:string (VlCompile.insideExpr(f lower upper))
        ; `"extent": "min-max"` asks for whiskers that reach the smallest and
        ; largest values there are, which is the same pipeline with the fence
        ; moved out to infinity: nothing is an outlier, and every row counts
        ; towards a whisker. Ignored, the chart drew Tukey's fences instead and
        ; scattered the extremes as dots.
        if ((markDef.stringOr("extent" "")) == "min-max") {
            fence = "false"
            inside = "true"
        }

        ; The rows outside the fence: drawn as points.
        def d2 (VlJson.objectValue())
        d2.setMember("name" (VlJson.stringValue("data_2")))
        d2.setMember("source" (VlJson.stringValue("data_1")))
        def t2 (VlJson.arrayValue())
        push t2.arr (VlCompile.filterOf(fence))
        push t2.arr (VlCompile.filterOf((VlCompile.validExpr(f))))
        d2.setMember("transform" t2)
        push data.arr d2

        ; The rows inside it, reduced to the ends of the whiskers.
        def d3 (VlJson.objectValue())
        d3.setMember("name" (VlJson.stringValue("data_3")))
        d3.setMember("source" (VlJson.stringValue("data_1")))
        def t3 (VlJson.arrayValue())
        push t3.arr (VlCompile.filterOf(inside))
        def agg (VlJson.objectValue())
        agg.setMember("type" (VlJson.stringValue("aggregate")))
        agg.setMember("groupby" (VlCompile.stringList1(dim)))
        agg.setMember("ops" (VlCompile.stringList4("min" "max" "min" "max")))
        agg.setMember("fields" (VlCompile.stringList4(f f lower upper)))
        agg.setMember("as" (VlCompile.stringList4(lowWhisker highWhisker lower upper)))
        push t3.arr agg
        d3.setMember("transform" t3)
        push data.arr d3

        push data.arr (VlCompile.filteredData("data_4" "data_3" (VlCompile.validExpr(lowWhisker))))
        push data.arr (VlCompile.filteredData("data_5" "data_3" (VlCompile.validExpr(upper))))

        ; The box itself, from the whole group rather than from the survivors.
        def d6 (VlJson.objectValue())
        d6.setMember("name" (VlJson.stringValue("data_6")))
        d6.setMember("source" (VlJson.stringValue("source_0")))
        def t6 (VlJson.arrayValue())
        def agg6 (VlJson.objectValue())
        agg6.setMember("type" (VlJson.stringValue("aggregate")))
        agg6.setMember("groupby" (VlCompile.stringList1(dim)))
        agg6.setMember("ops" (VlCompile.stringList5("q1" "q3" "median" "min" "max")))
        agg6.setMember("fields" (VlCompile.stringList5(f f f f f)))
        agg6.setMember("as" (VlCompile.stringList5(lower upper mid minF maxF)))
        push t6.arr agg6
        d6.setMember("transform" t6)
        push data.arr d6

        push data.arr (VlCompile.filteredData("data_7" "data_6" (VlCompile.validExpr(lower))))
        push data.arr (VlCompile.filteredData("data_8" "data_6" (VlCompile.validExpr(mid))))
        out.setMember("data" data)

        ; --- the signals: the band decides how wide the chart is ---
        def signals (VlJson.arrayValue())
        def step (VlJson.objectValue())
        step.setMember("name" (VlJson.stringValue("x_step")))
        step.setMember("value" (VlJson.numberValue(20.0)))
        push signals.arr step
        def width (VlJson.objectValue())
        width.setMember("name" (VlJson.stringValue("width")))
        width.setMember("update" (VlJson.stringValue("bandspace(domain('x').length, 0, 0) * x_step")))
        push signals.arr width
        out.setMember("signals" signals)

        ; --- the marks, in the order they are drawn ---
        def marks (VlJson.arrayValue())
        def whiskerTip:VlJson (VlCompile.tooltipOf2(("Upper Whisker of " + f) highWhisker ("Lower Whisker of " + f) lowWhisker dim))
        def boxTip:VlJson (VlCompile.boxTooltip(f maxF upper mid lower minF dim))

        ; A colour channel paints the outliers, the boxes and a flat median;
        ; the whiskers stay black, which is the reference's choice and not an
        ; oversight — a whisker is a measurement, not a category.
        def colourCh:VlChannel (this.channel("color"))
        def colourField:string ""
        if (colourCh.defined) {
            if (! colourCh.hasValue) {
                colourField = colourCh.field
            }
        }

        push marks.arr (VlCompile.outlierMark(dim f (this.describeExpr()) colourField))
        push marks.arr (VlCompile.whiskerMark("layer_0_layer_1_layer_0_marks" "data_4" dim lowWhisker lower whiskerTip))
        push marks.arr (VlCompile.whiskerMark("layer_0_layer_1_layer_1_marks" "data_5" dim upper highWhisker whiskerTip))
        push marks.arr (VlCompile.boxMark(dim lower upper boxTip (VlCompile.boxDescription(dim f upper maxF mid lower minF)) colourField))
        push marks.arr (VlCompile.medianMark(dim mid lower upper boxTip colourField))
        out.setMember("marks" marks)

        ; --- the scales: every drawn data set contributes to the domain ---
        def scales (VlJson.arrayValue())
        def xs (VlJson.objectValue())
        xs.setMember("name" (VlJson.stringValue("x")))
        xs.setMember("type" (VlJson.stringValue("band")))
        def xDomain (VlJson.objectValue())
        def xFields (VlJson.arrayValue())
        push xFields.arr (VlCompile.domainEntry("data_2" dim))
        push xFields.arr (VlCompile.domainEntry("data_4" dim))
        push xFields.arr (VlCompile.domainEntry("data_5" dim))
        push xFields.arr (VlCompile.domainEntry("data_7" dim))
        push xFields.arr (VlCompile.domainEntry("data_8" dim))
        xDomain.setMember("fields" xFields)
        xDomain.setMember("sort" (VlJson.boolValue(true)))
        xs.setMember("domain" xDomain)
        def xRange (VlJson.objectValue())
        def xStep (VlJson.objectValue())
        xStep.setMember("signal" (VlJson.stringValue("x_step")))
        xRange.setMember("step" xStep)
        xs.setMember("range" xRange)
        xs.setMember("paddingInner" (VlJson.numberValue(0.0)))
        xs.setMember("paddingOuter" (VlJson.numberValue(0.0)))
        push scales.arr xs

        def ys (VlJson.objectValue())
        ys.setMember("name" (VlJson.stringValue("y")))
        ys.setMember("type" (VlJson.stringValue("linear")))
        def yDomain (VlJson.objectValue())
        def yFields (VlJson.arrayValue())
        push yFields.arr (VlCompile.domainEntry("data_2" f))
        push yFields.arr (VlCompile.domainEntry("data_4" lowWhisker))
        push yFields.arr (VlCompile.domainEntry("data_4" lower))
        push yFields.arr (VlCompile.domainEntry("data_5" upper))
        push yFields.arr (VlCompile.domainEntry("data_5" highWhisker))
        push yFields.arr (VlCompile.domainEntry("data_7" lower))
        push yFields.arr (VlCompile.domainEntry("data_7" upper))
        push yFields.arr (VlCompile.domainEntry("data_8" mid))
        yDomain.setMember("fields" yFields)
        ys.setMember("domain" yDomain)
        ys.setMember("range" (this.positionRange("y")))
        ys.setMember("nice" (VlJson.boolValue(true)))
        ; A box plot's value axis reaches zero unless the specification says
        ; otherwise, and saying otherwise is the usual thing to say: a box of
        ; penguin masses between three and six kilograms drawn from zero is
        ; three boxes squeezed into the top half of the plot.
        def boxZero:boolean true
        def boxScale:VlJson (y.def0.get("scale"))
        if (boxScale.isObject()) {
            def boxZeroDef:VlJson (boxScale.get("zero"))
            if (boxZeroDef.isBool()) {
                boxZero = boxZeroDef.b
            }
        }
        ys.setMember("zero" (VlJson.boolValue(boxZero)))
        push scales.arr ys
        ; Only the three data sets that are actually painted contribute to the
        ; colour domain — the whiskers are black, so their rows have no say in
        ; which category gets which colour.
        if ((strlen colourField) > 0) {
            def cs (VlJson.objectValue())
            cs.setMember("name" (VlJson.stringValue("color")))
            cs.setMember("type" (VlJson.stringValue("ordinal")))
            def cDomain (VlJson.objectValue())
            def cFields (VlJson.arrayValue())
            push cFields.arr (VlCompile.domainEntry("data_2" colourField))
            push cFields.arr (VlCompile.domainEntry("data_7" colourField))
            push cFields.arr (VlCompile.domainEntry("data_8" colourField))
            cDomain.setMember("fields" cFields)
            cDomain.setMember("sort" (VlJson.boolValue(true)))
            cs.setMember("domain" cDomain)
            cs.setMember("range" (VlJson.stringValue("category")))
            push scales.arr cs
        }
        out.setMember("scales" scales)

        ; --- the axes: the same three any chart of this shape carries ---
        def axes (VlJson.arrayValue())
        push axes.arr (this.gridAxis("y" "left" false "x"))
        def xAxis:VlJson (this.labelAxis(x "x" "bottom"))
        push axes.arr xAxis
        push axes.arr (this.labelAxis(y "y" "left"))
        out.setMember("axes" axes)
        def boxLegends:VlJson (this.buildLegends())
        if ((boxLegends.count()) > 0) {
            out.setMember("legends" boxLegends)
        }
        return out
    }

    ; --- the small pieces a box plot is written out of -----------------------
    sfn stringList1:VlJson (a:string) {
        def out (VlJson.arrayValue())
        push out.arr (VlJson.stringValue(a))
        return out
    }
    sfn stringList2:VlJson (a:string b:string) {
        def out (VlJson.arrayValue())
        push out.arr (VlJson.stringValue(a))
        push out.arr (VlJson.stringValue(b))
        return out
    }
    sfn stringList4:VlJson (a:string b:string c:string d:string) {
        def out (VlJson.arrayValue())
        push out.arr (VlJson.stringValue(a))
        push out.arr (VlJson.stringValue(b))
        push out.arr (VlJson.stringValue(c))
        push out.arr (VlJson.stringValue(d))
        return out
    }
    sfn stringList5:VlJson (a:string b:string c:string d:string e:string) {
        def out (VlJson.arrayValue())
        push out.arr (VlJson.stringValue(a))
        push out.arr (VlJson.stringValue(b))
        push out.arr (VlJson.stringValue(c))
        push out.arr (VlJson.stringValue(d))
        push out.arr (VlJson.stringValue(e))
        return out
    }
    sfn filterOf:VlJson (expr:string) {
        def out (VlJson.objectValue())
        out.setMember("type" (VlJson.stringValue("filter")))
        out.setMember("expr" (VlJson.stringValue(expr)))
        return out
    }
    sfn filteredData:VlJson (name:string from:string expr:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue(name)))
        out.setMember("source" (VlJson.stringValue(from)))
        def transform (VlJson.arrayValue())
        push transform.arr (VlCompile.filterOf(expr))
        out.setMember("transform" transform)
        return out
    }
    sfn domainEntry:VlJson (data:string field:string) {
        def out (VlJson.objectValue())
        out.setMember("data" (VlJson.stringValue(data)))
        out.setMember("field" (VlJson.stringValue(field)))
        return out
    }

    ; One and a half inter-quartile ranges past the hinges, which is Tukey's
    ; fence and the reference's default.
    sfn spread:string (lower:string upper:string) {
        return (((("1.5 * (datum['" + upper) + "'] - datum['") + lower) + "'])")
    }
    sfn fenceExpr:string (f:string lower:string upper:string) {
        def gap:string (VlCompile.spread(lower upper))
        def out:string (("(datum['" + f) + "'] < datum['")
        out = (((out + lower) + "'] - ") + gap)
        out = ((((out + ") || (datum['") + f) + "'] > datum['") + upper)
        out = (((out + "'] + ") + gap) + ")")
        return out
    }
    sfn insideExpr:string (f:string lower:string upper:string) {
        def gap:string (VlCompile.spread(lower upper))
        def out:string (("(datum['" + lower) + "'] - ")
        out = ((((out + gap) + " <= datum['") + f) + "']) && (datum['")
        out = ((((out + f) + "'] <= datum['") + upper) + "'] + ")
        out = ((out + gap) + ")")
        return out
    }

    ; A tooltip is an object literal in an expression, and the fields are listed
    ; in the order the reference lists them: the top of the scale first.
    sfn tipNumber:string (label:string field:string) {
        return (((("\"" + label) + "\": format(") + (VlCompile.datumRef(field))) + ", \"\")")
    }
    sfn tipCategory:string (field:string) {
        def out:string (("\"" + field) + "\": isValid(datum[\"")
        out = ((out + field) + "\"]) ? isArray(datum[\"")
        out = ((out + field) + "\"]) ? join(datum[\"")
        out = ((out + field) + "\"], '\\n') : datum[\"")
        out = ((out + field) + "\"] : \"\"+datum[\"")
        out = ((out + field) + "\"]")
        return out
    }
    sfn tooltipOf2:VlJson (l1:string f1:string l2:string f2:string dim:string) {
        def out:string "{"
        out = ((out + (VlCompile.tipNumber(l1 f1))) + ", ")
        out = ((out + (VlCompile.tipNumber(l2 f2))) + ", ")
        out = ((out + (VlCompile.tipCategory(dim))) + "}")
        return (VlCompile.signalRef(out))
    }
    sfn boxTooltip:VlJson (f:string maxF:string upper:string mid:string lower:string minF:string dim:string) {
        def out:string "{"
        out = ((out + (VlCompile.tipNumber(("Max of " + f) maxF))) + ", ")
        out = ((out + (VlCompile.tipNumber(("Q3 of " + f) upper))) + ", ")
        out = ((out + (VlCompile.tipNumber(("Median of " + f) mid))) + ", ")
        out = ((out + (VlCompile.tipNumber(("Q1 of " + f) lower))) + ", ")
        out = ((out + (VlCompile.tipNumber(("Min of " + f) minF))) + ", ")
        out = ((out + (VlCompile.tipCategory(dim))) + "}")
        return (VlCompile.signalRef(out))
    }
    sfn boxDescription:VlJson (dim:string f:string upper:string maxF:string mid:string lower:string minF:string) {
        def out:string ("\"" + dim)
        out = ((out + ": \" + ") + (VlCompile.describeOne(dim true)))
        out = (((out + " + \"; ") + f) + ": \" + ") + (VlCompile.describeOne(lower false))
        out = (((out + " + \"; ") + upper) + ": \" + ") + (VlCompile.describeOne(upper false))
        out = (((out + " + \"; Max of ") + f) + ": \" + ") + (VlCompile.describeOne(maxF false))
        out = (((out + " + \"; Q3 of ") + f) + ": \" + ") + (VlCompile.describeOne(upper false))
        out = (((out + " + \"; Median of ") + f) + ": \" + ") + (VlCompile.describeOne(mid false))
        out = (((out + " + \"; Q1 of ") + f) + ": \" + ") + (VlCompile.describeOne(lower false))
        out = (((out + " + \"; Min of ") + f) + ": \" + ") + (VlCompile.describeOne(minF false))
        return (VlCompile.signalRef(out))
    }

    sfn bandCentre:VlJson (field:string) {
        def out (VlJson.objectValue())
        out.setMember("scale" (VlJson.stringValue("x")))
        out.setMember("field" (VlJson.stringValue(field)))
        out.setMember("band" (VlJson.numberValue(0.5)))
        return out
    }
    sfn yAt:VlJson (field:string) {
        def out (VlJson.objectValue())
        out.setMember("scale" (VlJson.stringValue("y")))
        out.setMember("field" (VlJson.stringValue(field)))
        return out
    }
    sfn styledMark:VlJson (name:string type:string style1:string style2:string from:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue(name)))
        out.setMember("type" (VlJson.stringValue(type)))
        def style (VlJson.arrayValue())
        push style.arr (VlJson.stringValue(style1))
        push style.arr (VlJson.stringValue(style2))
        out.setMember("style" style)
        def source (VlJson.objectValue())
        source.setMember("data" (VlJson.stringValue(from)))
        out.setMember("from" source)
        return out
    }
    sfn finishMark:void (mark:VlJson update:VlJson) {
        def encode (VlJson.objectValue())
        encode.setMember("update" update)
        mark.setMember("encode" encode)
    }

    ; The paint a box plot's three coloured marks carry: a colour channel makes
    ; it a lookup on the colour scale, and without one every box is the first
    ; category colour. An outlier is drawn as an OUTLINE, so the same channel
    ; reaches it as a stroke rather than as a fill.
    sfn boxPaint:VlJson (colourField:string) {
        if ((strlen colourField) == 0) {
            return (VlCompile.literal((VlJson.stringValue("#4c78a8"))))
        }
        def out (VlJson.objectValue())
        out.setMember("scale" (VlJson.stringValue("color")))
        out.setMember("field" (VlJson.stringValue(colourField)))
        return out
    }

    sfn outlierMark:VlJson (dim:string f:string description:string colourField:string) {
        def out:VlJson (VlCompile.styledMark("layer_0_layer_0_marks" "symbol" "point" "boxplot-outliers" "data_2"))
        def update (VlJson.objectValue())
        update.setMember("opacity" (VlCompile.literal((VlJson.numberValue(0.7)))))
        update.setMember("fill" (VlCompile.literal((VlJson.stringValue("transparent")))))
        update.setMember("stroke" (VlCompile.boxPaint(colourField)))
        update.setMember("ariaRoleDescription" (VlCompile.literal((VlJson.stringValue("point")))))
        update.setMember("description" (VlCompile.signalRef(description)))
        update.setMember("x" (VlCompile.bandCentre(dim)))
        update.setMember("y" (VlCompile.yAt(f)))
        VlCompile.finishMark(out update)
        return out
    }

    sfn whiskerMark:VlJson (name:string from:string dim:string lowField:string highField:string tip:VlJson) {
        def out:VlJson (VlCompile.styledMark(name "rule" "rule" "boxplot-rule" from))
        def update (VlJson.objectValue())
        update.setMember("stroke" (VlCompile.literal((VlJson.stringValue("black")))))
        update.setMember("tooltip" tip)
        update.setMember("x" (VlCompile.bandCentre(dim)))
        update.setMember("y" (VlCompile.yAt(lowField)))
        update.setMember("y2" (VlCompile.yAt(highField)))
        VlCompile.finishMark(out update)
        return out
    }

    sfn boxMark:VlJson (dim:string lower:string upper:string tip:VlJson description:VlJson colourField:string) {
        def out:VlJson (VlCompile.styledMark("layer_1_layer_0_marks" "rect" "bar" "boxplot-box" "data_7"))
        def update (VlJson.objectValue())
        update.setMember("ariaRoleDescription" (VlCompile.literal((VlJson.stringValue("box")))))
        update.setMember("fill" (VlCompile.boxPaint(colourField)))
        update.setMember("tooltip" tip)
        update.setMember("description" description)
        update.setMember("xc" (VlCompile.bandCentre(dim)))
        update.setMember("width" (VlCompile.literal((VlJson.numberValue(14.0)))))
        update.setMember("y" (VlCompile.yAt(lower)))
        update.setMember("y2" (VlCompile.yAt(upper)))
        VlCompile.finishMark(out update)
        return out
    }

    ; The median line, which is white on the box — except when the box has no
    ; height at all, where a white line on a white background would vanish.
    sfn medianMark:VlJson (dim:string mid:string lower:string upper:string tip:VlJson colourField:string) {
        def out:VlJson (VlCompile.styledMark("layer_1_layer_1_marks" "rect" "tick" "boxplot-median" "data_8"))
        def update (VlJson.objectValue())
        update.setMember("opacity" (VlCompile.literal((VlJson.numberValue(0.7)))))
        def fill (VlJson.arrayValue())
        def flat (VlJson.objectValue())
        flat.setMember("test" (VlJson.stringValue(((("datum['" + lower) + "'] >= datum['") + upper) + "']")))
        def flatPaint:VlJson (VlCompile.boxPaint(colourField))
        for flatPaint.keys fk:string fki {
            flat.setMember(fk (flatPaint.get(fk)))
        }
        push fill.arr flat
        push fill.arr (VlCompile.literal((VlJson.stringValue("white"))))
        update.setMember("fill" fill)
        update.setMember("tooltip" tip)
        update.setMember("xc" (VlCompile.bandCentre(dim)))
        update.setMember("width" (VlCompile.literal((VlJson.numberValue(14.0)))))
        update.setMember("yc" (VlCompile.yAt(mid)))
        update.setMember("height" (VlCompile.literal((VlJson.numberValue(1.0)))))
        VlCompile.finishMark(out update)
        return out
    }

    ; ---------------------------------------------------------------- facet ---
    ; One chart, drawn once per value of a field, with the furniture that says
    ; which is which: a header above each column naming the value it stands for,
    ; a footer below carrying the axis they share, a header to the left of each
    ; row, and a title over the lot.
    ;
    ; The panel is compiled by a normal compiler that has been told to ignore
    ; the facet channel — the chart inside a panel is just a chart — and its
    ; parts are then redistributed. That redistribution is the whole job: the
    ; GRID axes stay in the cell, because a grid belongs to the plot it crosses;
    ; the labelled x axis moves to the column footer and the labelled y axis to
    ; the row header, because those are drawn once for the whole column or row
    ; rather than once per panel.
    ; A `facet` operator, written as the channel it stands for. The block
    ; either names `row` and `column` outright or is one field def, which is
    ; the wrapped form and becomes the `facet` channel.
    sfn facetAsChannel:VlJson (src:VlJson) {
        def inner:VlJson (src.get("spec"))
        def out (VlJson.objectValue())
        ; Everything the whole chart carries — its data, its transforms, its
        ; configuration — stays where it is; the panel's own keys are laid over
        ; it, which is what a facet operator means by `spec`.
        for src.keys k:string ki {
            if (k == "facet") {
                ; becomes an encoding channel
            } {
            if (k == "spec") {
                ; folded in below
            } {
                out.setMember(k (src.get(k)))
            }
            }
        }
        if (inner.isObject()) {
            for inner.keys ik:string iki {
                out.setMember(ik (inner.get(ik)))
            }
        }
        def encoding (VlJson.objectValue())
        def had:VlJson (out.get("encoding"))
        if (had.isObject()) {
            for had.keys ek:string eki {
                encoding.setMember(ek (had.get(ek)))
            }
        }
        def given:VlJson (src.get("facet"))
        def placed:boolean false
        if (given.isObject()) {
            if (given.has("row")) {
                encoding.setMember("row" (given.get("row")))
                placed = true
            }
            if (given.has("column")) {
                encoding.setMember("column" (given.get("column")))
                placed = true
            }
            if (! placed) {
                encoding.setMember("facet" given)
            }
        }
        out.setMember("encoding" encoding)
        return out
    }

    fn compileFacet:VlJson (src:VlJson) {
        def fields:[string] (this.facetFields())
        ; The COLUMN a panel is picked out by, which is not always the column
        ; the chart named: a trellis of hours reads a time unit's answer, and
        ; grouping by the raw instants instead gave one panel per reading with
        ; nothing in the header to name it.
        def rowField:string ((this.channel("row")).outField())
        def columnField:string ((this.channel("column")).outField())
        def wrapField:string ((this.channel("facet")).outField())
        def rowTitleField:string ((this.channel("row")).field)
        def columnTitleField:string ((this.channel("column")).field)
        def wrapTitleField:string ((this.channel("facet")).field)
        ; How many panels across. A repeated specification says it at the top
        ; level, but a wrapped FACET channel says it on the channel — and read
        ; only from the top level the grid never wrapped, so every panel of a
        ; six-site trellis stood in one very wide row.
        def columnsDef:VlJson ((this.channel("facet")).def0.get("columns"))
        if (! (columnsDef.isNumber())) {
            columnsDef = (src.get("columns"))
        }
        clear channels

        def child (new VlCompile())
        child.rootSource = rootSource
        child.insidePanel = true
        child.widthSignal = "child_width"
        child.heightSignal = "child_height"
        child.markLabel = "child_marks"
        def piece:VlJson (child.compile(src))
        for child.errors e:string ei {
            this.fail(e)
        }
        if ((array_length child.errors) > 0) {
            return (VlJson.objectValue())
        }

        def out (VlJson.objectValue())
        for piece.keys pk:string pi {
            if (((((((pk == "data") || (pk == "marks")) || (pk == "scales")) || (pk == "signals")) || (pk == "axes")) || (pk == "legends")) || (pk == "style")) {
                ; rebuilt below
            } {
                out.setMember(pk (piece.get(pk)))
            }
        }

        ; The panel's marks read the partition rather than the whole data set.
        def panelMarks:VlJson (piece.get("marks"))
        def pm:int 0
        while (pm < (panelMarks.count())) {
            def one:VlJson (panelMarks.at(pm))
            ; A mark that is ITSELF a partition — a coloured line or area, which
            ; is one shape per series — keeps its partition and only changes
            ; where the rows come from. Given the plain treatment it lost the
            ; facet and became one group per ROW: a trellis of four areas came
            ; out with four hundred empty panels between them, and sixty
            ; thousand pixels of page.
            def existing:VlJson ((one.get("from")).get("facet"))
            if (existing.isObject()) {
                existing.setMember("data" (VlJson.stringValue("facet")))
            } {
                def innerFrom (VlJson.objectValue())
                innerFrom.setMember("data" (VlJson.stringValue("facet")))
                one.setMember("from" innerFrom)
            }
            pm = (pm + 1)
        }

        ; The domain of the trellis: the distinct values of the facet field, in
        ; the order they are to be drawn.
        def data:VlJson (piece.get("data"))
        def wrapped:boolean ((strlen wrapField) > 0)
        def domainName:string "column_domain"
        if ((strlen rowField) > 0) {
            domainName = "row_domain"
        }
        if wrapped {
            domainName = "facet_domain"
        }
        def facetField:string columnField
        if ((strlen rowField) > 0) {
            facetField = rowField
        }
        if wrapped {
            facetField = wrapField
        }
        push data.arr (VlCompile.domainData(domainName facetField child.dataLabel))
        def columns:VlJson columnsDef
        if wrapped {
            ; A wrapped grid's shape is computed rather than declared, and both
            ; of its extents are sequences over the facet count.
            def perRow:int (columns.intOr("value" 2))
            if (columns.isNumber()) {
                perRow = (to_int columns.num)
            }
            push data.arr (VlCompile.sequenceData("facet_domain_row" (("ceil(length(data('facet_domain')) / " + (VlJson.intToText(perRow))) + ")")))
            push data.arr (VlCompile.sequenceData("facet_domain_column" (("min(length(data('facet_domain')), " + (VlJson.intToText(perRow))) + ")")))
        }
        out.setMember("data" data)
        out.setMember("signals" (piece.get("signals")))
        out.setMember("scales" (piece.get("scales")))
        if ((piece.get("legends")).isArray()) {
            out.setMember("legends" (piece.get("legends")))
        }

        ; The axes, sorted by where they are drawn.
        def gridAxes (VlJson.arrayValue())
        def xAxes (VlJson.arrayValue())
        def yAxes (VlJson.arrayValue())
        def pieceAxes:VlJson (piece.get("axes"))
        if (pieceAxes.isArray()) {
            def ai:int 0
            while (ai < (pieceAxes.count())) {
                def axis:VlJson (pieceAxes.at(ai))
                if (axis.boolOr("grid" false)) {
                    push gridAxes.arr axis
                } {
                    if ((axis.stringOr("orient" "")) == "bottom") {
                        push xAxes.arr axis
                    } {
                        push yAxes.arr axis
                    }
                }
                ai = (ai + 1)
            }
        }

        def marks (VlJson.arrayValue())
        ; What the strip of panels is CALLED, which is the facet channel's own
        ; title where it stated one. Without it a grid of panels was named
        ; after the column — "a" rather than "Factor A".
        def facetKey:string "column"
        if ((strlen rowField) > 0) {
            facetKey = "row"
        }
        if wrapped {
            facetKey = "facet"
        }
        def titleField:string columnTitleField
        if ((strlen rowField) > 0) {
            titleField = rowTitleField
        }
        if wrapped {
            titleField = wrapTitleField
        }
        def titleText:VlJson (VlJson.stringValue((VlCompile.facetTitle(src facetKey titleField))))
        if wrapped {
            push marks.arr (VlCompile.titleGroup("facet-title" "column-title" titleText ""))
            push marks.arr (VlCompile.headerGroup("row_header" "row-header" "facet_domain_row" "" "child_height" yAxes false ""))
            push marks.arr (VlCompile.headerGroup("column_footer" "column-footer" "facet_domain_column" "" "child_width" xAxes true ""))
        } {
            if ((strlen rowField) > 0) {
                if ((strlen (titleText.asString())) > 0) {
                    push marks.arr (VlCompile.titleGroup("row-title" "row-title" titleText "left"))
                }
                push marks.arr (VlCompile.headerGroup("row_header" "row-header" "row_domain" rowField "child_height" yAxes false rowField))
                ; A row of panels only needs a strip under it if there is an
                ; axis to put there. A trellis whose panels have no x axis had
                ; an empty strip reserving a pixel of page.
                if ((xAxes.count()) > 0) {
                    push marks.arr (VlCompile.headerGroup("column_footer" "column-footer" "" "" "child_width" xAxes true ""))
                }
            } {
                push marks.arr (VlCompile.titleGroup("column-title" "column-title" titleText ""))
                push marks.arr (VlCompile.headerGroup("row_header" "row-header" "" "" "child_height" yAxes false ""))
                push marks.arr (VlCompile.headerGroup("column_header" "column-header" "column_domain" columnField "child_width" (VlJson.arrayValue()) true columnField))
                push marks.arr (VlCompile.headerGroup("column_footer" "column-footer" "column_domain" "" "child_width" xAxes true columnField))
            }
        }
        push marks.arr (VlCompile.cellGroup(facetField panelMarks gridAxes wrapped (this.viewStrokeRefused()) child.dataLabel))
        out.setMember("marks" marks)

        ; Where the panels go, and how far the title stands clear of them.
        ; How far apart the panels stand. `spacing` may be one number for
        ; both directions or one for each — a trellis of twenty-four hours
        ; sets its rows a pixel apart, and given twenty it was three times the
        ; height of the page.
        def layout (VlJson.objectValue())
        def spacing:VlJson (src.get("spacing"))
        if (spacing.isNumber()) {
            layout.setMember("padding" spacing)
        } {
        if (spacing.isObject()) {
            def gap (VlJson.objectValue())
            gap.setMember("row" (VlJson.numberValue((spacing.doubleOr("row" 20.0)))))
            gap.setMember("column" (VlJson.numberValue((spacing.doubleOr("column" 20.0)))))
            layout.setMember("padding" gap)
        } {
            layout.setMember("padding" (VlJson.numberValue(20.0)))
        }
        }
        if (! wrapped) {
            ; …and the title only stands clear of them if there is a title.
            def offset (VlJson.objectValue())
            if ((strlen (titleText.asString())) > 0) {
                if ((strlen rowField) > 0) {
                    offset.setMember("rowTitle" (VlJson.numberValue(10.0)))
                } {
                    offset.setMember("columnTitle" (VlJson.numberValue(10.0)))
                }
            }
            if ((array_length offset.keys) > 0) {
                layout.setMember("offset" offset)
            }
        }
        if wrapped {
            layout.setMember("bounds" (VlJson.stringValue("full")))
            layout.setMember("align" (VlJson.stringValue("all")))
            layout.setMember("columns" columnsDef)
        } {
            if ((strlen rowField) > 0) {
                layout.setMember("columns" (VlJson.numberValue(1.0)))
            } {
                def count (VlJson.objectValue())
                count.setMember("signal" (VlJson.stringValue("length(data('column_domain'))")))
                layout.setMember("columns" count)
            }
            layout.setMember("bounds" (VlJson.stringValue("full")))
            layout.setMember("align" (VlJson.stringValue("all")))
        }
        out.setMember("layout" layout)
        VlCompile.anchorComposedTitle(out)
        return out
    }

    ; A title over a composed view stands at the LEFT of the page, above
    ; everything the page holds. A title over a single plot is centred on the
    ; plot itself — `frame: "group"` — which is where a trellis title also
    ; ended up: over the first panel, printed across the headers.
    sfn anchorComposedTitle:void (out:VlJson) {
        def block:VlJson (out.get("title"))
        if (! (block.isObject())) {
            return
        }
        if (block.has("anchor")) {
            return
        }
        block.removeMember("frame")
        block.setMember("anchor" (VlJson.stringValue("start")))
    }

    sfn domainData:VlJson (name:string field:string from:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue(name)))
        out.setMember("source" (VlJson.stringValue(from)))
        def transform (VlJson.arrayValue())
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("aggregate")))
        def groupby (VlJson.arrayValue())
        push groupby.arr (VlJson.stringValue(field))
        t.setMember("groupby" groupby)
        push transform.arr t
        out.setMember("transform" transform)
        return out
    }

    sfn sequenceData:VlJson (name:string stop:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue(name)))
        def transform (VlJson.arrayValue())
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("sequence")))
        t.setMember("start" (VlJson.numberValue(0.0)))
        def stopSignal (VlJson.objectValue())
        stopSignal.setMember("signal" (VlJson.stringValue(stop)))
        t.setMember("stop" stopSignal)
        push transform.arr t
        out.setMember("transform" transform)
        return out
    }

    ; The title over a whole trellis: one piece of text, placed by the layout.
    sfn titleGroup:VlJson (name:string role:string text:VlJson orient:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue(name)))
        out.setMember("type" (VlJson.stringValue("group")))
        out.setMember("role" (VlJson.stringValue(role)))
        def title (VlJson.objectValue())
        title.setMember("text" text)
        if ((strlen orient) > 0) {
            title.setMember("orient" (VlJson.stringValue(orient)))
        }
        title.setMember("style" (VlJson.stringValue("guide-title")))
        title.setMember("offset" (VlJson.numberValue(10.0)))
        out.setMember("title" title)
        return out
    }

    ; A header, a footer or a row header: a group drawn once per column or row,
    ; carrying the axis that column or row shares and, when it names its own
    ; value, a title read from the row it was drawn for.
    sfn headerGroup:VlJson (name:string role:string from:string labelField:string dimension:string axes:VlJson across:boolean orderBy:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue(name)))
        out.setMember("type" (VlJson.stringValue("group")))
        out.setMember("role" (VlJson.stringValue(role)))
        if ((strlen from) > 0) {
            def source (VlJson.objectValue())
            source.setMember("data" (VlJson.stringValue(from)))
            out.setMember("from" source)
        }
        if ((strlen labelField) > 0) {
            def title (VlJson.objectValue())
            def text (VlJson.objectValue())
            text.setMember("signal" (VlJson.stringValue((VlCompile.parentLabel(labelField)))))
            title.setMember("text" text)
            if (! across) {
                title.setMember("orient" (VlJson.stringValue("left")))
            }
            title.setMember("style" (VlJson.stringValue("guide-label")))
            title.setMember("frame" (VlJson.stringValue("group")))
            title.setMember("offset" (VlJson.numberValue(10.0)))
            out.setMember("title" title)
        }
        ; A strip of panels is drawn in the same order as the panels it names,
        ; and that is true of the strip UNDER them as well as the one above:
        ; the footer carries the shared axis and has to line up with the
        ; columns it labels.
        if ((strlen from) > 0) {
            if ((strlen orderBy) > 0) {
                out.setMember("sort" (VlCompile.sortByField(orderBy false)))
            }
        }
        def update (VlJson.objectValue())
        def sizeName:string "height"
        if across {
            sizeName = "width"
        }
        update.setMember(sizeName (VlCompile.signalRef(dimension)))
        def encode (VlJson.objectValue())
        encode.setMember("update" update)
        out.setMember("encode" encode)
        if ((axes.count()) > 0) {
            out.setMember("axes" axes)
        }
        return out
    }

    sfn parentLabel:string (field:string) {
        return ((((("isValid(parent[\"" + field) + "\"]) ? parent[\"") + field) + "\"] : \"\"+parent[\"") + field + "\"]")
    }

    sfn sortByField:VlJson (field:string asList:boolean) {
        def out (VlJson.objectValue())
        def expr:string (("datum[\"" + field) + "\"]")
        if asList {
            def fields (VlJson.arrayValue())
            push fields.arr (VlJson.stringValue(expr))
            def orders (VlJson.arrayValue())
            push orders.arr (VlJson.stringValue("ascending"))
            out.setMember("field" fields)
            out.setMember("order" orders)
            return out
        }
        out.setMember("field" (VlJson.stringValue(expr)))
        out.setMember("order" (VlJson.stringValue("ascending")))
        return out
    }

    ; One panel: the chart itself, drawn over the partition it belongs to.
    sfn cellGroup:VlJson (field:string marks:VlJson gridAxes:VlJson wrapped:boolean bare:boolean from:string) {
        def out (VlJson.objectValue())
        out.setMember("name" (VlJson.stringValue("cell")))
        out.setMember("type" (VlJson.stringValue("group")))
        out.setMember("style" (VlJson.stringValue("cell")))
        if wrapped {
            ; A wrapped grid has no headers, so each panel names itself.
            def title (VlJson.objectValue())
            def text (VlJson.objectValue())
            text.setMember("signal" (VlJson.stringValue((VlCompile.parentLabel(field)))))
            title.setMember("text" text)
            title.setMember("style" (VlJson.stringValue("guide-label")))
            title.setMember("frame" (VlJson.stringValue("group")))
            title.setMember("offset" (VlJson.numberValue(10.0)))
            out.setMember("title" title)
        }
        def facet (VlJson.objectValue())
        facet.setMember("name" (VlJson.stringValue("facet")))
        facet.setMember("data" (VlJson.stringValue(from)))
        def groupby (VlJson.arrayValue())
        push groupby.arr (VlJson.stringValue(field))
        facet.setMember("groupby" groupby)
        def from (VlJson.objectValue())
        from.setMember("facet" facet)
        out.setMember("from" from)
        out.setMember("sort" (VlCompile.sortByField(field true)))
        def update (VlJson.objectValue())
        update.setMember("width" (VlCompile.signalRef("child_width")))
        update.setMember("height" (VlCompile.signalRef("child_height")))
        ; `"view": {"stroke": null}` is a chart asking for no box round its
        ; panels. The style says to draw one, so the panel has to say outright
        ; that it does not — and six panels each a stroke wider than they
        ; should be is six strokes of page.
        if bare {
            def none (VlJson.objectValue())
            none.setMember("value" (VlJson.nullValue()))
            update.setMember("stroke" none)
        }
        def encode (VlJson.objectValue())
        encode.setMember("update" update)
        out.setMember("encode" encode)
        out.setMember("marks" marks)
        if ((gridAxes.count()) > 0) {
            out.setMember("axes" gridAxes)
        }
        return out
    }

    ; ---------------------------------------------------------------- concat ---
    ; Several charts side by side, or one above another. Unlike a layer, each
    ; pane keeps its OWN axes and its own scales, so nothing is merged: each
    ; becomes a group mark with its own furniture inside it, and the layout
    ; places the groups.
    ;
    ; What the panes do share is the dimension that runs across the join. Panes
    ; side by side are all the same height and each is as wide as it needs;
    ; stacked panes are the other way round. So the shared dimension stays the
    ; chart's own signal and the other becomes one per pane, which is also why
    ; every scale carries the pane's name — two panes both have an `x`.
    fn compileConcat:VlJson (src:VlJson key:string horizontal:boolean) {
        def panes:VlJson (src.get(key))
        if (! (panes.isArray())) {
            this.fail((key + " is not an array"))
            return (VlJson.objectValue())
        }
        def total:int (panes.count())

        def out (VlJson.objectValue())
        def data (VlJson.arrayValue())
        def marks (VlJson.arrayValue())
        def scales (VlJson.arrayValue())
        def signals (VlJson.arrayValue())
        def signalNames:[string:int]
        def legends (VlJson.arrayValue())
        def legendNames:[string:int]
        def scaleNames:[string]
        def sharedDomains:[string:VlJson]
        def sharedSeen:[string:int]
        def sourceText:[string]
        def first:boolean true

        def index:int 0
        while (index < total) {
            ; A concatenation inside a concatenation gives its panes names
            ; built from BOTH — `concat_1_concat_0_x` — because otherwise the
            ; first pane of the inner one and the first pane of the outer one
            ; are both called `concat_0_` and quietly share a scale.
            def label:string ((prefix + ("concat_" + (VlJson.intToText(index)))) + "_")
            def child (new VlCompile())
            child.rootSource = rootSource
            child.prefix = label
            child.dataLabel = ("data_" + (VlJson.intToText((index + 1))))
            child.markLabel = (label + "marks")
            ; Both dimensions, whichever way the panes are stacked. The
            ; obvious rule — panes side by side each get their own width, panes
            ; above one another each get their own height — is only half
            ; right: a column of panes shares an EDGE, not a width. A
            ; histogram of twelve months is as wide as twelve bands and the
            ; scatter plot under it is as wide as a plot, and given the band
            ; chart's width the scatter came out sixty pixels narrow.
            child.widthSignal = (label + "width")
            child.heightSignal = (label + "height")
            def piece:VlJson (child.compile((VlCompile.mergeSpec(src (panes.at(index))))))
            for child.errors e:string ei {
                this.fail(e)
            }
            if ((array_length child.errors) == 0) {
                ; The colour a pane paints by is the SAME colour every other
                ; pane paints by: a non-position scale is shared across a
                ; concatenation, where a position scale is each pane's own.
                ; Kept apart, four repeated histograms drew four identical keys
                ; and the page grew to hold all of them.
                VlCompile.shareScales((piece.get("scales")) label sharedDomains)
                VlCompile.renameScaleRefs((piece.get("marks")) label)
                VlCompile.renameScaleRefs((piece.get("legends")) label)
                if first {
                    for piece.keys pk:string pi {
                        if ((((((pk == "data") || (pk == "marks")) || (pk == "scales")) || (pk == "signals")) || (pk == "axes")) || (pk == "legends")) {
                            ; merged below
                        } {
                            if (pk == "style") {
                                ; the frame belongs to each pane, not to the page
                            } {
                                out.setMember(pk (piece.get(pk)))
                            }
                        }
                    }
                    def pieceData:VlJson (piece.get("data"))
                    push data.arr (pieceData.at(0))
                    push sourceText (VlCompile.sourceKey((pieceData.at(0))))
                    first = false
                } {
                    ; A pane may read its own rows, the same way a layer may.
                    def ownData:VlJson (piece.get("data"))
                    def own:VlJson (ownData.at(0))
                    def key:string (VlCompile.sourceKey(own))
                    def at:int -1
                    def si:int 0
                    while (si < (array_length sourceText)) {
                        if ((itemAt sourceText si) == key) {
                            at = si
                        }
                        si = (si + 1)
                    }
                    if (at < 0) {
                        at = (array_length sourceText)
                        push sourceText key
                        own.setMember("name" (VlJson.stringValue(("source_" + (VlJson.intToText(at))))))
                        push data.arr own
                    }
                    def renamed:string ("source_" + (VlJson.intToText(at)))
                    VlCompile.renameSource(ownData renamed)
                    VlCompile.renameSourceRefs((piece.get("marks")) renamed)
                }
                def pieceData2:VlJson (piece.get("data"))
                def di:int 1
                while (di < (pieceData2.count())) {
                    push data.arr (pieceData2.at(di))
                    di = (di + 1)
                }
                ; The pane itself: a group carrying its own marks and axes, and
                ; told how big it is by the signals its child wrote.
                def group (VlJson.objectValue())
                group.setMember("type" (VlJson.stringValue("group")))
                group.setMember("name" (VlJson.stringValue((label + "group"))))
                ; A pane that is ITSELF a concatenation is not a plot: it is a
                ; second grid, and it carries its own layout rather than a
                ; frame and a size. Given the plot's treatment its panes lost
                ; their arrangement and stacked into one very tall column.
                if ((piece.get("layout")).isObject()) {
                    group.setMember("layout" (piece.get("layout")))
                    group.setMember("marks" (piece.get("marks")))
                } {
                    group.setMember("style" (VlJson.stringValue("cell")))
                    def update (VlJson.objectValue())
                    update.setMember("width" (VlCompile.signalRef((child.sizeSignal("width")))))
                    update.setMember("height" (VlCompile.signalRef((child.sizeSignal("height")))))
                    def encode (VlJson.objectValue())
                    encode.setMember("update" update)
                    group.setMember("encode" encode)
                    group.setMember("marks" (piece.get("marks")))
                    def pieceAxes:VlJson (piece.get("axes"))
                    if (pieceAxes.isArray()) {
                        group.setMember("axes" pieceAxes)
                    }
                }
                push marks.arr group

                def pieceScales:VlJson (piece.get("scales"))
                if (pieceScales.isArray()) {
                    def si:int 0
                    while (si < (pieceScales.count())) {
                        def sc:VlJson (pieceScales.at(si))
                        def scName:string (sc.stringOr("name" ""))
                        def keep:boolean true
                        if (VlCompile.sharedChannel(scName)) {
                            if (has sharedSeen scName) {
                                keep = false
                            } {
                                set sharedSeen scName 1
                                push scaleNames scName
                            }
                        }
                        if keep {
                            push scales.arr sc
                        }
                        si = (si + 1)
                    }
                }
                VlCompile.mergeSignals(signals signalNames (piece.get("signals")))
                VlCompile.mergeLegends(legends legendNames (piece.get("legends")))
            }
            index = (index + 1)
        }

        VlCompile.applyMergedDomains(scales scaleNames sharedDomains)

        out.setMember("data" data)
        if ((signals.count()) > 0) {
            out.setMember("signals" signals)
        }
        ; The panes are laid out on a grid whose cells are their full bounds,
        ; each pane keeping its own alignment — `each`, not `all`, because two
        ; panes of a concatenation need not have axes of the same depth.
        ;
        ; How many panes across is the whole difference between the two
        ; concatenations, and it has to be SAID: a layout without `columns`
        ; puts everything in one row, so a vertical concatenation that never
        ; stated a column count came out side by side.
        def layout (VlJson.objectValue())
        layout.setMember("padding" (VlJson.numberValue((src.doubleOr("spacing" 20.0)))))
        if horizontal {
            layout.setMember("columns" (VlJson.numberValue((to_double total))))
        } {
            layout.setMember("columns" (VlJson.numberValue(1.0)))
        }
        ; A WRAPPED concatenation says how many across itself.
        if ((src.get("columns")).isNumber()) {
            layout.setMember("columns" (src.get("columns")))
        }
        layout.setMember("bounds" (VlJson.stringValue((src.stringOr("bounds" "full")))))
        ; `each` unless the composition says otherwise. A REPEAT says otherwise:
        ; its panes are copies of one specification and line up on a single
        ; pitch, the way a trellis does, so the third copy does not start early
        ; because its own axis labels are shorter than its neighbour's.
        def stated:VlJson (src.get("align"))
        if ((stated.isString()) || (stated.isObject())) {
            layout.setMember("align" stated)
        } {
            layout.setMember("align" (VlJson.stringValue("each")))
        }
        out.setMember("layout" layout)
        out.setMember("marks" marks)
        out.setMember("scales" scales)
        if ((legends.count()) > 0) {
            out.setMember("legends" legends)
        }
        VlCompile.anchorComposedTitle(out)
        return out
    }

    ; Which scales a concatenation's panes SHARE. A position scale measures
    ; one plot and belongs to it; a colour, a size or a shape says what a
    ; value means, and that has to mean the same thing in every pane or the
    ; page is telling two stories at once. It is also the reference's own
    ; default resolution for a concatenation.
    sfn sharedChannel:boolean (name:string) {
        if (((name == "color") || (name == "fill")) || ((name == "stroke") || (name == "size"))) {
            return true
        }
        return (((name == "shape") || (name == "opacity")) || (name == "angle"))
    }

    ; Strip the pane's prefix off the scales it shares, and remember what each
    ; one's domain reads, so that the one surviving copy can be given the union
    ; of them all.
    sfn shareScales:void (scales:VlJson label:string domains:[string:VlJson]) {
        if (! (scales.isArray())) {
            return
        }
        def n:int (strlen label)
        def i:int 0
        while (i < (scales.count())) {
            def sc:VlJson (scales.at(i))
            def full:string (sc.stringOr("name" ""))
            if ((strlen full) > n) {
                if ((substring full 0 n) == label) {
                    def bare:string (substring full n (strlen full))
                    if (VlCompile.sharedChannel(bare)) {
                        sc.setMember("name" (VlJson.stringValue(bare)))
                        if (! (has domains bare)) {
                            set domains bare (VlJson.arrayValue())
                        }
                        def into:VlJson (unwrap (get domains bare))
                        VlCompile.collectDomain(into (sc.get("domain")) true)
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; Everywhere a pane named one of those scales — a mark's encoding, a
    ; legend's channel — now names the shared one. A scale is referred to by
    ; its NAME as a plain string, so the rename is a string rename; no other
    ; string in a compiled pane spells `concat_0_color`.
    ; `"resolve": {"scale": {"y": "independent"}}` is a dual-axis chart: the two
    ; layers measure different things up the same side of the plot and must not
    ; share a scale. Each layer's scale for that channel is given a name of its
    ; own — `layer_0_y`, `layer_1_y` — and everything in the layer that reads it
    ; is pointed at the new name, so the merge below finds two scales where it
    ; would otherwise find one and average them into a scale neither layer
    ; asked for.
    sfn renameOneScale:void (node:VlJson from:string to:string) {
        if (node.isArray()) {
            def k:int 0
            while (k < (node.count())) {
                VlCompile.renameOneScale((node.at(k)) from to)
                k = (k + 1)
            }
            return
        }
        if (! (node.isObject())) {
            return
        }
        for node.keys key:string ki {
            def v:VlJson (node.get(key))
            if (v.isString()) {
                if ((v.asString()) == from) {
                    if (((key == "scale") || (key == "gridScale")) || (key == "name")) {
                        node.setMember(key (VlJson.stringValue(to)))
                    }
                }
            } {
                VlCompile.renameOneScale(v from to)
            }
        }
    }

    ; Which channels the chart said its layers must not share.
    fn independentChannels:[string] () {
        def out:[string]
        def resolve:VlJson (source.get("resolve"))
        if (! (resolve.isObject())) {
            return out
        }
        def scales:VlJson (resolve.get("scale"))
        if (! (scales.isObject())) {
            return out
        }
        for scales.keys key:string ki {
            if (((scales.get(key)).asString()) == "independent") {
                push out key
            }
        }
        return out
    }

    sfn sideAxes:void (axes:VlJson scaleName:string channel:string) {
        if (! (axes.isArray())) {
            return
        }
        def far:string "right"
        if (channel == "x") {
            far = "top"
        }
        def k:int 0
        while (k < (axes.count())) {
            def a:VlJson (axes.at(k))
            if ((a.stringOr("scale" "")) == scaleName) {
                if (a.boolOr("grid" false)) {
                    ; A grid axis for a scale nothing else measures rules the
                    ; plot twice over. The reference draws one grid.
                    a.setMember("grid" (VlJson.boolValue(false)))
                } {
                    a.setMember("orient" (VlJson.stringValue(far)))
                }
            }
            k = (k + 1)
        }
    }

    sfn renameScaleRefs:void (node:VlJson label:string) {
        if (node.isArray()) {
            def k:int 0
            while (k < (node.count())) {
                VlCompile.renameScaleRefs((node.at(k)) label)
                k = (k + 1)
            }
            return
        }
        if (! (node.isObject())) {
            return
        }
        def n:int (strlen label)
        for node.keys key:string ki {
            def v:VlJson (node.get(key))
            if (v.isString()) {
                def text:string (v.asString())
                if ((strlen text) > n) {
                    if ((substring text 0 n) == label) {
                        def bare:string (substring text n (strlen text))
                        if (VlCompile.sharedChannel(bare)) {
                            node.setMember(key (VlJson.stringValue(bare)))
                        }
                    }
                }
            } {
                VlCompile.renameScaleRefs(v label)
            }
        }
    }

    sfn signalRef:VlJson (name:string) {
        def out (VlJson.objectValue())
        out.setMember("signal" (VlJson.stringValue(name)))
        return out
    }

    ; The same chart written the long way: the mark as it was, minus the flag,
    ; and a plain point mark over it.
    sfn withOverlayLayers:VlJson (src:VlJson markDef:VlJson) {
        def out (VlJson.objectValue())
        for src.keys key:string ki {
            if (key == "mark") {
                ; replaced by the layer below
            } {
                out.setMember(key (src.get(key)))
            }
        }
        def base (VlJson.objectValue())
        def baseMark (VlJson.objectValue())
        ; `"point": true` and `"point": {"filled": false, "fill": "white"}`
        ; are the same request with and without a say in how the dots look.
        def wantsPoints:boolean (VlCompile.overlayAsked(markDef "point"))
        def wantsLine:boolean (VlCompile.overlayAsked(markDef "line"))
        for markDef.keys mk:string mi {
            if ((mk == "point") || (mk == "line")) {
                ; the flags are what is being expanded
            } {
                baseMark.setMember(mk (markDef.get(mk)))
            }
        }
        ; An AREA with a line drawn on it is made translucent, so that the line
        ; and whatever is behind it both read through the fill. That is the
        ; reference's rule and it is the visible half of `line: true`.
        if wantsLine {
            if ((baseMark.stringOr("type" "")) == "area") {
                if (! (baseMark.has("opacity"))) {
                    baseMark.setMember("opacity" (VlJson.numberValue(0.7)))
                }
            }
        }
        base.setMember("mark" baseMark)
        def layer (VlJson.arrayValue())
        push layer.arr base

        ; The line along an area's top edge: the same encoding, drawn as a
        ; line with no fill.
        if wantsLine {
            def edge (VlJson.objectValue())
            def edgeMark:VlJson (VlCompile.overlayMark(markDef "line" "line"))
            edge.setMember("mark" edgeMark)
            push layer.arr edge
        }
        ; The dots on a line are FILLED, unlike a scatter plot's, because they
        ; mark where the line's own vertices are rather than standing for rows
        ; of their own.
        if wantsPoints {
            def dots (VlJson.objectValue())
            def dotMark:VlJson (VlCompile.overlayMark(markDef "point" "point"))
            if (! (dotMark.has("filled"))) {
                dotMark.setMember("filled" (VlJson.boolValue(true)))
            }
            dots.setMember("mark" dotMark)
            push layer.arr dots
        }
        out.setMember("layer" layer)
        return out
    }

    sfn overlayAsked:boolean (markDef:VlJson key:string) {
        def given:VlJson (markDef.get(key))
        if (given.isObject()) {
            return true
        }
        return (markDef.boolOr(key false))
    }

    ; The overlay's own mark definition: what the flag said, if it said
    ; anything, plus the two things that are true of every overlay. It is drawn
    ; SOLID — opacity 1 rather than the 0.7 a scatter plot's dots carry —
    ; because a dot on a line marks a vertex of that line rather than standing
    ; for a row that might be sitting on top of another.
    sfn overlayMark:VlJson (markDef:VlJson key:string type:string) {
        def out (VlJson.objectValue())
        out.setMember("type" (VlJson.stringValue(type)))
        def given:VlJson (markDef.get(key))
        if (given.isObject()) {
            for given.keys gk:string gi {
                if (gk != "type") {
                    out.setMember(gk (given.get(gk)))
                }
            }
        }
        if (! (out.has("opacity"))) {
            out.setMember("opacity" (VlJson.numberValue(1.0)))
        }
        return out
    }

    ; How big a layered chart is, decided across ALL of its layers.
    ;
    ; Everything the chart is as a whole is taken from the first layer, and its
    ; SIZE cannot be: a chart is as tall as the tallest thing in it, and the
    ; first layer of a hover chart is often a rule with only one position
    ; encoded. Sized from that layer alone, a three-hundred-pixel plot came out
    ; twenty pixels tall — a chart with nothing on an axis is one step tall on
    ; that axis, which is right for a strip plot and wrong for a layer.
    ;
    ; Only a plain measurement is overridden. A chart laid out from its BANDS
    ; carries signals rather than numbers, and every layer agrees about
    ; band-ness already, so there is nothing to settle there.
    fn resizeAcrossLayers:void (out:VlJson src:VlJson layers:VlJson bandX:boolean bandY:boolean) {
        def sizer (new VlCompile())
        sizer.rootSource = rootSource
        sizer.source = (VlCompile.mergeSpec(src (VlCompile.unionOfLayers(layers))))
        if bandX {
            set sizer.forcedTypes "x" "band"
        }
        if bandY {
            set sizer.forcedTypes "y" "band"
        }
        sizer.readMark()
        sizer.readEncoding()
        def sized (VlJson.objectValue())
        def spare (VlJson.arrayValue())
        sizer.sizeAndSignals(sized spare)
        VlCompile.takeSize(out sized "width")
        VlCompile.takeSize(out sized "height")
    }

    sfn takeSize:void (out:VlJson sized:VlJson dimension:string) {
        def measured:VlJson (sized.get(dimension))
        if (! (measured.isNumber())) {
            return
        }
        def already:VlJson (out.get(dimension))
        if (! (already.isNumber())) {
            return
        }
        if (already.num < measured.num) {
            out.setMember(dimension measured)
        }
    }

    ; One layer standing for all of them: the first layer's own definition with
    ; every channel any other layer encodes added to it. It is compiled for its
    ; SIZE and nothing else, so what it would draw does not matter.
    sfn unionOfLayers:VlJson (layers:VlJson) {
        def out (VlJson.objectValue())
        def encoding (VlJson.objectValue())
        def total:int (layers.count())
        def k:int 0
        while (k < total) {
            def layer:VlJson (layers.at(k))
            if (k == 0) {
                for layer.keys key:string ki {
                    if (key != "encoding") {
                        out.setMember(key (layer.get(key)))
                    }
                }
            }
            def enc:VlJson (layer.get("encoding"))
            if (enc.isObject()) {
                for enc.keys ek:string ei {
                    if (! (encoding.has(ek))) {
                        encoding.setMember(ek (enc.get(ek)))
                    }
                }
            }
            k = (k + 1)
        }
        out.setMember("encoding" encoding)
        return out
    }

    ; The channel's own title, read from the specification rather than from the
    ; compiler's channel list: by the time a trellis is assembled the channels
    ; have been re-read for the PANEL, which is a chart with no facet channel
    ; in it at all.
    sfn facetTitle:string (src:VlJson key:string fallback:string) {
        def encoding:VlJson (src.get("encoding"))
        if (encoding.isObject()) {
            def cdef:VlJson (encoding.get(key))
            if (cdef.isObject()) {
                ; A facet channel names its strip either directly or through
                ; the `header` block, and either place may say it has no name:
                ; `{"header": {"title": ""}}` is a grid of panels whose rows
                ; are labelled and whose strip is not.
                if (cdef.has("title")) {
                    return (cdef.stringOr("title" ""))
                }
                def header:VlJson (cdef.get("header"))
                if (header.isObject()) {
                    if (header.has("title")) {
                        return (header.stringOr("title" ""))
                    }
                }
            }
        }
        return fallback
    }

    ; A layer is a specification with the outer one's data, size and shared
    ; encoding behind it. The layer's own keys win.
    ; What a channel says when a shared encoding and a layer's own both say
    ; something about it. The layer wins property by property — but a layer
    ; that names its own source of values replaces the shared one entirely
    ; rather than carrying both, because a channel reads a field, a datum or a
    ; constant and never two of them at once.
    sfn mergeChannelDef:VlJson (shared:VlJson own:VlJson) {
        if (! (shared.isObject())) {
            return own
        }
        if (! (own.isObject())) {
            return own
        }
        def sourced:boolean (((own.has("field")) || (own.has("datum"))) || (own.has("value")))
        def out (VlJson.objectValue())
        for shared.keys sk:string si {
            def drop:boolean false
            if sourced {
                if (((sk == "field") || (sk == "datum")) || (sk == "value")) {
                    drop = true
                }
            }
            if (! drop) {
                out.setMember(sk (shared.get(sk)))
            }
        }
        for own.keys ok:string oi {
            out.setMember(ok (own.get(ok)))
        }
        return out
    }

    sfn mergeSpec:VlJson (outer:VlJson layer:VlJson) {
        def out (VlJson.objectValue())
        for outer.keys key:string ki {
            ; The composition itself is not inherited — a pane of a
            ; concatenation is not another concatenation.
            def composition:boolean (((key == "layer") || (key == "hconcat")) || ((key == "vconcat") || (key == "facet")))
            ; `concat` and the column count that folds it belong to the
            ; concatenation, not to its panes — inherited, every pane became a
            ; copy of the whole thing and the compiler recursed until the stack
            ; ran out.
            if ((key == "concat") || (key == "columns")) {
                composition = true
            }
            if composition {
                ; not inherited
            } {
                out.setMember(key (outer.get(key)))
            }
        }
        for layer.keys key2:string kj {
            ; A pane's own transforms run AFTER the ones it inherited, not
            ; instead of them. Replaced, a layer that filters by a selection
            ; lost the calculation the chart shares — and then binned a column
            ; that was never computed.
            if (key2 == "transform") {
                def chain (VlJson.arrayValue())
                def inherited:VlJson (outer.get("transform"))
                if (inherited.isArray()) {
                    def ti:int 0
                    while (ti < (inherited.count())) {
                        push chain.arr (inherited.at(ti))
                        ti = (ti + 1)
                    }
                }
                def own:VlJson (layer.get("transform"))
                if (own.isArray()) {
                    def oi:int 0
                    while (oi < (own.count())) {
                        push chain.arr (own.at(oi))
                        oi = (oi + 1)
                    }
                }
                out.setMember("transform" chain)
                continue
            }
            if (key2 == "encoding") {
                def merged (VlJson.objectValue())
                def outerEncoding:VlJson (outer.get("encoding"))
                if (outerEncoding.isObject()) {
                    for outerEncoding.keys ek:string ei {
                        merged.setMember(ek (outerEncoding.get(ek)))
                    }
                }
                def layerEncoding:VlJson (layer.get("encoding"))
                for layerEncoding.keys lk:string li {
                    ; A shared channel and a layer's channel are merged
                    ; PROPERTY by property. A candlestick states the y channel's
                    ; type, scale and axis once at the top and gives each layer
                    ; only the column to read; replaced wholesale, the type went
                    ; missing and a price axis came out as a band, one step per
                    ; distinct price.
                    merged.setMember(lk (VlCompile.mergeChannelDef((merged.get(lk)) (layerEncoding.get(lk)))))
                }
                out.setMember("encoding" merged)
            } {
                out.setMember(key2 (layer.get(key2)))
            }
        }
        return out
    }

    ; The axes of one layer, added to the stack's. An axis is named by the
    ; scale it measures, the side it stands on and whether it is the grid or
    ; the labels — two layers reading the same column want one axis between
    ; them, not one each.
    ;
    ; Grids are kept ahead of labels however late the layer that wanted one
    ; arrives, because a grid is drawn under the marks and a labelled axis
    ; over them.
    ; What makes one source data set the same as another: where its rows come
    ; from, which is a url or the rows themselves.
    sfn sourceKey:string (d:VlJson) {
        def w (new VlJsonWriter())
        if (d.has("url")) {
            return ("url:" + (d.stringOr("url" "")))
        }
        if (d.has("values")) {
            return ("values:" + (w.write((d.get("values")))))
        }
        return "empty"
    }

    ; Every data set in a layer that read `source_0` now reads the name the
    ; layer's own source was given.
    sfn renameSource:void (data:VlJson name:string) {
        def total:int (data.count())
        def k:int 1
        while (k < total) {
            def one:VlJson (data.at(k))
            if ((one.stringOr("source" "")) == "source_0") {
                one.setMember("source" (VlJson.stringValue(name)))
            }
            k = (k + 1)
        }
    }

    ; Every mark that read `source_0` now reads it too, however deeply the
    ; marks are nested.
    sfn renameSourceRefs:void (marks:VlJson name:string) {
        if (! (marks.isArray())) {
            return
        }
        def total:int (marks.count())
        def k:int 0
        while (k < total) {
            def m:VlJson (marks.at(k))
            k = (k + 1)
            def from:VlJson (m.get("from"))
            if (from.isObject()) {
                if ((from.stringOr("data" "")) == "source_0") {
                    from.setMember("data" (VlJson.stringValue(name)))
                }
                def facet:VlJson (from.get("facet"))
                if (facet.isObject()) {
                    if ((facet.stringOr("data" "")) == "source_0") {
                        facet.setMember("data" (VlJson.stringValue(name)))
                    }
                }
            }
            VlCompile.renameSourceRefs((m.get("marks")) name)
        }
    }

    ; Point every grid axis at the scale it is drawn across, once all of them
    ; are known.
    sfn crossGrids:void (axes:VlJson) {
        def total:int (axes.count())
        def k:int 0
        while (k < total) {
            def a:VlJson (axes.at(k))
            k = (k + 1)
            if (a.boolOr("grid" false)) {
                if (! (a.has("gridScale"))) {
                    def mine:string (a.stringOr("scale" ""))
                    def other:string ""
                    def j:int 0
                    while (j < total) {
                        def b:VlJson (axes.at(j))
                        j = (j + 1)
                        def named:string (b.stringOr("scale" ""))
                        if (named != mine) {
                            if ((strlen other) == 0) {
                                other = named
                            }
                        }
                    }
                    if ((strlen other) > 0) {
                        a.setMember("gridScale" (VlJson.stringValue(other)))
                    }
                }
            }
        }
    }

    sfn mergeAxes:void (into:VlJson seen:[string:int] axes:VlJson) {
        if (! (axes.isArray())) {
            return
        }
        ; A scale belongs to the first layer that measured it, grid and all.
        ; Merged one axis at a time instead, a chart whose first layer bins its
        ; x and whose second reads it whole was ruled off by the second — a
        ; grid down a histogram, which the reference does not draw.
        def total:int (axes.count())
        def fresh:[string:int]
        def freshNames:[string]
        def k:int 0
        while (k < total) {
            def key:string (VlCompile.axisKey((axes.at(k))))
            if (! (has seen key)) {
                if (! (has fresh key)) {
                    set fresh key 1
                    push freshNames key
                }
            }
            k = (k + 1)
        }
        k = 0
        while (k < total) {
            def a:VlJson (axes.at(k))
            k = (k + 1)
            def key2:string (VlCompile.axisKey(a))
            if (has fresh key2) {
                if (a.boolOr("grid" false)) {
                    VlCompile.insertBeforeLabels(into a)
                } {
                    push into.arr a
                }
            }
        }
        for freshNames done:string di {
            set seen done 1
        }
    }

    sfn axisKey:string (a:VlJson) {
        def out:string (a.stringOr("scale" ""))
        return ((out + "/") + (a.stringOr("orient" "")))
    }

    sfn insertBeforeLabels:void (into:VlJson a:VlJson) {
        def kept:[VlJson]
        for into.arr one:VlJson oi {
            push kept one
        }
        clear into.arr
        def placed:boolean false
        for kept one2:VlJson oi2 {
            if (! placed) {
                if (! (one2.boolOr("grid" false))) {
                    push into.arr a
                    placed = true
                }
            }
            push into.arr one2
        }
        if (! placed) {
            push into.arr a
        }
    }

    sfn mergeSignals:void (signals:VlJson seen:[string:int] from:VlJson) {
        if (! (from.isArray())) {
            return
        }
        def i:int 0
        while (i < (from.count())) {
            def sig:VlJson (from.at(i))
            def name:string (sig.stringOr("name" ""))
            if (! (has seen name)) {
                set seen name 1
                push signals.arr sig
            }
            i = (i + 1)
        }
    }

    ; A scale is kept once, with the first layer's properties — the first layer
    ; is the one whose axes the chart carries, so it decides whether the scale
    ; reaches zero. Its DOMAIN is the union of every layer's, which is collected
    ; here and written back once all the layers are in.
    sfn mergeScales:void (scales:VlJson names:[string] domains:[string:VlJson] from:VlJson) {
        if (! (from.isArray())) {
            return
        }
        def i:int 0
        while (i < (from.count())) {
            def sc:VlJson (from.at(i))
            def name:string (sc.stringOr("name" ""))
            def known:boolean false
            for names existing:string ei {
                if (existing == name) {
                    known = true
                }
            }
            if (! known) {
                push names name
                push scales.arr sc
                set domains name (VlJson.arrayValue())
            } {
                ; A later layer may know something about the scale the first
                ; one did not. The room a BAR needs at the ends of its scale is
                ; the case: a candlestick draws a rule in one layer and a bar
                ; in the next, and only the bar asks for the five pixels — kept
                ; from the first layer alone, the widest candle was drawn half
                ; outside the plot.
                for scales.arr already:VlJson ai {
                    if ((already.stringOr("name" "")) == name) {
                        if (! (already.has("padding"))) {
                            if (sc.has("padding")) {
                                already.setMember("padding" (sc.get("padding")))
                            }
                        }
                    }
                }
            }
            def collected:VlJson (unwrap (get domains name))
            ; A stated `domain: [0, 100]` on a position scale is an INTERVAL,
            ; not a list of categories to union: collected from every layer it
            ; became [0, 100, 0, 100]. Only an ordinal scale's literal domain
            ; is a set of names.
            def ordinal:boolean ((sc.stringOr("type" "")) == "ordinal")
            VlCompile.collectDomain(collected (sc.get("domain")) ordinal)
            i = (i + 1)
        }
    }

    ; A domain entry is a data set and a field. A stacked channel contributes
    ; two of them, one per end.
    sfn collectDomain:void (into:VlJson domain:VlJson ordinal:boolean) {
        ; A LITERAL domain — the one value a datum stands for — contributes its
        ; entries as themselves. Several layers each naming one is how a
        ; repeated chart's colour scale comes to have categories at all.
        if (domain.isArray()) {
            if (! ordinal) {
                return
            }
            def n:int (domain.count())
            def j:int 0
            while (j < n) {
                def one:VlJson (domain.at(j))
                def already:boolean false
                def seen:int 0
                while (seen < (into.count())) {
                    if (((into.at(seen)).asString()) == (one.asString())) {
                        already = true
                    }
                    seen = (seen + 1)
                }
                if (! already) {
                    push into.arr one
                }
                j = (j + 1)
            }
            return
        }
        if (! (domain.isObject())) {
            return
        }
        if (domain.has("signal")) {
            return
        }
        def data:VlJson (domain.get("data"))
        def fields:VlJson (domain.get("fields"))
        if (fields.isArray()) {
            def i:int 0
            while (i < (fields.count())) {
                def entry:VlJson (fields.at(i))
                ; A nested layer has already merged its own layers, so its
                ; `fields` hold whole entries rather than field NAMES. Wrapping
                ; one of those in another entry produced a domain that named no
                ; data set and whose field was an object, and the scale it
                ; described ran from zero to zero.
                if (entry.isObject()) {
                    push into.arr entry
                } {
                    def one (VlJson.objectValue())
                    one.setMember("data" data)
                    one.setMember("field" entry)
                    push into.arr one
                }
                i = (i + 1)
            }
            return
        }
        if (domain.has("field")) {
            def one2 (VlJson.objectValue())
            one2.setMember("data" data)
            one2.setMember("field" (domain.get("field")))
            push into.arr one2
        }
    }

    ; One layer contributing to a scale leaves its domain as it was; more than
    ; one turns it into a list of the fields they each contribute.
    sfn applyMergedDomains:void (scales:VlJson names:[string] domains:[string:VlJson]) {
        def i:int 0
        while (i < (scales.count())) {
            def sc:VlJson (scales.at(i))
            def name:string (sc.stringOr("name" ""))
            if (has domains name) {
                def collected:VlJson (unwrap (get domains name))
                if ((collected.count()) > 1) {
                    ; Entries that are values rather than field references make
                    ; a literal domain, not a list of fields to read.
                    def literal:boolean true
                    def c:int 0
                    while (c < (collected.count())) {
                        if ((collected.at(c)).isObject()) {
                            literal = false
                        }
                        c = (c + 1)
                    }
                    if literal {
                        sc.setMember("domain" collected)
                        i = (i + 1)
                        continue
                    }
                    def domain (VlJson.objectValue())
                    domain.setMember("fields" collected)
                    def old:VlJson (sc.get("domain"))
                    if (old.isObject()) {
                        if (old.has("sort")) {
                            domain.setMember("sort" (old.get("sort")))
                        }
                    }
                    sc.setMember("domain" domain)
                }
            }
            i = (i + 1)
        }
    }

    ; One axis over several layers names all of them: a scatter plot with a mean
    ; line reads "b, Mean of b", because the axis is measuring both.
    ; Which of a layer's channels named their own axis title. A title the
    ; layer did not ask for is derived from a field name, and a field name
    ; another layer happens to read is not something to append to the axis.
    sfn statedTitles:[string:boolean] (layer:VlJson) {
        def out:[string:boolean]
        def encoding:VlJson (layer.get("encoding"))
        if (encoding.isObject()) {
            for encoding.keys key:string ki {
                def cdef:VlJson (encoding.get(key))
                if (cdef.isObject()) {
                    def named:boolean (cdef.has("title"))
                    if (! named) {
                        def axisDef:VlJson (cdef.get("axis"))
                        if (axisDef.isObject()) {
                            named = (axisDef.has("title"))
                        }
                    }
                    if named {
                        set out key true
                    }
                }
            }
        }
        return out
    }

    ; An axis shared by several layers is titled by all of them at once, and
    ; the reference keeps two lists rather than one: the titles a layer ASKED
    ; for, and the titles that are merely the name of the column a layer
    ; happens to read. A stated title wins outright — a waterfall chart of
    ; `previous_sum`, `sum` and `center` whose first layer says "Amount" is
    ; titled "Amount", not "Amount, sum, center". With none stated they are all
    ; kept, joined by commas, which is how two lines of `temp_max` and
    ; `temp_min` come to share an axis called "temp_max, temp_min".
    sfn collectAxisTitles:void (titles:[string:string] asked:[string:string] from:VlJson stated:[string:boolean]) {
        if (! (from.isArray())) {
            return
        }
        def i:int 0
        while (i < (from.count())) {
            def axis:VlJson (from.at(i))
            def scale:string (axis.stringOr("scale" ""))
            def title:string (axis.stringOr("title" ""))
            if ((strlen title) > 0) {
                VlCompile.addTitle(titles scale title)
                if (has stated scale) {
                    VlCompile.addTitle(asked scale title)
                }
            }
            i = (i + 1)
        }
    }

    sfn addTitle:void (into:[string:string] scale:string title:string) {
        ; The title arriving may itself be a list: a layer inside a layer has
        ; already merged its own, and appending "Min of date, date" whole to
        ; "date" named the column twice.
        def rest:string title
        def cut:int (indexOf rest ", ")
        while (cut >= 0) {
            VlCompile.addOneTitle(into scale (substring rest 0 cut))
            rest = (substring rest (cut + 2) (strlen rest))
            cut = (indexOf rest ", ")
        }
        VlCompile.addOneTitle(into scale rest)
    }

    sfn addOneTitle:void (into:[string:string] scale:string title:string) {
        if ((strlen title) == 0) {
            return
        }
        if (has into scale) {
            def already:string (unwrap (get into scale))
            if (! (VlCompile.namesInclude(already title))) {
                set into scale ((already + ", ") + title)
            }
            return
        }
        set into scale title
    }

    ; Is this name already one of the comma-separated names in the list? Asked
    ; with `indexOf`, "date" is inside "date (year)" and "Mean of date" is
    ; inside nothing, so the answer depended on where in the list a name
    ; happened to sit. Split and compare whole names instead.
    sfn namesInclude:boolean (list:string name:string) {
        if (list == name) {
            return true
        }
        def rest:string list
        def sep:string ", "
        def cut:int (indexOf rest sep)
        while (cut >= 0) {
            if ((substring rest 0 cut) == name) {
                return true
            }
            rest = (substring rest (cut + 2) (strlen rest))
            cut = (indexOf rest sep)
        }
        return (rest == name)
    }

    sfn mergeAxisTitles:void (axes:VlJson titles:[string:string] asked:[string:string]) {
        def i:int 0
        while (i < (axes.count())) {
            def axis:VlJson (axes.at(i))
            def scale:string (axis.stringOr("scale" ""))
            if (axis.has("title")) {
                if (has asked scale) {
                    axis.setMember("title" (VlJson.stringValue((unwrap (get asked scale)))))
                } {
                    if (has titles scale) {
                        axis.setMember("title" (VlJson.stringValue((unwrap (get titles scale)))))
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; One legend per SCALE, however many layers ask for one. A line drawn with
    ; points is two layers and two keys — the line's is a stroke, the point's
    ; is a fill — and the reference draws a single key that is both: a filled
    ; circle with a stroke round it. Keeping only the first gave a line chart
    ; with dots a key with no dot in it.
    sfn mergeLegends:void (legends:VlJson seen:[string:int] from:VlJson) {
        if (! (from.isArray())) {
            return
        }
        def i:int 0
        while (i < (from.count())) {
            def l:VlJson (from.at(i))
            def key:string ""
            for l.keys k:string ki {
                if ((((k == "fill") || (k == "stroke")) || (k == "size")) || (k == "shape")) {
                    if ((strlen key) == 0) {
                        key = (l.stringOr(k ""))
                    }
                }
            }
            if (has seen key) {
                def at:int (unwrap (get seen key))
                def already:VlJson (legends.at(at))
                for l.keys k2:string ki2 {
                    if (! (already.has(k2))) {
                        def hides:boolean false
                        if (k2 == "encode") {
                            hides = (VlCompile.hidesSymbol((l.get("encode"))))
                        }
                        if (! hides) {
                            already.setMember(k2 (l.get(k2)))
                        }
                    } {
                        ; A symbol that is a SHAPE beats one that is a dash:
                        ; the key stands for the marks the chart draws, and a
                        ; dot is the more specific of the two.
                        if (k2 == "symbolType") {
                            if ((already.stringOr("symbolType" "")) == "stroke") {
                                already.setMember("symbolType" (l.get("symbolType")))
                            }
                        }
                        if (k2 == "encode") {
                            ; A key stands for the marks a scale paints, and
                            ; one of those marks may be INVISIBLE — a hover
                            ; highlight is drawn at opacity zero until it is
                            ; hovered. Copying its paint onto the shared key
                            ; made the key invisible too, which is not what the
                            ; key is for: the reference drops the properties
                            ; the layers disagree about and lets the defaults
                            ; stand.
                            if (! (VlCompile.hidesSymbol((l.get("encode"))))) {
                                already.setMember("encode" (l.get("encode")))
                            }
                        }
                    }
                }
                ; A pane that paints its marks by the same scale brings the
                ; scale with it, and a scale beats a constant: a key told to be
                ; transparent inside by a pane of hollow dots is filled by the
                ; scale the pane of bars brought.
                VlCompile.dropScaledOverride(already "fill")
                VlCompile.dropScaledOverride(already "stroke")
            } {
                set seen key (legends.count())
                push legends.arr l
            }
            i = (i + 1)
        }
    }

    sfn hidesSymbol:boolean (encode:VlJson) {
        if (! (encode.isObject())) {
            return false
        }
        def symbols:VlJson (encode.get("symbols"))
        if (! (symbols.isObject())) {
            return false
        }
        def update:VlJson (symbols.get("update"))
        if (! (update.isObject())) {
            return false
        }
        def opacity:VlJson (update.get("opacity"))
        if (! (opacity.isObject())) {
            return false
        }
        def value:VlJson (opacity.get("value"))
        if (! (value.isNumber())) {
            return false
        }
        return (value.num == 0.0)
    }

    ; -------------------------------------------------------------- reading ---
    fn readMark:void () {
        def mark:VlJson (source.get("mark"))
        if (mark.isString()) {
            markName = mark.str
            markDef = (VlJson.objectValue())
            return
        }
        if (mark.isObject()) {
            markName = (mark.stringOr("type" ""))
            markDef = mark
            if ((strlen markName) == 0) {
                this.fail("mark has no type")
            }
            return
        }
        this.fail("specification has no mark")
    }

    fn readEncoding:void () {
        def encoding:VlJson (source.get("encoding"))
        if (! (encoding.isObject())) {
            this.fail("specification has no encoding")
            return
        }
        for encoding.keys key:string ki {
            def cdef:VlJson (encoding.get(key))
            def ch (new VlChannel())
            ch.name = key
            ch.def0 = cdef
            ch.defined = true
            ch.field = (cdef.stringOr("field" ""))
            ch.aggregate = (cdef.stringOr("aggregate" ""))
            def aggDef:VlJson (cdef.get("aggregate"))
            if (aggDef.isObject()) {
                for aggDef.keys ak:string ai {
                    ch.aggregate = ak
                    ch.argField = (aggDef.get(ak).asString())
                }
            }
            ch.timeUnit = (cdef.stringOr("timeUnit" ""))
            if (cdef.has("bin")) {
                ch.hasBin = true
                def binDef:VlJson (cdef.get("bin"))
                ; `"bin": "binned"` says the column ALREADY holds bin starts —
                ; a transform upstream did the binning — so there is nothing to
                ; compute here and no bin signal to take a domain from. Read as
                ; a request to bin, the axis asked a signal that was never
                ; published where its range was, and came out one tick short of
                ; the data. It is the same statement as `{"binned": true}`,
                ; written the short way.
                if (binDef.isString()) {
                    if (binDef.str == "binned") {
                        ch.hasBin = false
                        ch.binnedAlready = true
                    }
                }
                if (binDef.isObject()) {
                    if (binDef.boolOr("binned" false)) {
                        ; Already binned upstream. The field keeps its own name
                        ; and its partner channel carries the far edge.
                        ch.hasBin = false
                        ch.binnedAlready = true
                        ch.binStep = (binDef.doubleOr("step" 0.0))
                    } {
                        if (binDef.has("maxbins")) {
                            ch.maxbins = (to_int (binDef.doubleOr("maxbins" 10.0)))
                        }
                        for binDef.keys bk:string bki {
                            if (bk != "maxbins") {
                                this.fail((("a bin written with '" + bk) + "' is not compiled here"))
                            }
                        }
                    }
                }
            }
            ; A channel may leave its type out, and most of the published
            ; examples do. It used to be read as `quantitative` regardless,
            ; which turned `{"field": "variety"}` into a continuous scale over
            ; a column of words: every bar landed at zero and the axis had one
            ; tick on it. The type is inferred from the same three places
            ; Vega-Lite infers it from — the transform on the channel, and
            ; failing that, the data.
            ch.kind = (cdef.stringOr("type" ""))
            if ((strlen ch.kind) == 0) {
                ch.kind = (this.inferKind(ch))
            }
            if (cdef.has("datum")) {
                ch.hasDatum = true
                ch.value = (cdef.get("datum"))
            }
            if (cdef.has("value")) {
                ch.hasValue = true
                ch.value = (cdef.get("value"))
                ; The channel's own value is the FALLBACK — what a row the
                ; condition does not hold for is drawn with. Which of the two
                ; answers a static drawing shows is decided where the condition
                ; is compiled, and decided here as well it was applied twice:
                ; a hover chart that fades every series but one faded none of
                ; them, because the fallback had already become the highlight.
                def cond:VlJson (cdef.get("condition"))
                if (cond.isObject()) {
                    if (cond.has("param")) {
                        ; A condition may name a FIELD rather than a value —
                        ; `{"condition": {"param": "brush", "field":
                        ; "Cylinders"}, "value": "grey"}` is how a chart greys
                        ; out everything outside the brush. The field is what
                        ; the selected rows are painted by, so the channel
                        ; encodes it: it needs a scale to read and a key to
                        ; name it, and without both the branch referred to a
                        ; scale the chart never built.
                        if (cond.has("field")) {
                            ch.field = (cond.stringOr("field" ""))
                            ch.aggregate = (cond.stringOr("aggregate" ""))
                            ch.timeUnit = (cond.stringOr("timeUnit" ""))
                            def condType:string (cond.stringOr("type" ""))
                            if ((strlen condType) > 0) {
                                ch.kind = condType
                            }
                            ch.conditional = true
                        }
                    }
                }
            }
            if ((strlen ch.aggregate) > 0) {
                if ((strlen ch.field) == 0) {
                    ch.field = ""
                }
            }
            if ((strlen ch.timeUnit) > 0) {
                ; The unit is written as one word — `yearmonthdate` — and means
                ; the list of parts it spells out.
                ch.timeUnits = (VlCompile.splitTimeUnit(ch.timeUnit))
                if ((array_length ch.timeUnits) == 0) {
                    this.fail(("the time unit '" + ch.timeUnit) + "' is not one this knows")
                } {
                    for ch.timeUnits tu:string tui {
                        if (! (VlTime.unitKnown(tu))) {
                            this.fail(((("the time unit '" + ch.timeUnit) + "' needs '") + tu) + "', which is not implemented")
                        }
                    }
                }
            }
            push channels ch
        }
    }

    ; ------------------------------------------------------- type inference ---
    ; What a channel that did not say its type must have meant.
    ;
    ; The transform on the channel settles it first, because it decides what
    ; comes out however the column went in: a count is a number, a binning
    ; produces a number, a time unit produces a date. Only when the channel is
    ; a plain field does the DATA get asked, and then the answer is whatever
    ; the column actually holds.
    fn inferKind:string (ch:VlChannel) {
        ; Binned either way: a column of bin starts is a QUANTITY, whoever did
        ; the binning. Read as a category it became a band scale, and a chart
        ; of nine bins was as wide as nine bands rather than as wide as the
        ; range they cover.
        if (ch.isBinned()) { return "quantitative" }
        if ((strlen ch.aggregate) > 0) { return "quantitative" }
        if ((strlen ch.timeUnit) > 0) { return "temporal" }
        ; A channel that names a CONTINUOUS scale has said what its column
        ; holds: `"scale": {"type": "log"}` on a column of frames per second
        ; is a quantity, whatever the raw rows do or do not contain — and the
        ; column may not be in them at all, being one a `calculate` made.
        def stated:VlJson (VlCompile.statedOn(ch "scale"))
        if (stated.isObject()) {
            def kind:string (stated.stringOr("type" ""))
            if ((((kind == "log") || (kind == "linear")) || ((kind == "pow") || (kind == "sqrt"))) || (kind == "symlog")) {
                return "quantitative"
            }
            if ((kind == "time") || (kind == "utc")) {
                return "temporal"
            }
        }
        ; And otherwise NOMINAL, whatever the column holds. This is the
        ; reference's rule and it is worth stating plainly, because the obvious
        ; guess is wrong: a column of the numbers 0, 5, 10 … 90 is read as
        ; ninety-one categories and not as a quantity. Ages in five-year bands
        ; are exactly that — nineteen groups, one bar each — and inferring
        ; `quantitative` from the fact that they are numbers turns the chart
        ; into a scatter of nineteen thin bars on a continuous axis.
        return "nominal"
    }

    ; The rows the specification carries with it, if it carries any. A `url`
    ; was resolved by whoever loaded it — the runtime has no loader — so a
    ; specification that still has one cannot be asked what is in it.
    fn inlineValues:VlJson () {
        def data:VlJson (source.get("data"))
        if (! (data.isObject())) {
            return (new VlJson)
        }
        return (data.get("values"))
    }

    ; A column, classified the way `vega-loader` classifies one: a number is
    ; quantitative, a date is temporal, anything else names a category. Only
    ; the rows that HAVE the field vote — a column that is missing from some
    ; rows is still whatever it is in the rest.
    sfn kindOfColumn:string (values:VlJson field:string) {
        def total:int (values.count())
        def seen:int 0
        def numbers:int 0
        def dates:int 0
        def k:int 0
        while (k < total) {
            def row:VlJson (values.at(k))
            k = (k + 1)
            if (! (row.isObject())) { continue }
            if (! (row.has(field))) { continue }
            def cell:VlJson (row.get(field))
            if (cell.isNull()) { continue }
            seen = (seen + 1)
            if (cell.isNumber()) {
                numbers = (numbers + 1)
            } {
                if (cell.isString()) {
                    if (VlCompile.looksLikeDate(cell.str)) {
                        dates = (dates + 1)
                    }
                }
            }
            ; A hundred rows is enough to tell a column of words from a column
            ; of numbers, and a data set may have a hundred thousand.
            if (seen >= 100) { k = total }
        }
        if (seen == 0) { return "nominal" }
        if (numbers == seen) { return "quantitative" }
        if (dates == seen) { return "temporal" }
        return "nominal"
    }

    ; A date, as written down: "2012", "2012-07", "2012-07-14", any of those
    ; with a time after them. Deliberately narrow — a column of words that
    ; happen to start with digits is not a column of dates, and guessing wrong
    ; here silently turns a bar chart into a time series.
    sfn looksLikeDate:boolean (text:string) {
        def n:int (strlen text)
        if ((n < 4) || (n > 40)) { return false }
        def k:int 0
        while (k < 4) {
            def c:int (charAt text k)
            if ((c < 48) || (c > 57)) { return false }
            k = (k + 1)
        }
        if (n == 4) { return true }
        def sep:int (charAt text 4)
        return (sep == 45)
    }

    ; A scale's name, which is its own inside one chart and the pane's inside a
    ; concatenation.
    fn sname:string (base:string) {
        return (prefix + base)
    }

    ; Did the specification state this dimension as a number? `"width": "container"`
    ; and a step object are both sizes, and neither is one this can use.
    fn sizeGiven:boolean (dimension:string) {
        def given:VlJson (source.get(dimension))
        if (given.isNumber()) {
            return true
        }
        ; `"width": "container"` asks the PAGE how wide the chart should be,
        ; and a drawing that is not on a page has to answer something: the
        ; reference answers with its own default width, and a chart of three
        ; categories laid out from its bands instead came out a sixth of that.
        return (given.isString())
    }


    ; How tall or wide one band was asked to be, in pixels. Twenty is the
    ; reference's own default, and `config.view.step` moves it for the whole
    ; chart — which is how a confusion matrix asks for forty-pixel cells
    ; without saying so on either axis.
    fn stepGiven:double (dimension:string) {
        def given:VlJson (source.get(dimension))
        if (given.isObject()) {
            if (given.has("step")) {
                return (given.doubleOr("step" 20.0))
            }
            this.fail((("a '" + dimension) + "' written as an object needs a `step`"))
        }
        return (this.configView("step" 20.0))
    }

    ; A number from the specification's own configuration, or the default.
    fn configView:double (key:string fallback:double) {
        return (this.configNumber("view" key fallback))
    }

    fn configNumber:double (block:string key:string fallback:double) {
        def config:VlJson (source.get("config"))
        if (! (config.isObject())) {
            return fallback
        }
        def inner:VlJson (config.get(block))
        if (! (inner.isObject())) {
            return fallback
        }
        return (inner.doubleOr(key fallback))
    }

    ; How long a colour ramp is drawn. It runs ALONG the legend, so a key at
    ; the side of a chart is as long as the chart is tall and a key under it is
    ; as wide as the chart is wide — and the two have different floors, 64 and
    ; 100, which are the reference's. Measured against the wrong axis a
    ; trellis's ramp came out twice the reference's length and took the extra
    ; hundred pixels out of the page.
    fn gradientLengthSignal:string (ch:VlChannel) {
        def across:boolean (this.legendRunsAcross(ch))
        if across {
            return (("clamp(" + widthSignal) + ", 100, 200)")
        }
        return (("clamp(" + heightSignal) + ", 64, 200)")
    }

    ; Whether a legend is laid out left to right. A stated `direction` says so
    ; outright; otherwise the side it sits on decides, because a key above or
    ; below a chart has the width to run across and not the height to run down.
    fn legendRunsAcross:boolean (ch:VlChannel) {
        def stated:VlJson (ch.def0.get("legend"))
        def direction:string ""
        def orient:string ""
        if (stated.isObject()) {
            direction = (stated.stringOr("direction" ""))
            orient = (stated.stringOr("orient" ""))
        }
        if ((strlen direction) == 0) {
            direction = (this.configText("legend" "direction" ""))
        }
        if ((strlen orient) == 0) {
            orient = (this.configText("legend" "orient" ""))
        }
        if ((strlen direction) > 0) {
            return (direction == "horizontal")
        }
        return ((orient == "top") || (orient == "bottom"))
    }

    ; Whether the chart asked for no frame round its plotting rectangle. It
    ; may say so in its own `view` block or in the configuration; either way
    ; what it says is a stroke of null, which is not a colour.
    fn viewStrokeRefused:boolean () {
        def view:VlJson (rootSource.get("view"))
        if (! (view.isObject())) {
            view = (source.get("view"))
        }
        if (view.isObject()) {
            if (view.has("stroke")) {
                return ((view.get("stroke")).isNull())
            }
        }
        def config:VlJson (rootSource.get("config"))
        if (! (config.isObject())) {
            config = (source.get("config"))
        }
        if (config.isObject()) {
            def inner:VlJson (config.get("view"))
            if (inner.isObject()) {
                if (inner.has("stroke")) {
                    return ((inner.get("stroke")).isNull())
                }
            }
        }
        return false
    }

    ; The same, for a name rather than a number. It reads the WHOLE chart's
    ; configuration rather than the pane's, because a configuration block is
    ; stated once at the top and applies everywhere below it.
    fn configText:string (block:string key:string fallback:string) {
        def config:VlJson (rootSource.get("config"))
        if (! (config.isObject())) {
            config = (source.get("config"))
        }
        if (! (config.isObject())) {
            return fallback
        }
        def inner:VlJson (config.get(block))
        if (! (inner.isObject())) {
            return fallback
        }
        return (inner.stringOr(key fallback))
    }

    ; The signal a dimension reads. A shared dimension is the chart's own.
    fn sizeSignal:string (dimension:string) {
        if (dimension == "width") {
            return widthSignal
        }
        return heightSignal
    }

    fn channel:VlChannel (name:string) {
        for channels ch:VlChannel ci {
            if (ch.name == name) {
                return ch
            }
        }
        def missing (new VlChannel())
        return missing
    }

    ; The channels that PARTITION rather than place: they decide which panel a
    ; row belongs in, and are otherwise invisible to the chart drawn in it.
    sfn isFacetChannel:boolean (name:string) {
        return (((name == "row") || (name == "column")) || (name == "facet"))
    }

    ; A second position field belongs to the channel it extends, not to one of
    ; its own: it gets no scale, no axis and no line of the description.
    sfn isSecondaryChannel:boolean (name:string) {
        return ((name == "x2") || (name == "y2"))
    }

    fn facetFields:[string] () {
        def out:[string]
        for channels ch:VlChannel ci {
            if (VlCompile.isFacetChannel(ch.name)) {
                if ((strlen ch.field) > 0) {
                    push out ch.field
                }
            }
        }
        return out
    }

    fn hasChannel:boolean (name:string) {
        for channels ch:VlChannel ci {
            if (ch.name == name) {
                return true
            }
        }
        return false
    }

    ; A mark that stacks: the reference stacks a bar and an area by default and
    ; nothing else, because those are the marks whose area means a total.
    fn stacks:boolean () {
        ; A pie is a stack bent into a circle: each wedge starts where the one
        ; before it ended, which is what a stack computes.
        ;
        ; A LABEL round a pie stacks too, for the same reason and over the same
        ; column: it stands at the middle of the wedge it names, and there is
        ; no middle without the two ends. Left unstacked, every label sat at
        ; the far edge of its wedge instead of in the centre of it.
        if (markName == "text") {
            if (this.hasChannel("theta")) {
                return true
            }
            ; …and a label on a stacked BAR stacks for the same reason, when
            ; the chart says so. `"stack": "normalize"` on the label's own x is
            ; a layer asking to be placed the way the bars under it are placed;
            ; read as nothing, every label stood at the far edge of the plot
            ; rather than in the segment it names.
            return ((VlCompile.asksToStack((this.channel("x")))) || (VlCompile.asksToStack((this.channel("y")))))
        }
        return (((markName == "bar") || (markName == "area")) || (markName == "arc"))
    }

    ; A mark on a stack either FILLS its segment or stands at a point in it. A
    ; bar and an area fill it; a label and a dot stand in it, in the middle by
    ; default. `spansBin` is the wrong question to ask here — it is about bins
    ; and leaves an area out, and asking it stacked every area chart to the
    ; middle of its own band.
    fn standsInStack:boolean () {
        if (markName == "text") { return true }
        if (markName == "point") { return true }
        if (markName == "circle") { return true }
        if (markName == "square") { return true }
        return false
    }

    ; Whether a channel STATED that it stacks. `null` and `false` both say the
    ; opposite, and saying nothing is not saying yes.
    sfn asksToStack:boolean (ch:VlChannel) {
        if (! ch.defined) {
            return false
        }
        if (! (ch.def0.has("stack"))) {
            return false
        }
        def given:VlJson (ch.def0.get("stack"))
        if (given.isNull()) {
            return false
        }
        if (given.isBool()) {
            return given.b
        }
        return true
    }

    sfn summative:boolean (op:string) {
        if ((op == "count") || (op == "sum")) {
            return true
        }
        return ((op == "distinct") || ((op == "valid") || (op == "missing")))
    }

    fn decideStack:void () {
        stackField = ""
        stackOffset = "zero"
        if (! (this.stacks())) {
            return
        }
        def measure:VlChannel (this.stackMeasure())
        if (! measure.defined) {
            return
        }
        ; A histogram is already one total per bin: there is nothing to pile up
        ; unless something separates the bars within a bin.
        ; A radial chart is read by comparing wedges, not by walking round the
        ; circle, so its angles start from nothing rather than from each other
        ; — unless the chart says otherwise, and a radial chart that asks for
        ; `"stack": true` is asking for the wedges to go all the way round.
        if (this.hasChannel("radius")) {
            if (! (measure.def0.has("stack"))) {
                return
            }
            if ((measure.def0.get("stack")).isNull()) {
                return
            }
        }
        ; A bar that already says where both its ends are is not stacked: it is
        ; drawn between two values, which is what a Gantt chart is.
        if (this.hasChannel((measure.name + "2"))) {
            return
        }
        ; Only a SUMMATIVE aggregate stacks. Piling up counts or sums says
        ; something — the parts make the whole — and piling up medians, means or
        ; the budget of some particular film says nothing, so the reference
        ; declines to stack those and draws each bar from zero.
        if ((strlen measure.aggregate) > 0) {
            if (! (VlCompile.summative(measure.aggregate))) {
                return
            }
        }
        def binned:VlChannel (this.stackDimension())
        if binned.defined {
            if binned.hasBin {
                if (! (this.hasChannel("color"))) {
                    return
                }
            }
            ; A stack piles bars up WITHIN something. A category, a bin, a
            ; date — some dimension that says which bars belong together. A
            ; chart whose other position channel is a plain number has no such
            ; thing: each bar stands at its own value, and nothing is piled
            ; anywhere unless a colour says so.
            if (this.continuousScale(binned)) {
                if (! (binned.hasBin)) {
                    if (! (this.hasChannel("color"))) {
                        return
                    }
                }
            }
        }
        ; `stack: null` and `stack: false` both mean "do not", and a string
        ; names the offset — "zero", "center", "normalize".
        def declared:VlJson (measure.def0.get("stack"))
        if (declared.isString()) {
            stackOffset = declared.str
        }
        if (measure.def0.has("stack")) {
            if (declared.isNull()) {
                return
            }
            if (declared.isBool()) {
                if (! declared.b) {
                    return
                }
            }
        }
        stackField = (measure.outField())
    }

    ; The channel a stack accumulates: the continuous one of x and y.
    fn stackMeasure:VlChannel () {
        def theta:VlChannel (this.channel("theta"))
        if theta.defined {
            return theta
        }
        def y:VlChannel (this.channel("y"))
        if (y.defined) {
            if (y.isContinuous()) {
                return y
            }
        }
        def x:VlChannel (this.channel("x"))
        if (x.defined) {
            if (x.isContinuous()) {
                return x
            }
        }
        def none (new VlChannel())
        return none
    }

    ; The other axis: what a stack is grouped by.
    fn stackDimension:VlChannel () {
        def measure:VlChannel (this.stackMeasure())
        ; A pie has no other axis: every wedge is in the one stack.
        if (measure.name == "theta") {
            def none (new VlChannel())
            return none
        }
        if (measure.name == "y") {
            return (this.channel("x"))
        }
        return (this.channel("y"))
    }

    ; ------------------------------------------------------------- geometry ---
    ; The padding a band scale gets, which is a property of the MARK: bars stand
    ; apart, a heat map's cells touch, and a tick is a line in the middle of a
    ; wide gap. The outer padding is always half the inner one.
    ; Which marks occupy their whole band rather than sitting on it.
    ; How thick a band-filling mark was told to be, or -1 if nothing said. It
    ; is a constant or it is nothing: a size read from a field is a scale, and
    ; a scale is not a number this can centre a mark on.
    fn statedSize:double () {
        def ch:VlChannel (this.channel("size"))
        if ch.defined {
            if ch.hasValue {
                if (ch.value.isNumber()) {
                    return ch.value.num
                }
            }
            return -1.0
        }
        def given:VlJson (markDef.get("size"))
        if (given.isNumber()) {
            return given.num
        }
        return -1.0
    }

    ; How see-through a dot is by default. Dots are drawn slightly transparent
    ; so that two landing on the same spot can be told apart — but a dot that
    ; stands for a whole GROUP has nothing to overlap with, so an aggregated
    ; chart draws them solid. That is the reference's rule and it is why a plot
    ; of mean ratings per genre came out faded.
    fn dotOpacity:double () {
        for channels ch:VlChannel ci {
            if ((strlen ch.aggregate) > 0) {
                return 1.0
            }
        }
        return 0.7
    }

    ; Does this mark fill the bin it belongs to, or stand at a point in it?
    ; The same distinction `fillsBand` makes for a band scale, and for the same
    ; marks.
    fn spansBin:boolean () {
        return (((markName == "bar") || (markName == "rect")) || (markName == "tick"))
    }

    ; A time unit is an INTERVAL, not an instant: `"timeUnit": "month"` says
    ; this row belongs to March, and a bar drawn for it fills March rather
    ; than standing on the first of it. The transform computes both ends, and
    ; this is the name of the far one — empty when nothing spans it, which is
    ; every mark that is a point on a date rather than a block over one.
    ; A rectangle over a time unit may be told where in the unit its row
    ; STANDS: `"bandPosition": 0` puts it on the boundary rather than across
    ; the middle, so the block is drawn half a unit either side of it. The
    ; reference computes both edges as columns of their own; without them the
    ; bars sat a half month to the right of the ticks they belong to.
    fn unitBandStated:boolean (ch:VlChannel) {
        if ((strlen (this.unitEndFieldPlain(ch))) == 0) {
            return false
        }
        return (ch.def0.has("bandPosition"))
    }

    fn unitOffsetStart:string (ch:VlChannel) {
        return ((ch.outField()) + "_offsetted_rect_start")
    }

    fn unitOffsetEnd:string (ch:VlChannel) {
        return ((ch.outField()) + "_offsetted_rect_end")
    }

    fn unitEndFieldPlain:string (ch:VlChannel) {
        if ((strlen ch.timeUnit) == 0) {
            return ""
        }
        if ((markName != "bar") && (markName != "rect")) {
            return ""
        }
        if (ch.hasBin || ch.binnedAlready) {
            return ""
        }
        ; Only where the dates are a MEASUREMENT. A month on a band scale is
        ; one of twelve categories and the band is already the whole of it.
        if (! (this.continuousScale(ch))) {
            return ""
        }
        if ((ch.name != "x") && (ch.name != "y")) {
            return ""
        }
        ; A chart that named the far end itself is not asking for the unit's.
        def partner:VlChannel (this.channel((ch.name + "2")))
        if partner.defined {
            return ""
        }
        if ((strlen (ch.outField())) == 0) {
            return ""
        }
        return ((ch.outField()) + "_end")
    }

    fn fillsBand:boolean () {
        return (((markName == "bar") || (markName == "rect")) || (markName == "tick"))
    }

    fn bandPaddingInner:double () {
        ; A specification may set the padding for every band scale it draws,
        ; and a heat map that wants its cells to touch says so exactly once.
        def stated:double (this.configNumber("scale" "bandPaddingInner" -1.0))
        if (stated >= 0.0) {
            return stated
        }
        if (markName == "rect") {
            return 0.0
        }
        if (markName == "tick") {
            return 0.25
        }
        ; A grouped bar chart's bands hold a whole sub-band each, so they are
        ; spaced further apart than bands holding a single bar.
        if (this.hasChannel("xOffset")) {
            return 0.2
        }
        return 0.1
    }

    ; The outer padding matches the inner one for a grouped chart and is half
    ; of it otherwise — the reference's own asymmetry.
    fn bandPaddingOuter:double () {
        def stated:double (this.configNumber("scale" "bandPaddingOuter" -1.0))
        if (stated >= 0.0) {
            return stated
        }
        def inner:double (this.bandPaddingInner())
        if (this.hasChannel("xOffset")) {
            return inner
        }
        return (inner / 2.0)
    }

    ; A discrete position channel is a BAND for the marks that fill their band —
    ; a bar, a heat map cell, a tick — and a POINT for the ones that sit on it.
    fn scaleTypeFor:string (ch:VlChannel) {
        if (has forcedTypes ch.name) {
            return (unwrap (get forcedTypes ch.name))
        }
        def declared:VlJson (VlCompile.statedOn(ch "scale"))
        if (declared.isObject()) {
            def named:string (declared.stringOr("type" ""))
            if ((strlen named) > 0) {
                return named
            }
        }
        ; A chart may paint by `stroke` rather than by `color` — that is how a
        ; line with a halo tells its series apart — and a stroke scale is the
        ; same scale under another name. Left out, it was typed like a POSITION
        ; scale, and five lines drawn through it came out the same blue.
        if (((ch.name == "color") || (ch.name == "fill")) || (ch.name == "stroke")) {
            if (ch.isDiscrete()) {
                return "ordinal"
            }
            return "linear"
        }
        if (ch.name == "shape") {
            return "ordinal"
        }
        if (ch.name == "size") {
            return "linear"
        }
        if (ch.isDiscrete()) {
            if (((markName == "bar") || (markName == "rect")) || (markName == "tick")) {
                return "band"
            }
            return "point"
        }
        if (ch.kind == "temporal") {
            return "time"
        }
        return "linear"
    }

    ; Whether the chart is placed on axes at all.
    fn hasPosition:boolean () {
        for channels ch:VlChannel ci {
            if ((ch.name == "x") || (ch.name == "y")) {
                if ((strlen (ch.outField())) > 0) {
                    return true
                }
            }
        }
        return false
    }

    fn sizeAndSignals:void (out:VlJson signals:VlJson) {
        this.sizeOne(out signals (this.channel("x")) "width" "x")
        this.sizeOne(out signals (this.channel("y")) "height" "y")
    }

    fn sizeOne:void (out:VlJson signals:VlJson ch:VlChannel dimension:string axis:string) {
        ; A chart with nothing on ONE axis is one step tall on that axis: a strip
        ; plot is a single row of ticks, not a three-hundred-pixel plot with one
        ; row in it. A chart with nothing on EITHER — a pie — is not a strip
        ; plot, it is a chart drawn some other way, and keeps its full size.
        def empty:boolean (! ch.defined)
        if (! empty) {
            if ((strlen (ch.outField())) == 0) {
                empty = true
            }
        }
        if empty {
            if (this.hasPosition()) {
                out.setMember(dimension (VlJson.numberValue(20.0)))
                return
            }
            out.setMember(dimension (VlJson.numberValue(300.0)))
            return
        }
        def type:string (this.scaleTypeFor(ch))
        ; A discrete scale of EITHER kind sizes the chart from its own steps.
        ; They differ only in the padding: a band leaves room between the bands,
        ; a point has no width to leave room around, so its inner padding is
        ; one whole step and its outer is half of one.
        def banded:boolean ((type == "band") || (type == "point"))
        ; …unless the specification stated the size. A discrete scale sizes the
        ; chart from its steps only when nobody said how big the chart is; a
        ; declared `width` is not a suggestion, and ignoring it drew a
        ; six-category bar chart twenty pixels wide.
        if (this.sizeGiven(dimension)) {
            banded = false
        }
        if banded {
            def step (VlJson.objectValue())
            step.setMember("name" (VlJson.stringValue((prefix + (axis + "_step")))))
            def inner:double (this.bandPaddingInner())
            def outer:double (this.bandPaddingOuter())
            if (type == "point") {
                inner = 1.0
                outer = 0.5
            }
            ; …and the chart may say how much room to leave at the ends. A
            ; histogram of frame times sets its point scale's padding to
            ; nothing, so the first reading sits ON the axis; given the usual
            ; half step either side it was forty pixels wider than it should
            ; be and every tick was in the wrong place.
            def stated:VlJson (VlCompile.statedOn(ch "scale"))
            if (stated.isObject()) {
                def said:VlJson (stated.get("padding"))
                if (said.isNumber()) {
                    outer = said.num
                }
                def saidOuter:VlJson (stated.get("paddingOuter"))
                if (saidOuter.isNumber()) {
                    outer = saidOuter.num
                }
                def saidInner:VlJson (stated.get("paddingInner"))
                if (saidInner.isNumber()) {
                    inner = saidInner.num
                }
            }
            if ((this.hasChannel("xOffset")) && (axis == "x")) {
                ; A band that holds a group of bars is as wide as the group
                ; needs, so its step is computed from the sub-scale rather than
                ; declared: the twenty pixels are per BAR, not per band.
                def sub:string (((("20 * bandspace(domain('" + (this.sname("xOffset"))) + "').length, 0, 0) / (1-") + (VlJson.formatNumber(inner 6))) + ")")
                step.setMember("update" (VlJson.stringValue(sub)))
            } {
                ; Twenty pixels a band unless the specification said otherwise.
                ; `"height": {"step": 16}` is how a chart says how tall each
                ; ROW is rather than how tall the chart is, which is the only
                ; sensible way to size a bar chart whose category count you do
                ; not know when you write it.
                step.setMember("value" (VlJson.numberValue((this.stepGiven(dimension)))))
            }
            push signals.arr step
            def size (VlJson.objectValue())
            size.setMember("name" (VlJson.stringValue((this.sizeSignal(dimension)))))
            def expr:string ((((((("bandspace(domain('" + (this.sname(axis))) + "').length, ") + (VlJson.formatNumber(inner 6))) + ", ") + (VlJson.formatNumber(outer 6))) + ") * ") + (prefix + (axis + "_step")))
            size.setMember("update" (VlJson.stringValue(expr)))
            push signals.arr size
            return
        }
        def given:VlJson (source.get(dimension))
        def value:VlJson (VlJson.numberValue(300.0))
        if (given.isNumber()) {
            value = given
        }
        ; A chart states its size; a PANE of a concatenation or a CELL of a
        ; trellis carries it as a signal instead, because the layout has to
        ; read it.
        if ((this.sizeSignal(dimension)) != dimension) {
            def sig (VlJson.objectValue())
            sig.setMember("name" (VlJson.stringValue((this.sizeSignal(dimension)))))
            sig.setMember("value" value)
            push signals.arr sig
            return
        }
        out.setMember(dimension value)
    }

    ; ----------------------------------------------------------------- data ---
    ; source_0 holds the rows as written; data_0 is what the marks read, after
    ; the transforms the encoding implies. The order is the reference's:
    ; aggregate, then stack, then the validity filter — a filter before the
    ; aggregate would count different rows.
    ; A run of numbers, from a start to a stop by a step. The column it lands
    ; in is called "data" unless the chart says otherwise, which is what the
    ; reference calls it too.
    sfn sequenceTransform:VlJson (given:VlJson) {
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("sequence")))
        t.setMember("start" (VlJson.numberValue((given.doubleOr("start" 0.0)))))
        t.setMember("stop" (VlJson.numberValue((given.doubleOr("stop" 0.0)))))
        t.setMember("step" (VlJson.numberValue((given.doubleOr("step" 1.0)))))
        t.setMember("as" (VlJson.stringValue((given.stringOr("as" "data")))))
        return t
    }

    fn buildData:VlJson () {
        def out (VlJson.arrayValue())
        def src (VlJson.objectValue())
        def sourceName:string "source_0"
        src.setMember("name" (VlJson.stringValue(sourceName)))
        def data:VlJson (source.get("data"))
        ; A chart may declare its rows once, under a name, and then point each
        ; layer at the one it draws: `"datasets": {"falcon": […], "square":
        ; […]}` with `"data": {"name": "falcon"}` on the layer. Read as no data
        ; at all, both layers drew whatever the other one had and the chart was
        ; one series drawn twice.
        ; The rows are taken, not the name: what the layer is pointing at is a
        ; list of values, and the naming of source data sets belongs to the
        ; layer merge, which numbers them and rewrites everything that reads
        ; them. Naming it here instead left the second layer's data set
        ; referred to before it was defined.
        def named:string (data.stringOr("name" ""))
        if ((strlen named) > 0) {
            def sets:VlJson (rootSource.get("datasets"))
            if (sets.isObject()) {
                if (sets.has(named)) {
                    src.setMember("values" (sets.get(named)))
                }
            }
        }
        if (data.has("values")) {
            src.setMember("values" (data.get("values")))
        }
        if (data.has("url")) {
            src.setMember("url" (data.get("url")))
        }
        ; A chart may GENERATE its data rather than be given it — a sequence of
        ; numbers to draw a sine wave over. There is nothing to derive it from,
        ; so the generator and everything after it live in one data set, which
        ; is what the reference writes and where the marks then look.
        def generated:boolean (data.has("sequence"))
        if (! generated) {
            push out.arr src
        }

        def derived (VlJson.objectValue())
        derived.setMember("name" (VlJson.stringValue(dataLabel)))
        derived.setMember("source" (VlJson.stringValue(sourceName)))
        def transforms (VlJson.arrayValue())

        this.pushTimeParse(transforms)
        this.pushSpecTransforms(transforms)
        this.pushDomainOrder(transforms)
        this.pushTimeUnits(transforms)
        this.pushUnitBandOffsets(transforms)
        ; After the time units, because the column it reads is one of theirs: a
        ; list of day names is looked up by the name the instant formats to.
        this.pushStatedOrder(transforms)
        this.pushBin(transforms)
        this.pushAggregate(transforms)
        this.pushImpute(transforms)
        this.pushStack(transforms)
        this.pushValidFilter(transforms)

        ; A derived data set with nothing to derive is not a data set. The
        ; reference points the marks straight at the source, and an extra node
        ; renames every node after it — which is most of what a chart with
        ; nothing to transform differed by.
        if generated {
            def whole (VlJson.arrayValue())
            push whole.arr (VlCompile.sequenceTransform((data.get("sequence"))))
            def si:int 0
            while (si < (transforms.count())) {
                push whole.arr (transforms.at(si))
                si = (si + 1)
            }
            src.setMember("transform" whole)
            push out.arr src
            dataLabel = "source_0"
            dataName = dataLabel
            return out
        }
        if ((transforms.count()) == 0) {
            dataLabel = "source_0"
            dataName = dataLabel
            return out
        }
        derived.setMember("transform" transforms)
        push out.arr derived
        dataName = dataLabel
        return out
    }

    ; The transforms the SPECIFICATION asked for, as opposed to the ones its
    ; encoding implies. They were not read at all: a spec with a `transform`
    ; array compiled to one without it, drew whatever the untransformed data
    ; said, and reported nothing. A filter that removed half the rows simply
    ; did not happen, and the chart looked entirely reasonable.
    ;
    ; They run before the encoding's own, which is the order Vega-Lite states
    ; and the order anyone writing one assumes: a filter is expected to reach
    ; the aggregate below it.
    ;
    ; What is not translated is REFUSED. Vega-Lite has a couple of dozen
    ; transforms and the runtime has ten; the gap is real, and a compiler that
    ; drops the difference silently is worse than one that has never heard of
    ; them.
    fn pushSpecTransforms:void (transforms:VlJson) {
        def own:VlJson (source.get("transform"))
        if (! (own.isArray())) {
            return
        }
        def total:int (own.count())
        def k:int 0
        while (k < total) {
            def t:VlJson (own.at(k))
            k = (k + 1)
            if (t.has("filter")) {
                def written:string (this.predicateExpr((t.get("filter"))))
                if ((strlen written) > 0) {
                    push transforms.arr (VlCompile.filterOf(written))
                }
            } {
                if (t.has("bin")) {
                    ; A binning the SPECIFICATION asked for, rather than one an
                    ; encoding implied. Same two transforms — the field's extent
                    ; has to be known before the boundaries can be chosen — but
                    ; the names come from the spec's own `as`.
                    def bf:string (t.stringOr("field" ""))
                    def bnames:[string] (VlCompile.namesOf((t.get("as")) bf))
                    def base:string (itemAt bnames 0)
                    def bext (VlJson.objectValue())
                    bext.setMember("type" (VlJson.stringValue("extent")))
                    bext.setMember("field" (VlJson.stringValue(bf)))
                    def bsig:string (VlCompile.varName(base))
                    bext.setMember("signal" (VlJson.stringValue((bsig + "_extent"))))
                    push transforms.arr bext
                    def bin (VlJson.objectValue())
                    bin.setMember("type" (VlJson.stringValue("bin")))
                    bin.setMember("field" (VlJson.stringValue(bf)))
                    def binAs (VlJson.arrayValue())
                    push binAs.arr (VlJson.stringValue(base))
                    push binAs.arr (VlJson.stringValue((itemAt bnames 1)))
                    bin.setMember("as" binAs)
                    bin.setMember("signal" (VlJson.stringValue((bsig + "_bins"))))
                    def bfrom (VlJson.objectValue())
                    bfrom.setMember("signal" (VlJson.stringValue((bsig + "_extent"))))
                    bin.setMember("extent" bfrom)
                    bin.setMember("maxbins" (VlJson.numberValue(10.0)))
                    push transforms.arr bin
                } {
                if (t.has("aggregate")) {
                    def ag (VlJson.objectValue())
                    ag.setMember("type" (VlJson.stringValue("aggregate")))
                    if (t.has("groupby")) {
                        ag.setMember("groupby" (t.get("groupby")))
                    } {
                        ag.setMember("groupby" (VlJson.arrayValue()))
                    }
                    VlCompile.spreadAggregate(ag (t.get("aggregate")))
                    push transforms.arr ag
                } {
                if (t.has("joinaggregate")) {
                    ; The same summary, kept BESIDE every row it summarises
                    ; rather than replacing them, which is what lets a bar be
                    ; drawn against its group's maximum.
                    def ja (VlJson.objectValue())
                    ja.setMember("type" (VlJson.stringValue("joinaggregate")))
                    if (t.has("groupby")) {
                        ja.setMember("groupby" (t.get("groupby")))
                    }
                    VlCompile.spreadAggregate(ja (t.get("joinaggregate")))
                    push transforms.arr ja
                } {
                if (t.has("loess")) {
                    ; A smoother over two fields, which REPLACES the data with
                    ; one point per distinct x — so it is emitted as it stands
                    ; and the runtime does the fitting.
                    def lo (VlJson.objectValue())
                    lo.setMember("type" (VlJson.stringValue("loess")))
                    lo.setMember("x" (VlJson.stringValue((t.stringOr("on" "")))))
                    lo.setMember("y" (VlJson.stringValue((t.stringOr("loess" "")))))
                    if (t.has("groupby")) {
                        lo.setMember("groupby" (t.get("groupby")))
                    }
                    if (t.has("bandwidth")) {
                        lo.setMember("bandwidth" (t.get("bandwidth")))
                    }
                    def loNames (VlJson.arrayValue())
                    push loNames.arr (VlJson.stringValue((t.stringOr("on" ""))))
                    push loNames.arr (VlJson.stringValue((t.stringOr("loess" ""))))
                    if (t.has("as")) {
                        loNames = (t.get("as"))
                    }
                    lo.setMember("as" loNames)
                    push transforms.arr lo
                } {
                if (t.has("calculate")) {
                    def f (VlJson.objectValue())
                    f.setMember("type" (VlJson.stringValue("formula")))
                    f.setMember("expr" (VlJson.stringValue((t.stringOr("calculate" "")))))
                    f.setMember("as" (VlJson.stringValue((t.stringOr("as" "")))))
                    push transforms.arr f
                } {
                if (t.has("window")) {
                    ; What a row can see of its neighbours. Written the way
                    ; Vega writes it: parallel lists of ops, fields, params and
                    ; names, with the sort split into two lists of its own.
                    def wn (VlJson.objectValue())
                    wn.setMember("type" (VlJson.stringValue("window")))
                    def wOps (VlJson.arrayValue())
                    def wFields (VlJson.arrayValue())
                    def wAs (VlJson.arrayValue())
                    def wParams (VlJson.arrayValue())
                    def spec:VlJson (t.get("window"))
                    def wCount:int (spec.count())
                    def wi:int 0
                    while (wi < wCount) {
                        def one:VlJson (spec.at(wi))
                        def wOp:string (one.stringOr("op" ""))
                        push wOps.arr (VlJson.stringValue(wOp))
                        ; An operation that reads no column and takes no
                        ; parameter — a row number, a rank, a running total of
                        ; rows — still needs a place in each list, because the
                        ; four lists are read in step. The reference writes a
                        ; null there. Written as an empty name and a one, the
                        ; window read a column nobody has and framed itself
                        ; one row wide.
                        if (one.has("field")) {
                            push wFields.arr (VlJson.stringValue((one.stringOr("field" ""))))
                        } {
                            push wFields.arr (VlJson.nullValue())
                        }
                        push wAs.arr (VlJson.stringValue((one.stringOr("as" (wOp + "_field")))))
                        if (one.has("param")) {
                            push wParams.arr (VlJson.numberValue((one.doubleOr("param" 1.0))))
                        } {
                            push wParams.arr (VlJson.nullValue())
                        }
                        wi = (wi + 1)
                    }
                    wn.setMember("ops" wOps)
                    wn.setMember("fields" wFields)
                    wn.setMember("as" wAs)
                    wn.setMember("params" wParams)
                    wn.setMember("sort" (VlCompile.sortSpec((t.get("sort")))))
                    if (t.has("groupby")) {
                        wn.setMember("groupby" (t.get("groupby")))
                    }
                    if (t.has("frame")) {
                        wn.setMember("frame" (t.get("frame")))
                    }
                    push transforms.arr wn
                } {
                if (t.has("density")) {
                    ; A kernel density estimate, which REPLACES the rows with
                    ; a sampled curve — so it is emitted as it stands and the
                    ; runtime does the estimating.
                    def kd (VlJson.objectValue())
                    kd.setMember("type" (VlJson.stringValue("kde")))
                    kd.setMember("field" (VlJson.stringValue((t.stringOr("density" "")))))
                    for t.keys dk:string dki {
                        if (dk != "density") {
                            kd.setMember(dk (t.get(dk)))
                        }
                    }
                    if (! (t.has("as"))) {
                        def kdNames (VlJson.arrayValue())
                        push kdNames.arr (VlJson.stringValue("value"))
                        push kdNames.arr (VlJson.stringValue("density"))
                        kd.setMember("as" kdNames)
                    }
                    ; Vega-Lite shares one domain across the groups so that
                    ; stacked densities line up on the same sample points.
                    if (! (t.has("resolve"))) {
                        kd.setMember("resolve" (VlJson.stringValue("shared")))
                    }
                    push transforms.arr kd
                } {
                if (t.has("stack")) {
                    ; A stack the SPECIFICATION asked for, rather than one the
                    ; encoding implied. Same transform, and the runtime already
                    ; has it; what it needs is the two names the spec gives the
                    ; running start and end.
                    def sk (VlJson.objectValue())
                    sk.setMember("type" (VlJson.stringValue("stack")))
                    if (t.has("groupby")) {
                        sk.setMember("groupby" (t.get("groupby")))
                    } {
                        sk.setMember("groupby" (VlJson.arrayValue()))
                    }
                    sk.setMember("field" (VlJson.stringValue((t.stringOr("stack" "")))))
                    sk.setMember("sort" (VlCompile.sortSpec((t.get("sort")))))
                    def skNames (VlJson.arrayValue())
                    if (t.has("as")) {
                        skNames = (t.get("as"))
                    } {
                        push skNames.arr (VlJson.stringValue(((t.stringOr("stack" "")) + "_start")))
                        push skNames.arr (VlJson.stringValue(((t.stringOr("stack" "")) + "_end")))
                    }
                    sk.setMember("as" skNames)
                    sk.setMember("offset" (VlJson.stringValue((t.stringOr("offset" "zero")))))
                    push transforms.arr sk
                } {
                if (t.has("flatten")) {
                    ; A column holding a LIST becomes one row per element, the
                    ; rest of the row repeated beside each. It is how data that
                    ; arrived already summarised carries its outliers.
                    def fl (VlJson.objectValue())
                    fl.setMember("type" (VlJson.stringValue("flatten")))
                    fl.setMember("fields" (t.get("flatten")))
                    if (t.has("as")) {
                        fl.setMember("as" (t.get("as")))
                    }
                    push transforms.arr fl
                } {
                if (t.has("fold")) {
                    ; Columns into rows. The `as` pair names the two columns
                    ; that come out — the name of the folded column and its
                    ; value — and defaults to "key" and "value".
                    def fo (VlJson.objectValue())
                    fo.setMember("type" (VlJson.stringValue("fold")))
                    fo.setMember("fields" (t.get("fold")))
                    def foldAs:VlJson (t.get("as"))
                    if (! (foldAs.isArray())) {
                        foldAs = (VlJson.arrayValue())
                        push foldAs.arr (VlJson.stringValue("key"))
                        push foldAs.arr (VlJson.stringValue("value"))
                    }
                    fo.setMember("as" foldAs)
                    push transforms.arr fo
                } {
                if (t.has("pivot")) {
                    ; And rows into columns, which is what lets one row hold
                    ; two years at once so that the difference between them is
                    ; a subtraction rather than a join.
                    def pv (VlJson.objectValue())
                    pv.setMember("type" (VlJson.stringValue("pivot")))
                    pv.setMember("field" (VlJson.stringValue((t.stringOr("pivot" "")))))
                    pv.setMember("value" (VlJson.stringValue((t.stringOr("value" "")))))
                    if (t.has("groupby")) {
                        pv.setMember("groupby" (t.get("groupby")))
                    }
                    if (t.has("op")) {
                        pv.setMember("op" (t.get("op")))
                    }
                    if (t.has("limit")) {
                        pv.setMember("limit" (t.get("limit")))
                    }
                    push transforms.arr pv
                } {
                if (t.has("timeUnit")) {
                    ; A time unit as a TRANSFORM rather than on a channel: the
                    ; same rounding, written where the data is prepared, so
                    ; that everything after it can group by the answer. Both
                    ; ends of the unit come out — the interval a year covers is
                    ; a year, not an instant — under the stated name and that
                    ; name with `_end`.
                    def tu (VlJson.objectValue())
                    tu.setMember("field" (VlJson.stringValue((t.stringOr("field" "")))))
                    tu.setMember("type" (VlJson.stringValue("timeunit")))
                    def tuUnits (VlJson.arrayValue())
                    for (VlCompile.splitTimeUnit((t.stringOr("timeUnit" "")))) unit:string ui {
                        push tuUnits.arr (VlJson.stringValue(unit))
                    }
                    tu.setMember("units" tuUnits)
                    def named:string (t.stringOr("as" ""))
                    if ((strlen named) == 0) {
                        named = ((t.stringOr("timeUnit" "")) + ("_" + (t.stringOr("field" ""))))
                    }
                    def unitAs (VlJson.arrayValue())
                    push unitAs.arr (VlJson.stringValue(named))
                    push unitAs.arr (VlJson.stringValue((named + "_end")))
                    tu.setMember("as" unitAs)
                    push transforms.arr tu
                } {
                    ; The rest name themselves by their leading key, which is
                    ; how Vega-Lite writes a transform, so the refusal can say
                    ; which one it was.
                    this.fail(("the transform '" + (VlCompile.transformName(t))) + "' is not compiled here")
                }
                }
                }
                }
                }
                }
                }
                }
                }
                }
                }
                }
            }
        }
    }

    ; A Vega-Lite aggregate is a list of {op, field, as}; a Vega one is three
    ; parallel lists. `count` names no field, and the reference writes a null
    ; there rather than shortening the list.
    sfn spreadAggregate:void (out:VlJson spec:VlJson) {
        def ops (VlJson.arrayValue())
        def fields (VlJson.arrayValue())
        def names (VlJson.arrayValue())
        def total:int (spec.count())
        def k:int 0
        while (k < total) {
            def one:VlJson (spec.at(k))
            def op:string (one.stringOr("op" "count"))
            push ops.arr (VlJson.stringValue(op))
            if (one.has("field")) {
                push fields.arr (VlJson.stringValue((one.stringOr("field" ""))))
            } {
                push fields.arr (VlJson.nullValue())
            }
            def name:string (one.stringOr("as" ""))
            if ((strlen name) == 0) {
                name = op
                if (one.has("field")) {
                    name = ((op + "_") + (one.stringOr("field" "")))
                }
            }
            push names.arr (VlJson.stringValue(name))
            k = (k + 1)
        }
        out.setMember("ops" ops)
        out.setMember("fields" fields)
        out.setMember("as" names)
    }

    ; The two names a binning writes, from the spec's `as` when it gave one.
    sfn namesOf:[string] (given:VlJson field:string) {
        def out:[string]
        if (given.isArray()) {
            if ((given.count()) > 1) {
                def a:VlJson (given.at(0))
                def b:VlJson (given.at(1))
                push out a.str
                push out b.str
                return out
            }
        }
        if (given.isString()) {
            push out given.str
            push out (given.str + "_end")
            return out
        }
        push out (("bin_maxbins_10_" + field))
        push out ((("bin_maxbins_10_" + field) + "_end"))
        return out
    }

    ; A Vega-Lite `sort` — a list of {field, order} — as the two parallel lists
    ; Vega's own transforms take.
    sfn sortSpec:VlJson (given:VlJson) {
        def out (VlJson.objectValue())
        def fields (VlJson.arrayValue())
        def orders (VlJson.arrayValue())
        if (given.isArray()) {
            def total:int (given.count())
            def k:int 0
            while (k < total) {
                def one:VlJson (given.at(k))
                if (one.isString()) {
                    push fields.arr (VlJson.stringValue(one.str))
                    push orders.arr (VlJson.stringValue("ascending"))
                } {
                    push fields.arr (VlJson.stringValue((one.stringOr("field" ""))))
                    push orders.arr (VlJson.stringValue((one.stringOr("order" "ascending"))))
                }
                k = (k + 1)
            }
        }
        out.setMember("field" fields)
        out.setMember("order" orders)
        return out
    }

    ; Roughly how long a time unit is, in milliseconds — enough to choose a
    ; tick interval with, which is all it is used for. A month is the average
    ; one; the calendar decides where the ticks actually land.
    ; One time unit, as the distance between two dates a unit apart. The base
    ; is the reference's own — the first of January 2001, which is a Monday in
    ; no year in particular — and the far end is that plus one of whatever is
    ; being measured.
    sfn unitStepSignal:string (unit:string) {
        def base:string "datetime(2001, 0, 1, 0, 0, 0, 0)"
        def far:string ""
        if (unit == "year") { far = "datetime(2002, 0, 1, 0, 0, 0, 0)" }
        if (unit == "quarter") { far = "datetime(2001, 3, 1, 0, 0, 0, 0)" }
        if (unit == "month") { far = "datetime(2001, 1, 1, 0, 0, 0, 0)" }
        if (unit == "week") { far = "datetime(2001, 0, 8, 0, 0, 0, 0)" }
        if (unit == "isoweek") { far = "datetime(2001, 0, 8, 0, 0, 0, 0)" }
        if (unit == "date") { far = "datetime(2001, 0, 2, 0, 0, 0, 0)" }
        if (unit == "day") { far = "datetime(2001, 0, 2, 0, 0, 0, 0)" }
        if (unit == "dayofyear") { far = "datetime(2001, 0, 2, 0, 0, 0, 0)" }
        if (unit == "hours") { far = "datetime(2001, 0, 1, 1, 0, 0, 0)" }
        if (unit == "minutes") { far = "datetime(2001, 0, 1, 0, 1, 0, 0)" }
        if (unit == "seconds") { far = "datetime(2001, 0, 1, 0, 0, 1, 0)" }
        if (unit == "milliseconds") { far = "datetime(2001, 0, 1, 0, 0, 0, 1)" }
        if ((strlen far) == 0) {
            return ""
        }
        return ((far + " - ") + base)
    }

    sfn msOfUnit:double (unit:string) {
        if (unit == "year") { return 31536000000.0 }
        if (unit == "quarter") { return 7776000000.0 }
        if (unit == "month") { return 2592000000.0 }
        if (unit == "week") { return 604800000.0 }
        if ((unit == "date") || (unit == "day")) { return 86400000.0 }
        if (unit == "hours") { return 3600000.0 }
        if (unit == "minutes") { return 60000.0 }
        if (unit == "seconds") { return 1000.0 }
        return 0.0
    }

    sfn transformName:string (t:VlJson) {
        for t.keys key:string ki {
            if (key != "as") {
                return key
            }
        }
        return "?"
    }

    ; `yearmonthdate` is three units written as one word, and the words are
    ; matched longest-first because `date` and `day` both begin with `d` and
    ; `milliseconds` begins with `minutes`' first letter. Anything left over
    ; means the whole name was not understood, and an empty answer says so.
    sfn splitTimeUnit:[string] (name:string) {
        def known:[string]
        push known "milliseconds"
        push known "seconds"
        push known "minutes"
        push known "hours"
        push known "quarter"
        push known "month"
        push known "date"
        push known "dayofyear"
        push known "day"
        push known "week"
        push known "year"

        def rest:string name
        ; A `utc` prefix asks for the unit in UTC rather than in the chart's
        ; zone. The zone is already an input here rather than the machine's, so
        ; the prefix names the same thing this already does.
        if ((strlen rest) > 3) {
            if ((substring rest 0 3) == "utc") {
                rest = (substring rest 3 (strlen rest))
            }
        }
        def out:[string]
        def guard:int 0
        while (((strlen rest) > 0) && (guard < 12)) {
            guard = (guard + 1)
            def matched:boolean false
            for known unit:string ui {
                if (! matched) {
                    def n:int (strlen unit)
                    if ((strlen rest) >= n) {
                        if ((substring rest 0 n) == unit) {
                            push out unit
                            rest = (substring rest n (strlen rest))
                            matched = true
                        }
                    }
                }
            }
            if (! matched) {
                def empty:[string]
                return empty
            }
        }
        if ((strlen rest) > 0) {
            def unread:[string]
            return unread
        }
        return out
    }

    ; The transform a time unit needs, before anything aggregates over it: the
    ; field is reduced to the parts the unit names, so that every March becomes
    ; the same instant and can be counted as one.
    fn pushTimeUnits:void (transforms:VlJson) {
        def seen:[string]
        for channels ch:VlChannel ci {
            if ((strlen ch.timeUnit) > 0) {
                if ((strlen ch.field) > 0) {
                    def name:string ((ch.timeUnit + "_") + ch.field)
                    if (! (VlTime.hasUnit(seen name))) {
                        push seen name
                        def t (VlJson.objectValue())
                        t.setMember("field" (VlJson.stringValue(ch.field)))
                        t.setMember("type" (VlJson.stringValue("timeunit")))
                        def units (VlJson.arrayValue())
                        for ch.timeUnits unit:string ui {
                            push units.arr (VlJson.stringValue(unit))
                        }
                        t.setMember("units" units)
                        def names (VlJson.arrayValue())
                        push names.arr (VlJson.stringValue(name))
                        push names.arr (VlJson.stringValue((name + "_end")))
                        t.setMember("as" names)
                        push transforms.arr t
                    }
                }
            }
        }
    }

    ; A date arrives as text and has to become an instant before a scale can
    ; place it, which the reference does with a formula rather than by teaching
    ; the scale to parse.
    fn pushTimeParse:void (transforms:VlJson) {
        def done:[string]
        ; A field a time unit TRANSFORM reads needs the same treatment as one a
        ; channel reads: rounding text to the nearest year answers nothing.
        def stated:VlJson (source.get("transform"))
        if (stated.isArray()) {
            def si:int 0
            while (si < (stated.count())) {
                def one:VlJson (stated.at(si))
                si = (si + 1)
                if (one.has("timeUnit")) {
                    def named:string (one.stringOr("field" ""))
                    if ((strlen named) > 0) {
                        if (! (VlTime.hasUnit(done named))) {
                            push done named
                            def parse (VlJson.objectValue())
                            parse.setMember("type" (VlJson.stringValue("formula")))
                            parse.setMember("expr" (VlJson.stringValue((("toDate(datum[\"" + named) + "\"])"))))
                            parse.setMember("as" (VlJson.stringValue(named)))
                            push transforms.arr parse
                        }
                    }
                }
            }
        }
        for channels ch:VlChannel ci {
            ; A field a time unit reads has to be a date first, whatever the
            ; channel calls its own type — `timeUnit: "month"` with
            ; `type: "ordinal"` is the commonest way anyone writes a chart of
            ; months, and the field arriving as text is the usual case.
            def needsDate:boolean (ch.kind == "temporal")
            if ((strlen ch.timeUnit) > 0) {
                needsDate = true
            }
            if needsDate {
                if ((strlen ch.field) > 0) {
                    if (! (VlTime.hasUnit(done ch.field))) {
                        push done ch.field
                        def t (VlJson.objectValue())
                        t.setMember("type" (VlJson.stringValue("formula")))
                        t.setMember("expr" (VlJson.stringValue((("toDate(datum[\"" + ch.field) + "\"])"))))
                        t.setMember("as" (VlJson.stringValue(ch.field)))
                        push transforms.arr t
                    }
                }
            }
        }
    }

    ; Binning is two transforms and two signals: the field's extent has to be
    ; known before the bin boundaries can be chosen, and the boundaries then
    ; have to be readable by the scale — a binned axis ticks on the bin edges
    ; rather than wherever a tick algorithm would have put them.
    fn pushBin:void (transforms:VlJson) {
        for channels ch:VlChannel ci {
            if ch.hasBin {
                def base:string (ch.outField())
                def sig:string (ch.binSignal())
                def extent (VlJson.objectValue())
                extent.setMember("type" (VlJson.stringValue("extent")))
                extent.setMember("field" (VlJson.stringValue(ch.field)))
                extent.setMember("signal" (VlJson.stringValue((sig + "_extent"))))
                push transforms.arr extent

                def bin (VlJson.objectValue())
                bin.setMember("type" (VlJson.stringValue("bin")))
                bin.setMember("field" (VlJson.stringValue(ch.field)))
                def asNames (VlJson.arrayValue())
                push asNames.arr (VlJson.stringValue(base))
                push asNames.arr (VlJson.stringValue((ch.binEndField())))
                bin.setMember("as" asNames)
                bin.setMember("signal" (VlJson.stringValue((sig + "_bins"))))
                def from (VlJson.objectValue())
                from.setMember("signal" (VlJson.stringValue((sig + "_extent"))))
                bin.setMember("extent" from)
                bin.setMember("maxbins" (VlJson.numberValue((to_double ch.maxbins))))
                push transforms.arr bin
            }
        }
    }

    fn pushAggregate:void (transforms:VlJson) {
        def ops (VlJson.arrayValue())
        def fields (VlJson.arrayValue())
        def asNames (VlJson.arrayValue())
        def groupby (VlJson.arrayValue())
        def any:boolean false
        for channels ch:VlChannel ci {
            if ((strlen ch.aggregate) > 0) {
                any = true
            }
        }
        if (! any) {
            return
        }
        for channels ch2:VlChannel ci2 {
            ; …unless it is a literal AND a field at once: a colour written as
            ; a condition and a fallback names the column the selected rows are
            ; painted by, and an aggregate that did not group by it summarised
            ; every series into one.
            def literalOnly:boolean ch2.hasValue
            if ch2.conditional {
                literalOnly = false
            }
            if literalOnly {
                ; a literal channel is not a field
            } {
                if ((strlen ch2.aggregate) > 0) {
                    push ops.arr (VlJson.stringValue(ch2.aggregate))
                    ; `count` counts rows and so names no field, but the two
                    ; lists stay parallel — the reference writes a null.
                    if (ch2.aggregate == "count") {
                        push fields.arr (VlJson.nullValue())
                    } {
                        ; An arg-op ranks by ONE column and is read for
                        ; another, so the field it aggregates is not the field
                        ; the channel measures.
                        if ((strlen ch2.argField) > 0) {
                            push fields.arr (VlJson.stringValue(ch2.argField))
                        } {
                            push fields.arr (VlJson.stringValue(ch2.field))
                        }
                    }
                    if ((strlen ch2.argField) > 0) {
                        push asNames.arr (VlJson.stringValue(((ch2.aggregate + "_") + ch2.argField)))
                    } {
                        push asNames.arr (VlJson.stringValue((ch2.outField())))
                    }
                } {
                    if (ch2.hasBin) {
                        push groupby.arr (VlJson.stringValue((ch2.outField())))
                        push groupby.arr (VlJson.stringValue((ch2.binEndField())))
                    } {
                        if ((strlen ch2.field) > 0) {
                            ; The derived name, not the raw one: a channel with
                            ; a time unit groups by the truncated field, which
                            ; is the whole reason it was computed.
                            push groupby.arr (VlJson.stringValue((ch2.outField())))
                            ; The far end of a time unit's interval travels
                            ; with the near one: grouped only by the start, the
                            ; column saying where March ends did not survive
                            ; the aggregate and every bar came out standing on
                            ; the first of the month instead of filling it.
                            def unitEnd:string (this.unitEndFieldPlain(ch2))
                            if ((strlen unitEnd) > 0) {
                                push groupby.arr (VlJson.stringValue(unitEnd))
                            }
                            if (this.unitBandStated(ch2)) {
                                push groupby.arr (VlJson.stringValue((this.unitOffsetStart(ch2))))
                                push groupby.arr (VlJson.stringValue((this.unitOffsetEnd(ch2))))
                            }
                            ; An aggregate keeps only what it groups by, so a
                            ; field computed purely to order the stack has to be
                            ; grouped by as well or it does not survive to be
                            ; sorted on. It is constant within the group it
                            ; belongs to, so grouping by it splits nothing.
                            def orderField:string (this.domainOrderField(ch2))
                            if ((strlen orderField) > 0) {
                                push groupby.arr (VlJson.stringValue(orderField))
                            }
                            ; The column holding a value's place in the list
                            ; its channel named travels with the value: an
                            ; aggregate that dropped it left the domain with
                            ; nothing to sort by, and the categories came out
                            ; in the order they were first seen.
                            def statedField:string (this.statedOrderField(ch2))
                            if ((strlen statedField) > 0) {
                                push groupby.arr (VlJson.stringValue(statedField))
                            }
                        }
                    }
                }
            }
        }
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("aggregate")))
        t.setMember("groupby" groupby)
        t.setMember("ops" ops)
        if ((fields.count()) > 0) {
            t.setMember("fields" fields)
        }
        t.setMember("as" asNames)
        push transforms.arr t
    }

    ; An area is a filled shape between two lines, and a shape with a hole in it
    ; is not a shape. A series missing a row at some x would leave one, so the
    ; missing rows are filled in at zero before the stack — which is also what
    ; keeps the stack's own baseline continuous underneath the series above it.
    fn pushImpute:void (transforms:VlJson) {
        if (markName != "area") {
            return
        }
        if ((strlen stackField) == 0) {
            return
        }
        def measure:VlChannel (this.stackMeasure())
        def dimension:VlChannel (this.stackDimension())
        if (! dimension.defined) {
            return
        }
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("impute")))
        t.setMember("field" (VlJson.stringValue((measure.outField()))))
        def groupby (VlJson.arrayValue())
        def colour:VlChannel (this.channel("color"))
        if colour.defined {
            if ((strlen (colour.outField())) > 0) {
                push groupby.arr (VlJson.stringValue((colour.outField())))
            }
        }
        t.setMember("groupby" groupby)
        t.setMember("key" (VlJson.stringValue((dimension.outField()))))
        t.setMember("method" (VlJson.stringValue("value")))
        t.setMember("value" (VlJson.numberValue(0.0)))
        push transforms.arr t
    }

    fn pushStack:void (transforms:VlJson) {
        if ((strlen stackField) == 0) {
            return
        }
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("stack")))
        def groupby (VlJson.arrayValue())
        def dimension:VlChannel (this.stackDimension())
        if dimension.defined {
            if ((strlen (dimension.outField())) > 0) {
                push groupby.arr (VlJson.stringValue((dimension.outField())))
            }
        }
        ; A grouped bar chart stacks inside each sub-band, not across the whole
        ; band: the offset channel is part of what identifies a stack.
        def offset:VlChannel (this.channel("xOffset"))
        if offset.defined {
            if ((strlen (offset.outField())) > 0) {
                push groupby.arr (VlJson.stringValue((offset.outField())))
            }
        }
        ; Every panel of a trellis stacks on its own: a bar in one column knows
        ; nothing about the bars in the next.
        for (this.facetFields()) field:string fi {
            push groupby.arr (VlJson.stringValue(field))
        }
        t.setMember("groupby" groupby)
        t.setMember("field" (VlJson.stringValue(stackField)))
        ; The stack's own order: by the channel that separates the segments,
        ; descending, so the first colour in the legend is the top segment.
        def sortFields (VlJson.arrayValue())
        def sortOrders (VlJson.arrayValue())
        ; An `order` channel says outright which segment goes first, and it
        ; beats anything derived from the colour: a pyramid names its three
        ; pieces in the order they are stacked, and sorted by their names
        ; instead the sky ended up between the two sides of the pyramid.
        def ordering:VlChannel (this.channel("order"))
        if ordering.defined {
            if ((strlen (ordering.outField())) > 0) {
                push sortFields.arr (VlJson.stringValue((ordering.outField())))
                def dir:string "ascending"
                if ((ordering.def0.stringOr("sort" "")) == "descending") {
                    dir = "descending"
                }
                push sortOrders.arr (VlJson.stringValue(dir))
                def sortOrder (VlJson.objectValue())
                sortOrder.setMember("field" sortFields)
                sortOrder.setMember("order" sortOrders)
                t.setMember("sort" sortOrder)
                def asOrdered (VlJson.arrayValue())
                push asOrdered.arr (VlJson.stringValue((stackField + "_start")))
                push asOrdered.arr (VlJson.stringValue((stackField + "_end")))
                t.setMember("as" asOrdered)
                t.setMember("offset" (VlJson.stringValue(stackOffset)))
                push transforms.arr t
                return
            }
        }
        ; What separates the segments. Usually the colour — but a layer that
        ; only LABELS a stack has no colour of its own and says which rows
        ; belong together with `detail` instead. Without it the label layer
        ; stacked in the order the rows arrived while the bars under it stacked
        ; by colour, and every label named the segment beside the one it sat
        ; in.
        def colour:VlChannel (this.channel("color"))
        if (! colour.defined) {
            colour = (this.channel("detail"))
        } {
            if ((strlen colour.field) == 0) {
                colour = (this.channel("detail"))
            }
        }
        if colour.defined {
            if ((strlen colour.field) > 0) {
                ; A stack is ordered by the SCALE's domain when one was given,
                ; not by the field's own values. `domain: ["sun","rain","snow"]`
                ; says what order the segments go in; sorting the strings
                ; instead puts them in alphabetical order, which is a different
                ; chart with the same colours.
                def sortBy:string colour.field
                if ((strlen (this.domainOrderField(colour))) > 0) {
                    sortBy = (this.domainOrderField(colour))
                }
                push sortFields.arr (VlJson.stringValue(sortBy))
                ; A bar's y axis points down the page, so the first colour has
                ; to be stacked last to end up on top. A pie has no inverted
                ; axis and reads the other way — and neither does a bar lying
                ; on its side, whose stack runs left to right along an x axis
                ; that increases in the direction it is read. Sorted as if it
                ; were upright, a horizontal stacked bar came out with its
                ; segments in reverse.
                ; Which end the first colour goes to is decided by the axis the
                ; stack runs along, not by the mark drawn on it: a y axis
                ; points down the page, so the first colour is stacked last to
                ; end up on top, while an x axis and a circle both run in the
                ; direction they are read. Decided by the mark, a pie and the
                ; labels round it stacked in opposite orders and every label
                ; named the wedge across the circle from it.
                def measured:VlChannel (this.stackMeasure())
                def upward:boolean (measured.name == "y")
                if upward {
                    push sortOrders.arr (VlJson.stringValue("descending"))
                } {
                    push sortOrders.arr (VlJson.stringValue("ascending"))
                }
            }
        }
        def sort (VlJson.objectValue())
        sort.setMember("field" sortFields)
        sort.setMember("order" sortOrders)
        t.setMember("sort" sort)
        def asNames (VlJson.arrayValue())
        push asNames.arr (VlJson.stringValue((stackField + "_start")))
        push asNames.arr (VlJson.stringValue((stackField + "_end")))
        t.setMember("as" asNames)
        t.setMember("offset" (VlJson.stringValue(stackOffset)))
        push transforms.arr t
    }

    ; Every value a mark is POSITIONED, PAINTED or SIZED by has to be a finite
    ; number, and the reference checks them all rather than the two that place
    ; the mark: a point whose colour is missing is as undrawable as one whose x
    ; is. The channels are asked in the reference's own order, because the
    ; answer is an expression and two expressions that test the same things in
    ; a different order are not the same string.
    ;
    ; A COUNT is left out: counting produces a number for every group there is,
    ; so there is nothing to check.
    fn validityExpr:string () {
        def out:string ""
        for (VlCompile.validityOrder()) name:string ni {
            def ch:VlChannel (this.channel(name))
            if ch.defined {
                if (! ch.hasValue) {
                    if (ch.aggregate != "count") {
                        if (this.continuousScale(ch)) {
                            def field:string (ch.outField())
                            if ((strlen field) > 0) {
                                if ((strlen out) > 0) {
                                    out = (out + " && ")
                                }
                                out = (out + (VlCompile.validExpr(field)))
                            }
                        }
                    }
                }
            }
        }
        return out
    }

    sfn validityOrder:[string] () {
        def out:[string]
        push out "x"
        push out "y"
        push out "theta"
        push out "radius"
        push out "color"
        push out "fill"
        push out "stroke"
        push out "opacity"
        push out "fillOpacity"
        push out "strokeOpacity"
        push out "strokeWidth"
        push out "size"
        push out "angle"
        return out
    }

    ; One shape drawn through many rows — a line, an area, a trail — is not a
    ; row at a time, and the rows it must skip are marked rather than dropped.
    ; The mark's own `defined` does that; see encodeMark.
    sfn isPathMark:boolean (name:string) {
        if (name == "line") { return true }
        if (name == "area") { return true }
        if (name == "trail") { return true }
        return false
    }

    ; Every continuous field a mark positions by has to be a finite number, and
    ; the reference drops the rows where it is not rather than drawing them at
    ; the origin.
    ; `"config": {"mark": {"invalid": null}}` is a chart asking to KEEP the
    ; rows whose numbers are missing rather than drop them — they are drawn at
    ; the zero of their scale, in whatever colour the chart gives them, which
    ; is how a scatter plot shows what it could not measure. Stated as null
    ; rather than left out: leaving it out is the default, and the default is
    ; to filter.
    fn keepsInvalid:boolean () {
        def block:VlJson (rootSource.get("config"))
        if (! (block.isObject())) {
            block = (source.get("config"))
        }
        if (! (block.isObject())) {
            return false
        }
        def cfg:VlJson (block.get("mark"))
        if (! (cfg.isObject())) {
            return false
        }
        if (! (cfg.has("invalid"))) {
            return false
        }
        return ((cfg.get("invalid")).isNull())
    }

    fn pushValidFilter:void (transforms:VlJson) {
        ; Except along a path, where dropping a row would join across the gap
        ; instead of leaving one. Those rows stay in the data and the mark
        ; steps over them — and the rows are still in the data, so the SCALES
        ; still see them.
        if (VlCompile.isPathMark(markName)) {
            return
        }
        if (this.keepsInvalid()) {
            return
        }
        def expr:string (this.validityExpr())
        if ((strlen expr) == 0) {
            return
        }
        def t (VlJson.objectValue())
        t.setMember("type" (VlJson.stringValue("filter")))
        t.setMember("expr" (VlJson.stringValue(expr)))
        push transforms.arr t
    }

    ; A name safe to use as a signal. A field name is whatever the data called
    ; the column — "IMDB Rating", "Miles_per_Gallon", "Body Mass (g)" — and a
    ; signal name is an identifier in an expression, so everything that is not
    ; a letter, a digit or an underscore becomes an underscore. The FIELD keeps
    ; its own spelling; only the signal is renamed.
    sfn varName:string (text:string) {
        def out:string ""
        def n:int (strlen text)
        def k:int 0
        while (k < n) {
            def c:int (charAt text k)
            k = (k + 1)
            def keep:boolean false
            if ((c >= 48) && (c <= 57)) { keep = true }
            if ((c >= 65) && (c <= 90)) { keep = true }
            if ((c >= 97) && (c <= 122)) { keep = true }
            if (c == 95) { keep = true }
            if keep {
                out = (out + (strfromcode c))
            } {
                out = (out + "_")
            }
        }
        return out
    }

    sfn validExpr:string (field:string) {
        def ref:string (VlCompile.datumRef(field))
        return (((("isValid(" + ref) + ") && isFinite(+") + ref) + ")")
    }

    ; The same question asked the other way about, which is how the reference
    ; writes it where a row is TESTED rather than filtered.
    sfn invalidExpr:string (field:string) {
        def ref:string (VlCompile.datumRef(field))
        return (((("!isValid(" + ref) + ") || !isFinite(+") + ref) + ")")
    }

    ; How an expression names a field. A plain column is `datum["name"]`; a
    ; field that reaches THROUGH a value — the row an arg-op picked out — is
    ; already written with brackets, and wrapping the whole thing in one more
    ; pair produced a string the expression parser could not read.
    sfn datumRef:string (field:string) {
        def open:int (indexOf field "[\"")
        if (open < 0) {
            return (("datum[\"" + field) + "\"]")
        }
        def head:string (substring field 0 open)
        def tail:string (substring field open (strlen field))
        return ((("datum[\"" + head) + "\"]") + tail)
    }

    ; ----------------------------------------------------------- predicates ---
    ; A `filter` written as an OBJECT rather than as an expression. Vega-Lite
    ; lets a filter be a small predicate — a field and a comparison, or several
    ; of those under `and` / `or` / `not` — and most of the published examples
    ; use one, because writing `datum["IMDB Rating"] != null` by hand is not
    ; what a grammar of graphics is for.
    ;
    ; They compile to the expression the runtime already evaluates, so nothing
    ; below this point knows the difference. What cannot be written that way is
    ; refused by name, which is the same bargain the transforms above make.
    ;
    ; Returns "" when it refused, having said why.
    ; A paint channel may be written as a TEST and a fallback:
    ;
    ;   "color": {"condition": {"test": "datum.n < 40", "value": "black"},
    ;             "value": "white"}
    ;
    ; which is one encoding with two answers, and the reference emits it as an
    ; array of them — the first whose test passes wins. Dropping the condition
    ; kept the fallback and painted every label white, which is the failure
    ; this cannot have: a chart that is wrong and says nothing.
    ;
    ; A condition on a PARAMETER is a different thing — it answers to a
    ; selection rather than to the row — and is left alone here.
    fn withCondition:VlJson (ch:VlChannel base:VlJson) {
        def given:VlJson (ch.def0.get("condition"))
        ; A channel may carry SEVERAL conditions, tried in order — a bar that
        ; is outlined thickly when clicked, thinly when hovered, and not at all
        ; otherwise. Read as one object, a list of them was not a condition at
        ; all and the channel silently lost every branch it had.
        def list (VlJson.arrayValue())
        if (given.isArray()) {
            def gi:int 0
            while (gi < (given.count())) {
                push list.arr (given.at(gi))
                gi = (gi + 1)
            }
        } {
            if (given.isObject()) {
                push list.arr given
            }
        }
        if ((list.count()) == 0) {
            return base
        }
        def out (VlJson.arrayValue())
        def i:int 0
        while (i < (list.count())) {
            def cond:VlJson (list.at(i))
            def expr:string ""
            if (cond.has("test")) {
                expr = (this.predicateExpr((cond.get("test"))))
            } {
                ; A condition on a PARAMETER is a test too, once it is asked
                ; what the parameter says with nobody touching the chart. A
                ; selection given an initial value picks rows out of the data —
                ; the four-cylinder cars of 1977 — and those rows are painted
                ; while the rest are grey, which is what the reference draws
                ; before anyone moves a slider.
                if (cond.has("param")) {
                    expr = (this.selectionExpr(cond))
                }
            }
            if ((strlen expr) == 0) {
                return base
            }
            if (expr != "false") {
                def branch:VlJson (this.conditionBranch(ch cond))
                if (! (branch.isObject())) {
                    return base
                }
                ; A branch that is known to hold IS the answer: nothing after
                ; it can be reached, and nothing before it applied. Answered
                ; with the fallback instead, a selection that starts out
                ; matching everything drew the unselected picture.
                if (expr == "true") {
                    if ((out.count()) == 0) {
                        return branch
                    }
                    push out.arr branch
                    return out
                }
                branch.setMember("test" (VlJson.stringValue(expr)))
                push out.arr branch
            }
            i = (i + 1)
        }
        if ((out.count()) == 0) {
            return base
        }
        push out.arr base
        return out
    }

    ; What a conditional channel actually shows in a drawing nobody has touched
    ; yet: the first branch whose condition is known to hold, or the fallback.
    ; A key stands for the mark it names, so it has to be painted with the same
    ; answer the mark is — read from the fallback alone, the key to a chart
    ; that fades on selection was faded when nothing was selected.
    fn resolvedConstant:VlJson (ch:VlChannel) {
        def given:VlJson (ch.def0.get("condition"))
        def list (VlJson.arrayValue())
        if (given.isArray()) {
            def gi:int 0
            while (gi < (given.count())) {
                push list.arr (given.at(gi))
                gi = (gi + 1)
            }
        } {
            if (given.isObject()) {
                push list.arr given
            }
        }
        def i:int 0
        while (i < (list.count())) {
            def cond:VlJson (list.at(i))
            if (cond.has("param")) {
                if ((this.selectionExpr(cond)) == "true") {
                    if (cond.has("value")) {
                        return (cond.get("value"))
                    }
                }
            }
            i = (i + 1)
        }
        return ch.value
    }

    ; What one branch of a conditional channel paints with: a constant, or the
    ; same scale the channel itself reads. Answers a non-object when the branch
    ; cannot be written — a field read through a scale the chart never built.
    fn conditionBranch:VlJson (ch:VlChannel cond:VlJson) {
        def branch (VlJson.objectValue())
        if (cond.has("value")) {
            branch.setMember("value" (cond.get("value")))
            return branch
        }
        ; A condition that names a FIELD reads it through the same scale the
        ; channel already uses — and only if there IS one. A channel whose base
        ; is a constant has no colour scale to read, and a branch that named
        ; one referred to a scale the chart never built.
        if (! (ch.encodes())) {
            return (VlJson.nullValue())
        }
        branch.setMember("scale" (VlJson.stringValue((this.sname("color")))))
        branch.setMember("field" (cond.get("field")))
        return branch
    }

    ; What a selection predicate says about a row when nothing is selected —
    ; which is what a drawing that cannot be clicked on always shows.
    ;
    ; Three cases, and none of them is a guess:
    ;
    ;   * the parameter was given an initial VALUE, so the selection is not
    ;     empty and every row is tested against it, field by field;
    ;   * the store is empty and `empty` was left alone, which means an empty
    ;     selection matches EVERYTHING — the reference's own default, and why
    ;     an unbrushed scatter plot shows all its points rather than none;
    ;   * the store is empty and `"empty": false`, which reverses that: nothing
    ;     matches, which is why a hover highlight is invisible until hovered.
    fn selectionExpr:string (pred:VlJson) {
        def name:string (pred.stringOr("param" ""))
        def param:VlJson (this.paramNamed(name))
        def initial:VlJson (param.get("value"))
        if (initial.isDefined()) {
            def tested:string (this.selectionValueExpr(param initial))
            if ((strlen tested) > 0) {
                return tested
            }
        }
        if (pred.boolOr("empty" true)) {
            return "true"
        }
        return "false"
    }

    ; The parameter of that name, wherever in the specification it was
    ; declared. A layered chart brushes in one layer and filters in another, so
    ; the search is over the whole spec rather than over the layer that asked.
    fn paramNamed:VlJson (name:string) {
        def found (VlJson.objectValue())
        VlCompile.findParam(rootSource name found)
        return found
    }

    sfn findParam:void (node:VlJson name:string into:VlJson) {
        if (into.has("name")) {
            return
        }
        if (node.isArray()) {
            def total:int (node.count())
            def k:int 0
            while (k < total) {
                VlCompile.findParam((node.at(k)) name into)
                k = (k + 1)
            }
            return
        }
        if (! (node.isObject())) {
            return
        }
        def params:VlJson (node.get("params"))
        if (params.isArray()) {
            def n:int (params.count())
            def i:int 0
            while (i < n) {
                def p:VlJson (params.at(i))
                if ((p.stringOr("name" "")) == name) {
                    for p.keys pk:string pi {
                        into.setMember(pk (p.get(pk)))
                    }
                    return
                }
                i = (i + 1)
            }
        }
        for node.keys key:string ki {
            VlCompile.findParam((node.get(key)) name into)
        }
    }

    ; A POINT selection's initial value is a list of rows, each naming the
    ; fields that must match — `[{"Cylinders": 4, "Year": 1977}]` selects the
    ; four-cylinder cars of 1977. An INTERVAL's is a map of channel to range.
    fn selectionValueExpr:string (param:VlJson initial:VlJson) {
        if (initial.isArray()) {
            def out:string ""
            def total:int (initial.count())
            def k:int 0
            while (k < total) {
                def row:VlJson (initial.at(k))
                def one:string ""
                for row.keys field:string fi {
                    def piece:string ((("datum[\"" + field) + "\"] === ") + (this.literalOf((row.get(field)))))
                    if ((strlen one) > 0) {
                        one = ((one + " && ") + piece)
                    } {
                        one = piece
                    }
                }
                if ((strlen one) > 0) {
                    if ((strlen out) > 0) {
                        out = (((out + " || (") + one) + ")")
                    } {
                        out = (("(" + one) + ")")
                    }
                }
                k = (k + 1)
            }
            return out
        }
        if (initial.isObject()) {
            def out:string ""
            for initial.keys channel:string ci {
                def span:VlJson (initial.get(channel))
                if (span.isArray()) {
                    if ((span.count()) == 2) {
                        def ch:VlChannel (this.channel(channel))
                        def field:string ch.field
                        if ((strlen field) > 0) {
                            def piece:string (((((("(datum[\"" + field) + "\"] >= ") + (this.literalOf((span.at(0))))) + " && datum[\"") + field) + "\"] <= ")
                            piece = ((piece + (this.literalOf((span.at(1))))) + ")")
                            if ((strlen out) > 0) {
                                out = ((out + " && ") + piece)
                            } {
                                out = piece
                            }
                        }
                    }
                }
            }
            return out
        }
        return ""
    }

    fn predicateExpr:string (pred:VlJson) {
        if (pred.isString()) {
            return (("(" + pred.str) + ")")
        }
        if (! (pred.isObject())) {
            this.fail("a filter is either an expression string or a predicate object")
            return ""
        }
        if (pred.has("and")) { return (this.joinPredicates((pred.get("and")) " && ")) }
        if (pred.has("or")) { return (this.joinPredicates((pred.get("or")) " || ")) }
        if (pred.has("not")) {
            def inner:string (this.predicateExpr((pred.get("not"))))
            if ((strlen inner) == 0) {
                return ""
            }
            return (("!(" + inner) + ")")
        }
        ; A selection is a predicate about what someone clicked on. There is
        ; nothing here to click on — but that is an ANSWER rather than a
        ; refusal, and it is the same answer the reference gives on its own
        ; first frame, before anybody has touched the chart.
        if (pred.has("param")) {
            return (this.selectionExpr(pred))
        }
        if (pred.has("selection")) {
            this.fail("a filter on a selection needs interaction, which is not compiled here")
            return ""
        }

        def field:string (pred.stringOr("field" ""))
        if ((strlen field) == 0) {
            this.fail("a filter predicate needs a field, or one of and/or/not")
            return ""
        }
        def ref:string (("datum[\"" + field) + "\"]")
        ; A predicate may compare a TIME UNIT of the column rather than the
        ; column: "the first of January", whatever the year. Both sides are
        ; reduced to the same instant in one arbitrary year — the reference
        ; uses 2012, and which year it is cannot matter once both sides use it
        ; — and then compared as numbers.
        if (pred.has("timeUnit")) {
            def units:[string] (VlCompile.splitTimeUnit((pred.stringOr("timeUnit" ""))))
            def reduced:string (VlCompile.unitInstant(ref units))
            if (pred.has("equal")) {
                return (this.unitPredicate(reduced units "===" (pred.get("equal"))))
            }
            if (pred.has("lt")) {
                return (this.unitPredicate(reduced units "<" (pred.get("lt"))))
            }
            if (pred.has("lte")) {
                return (this.unitPredicate(reduced units "<=" (pred.get("lte"))))
            }
            if (pred.has("gt")) {
                return (this.unitPredicate(reduced units ">" (pred.get("gt"))))
            }
            if (pred.has("gte")) {
                return (this.unitPredicate(reduced units ">=" (pred.get("gte"))))
            }
            ; A RANGE is two of those, and either end may be open.
            if (pred.has("range")) {
                def span:VlJson (pred.get("range"))
                if ((! (span.isArray())) || ((span.count()) != 2)) {
                    this.fail("a `range` filter needs a two-element array")
                    return ""
                }
                def parts:string ""
                if (! ((span.at(0)).isNull())) {
                    parts = (this.unitPredicate(reduced units ">=" (span.at(0))))
                }
                if (! ((span.at(1)).isNull())) {
                    def high:string (this.unitPredicate(reduced units "<=" (span.at(1))))
                    if ((strlen parts) > 0) {
                        parts = ((parts + " && ") + high)
                    } {
                        parts = high
                    }
                }
                if ((strlen parts) == 0) {
                    this.fail("a `range` filter open at both ends filters nothing")
                    return ""
                }
                return (("(" + parts) + ")")
            }
            if (pred.has("oneOf")) {
                def set:VlJson (pred.get("oneOf"))
                if (! (set.isArray())) {
                    this.fail("a `oneOf` filter needs an array of values")
                    return ""
                }
                def any:string ""
                def oi:int 0
                while (oi < (set.count())) {
                    def one:string (this.unitPredicate(reduced units "===" (set.at(oi))))
                    if ((strlen any) > 0) {
                        any = ((any + " || ") + one)
                    } {
                        any = one
                    }
                    oi = (oi + 1)
                }
                return (("(" + any) + ")")
            }
            this.fail("a filter predicate with a timeUnit needs a comparison")
            return ""
        }

        ; `valid` is about the row having a usable number at all, which is two
        ; questions and not one: present, and finite.
        if (pred.has("valid")) {
            def want:VlJson (pred.get("valid"))
            if (want.asBool()) {
                return (("(" + (VlCompile.validExpr(field))) + ")")
            }
            return (("!(" + (VlCompile.validExpr(field))) + ")")
        }
        if (pred.has("equal")) { return (this.comparePredicate(ref "===" (pred.get("equal")))) }
        if (pred.has("lt")) { return (this.comparePredicate(ref "<" (pred.get("lt")))) }
        if (pred.has("lte")) { return (this.comparePredicate(ref "<=" (pred.get("lte")))) }
        if (pred.has("gt")) { return (this.comparePredicate(ref ">" (pred.get("gt")))) }
        if (pred.has("gte")) { return (this.comparePredicate(ref ">=" (pred.get("gte")))) }
        if (pred.has("oneOf")) {
            def set:VlJson (pred.get("oneOf"))
            if (! (set.isArray())) {
                this.fail("a `oneOf` filter needs an array of values")
                return ""
            }
            def written:string (this.literalOf(set))
            if ((strlen written) == 0) {
                return ""
            }
            return (((("(indexof(" + written) + ", ") + ref) + ") >= 0)")
        }
        if (pred.has("range")) {
            def span:VlJson (pred.get("range"))
            if ((! (span.isArray())) || ((span.count()) != 2)) {
                this.fail("a `range` filter needs a two-element array")
                return ""
            }
            ; A null bound means the range is open on that side, which is how
            ; Vega-Lite says "everything above 5".
            def lower:VlJson (span.at(0))
            def upper:VlJson (span.at(1))
            def parts:string ""
            if (! (lower.isNull())) {
                parts = (this.comparePredicate(ref ">=" lower))
                if ((strlen parts) == 0) { return "" }
            }
            if (! (upper.isNull())) {
                def high:string (this.comparePredicate(ref "<=" upper))
                if ((strlen high) == 0) { return "" }
                if ((strlen parts) > 0) {
                    parts = ((parts + " && ") + high)
                } {
                    parts = high
                }
            }
            if ((strlen parts) == 0) {
                this.fail("a `range` filter open at both ends filters nothing")
                return ""
            }
            return (("(" + parts) + ")")
        }
        this.fail((("no comparison in the filter predicate on '" + field) + "' is compiled here"))
        return ""
    }

    ; A value reduced to the units the predicate names, as an instant in 2012.
    ; Every unit the predicate does not name is flattened to the same constant,
    ; so what is left compares only what was asked about.
    sfn unitInstant:string (ref:string units:[string]) {
        def year:string "2012"
        def month:string "0"
        def day:string "1"
        def hours:string "0"
        def minutes:string "0"
        def seconds:string "0"
        for units u:string ui {
            if (u == "year") { year = (("year(" + ref) + ")") }
            if (u == "quarter") { month = (("(quarter(" + ref) + ") * 3)") }
            if (u == "month") { month = (("month(" + ref) + ")") }
            if (u == "date") { day = (("date(" + ref) + ")") }
            if (u == "day") { day = (("(day(" + ref) + ") + 1)") }
            if (u == "hours") { hours = (("hours(" + ref) + ")") }
            if (u == "minutes") { minutes = (("minutes(" + ref) + ")") }
            if (u == "seconds") { seconds = (("seconds(" + ref) + ")") }
        }
        def out:string (((("time(datetime(" + year) + ", ") + month) + ", ")
        out = (((((out + day) + ", ") + hours) + ", ") + minutes)
        return ((((out + ", ") + seconds) + ", 0))"))
    }

    ; The other side of that comparison: the value the predicate names, reduced
    ; the same way. It may be a plain number — one month, one hour — or a date
    ; object naming several parts at once.
    fn unitPredicate:string (reduced:string units:[string] op:string want:VlJson) {
        def year:string "2012"
        def month:string "0"
        def day:string "1"
        def hours:string "0"
        def minutes:string "0"
        def seconds:string "0"
        if (want.isObject()) {
            if (want.has("year")) { year = (VlJson.intToText((want.intOr("year" 2012)))) }
            if (want.has("quarter")) { month = (VlJson.intToText((((want.intOr("quarter" 1)) - 1) * 3))) }
            if (want.has("month")) { month = (VlCompile.monthNumber((want.get("month")))) }
            if (want.has("date")) { day = (VlJson.intToText((want.intOr("date" 1)))) }
            if (want.has("day")) { day = (VlJson.intToText(((want.intOr("day" 0)) + 1))) }
            if (want.has("hours")) { hours = (VlJson.intToText((want.intOr("hours" 0)))) }
            if (want.has("minutes")) { minutes = (VlJson.intToText((want.intOr("minutes" 0)))) }
            if (want.has("seconds")) { seconds = (VlJson.intToText((want.intOr("seconds" 0)))) }
        } {
            ; A bare value belongs to the one unit the predicate named.
            def only:string ""
            for units u2:string uj {
                only = u2
            }
            def text:string (VlJson.intToText((to_int (want.asDouble()))))
            if (only == "year") { year = text }
            if (only == "quarter") { month = (VlJson.intToText((((to_int (want.asDouble())) - 1) * 3))) }
            if (only == "month") { month = (VlCompile.monthNumber(want)) }
            if (only == "date") { day = text }
            if (only == "day") { day = (VlJson.intToText(((to_int (want.asDouble())) + 1))) }
            if (only == "hours") { hours = text }
            if (only == "minutes") { minutes = text }
            if (only == "seconds") { seconds = text }
        }
        def other:string (((("time(datetime(" + year) + ", ") + month) + ", ")
        other = (((((other + day) + ", ") + hours) + ", ") + minutes)
        other = ((((other + ", ") + seconds) + ", 0))"))
        return (((reduced + op) + other))
    }

    ; A month as the number `datetime` wants, which counts from zero. A
    ; specification may write it as a number counting from one, or by name.
    sfn monthNumber:string (given:VlJson) {
        if (given.isNumber()) {
            return (VlJson.intToText(((to_int given.num) - 1)))
        }
        def names:[string]
        push names "january"
        push names "february"
        push names "march"
        push names "april"
        push names "may"
        push names "june"
        push names "july"
        push names "august"
        push names "september"
        push names "october"
        push names "november"
        push names "december"
        def wanted:string (VlRegex.lower((given.asString())))
        for names name:string ni {
            if ((substring name 0 3) == (substring wanted 0 3)) {
                return (VlJson.intToText(ni))
            }
        }
        return "0"
    }

    fn joinPredicates:string (list:VlJson glue:string) {
        if (! (list.isArray())) {
            this.fail("an `and` / `or` filter needs an array of predicates")
            return ""
        }
        def total:int (list.count())
        if (total == 0) {
            this.fail("an `and` / `or` filter with nothing in it filters nothing")
            return ""
        }
        def out:string ""
        def k:int 0
        while (k < total) {
            def one:string (this.predicateExpr((list.at(k))))
            if ((strlen one) == 0) {
                return ""
            }
            if (k > 0) {
                out = (out + glue)
            }
            out = (out + one)
            k = (k + 1)
        }
        return (("(" + out) + ")")
    }

    fn comparePredicate:string (ref:string op:string value:VlJson) {
        def written:string (this.literalOf(value))
        if ((strlen written) == 0) {
            return ""
        }
        return (((((("(" + ref) + " ") + op) + " ") + written) + ")")
    }

    ; A value from the specification, written as the expression that produces
    ; it. JSON's own text is that expression for everything scalar and for an
    ; array of scalars, which is why the writer does the work; a date written
    ; as `{"year": 2012}` is not, and is refused rather than compared against
    ; whatever an object stringifies to.
    fn literalOf:string (value:VlJson) {
        if (value.isObject()) {
            this.fail("a filter compared against a date object is not compiled here")
            return ""
        }
        if (value.isNull()) {
            this.fail("a filter compared against null is not compiled here")
            return ""
        }
        def w (new VlJsonWriter())
        return (w.write(value))
    }

    ; --------------------------------------------------------------- scales ---
    fn buildScales:VlJson () {
        def out (VlJson.arrayValue())
        this.pushPositionScale(out (this.channel("x")) "x")
        this.pushPositionScale(out (this.channel("y")) "y")
        this.pushOffsetScale(out)
        this.pushThetaScale(out)
        this.pushRadiusScale(out)
        this.pushShapeScale(out)
        this.pushStrokeDashScale(out)
        this.pushColourScale(out)
        this.pushPaintScale(out "fill")
        this.pushPaintScale(out "stroke")
        this.pushSizeScale(out)
        return out
    }

    ; A dash pattern is a scale like any other: an ordinal one whose outputs
    ; are the five patterns the reference cycles through, from a solid line to
    ; a dot-dash. They are written as lists of on/off lengths, which is what
    ; both renderers already understand — nothing here has to know what a dash
    ; looks like, only which one each series gets.
    fn pushStrokeDashScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("strokeDash"))
        if (! (ch.encodes())) {
            return
        }
        if (ch.hasValue) {
            return
        }
        if (VlCompile.suppressed(ch "scale")) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("strokeDash")))))
        sc.setMember("type" (VlJson.stringValue("ordinal")))
        sc.setMember("domain" (this.domainFor(ch)))
        sc.setMember("range" (VlCompile.dashPatterns()))
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    ; The reference's own five, in its own order.
    sfn dashPatterns:VlJson () {
        def out (VlJson.arrayValue())
        push out.arr (VlCompile.numberList2(1.0 0.0))
        push out.arr (VlCompile.numberList2(4.0 2.0))
        push out.arr (VlCompile.numberList2(2.0 1.0))
        push out.arr (VlCompile.numberList2(1.0 1.0))
        def last (VlJson.arrayValue())
        push last.arr (VlJson.numberValue(1.0))
        push last.arr (VlJson.numberValue(2.0))
        push last.arr (VlJson.numberValue(4.0))
        push last.arr (VlJson.numberValue(2.0))
        push out.arr last
        return out
    }

    sfn numberList2:VlJson (a:double b:double) {
        def out (VlJson.arrayValue())
        push out.arr (VlJson.numberValue(a))
        push out.arr (VlJson.numberValue(b))
        return out
    }

    ; A shape scale is ordinal like a colour scale, and its range is the
    ; reference's own sequence of symbols rather than a palette.
    fn pushShapeScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("shape"))
        if (! ch.defined) {
            return
        }
        if ch.hasValue {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("shape")))))
        sc.setMember("type" (VlJson.stringValue("ordinal")))
        sc.setMember("domain" (this.domainFor(ch)))
        sc.setMember("range" (VlJson.stringValue("symbol")))
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    ; The scale a group of bars is spread across INSIDE its band: a band scale
    ; of its own, one step per bar, with nothing between them.
    fn pushOffsetScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("xOffset"))
        if (! ch.defined) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("xOffset")))))
        sc.setMember("type" (VlJson.stringValue("band")))
        sc.setMember("domain" (this.domainFor(ch)))
        def range (VlJson.objectValue())
        range.setMember("step" (VlJson.numberValue(20.0)))
        sc.setMember("range" range)
        push out.arr sc
    }

    ; A radial chart measures twice: the wedge's ANGLE says one thing and its
    ; LENGTH says another. The length is a square-root scale, because a wedge's
    ; area grows with the square of its radius and area is what a reader judges.
    fn pushRadiusScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("radius"))
        if (! ch.defined) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("radius")))))
        sc.setMember("type" (VlJson.stringValue((this.scaleTypeFor(ch)))))
        sc.setMember("domain" (this.domainFor(ch)))
        def range (VlJson.arrayValue())
        def declared:VlJson (ch.def0.get("scale"))
        def from:double (declared.doubleOr("rangeMin" 0.0))
        push range.arr (VlJson.numberValue(from))
        def outer (VlJson.objectValue())
        outer.setMember("signal" (VlJson.stringValue("min(width,height)/2")))
        push range.arr outer
        sc.setMember("range" range)
        sc.setMember("zero" (VlJson.boolValue(true)))
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    ; A pie's scale is an angle: the whole circle, from nothing.
    fn pushThetaScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("theta"))
        if (! ch.defined) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("theta")))))
        sc.setMember("type" (VlJson.stringValue("linear")))
        sc.setMember("domain" (this.domainFor(ch)))
        def range (VlJson.arrayValue())
        push range.arr (VlJson.numberValue(0.0))
        push range.arr (VlJson.numberValue(6.283185307179586))
        sc.setMember("range" range)
        sc.setMember("zero" (VlJson.boolValue(true)))
        ; …unless the chart said where the angles run. A pyramid is a pie with
        ; a bite taken out of it, and the bite is a stated range.
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    fn pushPositionScale:void (out:VlJson ch:VlChannel axis:string) {
        if (! ch.defined) {
            return
        }
        if ((strlen (ch.outField())) == 0) {
            return
        }
        def type:string (this.scaleTypeFor(ch))
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname(axis)))))
        sc.setMember("type" (VlJson.stringValue(type)))
        sc.setMember("domain" (this.domainFor(ch)))
        if ((type == "band") || (type == "point")) {
            def sized:string "width"
            if (axis == "y") {
                sized = "height"
            }
            if (this.sizeGiven(sized)) {
                ; The chart's size was declared, so the scale spans it rather
                ; than deciding it. A DISCRETE y runs down the page rather than
                ; up it — the first category is at the top, which is the order
                ; a list is read in — where a continuous one is inverted so
                ; that bigger is higher. Inverted too, the categories came out
                ; bottom to top.
                if (axis == "y") {
                    def down (VlJson.arrayValue())
                    push down.arr (VlJson.numberValue(0.0))
                    def tall (VlJson.objectValue())
                    tall.setMember("signal" (VlJson.stringValue((this.sizeSignal("height")))))
                    push down.arr tall
                    sc.setMember("range" down)
                } {
                    sc.setMember("range" (this.positionRange(axis)))
                }
            } {
                def range (VlJson.objectValue())
                def step (VlJson.objectValue())
                step.setMember("signal" (VlJson.stringValue((prefix + (axis + "_step")))))
                range.setMember("step" step)
                sc.setMember("range" range)
            }
            if (type == "point") {
                sc.setMember("padding" (VlJson.numberValue(0.5)))
            } {
                sc.setMember("paddingInner" (VlJson.numberValue((this.bandPaddingInner()))))
                sc.setMember("paddingOuter" (VlJson.numberValue((this.bandPaddingOuter()))))
            }
        } {
            sc.setMember("range" (this.positionRange(axis)))
            if (false) {
            } {
                ; A continuous position scale that does NOT reach zero is
                ; padded by five pixels, so a mark sitting on the lowest value
                ; is not drawn half outside the plot. A scale extended to zero
                ; already has that room and asks for none.
                ; A binned axis already knows where its ticks go — the bin
                ; edges — so it is neither niced nor extended to zero.
                if ch.hasBin {
                    def bins (VlJson.objectValue())
                    def binSig:string (ch.binSignal())
                    bins.setMember("signal" (VlJson.stringValue((binSig + "_bins"))))
                    sc.setMember("bins" bins)
                    sc.setMember("zero" (VlJson.boolValue(false)))
                } {
                if ch.binnedAlready {
                    ; The edges are a fixed step apart and the data says so.
                    def known (VlJson.objectValue())
                    known.setMember("step" (VlJson.numberValue(ch.binStep)))
                    sc.setMember("bins" known)
                    sc.setMember("zero" (VlJson.boolValue(false)))
                } {
                if ((type == "time") || (type == "utc")) {
                    ; A time scale is niced by its own calendar or not at all,
                    ; and it is never extended to zero — zero is 1970, and a
                    ; chart of the last decade does not want the seventies in
                    ; it. Nor is it padded: the reference leaves a date axis
                    ; running exactly from the first instant to the last.
                } {
                    ; A scale told where to run does not get niced: nicing is
                    ; how a scale CHOOSES round ends, and it has been given
                    ; them.
                    if (! (this.domainStated(ch))) {
                        sc.setMember("nice" (VlJson.boolValue(true)))
                    }
                    ; A bar's baseline is zero because its LENGTH is the value;
                    ; a line's is not, because only its height is read.
                    ; A log scale cannot reach zero, so it is never asked to.
                    def reachesZero:boolean false
                    if (type != "log") {
                        reachesZero = (this.zeroFor(ch))
                        sc.setMember("zero" (VlJson.boolValue(reachesZero)))
                    }
                    ; Five pixels of room at the ends, so a BAR sitting on
                    ; the lowest value is not drawn half outside the plot.
                    ; Only a bar: a line or a point at the edge of its own
                    ; scale is where the data put it, and the reference
                    ; leaves it there.
                    if (! reachesZero) {
                        if (markName == "bar") {
                            sc.setMember("padding" (VlJson.numberValue(5.0)))
                        }
                    }
                }
                }
                }
            }
        }
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    ; Was this field written by a `bin` the SPECIFICATION asked for? An
    ; encoding-level bin is already known through `hasBin`; a spec-level one
    ; produces an ordinary-looking field name that nothing downstream would
    ; otherwise recognise as the edge of a bin.
    fn fieldIsSpecBinned:boolean (field:string) {
        if ((strlen field) == 0) {
            return false
        }
        def own:VlJson (source.get("transform"))
        if (! (own.isArray())) {
            return false
        }
        def total:int (own.count())
        def k:int 0
        while (k < total) {
            def t:VlJson (own.at(k))
            if (t.has("bin")) {
                def names:[string] (VlCompile.namesOf((t.get("as")) (t.stringOr("field" ""))))
                for names name:string ni {
                    if (name == field) {
                        return true
                    }
                }
            }
            k = (k + 1)
        }
        return false
    }

    ; The name of the field holding a value's place in its scale's declared
    ; domain, or "" when the scale declared no domain to place it in.
    fn domainOrderField:string (ch:VlChannel) {
        def declared:VlJson (ch.def0.get("scale"))
        if (! (declared.isObject())) {
            return ""
        }
        def domain:VlJson (declared.get("domain"))
        if (! (domain.isArray())) {
            return ""
        }
        ; Only a DISCRETE domain is an order. `"domain": [0, 100]` on a
        ; quantitative scale states the ends of a measurement, and read as a
        ; list of categories it wrote a column holding each row's place in
        ; [0, 100] — a column of −1s that no scale reads and that the
        ; reference does not write.
        if (! (ch.isDiscrete())) {
            return ""
        }
        if ((strlen ch.field) == 0) {
            return ""
        }
        return (("_" + ch.field) + "_sort_index")
    }

    ; …and the formula that computes it. `indexof` over the declared domain,
    ; which is exactly what the reference emits.
    fn pushDomainOrder:void (transforms:VlJson) {
        ; …and only where something reads it. The column exists to order a
        ; STACK by its colours; a chart with no stack has nothing to order, and
        ; a chart whose shape and colour name the same field wrote the same
        ; column twice. Either way the reference writes nothing, and a data set
        ; that exists changes the name of every one after it.
        if ((strlen stackField) == 0) {
            return
        }
        for channels ch:VlChannel ci {
            def name:string (this.domainOrderField(ch))
            if ((strlen name) > 0) {
                def declared:VlJson (ch.def0.get("scale"))
                def domain:VlJson (declared.get("domain"))
                def w (new VlJsonWriter())
                def t (VlJson.objectValue())
                t.setMember("type" (VlJson.stringValue("formula")))
                t.setMember("expr" (VlJson.stringValue(((("indexof(" + (w.write(domain))) + ", datum['") + (ch.field + "'])")))))
                t.setMember("as" (VlJson.stringValue(name)))
                push transforms.arr t
            }
        }
    }

    ; What a channel SAID its scale should be, laid over what was derived from
    ; the data. `{"scale": {"domain": [...], "range": [...]}}` is how anyone
    ; fixes the order of a stack or gives a series its own colours, and it was
    ; being ignored: the domain came out in first-seen order and the range came
    ; out of the default palette, so the colours were the right colours for the
    ; wrong categories.
    ;
    ; `type` is left out of this deliberately — it is read earlier, by
    ; scaleTypeFor, because it decides which branch built the scale at all.
    ; What a channel says about one of its own properties. A conditional
    ; channel says it in the CONDITION — the field, its type, and the scale
    ; that maps it are all written where the condition is written, because the
    ; other branch is a bare colour with nothing to scale. Read from the
    ; channel alone, a chart that named its own five weather colours was drawn
    ; in the default palette.
    sfn statedOn:VlJson (ch:VlChannel key:string) {
        if (ch.def0.has(key)) {
            return (ch.def0.get(key))
        }
        def cond:VlJson (ch.def0.get("condition"))
        if (cond.isArray()) {
            if ((cond.count()) > 0) {
                cond = (cond.at(0))
            }
        }
        if (cond.isObject()) {
            if (cond.has(key)) {
                return (cond.get(key))
            }
        }
        return (VlJson.nullValue())
    }

    ; A domain that names a selection rather than values. `{"domain": {"param":
    ; "brush"}}` means "run this scale over whatever the brush covers", and
    ; while nothing is brushed that is the whole data domain — which is why the
    ; reference emits the ordinary data domain and puts the selection in
    ; `domainRaw` beside it, to be read only once a selection exists. Copied
    ; into `domain` instead it is not a domain at all: the scale had no numbers
    ; to map and the page came out six hundred trillion pixels wide.
    sfn domainNamesParam:boolean (declared:VlJson) {
        if (! (declared.isObject())) {
            return false
        }
        def domain:VlJson (declared.get("domain"))
        if (! (domain.isObject())) {
            return false
        }
        return (domain.has("param"))
    }

    fn applyDeclaredScale:void (sc:VlJson ch:VlChannel) {
        def declared:VlJson (VlCompile.statedOn(ch "scale"))
        if (! (declared.isObject())) {
            return
        }
        for declared.keys key:string ki {
            if (key != "type") {
                ; `rangeMax` is not a key beside the range: it is the far end
                ; OF it. A scale of circle areas told `"rangeMax": 5000` runs
                ; from nothing to five thousand, and written alongside a range
                ; the scale had already computed, the biggest circle came out
                ; at three hundred and sixty-one — the default — with the five
                ; thousand ignored.
                if ((key == "rangeMax") || (key == "rangeMin")) {
                    def span:VlJson (sc.get("range"))
                    if (span.isArray()) {
                        if ((span.count()) > 1) {
                            def at:int 1
                            if (key == "rangeMin") {
                                at = 0
                            }
                            set_at span.arr at (declared.get(key))
                        }
                    }
                } {
                if ((key == "domain") && (VlCompile.domainNamesParam(declared))) {
                    ; The selection the domain follows, written where a
                    ; renderer that has one will look, and nowhere a renderer
                    ; that has none will.
                    def raw (VlJson.objectValue())
                    def sel:string (((declared.get("domain")).get("param")).asString())
                    raw.setMember("signal" (VlJson.stringValue(((sel + "[\"") + (ch.field + "\"]")))))
                    sc.setMember("domainRaw" raw)
                } {
                if (key == "scheme") {
                    ; A named palette is part of the RANGE, not a key beside
                    ; it: `"scale": {"scheme": "category20b"}` asks the scale to
                    ; take its output from that palette, and written anywhere
                    ; else nothing reads it.
                    def named (VlJson.objectValue())
                    named.setMember("scheme" (declared.get("scheme")))
                    sc.setMember("range" named)
                } {
                    sc.setMember(key (declared.get(key)))
                }
                }
                }
            }
        }
    }

    ; The reference's own rule, and it is about the mark rather than the field:
    ; a bar or an area means a quantity measured from nothing, a point or a line
    ; means a position.
    ; Did the channel say where its scale runs? A stated domain settles both
    ; the ends and whether they are nice.
    fn domainStated:boolean (ch:VlChannel) {
        def declared:VlJson (VlCompile.statedOn(ch "scale"))
        if (! (declared.isObject())) {
            return false
        }
        ; A domain that names a selection states nothing about the numbers:
        ; the scale still measures its data, and the selection only narrows it
        ; once there is one.
        if (VlCompile.domainNamesParam(declared)) {
            return false
        }
        return (declared.has("domain"))
    }

    fn zeroFor:boolean (ch:VlChannel) {
        def declared:VlJson (ch.def0.get("scale"))
        if (declared.isObject()) {
            def z:VlJson (declared.get("zero"))
            if (z.isBool()) {
                return z.b
            }
        }
        ; A log scale cannot reach zero, so it never asks to.
        if ((this.scaleTypeFor(ch)) == "log") {
            return false
        }
        ; Nor does a BINNED field, however it came to be binned. A bin already
        ; says where its own range starts, and extending that to zero draws a
        ; chart of empty space with the bars crowded at one end.
        ; …and nor does a field the CHANNEL binned: a bin already says where
        ; its own range starts, and extending that to zero draws a chart of
        ; empty space with the bars crowded at one end. A column a TRANSFORM
        ; binned is a different matter — the chart reads it as a plain number
        ; and so does the reference, which knows nothing about where it came
        ; from.
        if ch.hasBin {
            return false
        }
        if ch.binnedAlready {
            return false
        }
        ; A line or an area is read along one axis and measured up the other.
        ; The axis it is read ALONG starts wherever the data starts; the one it
        ; is measured up starts at nothing, because the height is the value.
        ; A mark with a LENGTH is read along one axis and measured up the other.
        ; The axis it is read along starts wherever the data starts; the one it
        ; is measured up starts at nothing, because the length IS the value. A
        ; bar belongs in this group and was not in it: both of its axes were
        ; extended to zero, which on a chart whose two axes are both numbers
        ; drags the whole plot sideways.
        if (((markName == "line") || (markName == "area")) || (markName == "bar")) {
            if ((strlen stackField) > 0) {
                if ((ch.outField()) == stackField) {
                    return true
                }
            }
            ; The axis it is READ ALONG only starts where the data starts when
            ; there is something to read along — that is, when the other
            ; position channel is continuous too. A horizontal bar over a
            ; column of names has one continuous axis and that axis is its
            ; length, so it starts at nothing.
            def other:VlChannel (this.channel("y"))
            if (ch.name == "y") {
                other = (this.channel("x"))
            }
            if (! other.defined) {
                return true
            }
            if (other.isDiscrete()) {
                return true
            }
            return (ch.name == "y")
        }
        if ((strlen stackField) > 0) {
            if ((ch.outField()) == stackField) {
                return true
            }
        }
        ; Everything else measures from nothing. That is the reference's own
        ; default and it is the way round this used to be written: the marks
        ; that reach zero were listed and the rest fell through to `false`, so
        ; a mark nobody had thought of — an image, a rule — got a scale that
        ; started at its own smallest value and a plot dragged sideways.
        ; Only a mark with a LENGTH is an exception, and it is handled above.
        ;
        ; A view that draws NOTHING is not one of them. The container of a
        ; layered chart compiles its own scales alongside its layers', and it
        ; has no mark to ask: answering for it as though it drew a point put a
        ; zero back into a scale that its two lines had both said not to.
        if ((strlen markName) == 0) {
            return false
        }
        return true
    }

    fn positionRange:VlJson (axis:string) {
        def range (VlJson.arrayValue())
        def signal (VlJson.objectValue())
        if (axis == "x") {
            signal.setMember("signal" (VlJson.stringValue((this.sizeSignal("width")))))
            push range.arr (VlJson.numberValue(0.0))
            push range.arr signal
        } {
            signal.setMember("signal" (VlJson.stringValue((this.sizeSignal("height")))))
            push range.arr signal
            push range.arr (VlJson.numberValue(0.0))
        }
        return range
    }

    ; A stacked channel takes its domain from the two fields the stack wrote,
    ; not from the one it read.
    fn domainFor:VlJson (ch:VlChannel) {
        ; A datum names its own domain: the one value it stands for. Several
        ; layers each naming one is how a repeated chart's key gets its
        ; categories, and the merge unions them.
        if ch.hasDatum {
            def only (VlJson.arrayValue())
            push only.arr ch.value
            return only
        }
        def out (VlJson.objectValue())
        ; A binned axis runs from the first bin's start to the last one's end,
        ; which the bin transform published as a signal — reading the data
        ; instead would stop at the last bin's START.
        if ch.hasBin {
            def sig:string (ch.binSignal())
            out.setMember("signal" (VlJson.stringValue(((("[" + sig) + "_bins.start, ") + sig) + "_bins.stop]")))
            return out
        }
        out.setMember("data" (VlJson.stringValue(dataLabel)))
        ; A stack rewrites the POSITION it stacks, not every channel that
        ; happens to read the same column. A bar coloured by its own length
        ; reads that column twice — once as a position, which the stack turned
        ; into a pair of running totals, and once as a colour, which it did
        ; not — so a colour scale given the running totals ran to the total of
        ; every bar rather than to the longest one.
        ; …and not every position either: only the one the stack was computed
        ; ALONG. A radial chart stacks its angles and measures its radii, over
        ; the same column; given the running totals the radius scale ran to the
        ; total of every wedge rather than to the largest one.
        def measured:VlChannel (this.stackMeasure())
        def stacked:boolean (measured.name == ch.name)
        if (stacked && ((strlen stackField) > 0)) {
            if ((ch.outField()) == stackField) {
                def fields (VlJson.arrayValue())
                push fields.arr (VlJson.stringValue((stackField + "_start")))
                push fields.arr (VlJson.stringValue((stackField + "_end")))
                out.setMember("fields" fields)
                return out
            }
        }
        ; A channel with a second field takes its domain from both of them.
        def second:VlChannel (this.channel((ch.name + "2")))
        if second.defined {
            if ((strlen second.field) > 0) {
                def pair (VlJson.arrayValue())
                push pair.arr (VlJson.stringValue((ch.outField())))
                push pair.arr (VlJson.stringValue((second.outField())))
                out.setMember("fields" pair)
                ; …and a DISCRETE domain drawn from two columns is ordered like
                ; any other. A heat lane's rectangles run from −c/2 to +c/2 on
                ; a band scale of both ends: in their own order the two bands
                ; land wherever the rows happened to arrive, and half the lanes
                ; came out twice as deep as they are.
                if (ch.isDiscrete()) {
                    out.setMember("sort" (this.domainSortFor(ch)))
                }
                return out
            }
        }
        ; …and a channel whose unit is an interval takes its domain from both
        ; ends of it, so a scale of months reaches the end of December rather
        ; than stopping on the first.
        def spanEnd:string (this.unitEndField(ch))
        if ((strlen spanEnd) > 0) {
            def ends (VlJson.arrayValue())
            push ends.arr (VlJson.stringValue((this.unitStartField(ch))))
            push ends.arr (VlJson.stringValue(spanEnd))
            out.setMember("fields" ends)
            return out
        }
        out.setMember("field" (VlJson.stringValue((ch.outField()))))
        if (ch.isDiscrete()) {
            out.setMember("sort" (this.domainSortFor(ch)))
        }
        return out
    }

    ; How a discrete domain is ordered. Ascending by its own values unless the
    ; channel says otherwise, and the interesting form is `"sort": "-x"` — put
    ; the categories in order of what the X CHANNEL measures, biggest first,
    ; which is how a bar chart is told to rank itself.
    fn domainSortFor:VlJson (ch:VlChannel) {
        def given:VlJson (ch.def0.get("sort"))
        if (given.isNull()) {
            ; `"sort": null` is a chart saying its categories are ALREADY in
            ; the order it wants — a waterfall runs Begin, Jan, Feb — and it is
            ; a different statement from saying nothing, which asks for them in
            ; their own order. Read the same, the months came out alphabetical.
            if (ch.def0.has("sort")) {
                return (VlJson.boolValue(false))
            }
            return (VlJson.boolValue(true))
        }
        if (given.isBool()) {
            return given
        }
        if (given.isObject()) {
            return given
        }
        if (given.isString()) {
            def text:string given.str
            if (text == "ascending") { return (VlJson.boolValue(true)) }
            if (text == "descending") {
                def down (VlJson.objectValue())
                down.setMember("order" (VlJson.stringValue("descending")))
                return down
            }
            ; "-x" or "x": the channel to rank by, and which way round.
            def descending:boolean false
            def name:string text
            if ((substring text 0 1) == "-") {
                descending = true
                name = (substring text 1 (strlen text))
            }
            def by:VlChannel (this.channel(name))
            if by.defined {
                def spec (VlJson.objectValue())
                def op:string by.aggregate
                if ((strlen op) == 0) { op = "min" }
                spec.setMember("op" (VlJson.stringValue(op)))
                ; A COUNT counts rows and reads no column, so it names none.
                ; Named as the empty string it was a column nobody has, and
                ; the categories came out in the order they were first seen.
                if ((strlen by.field) > 0) {
                    spec.setMember("field" (VlJson.stringValue(by.field)))
                }
                if descending {
                    spec.setMember("order" (VlJson.stringValue("descending")))
                }
                return spec
            }
        }
        ; An explicit LIST is an order in itself: the categories go in the
        ; order it names, whatever they sort as on their own. It is answered
        ; the way the reference answers it — by a column holding each value's
        ; place in the list, and a domain sorted by that.
        if (given.isArray()) {
            def by:string (this.statedOrderField(ch))
            if ((strlen by) > 0) {
                def spec (VlJson.objectValue())
                spec.setMember("op" (VlJson.stringValue("min")))
                spec.setMember("field" (VlJson.stringValue(by)))
                return spec
            }
        }
        return (VlJson.boolValue(true))
    }

    ; The column holding a value's place in the list its channel named, or ""
    ; when it named none.
    fn statedOrderField:string (ch:VlChannel) {
        if (! ((ch.def0.get("sort")).isArray())) {
            return ""
        }
        if ((strlen (ch.outField())) == 0) {
            return ""
        }
        return (((prefix + (ch.name + "_")) + (ch.outField())) + "_sort_index")
    }

    ; …and the formula that computes it. A plain column is looked up as it
    ; stands; a TIME UNIT is looked up by its name, because a list of days is
    ; written "mon", "tue" and the column holds instants. Both the short name
    ; and the long one are tried, which is what the reference accepts.
    fn pushStatedOrder:void (transforms:VlJson) {
        for channels ch:VlChannel ci {
            def name:string (this.statedOrderField(ch))
            if ((strlen name) > 0) {
                def w (new VlJsonWriter())
                def list:string (w.write((VlCompile.lowerList((ch.def0.get("sort"))))))
                def read:string (VlCompile.datumRef((ch.outField())))
                def expr:string (((("indexof(" + list) + ", ") + read) + ")")
                if ((strlen ch.timeUnit) > 0) {
                    def short:string "%a"
                    def long:string "%A"
                    if (VlCompile.namesMonths(ch.timeUnits)) {
                        short = "%b"
                        long = "%B"
                    }
                    def a1:string (((("indexof(" + list) + ", lower(timeFormat(") + read) + ((", \"" + short) + "\")))"))
                    def a2:string (((("indexof(" + list) + ", lower(timeFormat(") + read) + ((", \"" + long) + "\")))"))
                    expr = ((("max(" + a1) + ", ") + a2) + ")"
                }
                def t (VlJson.objectValue())
                t.setMember("type" (VlJson.stringValue("formula")))
                t.setMember("expr" (VlJson.stringValue(expr)))
                t.setMember("as" (VlJson.stringValue(name)))
                push transforms.arr t
            }
        }
    }

    sfn namesMonths:boolean (units:[string]) {
        for units u:string ui {
            if (u == "month") {
                return true
            }
        }
        return false
    }

    ; The same list, lowercased, so that "Monday" and "mon" both match what a
    ; date formats to.
    sfn lowerList:VlJson (given:VlJson) {
        def out (VlJson.arrayValue())
        def k:int 0
        while (k < (given.count())) {
            push out.arr (VlJson.stringValue((VlRegex.lower((given.at(k).asString())))))
            k = (k + 1)
        }
        return out
    }

    ; A `fill` or `stroke` channel builds the same scale a `color` channel
    ; would, under its own name. Everything downstream — the domain, the
    ; palette, the continuous ramp — is the colour scale's own machinery.
    fn pushPaintScale:void (out:VlJson name:string) {
        def ch:VlChannel (this.channel(name))
        if (! (ch.encodes())) {
            return
        }
        if (ch.hasValue) {
            return
        }
        if (VlCompile.suppressed(ch "scale")) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname(name)))))
        sc.setMember("type" (VlJson.stringValue((this.scaleTypeFor(ch)))))
        sc.setMember("domain" (this.domainFor(ch)))
        sc.setMember("range" (VlJson.stringValue((VlCompile.colourRangeFor(ch)))))
        if (ch.isContinuous()) {
            sc.setMember("interpolate" (VlJson.stringValue("hcl")))
            sc.setMember("zero" (VlJson.boolValue(false)))
        }
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    sfn colourRangeFor:string (ch:VlChannel) {
        if (ch.isContinuous()) {
            return "ramp"
        }
        ; An ORDINAL column has an order — four cylinders is more than three —
        ; so its colours are a ramp through a single hue rather than a set of
        ; unrelated ones. A nominal column has no order and gets the palette.
        if ((VlCompile.statedOn(ch "type")).isString()) {
            if (((VlCompile.statedOn(ch "type")).str) == "ordinal") {
                return "ordinal"
            }
        }
        if (ch.kind == "ordinal") {
            return "ordinal"
        }
        return "category"
    }

    fn pushColourScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("color"))
        if (! (ch.encodes())) {
            return
        }
        if (ch.hasValue) {
            if (! ch.conditional) {
                return
            }
        }
        ; `"scale": null` says the column already holds colours. There is
        ; nothing to map and nothing to be a key to: the values go straight
        ; through, and a legend of red, green and blue named after themselves
        ; would only be seventy-four pixels of restating the bars.
        if (VlCompile.suppressed(ch "scale")) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("color")))))
        def type:string (this.scaleTypeFor(ch))
        sc.setMember("type" (VlJson.stringValue(type)))
        sc.setMember("domain" (this.domainFor(ch)))
        if (ch.isDiscrete()) {
            sc.setMember("range" (VlJson.stringValue((VlCompile.colourRangeFor(ch)))))
        } {
            ; A continuous colour is a ramp, interpolated the way the reference
            ; interpolates it — in a perceptual space, not in RGB.
            def scheme:string "ramp"
            if (markName == "rect") {
                scheme = "heatmap"
            }
            ; A scale with a stated middle is a scale read in two directions,
            ; so it is painted in two — one colour above the middle and another
            ; below it, rather than one ramp through it.
            def declared0:VlJson (ch.def0.get("scale"))
            if (declared0.isObject()) {
                if (declared0.has("domainMid")) {
                    scheme = "diverging"
                }
            }
            sc.setMember("range" (VlJson.stringValue(scheme)))
            sc.setMember("interpolate" (VlJson.stringValue("hcl")))
            sc.setMember("zero" (VlJson.boolValue(false)))
        }
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    fn pushSizeScale:void (out:VlJson) {
        def ch:VlChannel (this.channel("size"))
        if (! ch.defined) {
            return
        }
        if (ch.hasValue) {
            return
        }
        def sc (VlJson.objectValue())
        sc.setMember("name" (VlJson.stringValue((this.sname("size")))))
        sc.setMember("type" (VlJson.stringValue("linear")))
        sc.setMember("domain" (this.domainFor(ch)))
        ; The reference's own bubble sizes: an area of four up to one of 361,
        ; which is a symbol of two pixels across up to one of nineteen.
        def range (VlJson.arrayValue())
        if (markName == "trail") {
            ; A TRAIL's size is a WIDTH in pixels, not an area in square ones:
            ; it is the thickness of the ribbon at that point, and the
            ; reference runs it from one pixel to four. Given a bubble's range
            ; instead, a chart of share prices came out ninety times too thick.
            push range.arr (VlJson.numberValue(1.0))
            push range.arr (VlJson.numberValue(4.0))
        } {
            push range.arr (VlJson.numberValue(4.0))
            ; A chart binned along BOTH axes is a grid of cells, and the
            ; biggest bubble is the one that nearly fills a cell — how big
            ; that is depends on the plot's size and on how many bins there
            ; are, so it is a signal rather than a number. Given the ordinary
            ; nineteen-pixel bubble instead, every dot came out two thirds of
            ; the size the reference draws it.
            def cell:string (this.binCellSignal())
            if ((strlen cell) > 0) {
                push range.arr (VlCompile.signalRef(cell))
            } {
                push range.arr (VlJson.numberValue(361.0))
            }
        }
        sc.setMember("range" range)
        sc.setMember("zero" (VlJson.boolValue(true)))
        ; …unless the specification stated one. A trail asks for widths in
        ; pixels, and the default here is an AREA in square pixels: the
        ; difference is a chart drawn a hundred times too thick.
        this.applyDeclaredScale(sc ch)
        push out.arr sc
    }

    ; How big one cell of a doubly-binned grid is, squared — an area, because
    ; a symbol's size is one. "" when the chart is not a grid of cells.
    fn binCellSignal:string () {
        def x:VlChannel (this.channel("x"))
        def y:VlChannel (this.channel("y"))
        if (! (x.hasBin && y.hasBin)) {
            return ""
        }
        def across:string ((widthSignal + " / ") + (VlCompile.binCount(x)))
        def down:string ((heightSignal + " / ") + (VlCompile.binCount(y)))
        return (((("pow(0.95 * min(" + across) + ", ") + down) + "), 2)")
    }

    ; How many bins a channel's own signal says there are.
    sfn binCount:string (ch:VlChannel) {
        def sig:string (ch.binSignal())
        return ((((((("((" + sig) + "_bins.stop - ") + sig) + "_bins.start) / ") + sig) + "_bins.step)"))
    }

    ; ---------------------------------------------------------------- axes ---
    ; Three of them for a normal chart, and the first is not an axis at all: a
    ; grid is drawn as a separate axis with everything else switched off, so it
    ; can sit UNDER the marks while the labelled axis sits over them.
    fn buildAxes:VlJson () {
        def out (VlJson.arrayValue())
        def x:VlChannel (this.channel("x"))
        def y:VlChannel (this.channel("y"))
        ; `count` names no field and is still an axis — what matters is
        ; whether the channel produces a column, not whether the spec typed one.
        def hasX:boolean (x.defined && ((strlen (x.outField())) > 0))
        def hasY:boolean (y.defined && ((strlen (y.outField())) > 0))
        ; `"axis": null` means the channel keeps its scale and loses its
        ; furniture. A layered chart writes its own row labels as a text mark
        ; and turns the axis off; drawing it anyway puts the labels on twice,
        ; in two different places.
        ; A channel whose axis is off still has a SCALE, and a grid drawn for
        ; the other channel is drawn across that scale's range. So which
        ; channels have scales is remembered before the furniture is turned
        ; off: a stream graph names no y axis and its x grid still runs the
        ; height of the plot.
        def scaleX:boolean hasX
        def scaleY:boolean hasY
        if (VlCompile.suppressed(x "axis")) { hasX = false }
        if (VlCompile.suppressed(y "axis")) { hasY = false }

        ; Grids first and both of them, because a grid is drawn under the
        ; marks and a labelled axis over them; x before y, which is the order
        ; the reference emits and therefore the order they are compared in.
        ; A binned axis has no grid: its own tick marks are the bin edges, and
        ; a grid drawn on them would be a line down every bar.
        ; A grid is drawn for a CONTINUOUS scale — its lines stand for numbers
        ; between the marks — unless the specification asks for one everywhere,
        ; which a heat map does: `"config": {"axis": {"grid": true}}` rules the
        ; cells off from each other.
        ; A channel that turned its axis off turned its grid off with it —
        ; `"axis": null` is the whole of the furniture, not just the labels.
        ; What the OTHER channel's grid runs across is still its scale, which
        ; is why the two questions are asked of different things.
        if hasX {
            if (this.wantsGrid(x)) {
                push out.arr (this.gridAxis("x" "bottom" scaleY "y"))
            }
        }
        if hasY {
            if (this.wantsGrid(y)) {
                push out.arr (this.gridAxis("y" "left" scaleX "x"))
            }
        }
        if hasX {
            push out.arr (this.labelAxis(x "x" "bottom"))
        }
        if hasY {
            push out.arr (this.labelAxis(y "y" "left"))
        }
        return out
    }

    ; Where a turned axis label hangs from. Both answers follow from the angle
    ; and the side, and the one that equals the guide's own default — centre
    ; across, middle down — is left unsaid, which is what the reference leaves
    ; unsaid too.
    sfn turnLabels:void (a:VlJson orient:string) {
        if (! (a.has("labelAngle"))) {
            return
        }
        ; An angle is a direction, not a number of turns: the reference writes
        ; a quarter turn back as 315 and not as -45, and two labels that face
        ; the same way have to be written the same way.
        def turn:double (a.doubleOr("labelAngle" 0.0))
        while (turn < 0.0) { turn = (turn + 360.0) }
        while (turn >= 360.0) { turn = (turn - 360.0) }
        a.setMember("labelAngle" (VlJson.numberValue(turn)))
        def sideways:boolean ((orient == "left") || (orient == "right"))
        def flipped:boolean ((orient == "top") || (orient == "right"))

        ; Across the label's own line: which end of the string meets the axis.
        def align:string "center"
        if ((turn > 0.0) && (turn < 180.0)) { align = "left" }
        if ((turn > 180.0) && (turn < 360.0)) { align = "right" }
        if sideways {
            align = "right"
            if ((turn > 90.0) && (turn < 270.0)) { align = "left" }
            if ((turn == 90.0) || (turn == 270.0)) { align = "center" }
        }
        if flipped {
            if (align == "left") { align = "right" } {
                if (align == "right") { align = "left" }
            }
        }

        ; Down the label's own line: which edge of the glyphs meets the axis.
        def baseline:string "middle"
        if (! sideways) {
            baseline = "bottom"
            if ((turn < 90.0) || (turn > 270.0)) { baseline = "top" }
            if ((turn == 90.0) || (turn == 270.0)) { baseline = "middle" }
        } {
            if (turn == 90.0) { baseline = "top" }
            if (turn == 270.0) { baseline = "bottom" }
        }
        if flipped {
            if (baseline == "top") { baseline = "bottom" } {
                if (baseline == "bottom") { baseline = "top" }
            }
        }

        if (align != "center") {
            if (! (a.has("labelAlign"))) {
                a.setMember("labelAlign" (VlJson.stringValue(align)))
            }
        } {
            if sideways {
                if (! (a.has("labelAlign"))) {
                    a.setMember("labelAlign" (VlJson.stringValue(align)))
                }
            }
        }
        if (baseline != "middle") {
            if (! (a.has("labelBaseline"))) {
                a.setMember("labelBaseline" (VlJson.stringValue(baseline)))
            }
        } {
            if (! sideways) {
                if (! (a.has("labelBaseline"))) {
                    a.setMember("labelBaseline" (VlJson.stringValue(baseline)))
                }
            }
        }
    }

    ; Whether a channel's SCALE runs continuously. The column's type is the
    ; usual answer, but not the only one: a chart may say `"scale": {"type":
    ; "log"}` and say nothing about the type, and a scale nobody could type
    ; from the data was read as a list of categories — its labels turned
    ; upright, its ends centred, and no grid drawn for it at all.
    fn continuousScale:boolean (ch:VlChannel) {
        def kind:string (this.scaleTypeFor(ch))
        if (kind == "band") { return false }
        if (kind == "point") { return false }
        if (kind == "ordinal") { return false }
        return true
    }

    ; What the whole chart's configuration says about one guide property, or
    ; nothing at all if it does not say.
    fn configFlag:VlJson (block:string key:string) {
        def config:VlJson (rootSource.get("config"))
        if (! (config.isObject())) {
            config = (source.get("config"))
        }
        if (! (config.isObject())) {
            return (VlJson.nullValue())
        }
        def inner:VlJson (config.get(block))
        if (! (inner.isObject())) {
            return (VlJson.nullValue())
        }
        return (inner.get(key))
    }

    ; Whether a channel is ruled off. What decides is the SCALE, not the
    ; column: a grid line stands for a number between the marks, and a scale
    ; with a discrete domain has no numbers between its marks. A binned axis
    ; has none either — its own ticks are the bin edges, and a grid drawn on
    ; them is a line down every bar.
    ;
    ; A chart may say either way and its word is final, which is how a bar
    ; chart rules its categories off from each other and how a chart asking to
    ; be read by its marks alone gets no lines at all.
    fn wantsGrid:boolean (ch:VlChannel) {
        def stated:VlJson (ch.def0.get("axis"))
        if (stated.isObject()) {
            def said:VlJson (stated.get("grid"))
            if (said.isBool()) {
                return (said.asBool())
            }
        }
        ; …then what the chart says about every axis it has. A heat map rules
        ; its cells off from each other; a population pyramid says no lines at
        ; all. Both are stated once at the top and both are final.
        def everywhere:VlJson (this.configFlag("axis" "grid"))
        if (everywhere.isBool()) {
            return (everywhere.asBool())
        }
        if (ch.isBinned()) {
            return false
        }
        return (this.continuousScale(ch))
    }

    ; Does the specification's own configuration ask for a grid on every axis?
    fn configSaysGrid:boolean () {
        def config:VlJson (source.get("config"))
        if (! (config.isObject())) {
            return false
        }
        def axisConfig:VlJson (config.get("axis"))
        if (! (axisConfig.isObject())) {
            return false
        }
        return (axisConfig.boolOr("grid" false))
    }

    ; Did the channel ask for this piece of furniture to be left off? Written
    ; as `null` — not `false`, which Vega-Lite does not accept here either.
    sfn suppressed:boolean (ch:VlChannel key:string) {
        if (! ch.defined) {
            return false
        }
        if (! (ch.def0.has(key))) {
            ; A conditional channel says what it reads in the CONDITION — the
            ; field, its type, and whether it wants a key drawn for it. Read
            ; only from the channel, a `"legend": null` written where the field
            ; is written was never seen, and a hover chart grew a key for a
            ; colour nothing is meant to look up.
            def cond:VlJson (ch.def0.get("condition"))
            if (cond.isArray()) {
                if ((cond.count()) > 0) {
                    cond = (cond.at(0))
                }
            }
            if (cond.isObject()) {
                if (cond.has(key)) {
                    return ((cond.get(key)).isNull())
                }
            }
            return false
        }
        def given:VlJson (ch.def0.get(key))
        return (given.isNull())
    }

    sfn refusesGrid:boolean (ch:VlChannel) {
        def given:VlJson (ch.def0.get("axis"))
        if (! (given.isObject())) {
            return false
        }
        def grid:VlJson (given.get("grid"))
        if (grid.isBool()) {
            return (! (grid.asBool()))
        }
        return false
    }

    fn logGrid:boolean (scale:string) {
        def ch:VlChannel (this.channel(scale))
        if (! ch.defined) {
            return false
        }
        return ((this.scaleTypeFor(ch)) == "log")
    }

    fn gridAxis:VlJson (scale:string orient:string crosses:boolean other:string) {
        def a (VlJson.objectValue())
        a.setMember("scale" (VlJson.stringValue((this.sname(scale)))))
        a.setMember("orient" (VlJson.stringValue(orient)))
        if crosses {
            a.setMember("gridScale" (VlJson.stringValue((this.sname(other)))))
        }
        a.setMember("grid" (VlJson.boolValue(true)))
        ; A grid is drawn at the axis's ticks, so an axis that names its own
        ; tick values names the grid's too. Left to count ticks by the plot's
        ; width, the grid crossed a chart of three stated values in four
        ; places.
        def gridded:VlChannel (this.channel(scale))
        def stated:VlJson (gridded.def0.get("axis"))
        if (stated.isObject()) {
            if (stated.has("values")) {
                a.setMember("values" (stated.get("values")))
            }
            if (stated.has("tickCount")) {
                a.setMember("tickCount" (stated.get("tickCount")))
            }
            ; Where in its band a tick stands is a property of the tick, so a
            ; grid drawn at the same ticks stands in the same place.
            if (stated.has("bandPosition")) {
                a.setMember("bandPosition" (stated.get("bandPosition")))
            }
            ; …and so is how far the whole axis stands off the plot. The grid
            ; itself does not move — it crosses the plot and never left it —
            ; but the axis it belongs to is measured from the same place as
            ; the labelled one, and the two disagreeing put the gridlines of a
            ; questionnaire fifty pixels from its rows.
            if (stated.has("offset")) {
                a.setMember("offset" (stated.get("offset")))
            }
        }
        if (! (a.has("values"))) {
            if (! (a.has("tickCount"))) {
                ; A grid over a band or a point scale has one line per value
                ; and nothing to count; a log scale's ticks are the whole
                ; multiples inside each decade, which is also not a count.
                if (this.continuousScale(gridded)) {
                    if (! (this.logGrid(scale))) {
                        if (! (VlCompile.cycleUnit(gridded.timeUnit))) {
                            a.setMember("tickCount" (this.tickCountSignal(orient)))
                        }
                    }
                }
            }
        }
        ; A grid on a time axis is ruled at the unit's own boundaries, so it
        ; needs the same floor under its step that the labelled axis has.
        if ((strlen gridded.timeUnit) > 0) {
            def step:string (VlCompile.unitStepSignal((VlTime.finestUnit(gridded.timeUnits))))
            if ((strlen step) > 0) {
                a.setMember("tickMinStep" (VlCompile.signalRef(step)))
            }
        }
        a.setMember("domain" (VlJson.boolValue(false)))
        a.setMember("labels" (VlJson.boolValue(false)))
        a.setMember("aria" (VlJson.boolValue(false)))
        a.setMember("maxExtent" (VlJson.numberValue(0.0)))
        a.setMember("minExtent" (VlJson.numberValue(0.0)))
        a.setMember("ticks" (VlJson.boolValue(false)))
        a.setMember("zindex" (VlJson.numberValue(0.0)))
        this.gridCondition(a scale)
        return a
    }

    ; A grid line's paint may answer to the tick it is drawn at:
    ;
    ;   "gridColor": {"condition": {"test": "datum.value === 0",
    ;                               "value": "black"}, "value": "#ddd"}
    ;
    ; is how a chart of negative values draws a black zero line without an axis
    ; domain. The reference does not keep it as `gridColor` — a conditional is
    ; not a colour — but moves it onto the grid mark's own encoding, where a
    ; branch can be tested per tick.
    ; The same for the parts of the LABELLED axis: a chart may paint the tick
    ; and the label at each January black and leave the rest of them out, which
    ; is how a year is marked on an axis of days. Written only for the grid,
    ; every tick came out the default grey.
    fn labelCondition:void (a:VlJson ch:VlChannel) {
        def given:VlJson (ch.def0.get("axis"))
        if (! (given.isObject())) {
            return
        }
        def encode (VlJson.objectValue())
        def labels (VlJson.objectValue())
        VlCompile.gridBranch(labels given "labelColor" "fill" (this))
        VlCompile.gridBranch(labels given "labelOpacity" "opacity" (this))
        if ((array_length labels.keys) > 0) {
            def labelEncode (VlJson.objectValue())
            labelEncode.setMember("update" labels)
            encode.setMember("labels" labelEncode)
        }
        def ticks (VlJson.objectValue())
        VlCompile.gridBranch(ticks given "tickColor" "stroke" (this))
        VlCompile.gridBranch(ticks given "tickOpacity" "strokeOpacity" (this))
        if ((array_length ticks.keys) > 0) {
            def tickEncode (VlJson.objectValue())
            tickEncode.setMember("update" ticks)
            encode.setMember("ticks" tickEncode)
        }
        if ((array_length encode.keys) == 0) {
            return
        }
        a.setMember("encode" encode)
    }

    fn gridCondition:void (a:VlJson scale:string) {
        def ch:VlChannel (this.channel(scale))
        if (! ch.defined) {
            return
        }
        def given:VlJson (ch.def0.get("axis"))
        if (! (given.isObject())) {
            return
        }
        def update (VlJson.objectValue())
        VlCompile.gridBranch(update given "gridColor" "stroke" (this))
        VlCompile.gridBranch(update given "gridOpacity" "strokeOpacity" (this))
        VlCompile.gridBranch(update given "gridWidth" "strokeWidth" (this))
        VlCompile.gridBranch(update given "gridDash" "strokeDash" (this))
        ; `count` is a list's length; an object's members are its keys.
        if ((array_length update.keys) == 0) {
            return
        }
        def gridEncode (VlJson.objectValue())
        gridEncode.setMember("update" update)
        def encode (VlJson.objectValue())
        encode.setMember("grid" gridEncode)
        a.setMember("encode" encode)
    }

    sfn gridBranch:void (update:VlJson given:VlJson key:string channel:string owner:VlCompile) {
        def stated:VlJson (given.get(key))
        if (! (stated.isObject())) {
            return
        }
        def cond:VlJson (stated.get("condition"))
        if (! (cond.isObject())) {
            return
        }
        if (! (cond.has("test"))) {
            return
        }
        def expr:string (owner.predicateExpr((cond.get("test"))))
        if ((strlen expr) == 0) {
            return
        }
        def branch (VlJson.objectValue())
        branch.setMember("test" (VlJson.stringValue(expr)))
        branch.setMember("value" (cond.get("value")))
        def out (VlJson.arrayValue())
        push out.arr branch
        push out.arr (VlCompile.literal((stated.get("value"))))
        update.setMember(channel out)
    }

    fn labelAxis:VlJson (ch:VlChannel scale:string orient:string) {
        def a (VlJson.objectValue())
        a.setMember("scale" (VlJson.stringValue((this.sname(scale)))))
        a.setMember("orient" (VlJson.stringValue(orient)))
        a.setMember("grid" (VlJson.boolValue(false)))
        ; An axis measuring a channel with two ends names both of them.
        def axisTitle:string (ch.title())
        ; A stated title is the whole title, and a stated EMPTY title is a
        ; chart asking for no name at all — which is not the same as saying
        ; nothing. Read as silence it was given the column's name back, and
        ; the axis reserved a line of page for it.
        def ownTitle:VlJson (ch.def0.get("title"))
        if (ownTitle.isString()) {
            axisTitle = ownTitle.str
        }
        def secondary:VlChannel (this.channel((ch.name + "2")))
        if (secondary.defined && (! (ownTitle.isString()))) {
            if ((strlen secondary.field) > 0) {
                ; …unless the second channel is the far edge of a BIN. A binned
                ; axis has two fields because a bin has two ends, and naming
                ; both of them titles the axis "IMDB Rating, bin_IMDB_Rating_end".
                ; A COMPUTED bin's far edge is an internal name — appending
                ; it titles the axis "IMDB Rating, bin_IMDB_Rating_end" — but a
                ; pre-binned pair is two columns the specification named
                ; itself, and the reference names both of them.
                def binPair:boolean ch.hasBin
                ; …nor when the channel NAMED itself. A stated title is the
                ; whole title; appending the other end's field name to it
                ; produces "Percentage, nx2".
                def named:boolean ((strlen (ch.def0.stringOr("title" ""))) > 0)
                if ((! binPair) && (! named)) {
                    axisTitle = ((axisTitle + ", ") + (secondary.title()))
                }
            }
        }
        ; `"title": null` is a channel asking for no name on its axis, which is
        ; what a chart writes when the column's name would say less than the
        ; drawing already does. It is not the same as an absent title, which
        ; means "call it whatever the column is called".
        ; …and a chart may say it once for every axis it has, which is what a
        ; drawing whose columns are obvious writes. An empty name is no name
        ; either: the reference writes nothing rather than an empty string.
        def titledEverywhere:VlJson (this.configFlag("axis" "title"))
        def refusedEverywhere:boolean (titledEverywhere.isNull())
        if (! (titledEverywhere.isDefined())) {
            refusedEverywhere = false
        }
        if refusedEverywhere {
            ; nothing to call it
        } {
        if ((strlen axisTitle) == 0) {
            ; nor anything to call it
        } {
        if (! (VlCompile.suppressed(ch "title"))) {
            a.setMember("title" (VlJson.stringValue(axisTitle)))
        }
        }
        }
        def given:VlJson (ch.def0.get("axis"))
        if (given.isObject()) {
            for given.keys key:string ki {
                ; A stated `grid` belongs to the grid axis and not to this one.
                ; Copied here as well, the labelled axis drew the grid a second
                ; time, over the marks instead of under them.
                if (key != "grid") {
                    a.setMember(key (given.get(key)))
                }
            }
        }
        if (orient == "bottom") {
            ; Category names along the foot of a chart do not fit side by side,
            ; so the reference turns them upright unless the spec says
            ; otherwise. A vertical axis has room and keeps them level.
            ; …but a month is not a category name. A channel with a time unit
            ; is labelled with dates, which are short and which the reference
            ; leaves level however discrete the scale under them is.
            if (! (this.continuousScale(ch))) {
                if ((strlen ch.timeUnit) == 0) {
                    if (! (a.has("labelAngle"))) {
                        a.setMember("labelAngle" (VlJson.numberValue(270.0)))
                    }
                } {
                    ; A discrete axis of DATES keeps its labels level, and
                    ; twelve level month names do not fit where twelve turned
                    ; ones would — so the reference thins them, and an axis
                    ; that does not thin them prints Jan over Feb.
                    ; …unless the specification said. `labelOverlap: false` is
                    ; a chart asking for every label to be drawn, however many
                    ; there are — a lasagna plot draws one per day and paints
                    ; all but the Januaries out — and thinned anyway it kept
                    ; eight of a hundred and thirty-one.
                    if (! (a.has("labelOverlap"))) {
                        a.setMember("labelOverlap" (VlJson.boolValue(true)))
                    }
                }
            }
        }
        ; Turned labels have to be told which corner to hang from. A label at
        ; 270 degrees down the foot of a chart reads bottom-to-top and ends at
        ; the axis, so it is aligned RIGHT and centred on its own line; at 90
        ; it starts there and is aligned left. Left to the defaults, every
        ; turned label was drawn from the wrong end and the chart was as much
        ; too wide as its longest category name.
        VlCompile.turnLabels(a (a.stringOr("orient" orient)))
        if (stackOffset == "normalize") {
            if ((ch.outField()) == stackField) {
                a.setMember("format" (VlJson.stringValue(".0%")))
            }
        }
        ; A time unit's labels are dates, whatever the channel calls its type:
        ; the values on the axis are instants, and printed as numbers they read
        ; as thirteen digits of milliseconds.
        ; …unless the specification stated its own. `"axis": {"format": "%Y"}`
        ; is a chart asking for years on an axis of months, and overwriting it
        ; with the unit's own format ignored the one thing the spec said about
        ; how it wanted to be read.
        if ((strlen ch.timeUnit) > 0) {
            if (! (a.has("format"))) {
                a.setMember("format" (VlJson.stringValue((VlTime.unitFormat(ch.timeUnits)))))
            }
            a.setMember("formatType" (VlJson.stringValue("time")))
            ; And a floor under the tick step: an axis of months has nothing to
            ; say between one month and the next, however many pixels it has.
            ;
            ; How long a month is is not a number, though — it is a question
            ; about a calendar, and the answer differs by thirty-two hours
            ; between February and March and by an hour again where the clocks
            ; go forward. The reference asks it as one: the distance between
            ; two dates a unit apart, worked out where the chart is read. Told
            ; a month is thirty days instead, an axis of months ticked twelve
            ; times in a year that has eleven months' room.
            def step:string (VlCompile.unitStepSignal((VlTime.finestUnit(ch.timeUnits))))
            if ((strlen step) > 0) {
                a.setMember("tickMinStep" (VlCompile.signalRef(step)))
            }
        }
        if (this.continuousScale(ch)) {
            ; The first and last labels of a horizontal continuous axis are
            ; pulled inside the plot rather than allowed to hang off it, which
            ; is what `labelFlush` means and why they are left- and
            ; right-aligned rather than centred.
            ; …unless the specification said otherwise. `"labelFlush": false`
            ; is a chart asking for its end labels to be centred on their
            ; ticks and to hang off the plot, and overwritten it took nineteen
            ; pixels of page off the right of the drawing.
            if (orient == "bottom") {
                if (! (a.has("labelFlush"))) {
                    a.setMember("labelFlush" (VlJson.boolValue(true)))
                }
            }
            ; A log axis's ticks are the whole multiples inside each decade,
            ; so there is no count to ask for — and they are unevenly spaced,
            ; so crowded labels are thinned from the front rather than halved.
            if ((this.scaleTypeFor(ch)) == "log") {
                if (! (a.has("labelOverlap"))) {
                    a.setMember("labelOverlap" (VlJson.stringValue("greedy")))
                }
            } {
                if (! (a.has("labelOverlap"))) {
                    a.setMember("labelOverlap" (VlJson.boolValue(true)))
                }
                ; A binned axis wants a tick per bin edge, which is far more
                ; than one per forty pixels — the scale's own `bins` then
                ; decides where they land.
                ; …unless the specification asked for a count. `tickCount: 11`
                ; on an axis of ten years is a chart asking for a tick a year,
                ; and overwritten by one-per-forty-pixels it got whatever the
                ; plot happened to be wide.
                if (a.has("tickCount")) {
                    ; the axis said so
                } {
                    if ch.hasBin {
                        def dense (VlJson.objectValue())
                        dense.setMember("signal" (VlJson.stringValue((("ceil(" + (this.sizeSignal("width"))) + "/10)"))))
                        a.setMember("tickCount" dense)
                    } {
                        if (! (VlCompile.cycleUnit(ch.timeUnit))) {
                            a.setMember("tickCount" (this.tickCountSignal(orient)))
                        }
                    }
                }
            }
        }
        this.labelCondition(a ch)
        a.setMember("zindex" (VlJson.numberValue(0.0)))
        return a
    }

    ; Four time units get no tick count at all: a month, an hour, a weekday and
    ; a quarter each have a fixed number of values in their cycle, so the axis
    ; is ticked at every one of them and a density in pixels would thin them.
    ; An axis of the twelve months came out labelled Jan, Mar, May …, which is
    ; a chart of six months as far as anyone reading it is concerned.
    sfn cycleUnit:boolean (unit:string) {
        if (unit == "month") { return true }
        if (unit == "hours") { return true }
        if (unit == "day") { return true }
        if (unit == "quarter") { return true }
        return false
    }

    ; One tick per forty pixels down, one per fifty across — the reference's own
    ; densities, written as signals so they follow a resized chart.
    fn tickCountSignal:VlJson (orient:string) {
        def out (VlJson.objectValue())
        if (orient == "bottom") {
            out.setMember("signal" (VlJson.stringValue((("ceil(" + (this.sizeSignal("width"))) + "/40)"))))
        } {
            out.setMember("signal" (VlJson.stringValue((("ceil(" + (this.sizeSignal("height"))) + "/40)"))))
        }
        return out
    }

    ; -------------------------------------------------------------- legends ---
    fn buildLegends:VlJson () {
        def out (VlJson.arrayValue())
        def colour:VlChannel (this.channel("color"))
        if (VlCompile.suppressed(colour "legend")) {
            colour = (new VlChannel())
        }
        if (VlCompile.suppressed(colour "scale")) {
            colour = (new VlChannel())
        }
        if (colour.encodes()) {
            if (((! colour.hasValue) || colour.conditional) || colour.hasDatum) {
                def l (VlJson.objectValue())
                ; A key stands for the mark it names. A line is drawn with a
                ; STROKE, so its key is too; a dot depends on whether it is
                ; FILLED — a scatter plot's outlined dots make an outlined key,
                ; and the solid dots on a line make a solid one.
                def outlined:boolean ((markName == "line") || (markName == "trail"))
                if (markName == "point") {
                    outlined = (! (markDef.boolOr("filled" false)))
                }
                if outlined {
                    l.setMember("stroke" (VlJson.stringValue((this.sname("color")))))
                } {
                    l.setMember("fill" (VlJson.stringValue((this.sname("color")))))
                }
                if (colour.isContinuous()) {
                    ; A continuous colour is a gradient bar, and the bar is as
                    ; long as the chart is tall, within reason.
                    def length (VlJson.objectValue())
                    length.setMember("signal" (VlJson.stringValue((this.gradientLengthSignal(colour)))))
                    l.setMember("gradientLength" length)
                } {
                    l.setMember("symbolType" (VlJson.stringValue((this.legendSymbol()))))
                }
                VlCompile.nameLegend(l colour)
                if (markName == "point") {
                    l.setMember("encode" (this.pointSymbolEncode(outlined)))
                } {
                    ; A key stands for the mark, so it is as transparent as the
                    ; mark is: two half-visible bars are named by two
                    ; half-visible squares.
                    def markOpacity:VlChannel (this.channel("opacity"))
                    if markOpacity.defined {
                        if markOpacity.hasValue {
                            l.setMember("encode" (VlCompile.symbolOpacityEncode((this.resolvedConstant(markOpacity)))))
                        }
                    } {
                        ; A dot that nothing said an opacity for is still drawn
                        ; slightly transparent, and its key is drawn the same
                        ; way. Left solid, the key to a scatter plot was a
                        ; shade darker than every dot it named.
                        if (((markName == "circle") || (markName == "square")) || (markName == "tick")) {
                            l.setMember("encode" (VlCompile.symbolOpacityEncode((VlJson.numberValue((this.dotOpacity()))))))
                        }
                    }
                }
                VlCompile.applyStatedLegend(l colour)
                ; A key whose fill comes from the scale does not also state a
                ; fill: the scale is the fill. Told to be transparent as well,
                ; the outlined key of a scatter plot was drawn hollow where the
                ; reference fills it.
                VlCompile.dropScaledOverride(l "fill")
                VlCompile.dropScaledOverride(l "stroke")
                push out.arr l
            }
        }
        ; A dash pattern's key is a short line drawn in that pattern, in the
        ; mark's own colour — there is nothing else to paint it with, since the
        ; whole point of the channel is that the series are told apart by their
        ; dashes rather than by their colours.
        def dashCh:VlChannel (this.channel("strokeDash"))
        if (VlCompile.suppressed(dashCh "legend")) {
            dashCh = (new VlChannel())
        }
        if (dashCh.encodes()) {
            if (! dashCh.hasValue) {
                def ld (VlJson.objectValue())
                ld.setMember("strokeDash" (VlJson.stringValue((this.sname("strokeDash")))))
                ld.setMember("symbolType" (VlJson.stringValue("stroke")))
                VlCompile.nameLegend(ld dashCh)
                VlCompile.applyStatedLegend(ld dashCh)
                def dashUpdate (VlJson.objectValue())
                dashUpdate.setMember("stroke" (VlCompile.literal((VlJson.stringValue("#4c78a8")))))
                def dashSymbols (VlJson.objectValue())
                dashSymbols.setMember("update" dashUpdate)
                def dashEncode (VlJson.objectValue())
                dashEncode.setMember("symbols" dashSymbols)
                ld.setMember("encode" dashEncode)
                push out.arr ld
            }
        }
        ; A chart may paint with `fill` or `stroke` rather than with `color`,
        ; and its key is the same key under a different scale name.
        VlCompile.pushPaintLegend(out (this.paintLegend("fill")))
        VlCompile.pushPaintLegend(out (this.paintLegend("stroke")))
        def shapeCh:VlChannel (this.channel("shape"))
        if (VlCompile.suppressed(shapeCh "legend")) {
            shapeCh = (new VlChannel())
        }
        if shapeCh.defined {
            if (! shapeCh.hasValue) {
                def l3 (VlJson.objectValue())
                l3.setMember("shape" (VlJson.stringValue((this.sname("shape")))))
                VlCompile.nameLegend(l3 shapeCh)
                VlCompile.applyStatedLegend(l3 shapeCh)
                if (markName == "point") {
                    def shapeEncode:VlJson (this.pointSymbolEncode((! (markDef.boolOr("filled" false)))))
                    def shapeSymbols:VlJson (shapeEncode.get("symbols"))
                    def shapeUpdate:VlJson (shapeSymbols.get("update"))
                    shapeUpdate.setMember("stroke" (VlCompile.literal((VlJson.stringValue("#4c78a8")))))
                    l3.setMember("encode" shapeEncode)
                }
                push out.arr l3
            }
        }
        def size:VlChannel (this.channel("size"))
        if (VlCompile.suppressed(size "legend")) {
            size = (new VlChannel())
        }
        if size.defined {
            if (! size.hasValue) {
                def l2 (VlJson.objectValue())
                ; A trail's size is the WIDTH of the ribbon, so its key is a
                ; set of lines of different thicknesses rather than dots of
                ; different areas.
                def sizeKey:string "size"
                if (((markName == "trail") || (markName == "line")) || (markName == "rule")) {
                    sizeKey = "strokeWidth"
                }
                l2.setMember(sizeKey (VlJson.stringValue((this.sname("size")))))
                l2.setMember("symbolType" (VlJson.stringValue((this.legendSymbol()))))
                VlCompile.nameLegend(l2 size)
                VlCompile.applyStatedLegend(l2 size)
                ; A size key stands for the same dot the chart draws, and its
                ; colour is the mark's constant since nothing encodes one.
                if (markName == "point") {
                    def encode:VlJson (this.pointSymbolEncode((! (markDef.boolOr("filled" false)))))
                    def symbols:VlJson (encode.get("symbols"))
                    def update:VlJson (symbols.get("update"))
                    update.setMember("stroke" (VlCompile.literal((VlJson.stringValue((this.markColour()))))))
                    l2.setMember("encode" encode)
                }
                if ((markName == "circle") || (markName == "square")) {
                    l2.setMember("encode" (VlCompile.filledSymbolEncode((this.markOpacity((this.dotOpacity()))) (this.markColour()) (this.markOutline()) (this.opacityStated()))))
                }
                push out.arr l2
            }
        }
        return (VlCompile.foldSameTitleLegends(out))
    }

    ; Two channels reading the SAME column are one key, not two. A scatter
    ; plot that tells its species apart by colour and by shape draws one
    ; column of entries, each a differently shaped mark in a different
    ; colour; drawn as two keys it says the same thing twice, and takes
    ; twice the width of page to say it.
    ;
    ; They are recognised by their title, which is the column they name.
    sfn foldSameTitleLegends:VlJson (legends:VlJson) {
        def out (VlJson.arrayValue())
        def byTitle:[string:VlJson]
        def i:int 0
        while (i < (legends.count())) {
            def l:VlJson (legends.at(i))
            def title:string (l.stringOr("title" ""))
            def folded:boolean false
            if ((strlen title) > 0) {
                if (has byTitle title) {
                    def into:VlJson (unwrap (get byTitle title))
                    for l.keys k:string ki {
                        if (VlCompile.legendChannelKey(k)) {
                            if (! (into.has(k))) {
                                into.setMember(k (l.get(k)))
                            }
                        }
                    }
                    ; A channel that arrived from another key brings its
                    ; scale with it, and a scale beats a constant: a key told
                    ; to be transparent inside and then given a fill scale is
                    ; filled by the scale.
                    VlCompile.dropScaledOverride(into "fill")
                    VlCompile.dropScaledOverride(into "stroke")
                    folded = true
                } {
                    set byTitle title l
                }
            }
            if (! folded) {
                push out.arr l
            }
            i = (i + 1)
        }
        return out
    }

    sfn legendChannelKey:boolean (key:string) {
        if (((key == "fill") || (key == "stroke")) || ((key == "size") || (key == "shape"))) {
            return true
        }
        return ((key == "strokeDash") || (key == "opacity"))
    }

    ; What colour the marks are drawn in when nothing varies the colour: the
    ; chart's own constant if it stated one, and the reference's blue if not.
    ; A key drawn beside them has to be that colour too — a size key next to
    ; black circles was drawing blue ones.
    fn markColour:string () {
        def colour:VlChannel (this.channel("color"))
        if colour.defined {
            if colour.hasValue {
                def stated:string (colour.value.asString())
                if ((strlen stated) > 0) {
                    return stated
                }
            }
            ; A conditional colour's other branch is a plain colour, and it is
            ; the colour the marks are drawn in whenever nothing is selected —
            ; which is what a key drawn beside them stands for.
            def fallback:VlJson (colour.def0.get("value"))
            if (fallback.isString()) {
                def named:string (fallback.asString())
                if ((strlen named) > 0) {
                    return named
                }
            }
        }
        def marked:VlJson (markDef.get("color"))
        if (marked.isString()) {
            return (marked.asString())
        }
        ; A mark may say its colour as a fill or as an outline rather than as
        ; `color`, and a key stands for the mark: a circle outlined in black
        ; is named by a black dot, not by the default blue.
        def filled:VlJson (markDef.get("fill"))
        if (filled.isString()) {
            return (filled.asString())
        }
        def outline:VlJson (markDef.get("stroke"))
        if (outline.isString()) {
            return (outline.asString())
        }
        return "#4c78a8"
    }

    ; The key of an outlined mark is an outline too: transparent inside, and
    ; the same partial opacity the points are drawn with.
    sfn filledSymbolEncode:VlJson (opacity:double paint:string outline:string stated:boolean) {
        def update (VlJson.objectValue())
        update.setMember("fill" (VlCompile.literal((VlJson.stringValue(paint)))))
        update.setMember("opacity" (VlCompile.literal((VlJson.numberValue(opacity)))))
        ; A key stands for the mark, outline and all: a circle drawn with a
        ; black edge is named by a dot with a black edge, not by one with none.
        ; …and as see-through in its fill as the mark is, where the chart SAID
        ; how see-through that is. A dot's own default transparency is not a
        ; statement about its fill and the reference writes none; an opacity
        ; the specification asked for is, and it writes it on both.
        if stated {
            update.setMember("fillOpacity" (VlCompile.literal((VlJson.numberValue(opacity)))))
        }
        update.setMember("stroke" (VlCompile.literal((VlJson.stringValue(outline)))))
        def symbols (VlJson.objectValue())
        symbols.setMember("update" update)
        def out (VlJson.objectValue())
        out.setMember("symbols" symbols)
        return out
    }

    sfn symbolOpacityEncode:VlJson (value:VlJson) {
        def update (VlJson.objectValue())
        update.setMember("opacity" (VlCompile.literal(value)))
        def symbols (VlJson.objectValue())
        symbols.setMember("update" update)
        def out (VlJson.objectValue())
        out.setMember("symbols" symbols)
        return out
    }

    ; What a key is called, unless the specification said it is called nothing.
    ; `"legend": {"title": null}` is a chart saying the colours speak for
    ; themselves, and a title printed anyway is as wide as the words in it —
    ; ninety-eight pixels of page on a heat map of temperatures.
    ; If a legend maps a channel to a SCALE, an encode block that also states
    ; a constant for it is a constant overruling the scale, and the reference
    ; writes no such thing.
    sfn dropScaledOverride:void (l:VlJson key:string) {
        if (! ((l.get(key)).isString())) {
            return
        }
        def encode:VlJson (l.get("encode"))
        if (! (encode.isObject())) {
            return
        }
        def symbols:VlJson (encode.get("symbols"))
        if (! (symbols.isObject())) {
            return
        }
        def update:VlJson (symbols.get("update"))
        if (! (update.isObject())) {
            return
        }
        update.removeMember(key)
    }

    sfn nameLegend:void (l:VlJson ch:VlChannel) {
        def given:VlJson (VlCompile.statedOn(ch "legend"))
        if (given.isObject()) {
            if (given.has("title")) {
                if ((given.get("title")).isNull()) {
                    return
                }
            }
        }
        ; `"title": null` on the channel is a chart asking for no heading at
        ; all — the categories say what they are — and it is not the same as
        ; saying nothing, which means "call it whatever the column is called".
        if (VlCompile.suppressed(ch "title")) {
            return
        }
        ; A conditional channel names itself in the condition, beside the
        ; field it names — read from the channel alone, a key titled "Weather"
        ; was headed with the column's own name instead.
        def named:VlJson (VlCompile.statedOn(ch "title"))
        if (named.isString()) {
            l.setMember("title" named)
            return
        }
        l.setMember("title" (VlJson.stringValue((ch.title()))))
    }

    ; What the specification said about the key itself — where it sits, how long
    ; its gradient is, what its symbols look like. Copied over whatever the
    ; defaults decided, the same way an axis definition is.
    ; What fraction of its band a mark was told to take, or 0 when it was told
    ; nothing. `{"height": {"band": 0.5}}` is a bar half as deep as its row.
    fn bandShare:double (dimension:string) {
        def given:VlJson (markDef.get(dimension))
        if (! (given.isObject())) {
            return 0.0
        }
        def part:VlJson (given.get("band"))
        if (! (part.isNumber())) {
            return 0.0
        }
        if (part.num >= 1.0) {
            return 0.0
        }
        return part.num
    }

    sfn applyStatedLegend:void (l:VlJson ch:VlChannel) {
        def given:VlJson (VlCompile.statedOn(ch "legend"))
        if (! (given.isObject())) {
            return
        }
        for given.keys key:string ki {
            def value:VlJson (given.get(key))
            if (! (value.isNull())) {
                l.setMember(key value)
            }
        }
    }

    sfn pushPaintLegend:void (out:VlJson entry:VlJson) {
        if (entry.isObject()) {
            if (entry.has("title")) {
                push out.arr entry
            }
        }
    }

    fn paintLegend:VlJson (name:string) {
        def empty (VlJson.objectValue())
        def ch:VlChannel (this.channel(name))
        if (VlCompile.suppressed(ch "legend")) {
            return empty
        }
        if (VlCompile.suppressed(ch "scale")) {
            return empty
        }
        if (! (ch.encodes())) {
            return empty
        }
        if (ch.hasValue) {
            return empty
        }
        def l (VlJson.objectValue())
        l.setMember(name (VlJson.stringValue((this.sname(name)))))
        if (ch.isContinuous()) {
            def length (VlJson.objectValue())
            length.setMember("signal" (VlJson.stringValue((this.gradientLengthSignal(ch)))))
            l.setMember("gradientLength" length)
        } {
            l.setMember("symbolType" (VlJson.stringValue((this.legendSymbol()))))
        }
        VlCompile.nameLegend(l ch)
        VlCompile.applyStatedLegend(l ch)
        return l
    }

    ; A dot's key is painted the way the dot is: an outlined one shows the fill
    ; the mark asked for — nothing, or the white the stroked overlay wants —
    ; and a filled one takes its colour from the scale and needs no fill here.
    ; Either way the key is as transparent as the mark.
    ; How transparent the mark is: the channel says first, because a channel is
    ; how a chart makes one layer's marks appear only on hover, and the mark
    ; definition second.
    ; The outline a key's symbol is drawn with: the mark's own, where it has
    ; one, and nothing where it does not.
    ; Did the chart SAY how see-through the mark is, or is it the default a
    ; dot is drawn with?
    fn opacityStated:boolean () {
        if (markDef.has("opacity")) {
            return true
        }
        def ch:VlChannel (this.channel("opacity"))
        if ch.defined {
            if ch.hasValue {
                return true
            }
        }
        return false
    }

    fn markOutline:string () {
        def outline:VlJson (markDef.get("stroke"))
        if (outline.isString()) {
            return (outline.asString())
        }
        return "transparent"
    }

    fn markOpacity:double (fallback:double) {
        def ch:VlChannel (this.channel("opacity"))
        if ch.defined {
            if ch.hasValue {
                if (ch.value.isNumber()) {
                    return ch.value.num
                }
            }
        }
        return (markDef.doubleOr("opacity" fallback))
    }

    fn pointSymbolEncode:VlJson (outlined:boolean) {
        def update (VlJson.objectValue())
        if outlined {
            update.setMember("fill" (VlCompile.literal((VlJson.stringValue((markDef.stringOr("fill" "transparent")))))))
        }
        ; As transparent as the dot it stands for, and no more solid than it.
        ; A flat 0.7 here was a dot's default written twice: where the dots
        ; stand for SUMMARIES they are drawn solid — one dot per group cannot
        ; land on another — and the reference then writes no opacity on the key
        ; either, because there is nothing to see through.
        def shade:double (this.markOpacity((this.dotOpacity())))
        if (shade != 1.0) {
            update.setMember("opacity" (VlCompile.literal((VlJson.numberValue(shade)))))
        }
        def symbols (VlJson.objectValue())
        symbols.setMember("update" update)
        def out (VlJson.objectValue())
        out.setMember("symbols" symbols)
        return out
    }

    ; What the key is drawn as: a filled square for the marks that are solid
    ; blocks of colour, a short dash for a line, and a dot for everything else.
    fn legendSymbol:string () {
        ; A trail is a line, and its key is a short line too.
        if ((markName == "line") || (markName == "trail")) {
            return "stroke"
        }
        if ((markName == "bar") || (markName == "rect")) {
            return "square"
        }
        return "circle"
    }

    ; ---------------------------------------------------------------- marks ---
    fn vegaMarkType:string () {
        if (((markName == "bar") || (markName == "tick")) || (markName == "rect")) {
            return "rect"
        }
        if (((markName == "point") || (markName == "circle")) || (markName == "square")) {
            return "symbol"
        }
        return markName
    }

    ; A coloured line is not one line: it is one line PER SERIES, and a line
    ; joins its points in order, so the rows have to be partitioned before the
    ; shape is drawn rather than coloured after it. That is a faceted group —
    ; the same construction a trellis uses, with the panels drawn on top of one
    ; another instead of side by side.
    fn seriesField:string () {
        ; A TRAIL is a line whose width varies along it, and it is one shape
        ; per series for exactly the same reason. Left out, five companies'
        ; share prices came out as one ribbon running back and forth across
        ; the plot.
        if (((markName != "line") && (markName != "area")) && (markName != "trail")) {
            return ""
        }
        def colour:VlChannel (this.channel("color"))
        if (colour.encodes()) {
            ; A colour written as a CONDITION and a fallback still names a
            ; column — the selected rows are painted by it and the rest grey —
            ; and a line is one shape per value of that column either way.
            ; Read as a constant, four series came out as one line running
            ; back and forth across the plot.
            if ((! colour.hasValue) || colour.conditional) {
                return (colour.outField())
            }
        }
        ; `detail` is a channel that groups and nothing else — it paints no
        ; colour and draws no key, it only says which rows belong to the same
        ; shape. A ranged dot plot uses it to give five countries five lines;
        ; ignored, they came out as one line zig-zagging between them.
        def detail:VlChannel (this.channel("detail"))
        if (detail.encodes()) {
            if ((strlen detail.field) > 0) {
                return (detail.outField())
            }
        }
        ; A line is one shape per series however the series are told apart, and
        ; a dash pattern tells them apart as well as a colour does. Without this
        ; a chart of five dashed lines is ONE line that runs back and forth
        ; across the plot five times.
        def dash:VlChannel (this.channel("strokeDash"))
        if (dash.encodes()) {
            if (! dash.hasValue) {
                return (dash.outField())
            }
        }
        return ""
    }

    ; A rectangle for an interval selection that was given one to start with.
    ;
    ; `{"select": "interval", "value": {"x": [55, 160], "y": [13, 37]}}` is a
    ; chart that opens with something already brushed, and the reference draws
    ; the brush: a translucent dark rectangle under the marks and a white
    ; outline over them. Nothing here can be dragged, so what is drawn is the
    ; stated extent and it never moves — but a chart that says it starts
    ; brushed and shows no brush is not the same picture.
    fn withBrushes:VlJson (marks:VlJson) {
        def params:VlJson (source.get("params"))
        if (! (params.isArray())) {
            return marks
        }
        def unders (VlJson.arrayValue())
        def overs (VlJson.arrayValue())
        def total:int (params.count())
        def k:int 0
        while (k < total) {
            def p:VlJson (params.at(k))
            if (VlCompile.selectsInterval(p)) {
                def initial:VlJson (p.get("value"))
                if (initial.isObject()) {
                    def name:string (p.stringOr("name" "brush"))
                    def under (VlJson.objectValue())
                    under.setMember("name" (VlJson.stringValue((name + "_brush_bg"))))
                    under.setMember("type" (VlJson.stringValue("rect")))
                    def uEnc (VlJson.objectValue())
                    def uUp (VlJson.objectValue())
                    uUp.setMember("fill" (VlCompile.plainValue((VlJson.stringValue("#333")))))
                    uUp.setMember("fillOpacity" (VlCompile.plainValue((VlJson.numberValue(0.125)))))
                    this.brushExtent(uUp initial)
                    uEnc.setMember("update" uUp)
                    under.setMember("encode" uEnc)
                    push unders.arr under

                    def over (VlJson.objectValue())
                    over.setMember("name" (VlJson.stringValue((name + "_brush"))))
                    over.setMember("type" (VlJson.stringValue("rect")))
                    def oEnc (VlJson.objectValue())
                    def oUp (VlJson.objectValue())
                    oUp.setMember("fill" (VlCompile.plainValue((VlJson.stringValue("transparent")))))
                    oUp.setMember("stroke" (VlCompile.plainValue((VlJson.stringValue("white")))))
                    this.brushExtent(oUp initial)
                    oEnc.setMember("update" oUp)
                    over.setMember("encode" oEnc)
                    push overs.arr over
                }
            }
            k = (k + 1)
        }
        if (((unders.count()) == 0)) {
            return marks
        }
        def out (VlJson.arrayValue())
        for unders.arr u:VlJson ui { push out.arr u }
        for marks.arr m:VlJson mi { push out.arr m }
        for overs.arr o:VlJson oi { push out.arr o }
        return out
    }

    ; The two ends of each brushed channel, put through that channel's own
    ; scale — which is what turns "from 55 to 160 horsepower" into pixels.
    fn brushExtent:void (update:VlJson initial:VlJson) {
        for initial.keys channel:string ci {
            def span:VlJson (initial.get(channel))
            if (span.isArray()) {
                if ((span.count()) == 2) {
                    def far:string (channel + "2")
                    update.setMember(channel (this.scaledValue(channel (span.at(0)))))
                    update.setMember(far (this.scaledValue(channel (span.at(1)))))
                }
            }
        }
    }

    fn scaledValue:VlJson (channel:string value:VlJson) {
        def out (VlJson.objectValue())
        out.setMember("scale" (VlJson.stringValue((this.sname(channel)))))
        out.setMember("value" value)
        return out
    }

    sfn plainValue:VlJson (value:VlJson) {
        def out (VlJson.objectValue())
        out.setMember("value" value)
        return out
    }

    sfn selectsInterval:boolean (p:VlJson) {
        def sel:VlJson (p.get("select"))
        if (sel.isString()) {
            return (sel.str == "interval")
        }
        if (sel.isObject()) {
            return ((sel.stringOr("type" "")) == "interval")
        }
        return false
    }

    ; The two edges of the unit a row's rectangle covers, written as columns.
    ; `bandPosition` says where in the unit the row STANDS: at 0 it stands on
    ; the boundary, so the block runs from half a unit before it to half a unit
    ; after, which is the midpoint of each neighbouring pair.
    fn pushUnitBandOffsets:void (transforms:VlJson) {
        for channels ch:VlChannel ci {
            if (this.unitBandStated(ch)) {
                ; Always halfway: the edges are the MIDPOINTS of the unit and
                ; each of its neighbours, whatever `bandPosition` is — the
                ; position says where in the unit the row stands, and the block
                ; is drawn round it either way.
                def where:double 0.5
                def other:double 0.5
                def here:string (VlCompile.datumRef((ch.outField())))
                def far:string (VlCompile.datumRef((this.unitEndFieldPlain(ch))))
                def unit:string (VlTime.finestUnit(ch.timeUnits))
                def before:string (((("timeOffset('" + unit) + "', ") + here) + ", -1)")
                def a (VlJson.objectValue())
                a.setMember("type" (VlJson.stringValue("formula")))
                a.setMember("expr" (VlJson.stringValue(((((((VlJson.formatNumber(other 6)) + " * ") + before) + " + ") + (VlJson.formatNumber(where 6))) + " * ") + here)))
                a.setMember("as" (VlJson.stringValue((this.unitOffsetStart(ch)))))
                push transforms.arr a
                def b (VlJson.objectValue())
                b.setMember("type" (VlJson.stringValue("formula")))
                b.setMember("expr" (VlJson.stringValue(((((((VlJson.formatNumber(other 6)) + " * ") + here) + " + ") + (VlJson.formatNumber(where 6))) + " * ") + far)))
                b.setMember("as" (VlJson.stringValue((this.unitOffsetEnd(ch)))))
                push transforms.arr b
            }
        }
    }

    fn unitEndField:string (ch:VlChannel) {
        def plain:string (this.unitEndFieldPlain(ch))
        if ((strlen plain) == 0) {
            return ""
        }
        if (this.unitBandStated(ch)) {
            return (this.unitOffsetEnd(ch))
        }
        return plain
    }

    ; The near edge, which is the column itself unless the unit was offset.
    fn unitStartField:string (ch:VlChannel) {
        if (this.unitBandStated(ch)) {
            return (this.unitOffsetStart(ch))
        }
        return (ch.outField())
    }

    fn buildMarks:VlJson () {
        def series:string (this.seriesField())
        if ((strlen series) > 0) {
            return (this.buildSeriesGroup(series))
        }
        return (this.buildFlatMarks())
    }

    fn buildSeriesGroup:VlJson (series:string) {
        def out (VlJson.arrayValue())
        def group (VlJson.objectValue())
        group.setMember("name" (VlJson.stringValue("pathgroup")))
        group.setMember("type" (VlJson.stringValue("group")))
        def facet (VlJson.objectValue())
        facet.setMember("name" (VlJson.stringValue("faceted_path_main")))
        facet.setMember("data" (VlJson.stringValue(dataName)))
        def groupby (VlJson.arrayValue())
        push groupby.arr (VlJson.stringValue(series))
        facet.setMember("groupby" groupby)
        def from (VlJson.objectValue())
        from.setMember("facet" facet)
        group.setMember("from" from)
        ; Every panel is the whole plot: they are drawn on top of one another.
        def update (VlJson.objectValue())
        update.setMember("width" (VlCompile.groupField("width")))
        update.setMember("height" (VlCompile.groupField("height")))
        def encode (VlJson.objectValue())
        encode.setMember("update" update)
        group.setMember("encode" encode)

        def inner:VlJson (this.buildFlatMarks())
        def mark:VlJson (inner.at(0))
        def innerFrom (VlJson.objectValue())
        innerFrom.setMember("data" (VlJson.stringValue("faceted_path_main")))
        mark.setMember("from" innerFrom)
        group.setMember("marks" inner)
        push out.arr group
        return out
    }

    sfn groupField:VlJson (name:string) {
        def inner (VlJson.objectValue())
        inner.setMember("group" (VlJson.stringValue(name)))
        def out (VlJson.objectValue())
        out.setMember("field" inner)
        return out
    }

    fn buildFlatMarks:VlJson () {
        def out (VlJson.arrayValue())
        def m (VlJson.objectValue())
        m.setMember("name" (VlJson.stringValue(markLabel)))
        m.setMember("type" (VlJson.stringValue((this.vegaMarkType()))))
        def style (VlJson.arrayValue())
        push style.arr (VlJson.stringValue(markName))
        m.setMember("style" style)
        ; A line and an area are one shape through many rows, so the rows have
        ; to be in the order the shape is drawn — by position, not by the order
        ; the data happened to arrive in.
        if ((markName == "line") || (markName == "area")) {
            def sort (VlJson.objectValue())
            sort.setMember("field" (VlJson.stringValue("x")))
            m.setMember("sort" sort)
        }
        ; A mark may be CLIPPED to the plot it is drawn in. A horizon chart is
        ; the reason: the same series is drawn twice, once shifted a band down,
        ; and the part that hangs below the plot is meant to be cut off rather
        ; than to make the page taller.
        if (markDef.boolOr("clip" false)) {
            m.setMember("clip" (VlJson.boolValue(true)))
        }
        def from (VlJson.objectValue())
        from.setMember("data" (VlJson.stringValue(dataName)))
        m.setMember("from" from)

        def update (VlJson.objectValue())
        ; The mark definition may nudge every instance — a label six pixels
        ; above the bar it names.
        for markDef.keys key:string ki {
            if ((((key == "dx") || (key == "dy")) || (key == "opacity")) || (key == "interpolate")) {
                update.setMember(key (VlCompile.literal((markDef.get(key)))))
            }
        }
        if (markName == "arc") {
            this.encodePaint(update)
            this.encodeAria(update)
            this.encodeArc(update)
            def encodeArc (VlJson.objectValue())
            encodeArc.setMember("update" update)
            m.setMember("encode" encodeArc)
            push out.arr m
            return out
        }
        ; A label on a pie is placed in POLAR coordinates: at the centre of the
        ; chart, an angle round and a radius out. Placed on x and y like every
        ; other text mark it had neither, and every label of a labelled pie
        ; landed in a heap in the middle of it.
        if (markName == "text") {
            if ((this.channel("theta")).defined) {
                this.encodePaint(update)
                this.encodeAria(update)
                ; Everything a text mark says that is not WHERE it goes — what
                ; it reads, how it is set — and then where it goes, in polar.
                this.encodePosition(update)
                this.applyMarkPosition(update)
                this.encodePolarText(update)
                def polar (VlJson.objectValue())
                polar.setMember("update" update)
                m.setMember("encode" polar)
                push out.arr m
                return out
            }
        }
        if (markName == "area") {
            update.setMember("orient" (VlCompile.literal((VlJson.stringValue("vertical")))))
        }
        this.encodePaint(update)
        this.encodeAria(update)
        this.encodePosition(update)
        this.applyMarkPosition(update)
        def encode (VlJson.objectValue())
        encode.setMember("update" update)
        m.setMember("encode" encode)
        push out.arr m
        return out
    }

    ; A wedge is placed by its centre and its two radii, and swept between the
    ; two angles the stack wrote. The angles run backwards — the wedge ENDS at
    ; the stack's start — because a stack accumulates downward and a circle is
    ; read clockwise.
    ; A label round a pie: the centre of the chart, the angle its wedge covers
    ; and how far out to stand. The angle is the MIDDLE of the wedge, which is
    ; why it is written from the stack's two ends rather than from either.
    fn encodePolarText:void (update:VlJson) {
        def half (VlJson.objectValue())
        half.setMember("signal" (VlJson.stringValue("width")))
        half.setMember("mult" (VlJson.numberValue(0.5)))
        update.setMember("x" half)
        def halfDown (VlJson.objectValue())
        halfDown.setMember("signal" (VlJson.stringValue("height")))
        halfDown.setMember("mult" (VlJson.numberValue(0.5)))
        update.setMember("y" halfDown)
        update.setMember("align" (VlCompile.literal((VlJson.stringValue("center")))))
        update.setMember("baseline" (VlCompile.literal((VlJson.stringValue("middle")))))

        def offset:double (markDef.doubleOr("radiusOffset" 0.0))
        def stated:VlJson (markDef.get("radius"))
        def radius:VlChannel (this.channel("radius"))
        if (stated.isNumber()) {
            update.setMember("radius" (VlCompile.literal(stated)))
        } {
            if radius.defined {
                def scaled:VlJson (this.scaled("radius" (radius.outField())))
                if (offset != 0.0) {
                    scaled.setMember("offset" (VlJson.numberValue(offset)))
                }
                update.setMember("radius" scaled)
            } {
                def out (VlJson.objectValue())
                out.setMember("signal" (VlJson.stringValue((("min(width,height)/2 + " + (VlJson.formatNumber(offset 4)))))))
                update.setMember("radius" out)
            }
        }

        def theta:VlChannel (this.channel("theta"))
        if theta.defined {
            if ((strlen stackField) > 0) {
                def mid (VlJson.objectValue())
                def expr:string ("scale(\"" + (this.sname("theta")))
                expr = ((((expr + "\", 0.5 * ") + (VlCompile.datumRef((stackField + "_start")))) + " + 0.5 * ") + (VlCompile.datumRef((stackField + "_end"))))
                mid.setMember("signal" (VlJson.stringValue((expr + ")"))))
                update.setMember("theta" mid)
            } {
                update.setMember("theta" (this.scaled("theta" (theta.outField()))))
            }
        }
    }

    fn encodeArc:void (update:VlJson) {
        def half (VlJson.objectValue())
        half.setMember("signal" (VlJson.stringValue("width")))
        half.setMember("mult" (VlJson.numberValue(0.5)))
        update.setMember("x" half)
        def halfDown (VlJson.objectValue())
        halfDown.setMember("signal" (VlJson.stringValue("height")))
        halfDown.setMember("mult" (VlJson.numberValue(0.5)))
        update.setMember("y" halfDown)
        def radius:VlChannel (this.channel("radius"))
        def statedOuter:VlJson (markDef.get("outerRadius"))
        if (statedOuter.isNumber()) {
            ; A pie told how big it is is that big. Ignored, every wedge ran
            ; out to half the plot and the labels drawn round it landed inside
            ; the pie rather than outside it.
            update.setMember("outerRadius" (VlCompile.literal(statedOuter)))
        } {
            if radius.defined {
                update.setMember("outerRadius" (this.scaled("radius" (radius.outField()))))
            } {
                def outer (VlJson.objectValue())
                outer.setMember("signal" (VlJson.stringValue("min(width,height)/2")))
                update.setMember("outerRadius" outer)
            }
        }
        def inner:VlJson (markDef.get("innerRadius"))
        if (inner.isNumber()) {
            update.setMember("innerRadius" (VlCompile.literal(inner)))
        } {
            update.setMember("innerRadius" (VlCompile.literal((VlJson.numberValue(0.0)))))
        }
        if ((strlen stackField) > 0) {
            update.setMember("startAngle" (this.scaled("theta" (stackField + "_end"))))
            update.setMember("endAngle" (this.scaled("theta" (stackField + "_start"))))
        } {
            ; Unstacked, every wedge starts at nothing: the chart is read by
            ; comparing the wedges rather than by walking round the circle.
            def theta:VlChannel (this.channel("theta"))
            if theta.defined {
                update.setMember("startAngle" (this.scaled("theta" (theta.outField()))))
                def zero (VlJson.objectValue())
                zero.setMember("scale" (VlJson.stringValue((this.sname("theta")))))
                zero.setMember("value" (VlJson.numberValue(0.0)))
                update.setMember("endAngle" zero)
            }
        }
    }

    ; The colour a mark carries. A point is drawn as an outline, everything else
    ; as a fill, and a colour channel replaces the constant with a scale.
    fn encodePaint:void (update:VlJson) {
        ; An image has nothing to paint. Its picture is the file it names, and
        ; a fill under it is either invisible or a blue square where the
        ; picture has transparency — the reference writes none.
        if (markName == "image") {
            return
        }
        ; `fill` and `stroke` are channels in their own right — a heat map
        ; written with `"fill"` rather than `"color"` is the same chart said a
        ; different way, and each gets a scale of its own name. Read as
        ; nothing, the cells came out the palette's first blue and the chart
        ; had no key at all.
        ; How solid the paint is, and how thick the outline. These are channels
        ; too — a bar that fades until it is selected and outlines itself when
        ; it is says so on `fillOpacity` and `strokeWidth`, and read as nothing
        ; the chart drew every bar the same and lost the whole interaction.
        this.paintValueChannel(update "fillOpacity")
        this.paintValueChannel(update "strokeOpacity")
        this.paintValueChannel(update "strokeWidth")
        this.paintValueChannel(update "strokeDash")
        if (this.paintChannel(update "fill")) {
            this.paintChannel(update "stroke")
            this.applyMarkPaint(update "fill")
            return
        }
        if (this.paintChannel(update "stroke")) {
            this.applyMarkPaint(update "stroke")
            return
        }
        def outlined:boolean ((markName == "point") && (! (markDef.boolOr("filled" false))))
        ; A dot is drawn slightly transparent so that two that land on the same
        ; spot can be told apart — unless it says otherwise, which the dots on
        ; a line do: they mark that line's own vertices.
        ; …and unless the dots stand for SUMMARIES rather than for rows. One
        ; dot per group cannot land on another, so there is nothing to see
        ; through and the reference draws them solid.
        if (markName == "point") {
            update.setMember("opacity" (VlCompile.literal((VlJson.numberValue((markDef.doubleOr("opacity" (this.dotOpacity()))))))))
        }
        if outlined {
            update.setMember("fill" (VlCompile.literal((VlJson.stringValue("transparent")))))
        }
        ; A tick and a filled dot are both drawn slightly transparent, so that
        ; the ones that land on the same spot can be told apart.
        if (((markName == "tick") || (markName == "circle")) || (markName == "square")) {
            update.setMember("opacity" (VlCompile.literal((VlJson.numberValue((markDef.doubleOr("opacity" (this.dotOpacity()))))))))
        }
        def key:string "fill"
        if ((outlined || (markName == "line")) || (markName == "rule")) {
            key = "stroke"
        }
        ; A rule is a line drawn over a chart rather than a series in it, so it
        ; is black by default rather than the palette's first colour.
        if (markName == "rule") {
            def ruleColour:VlChannel (this.channel("color"))
            if (! ruleColour.defined) {
                update.setMember("stroke" (VlCompile.literal((VlJson.stringValue("black")))))
                ; The mark's OWN properties still apply. These two used to
                ; return here, which meant a rule or a plain text mark carried
                ; nothing the mark definition asked for — not its size, not its
                ; font, not even the alignment that was the whole point of it.
                this.applyMarkPaint(update "stroke")
                return
            }
        }
        if (markName == "text") {
            ; A label is centred on its anchor unless the chart says otherwise.
            ; `"config": {"text": {"align": "left"}}` is a chart labelling the
            ; ends of its lines, and written over with the default every label
            ; sat on the line rather than beside it.
            update.setMember("align" (VlCompile.literal((VlJson.stringValue((this.configText("text" "align" "center")))))))
            update.setMember("baseline" (VlCompile.literal((VlJson.stringValue((this.configText("text" "baseline" "middle")))))))
            def colour0:VlChannel (this.channel("color"))
            if (! colour0.defined) {
                ; …in the colour the chart said labels are, which is black
                ; unless it said. Written black regardless, a chart asking for
                ; dark grey labels got none of them.
                def inkName:string (this.configText("text" "fill" "black"))
                inkName = (this.configText("text" "color" inkName))
                update.setMember("fill" (VlCompile.literal((VlJson.stringValue(inkName)))))
                this.applyMarkPaint(update "fill")
                return
            }
        }
        def colour:VlChannel (this.channel("color"))
        if colour.defined {
            if colour.hasDatum {
                def through (VlJson.objectValue())
                through.setMember("scale" (VlJson.stringValue((this.sname("color")))))
                through.setMember("value" colour.value)
                update.setMember(key (this.withCondition(colour through)))
                this.applyMarkPaint(update key)
                return
            }
            def base:VlJson (VlCompile.literal(colour.value))
            if (! colour.hasValue) {
                if (colour.encodes()) {
                    base = (VlJson.objectValue())
                    if (! (VlCompile.suppressed(colour "scale"))) {
                        base.setMember("scale" (VlJson.stringValue((this.sname("color")))))
                    }
                    base.setMember("field" (VlJson.stringValue((colour.outField()))))
                } {
                    ; Nothing encoded: whatever the condition does not catch is
                    ; drawn in the mark's own colour.
                    base = (VlCompile.literal((VlJson.stringValue("#4c78a8"))))
                }
            }
            update.setMember(key (this.withCondition(colour base)))
            this.applyMarkPaint(update key)
            return
        }
        update.setMember(key (VlCompile.literal((VlJson.stringValue("#4c78a8")))))
        this.applyMarkPaint(update key)
    }

    ; One of the two paint channels, written on the mark if it was encoded.
    ; Answers whether it was.
    ; A channel that is a plain number or colour rather than a category: how
    ; opaque, how thick, how dashed. It takes a scale only when it reads a
    ; field, which is rare — what these carry is nearly always a constant or a
    ; condition over one.
    fn paintValueChannel:void (update:VlJson name:string) {
        def ch:VlChannel (this.channel(name))
        if (! ch.defined) {
            return
        }
        def base:VlJson (VlCompile.literal(ch.value))
        if (! ch.hasValue) {
            if (! (ch.encodes())) {
                return
            }
            base = (VlJson.objectValue())
            if (! (VlCompile.suppressed(ch "scale"))) {
                base.setMember("scale" (VlJson.stringValue((this.sname(name)))))
            }
            base.setMember("field" (VlJson.stringValue((ch.outField()))))
        }
        update.setMember(name (this.withCondition(ch base)))
    }

    fn paintChannel:boolean (update:VlJson name:string) {
        def ch:VlChannel (this.channel(name))
        if (! ch.defined) {
            return false
        }
        if ch.hasDatum {
            def scaled (VlJson.objectValue())
            scaled.setMember("scale" (VlJson.stringValue((this.sname(name)))))
            scaled.setMember("value" ch.value)
            update.setMember(name (this.withCondition(ch scaled)))
            return true
        }
        def base:VlJson (VlCompile.literal(ch.value))
        if (! ch.hasValue) {
            if (! (ch.encodes())) {
                return false
            }
            base = (VlJson.objectValue())
            if (! (VlCompile.suppressed(ch "scale"))) {
                base.setMember("scale" (VlJson.stringValue((this.sname(name)))))
            }
            base.setMember("field" (VlJson.stringValue((ch.outField()))))
        }
        update.setMember(name (this.withCondition(ch base)))
        return true
    }

    ; What the MARK DEFINITION says about paint, as opposed to what a channel
    ; says. `{"mark": {"type": "line", "color": "firebrick"}}` is how anyone
    ; colours a single series, and it reached nothing: the colour came only
    ; from a `color` channel, so a line asked to be firebrick came out the
    ; palette's first blue and a text mark asked for white came out black.
    ;
    ; A channel still wins where there is one — that is Vega-Lite's order, and
    ; it is why each of these asks whether its own channel was encoded before
    ; it writes anything.
    fn applyMarkPaint:void (update:VlJson key:string) {
        if (markDef.has("color")) {
            def hasColor:VlChannel (this.channel("color"))
        if (! hasColor.defined) {
                update.setMember(key (VlCompile.literal((markDef.get("color")))))
            }
        }
        VlCompile.markLiteral(update markDef "fill" "fill")
        VlCompile.markLiteral(update markDef "stroke" "stroke")
        VlCompile.markLiteral(update markDef "fillOpacity" "fillOpacity")
        VlCompile.markLiteral(update markDef "strokeOpacity" "strokeOpacity")
        VlCompile.markLiteral(update markDef "strokeWidth" "strokeWidth")
        VlCompile.markLiteral(update markDef "strokeDash" "strokeDash")
        VlCompile.markLiteral(update markDef "cornerRadius" "cornerRadius")
        ; `cornerRadiusEnd` rounds the end a bar GROWS toward and leaves the
        ; end it stands on square, so which two corners those are depends on
        ; which way the bar runs. Written as a plain corner radius it rounded
        ; all four and a stacked bar's segments came apart at the joins.
        if (markDef.has("cornerRadiusEnd")) {
            def radius:VlJson (markDef.get("cornerRadiusEnd"))
            def measured:VlChannel (this.stackMeasure())
            def upright:boolean (measured.name != "x")
            if upright {
                update.setMember("cornerRadiusTopLeft" (VlCompile.literal(radius)))
                update.setMember("cornerRadiusTopRight" (VlCompile.literal(radius)))
            } {
                update.setMember("cornerRadiusTopRight" (VlCompile.literal(radius)))
                update.setMember("cornerRadiusBottomRight" (VlCompile.literal(radius)))
            }
        }
        ; A mark may carry its own words. `{"type": "text", "text": "hazardous"}`
        ; is a label that names itself rather than reading a column, which is
        ; how an annotation over a chart of something else is written; left
        ; unread it came out blank.
        VlCompile.markLiteral(update markDef "text" "text")
        VlCompile.markLiteral(update markDef "align" "align")
        VlCompile.markLiteral(update markDef "baseline" "baseline")
        VlCompile.markLiteral(update markDef "font" "font")
        VlCompile.markLiteral(update markDef "fontSize" "fontSize")
        VlCompile.markLiteral(update markDef "fontWeight" "fontWeight")
        VlCompile.markLiteral(update markDef "tension" "tension")
        ; opacity, size and shape each have a channel of their own, so they are
        ; only taken from the mark when nothing encoded them.
        def hasOpacity:VlChannel (this.channel("opacity"))
        if (! hasOpacity.defined) {
            VlCompile.markLiteral(update markDef "opacity" "opacity")
        }
        def hasSize:VlChannel (this.channel("size"))
        if (! hasSize.defined) {
            ; A rule and a line have no area, so their size is a THICKNESS —
            ; the same rule the size CHANNEL follows. Written as `size` on a
            ; mark definition it reached nothing, and a line asked to be three
            ; pixels wide came out at the default two.
            if ((markName == "rule") || (markName == "line")) {
                VlCompile.markLiteral(update markDef "size" "strokeWidth")
            } {
                VlCompile.markLiteral(update markDef "size" "size")
            }
        }
        def hasShape:VlChannel (this.channel("shape"))
        if (! hasShape.defined) {
            VlCompile.markLiteral(update markDef "shape" "shape")
        }
    }

    ; Where the MARK DEFINITION says to put the mark, as opposed to where a
    ; channel says. `{"mark": {"type": "text", "x": 5}}` is how a label is
    ; nailed five pixels in from the left edge whatever the data says, and it
    ; is what a layered chart uses to write its own row labels.
    ;
    ; A channel wins wherever there is one: the mark definition is the answer
    ; for a dimension nothing encoded, not an override of one that was.
    fn applyMarkPosition:void (update:VlJson) {
        this.markPlace(update "x" "x")
        this.markPlace(update "y" "y")
        this.markPlace(update "x2" "x2")
        this.markPlace(update "y2" "y2")
        this.markPlace(update "width" "width")
        this.markPlace(update "height" "height")
        ; `"xOffset": -4` nudges a mark off the position its channel gave it —
        ; four pixels back from the end of the bar it labels — and the
        ; reference writes it as an `offset` on that channel rather than as a
        ; position of its own, so it survives whatever the scale did.
        VlCompile.markNudge(update markDef "xOffset" "x")
        VlCompile.markNudge(update markDef "yOffset" "y")
        ; A mark drawn between two values nudges BOTH ends, and each has its
        ; own name. With only the near one read, a waterfall's connector came
        ; out twenty-two pixels short at the far end.
        VlCompile.markNudge(update markDef "x2Offset" "x2")
        VlCompile.markNudge(update markDef "y2Offset" "y2")
    }

    sfn markNudge:void (update:VlJson markDef:VlJson key:string channel:string) {
        if (! (markDef.has(key))) {
            return
        }
        def placed:VlJson (update.get(channel))
        if (! (placed.isObject())) {
            return
        }
        placed.setMember("offset" (markDef.get(key)))
    }

    fn markPlace:void (update:VlJson channelName:string key:string) {
        if (! (markDef.has(key))) {
            return
        }
        def encoded:VlChannel (this.channel(channelName))
        if encoded.defined {
            return
        }
        ; A size written as a FRACTION of a band is not a size: it is a share
        ; of whatever the band turns out to be, and the position encoder has
        ; already turned it into one. Written out as a number as well, the
        ; mark was given an object where a number goes and drew nothing.
        if (update.has(key)) {
            if ((this.bandShare(key)) > 0.0) {
                return
            }
        }
        def given:VlJson (markDef.get(key))
        ; "width" and "height" mean the group's own, which is a reference and
        ; not a number — that is how a mark is pinned to the far edge.
        if (given.isString()) {
            if ((given.str == "width") || (given.str == "height")) {
                def group (VlJson.objectValue())
                group.setMember("group" (VlJson.stringValue(given.str)))
                def ref (VlJson.objectValue())
                ref.setMember("field" group)
                update.setMember(key ref)
                return
            }
        }
        update.setMember(key (VlCompile.literal(given)))
    }

    sfn markLiteral:void (update:VlJson markDef:VlJson from:string to:string) {
        if (markDef.has(from)) {
            update.setMember(to (VlCompile.literal((markDef.get(from)))))
        }
    }

    fn encodeAria:void (update:VlJson) {
        if (((markName != "line") && (markName != "area")) && (markName != "arc")) {
            update.setMember("ariaRoleDescription" (VlCompile.literal((VlJson.stringValue(markName)))))
        }
        def text:string (this.describeExpr())
        if ((strlen text) > 0) {
            def signal (VlJson.objectValue())
            signal.setMember("signal" (VlJson.stringValue(text)))
            update.setMember("description" signal)
        }
    }

    ; The tooltip text every mark carries: each encoded field, named and
    ; formatted the way the reference formats it — a number through `format`, a
    ; category through the array-or-scalar test that keeps a multi-valued field
    ; readable.
    ; The order the channels are named in is the REFERENCE's, not the
    ; specification's: position first and along the page before down it, then
    ; everything else in the order it was written. A horizontal bar chart says
    ; "b: 28; a: A" whether or not the spec put `y` first.
    fn describedChannels:[VlChannel] () {
        def out:[VlChannel]
        for channels first:VlChannel fi {
            if (first.name == "x") {
                push out first
            }
        }
        for channels second:VlChannel si {
            if (second.name == "y") {
                push out second
            }
        }
        for channels rest:VlChannel ri {
            if ((rest.name != "x") && (rest.name != "y")) {
                push out rest
            }
        }
        return out
    }

    fn describeExpr:string () {
        def out:string ""
        def seen:[string:int]
        for (this.describedChannels()) ch:VlChannel ci {
            if (ch.hasValue) {
                ; a constant is not described
            } {
              if (VlCompile.isFacetChannel(ch.name)) {
                ; a panel is named by its header, not by every mark in it
              } {
                if (has seen (ch.outField())) {
                    ; the same field on two channels is named once
                } {
                if ((strlen (ch.outField())) > 0) {
                    set seen (ch.outField()) 1
                    if ((strlen out) > 0) {
                        out = (out + " + \"; ")
                    } {
                        out = "\""
                    }
                    out = ((out + (ch.title())) + ": \" + ")
                    if ch.hasBin {
                        out = (out + (VlCompile.describeBin((ch.outField()) (ch.binEndField()))))
                    } {
                    ; A time unit's value is an instant however the channel
                    ; declared its type, so it is named as a date and in the
                    ; unit's own format — "Jan", not thirteen digits.
                    if ((strlen ch.timeUnit) > 0) {
                        out = (out + (VlCompile.describeUnit((ch.outField()) (VlTime.unitFormat(ch.timeUnits)))))
                    } {
                    if (ch.kind == "temporal") {
                        out = (out + (VlCompile.describeDate((ch.outField()))))
                    } {
                        ; A normalised stack is a SHARE, so what is described is
                        ; the segment's own length as a percentage, not the
                        ; number it was computed from.
                        if ((stackOffset == "normalize") && ((ch.outField()) == stackField)) {
                            out = (out + (VlCompile.describeShare(stackField)))
                        } {
                            out = (out + (VlCompile.describeOne((ch.outField()) (ch.isDiscrete()))))
                        }
                    }
                    }
                    }
                }
                }
              }
            }
        }
        return out
    }

    ; A bin is not a value but an interval, and it is named as one — with an en
    ; dash, which is what the reference writes.
    sfn describeBin:string (startField:string endField:string) {
        ; An en dash, which is what the reference writes between the ends.
        def dash:string (strfromcode 8211)
        def out:string "(!isValid(datum[\""
        out = (out + startField)
        out = (out + "\"]) || !isFinite(+datum[\"")
        out = (out + startField)
        out = (out + "\"]) ? \"null\" : format(datum[\"")
        out = (out + startField)
        out = (out + "\"], \"\") + \" ")
        out = (out + dash)
        out = (out + " \" + format(datum[\"")
        out = (out + endField)
        out = (out + "\"], \"\"))")
        return out
    }

    sfn describeShare:string (field:string) {
        return ((((("(format(datum[\"" + field) + "_end\"]-datum[\"") + field) + "_start\"], \".0%\"))"))
    }

    sfn describeUnit:string (field:string spec:string) {
        return ((((("(timeFormat(" + (VlCompile.datumRef(field))) + ", \"") + spec) + "\"))"))
    }

    sfn describeDate:string (field:string) {
        return (("(timeFormat(" + (VlCompile.datumRef(field))) + ", \"%b %d, %Y\"))")
    }

    sfn describeOne:string (field:string discrete:boolean) {
        if discrete {
            def dref:string (VlCompile.datumRef(field))
            return ((((((("(isValid(" + dref) + ") ? isArray(") + dref) + ") ? join(") + dref) + ", ' ') : ") + dref) + " : \"\"+" + dref + ")")
        }
        return ((("(format(" + (VlCompile.datumRef(field))) + ", \"\"))"))
    }

    sfn literal:VlJson (value:VlJson) {
        ; A mark property may be an EXPRESSION rather than a constant —
        ; `{"dy": {"expr": "datum.amount >= 0 ? -4 : 4"}}` is a label that
        ; hops to the other side of the line it names — and the reference
        ; writes that straight through as a signal. Wrapped as a value, the
        ; whole object reached the renderer, which read a number out of it and
        ; got nothing.
        if (value.isObject()) {
            if (value.has("expr")) {
                def signal (VlJson.objectValue())
                signal.setMember("signal" (value.get("expr")))
                return signal
            }
        }
        def out (VlJson.objectValue())
        out.setMember("value" value)
        return out
    }

    fn scaled:VlJson (scale:string field:string) {
        def out (VlJson.objectValue())
        out.setMember("scale" (VlJson.stringValue((this.sname(scale)))))
        out.setMember("field" (VlJson.stringValue(field)))
        return out
    }

    ; Where the mark goes. A band puts the mark at the start of its band and
    ; gives it the band's width; a stacked value is drawn between the two ends
    ; the stack wrote; everything else is a point on a scale.
    fn encodePosition:void (update:VlJson) {
        this.encodeAxisPair(update (this.channel("x")) "x" "width")
        this.encodeAxisPair(update (this.channel("y")) "y" "height")
        def size:VlChannel (this.channel("size"))
        if size.defined {
            ; A rule and a line have no area, so their `size` is a THICKNESS:
            ; the reference writes it as `strokeWidth`, and written as `size`
            ; it reaches nothing and a five-pixel rule comes out one pixel.
            def sizeKey:string "size"
            if ((markName == "rule") || (markName == "line")) {
                sizeKey = "strokeWidth"
            }
            ; A TEXT mark's size is how big the letters are: a pictogram chart
            ; drawn out of emoji sizes them by the count they stand for. Given
            ; a symbol's area instead it reaches nothing and every glyph came
            ; out at the default eleven points.
            if (markName == "text") {
                sizeKey = "fontSize"
            }
            if size.hasValue {
                update.setMember(sizeKey (this.withCondition(size (VlCompile.literal(size.value)))))
            } {
                update.setMember(sizeKey (this.scaled("size" (size.outField()))))
            }
        }
        def shape:VlChannel (this.channel("shape"))
        if shape.defined {
            if shape.hasValue {
                update.setMember("shape" (VlCompile.literal(shape.value)))
            } {
                update.setMember("shape" (this.scaled("shape" (shape.outField()))))
            }
        } {
            ; A `circle` and a `square` are points whose shape is in their
            ; name, and the reference says so on the mark rather than leaving
            ; the symbol to its default.
            if (markName == "circle") {
                update.setMember("shape" (VlCompile.literal((VlJson.stringValue("circle")))))
            }
            if (markName == "square") {
                update.setMember("shape" (VlCompile.literal((VlJson.stringValue("square")))))
            }
        }
        def dash:VlChannel (this.channel("strokeDash"))
        if dash.defined {
            if dash.hasValue {
                update.setMember("strokeDash" (VlCompile.literal(dash.value)))
            } {
                update.setMember("strokeDash" (this.scaled("strokeDash" (dash.outField()))))
            }
        }
        ; `"opacity": {"value": 0.7}` is how two overlapping bars are drawn so
        ; that both can be seen, and it reached nothing: the channel was read,
        ; noted, and never written, so the chart came out opaque and the series
        ; behind was invisible. A condition writes its fallback here, which is
        ; what a drawing with no interaction in it shows.
        ; …and it may answer to a selection rather than being flat: a hover
        ; chart fades every series but the one under the pointer, and that is
        ; the same conditional every other paint channel carries.
        def opacity:VlChannel (this.channel("opacity"))
        if opacity.defined {
            if opacity.hasValue {
                update.setMember("opacity" (this.withCondition(opacity (VlCompile.literal(opacity.value)))))
            } {
                this.fail("an opacity read from a field is not compiled here")
            }
        }
        ; A rule given only one position is a line ACROSS the plot at that
        ; value — a mean line, a threshold — so it spans the other axis.
        if (markName == "rule") {
            if (! (this.hasChannel("x"))) {
                update.setMember("x" (VlCompile.groupField("width")))
                update.setMember("x2" (VlCompile.literal((VlJson.numberValue(0.0)))))
            }
            if (! (this.hasChannel("y"))) {
                update.setMember("y" (VlCompile.groupField("height")))
                update.setMember("y2" (VlCompile.literal((VlJson.numberValue(0.0)))))
            }
        }
        ; A rectangle given only one pair of positions spans the plot in the
        ; other direction. A chart of historical periods is exactly that: two
        ; rects with a start and an end year and nothing said about the
        ; vertical, meant to be bands behind the line. Left without a y they
        ; came out as two rectangles of no height at all.
        if (markName == "rect") {
            if (! (this.hasChannel("y"))) {
                update.setMember("y" (VlCompile.literal((VlJson.numberValue(0.0)))))
                update.setMember("y2" (VlCompile.groupField("height")))
            }
            if (! (this.hasChannel("x"))) {
                update.setMember("x" (VlCompile.literal((VlJson.numberValue(0.0)))))
                update.setMember("x2" (VlCompile.groupField("width")))
            }
        }
        def text:VlChannel (this.channel("text"))
        if text.defined {
            if (! text.hasValue) {
                def signal (VlJson.objectValue())
                def expr:string (VlCompile.describeOne((text.outField()) (text.isDiscrete())))
                signal.setMember("signal" (VlJson.stringValue(expr)))
                update.setMember("text" signal)
            }
        }
        ; An image's `url` is the picture it draws. Read as nothing, the mark
        ; came out as an empty box the right size in the right place with no
        ; picture in it.
        def url:VlChannel (this.channel("url"))
        if url.defined {
            if url.hasValue {
                update.setMember("url" (VlCompile.literal(url.value)))
            } {
                def named:string (url.outField())
                def pick (VlJson.objectValue())
                def expr:string (((((("isValid(" + (VlCompile.datumRef(named))) + ") ? ") + (VlCompile.datumRef(named))) + " : \"\"+") + (VlCompile.datumRef(named))))
                pick.setMember("signal" (VlJson.stringValue(expr)))
                update.setMember("url" pick)
            }
        }
        ; A line or an area is one shape through many rows, so the rows it must
        ; skip are marked rather than dropped: dropping them would join across
        ; the gap.
        if (VlCompile.isPathMark(markName)) {
            def expr:string (this.validityExpr())
            if ((strlen expr) > 0) {
                def d (VlJson.objectValue())
                d.setMember("signal" (VlJson.stringValue(expr)))
                update.setMember("defined" d)
            }
        }
    }

    ; The half pixel a binned bar is nudged by, so that neighbouring bars share
    ; an edge instead of overlapping on it — and, when a bin is narrower than a
    ; quarter of a pixel, so that it does not vanish. Both edges carry the same
    ; expression with the sign flipped; `upper` is the bin's end.
    ; How much room a mark leaves between one bin and the next: a bar stands a
    ; pixel clear of its neighbour, a heat map's cells touch.
    fn binSpacing:double () {
        if (markName == "rect") {
            return 0.0
        }
        return 1.0
    }

    sfn binNudge:VlJson (startField:string endField:string axis:string upper:boolean spacing:double) {
        def gap:string (((((("abs(scale(\"" + axis) + "\", datum[\"") + endField) + "\"]) - scale(\"" + axis) + "\", datum[\"") + startField) + "\"]))")
        def half:string (VlJson.formatNumber((spacing / 2.0) 6))
        def toward:string ("-" + half)
        def away:string half
        if upper {
            toward = half
            away = ("-" + half)
        }
        if (spacing == 0.0) {
            toward = "0.5"
            away = "0"
            if (! upper) {
                toward = "-0.5"
            }
        }
        def expr:string ((((((("0.5 + (" + gap) + " < 0.25 ? ") + toward) + " * (0.25 - (") + gap) + ")) : ") + away) + ")")
        def out (VlJson.objectValue())
        out.setMember("signal" (VlJson.stringValue(expr)))
        return out
    }

    fn encodeAxisPair:void (update:VlJson ch:VlChannel axis:string dimension:string) {
        if (! ch.defined) {
            return
        }
        if ch.hasValue {
            update.setMember(axis (VlCompile.literal(ch.value)))
            return
        }
        ; A DATUM is a constant read THROUGH the scale rather than in pixels:
        ; `{"datum": 300}` on y is the line at three hundred on the axis, not
        ; three hundred pixels down the page. Left out, an annotation drawn
        ; across a chart had no vertical position at all.
        if ch.hasDatum {
            def at (VlJson.objectValue())
            at.setMember("scale" (VlJson.stringValue((this.sname(axis)))))
            at.setMember("value" ch.value)
            update.setMember(axis at)
            return
        }
        if ((strlen (ch.outField())) == 0) {
            return
        }
        def type:string (this.scaleTypeFor(ch))
        if (type == "band") {
            def at:VlJson (this.scaled(axis (ch.outField())))
            ; A mark drawn BETWEEN two categories runs from the middle of one
            ; to the middle of the other — a waterfall's connector from the
            ; centre of one month's bar to the centre of the next, a heat
            ; lane's block from one computed edge to another. Which mark it is
            ; does not come into it: what decides is that the chart named both
            ; ends. Filled to the band instead, every block came out the same
            ; height whatever it was measuring.
            def other:VlChannel (this.channel((axis + "2")))
            if other.defined {
                if ((strlen (other.outField())) > 0) {
                    at.setMember("band" (VlJson.numberValue(0.5)))
                    update.setMember(axis at)
                    def far:VlJson (this.scaled(axis (other.outField())))
                    far.setMember("band" (VlJson.numberValue(0.5)))
                    update.setMember((axis + "2") far)
                    return
                }
            }
            ; A label over a bar chart sits on the same band scale the bars do,
            ; and it does not fill the band — it stands in the middle of it.
            if (! (this.fillsBand())) {
                at.setMember("band" (VlJson.numberValue(0.5)))
                update.setMember(axis at)
                return
            }
            ; A mark told how THICK it is does not fill its band: it is
            ; centred in it at exactly that thickness, which is how a box plot
            ; drawn by hand keeps its boxes fourteen pixels deep whatever the
            ; band underneath them is.
            def stated:double (this.statedSize())
            if (stated > 0.0) {
                at.setMember("band" (VlJson.numberValue(0.5)))
                update.setMember((axis + "c") at)
                update.setMember(dimension (VlCompile.literal((VlJson.numberValue(stated)))))
                return
            }
            def band:string axis
            ; A grouped bar is placed at its band AND then along the sub-scale
            ; inside it, so its width is the sub-band's rather than the band's.
            def offset:VlChannel (this.channel("xOffset"))
            if (offset.defined && (axis == "x")) {
                at.setMember("offset" (this.scaled("xOffset" (offset.outField()))))
                band = "xOffset"
            }
            ; A mark may take a FRACTION of its band rather than all of it —
            ; `"height": {"band": 0.5}` is a bar half as deep as the row it
            ; sits in — and the half it does not take is shared evenly either
            ; side, so the mark starts a quarter of the way in.
            def share:double (this.bandShare(dimension))
            if (share > 0.0) {
                at.setMember("band" (VlJson.numberValue(((1.0 - share) / 2.0))))
                update.setMember(axis at)
                def part (VlJson.objectValue())
                def factor:string (VlJson.formatNumber(share 4))
                part.setMember("signal" (VlJson.stringValue(((("max(0.25, " + factor) + " * bandwidth('") + (this.sname(band))) + "'))")))
                update.setMember(dimension part)
                return
            }
            update.setMember(axis at)
            def width (VlJson.objectValue())
            width.setMember("signal" (VlJson.stringValue((("max(0.25, bandwidth('" + (this.sname(band))) + "'))"))))
            update.setMember(dimension width)
            return
        }
        ; A binned bar spans its bin, and the pair of half-pixel nudges keeps a
        ; bin narrower than a quarter pixel from disappearing entirely.
        ;
        ; A bar over bins that were computed UPSTREAM spans its bin the same
        ; way — the only difference is where the far edge's name comes from:
        ; a computed bin derives it, and a pre-binned one is handed it by the
        ; partner channel. Drawing that case without the nudges left every bar
        ; a pixel wider than the reference's and touching its neighbour.
        def endField:string ""
        if ch.hasBin {
            endField = (ch.binEndField())
        }
        if ch.binnedAlready {
            def partner:VlChannel (this.channel((ch.name + "2")))
            if partner.defined {
                endField = (partner.outField())
            }
        }
        if ((strlen endField) == 0) {
            endField = (this.unitEndField(ch))
        }
        if ((strlen endField) > 0) {
            ; A bin has two edges, and whether a mark SPANS them or stands at
            ; one point between them is a property of the mark: a bar fills its
            ; bin, and a line through the bins joins their MIDDLES. Drawn to
            ; the far edge instead, every vertex of a binned line sat half a
            ; bin to the right of where the reference puts it.
            if (! (this.spansBin())) {
                def mid (VlJson.objectValue())
                def half:string ((("scale(\"" + (this.sname(axis))) + "\", 0.5 * ") + (VlCompile.datumRef((ch.outField()))))
                half = (((half + " + 0.5 * ") + (VlCompile.datumRef(endField))) + ")")
                mid.setMember("signal" (VlJson.stringValue(half)))
                update.setMember(axis mid)
                return
            }
            def from:VlJson (this.scaled(axis endField))
            from.setMember("offset" (VlCompile.binNudge((ch.outField()) endField axis true (this.binSpacing()))))
            update.setMember(axis from)
            def to:VlJson (this.scaled(axis (this.unitStartField(ch))))
            to.setMember("offset" (VlCompile.binNudge((this.unitStartField(ch)) endField axis false (this.binSpacing()))))
            update.setMember((axis + "2") to)
            return
        }
        if ((strlen stackField) > 0) {
            if ((ch.outField()) == stackField) {
                ; A mark that FILLS its segment is drawn between the two ends;
                ; one that stands IN it stands at a point between them, which
                ; for a label is the middle. Drawn to the far end instead,
                ; every label on a stacked bar sat on the line between its own
                ; segment and the next.
                if (this.standsInStack()) {
                    def where:double (ch.def0.doubleOr("bandPosition" 0.5))
                    def other:double (1.0 - where)
                    def mid (VlJson.objectValue())
                    def at:string ((("scale(\"" + (this.sname(axis))) + "\", ") + (VlJson.formatNumber(other 6)))
                    at = ((((at + " * ") + (VlCompile.datumRef((stackField + "_start")))) + " + ") + (VlJson.formatNumber(where 6)))
                    at = (((at + " * ") + (VlCompile.datumRef((stackField + "_end")))) + ")")
                    mid.setMember("signal" (VlJson.stringValue(at)))
                    update.setMember(axis mid)
                    return
                }
                update.setMember(axis (this.scaled(axis (stackField + "_end"))))
                update.setMember((axis + "2") (this.scaled(axis (stackField + "_start"))))
                return
            }
        }
        ; A tick is a short line drawn ACROSS its band, so it is centred on its
        ; value and given a thickness rather than placed by its corner.
        if (markName == "tick") {
            update.setMember((axis + "c") (this.scaled(axis (ch.outField()))))
            update.setMember(dimension (VlCompile.literal((VlJson.numberValue(1.0)))))
            ; With nothing on the other axis there is no band to cross, so the
            ; tick crosses the plot itself — three quarters of it, centred.
            def other:string "y"
            def otherSize:string "height"
            if (axis == "y") {
                other = "x"
                otherSize = "width"
            }
            if (! (this.hasChannel(other))) {
                def centre (VlJson.objectValue())
                centre.setMember("signal" (VlJson.stringValue((this.sizeSignal(otherSize)))))
                centre.setMember("mult" (VlJson.numberValue(0.5)))
                update.setMember((other + "c") centre)
                def across (VlJson.objectValue())
                across.setMember("signal" (VlJson.stringValue((("0.75 * " + (this.sizeSignal(otherSize)))))))
                update.setMember(otherSize across)
            }
            return
        }
        ; A channel may name a SECOND field — a bar from one value to another,
        ; which is what a Gantt chart is — and then both ends are given.
        def second:VlChannel (this.channel((axis + "2")))
        if second.defined {
            if ((strlen second.field) > 0) {
                update.setMember(axis (this.scaled(axis (ch.outField()))))
                update.setMember((axis + "2") (this.scaled(axis (second.outField()))))
                return
            }
        }
        ; A row whose number is missing is still drawn when the chart asked to
        ; keep it: at the zero of its own scale, tested per row, which is what
        ; the reference writes in place of dropping it upstream.
        if (this.keepsInvalid()) {
            def choice (VlJson.arrayValue())
            def missing (VlJson.objectValue())
            missing.setMember("test" (VlJson.stringValue((VlCompile.invalidExpr((ch.outField()))))))
            missing.setMember("scale" (VlJson.stringValue((this.sname(axis)))))
            missing.setMember("value" (VlJson.numberValue(0.0)))
            push choice.arr missing
            push choice.arr (this.scaled(axis (ch.outField())))
            update.setMember(axis choice)
            return
        }
        ; An image given a size is placed by its MIDDLE, not by its corner:
        ; `{"type": "image", "width": 50}` means a fifty-pixel picture centred
        ; on the point it stands for, which is why the reference writes `xc`
        ; and `yc`. Written as a corner, every picture sat down and to the
        ; right of where it belongs by half its own size.
        if (markName == "image") {
            if (markDef.has(dimension)) {
                update.setMember((axis + "c") (this.scaled(axis (ch.outField()))))
                return
            }
        }
        update.setMember(axis (this.scaled(axis (ch.outField()))))
        ; A bar has LENGTH, so it needs both ends. A stacked one gets them from
        ; the stack; an unstacked one runs from the baseline of its scale.
        if ((markName == "bar") || (markName == "area")) {
            def measure:VlChannel (this.stackMeasure())
            if (measure.name == ch.name) {
                def base (VlJson.objectValue())
                ; The PANE's scale, not a scale called "x": a concatenated view
                ; names each pane's scales after it, and a baseline that named
                ; the bare axis referred to a scale no chart defines.
                base.setMember("scale" (VlJson.stringValue((this.sname(axis)))))
                base.setMember("value" (VlJson.numberValue(0.0)))
                update.setMember((axis + "2") base)
            }
        }
    }
}

; ==============================================================================
; VlConfig.rgr — the style defaults a mark inherits before its own encode runs.
; ==============================================================================
; A compiled Vega-Lite spec does not spell out every property it draws with. A
; point mark carries `"style": ["point"]` and nothing else about its size, and
; the reference fills in 30 from its default configuration. Without this table a
; scatter plot's symbols come out the wrong size and nothing in the spec says
; why — the value is in the renderer's defaults, not in the document.
;
; The values below are the reference implementation's own defaults (vega-parser's
; config), restricted to the styles the specs here use. A spec's own `config`
; block is merged over them, so an explicit setting always wins.
; ==============================================================================

Import "VlJson.rgr"

class VlConfig {
    ; What a built-in range name means in THIS chart, when its
    ; configuration renamed it.
    def rangeSchemes:[string:string]
    ; …or the colours themselves: `{"range": {"category": ["#B96926",
    ; "#59C3C4"]}}` is every category scale in this chart in a deck's own
    ; palette (kept joined by spaces)
    def rangeLists:[string:string]
    def styles:[string:VlJson]
    ; Per-mark-type defaults: `config.rect`, `config.line`, `config.symbol`, …
    ; These are applied before the styles and are what give a line its width and
    ; a symbol its default fill.
    def markTypes:[string:VlJson]
    ; `config.mark` applies to every mark type; empty by default.
    def markAll:VlJson (VlJson.objectValue())
    ; `config.axis`: what every axis starts from before its own spec is read.
    ; A spec that wants its guides in a different colour says so once here
    ; rather than on each of its axes, and the reference reads it the same way.
    def axisAll:VlJson (VlJson.objectValue())
    ; …and what it says about the axes of ONE dimension. `"axisX": {…}` is how
    ; a page of histograms narrows every horizontal axis at once, and it is
    ; read by the axis' orientation: top and bottom are the x axes.
    def axisAcross:VlJson (VlJson.objectValue())
    def axisDown:VlJson (VlJson.objectValue())
    ; `config.legend`, which every legend inherits the same way every axis
    ; inherits `config.axis` — the colours a legend reads on a dark page are a
    ; property of the chart, and stating them once is the only way to say so
    ; without repeating them on every channel that happens to have a key.
    def legendAll:VlJson (VlJson.objectValue())

    ; --- the built-in table ---------------------------------------------------
    fn loadDefaults:void () {
        this.loadMarkTypeDefaults()
        def cell:VlJson (VlJson.objectValue())
        cell.setMember("fill" (VlJson.stringValue("transparent")))
        cell.setMember("stroke" (VlJson.stringValue("#ddd")))
        set styles "cell" cell

        ; A chart with no plotting frame — a pie, an arc — carries "view"
        ; instead of "cell": the same transparent background with no border
        ; drawn round it.
        def view:VlJson (VlJson.objectValue())
        view.setMember("fill" (VlJson.stringValue("transparent")))
        set styles "view" view

        def point:VlJson (VlJson.objectValue())
        point.setMember("size" (VlJson.intValue(30)))
        point.setMember("strokeWidth" (VlJson.intValue(2)))
        point.setMember("shape" (VlJson.stringValue("circle")))
        set styles "point" point

        ; A circle and a square are a point with the shape decided, so they
        ; inherit its stroke width along with its size.
        def circle:VlJson (VlJson.objectValue())
        circle.setMember("size" (VlJson.intValue(30)))
        circle.setMember("strokeWidth" (VlJson.intValue(2)))
        circle.setMember("shape" (VlJson.stringValue("circle")))
        set styles "circle" circle

        def square:VlJson (VlJson.objectValue())
        square.setMember("size" (VlJson.intValue(30)))
        square.setMember("strokeWidth" (VlJson.intValue(2)))
        square.setMember("shape" (VlJson.stringValue("square")))
        set styles "square" square

        def guideLabel:VlJson (VlJson.objectValue())
        guideLabel.setMember("fill" (VlJson.stringValue("#000")))
        guideLabel.setMember("font" (VlJson.stringValue("sans-serif")))
        guideLabel.setMember("fontSize" (VlJson.intValue(10)))
        set styles "guide-label" guideLabel

        def guideTitle:VlJson (VlJson.objectValue())
        guideTitle.setMember("fill" (VlJson.stringValue("#000")))
        guideTitle.setMember("font" (VlJson.stringValue("sans-serif")))
        guideTitle.setMember("fontSize" (VlJson.intValue(11)))
        guideTitle.setMember("fontWeight" (VlJson.stringValue("bold")))
        set styles "guide-title" guideTitle

        def groupTitle:VlJson (VlJson.objectValue())
        groupTitle.setMember("fill" (VlJson.stringValue("#000")))
        groupTitle.setMember("font" (VlJson.stringValue("sans-serif")))
        groupTitle.setMember("fontSize" (VlJson.intValue(13)))
        groupTitle.setMember("fontWeight" (VlJson.stringValue("bold")))
        set styles "group-title" groupTitle
    }

    ; The reference's per-mark-type defaults, with its own constants:
    ; #4c78a8 as the default colour, 2 as the default stroke width, 30 as the
    ; default symbol size (64 for a bare symbol mark), #000 for text.
    fn loadMarkTypeDefaults:void () {
        def arc:VlJson (VlJson.objectValue())
        arc.setMember("fill" (VlJson.stringValue("#4c78a8")))
        set markTypes "arc" arc

        def area:VlJson (VlJson.objectValue())
        area.setMember("fill" (VlJson.stringValue("#4c78a8")))
        set markTypes "area" area

        def line:VlJson (VlJson.objectValue())
        line.setMember("stroke" (VlJson.stringValue("#4c78a8")))
        line.setMember("strokeWidth" (VlJson.intValue(2)))
        set markTypes "line" line

        def pathMark:VlJson (VlJson.objectValue())
        pathMark.setMember("stroke" (VlJson.stringValue("#4c78a8")))
        set markTypes "path" pathMark

        def rect:VlJson (VlJson.objectValue())
        rect.setMember("fill" (VlJson.stringValue("#4c78a8")))
        set markTypes "rect" rect

        def rule:VlJson (VlJson.objectValue())
        rule.setMember("stroke" (VlJson.stringValue("#000")))
        set markTypes "rule" rule

        def shape:VlJson (VlJson.objectValue())
        shape.setMember("stroke" (VlJson.stringValue("#4c78a8")))
        set markTypes "shape" shape

        def symbol:VlJson (VlJson.objectValue())
        symbol.setMember("fill" (VlJson.stringValue("#4c78a8")))
        symbol.setMember("size" (VlJson.intValue(64)))
        set markTypes "symbol" symbol

        def textMark:VlJson (VlJson.objectValue())
        textMark.setMember("fill" (VlJson.stringValue("#000")))
        textMark.setMember("font" (VlJson.stringValue("sans-serif")))
        textMark.setMember("fontSize" (VlJson.intValue(11)))
        set markTypes "text" textMark

        def trail:VlJson (VlJson.objectValue())
        trail.setMember("fill" (VlJson.stringValue("#4c78a8")))
        trail.setMember("size" (VlJson.intValue(2)))
        set markTypes "trail" trail
    }

    ; A mark drawn as a line rather than as a block of colour, for which
    ; `color` means the stroke.
    sfn outlinedMark:boolean (name:string) {
        return (((name == "line") || (name == "rule")) || (name == "path"))
    }

    fn markTypeDefaults:VlJson (markType:string) {
        if (has markTypes markType) {
            return (unwrap (get markTypes markType))
        }
        return (VlJson.objectValue())
    }

    ; --- a spec's own config --------------------------------------------------
    fn mergeSpecConfig:void (config:VlJson) {
        if (! (config.isObject())) {
            return
        }
        ; `config.range` renames the palettes the built-in range NAMES stand
        ; for: `{"range": {"ramp": {"scheme": "yellowgreenblue"}}}` says every
        ; continuous colour scale in this chart reads that scheme rather than
        ; the default blues. The scale still says `"range": "ramp"`; what ramp
        ; means is what changes.
        ; `config.view` is the plotting frame's own style: `{"strokeWidth": 0}`
        ; or `{"stroke": ""}` is a chart asking for no border round its plot,
        ; and drawn anyway that border is a rectangle the reference does not
        ; have. `step` belongs to the layout rather than to the paint and is
        ; read where the sizes are decided.
        def viewBlock:VlJson (config.get("view"))
        if (viewBlock.isObject()) {
            def cellStyle:VlJson (VlJson.objectValue())
            if (has styles "cell") {
                def base:VlJson (unwrap (get styles "cell"))
                for base.keys bk:string bi {
                    cellStyle.setMember(bk (base.get(bk)))
                }
            }
            for viewBlock.keys vk:string vi {
                if (vk != "step") {
                    cellStyle.setMember(vk (viewBlock.get(vk)))
                }
            }
            set styles "cell" cellStyle
        }

        def rangeBlock:VlJson (config.get("range"))
        if (rangeBlock.isObject()) {
            for rangeBlock.keys rk:string ri {
                def entry:VlJson (rangeBlock.get(rk))
                if (entry.isArray()) {
                    def joined:string ""
                    def ei:int 0
                    while (ei < (entry.count())) {
                        def cell:VlJson (entry.at(ei))
                        if (cell.isString()) {
                            if ((strlen joined) > 0) {
                                joined = (joined + " ")
                            }
                            joined = (joined + cell.str)
                        }
                        ei = (ei + 1)
                    }
                    if ((strlen joined) > 0) {
                        set rangeLists rk joined
                    }
                }
                if (entry.isObject()) {
                    def named:string (entry.stringOr("scheme" ""))
                    if ((strlen named) > 0) {
                        set rangeSchemes rk named
                    }
                }
            }
        }
        if (config.get("mark").isObject()) {
            markAll = (config.get("mark"))
        }
        if (config.get("axis").isObject()) {
            axisAll = (config.get("axis"))
        }
        if (config.get("axisX").isObject()) {
            axisAcross = (config.get("axisX"))
        }
        if (config.get("axisY").isObject()) {
            axisDown = (config.get("axisY"))
        }
        if (config.has("legend")) {
            legendAll = (config.get("legend"))
        }
        for config.keys name:string ci {
            if (has markTypes name) {
                def incomingMark:VlJson (config.get(name))
                if (incomingMark.isObject()) {
                    def base:VlJson (unwrap (get markTypes name))
                    def mergedMark:VlJson (VlJson.objectValue())
                    for base.keys key:string bi {
                        mergedMark.setMember(key (base.get(key)))
                    }
                    for incomingMark.keys key:string ii {
                        ; `color` is what a person writes and `fill` or
                        ; `stroke` is what a renderer reads — which of the two
                        ; depends on the mark. Copied across as it stands it
                        ; reached nothing, and a chart that asked for dark grey
                        ; labels got black ones.
                        def target:string key
                        if (key == "color") {
                            target = "fill"
                            if (VlConfig.outlinedMark(name)) {
                                target = "stroke"
                            }
                        }
                        mergedMark.setMember(target (incomingMark.get(key)))
                    }
                    set markTypes name mergedMark
                }
            }
        }
        def styleBlock:VlJson (config.get("style"))
        if (! (styleBlock.isObject())) {
            return
        }
        for styleBlock.keys name:string ki {
            def incoming:VlJson (styleBlock.get(name))
            if (incoming.isObject()) {
                def merged:VlJson (VlJson.objectValue())
                if (has styles name) {
                    def existing:VlJson (unwrap (get styles name))
                    for existing.keys key:string ei {
                        merged.setMember(key (existing.get(key)))
                    }
                }
                for incoming.keys key:string ii {
                    merged.setMember(key (incoming.get(key)))
                }
                set styles name merged
            }
        }
    }

    ; One axis' settings: the config's defaults with the axis' own on top.
    fn mergedAxis:VlJson (adef:VlJson) {
        def orient:string (adef.stringOr("orient" "bottom"))
        def sided:VlJson axisDown
        if ((orient == "bottom") || (orient == "top")) {
            sided = axisAcross
        }
        def anySided:int (array_length sided.keys)
        if ((array_length axisAll.keys) == 0) {
            if (anySided == 0) {
                return adef
            }
        }
        def out:VlJson (VlJson.objectValue())
        for axisAll.keys key:string ai {
            out.setMember(key (axisAll.get(key)))
        }
        for sided.keys skey:string si {
            out.setMember(skey (sided.get(skey)))
        }
        for adef.keys key:string di {
            out.setMember(key (adef.get(key)))
        }
        return out
    }

    fn mergedLegend:VlJson (ldef:VlJson) {
        if ((array_length legendAll.keys) == 0) {
            return ldef
        }
        def out:VlJson (VlJson.objectValue())
        for legendAll.keys key:string ai {
            out.setMember(key (legendAll.get(key)))
        }
        for ldef.keys key:string di {
            out.setMember(key (ldef.get(key)))
        }
        return out
    }

    fn hasStyle:boolean (name:string) {
        return (has styles name)
    }

    fn style:VlJson (name:string) {
        if (has styles name) {
            return (unwrap (get styles name))
        }
        return (VlJson.objectValue())
    }

    ; The categorical colour schemes, by the names a spec uses. `category` is
    ; the configured default for a nominal colour scale and resolves to
    ; tableau10, which is where a chart's first bar gets #4c78a8 from.
    ; A ramp is stored the way the reference stores one: the hex digits of every
    ; colour run together, six at a time, because a list of eleven quoted
    ; strings is eleven times the noise for the same eleven colours.
    sfn ramp:[string] (digits:string) {
        def out:[string]
        def n:int (strlen digits)
        def i:int 0
        while ((i + 6) <= n) {
            push out ("#" + (substring digits i (i + 6)))
            i = (i + 6)
        }
        return out
    }

    ; The palette a range name stands for in this chart, after any renaming
    ; the configuration did.
    fn schemeFor:[string] (name:string) {
        if (has rangeLists name) {
            return (strsplit (unwrap (get rangeLists name)) " ")
        }
        if (has rangeSchemes name) {
            return (VlConfig.schemeColors((unwrap (get rangeSchemes name))))
        }
        return (VlConfig.schemeColors(name))
    }

    ; Is that scheme a RAMP — a continuous run of colour — rather than a list
    ; of distinct ones? An ordinal scale is spread along the first and takes
    ; the second in turn, and the two read completely differently.
    fn schemeIsRamp:boolean (name:string) {
        def resolved:string name
        if (has rangeSchemes name) {
            resolved = (unwrap (get rangeSchemes name))
        }
        return (VlConfig.rampScheme(resolved))
    }

    sfn rampScheme:boolean (name:string) {
        if (name == "ordinal") {
            return true
        }
        ; `ramp` and `sequential` are the configuration's own names for a
        ; continuous scheme, and a continuous scheme is what they stand for:
        ; the reference resolves both to `blues`. Read as ordinary palettes,
        ; a scale asked to cut a column into five bands took the first five
        ; STOPS of the ramp instead of sampling it five times, and came out in
        ; five shades of the palest blue.
        if ((name == "ramp") || (name == "sequential")) {
            return true
        }
        if (((name == "blues") || (name == "greens")) || ((name == "greys") || (name == "oranges"))) {
            return true
        }
        if (((name == "purples") || (name == "reds")) || ((name == "viridis") || (name == "magma"))) {
            return true
        }
        if (((name == "rainbow") || (name == "greenblue")) || ((name == "inferno") || (name == "plasma"))) {
            return true
        }
        if ((name == "yellowgreenblue") || (name == "yellowGreenBlue")) {
            return true
        }
        if ((name == "lighttealblue") || (name == "lightTealBlue")) {
            return true
        }
        return ((strlen (VlConfig.vegaRamp(name))) > 0)
    }

    sfn schemeColors:[string] (name:string) {
        def out:[string]
        if ((name == "category") || (name == "tableau10")) {
            push out "#4c78a8"
            push out "#f58518"
            push out "#e45756"
            push out "#72b7b2"
            push out "#54a24b"
            push out "#eeca3b"
            push out "#b279a2"
            push out "#ff9da6"
            push out "#9d755d"
            push out "#bab0ac"
            return out
        }
        ; The shapes an ordinal `symbol` range hands out, in the reference's
        ; order. A shape scale is an ordinal scale like any other; only its
        ; range is names rather than colours.
        if (name == "symbol") {
            push out "circle"
            push out "square"
            push out "triangle-up"
            push out "cross"
            push out "diamond"
            push out "triangle-right"
            push out "triangle-down"
            push out "triangle-left"
            return out
        }
        ; Continuous colour ramps. A CONTINUOUS scale interpolates between
        ; these; an ordinal one picks from them by index, which is the same list
        ; read two ways. `heatmap` and `ramp` are the reference's own names for
        ; the ramps its configuration reaches for by default.
        if ((name == "heatmap") || (name == "yellowgreenblue")) {
            return (VlConfig.ramp("eff9bddbf1b4bde5b594d5b969c5be45b4c22c9ec02182b82163aa23479c1c3185"))
        }
        ; An ORDINAL column has an order — four cylinders is more than three —
        ; so the reference's default range for one is the blue ramp rather
        ; than the palette, with the categories spread along it.
        if ((((name == "ramp") || (name == "blues")) || (name == "sequential")) || (name == "ordinal")) {
            return (VlConfig.ramp("cfe1f2bed8eca8cee58fc1de74b2d75ba3cf4592c63181bd206fb2125ca40a4a90"))
        }
        ; A scale read in two directions from a middle. The reference's default
        ; is blue-orange, taken from its high end down — `extent: [1, 0]` — so
        ; the stops are listed here in that order rather than carrying an
        ; extent through the scale layer for one scheme's sake.
        if (name == "diverging") {
            return (VlConfig.ramp("994a07c5690de8932ffbbf74fce0baf2f0ebd2e5ef9dcae15da2cb2f78b3134b85"))
        }
        if ((name == "blueorange") || (name == "blue-orange")) {
            return (VlConfig.ramp("134b852f78b35da2cb9dcae1d2e5eff2f0ebfce0bafbbf74e8932fc5690d994a07"))
        }
        if (name == "greens") {
            return (VlConfig.ramp("d3eecdc0e6baabdda594d3917bc77d60ba6c46ab5e329a512089430e7735036429"))
        }
        if (name == "greys") {
            return (VlConfig.ramp("e2e2e2d4d4d4c4c4c4b1b1b19d9d9d8888887575756262624d4d4d3535351e1e1e"))
        }
        if (name == "oranges") {
            return (VlConfig.ramp("fdd8b3fdc998fdb87bfda55efc9244f87f2cf06b18e4580bd14904b93d029f3303"))
        }
        if (name == "purples") {
            return (VlConfig.ramp("e2e1efd4d4e8c4c5e0b4b3d6a3a0cc928ec3827cb97566ae684ea25c3696501f8c"))
        }
        if (name == "reds") {
            return (VlConfig.ramp("fdc9b4fcb49afc9e80fc8767fa7051f6573fec3f2fdc2a25c81b1db21218970b13"))
        }
        if (name == "viridis") {
            return (VlConfig.ramp("440154470e61481a6c482575472f7d443a834144873d4e8a39568c35608d31688e2d708e2a788e27818e23888e21918d1f988b1fa08822a8842ab07f35b77943bf7154c56866cc5d7ad1518fd744a5db36bcdf27d2e21be9e51afde725"))
        }
        if (name == "magma") {
            return (VlConfig.ramp("0000040404130b0924150e3720114b2c11603b0f704a107957157e651a80721f817f24828c29819a2e80a8327db6377ac43c75d1426fde4968e95462f1605df76f5cfa7f5efc8f65fe9f6dfeaf78febf84fece91fddea0fcedaffcfdbf"))
        }
        if (name == "rainbow") {
            return (VlConfig.ramp("6e40aa883eb1a43db3bf3cafd83fa4ee4395fe4b83ff576eff6659ff7847ff8c38f3a130e2b72fcfcc36bee044aff05b8ff4576ff65b52f6673af27828ea8d1ddfa319d0b81cbecb23abd82f96e03d82e14c6edb5a5dd0664dbf6e40aa"))
        }
        if ((name == "yellowgreenblue") || (name == "yellowGreenBlue")) {
            return (VlConfig.ramp("eff9bdd4eeb4a9ddb774c9bd45b4c22997be2173b1234ea01c3185"))
        }
        if ((name == "lighttealblue") || (name == "lightTealBlue")) {
            return (VlConfig.ramp("e3e9e0c0dccf9aceca7abfc859afc0389fb9328dad2f7ca0276b95255988"))
        }
        ; A twenty-colour categorical palette, in four shades of five hues —
        ; what a chart reaches for when ten categories are not enough.
        if (name == "category20b") {
            return (VlConfig.ramp("393b795254a36b6ecf9c9ede6379398ca252b5cf6bcedb9c8c6d31bd9e39e7ba52e7cb94843c39ad494ad6616be7969c7b4173a55194ce6dbdde9ed6"))
        }
        ; ColorBrewer Set2 and Dark2, as Vega names them. Both are qualitative
        ; palettes meant for a light page; Set2 is the one that also reads on a
        ; DARK one, which is what a chart on a slate background needs — the
        ; twenty-colour palette starts at #393b79 and disappears into it.
        if (name == "set2") {
            push out "#66c2a5"
            push out "#fc8d62"
            push out "#8da0cb"
            push out "#e78ac3"
            push out "#a6d854"
            push out "#ffd92f"
            push out "#e5c494"
            push out "#b3b3b3"
            return out
        }
        if (name == "dark2") {
            push out "#1b9e77"
            push out "#d95f02"
            push out "#7570b3"
            push out "#e7298a"
            push out "#66a61e"
            push out "#e6ab02"
            push out "#a6761d"
            push out "#666666"
            return out
        }
        ; The rest of ColorBrewer's qualitative palettes, as Vega names them.
        ; Pastel1 and Pastel2 are the light ones a chart on a dark slide picks.
        if (name == "pastel1") {
            return (VlConfig.ramp("fbb4aeb3cde3ccebc5decbe4fed9a6ffffcce5d8bdfddaecf2f2f2"))
        }
        if (name == "pastel2") {
            return (VlConfig.ramp("b3e2cdfdcdaccbd5e8f4cae4e6f5c9fff2aef1e2cccccccc"))
        }
        if (name == "set1") {
            return (VlConfig.ramp("e41a1c377eb84daf4a984ea3ff7f00ffff33a65628f781bf999999"))
        }
        if (name == "set3") {
            return (VlConfig.ramp("8dd3c7ffffb3bebadafb807280b1d3fdb462b3de69fccde5d9d9d9bc80bdccebc5ffed6f"))
        }
        if (name == "accent") {
            return (VlConfig.ramp("7fc97fbeaed4fdc086ffff99386cb0f0027fbf5b17666666"))
        }
        if (name == "paired") {
            return (VlConfig.ramp("a6cee31f78b4b2df8a33a02cfb9a99e31a1cfdbf6fff7f00cab2d66a3d9affff99b15928"))
        }
        if (name == "category10") {
            push out "#1f77b4"
            push out "#ff7f0e"
            push out "#2ca02c"
            push out "#d62728"
            push out "#9467bd"
            push out "#8c564b"
            push out "#e377c2"
            push out "#7f7f7f"
            push out "#bcbd22"
            push out "#17becf"
            return out
        }
        def more:string (VlConfig.vegaDiscrete(name))
        if ((strlen more) == 0) {
            more = (VlConfig.vegaRamp(name))
        }
        return (VlConfig.ramp(more))
    }

    ; Vega's continuous colour schemes (vega-scale's palettes, see
    ; VEGA_LICENSE) that the cases above do not spell out, by name in any
    ; case — `turbo`, `inferno`, `spectral`, `redYellowGreen`… — as their
    ; stops. A scheme the reference has must not fall back to the default
    ; palette here: a chart asking for `turbo` came out in tableau10.
    sfn vegaRamp:string (name:string) {

    ; …and its categorical ones the cases above do not spell out.
    sfn vegaDiscrete:string (name:string) {
        def n:string (to_lowercase name)
        if (n == "category20") {
            return "1f77b4aec7e8ff7f0effbb782ca02c98df8ad62728ff98969467bdc5b0d58c564bc49c94e377c2f7b6d27f7f7fc7c7c7bcbd22dbdb8d17becf9edae5"
        }
        if (n == "category20c") {
            return "3182bd6baed69ecae1c6dbefe6550dfd8d3cfdae6bfdd0a231a35474c476a1d99bc7e9c0756bb19e9ac8bcbddcdadaeb636363969696bdbdbdd9d9d9"
        }
        if (n == "tableau20") {
            return "4c78a89ecae9f58518ffbf7954a24b88d27ab79a20f2cf5b43989483bcb6e45756ff9d9879706ebab0acd67195fcbfd2b279a2d6a5c99e765fd8b5a5"
        }
        if (n == "observable10") {
            return "4269d0efb118ff725c6cc5b03ca951ff8ab7a463f297bbf59c6b4e9498a0"
        }
        return ""
    }

    ; A mark's `style` is a name or a list of them, applied in order.
    sfn styleNames:[string] (v:VlJson) {
        def out:[string]
        if (v.isString()) {
            push out v.str
            return out
        }
        if (v.isArray()) {
            def total:int (v.count())
            def k:int 0
            while (k < total) {
                push out (v.at(k).asString())
                k = (k + 1)
            }
        }
        return out
    }
}

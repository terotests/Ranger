; ==============================================================================
; VlShape.rgr — the geometry a mark is, independent of what draws it.
; ==============================================================================
; A backend decides how to write a shape down; it does not get to decide what
; shape it is. That distinction was not made here before, and it cost: the EVG
; backend drew every symbol that was not a square as a circle, because the
; circle was the only outline anything had. A diamond legend key stood beside
; diamond-less points and nothing in the suite could tell, since the scene said
; `shape: diamond` and the scene was what was being compared.
;
; So the outlines live here, once, and both backends ask for them. They are the
; reference's own — ported from its symbol table rather than invented — because
; the point of the exercise is that the same specification draws the same
; picture, and a shape that is merely plausible is not the same picture.
;
; The one convention worth stating: a symbol's `size` is an AREA, and every
; builtin is drawn inside the square of that area. `sqrt(size)` is that
; square's side, so a circle's radius is `sqrt(size)/2` — not the
; `sqrt(size/PI)` that would give it the stated area. Two symbols of size 30
; and 120 then read as twice as big rather than four times.
; ==============================================================================

Import "VlMath.rgr"
Import "../../evg/PathBuilder.rgr"

class VlShape {

    ; Whether a shape name is one this knows how to draw. A name it does not
    ; know is worth saying out loud rather than drawing as a circle and hoping:
    ; a chart whose shapes all came out round still looks like a chart.
    sfn known:boolean (shape:string) {
        if (shape == "circle") { return true }
        if (shape == "square") { return true }
        if (shape == "cross") { return true }
        if (shape == "diamond") { return true }
        if (shape == "arrow") { return true }
        if (shape == "wedge") { return true }
        if (shape == "triangle") { return true }
        if (shape == "triangle-up") { return true }
        if (shape == "triangle-down") { return true }
        if (shape == "triangle-right") { return true }
        if (shape == "triangle-left") { return true }
        if (shape == "stroke") { return true }
        return (VlShape.isPathShape(shape))
    }

    ; A shape may be a PATH rather than a name: a specification hands the
    ; symbol scale a list of SVG path strings and gets a pictogram per
    ; category. It is recognised the way the reference recognises it — by the
    ; move-to it has to start with.
    sfn isPathShape:boolean (shape:string) {
        if ((strlen shape) < 2) {
            return false
        }
        def first:string (substring shape 0 1)
        return ((first == "M") || (first == "m"))
    }

    ; A path, scaled about its own origin and moved. The parser has already
    ; turned every relative command into an absolute one, so each command is a
    ; handful of points and nothing else needs to know which is which.
    sfn appendScaledPath:void (builder:PathBuilder data:string scale:double dx:double dy:double) {
        def parser (new SVGPathParser())
        parser.parse(data)
        for (parser.getCommands()) c:PathCommand ci {
            if (c.type == "M") {
                builder.moveTo(((c.x * scale) + dx) ((c.y * scale) + dy))
            }
            if (c.type == "L") {
                builder.lineTo(((c.x * scale) + dx) ((c.y * scale) + dy))
            }
            if (c.type == "C") {
                builder.cubicTo(((c.x1 * scale) + dx) ((c.y1 * scale) + dy) ((c.x2 * scale) + dx) ((c.y2 * scale) + dy) ((c.x * scale) + dx) ((c.y * scale) + dy))
            }
            if (c.type == "Q") {
                builder.quadTo(((c.x1 * scale) + dx) ((c.y1 * scale) + dy) ((c.x * scale) + dx) ((c.y * scale) + dy))
            }
            if (c.type == "Z") {
                builder.close()
            }
        }
    }

    ; A symbol centred on (cx, cy). Everything below is the reference's own
    ; construction, in its own order, so the vertices line up one for one.
    sfn appendSymbol:void (builder:PathBuilder shape:string size:double cx:double cy:double) {
        def area:double size
        if (area < 0.0) {
            area = 0.0
        }
        def r:double ((sqrt area) / 2.0)

        ; A custom path is drawn AS ITSELF, scaled to the symbol's radius and
        ; moved to where the symbol goes. The path is written round the origin
        ; in the same units every built-in shape is, so the radius is the whole
        ; transformation: `size` is an area and a drawing is a length.
        if (VlShape.isPathShape(shape)) {
            VlShape.appendScaledPath(builder shape r cx cy)
            return
        }

        if (shape == "square") {
            def w:double (sqrt area)
            builder.addRect((cx - (w / 2.0)) (cy - (w / 2.0)) w w)
            return
        }
        ; The key a LINE chart gets: a dash rather than a filled shape, so the
        ; legend shows what the chart actually draws.
        if (shape == "stroke") {
            builder.addLine((cx - r) cy (cx + r) cy)
            return
        }
        if (shape == "cross") {
            def s:double (r / 2.5)
            def pts:[double]
            VlShape.push2(pts (cx - r) (cy - s))
            VlShape.push2(pts (cx - r) (cy + s))
            VlShape.push2(pts (cx - s) (cy + s))
            VlShape.push2(pts (cx - s) (cy + r))
            VlShape.push2(pts (cx + s) (cy + r))
            VlShape.push2(pts (cx + s) (cy + s))
            VlShape.push2(pts (cx + r) (cy + s))
            VlShape.push2(pts (cx + r) (cy - s))
            VlShape.push2(pts (cx + s) (cy - s))
            VlShape.push2(pts (cx + s) (cy - r))
            VlShape.push2(pts (cx - s) (cy - r))
            VlShape.push2(pts (cx - s) (cy - s))
            builder.addPolygon(pts)
            return
        }
        if (shape == "diamond") {
            def pts:[double]
            VlShape.push2(pts (cx - r) cy)
            VlShape.push2(pts cx (cy - r))
            VlShape.push2(pts (cx + r) cy)
            VlShape.push2(pts cx (cy + r))
            builder.addPolygon(pts)
            return
        }
        if (shape == "arrow") {
            def s:double (r / 7.0)
            def t:double (r / 2.5)
            def v:double (r / 8.0)
            def pts:[double]
            VlShape.push2(pts (cx - s) (cy + r))
            VlShape.push2(pts (cx + s) (cy + r))
            VlShape.push2(pts (cx + s) (cy - v))
            VlShape.push2(pts (cx + t) (cy - v))
            VlShape.push2(pts cx (cy - r))
            VlShape.push2(pts (cx - t) (cy - v))
            VlShape.push2(pts (cx - s) (cy - v))
            builder.addPolygon(pts)
            return
        }
        ; `wedge` and `triangle` sit on the centroid of the triangle they
        ; describe rather than on the middle of its bounding box, which is the
        ; `o` term: a row of triangles then looks evenly spaced instead of
        ; hanging low.
        def halfSqrt3:double 0.8660254037844386
        def tan30:double 0.5773502691896257
        if (shape == "wedge") {
            def h:double (halfSqrt3 * r)
            def o:double (h - (r * tan30))
            def b:double (r / 4.0)
            def pts:[double]
            VlShape.push2(pts cx (cy - (h + o)))
            VlShape.push2(pts (cx - b) ((cy + h) - o))
            VlShape.push2(pts (cx + b) ((cy + h) - o))
            builder.addPolygon(pts)
            return
        }
        if (shape == "triangle") {
            def h:double (halfSqrt3 * r)
            def o:double (h - (r * tan30))
            def pts:[double]
            VlShape.push2(pts cx (cy - (h + o)))
            VlShape.push2(pts (cx - r) ((cy + h) - o))
            VlShape.push2(pts (cx + r) ((cy + h) - o))
            builder.addPolygon(pts)
            return
        }
        if (shape == "triangle-up") {
            def h:double (halfSqrt3 * r)
            def pts:[double]
            VlShape.push2(pts cx (cy - h))
            VlShape.push2(pts (cx - r) (cy + h))
            VlShape.push2(pts (cx + r) (cy + h))
            builder.addPolygon(pts)
            return
        }
        if (shape == "triangle-down") {
            def h:double (halfSqrt3 * r)
            def pts:[double]
            VlShape.push2(pts cx (cy + h))
            VlShape.push2(pts (cx - r) (cy - h))
            VlShape.push2(pts (cx + r) (cy - h))
            builder.addPolygon(pts)
            return
        }
        if (shape == "triangle-right") {
            def h:double (halfSqrt3 * r)
            def pts:[double]
            VlShape.push2(pts (cx + h) cy)
            VlShape.push2(pts (cx - h) (cy - r))
            VlShape.push2(pts (cx - h) (cy + r))
            builder.addPolygon(pts)
            return
        }
        if (shape == "triangle-left") {
            def h:double (halfSqrt3 * r)
            def pts:[double]
            VlShape.push2(pts (cx - h) cy)
            VlShape.push2(pts (cx + h) (cy - r))
            VlShape.push2(pts (cx + h) (cy + r))
            builder.addPolygon(pts)
            return
        }
        builder.addCircle(cx cy r)
    }

    sfn push2:void (pts:[double] x:double y:double) {
        push pts x
        push pts y
    }

    ; ------------------------------------------------------------------ rect ---
    ; A rectangle, with a radius per corner. Each radius is clamped to half the
    ; SHORTER side, so a radius larger than the box gives a stadium rather than
    ; a shape that crosses itself — and the clamp is against the shorter side
    ; for every corner, not against the side that corner happens to sit on.
    ;
    ; The curve constant is not the usual circle kappa. The reference uses
    ; 0.448084975506, which is the value that minimises the RADIAL error of a
    ; four-segment circle rather than the one that makes the curve pass through
    ; the quarter points. On a 12px corner the two differ by about a fiftieth
    ; of a pixel; it is here because being the same as the reference is cheaper
    ; than arguing about which is better.
    sfn appendRect:void (builder:PathBuilder x:double y:double w:double h:double tl:double tr:double br:double bl:double) {
        def shorter:double w
        if (h < shorter) {
            shorter = h
        }
        def limit:double (shorter / 2.0)
        def rtl:double (VlShape.clamp(tl 0.0 limit))
        def rtr:double (VlShape.clamp(tr 0.0 limit))
        def rbr:double (VlShape.clamp(br 0.0 limit))
        def rbl:double (VlShape.clamp(bl 0.0 limit))

        if ((((rtl <= 0.0) && (rtr <= 0.0)) && (rbr <= 0.0)) && (rbl <= 0.0)) {
            builder.addRect(x y w h)
            return
        }
        def c:double 0.448084975506
        def x2:double (x + w)
        def y2:double (y + h)
        builder.moveTo((x + rtl) y)
        builder.lineTo((x2 - rtr) y)
        builder.cubicTo((x2 - (c * rtr)) y x2 (y + (c * rtr)) x2 (y + rtr))
        builder.lineTo(x2 (y2 - rbr))
        builder.cubicTo(x2 (y2 - (c * rbr)) (x2 - (c * rbr)) y2 (x2 - rbr) y2)
        builder.lineTo((x + rbl) y2)
        builder.cubicTo((x + (c * rbl)) y2 x (y2 - (c * rbl)) x (y2 - rbl))
        builder.lineTo(x (y + rtl))
        builder.cubicTo(x (y + (c * rtl)) (x + (c * rtl)) y (x + rtl) y)
        builder.close()
    }

    sfn clamp:double (v:double low:double high:double) {
        def out:double v
        if (out > high) {
            out = high
        }
        if (out < low) {
            out = low
        }
        return out
    }

    ; ------------------------------------------------------------------- arc ---
    ; A wedge: out along the start angle, round the outer radius, back down the
    ; end angle and round the inner one. The reference's angles are measured
    ; from UP and run clockwise, so x is sin and y is -cos.
    ;
    ; Flattened into short segments rather than emitted as elliptical arcs: a
    ; wedge is a closed shape whose two straight edges have to meet the curve
    ; exactly, and a chain of small lines is exact enough at chart sizes and has
    ; no sweep flag to get wrong.
    sfn appendArc:void (builder:PathBuilder cx:double cy:double startAngle:double endAngle:double innerRadius:double outerRadius:double) {
        def a0:double startAngle
        def a1:double endAngle
        if (a1 < a0) {
            def swap:double a0
            a0 = a1
            a1 = swap
        }
        if (outerRadius <= 0.0) {
            return
        }
        def span:double (a1 - a0)
        def steps:int (to_int ((span / 0.05) + 1.0))
        if (steps < 2) {
            steps = 2
        }
        if (steps > 480) {
            steps = 480
        }

        def k:int 0
        while (k <= steps) {
            def t:double ((to_double k) / (to_double steps))
            def a:double (a0 + (span * t))
            def x:double (cx + ((sin a) * outerRadius))
            def y:double (cy - ((cos a) * outerRadius))
            if (k == 0) {
                builder.moveTo(x y)
            } {
                builder.lineTo(x y)
            }
            k = (k + 1)
        }
        if (innerRadius > 0.0) {
            def j:int steps
            while (j >= 0) {
                def t2:double ((to_double j) / (to_double steps))
                def a2:double (a0 + (span * t2))
                builder.lineTo((cx + ((sin a2) * innerRadius)) (cy - ((cos a2) * innerRadius)))
                j = (j - 1)
            }
        } {
            builder.lineTo(cx cy)
        }
        builder.close()
    }

    ; ----------------------------------------------------------------- curve ---
    ; Which interpolations turn a list of points into something other than the
    ; straight lines between them. A name not on this list is drawn straight,
    ; and the renderer parity harness reports it rather than letting a curve
    ; quietly become a polyline.
    sfn curveKnown:boolean (interpolate:string) {
        if (interpolate == "linear") { return true }
        if (interpolate == "step") { return true }
        if (interpolate == "step-after") { return true }
        if (interpolate == "step-before") { return true }
        if (interpolate == "basis") { return true }
        if (interpolate == "natural") { return true }
        if (interpolate == "monotone") { return true }
        if (interpolate == "cardinal") { return true }
        if (interpolate == "catmull-rom") { return true }
        return false
    }

    ; A stepped line does not slope: it holds its value and then jumps. Which
    ; way round decides what the line CLAIMS — `step-after` says the value held
    ; until the next reading, `step-before` says it had already changed by the
    ; time the reading was taken, and `step` splits the difference and admits it
    ; does not know. A renderer that draws all three as a slope says none of it.
    sfn steppedPoints:[double] (pts:[double] interpolate:string) {
        def n:int (idiv (array_length pts) 2)
        if (n < 2) {
            return pts
        }
        def after:boolean (interpolate == "step-after")
        def before:boolean (interpolate == "step-before")
        def middle:boolean (interpolate == "step")
        if (((! after) && (! before)) && (! middle)) {
            return pts
        }
        def out:[double]
        push out (itemAt pts 0)
        push out (itemAt pts 1)
        def i:int 1
        while (i < n) {
            def px:double (itemAt pts ((i - 1) * 2))
            def py:double (itemAt pts (((i - 1) * 2) + 1))
            def x:double (itemAt pts (i * 2))
            def y:double (itemAt pts ((i * 2) + 1))
            if after {
                push out x
                push out py
            }
            if before {
                push out px
                push out y
            }
            if middle {
                def mid:double ((px + x) / 2.0)
                push out mid
                push out py
                push out mid
                push out y
            }
            push out x
            push out y
            i = (i + 1)
        }
        return out
    }

    sfn subrange:[double] (values:[double] from:int upto:int) {
        def out:[double]
        def k:int from
        while (k < upto) {
            push out (itemAt values k)
            k = (k + 1)
        }
        return out
    }

    ; The same, for a path drawn in more than one stroke. `breaks` names the
    ; vertex each stroke starts at, so a line whose data goes missing in the
    ; middle stays ONE path with a hole in it rather than becoming two paths —
    ; which is what the reference draws, and what a renderer that fills has to
    ; be handed if the pieces are to share one fill.
    sfn appendBrokenCurve:void (builder:PathBuilder pts:[double] breaks:[int] interpolate:string tension:double closed:boolean) {
        def strokes:int (array_length breaks)
        if (strokes < 2) {
            VlShape.appendCurve(builder pts interpolate tension closed)
            return
        }
        def total:int (array_length pts)
        def b:int 0
        while (b < strokes) {
            def from:int ((itemAt breaks b) * 2)
            def upto:int total
            if ((b + 1) < strokes) {
                upto = ((itemAt breaks (b + 1)) * 2)
            }
            b = (b + 1)
            def run:[double] (VlShape.subrange(pts from upto))
            VlShape.appendCurve(builder run interpolate tension closed)
        }
    }

    ; A trail broken the same way: each stroke carries its own widths.
    sfn appendBrokenTrail:void (builder:PathBuilder pts:[double] sizes:[double] breaks:[int]) {
        def strokes:int (array_length breaks)
        if (strokes < 2) {
            VlShape.appendTrail(builder pts sizes)
            return
        }
        def vertices:int (array_length sizes)
        def b:int 0
        while (b < strokes) {
            def from:int (itemAt breaks b)
            def upto:int vertices
            if ((b + 1) < strokes) {
                upto = (itemAt breaks (b + 1))
            }
            b = (b + 1)
            def run:[double] (VlShape.subrange(pts (from * 2) (upto * 2)))
            def wide:[double] (VlShape.subrange(sizes from upto))
            VlShape.appendTrail(builder run wide)
        }
    }

    ; A run of points as the curve the specification asked for. Steps become
    ; more points and stay straight; the smooth interpolations become cubics,
    ; which is what the reference emits too — a curve flattened into segments
    ; would draw the same picture but not the same path, and the path is what
    ; a PDF and an SVG both carry.
    sfn appendCurve:void (builder:PathBuilder pts:[double] interpolate:string tension:double closed:boolean) {
        def stepped:[double] (VlShape.steppedPoints(pts interpolate))
        def n:int (idiv (array_length stepped) 2)
        if (n == 0) {
            return
        }
        ; One point on its own is still drawn: the reference writes `M x,y Z`,
        ; which a round cap paints as a dot. It is what a line looks like where
        ; the data has one reading with nothing either side of it, and dropping
        ; it silently loses the reading.
        if (n == 1) {
            builder.moveTo((itemAt stepped 0) (itemAt stepped 1))
            builder.close()
            return
        }
        def smooth:boolean false
        if (interpolate == "basis") { smooth = true }
        if (interpolate == "natural") { smooth = true }
        if (interpolate == "monotone") { smooth = true }
        if (interpolate == "cardinal") { smooth = true }
        if (interpolate == "catmull-rom") { smooth = true }

        if ((! smooth) || (n < 3)) {
            if closed {
                builder.addPolygon(stepped)
            } {
                builder.addPolyline(stepped)
            }
            return
        }

        if (interpolate == "basis") {
            VlShape.appendBasis(builder stepped n)
        }
        if (interpolate == "natural") {
            VlShape.appendNatural(builder stepped n)
        }
        if (interpolate == "monotone") {
            VlShape.appendMonotone(builder stepped n)
        }
        if (interpolate == "cardinal") {
            VlShape.appendCardinal(builder stepped n tension)
        }
        if (interpolate == "catmull-rom") {
            VlShape.appendCatmullRom(builder stepped n tension)
        }
        if closed {
            builder.close()
        }
    }

    sfn px:double (pts:[double] i:int) {
        return (itemAt pts (i * 2))
    }

    sfn py:double (pts:[double] i:int) {
        return (itemAt pts ((i * 2) + 1))
    }

    ; A uniform cubic B-spline: the curve does not pass through its points, it
    ; is pulled towards them. The first and last segments are the half-open
    ; ends the reference draws, which is why they are written out rather than
    ; folded into the loop.
    sfn appendBasis:void (builder:PathBuilder pts:[double] n:int) {
        def x0:double (VlShape.px(pts 0))
        def y0:double (VlShape.py(pts 0))
        def x1:double (VlShape.px(pts 1))
        def y1:double (VlShape.py(pts 1))
        builder.moveTo(x0 y0)
        builder.lineTo((((5.0 * x0) + x1) / 6.0) (((5.0 * y0) + y1) / 6.0))
        def i:int 1
        while (i < (n - 1)) {
            VlShape.basisSegment(builder pts (i - 1) i (i + 1))
            i = (i + 1)
        }
        ; The closing segment repeats the last point as its own successor, which
        ; is what brings the spline back onto the point it ends at instead of
        ; leaving it short — a B-spline does not pass through its knots, so
        ; without this the line stops a sixth of a step early.
        VlShape.basisSegment(builder pts (n - 2) (n - 1) (n - 1))
        builder.lineTo((VlShape.px(pts (n - 1))) (VlShape.py(pts (n - 1))))
    }

    sfn basisSegment:void (builder:PathBuilder pts:[double] a:int b:int c:int) {
        def xa:double (VlShape.px(pts a))
        def ya:double (VlShape.py(pts a))
        def xb:double (VlShape.px(pts b))
        def yb:double (VlShape.py(pts b))
        def xc:double (VlShape.px(pts c))
        def yc:double (VlShape.py(pts c))
        def c1x:double (((2.0 * xa) + xb) / 3.0)
        def c1y:double (((2.0 * ya) + yb) / 3.0)
        def c2x:double ((xa + (2.0 * xb)) / 3.0)
        def c2y:double ((ya + (2.0 * yb)) / 3.0)
        def ex:double (((xa + (4.0 * xb)) + xc) / 6.0)
        def ey:double (((ya + (4.0 * yb)) + yc) / 6.0)
        builder.cubicTo(c1x c1y c2x c2y ex ey)
    }

    ; A natural cubic spline: passes through every point, and the curvature is
    ; zero at both ends. It is the only interpolation here that cannot draw its
    ; first segment until it has seen the last point — the control points come
    ; out of one tridiagonal system per axis.
    sfn appendNatural:void (builder:PathBuilder pts:[double] n:int) {
        def xs:[double]
        def ys:[double]
        def k:int 0
        while (k < n) {
            push xs (VlShape.px(pts k))
            push ys (VlShape.py(pts k))
            k = (k + 1)
        }
        def cx:[double] (VlShape.naturalControls(xs n))
        def cy:[double] (VlShape.naturalControls(ys n))
        def m:int (n - 1)
        builder.moveTo((itemAt xs 0) (itemAt ys 0))
        def i:int 0
        while (i < m) {
            builder.cubicTo((itemAt cx i) (itemAt cy i) (itemAt cx (m + i)) (itemAt cy (m + i)) (itemAt xs (i + 1)) (itemAt ys (i + 1)))
            i = (i + 1)
        }
    }

    ; The control points along one axis: a forward sweep that clears the
    ; sub-diagonal, then a back substitution. The answer holds the m first
    ; control points followed by the m second ones.
    sfn naturalControls:[double] (x:[double] n:int) {
        def m:int (n - 1)
        def a:[double]
        def b:[double]
        def r:[double]
        def i:int 0
        while (i < m) {
            push a 1.0
            push b 4.0
            push r 0.0
            i = (i + 1)
        }
        set a 0 0.0
        set b 0 2.0
        set r 0 ((itemAt x 0) + (2.0 * (itemAt x 1)))
        i = 1
        while (i < (m - 1)) {
            set r i ((4.0 * (itemAt x i)) + (2.0 * (itemAt x (i + 1))))
            i = (i + 1)
        }
        if (m > 1) {
            set a (m - 1) 2.0
            set b (m - 1) 7.0
            set r (m - 1) ((8.0 * (itemAt x (m - 1))) + (itemAt x m))
        }
        i = 1
        while (i < m) {
            def factor:double ((itemAt a i) / (itemAt b (i - 1)))
            set b i ((itemAt b i) - factor)
            set r i ((itemAt r i) - (factor * (itemAt r (i - 1))))
            i = (i + 1)
        }
        set a (m - 1) ((itemAt r (m - 1)) / (itemAt b (m - 1)))
        i = (m - 2)
        while (i >= 0) {
            set a i (((itemAt r i) - (itemAt a (i + 1))) / (itemAt b i))
            i = (i - 1)
        }
        set b (m - 1) (((itemAt x m) + (itemAt a (m - 1))) / 2.0)
        i = 0
        while (i < (m - 1)) {
            set b i ((2.0 * (itemAt x (i + 1))) - (itemAt a (i + 1)))
            i = (i + 1)
        }
        def out:[double]
        i = 0
        while (i < m) {
            push out (itemAt a i)
            i = (i + 1)
        }
        i = 0
        while (i < m) {
            push out (itemAt b i)
            i = (i + 1)
        }
        return out
    }

    ; A monotone cubic: it passes through every point and never overshoots
    ; between two of them, so a line that only rises is never drawn dipping.
    ; That is a claim about the data and not a matter of taste, which is why the
    ; slope rule is ported exactly rather than approximated.
    sfn appendMonotone:void (builder:PathBuilder pts:[double] n:int) {
        def slopes:[double] (VlShape.monotoneSlopes(pts n))
        builder.moveTo((VlShape.px(pts 0)) (VlShape.py(pts 0)))
        def i:int 0
        while (i < (n - 1)) {
            def x0:double (VlShape.px(pts i))
            def y0:double (VlShape.py(pts i))
            def x1:double (VlShape.px(pts (i + 1)))
            def y1:double (VlShape.py(pts (i + 1)))
            def dx:double ((x1 - x0) / 3.0)
            builder.cubicTo((x0 + dx) (y0 + (dx * (itemAt slopes i))) (x1 - dx) (y1 - (dx * (itemAt slopes (i + 1)))) x1 y1)
            i = (i + 1)
        }
    }

    ; The tangent at each point. Inside the run it is the harmonic-mean rule —
    ; capped by the neighbouring secants, and flat wherever they disagree in
    ; sign, which is what pins a peak in place. The ends use the one-sided rule.
    sfn monotoneSlopes:[double] (pts:[double] n:int) {
        def secants:[double]
        def i:int 0
        while (i < (n - 1)) {
            def dx:double ((VlShape.px(pts (i + 1))) - (VlShape.px(pts i)))
            def dy:double ((VlShape.py(pts (i + 1))) - (VlShape.py(pts i)))
            if (dx == 0.0) {
                push secants 0.0
            } {
                push secants (dy / dx)
            }
            i = (i + 1)
        }
        def out:[double]
        i = 0
        while (i < n) {
            push out 0.0
            i = (i + 1)
        }
        i = 1
        while (i < (n - 1)) {
            def s0:double (itemAt secants (i - 1))
            def s1:double (itemAt secants i)
            def h0:double ((VlShape.px(pts i)) - (VlShape.px(pts (i - 1))))
            def h1:double ((VlShape.px(pts (i + 1))) - (VlShape.px(pts i)))
            def value:double 0.0
            if (((VlShape.sign(s0)) * (VlShape.sign(s1))) > 0.0) {
                def p:double 0.0
                if ((h0 + h1) != 0.0) {
                    p = (((s0 * h1) + (s1 * h0)) / (h0 + h1))
                }
                def limit:double (VlShape.absOf(s0))
                if ((VlShape.absOf(s1)) < limit) {
                    limit = (VlShape.absOf(s1))
                }
                if ((0.5 * (VlShape.absOf(p))) < limit) {
                    limit = (0.5 * (VlShape.absOf(p)))
                }
                value = (((VlShape.sign(s0)) + (VlShape.sign(s1))) * limit)
            }
            set out i value
            i = (i + 1)
        }
        ; The ends: the slope that makes the end segment's own cubic match the
        ; secant it spans, given the tangent already fixed at the other end.
        set out 0 (VlShape.endSlope(pts 0 1 (itemAt out 1)))
        set out (n - 1) (VlShape.endSlope(pts (n - 1) (n - 2) (itemAt out (n - 2))))
        return out
    }

    sfn endSlope:double (pts:[double] at:int toward:int other:double) {
        def h:double ((VlShape.px(pts toward)) - (VlShape.px(pts at)))
        if (h == 0.0) {
            return other
        }
        def dy:double ((VlShape.py(pts toward)) - (VlShape.py(pts at)))
        return ((((3.0 * dy) / h) - other) / 2.0)
    }

    sfn sign:double (v:double) {
        if (v > 0.0) { return 1.0 }
        if (v < 0.0) { return (0.0 - 1.0) }
        return 0.0
    }

    sfn absOf:double (v:double) {
        if (v < 0.0) {
            return (0.0 - v)
        }
        return v
    }

    ; A cardinal spline: passes through every point, and the tangent at each is
    ; the direction from the point before it to the point after. `tension` at 0
    ; is the reference's default; 1 flattens it back to straight lines.
    sfn appendCardinal:void (builder:PathBuilder pts:[double] n:int tension:double) {
        def k:double ((1.0 - tension) / 6.0)
        builder.moveTo((VlShape.px(pts 0)) (VlShape.py(pts 0)))
        def i:int 0
        while (i < (n - 1)) {
            ; At the ends the missing neighbour is the point on the OTHER side,
            ; not the end point repeated. That makes the tangent there exactly
            ; zero — the curve leaves the first point and arrives at the last
            ; one flat. Repeating the end point instead leaves a tangent of
            ; k times the first step, and the line starts off at the wrong
            ; angle by about half a pixel.
            def i0:int (i - 1)
            if (i0 < 0) { i0 = (i + 1) }
            def i3:int (i + 2)
            if (i3 > (n - 1)) { i3 = i }
            def x0:double (VlShape.px(pts i0))
            def y0:double (VlShape.py(pts i0))
            def x1:double (VlShape.px(pts i))
            def y1:double (VlShape.py(pts i))
            def x2:double (VlShape.px(pts (i + 1)))
            def y2:double (VlShape.py(pts (i + 1)))
            def x3:double (VlShape.px(pts i3))
            def y3:double (VlShape.py(pts i3))
            builder.cubicTo((x1 + (k * (x2 - x0))) (y1 + (k * (y2 - y0))) (x2 + (k * (x1 - x3))) (y2 + (k * (y1 - y3))) x2 y2)
            i = (i + 1)
        }
    }

    ; Catmull-Rom, parameterised by `alpha`. The reference's default 0.5 is the
    ; centripetal form — the one that does not tie itself in a loop when two
    ; points sit close together.
    sfn appendCatmullRom:void (builder:PathBuilder pts:[double] n:int alpha:double) {
        if (alpha <= 0.0) {
            VlShape.appendCardinal(builder pts n 0.0)
            return
        }
        builder.moveTo((VlShape.px(pts 0)) (VlShape.py(pts 0)))
        def i:int 0
        while (i < (n - 1)) {
            def i0:int (i - 1)
            if (i0 < 0) { i0 = 0 }
            def i3:int (i + 2)
            if (i3 > (n - 1)) { i3 = (n - 1) }
            def x0:double (VlShape.px(pts i0))
            def y0:double (VlShape.py(pts i0))
            def x1:double (VlShape.px(pts i))
            def y1:double (VlShape.py(pts i))
            def x2:double (VlShape.px(pts (i + 1)))
            def y2:double (VlShape.py(pts (i + 1)))
            def x3:double (VlShape.px(pts i3))
            def y3:double (VlShape.py(pts i3))

            def l01:double (VlShape.knot(x0 y0 x1 y1 alpha))
            def l12:double (VlShape.knot(x1 y1 x2 y2 alpha))
            def l23:double (VlShape.knot(x2 y2 x3 y3 alpha))
            def q01:double (l01 * l01)
            def q12:double (l12 * l12)
            def q23:double (l23 * l23)

            def ax:double x1
            def ay:double y1
            def bx:double x2
            def by:double y2
            if (l01 > 0.000001) {
                def a:double (((2.0 * q01) + ((3.0 * l01) * l12)) + q12)
                def nn:double ((3.0 * l01) * (l01 + l12))
                ax = ((((x1 * a) - (x0 * q12)) + (x2 * q01)) / nn)
                ay = ((((y1 * a) - (y0 * q12)) + (y2 * q01)) / nn)
            }
            if (l23 > 0.000001) {
                def b:double (((2.0 * q23) + ((3.0 * l23) * l12)) + q12)
                def mm:double ((3.0 * l23) * (l23 + l12))
                bx = ((((x2 * b) + (x1 * q23)) - (x3 * q12)) / mm)
                by = ((((y2 * b) + (y1 * q23)) - (y3 * q12)) / mm)
            }
            builder.cubicTo(ax ay bx by x2 y2)
            i = (i + 1)
        }
    }

    ; ---------------------------------------------------------------- trail ---
    ; A line whose width varies along it. Each pair of consecutive points is a
    ; CAPSULE of its own — two parallel edges and a round cap at each end,
    ; closed — so that a trail whose size changes tapers rather than stepping.
    ; Overlapping capsules is the point: the joins are filled by the caps.
    ;
    ; This is the reference's own construction, which matters because a trail
    ; built any other way looks nearly right and is wrong at every join.
    sfn appendTrail:void (builder:PathBuilder points:[double] sizes:[double]) {
        def count:int (array_length sizes)
        if (count == 0) {
            return
        }
        def ready:boolean false
        def x1:double 0.0
        def y1:double 0.0
        def r1:double 0.0
        def k:int 0
        while (k < count) {
            def x2:double (itemAt points (k * 2))
            def y2:double (itemAt points ((k * 2) + 1))
            def r2:double ((itemAt sizes k) / 2.0)
            if ready {
                ; The normal to the segment, which is where the two parallel
                ; edges sit.
                def ux:double (y1 - y2)
                def uy:double (x2 - x1)
                def ud:double (sqrt ((ux * ux) + (uy * uy)))
                if (ud > 0.0) {
                    ux = (ux / ud)
                    uy = (uy / ud)
                    def rx:double (ux * r1)
                    def ry:double (uy * r1)
                    def t:double (atan2 uy ux)
                    def pi:double (VlShape.piOf())
                    builder.moveTo((x1 - rx) (y1 - ry))
                    builder.lineTo((x2 - (ux * r2)) (y2 - (uy * r2)))
                    VlShape.arcSegments(builder x2 y2 r2 (t - pi) t)
                    builder.lineTo((x1 + rx) (y1 + ry))
                    VlShape.arcSegments(builder x1 y1 r1 t (t + pi))
                    builder.close()
                } {
                    ; Two points in the same place: a dot, not a segment.
                    VlShape.appendDot(builder x2 y2 r2)
                }
            } {
                ready = true
            }
            x1 = x2
            y1 = y2
            r1 = r2
            k = (k + 1)
        }
    }

    sfn piOf:double () {
        return 3.14159265358979323846
    }

    ; A circular arc appended to the subpath already being built, in the
    ; screen's own convention: angle zero points along +x and grows towards +y.
    ; Flattened finely enough that the chord never sits more than a twentieth of
    ; a pixel inside the true arc.
    sfn arcSegments:void (builder:PathBuilder cx:double cy:double r:double a0:double a1:double) {
        if (r <= 0.0) {
            return
        }
        def span:double (a1 - a0)
        def steps:int (to_int ((((VlShape.absOf(span)) * r) / 0.4) + 1.0))
        if (steps < 6) {
            steps = 6
        }
        if (steps > 240) {
            steps = 240
        }
        def k:int 1
        while (k <= steps) {
            def t:double ((to_double k) / (to_double steps))
            def a:double (a0 + (span * t))
            builder.lineTo((cx + ((cos a) * r)) (cy + ((sin a) * r)))
            k = (k + 1)
        }
    }

    sfn appendDot:void (builder:PathBuilder cx:double cy:double r:double) {
        if (r <= 0.0) {
            return
        }
        builder.moveTo((cx + r) cy)
        def full:double (2.0 * (VlShape.piOf()))
        VlShape.arcSegments(builder cx cy r 0.0 full)
        builder.close()
    }

    sfn knot:double (x0:double y0:double x1:double y1:double alpha:double) {
        def dx:double (x1 - x0)
        def dy:double (y1 - y0)
        def d2:double ((dx * dx) + (dy * dy))
        if (d2 <= 0.0) {
            return 0.0
        }
        return (VlMath.pow(d2 (alpha / 2.0)))
    }
}

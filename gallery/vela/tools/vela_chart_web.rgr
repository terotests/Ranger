        if (name == "strokeWidth") {
            def value:double (this.number(args 0 "strokeWidth"))
            current.strokeWidth(value)
            return
        }
        if (name == "filled") {
            def value:boolean (this.flag(args 0 "filled"))
            current.filled(value)
            return
        }
        if (name == "withPoints") {
            def value:boolean (this.flag(args 0 "withPoints"))
            current.withPoints(value)
            return
        }
        if (name == "tooltip") {
            def value:boolean (this.flag(args 0 "tooltip"))
            current.tooltip(value)
            return
        }
        if (name == "bin") {
            current.bin()
            return
        }
        if (name == "noStack") {
            current.noStack()
            return
        }
        if (name == "keepOrder") {
            current.keepOrder()
            return
        }
        if (name == "noLegend") {
            current.noLegend()
            return
        }
        if (name == "noAxis") {
            current.noAxis()
            return
        }
        if (name == "count") {
            def channel:string (this.text(args 0 "count"))
            current.count(channel)
            return
        }
        if (name == "maxBins") {
            def many:double (this.number(args 0 "maxBins"))
            def manyInt:int (to_int many)
            current.maxBins(manyInt)
            return
        }
        if (name == "valueNumber") {
            def channel2:string (this.text(args 0 "valueNumber"))
            def value2:double (this.number(args 1 "valueNumber"))
            current.valueNumber(channel2 value2)
            return
        }
        if (name == "valueString") {
            def channel3:string (this.text(args 0 "valueString"))
            def value3:string (this.text(args 1 "valueString"))
            current.valueString(channel3 value3)
            return
        }
        if (name == "axisOrient") {
            def side:string (this.text(args 0 "axisOrient"))
            current.axisOrient(side)
            return
        }
        if (name == "chart") {
            onChart = true
            return
        }
        this.fail((("a mark has no method '" + name) + "'"))
    }
}

; ------------------------------------------------------------------------------
; What the page calls: lines of API code and rows of data in, a drawn chart out.
; There is no file system here and no command line, which is what makes the
; compiled bundle loadable by a browser.
; ------------------------------------------------------------------------------
class VelaChartApi {

    ; A chart over the rows the page holds, ready to be called. JavaScript on
    ; the page calls the SAME compiled methods this file's interpreter calls —
    ; `chart.bar().x("region")` is `VlChart.bar()` and `VlChartMark.x(…)`
    ; either way — so the page hands one of these to whichever language the
    ; reader chose and asks `draw` for the picture afterwards.
    sfn newChart:VlChart (dataText:string) {
        def data (VlDataset.create())
        def chart:VlChart (VlChart.create(data))
        def parser (new VlJsonParser())
        def rows:VlJson (parser.parse(dataText))
        if (! parser.ok) {
            chart.error(("the data is not valid JSON: " + parser.err))
            return chart
        }
        def values:VlJson rows
        if (rows.isObject()) {
            ; `{"values": […]}` is what a specification's data block looks like,
            ; and somebody pasting one in should get a chart rather than a
            ; complaint about the shape of their own data.
            values = (rows.get("values"))
        }
        if (! (values.isArray())) {
            chart.error("the data has to be an array of rows")
            return chart
        }
        data.fromValues(values)
        return chart
    }

    sfn render:string (script:string dataText:string) {
        def out:VlJson (VlJson.objectValue())
        def errors:VlJson (VlJson.arrayValue())

        def chart:VlChart (VelaChartApi.newChart(dataText))
        for chart.errors de:string dei {
            push errors.arr (VlJson.stringValue(de))
        }
        if ((array_length chart.errors) > 0) {
            return (VelaChartApi.failure(out errors))
        }

        def runner:VlChartScript (VlChartScript.create2(chart))
        runner.run(script)
        for runner.errors e:string ei {
            push errors.arr (VlJson.stringValue(e))
        }
        if ((array_length runner.errors) > 0) {
            return (VelaChartApi.failure(out errors))
        }
        return (VelaChartApi.draw(chart runner.calls))
    }

    ; The other half, for a caller that did its own calling: a chart in, a
    ; drawn chart out.
    sfn draw:string (chart:VlChart calls:int) {
        def out:VlJson (VlJson.objectValue())
        def errors:VlJson (VlJson.arrayValue())
        def spec:VlJson (chart.toSpec())
        for chart.errors ce:string cei {
            push errors.arr (VlJson.stringValue(ce))
        }
        if ((array_length chart.errors) > 0) {
            return (VelaChartApi.failure(out errors))
        }
        def writer (new VlJsonWriter())
        def specText:string (writer.writePretty(spec))

        def compiler (new VlCompile())
        def vega:VlJson (compiler.compileSpec(spec))
        for compiler.errors pe:string pei {
            push errors.arr (VlJson.stringValue(pe))
        }
        if ((array_length compiler.errors) > 0) {
            return (VelaChartApi.failure(out errors))
        }
        def vegaText:string (writer.writePretty(vega))

        def rt (new VlRuntime())
        def scene:VlSceneMark (rt.run(vega))
        for rt.errors re:string rei {
            push errors.arr (VlJson.stringValue(re))
        }
        if ((array_length rt.errors) > 0) {
            return (VelaChartApi.failure(out errors))
        }

        def list:VlCommandList (VlSceneCommands.build(scene))
        def root:VlSceneItem (itemAt scene.items 0)
        def svgWriter (new VlSvgWriter())
        def doc:string (svgWriter.writeDocument(list (root.number("viewWidth")) (root.number("viewHeight")) (root.number("originX")) (root.number("originY")) rt.background))

        def warnings (VlJson.arrayValue())
        for rt.warnings rw:string rwi {
            push warnings.arr (VlJson.stringValue(rw))
        }
        for svgWriter.unsupported un:string uni {
            push warnings.arr (VlJson.stringValue(("not drawn as asked: " + un)))
        }

        out.setMember("ok" (VlJson.boolValue(true)))
        out.setMember("svg" (VlJson.stringValue(doc)))
        out.setMember("spec" (VlJson.stringValue(specText)))
        out.setMember("vega" (VlJson.stringValue(vegaText)))
        out.setMember("calls" (VlJson.intValue(calls)))
        def rowCount:int (chart.data.count())
        out.setMember("rows" (VlJson.intValue(rowCount)))
        out.setMember("commands" (VlJson.intValue((list.count()))))
        out.setMember("warnings" warnings)
        return (writer.write(out))
    }

    ; What the data says its columns are — the inference the API does, answered
    ; to the page so a reader can see WHY a channel came out temporal.
    sfn columns:string (dataText:string) {
        def out:VlJson (VlJson.objectValue())
        def parser (new VlJsonParser())
        def rows:VlJson (parser.parse(dataText))
        def values:VlJson rows
        if (rows.isObject()) {
            values = (rows.get("values"))
        }
        if (! (values.isArray())) {
            def w2 (new VlJsonWriter())
            return (w2.write(out))
        }
        def data (VlDataset.create())
        data.fromValues(values)
        def seen:[string]
        def i:int 0
        def n:int (values.count())
        while (i < n) {
            def row:VlJson (values.at(i))
            for row.keys k:string ki {
                def known:boolean false
                for seen s:string si {
                    if (s == k) {
                        known = true
                    }
                }
                if (! known) {
                    push seen k
                    out.setMember(k (VlJson.stringValue((data.fieldType(k)))))
                }
            }
            i = (i + 1)
        }
        def w (new VlJsonWriter())
        return (w.write(out))
    }

    sfn failure:string (out:VlJson errors:VlJson) {
        out.setMember("ok" (VlJson.boolValue(false)))
        out.setMember("errors" errors)
        def w (new VlJsonWriter())
        return (w.write(out))
    }

    ; The page calls the class directly; a `main` that ran something would run
    ; it on every page load.
    sfn main:void () {
    }
}

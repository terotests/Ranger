; ==============================================================================
; vela_commands.rgr — run a Vega specification and print the draw commands.
; ==============================================================================
;   vela_commands <spec.vg.json> [out.txt]
;
; The command list is what a renderer backend will consume. Printing it is how
; the drawing side is tested while there is no backend: the text is stable, so a
; golden file catches a change in what would be drawn.
; ==============================================================================

Import "../src/VlRuntime.rgr"
Import "../src/VlCommand.rgr"

class VelaCommandTool {

    sfn dirOf:string (path:string) {
        def lastSep:int (lastIndexOf path "/")
        if (lastSep >= 0) {
            return (substring path 0 (lastSep + 1))
        }
        return "./"
    }

    sfn nameOf:string (path:string) {
        def lastSep:int (lastIndexOf path "/")
        if (lastSep >= 0) {
            return (substring path (lastSep + 1) (strlen path))
        }
        return path
    }

    ; `--zone=Europe/Helsinki` answers "Europe/Helsinki"; anything else answers
    ; the empty string, which is also what an empty value answers — a flag with
    ; nothing after it is the same as not passing it.
    sfn flagValue:string (arg:string prefix:string) {
        def n:int (strlen prefix)
        if ((strlen arg) <= n) {
            return ""
        }
        if ((substring arg 0 n) != prefix) {
            return ""
        }
        return (substring arg n (strlen arg))
    }

    sfn main:void () {
        def argCount:int (shell_arg_cnt)
        if (argCount < 1) {
            print "usage: vela_commands <spec.vg.json> [out.txt]"
            return
        }
        ; --zone=<name> reads a `time` scale in that wall clock instead of
        ; UTC. It is an argument rather than something read from the machine on
        ; purpose: the same spec has to draw the same chart on every target.
        def inputPath:string ""
        def outputPath:string ""
        def zoneName:string ""
        def positional:int 0
        def ai:int 0
        while (ai < argCount) {
            def arg:string (shell_arg ai)
            if ((VelaCommandTool.flagValue(arg "--zone=")) != "") {
                zoneName = (VelaCommandTool.flagValue(arg "--zone="))
            } {
                if (positional == 0) {
                    inputPath = arg
                } {
                    if (positional == 1) {
                        outputPath = arg
                    }
                }
                positional = (positional + 1)
            }
            ai = (ai + 1)
        }
        if ((strlen inputPath) == 0) {
            print "usage: vela_commands <spec.vg.json> [out.txt] [--zone=Europe/Helsinki]"
            return
        }

        def inDir:string (VelaCommandTool.dirOf(inputPath))
        def inName:string (VelaCommandTool.nameOf(inputPath))
        def text@(optional):string (read_file inDir inName)
        if (null? text) {
            print ("could not read " + inputPath)
            return
        }

        def parser (new VlJsonParser())
        def specJson:VlJson (parser.parse((unwrap text)))
        if (! parser.ok) {
            print ("spec is not valid JSON: " + parser.err)
            return
        }

        def rt (new VlRuntime())
        rt.timeZoneName = zoneName
        def scene:VlSceneMark (rt.run(specJson))
        for rt.errors e:string ei {
            print ("error: " + e)
        }
        if ((array_length rt.errors) > 0) {
            return
        }

        def list:VlCommandList (VlSceneCommands.build(scene))
        def out:string (list.asText())
        if ((strlen outputPath) > 0) {
            write_file (VelaCommandTool.dirOf(outputPath)) (VelaCommandTool.nameOf(outputPath)) out
            print ("wrote " + outputPath)
        } {
            print out
        }
    }
}

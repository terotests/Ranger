; ==============================================================================
; vela_scene.rgr — run a Vega specification and print the scene as JSON.
; ==============================================================================
;   vela_scene <spec.vg.json> [out.scene.json]
;
; With no output path the scene goes to stdout, which is what the parity harness
; reads. Errors go to stdout too, prefixed, and set a non-empty error list — a
; spec this runtime cannot run says so instead of printing half a chart.
; ==============================================================================

Import "../src/VlRuntime.rgr"

class VelaSceneTool {

    ; read_file / write_file take a directory and a name rather than one path.
    sfn dirOf:string (path:string) {
        def lastSep:int (lastIndexOf path "/")
        if (lastSep >= 0) {
            return (substring path 0 (lastSep + 1))
        }
        return "./"
    }

    sfn nameOf:string (path:string) {
        def lastSep:int (lastIndexOf path "/")
        if (lastSep >= 0) {
            return (substring path (lastSep + 1) (strlen path))
        }
        return path
    }

    ; `--zone=Europe/Helsinki` answers "Europe/Helsinki"; anything else answers
    ; the empty string, which is also what an empty value answers — a flag with
    ; nothing after it is the same as not passing it.
    sfn flagValue:string (arg:string prefix:string) {
        def n:int (strlen prefix)
        if ((strlen arg) <= n) {
            return ""
        }
        if ((substring arg 0 n) != prefix) {
            return ""
        }
        return (substring arg n (strlen arg))
    }

    sfn main:void () {
        def argCount:int (shell_arg_cnt)
        if (argCount < 1) {
            print "usage: vela_scene <spec.vg.json> [out.scene.json]"
            return
        }
        ; --zone=<name> reads a `time` scale in that wall clock instead of
        ; UTC. It is an argument rather than something read from the machine on
        ; purpose: the same spec has to draw the same chart on every target.
        def inputPath:string ""
        def outputPath:string ""
        def zoneName:string ""
        ; --reflow runs the chart, then changes `width` to the value it already
        ; has and answers the scene the incremental path produces. It must be
        ; the same scene: the golden files are the assertion, and running them
        ; all through it is how the dataflow is checked against every chart
        ; rather than against the one the unit test builds.
        def reflow:boolean false
        def positional:int 0
        def ai:int 0
        while (ai < argCount) {
            def arg:string (shell_arg ai)
            if ((VelaSceneTool.flagValue(arg "--zone=")) != "") {
                zoneName = (VelaSceneTool.flagValue(arg "--zone="))
            } {
              if (arg == "--reflow") {
                reflow = true
              } {
                if (positional == 0) {
                    inputPath = arg
                } {
                    if (positional == 1) {
                        outputPath = arg
                    }
                }
                positional = (positional + 1)
              }
            }
            ai = (ai + 1)
        }
        if ((strlen inputPath) == 0) {
            print "usage: vela_scene <spec.vg.json> [out.scene.json] [--zone=Europe/Helsinki] [--reflow]"
            return
        }

        ; read_file takes a directory and a name, not one path.
        def inDir:string (VelaSceneTool.dirOf(inputPath))
        def inName:string (VelaSceneTool.nameOf(inputPath))
        def text@(optional):string (read_file inDir inName)
        if (null? text) {
            print ("could not read " + inputPath)
            return
        }

        def parser (new VlJsonParser())
        def specJson:VlJson (parser.parse((unwrap text)))
        if (! parser.ok) {
            print ("spec is not valid JSON: " + parser.err)
            return
        }

        def rt (new VlRuntime())
        rt.timeZoneName = zoneName
        def scene:VlSceneMark (rt.run(specJson))
        if reflow {
            scene = (rt.update("width" (VlJson.numberValue((rt.chartWidth)))))
        }

        for rt.warnings w:string wi {
            print ("warning: " + w)
        }
        for rt.errors e:string ei {
            print ("error: " + e)
        }
        if ((array_length rt.errors) > 0) {
            return
        }

        def writer (new VlSceneWriter())
        def out:string (writer.write(scene))
        if ((strlen outputPath) > 0) {
            def outDir:string (VelaSceneTool.dirOf(outputPath))
            def outName:string (VelaSceneTool.nameOf(outputPath))
            write_file outDir outName out
            print (("wrote " + outputPath) + " ")
        } {
            print out
        }
    }
}

; ==============================================================================
; vela_evg.rgr — render Vega specifications into an EVG showcase page.
; ==============================================================================
;   vela_evg <out.tsx> [--title=…] [--compact] <spec.vg.json> [caption] …
;
; `--compact` puts eight charts on a page instead of six by giving each one a
; single line under it rather than a heading above and a caption below. The
; page is a fixed height and the charts have to fit inside it; two text blocks
; per chart is what does not.
;
; Writes one TSX page holding every chart, which the EVG showcase then renders
; to PDF, PNG and HTML like any other page. The charts themselves are geometry
; and colour computed from the specification, so unlike the hand-written pages
; they do carry visual attributes — the theme still styles the page around them.
; ==============================================================================

Import "../src/VlRuntime.rgr"
Import "../src/VlCommand.rgr"
Import "../src/VlEvg.rgr"

class VelaEvgTool {

    ; One writer for the whole page, so the palette slots are numbered once
    ; across every chart on it and the generated stylesheet matches.
    sfn sharedWriter:VlEvgWriter () {
        def w (new VlEvgWriter())
        w.useClasses = true
        return w
    }

    sfn dirOf:string (path:string) {
        def lastSep:int (lastIndexOf path "/")
        if (lastSep >= 0) {
            return (substring path 0 (lastSep + 1))
        }
        return "./"
    }

    sfn nameOf:string (path:string) {
        def lastSep:int (lastIndexOf path "/")
        if (lastSep >= 0) {
            return (substring path (lastSep + 1) (strlen path))
        }
        return path
    }

    sfn main:void () {
        def argCount:int (shell_arg_cnt)
        if (argCount < 2) {
            print "usage: vela_evg <out.tsx> <spec.vg.json> [caption] …"
            return
        }
        def outputPath:string (shell_arg 0)
        def writer:VlEvgWriter (VelaEvgTool.sharedWriter())

        ; The page's heading, so more than one generated chart page can exist
        ; without them all claiming to be the same one.
        def title:string "Kaaviot"
        def compact:boolean false
        def first:int 1
        def reading:boolean true
        while (reading && (first < argCount)) {
            def flag:string (shell_arg first)
            if (VelaEvgTool.hasPrefix(flag "--title=")) {
                title = (substring flag 8 (strlen flag))
                first = (first + 1)
            } {
                if (flag == "--compact") {
                    compact = true
                    first = (first + 1)
                } {
                    reading = false
                }
            }
        }

        def nl:string (strfromcode 10)
        def page:string ""
        page = ((page + "// GENERATED by gallery/vela/tools/vela_evg.rgr — do not edit by hand.") + nl)
        page = ((page + "//") + nl)
        page = ((page + "// Each chart below is an unmodified Vega specification, compiled from a") + nl)
        page = ((page + "// Vega-Lite example, run through the Vela runtime and drawn with the EVG") + nl)
        page = ((page + "// vector layer: every gridline, bar, wedge and label is path data and text") + nl)
        page = ((page + "// this repository computed, in all three targets.") + nl)
        page = ((page + "//") + nl)
        page = ((page + "// Regenerate with:  npm run vela:showcase") + nl)
        page = (page + nl)
        page = ((page + "import { View, Label, Path } from \"./evg_types\";") + nl)
        page = (page + nl)
        page = ((page + "function render() {") + nl)
        page = ((page + "  return (") + nl)
        page = ((page + "    <View className=\"page\">") + nl)
        page = ((((page + "      <Label className=\"title\">") + title) + "</Label>") + nl)
        page = ((page + "      <View className=\"rule\" />") + nl)

        ; Two charts to a row: a printed page fits about three rows, and EVG
        ; scales a page down to fit rather than spilling over, so a page that
        ; asks for too much comes out shrunk instead of clipped.
        def index:int first
        def inRow:int 0
        while (index < argCount) {
            def specPath:string (shell_arg index)
            def caption:string ""
            if ((index + 1) < argCount) {
                def maybe:string (shell_arg (index + 1))
                if (! (VelaEvgTool.looksLikePath(maybe))) {
                    caption = maybe
                    index = (index + 1)
                }
            }
            if (inRow == 0) {
                page = ((page + "      <View className=\"row chartRow\">") + nl)
            }
            page = (page + (VelaEvgTool.chartSection(writer specPath caption compact)))
            inRow = (inRow + 1)
            if (inRow == 2) {
                page = ((page + "      </View>") + nl)
                inRow = 0
            }
            index = (index + 1)
        }
        if (inRow > 0) {
            page = ((page + "      </View>") + nl)
        }

        page = ((page + "    </View>") + nl)
        page = ((page + "  );") + nl)
        page = ((page + "}") + nl)
        page = (page + nl)
        page = ((page + "export default render;") + nl)

        write_file (VelaEvgTool.dirOf(outputPath)) (VelaEvgTool.nameOf(outputPath)) page
        print ("wrote " + outputPath)

        ; The colours the specs asked for, as the stylesheet's default layer.
        if (argCount > first) {
            def cssPath:string (VelaEvgTool.cssPathFor(outputPath))
            write_file (VelaEvgTool.dirOf(cssPath)) (VelaEvgTool.nameOf(cssPath)) (writer.defaultCss())
            print ("wrote " + cssPath)
        }
    }

    ; pages/charts.tsx  ->  themes/charts-default.css
    sfn cssPathFor:string (pagePath:string) {
        def dir:string (VelaEvgTool.dirOf(pagePath))
        def name:string (VelaEvgTool.nameOf(pagePath))
        def stem:string name
        def dot:int (lastIndexOf name ".")
        if (dot > 0) {
            stem = (substring name 0 dot)
        }
        def parent:string dir
        def cut:int (lastIndexOf (substring dir 0 ((strlen dir) - 1)) "/")
        if (cut >= 0) {
            parent = (substring dir 0 (cut + 1))
        }
        return (((parent + "themes/") + stem) + "-default.css")
    }

    sfn hasPrefix:boolean (text:string prefix:string) {
        def n:int (strlen prefix)
        if ((strlen text) < n) {
            return false
        }
        return ((substring text 0 n) == prefix)
    }

    sfn looksLikePath:boolean (text:string) {
        def n:int (strlen text)
        if (n < 5) {
            return false
        }
        return ((substring text (n - 5) n) == ".json")
    }

    sfn chartSection:string (writer:VlEvgWriter specPath:string caption:string compact:boolean) {
        def nl:string (strfromcode 10)
        def text@(optional):string (read_file (VelaEvgTool.dirOf(specPath)) (VelaEvgTool.nameOf(specPath)))
        if (null? text) {
            print ("could not read " + specPath)
            return ""
        }
        def parser (new VlJsonParser())
        def specJson:VlJson (parser.parse((unwrap text)))
        if (! parser.ok) {
            print ((("spec " + specPath) + " is not valid JSON: ") + parser.err)
            return ""
        }

        def rt (new VlRuntime())
        def scene:VlSceneMark (rt.run(specJson))
        for rt.errors e:string ei {
            print ((("error in " + specPath) + ": ") + e)
        }
        if ((array_length rt.errors) > 0) {
            return ""
        }

        def list:VlCommandList (VlSceneCommands.build(scene))
        def root:VlSceneItem (itemAt scene.items 0)
        def chart:string (writer.writeChart(list (root.number("viewWidth")) (root.number("viewHeight")) (root.number("originX")) (root.number("originY"))))

        def out:string ((("        <View className=\"chartCell\">") + nl))
        if compact {
            ; One line, under the chart: what it is and how much geometry it
            ; took. The specification's own name is not repeated here — the
            ; gallery's blurb says where every chart on the page comes from.
            out = (out + chart)
            out = ((((((out + "          <Label className=\"caption\">") + caption) + " · ") + (VlJson.intToText((list.count())))) + " komentoa</Label>") + nl)
            out = ((out + "        </View>") + nl)
            return out
        }
        if ((strlen caption) > 0) {
            out = ((((out + "          <Label className=\"subhead\">") + caption) + "</Label>") + nl)
        }
        out = (out + chart)
        out = ((((((out + "          <Label className=\"caption\">") + (VlJson.intToText((list.count())))) + " piirtokomentoa · ") + (VelaEvgTool.nameOf(specPath))) + "</Label>") + nl)
        out = ((out + "        </View>") + nl)
        return out
    }
}

      ],
      "from": {
        "data": "data_1"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "point"
          },
          "description": {
            "signal": "\"c: \" + (format(datum[\"c\"], \"\")) + \"; b: \" + (format(datum[\"b\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "c"
          },
          "y": {
            "scale": "y",
            "field": "b"
          }
        }
      }
    }

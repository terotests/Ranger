          "as": "c"
        }
      ]
    },
    {
      "name": "data_1",
      "source": "data_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"c\"]) && isFinite(+datum[\"c\"]) && isValid(datum[\"b\"]) && isFinite(+datum[\"b\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "layer_0_marks",
      "type": "line",
      "style": [
        "line"
      ],
      "sort": {
        "field": "x"
      },
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "#4c78a8"
          },
          "description": {
            "signal": "\"c: \" + (format(datum[\"c\"], \"\")) + \"; b: \" + (format(datum[\"b\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "c"
          },
          "y": {
            "scale": "y",
            "field": "b"
          },
          "defined": {
            "signal": "isValid(datum[\"c\"]) && isFinite(+datum[\"c\"]) && isValid(datum[\"b\"]) && isFinite(+datum[\"b\"])"
          }
        }
      }
    },
    {
      "name": "layer_1_marks",
      "type": "symbol",
      "style": [

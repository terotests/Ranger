    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "extent",
          "field": "people",
          "signal": "bin_maxbins_10_people_extent"
        },
        {
          "type": "bin",
          "field": "people",
          "as": [
            "lo",
            "hi"
          ],
          "signal": "bin_maxbins_10_people_bins",
          "extent": {
            "signal": "bin_maxbins_10_people_extent"
          },
          "maxbins": 10
        },
        {
          "type": "aggregate",
          "groupby": [
            "lo",
            "hi"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "joinaggregate",
          "as": [
            "most"
          ],
          "ops": [
            "max"
          ],
          "fields": [
            "n"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.n / datum.most",
          "as": "share"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "line",
      "style": [
        "line"
      ],
      "sort": {
        "field": "x"
      },
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "#4c78a8"
          },
          "description": {
            "signal": "\"n: \" + (format(datum[\"n\"], \"\")) + \"; share: \" + (format(datum[\"share\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "n"
          },
          "y": {
            "scale": "y",
            "field": "share"
          },
          "defined": {
            "signal": "isValid(datum[\"n\"]) && isFinite(+datum[\"n\"]) && isValid(datum[\"share\"]) && isFinite(+datum[\"share\"])"
          }
        }
      }
    }
  ],
  "scales": [

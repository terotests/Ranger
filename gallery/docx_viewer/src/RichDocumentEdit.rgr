; ==============================================================================
; RichDocumentEdit - TextEditingTarget adapter over RichDocument paragraphs.
; ==============================================================================
; Mutates Paragraph.text + TextSpan[] only. No OOXML. StyleId preserved.
; ==============================================================================

Import "RichDocument.rgr"
Import "../../text_editor/src/TextEditCore.rgr"

class RichDocumentEdit {
    def doc:RichDocument (new RichDocument)
    def lastMergeCaret:DocumentPosition (new DocumentPosition)

    Constructor () {
    }

    fn bind:void (d:RichDocument) {
        doc = d
    }

    fn findParagraph:Paragraph (paragraphId:int) {
        def i:int 0
        while (i < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(i))
            if (p.id == paragraphId) {
                return p
            }
            i = (i + 1)
        }
        return (new Paragraph)
    }

    fn findParagraphIndex:int (paragraphId:int) {
        def i:int 0
        while (i < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(i))
            if (p.id == paragraphId) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn getText:string (paragraphId:int) {
        def p:Paragraph (this.findParagraph(paragraphId))
        return p.text
    }

    fn textLength:int (paragraphId:int) {
        return (strlen (this.getText(paragraphId)))
    }

    fn paragraphExists:boolean (paragraphId:int) {
        return ((this.findParagraphIndex(paragraphId)) >= 0)
    }

    ; Span covering offset (or last span).
    fn spanAt:TextSpan (p:Paragraph offset:int) {
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if ((offset >= s.start) && (offset < s.end)) {
                return s
            }
            if ((offset == s.end) && (offset == (strlen p.text))) {
                return s
            }
            i = (i + 1)
        }
        if ((array_length p.spans) > 0) {
            return (itemAt p.spans ((array_length p.spans) - 1))
        }
        def empty:TextSpan (TextSpan.create(0 0))
        return empty
    }

    fn mergeAdjacentSpans:void (p:Paragraph) {
        if ((array_length p.spans) < 2) {
            return
        }
        def out:[TextSpan]
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan ((itemAt p.spans i).copy())
            if ((array_length out) > 0) {
                def prev:TextSpan (itemAt out ((array_length out) - 1))
                if ((prev.end == s.start) && (prev.sameFormat(s))) {
                    prev.end = s.end
                } {
                    push out s
                }
            } {
                push out s
            }
            i = (i + 1)
        }
        clear p.spans
        def j:int 0
        while (j < (array_length out)) {
            push p.spans (itemAt out j)
            j = (j + 1)
        }
    }

    ; Rebuild spans after text replacement at [start,end) → text.
    ; Overlapping spans are split/clipped — never dropped wholesale (that used
    ; to wipe heading/title run formatting down to default 11pt on Backspace).
    fn replaceRange:void (paragraphId:int start:int end:int text:string) {
        doc.touch()
        def p:Paragraph (this.findParagraph(paragraphId))
        if (p.id != paragraphId) {
            return
        }
        def len:int (strlen p.text)
        if (start < 0) {
            start = 0
        }
        if (end < start) {
            end = start
        }
        if (start > len) {
            start = len
        }
        if (end > len) {
            end = len
        }
        def tip:TextSpan (this.spanAt(p start))
        def insertFmt:TextSpan (tip.copy())
        ; Align span edges to the edit range before removing the middle.
        this.splitSpansAt(p start)
        this.splitSpansAt(p end)
        def before:string (substring p.text 0 start)
        def after:string (substring p.text end len)
        def delta:int ((strlen text) - (end - start))
        def newSpans:[TextSpan]
        def si:int 0
        while (si < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans si)
            if (s.end <= start) {
                if (s.end > s.start) {
                    push newSpans (s.copy())
                }
            } {
                if (s.start >= end) {
                    def r:TextSpan (s.copy())
                    r.start = (r.start + delta)
                    r.end = (r.end + delta)
                    if (r.end > r.start) {
                        push newSpans r
                    }
                }
                ; fully inside [start,end) — drop
            }
            si = (si + 1)
        }
        p.text = (before + text + after)
        if ((strlen text) > 0) {
            def mid:TextSpan (insertFmt.copy())
            mid.start = start
            mid.end = (start + (strlen text))
            def placed:boolean false
            def out2:[TextSpan]
            def k:int 0
            while (k < (array_length newSpans)) {
                def ns:TextSpan (itemAt newSpans k)
                if ((placed == false) && (ns.start >= mid.end)) {
                    push out2 mid
                    placed = true
                }
                push out2 ns
                k = (k + 1)
            }
            if (placed == false) {
                push out2 mid
            }
            clear newSpans
            def k2:int 0
            while (k2 < (array_length out2)) {
                push newSpans (itemAt out2 k2)
                k2 = (k2 + 1)
            }
        }
        clear p.spans
        def m:int 0
        while (m < (array_length newSpans)) {
            push p.spans (itemAt newSpans m)
            m = (m + 1)
        }
        if ((array_length p.spans) == 0) {
            ; Preserve tip formatting even for empty paragraphs / full deletes.
            def one:TextSpan (insertFmt.copy())
            one.start = 0
            one.end = (strlen p.text)
            push p.spans one
        }
        this.mergeAdjacentSpans(p)
    }

    fn splitParagraph:int (paragraphId:int offset:int) {
        doc.touch()
        def idx:int (this.findParagraphIndex(paragraphId))
        if (idx < 0) {
            return paragraphId
        }
        def p:Paragraph (doc.paragraphAt(idx))
        def len:int (strlen p.text)
        if (offset < 0) {
            offset = 0
        }
        if (offset > len) {
            offset = len
        }
        def left:string (substring p.text 0 offset)
        def right:string (substring p.text offset len)
        ; New paragraph after p in blocks + paragraphs list
        def np:Paragraph (doc.addParagraphOnly())
        np.styleId = p.styleId
        np.align = p.align
        np.spaceBeforePt = p.spaceBeforePt
        np.spaceAfterPt = p.spaceAfterPt
        np.lineSpacing = p.lineSpacing
        np.indentLeftPt = p.indentLeftPt
        np.indentRightPt = p.indentRightPt
        np.indentFirstLinePt = p.indentFirstLinePt
        ; Carry the list membership too, or Enter inside a list drops out of it
        ; and leaves a blank line between the items. The marker itself is not
        ; copied: DocxLayout renumbers from listNumId as it lays the list out,
        ; so the new paragraph gets the next number and the ones after it shift.
        np.listKind = p.listKind
        np.listLevel = p.listLevel
        np.listNumId = p.listNumId
        np.listFmt = p.listFmt
        np.listText = p.listText
        np.text = right
        ; Split spans
        clear np.spans
        def tip:TextSpan (this.spanAt(p offset))
        def base:TextSpan (tip.copy())
        if ((strlen right) > 0) {
            base.start = 0
            base.end = (strlen right)
            push np.spans base
        } {
            def empty:TextSpan (tip.copy())
            empty.start = 0
            empty.end = 0
            push np.spans empty
        }
        ; Truncate original
        this.replaceRange(paragraphId offset len "")
        p.text = left
        ; Ensure left spans clipped
        def keep:[TextSpan]
        def si:int 0
        while (si < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans si)
            if (s.start < offset) {
                def c:TextSpan (s.copy())
                if (c.end > offset) {
                    c.end = offset
                }
                push keep c
            }
            si = (si + 1)
        }
        clear p.spans
        def ki:int 0
        while (ki < (array_length keep)) {
            push p.spans (itemAt keep ki)
            ki = (ki + 1)
        }
        if ((array_length p.spans) == 0) {
            push p.spans (TextSpan.create(0 (strlen p.text)))
        }
        ; Insert block after the block that owns p
        def bi:int 0
        def found:boolean false
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                if (b.paragraph.id == paragraphId) {
                    def nb:DocBlock (DocBlock.para(np))
                    ; insert after bi
                    def rest:[DocBlock]
                    def rj:int (bi + 1)
                    while (rj < (doc.blockCount())) {
                        push rest (doc.blockAt(rj))
                        rj = (rj + 1)
                    }
                    while ((array_length doc.blocks) > (bi + 1)) {
                        removeLast doc.blocks
                    }
                    push doc.blocks nb
                    def rk:int 0
                    while (rk < (array_length rest)) {
                        push doc.blocks (itemAt rest rk)
                        rk = (rk + 1)
                    }
                    found = true
                    bi = (doc.blockCount())
                }
            }
            bi = (bi + 1)
        }
        if (found == false) {
            push doc.blocks (DocBlock.para(np))
        }
        return np.id
    }

    ; --- body order -----------------------------------------------------------
    ; Selection spanning paragraphs needs to know which one comes first. Only
    ; top-level paragraph blocks count: table cells and headers are not part of
    ; the linear caret flow.
    fn bodyOrderOf:int (paragraphId:int) {
        def order:int 0
        def bi:int 0
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                if (b.paragraph.id == paragraphId) {
                    return order
                }
                order = (order + 1)
            }
            bi = (bi + 1)
        }
        return -1
    }

    fn bodyParagraphCount:int () {
        def count:int 0
        def bi:int 0
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                count = (count + 1)
            }
            bi = (bi + 1)
        }
        return count
    }

    fn bodyParagraphIdAt:int (order:int) {
        def seen:int 0
        def bi:int 0
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                if (seen == order) {
                    return b.paragraph.id
                }
                seen = (seen + 1)
            }
            bi = (bi + 1)
        }
        return 0
    }

    ; --- table cells ----------------------------------------------------------
    ; Cell paragraphs are created with addParagraphOnly, so they are NOT body
    ; blocks and bodyOrderOf returns -1 for them. Tab navigation needs to locate
    ; a caret inside a table instead. Fills [blockIndex, rowIndex, cellIndex,
    ; paragraphIndexInCell]; blockIndex -1 when the paragraph is not in a table.
    fn tableCellOf:void (paragraphId:int out:[int]) {
        clear out
        push out -1
        push out -1
        push out -1
        push out -1
        def bi:int 0
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 1) {
                def t:DocumentTable b.table
                def ri:int 0
                while (ri < (array_length t.rows)) {
                    def row:DocTableRow (itemAt t.rows ri)
                    def ci:int 0
                    while (ci < (array_length row.cells)) {
                        def cell:DocTableCell (itemAt row.cells ci)
                        def pi:int 0
                        while (pi < (array_length cell.paragraphs)) {
                            def cp:Paragraph (itemAt cell.paragraphs pi)
                            if (cp.id == paragraphId) {
                                clear out
                                push out bi
                                push out ri
                                push out ci
                                push out pi
                                return
                            }
                            pi = (pi + 1)
                        }
                        ci = (ci + 1)
                    }
                    ri = (ri + 1)
                }
            }
            bi = (bi + 1)
        }
    }

    fn tableAtBlock:DocumentTable (blockIndex:int) {
        def b:DocBlock (doc.blockAt(blockIndex))
        return b.table
    }

    ; First paragraph of a cell, or 0 when the coordinates are out of range.
    fn cellParagraphId:int (blockIndex:int rowIndex:int cellIndex:int) {
        if ((blockIndex < 0) || (blockIndex >= (doc.blockCount()))) {
            return 0
        }
        def b:DocBlock (doc.blockAt(blockIndex))
        if (b.kind != 1) {
            return 0
        }
        def t:DocumentTable b.table
        if ((rowIndex < 0) || (rowIndex >= (array_length t.rows))) {
            return 0
        }
        def row:DocTableRow (itemAt t.rows rowIndex)
        if ((cellIndex < 0) || (cellIndex >= (array_length row.cells))) {
            return 0
        }
        def cell:DocTableCell (itemAt row.cells cellIndex)
        if ((array_length cell.paragraphs) == 0) {
            return 0
        }
        def first:Paragraph (itemAt cell.paragraphs 0)
        return first.id
    }

    fn cellCountInRow:int (blockIndex:int rowIndex:int) {
        if ((blockIndex < 0) || (blockIndex >= (doc.blockCount()))) {
            return 0
        }
        def b:DocBlock (doc.blockAt(blockIndex))
        if (b.kind != 1) {
            return 0
        }
        def t:DocumentTable b.table
        if ((rowIndex < 0) || (rowIndex >= (array_length t.rows))) {
            return 0
        }
        def row:DocTableRow (itemAt t.rows rowIndex)
        return (array_length row.cells)
    }

    fn rowCountOfTable:int (blockIndex:int) {
        if ((blockIndex < 0) || (blockIndex >= (doc.blockCount()))) {
            return 0
        }
        def b:DocBlock (doc.blockAt(blockIndex))
        if (b.kind != 1) {
            return 0
        }
        def t:DocumentTable b.table
        return (array_length t.rows)
    }

    ; First body paragraph appearing after / before a given block index.
    fn bodyParagraphAfterBlock:int (blockIndex:int) {
        def bi:int (blockIndex + 1)
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                return b.paragraph.id
            }
            bi = (bi + 1)
        }
        return 0
    }

    fn bodyParagraphBeforeBlock:int (blockIndex:int) {
        def bi:int (blockIndex - 1)
        while (bi >= 0) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                return b.paragraph.id
            }
            bi = (bi - 1)
        }
        return 0
    }

    ; The table block that immediately follows / precedes a body paragraph, or -1.
    fn tableBlockAfterParagraph:int (paragraphId:int) {
        def at:int (this.blockIndexOfParagraph(paragraphId))
        if (at < 0) {
            return -1
        }
        def bi:int (at + 1)
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 1) {
                return bi
            }
            if (b.kind == 0) {
                return -1
            }
            bi = (bi + 1)
        }
        return -1
    }

    fn tableBlockBeforeParagraph:int (paragraphId:int) {
        def at:int (this.blockIndexOfParagraph(paragraphId))
        if (at < 0) {
            return -1
        }
        def bi:int (at - 1)
        while (bi >= 0) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 1) {
                return bi
            }
            if (b.kind == 0) {
                return -1
            }
            bi = (bi - 1)
        }
        return -1
    }

    ; Word adds a row when you Tab out of the last cell. The new row copies the
    ; last row's cell count and cell chrome so it matches the table.
    fn appendTableRow:int (blockIndex:int) {
        doc.touch()
        if ((blockIndex < 0) || (blockIndex >= (doc.blockCount()))) {
            return -1
        }
        def b:DocBlock (doc.blockAt(blockIndex))
        if (b.kind != 1) {
            return -1
        }
        def t:DocumentTable b.table
        def rowN:int (array_length t.rows)
        if (rowN == 0) {
            return -1
        }
        def template:DocTableRow (itemAt t.rows (rowN - 1))
        def row:DocTableRow (new DocTableRow)
        row.heightTwips = template.heightTwips
        def ci:int 0
        while (ci < (array_length template.cells)) {
            def src:DocTableCell (itemAt template.cells ci)
            def cell:DocTableCell (new DocTableCell)
            cell.gridSpan = src.gridSpan
            cell.vAlign = src.vAlign
            cell.padTopPx = src.padTopPx
            cell.padRightPx = src.padRightPx
            cell.padBottomPx = src.padBottomPx
            cell.padLeftPx = src.padLeftPx
            cell.borderTop = (new DocTableBorder)
            cell.borderLeft = (new DocTableBorder)
            cell.borderBottom = (new DocTableBorder)
            cell.borderRight = (new DocTableBorder)
            def p:Paragraph (doc.addParagraphOnly())
            p.styleId = "Normal"
            p.spaceBeforePt = 0.0
            p.spaceAfterPt = 0.0
            p.lineSpacing = 1.0
            def sp:TextSpan (TextSpan.create(0 0))
            if ((array_length src.paragraphs) > 0) {
                def srcPara:Paragraph (itemAt src.paragraphs 0)
                p.align = srcPara.align
                if ((array_length srcPara.spans) > 0) {
                    def srcSpan:TextSpan (itemAt srcPara.spans 0)
                    sp.fontSizePt = srcSpan.fontSizePt
                    sp.fontFamily = srcSpan.fontFamily
                    sp.colorHex = srcSpan.colorHex
                }
            }
            push p.spans sp
            push cell.paragraphs p
            push row.cells cell
            ci = (ci + 1)
        }
        push t.rows row
        return (array_length t.rows)
    }

    fn removeLastTableRow:boolean (blockIndex:int) {
        doc.touch()
        if ((blockIndex < 0) || (blockIndex >= (doc.blockCount()))) {
            return false
        }
        def b:DocBlock (doc.blockAt(blockIndex))
        if (b.kind != 1) {
            return false
        }
        def t:DocumentTable b.table
        if ((array_length t.rows) <= 1) {
            return false
        }
        removeLast t.rows
        return true
    }

    ; Block index of the top-level block holding this paragraph, or -1.
    fn blockIndexOfParagraph:int (paragraphId:int) {
        def bi:int 0
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                if (b.paragraph.id == paragraphId) {
                    return bi
                }
            }
            bi = (bi + 1)
        }
        return -1
    }

    ; Splice a fresh table block immediately before the given paragraph's block.
    fn insertTableBefore:DocumentTable (paragraphId:int) {
        doc.touch()
        def t:DocumentTable (doc.addTableOnly())
        def at:int (this.blockIndexOfParagraph(paragraphId))
        if (at < 0) {
            push doc.blocks (DocBlock.tbl(t))
            return t
        }
        def rest:[DocBlock]
        def rj:int at
        while (rj < (doc.blockCount())) {
            push rest (doc.blockAt(rj))
            rj = (rj + 1)
        }
        while ((array_length doc.blocks) > at) {
            removeLast doc.blocks
        }
        push doc.blocks (DocBlock.tbl(t))
        def rk:int 0
        while (rk < (array_length rest)) {
            push doc.blocks (itemAt rest rk)
            rk = (rk + 1)
        }
        return t
    }

    ; A chart, inserted before the paragraph the caret is in. Same shape as a
    ; table paste: a chart is a block, and the paragraph it interrupts has
    ; already been split in two.
    fn insertChartBefore:DocChart (paragraphId:int json:string) {
        doc.touch()
        def c:DocChart (doc.addChart(json))
        ; addChart appended a block for it; take that back off and put it
        ; where the caret is instead.
        removeLast doc.blocks
        def at:int (this.blockIndexOfParagraph(paragraphId))
        if (at < 0) {
            push doc.blocks (DocBlock.chartBlock(c))
            return c
        }
        def rest:[DocBlock]
        def rj:int at
        while (rj < (doc.blockCount())) {
            push rest (doc.blockAt(rj))
            rj = (rj + 1)
        }
        while ((array_length doc.blocks) > at) {
            removeLast doc.blocks
        }
        push doc.blocks (DocBlock.chartBlock(c))
        def rk:int 0
        while (rk < (array_length rest)) {
            push doc.blocks (itemAt rest rk)
            rk = (rk + 1)
        }
        return c
    }

    ; Remove the block holding this chart (used to undo a chart paste, and to
    ; delete one).
    fn removeChartBlock:boolean (chartId:int) {
        doc.touch()
        def keep:[DocBlock]
        def found:boolean false
        def i:int 0
        while (i < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(i))
            def drop:boolean false
            if (b.kind == 4) {
                if (b.chart.id == chartId) {
                    drop = true
                    found = true
                }
            }
            if (drop == false) {
                push keep b
            }
            i = (i + 1)
        }
        if found {
            clear doc.blocks
            def k:int 0
            while (k < (array_length keep)) {
                push doc.blocks (itemAt keep k)
                k = (k + 1)
            }
        }
        return found
    }

    ; Remove the block holding this table (used to undo a table paste).
    fn removeTableById:boolean (tableId:int) {
        doc.touch()
        def at:int -1
        def bi:int 0
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 1) {
                if (b.table.id == tableId) {
                    at = bi
                    bi = (doc.blockCount())
                }
            }
            bi = (bi + 1)
        }
        if (at < 0) {
            return false
        }
        def rest:[DocBlock]
        def rj:int (at + 1)
        while (rj < (doc.blockCount())) {
            push rest (doc.blockAt(rj))
            rj = (rj + 1)
        }
        while ((array_length doc.blocks) > at) {
            removeLast doc.blocks
        }
        def rk:int 0
        while (rk < (array_length rest)) {
            push doc.blocks (itemAt rest rk)
            rk = (rk + 1)
        }
        return true
    }

    ; Merge paragraphId into previous top-level body paragraph.
    fn mergePrevious:DocumentPosition (paragraphId:int) {
        doc.touch()
        def fail:DocumentPosition (DocumentPosition.create(0 0))
        def idx:int (this.findParagraphIndex(paragraphId))
        if (idx <= 0) {
            return fail
        }
        ; Find previous paragraph that appears as a body block before this one
        def prevId:int 0
        def bi:int 0
        def saw:boolean false
        while (bi < (doc.blockCount())) {
            def b:DocBlock (doc.blockAt(bi))
            if (b.kind == 0) {
                if (b.paragraph.id == paragraphId) {
                    saw = true
                    bi = (doc.blockCount())
                } {
                    prevId = b.paragraph.id
                }
            }
            bi = (bi + 1)
        }
        if (saw == false) {
            return fail
        }
        if (prevId <= 0) {
            return fail
        }
        def prev:Paragraph (this.findParagraph(prevId))
        def cur:Paragraph (this.findParagraph(paragraphId))
        def joinAt:int (strlen prev.text)
        def joined:string (cur.text)
        ; Append text with formatting from first span of cur
        def fmt:TextSpan (this.spanAt(cur 0))
        this.replaceRange(prevId joinAt joinAt joined)
        if ((strlen joined) > 0) {
            ; apply cur's first span attrs onto inserted range roughly
            def a:int joinAt
            def b:int (joinAt + (strlen joined))
            this.applyBold(prevId a b fmt.bold)
        }
        ; Remove cur from blocks + paragraphs
        def nb:[DocBlock]
        def bj:int 0
        while (bj < (doc.blockCount())) {
            def bb:DocBlock (doc.blockAt(bj))
            if (bb.kind == 0) {
                if (bb.paragraph.id == paragraphId) {
                    ; skip
                } {
                    push nb bb
                }
            } {
                push nb bb
            }
            bj = (bj + 1)
        }
        clear doc.blocks
        def bk:int 0
        while (bk < (array_length nb)) {
            push doc.blocks (itemAt nb bk)
            bk = (bk + 1)
        }
        def np:[Paragraph]
        def pi:int 0
        while (pi < (doc.paragraphCount())) {
            def pp:Paragraph (doc.paragraphAt(pi))
            if (pp.id == paragraphId) {
                ; skip
            } {
                push np pp
            }
            pi = (pi + 1)
        }
        clear doc.paragraphs
        def pk:int 0
        while (pk < (array_length np)) {
            push doc.paragraphs (itemAt np pk)
            pk = (pk + 1)
        }
        lastMergeCaret = (DocumentPosition.create(prevId joinAt))
        return (lastMergeCaret.copy())
    }

    ; --- run properties, by name ---------------------------------------------
    ; There was one of these, for bold, written out longhand — split the spans
    ; at both ends, walk them, set the field, merge back. Italic, underline, a
    ; point size and a colour are the same six lines with one field changed, and
    ; writing them out five more times is how a file grows a bug in the fifth
    ; copy only. So the field is a NAME, and there is one applier.
    ;
    ;   "bold" "italic" "underline"   flag, from `on`
    ;   "size"                        points, from `num`
    ;   "font" "color"                text, from `text`
    fn applyRun:void (paragraphId:int start:int end:int what:string on:boolean num:double text:string) {
        doc.touch()
        def p:Paragraph (this.findParagraph(paragraphId))
        if (p.id != paragraphId) {
            return
        }
        if (start >= end) {
            return
        }
        this.splitSpansAt(p start)
        this.splitSpansAt(p end)
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if ((s.start >= start) && (s.end <= end)) {
                if (what == "bold") {
                    s.bold = on
                }
                if (what == "italic") {
                    s.italic = on
                }
                if (what == "underline") {
                    s.underline = on
                }
                if (what == "size") {
                    s.fontSizePt = num
                }
                if (what == "font") {
                    s.fontFamily = text
                }
                if (what == "color") {
                    s.colorHex = text
                }
            }
            i = (i + 1)
        }
        this.mergeAdjacentSpans(p)
    }

    ; True when every span covering [start,end) already has this flag on.
    ; "Covered" matters: an empty range has nothing to be on, and answering
    ; yes for one would make a toggle turn bold OFF on an empty selection.
    fn rangeIsOn:boolean (paragraphId:int start:int end:int what:string) {
        def p:Paragraph (this.findParagraph(paragraphId))
        if (p.id != paragraphId) {
            return false
        }
        if (start >= end) {
            return false
        }
        def covered:boolean false
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            def a:int s.start
            def b:int s.end
            if (a < start) {
                a = start
            }
            if (b > end) {
                b = end
            }
            if (a < b) {
                covered = true
                def on:boolean false
                if (what == "bold") {
                    on = s.bold
                }
                if (what == "italic") {
                    on = s.italic
                }
                if (what == "underline") {
                    on = s.underline
                }
                if (on == false) {
                    return false
                }
            }
            i = (i + 1)
        }
        return covered
    }

    ; What the first span of a range says, for a toolbar that has to show the
    ; face and the size of what the caret is in.
    fn runFontOf:string (paragraphId:int offset:int) {
        def p:Paragraph (this.findParagraph(paragraphId))
        if (p.id != paragraphId) {
            return ""
        }
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if ((offset >= s.start) && (offset <= s.end)) {
                return s.fontFamily
            }
            i = (i + 1)
        }
        return ""
    }

    fn runSizeOf:double (paragraphId:int offset:int) {
        def p:Paragraph (this.findParagraph(paragraphId))
        if (p.id != paragraphId) {
            return 0.0
        }
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if ((offset >= s.start) && (offset <= s.end)) {
                return s.fontSizePt
            }
            i = (i + 1)
        }
        return 0.0
    }

    fn applyBold:void (paragraphId:int start:int end:int value:boolean) {
        this.applyRun(paragraphId start end "bold" value 0.0 "")
    }

    fn rangeIsBold:boolean (paragraphId:int start:int end:int) {
        return (this.rangeIsOn(paragraphId start end "bold"))
    }

    fn applyFont:void (paragraphId:int start:int end:int font:string) {
        this.applyRun(paragraphId start end "font" false 0.0 font)
    }

    fn splitSpansAt:void (p:Paragraph offset:int) {
        def len:int (strlen p.text)
        if ((offset <= 0) || (offset >= len)) {
            return
        }
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if ((offset > s.start) && (offset < s.end)) {
                def right:TextSpan (s.copy())
                right.start = offset
                s.end = offset
                insert p.spans (i + 1) right
                return
            }
            i = (i + 1)
        }
    }
}

; ==============================================================================
; DocxView - SoftCanvas paint of laid-out RichDocument pages.
; ==============================================================================

Import "RichDocument.rgr"
; The chart component: the same model, the same generator and the same Vela
; renderer the spreadsheet uses. A chart pasted into a document is not a second
; implementation of charts — it is the first one, running here.
Import "../../datagrid/src/ChartDoc.rgr"
Import "../../datagrid/src/GridChartView.rgr"
Import "../../datagrid/src/SoftPainter.rgr"
Import "DocxLayout.rgr"
Import "DocxEditController.rgr"
Import "DocxTextMetrics.rgr"
Import "WordNumbering.rgr"
Import "../../game_engine/framebuffer.rgr"
Import "../../game_engine/ui/UIContext.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../pdf_writer/src/raster/PNGEncoder.rgr"
Import "../../pdf_writer/src/raster/RasterBuffer.rgr"
Import "../../text_editor/src/TextEditCore.rgr"

class DocxView {
    def canvas:SoftCanvas (new SoftCanvas)
    def ctx:UIContext (new UIContext)
    ; Charts in the document, drawn by the spreadsheet's own renderer. The
    ; cache is keyed by chart id and box, so scrolling a page of charts costs
    ; nothing and editing one costs a single recompute.
    def charts:GridChartView (new GridChartView)
    def chartInk:SoftPainter (new SoftPainter)
    ; Which chart the caret is on, or 0. Painted with a frame so the reader can
    ; see what an edit would change.
    def selectedChartId:int 0
    def layout:DocxLayout (new DocxLayout)
    def pageIndex:int 0
    def bg:EVGColor (EVGColor.rgb(248 248 250))
    def ink:EVGColor (EVGColor.rgb(20 24 32))
    def marginGuide:EVGColor (EVGColor.rgb(220 224 232))
    def pageGap:int 24
    def docRef:RichDocument
    def caretColor:EVGColor (EVGColor.rgb(20 90 200))
    def selColor:EVGColor (EVGColor.rgb(120 170 255))

    Constructor () {
    }

    fn init:void (fontDir:string) {
        ctx.tr.addFontDir(fontDir)
        ctx.tr.loadFont("Open Sans" "Open_Sans/OpenSans-Regular.ttf")
        ctx.tr.fm.loadFont("Open_Sans/OpenSans-Bold.ttf")
        ctx.tr.fm.loadFont("Cinzel/Cinzel-Regular.ttf")
        ctx.tr.fm.loadFont("Josefin_Sans/JosefinSans-Regular.ttf")
    }

    fn present:void (doc:RichDocument page:int nums:WordNumbering) {
        docRef = doc
        layout.layout(doc ctx.tr nums)
        if (page < 0) {
            page = 0
        }
        if (page >= (layout.pageCount())) {
            page = ((layout.pageCount()) - 1)
        }
        if (page < 0) {
            page = 0
        }
        pageIndex = page
        def pg:LaidPage (layout.pageAt(pageIndex))
        canvas.init(pg.width pg.height)
        ctx.attach(canvas)
        canvas.clear((bg.red()) (bg.green()) (bg.blue()))
        def sec:DocSection (doc.sectionAt(pg.sectionIndex))
        def ml:int (sec.marginLeftPx())
        def mt:int (sec.marginTopPx())
        def mr:int (sec.marginRightPx())
        def mb:int (sec.marginBottomPx())
        ctx.strokeRect(ml mt ((pg.width - ml) - mr) ((pg.height - mt) - mb) 1 marginGuide)
        this.paintPage(pg)
    }

    fn presentWithEdit:void (doc:RichDocument page:int nums:WordNumbering edit:DocxEditController) {
        docRef = doc
        layout.layout(doc ctx.tr nums)
        if (page < 0) {
            page = 0
        }
        if (page >= (layout.pageCount())) {
            page = ((layout.pageCount()) - 1)
        }
        if (page < 0) {
            page = 0
        }
        pageIndex = page
        def pg:LaidPage (layout.pageAt(pageIndex))
        canvas.init(pg.width pg.height)
        ctx.attach(canvas)
        canvas.clear((bg.red()) (bg.green()) (bg.blue()))
        def sec:DocSection (doc.sectionAt(pg.sectionIndex))
        def ml:int (sec.marginLeftPx())
        def mt:int (sec.marginTopPx())
        def mr:int (sec.marginRightPx())
        def mb:int (sec.marginBottomPx())
        ctx.strokeRect(ml mt ((pg.width - ml) - mr) ((pg.height - mt) - mb) 1 marginGuide)
        if (edit.isActive()) {
            this.paintSelection(edit)
        }
        this.paintPage(pg)
        if (edit.isActive()) {
            this.paintCaret(edit)
        }
    }

    fn paintCaret:void (edit:DocxEditController) {
        def cx:int (edit.caretPixelX(layout pageIndex))
        def cy:int (edit.caretPixelY(layout pageIndex))
        def ch:int (edit.caretHeight(layout pageIndex))
        if ((cx < 0) || (cy < 0)) {
            return
        }
        ctx.fillRect(cx cy 2 ch caretColor)
    }

    fn paintSelection:void (edit:DocxEditController) {
        def sel:DocumentRange (edit.selection())
        if (sel.isCollapsed()) {
            return
        }
        def a:[int]
        def b:[int]
        edit.orderedEnds(a b)
        def sPid:int (itemAt a 0)
        def sOff:int (itemAt a 1)
        def ePid:int (itemAt b 0)
        def eOff:int (itemAt b 1)
        def sOrder:int (edit.adapter.bodyOrderOf(sPid))
        def eOrder:int (edit.adapter.bodyOrderOf(ePid))
        if ((sOrder < 0) || (eOrder < 0)) {
            return
        }
        def pg:LaidPage (layout.pageAt(pageIndex))
        def i:int 0
        while (i < (array_length pg.lines)) {
            def line:LaidLine (itemAt pg.lines i)
            if (line.kind == 0) {
                if (line.paraIndex > 0) {
                    def order:int (edit.adapter.bodyOrderOf(line.paraIndex))
                    if ((order >= sOrder) && (order <= eOrder)) {
                        ; Clip the selection to what this visual line covers.
                        def ls:int line.docStart
                        def le:int line.docEnd
                        def s:int ls
                        def e:int le
                        if (order == sOrder) {
                            if (sOff > s) {
                                s = sOff
                            }
                        }
                        if (order == eOrder) {
                            if (eOff < e) {
                                e = eOff
                            }
                        }
                        if (s < ls) {
                            s = ls
                        }
                        if (e > le) {
                            e = le
                        }
                        def p:Paragraph (unwrap line.paragraphRef)
                        def fontPx:double line.fontSizePx
                        def x0:int line.x
                        if ((strlen line.listPrefix) > 0) {
                            if ((indexOf line.text line.listPrefix) == 0) {
                                x0 = (x0 + (DocxTextMetrics.measurePlain(ctx.tr line.listPrefix fontPx line.bold)))
                            }
                        }
                        if (s < e) {
                            def x1:int (x0 + (DocxTextMetrics.measureRange(ctx.tr p fontPx ls s)))
                            def x2:int (x0 + (DocxTextMetrics.measureRange(ctx.tr p fontPx ls e)))
                            def w:int (x2 - x1)
                            if (w < 2) {
                                w = 2
                            }
                            ; A paragraph swallowed whole shows its newline too.
                            if (order < eOrder) {
                                if (e == (strlen p.text)) {
                                    w = (w + 6)
                                }
                            }
                            ctx.fillRect(x1 line.y w line.height selColor)
                        } {
                            ; Empty paragraph inside the selection still shows.
                            def emptyInside:boolean false
                            if ((ls == le) && ((strlen line.text) == 0)) {
                                if ((order > sOrder) && (order < eOrder)) {
                                    emptyInside = true
                                }
                                if ((order == sOrder) && (order != eOrder)) {
                                    emptyInside = true
                                }
                                if ((order == eOrder) && (order != sOrder)) {
                                    emptyInside = false
                                }
                                if ((sPid == ePid) && (sOff <= ls) && (eOff >= ls)) {
                                    emptyInside = true
                                }
                            }
                            if emptyInside {
                                ctx.fillRect(line.x line.y 6 line.height selColor)
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn presentAll:void (doc:RichDocument nums:WordNumbering maxPages:int) {
        docRef = doc
        layout.layout(doc ctx.tr nums)
        def n:int (layout.pageCount())
        if (n < 1) {
            canvas.init(100 100)
            return
        }
        if ((maxPages > 0) && (n > maxPages)) {
            n = maxPages
        }
        def maxW:int 0
        def totalH:int 0
        def i:int 0
        while (i < n) {
            def pg:LaidPage (layout.pageAt(i))
            if (pg.width > maxW) {
                maxW = pg.width
            }
            totalH = (totalH + pg.height)
            if (i < (n - 1)) {
                totalH = (totalH + pageGap)
            }
            i = (i + 1)
        }
        canvas.init(maxW totalH)
        ctx.attach(canvas)
        canvas.clear(210 214 220)
        def yOff:int 0
        i = 0
        while (i < n) {
            def pg2:LaidPage (layout.pageAt(i))
            ; page shadow card
            ctx.fillRect(0 yOff pg2.width pg2.height bg)
            ; temporarily paint into offset by adjusting line y — copy approach:
            this.paintPageAt(pg2 0 yOff)
            yOff = (yOff + pg2.height + pageGap)
            i = (i + 1)
        }
    }

    fn paintPage:void (pg:LaidPage) {
        this.paintPageAt(pg 0 0)
    }

    fn paintPageAt:void (pg:LaidPage ox:int oy:int) {
        def i:int 0
        while (i < (array_length pg.lines)) {
            def line:LaidLine (itemAt pg.lines i)
            def lx:int (line.x + ox)
            def ly:int (line.y + oy)
            if (line.kind == 2) {
                ctx.fillRect(lx ly line.width line.height (this.hexColor(line.fillHex)))
            }
            if (line.kind == 3) {
                ctx.fillRect(lx ly line.width line.height (this.hexColor(line.borderColor)))
            }
            if (line.kind == 1) {
                def p:Paragraph line.paragraphRef
                if (line.imageIndex < (array_length p.images)) {
                    def dimg:DocImage (itemAt p.images line.imageIndex)
                    if dimg.ok {
                        if ((dimg.pixels.width == line.width) && (dimg.pixels.height == line.height)) {
                            canvas.blitImage(dimg.pixels lx ly)
                        } {
                            canvas.blitImageRectScaled(dimg.pixels 0 0 dimg.pixels.width dimg.pixels.height lx ly line.width line.height)
                        }
                    } {
                        ctx.fillRect(lx ly line.width line.height (EVGColor.rgb(200 210 220)))
                        ctx.text("[image]" lx (ly + 4) 12.0 ink)
                    }
                }
            }
            if (line.kind == 6) {
                this.paintChartLine(line lx ly)
            }
            if ((line.kind == 0) || (line.kind == 4) || (line.kind == 5)) {
                this.paintStyledLine(line lx ly)
            }
            i = (i + 1)
        }
    }

    ; A chart, drawn where the layout put it. The document carries the chart's
    ; JSON; this decodes it, hands the cells and the settings to the same
    ; generator the grid uses, and paints the resulting draw commands onto this
    ; page's canvas. Nothing about the picture was stored — it is made here,
    ; which is why an edit shows up immediately.
    fn paintChartLine:void (line:LaidLine lx:int ly:int) {
        def ch:DocChart (docRef.chartById(line.chartId))
        if ((strlen ch.json) == 0) {
            return
        }
        def doc:ChartDoc (ChartDocCodec.decode(ch.json))
        if (doc.ok == false) {
            ch.note = doc.note
            ctx.fillRect(lx ly line.width line.height (EVGColor.rgb(240 242 246)))
            ctx.text(("[chart: " + doc.note + "]") (lx + 8) (ly + 8) 12.0 ink)
            return
        }
        ; The chart's id is the render cache's key, so two charts in one
        ; document do not evict each other.
        doc.chart.id = ch.id
        def dl (new EVGDisplayList)
        charts.paint(dl doc.cells doc.chart ctx.tr lx ly line.width line.height)
        chartInk.attach(canvas ctx (new GridImages) (canvas.getWidth()) (canvas.getHeight()))
        chartInk.draw(dl)
        ch.note = ""
        if (selectedChartId == ch.id) {
            ; The selection frame is chrome, not part of the chart — it is
            ; drawn after, so it never ends up in an exported picture.
            def mark:EVGColor (EVGColor.rgb(40 100 210))
            ctx.strokeRect((lx - 3) (ly - 3) (line.width + 6) (line.height + 6) 2 mark)
        }
    }

    ; Paint a visual line using paragraph TextSpan runs (bold/color/underline).
    ; Layout still wraps with the line's primary size; run styles drive glyphs.
    fn paintStyledLine:void (line:LaidLine lx:int ly:int) {
        def size:double line.fontSizePx
        if (size < 8.0) {
            size = 8.0
        }
        def p:Paragraph line.paragraphRef
        def muteChrome:boolean false
        if ((line.kind == 4) || (line.kind == 5)) {
            muteChrome = true
        }
        if ((p.id <= 0) || ((array_length p.spans) == 0)) {
            def col0:EVGColor (this.hexColor(line.colorHex))
            if muteChrome {
                col0 = (EVGColor.rgb(80 90 110))
            }
            this.setPaintFace(line.bold)
            ctx.text(line.text lx ly size col0)
            if line.underline {
                def uy0:int ((ly + (to_int size)) + 1)
                ctx.fillRect(lx uy0 line.width 1 col0)
            }
            return
        }
        def display:string line.text
        def x:int lx
        def prefixLen:int 0
        if ((strlen line.listPrefix) > 0) {
            if ((indexOf display line.listPrefix) == 0) {
                prefixLen = (strlen line.listPrefix)
            }
        }
        if (prefixLen > 0) {
            def pref:string (substring display 0 prefixLen)
            def colP:EVGColor (this.hexColor(line.colorHex))
            if muteChrome {
                colP = (EVGColor.rgb(80 90 110))
            }
            this.setPaintFace(line.bold)
            ctx.text(pref x ly size colP)
            x = (x + (to_int (ctx.tr.measureWidth(pref size))))
            display = (substring display prefixLen (strlen display))
        }
        def doc0:int line.docStart
        def doc1:int line.docEnd
        if (doc1 < doc0) {
            doc1 = doc0
        }
        ; Empty line still needs a hit target; nothing to paint.
        if ((strlen display) == 0) {
            return
        }
        ; If doc offsets were never set, paint whole line with first span.
        if ((doc0 == 0) && (doc1 == 0) && ((strlen p.text) > 0) && ((strlen display) > 0)) {
            if ((indexOf p.text display) < 0) {
                def s0:TextSpan (itemAt p.spans 0)
                this.paintTextRun(display x ly size s0 muteChrome)
                return
            }
        }
        def si:int 0
        while (si < (array_length p.spans)) {
            def sp:TextSpan (itemAt p.spans si)
            def a:int sp.start
            def b:int sp.end
            if (a < doc0) {
                a = doc0
            }
            if (b > doc1) {
                b = doc1
            }
            if (a < b) {
                def local0:int (a - doc0)
                def local1:int (b - doc0)
                if (local0 < 0) {
                    local0 = 0
                }
                if (local1 > (strlen display)) {
                    local1 = (strlen display)
                }
                if (local0 < local1) {
                    def chunk:string (substring display local0 local1)
                    def runW:int (this.paintTextRun(chunk x ly size sp muteChrome))
                    x = (x + runW)
                }
            }
            si = (si + 1)
        }
    }

    ; Single face policy, shared with DocxTextMetrics so what is painted and
    ; what the caret / selection measure can never disagree.
    fn setPaintFace:void (bold:boolean) {
        DocxTextMetrics.applyFace(ctx.tr bold)
    }

    fn paintTextRun:int (chunk:string x:int y:int size:double sp:TextSpan muteChrome:boolean) {
        def col:EVGColor (this.hexColor(sp.colorHex))
        if muteChrome {
            col = (EVGColor.rgb(80 90 110))
        }
        def runSize:double size
        if (runSize < 8.0) {
            runSize = 8.0
        }
        this.setPaintFace(sp.bold)
        ctx.text(chunk x y runSize col)
        def w:int (DocxTextMetrics.measurePlain(ctx.tr chunk runSize sp.bold))
        if sp.underline {
            def uy:int ((y + (to_int runSize)) + 1)
            ctx.fillRect(x uy w 1 col)
        }
        return w
    }

    fn hexColor:EVGColor (hex:string) {
        if ((strlen hex) != 6) {
            return ink
        }
        def r:int (this.hexByte((substring hex 0 2)))
        def g:int (this.hexByte((substring hex 2 4)))
        def b:int (this.hexByte((substring hex 4 6)))
        return (EVGColor.rgb(r g b))
    }

    fn hexByte:int (hh:string) {
        def hi:int (this.hexNibble((charAt hh 0)))
        def lo:int (this.hexNibble((charAt hh 1)))
        return ((hi * 16) + lo)
    }

    fn hexNibble:int (ch:int) {
        if ((ch >= 48) && (ch <= 57)) {
            return (ch - 48)
        }
        if ((ch >= 65) && (ch <= 70)) {
            return (ch - 55)
        }
        if ((ch >= 97) && (ch <= 102)) {
            return (ch - 87)
        }
        return 0
    }

    fn raw:buffer () {
        return (canvas.raw())
    }

    fn width:int () {
        return canvas.w
    }

    fn height:int () {
        return canvas.h
    }

    fn writePng:void (dir:string file:string) {
        def rb:RasterBuffer (new RasterBuffer)
        rb.width = (this.width())
        rb.height = (this.height())
        rb.pixels = (this.raw())
        def png:PNGEncoder (new PNGEncoder)
        png.encode(rb dir file)
    }

    fn pngBytes:buffer () {
        def rb:RasterBuffer (new RasterBuffer)
        rb.width = (this.width())
        rb.height = (this.height())
        rb.pixels = (this.raw())
        def png:PNGEncoder (new PNGEncoder)
        return (png.encodeToBuffer(rb))
    }
}

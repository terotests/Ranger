; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; DocxEditController - TextEditCore-style editing over RichDocument + DocxLayout.
; ==============================================================================
;
; Shared types: DocumentPosition / DocumentRange / DocEditOp from TextEditCore.
; Adapter: RichDocumentEdit. Hit-test + caret geometry come from DocxLayout —
; the same layout used to paint text.
; ==============================================================================

Import "RichDocument.rgr"
Import "RichDocumentEdit.rgr"
Import "ClipboardTable.rgr"
Import "../../datagrid/src/ChartDoc.rgr"
Import "DocxTextMetrics.rgr"
Import "DocxLayout.rgr"
Import "../../text_editor/src/TextEditCore.rgr"
Import "../../game_engine/ui/UITextRenderer.rgr"
Import "../../office/editor/OfficeHistory.rgr"

class DocxEditController {
    def adapter:RichDocumentEdit (new RichDocumentEdit)
    def sel:DocumentRange (new DocumentRange)
    ; The ops, what counts as one action, what an op's transaction is and how
    ; much falls off the bottom at the limit — all of it
    ; `gallery/office/editor`, shared with the spreadsheet's history. The
    ; document's own rules were missing all three: a paste of three lines was
    ; five separate undos that never got back to where they started. The two
    ; stacks and the trim loop that used to live here are gone with them; a
    ; type parameter means the shared file can hold `DocEditOp` without
    ; knowing anything about it.
    def history:OfficeHistory@(DocEditOp) (new OfficeHistory@(DocEditOp) ())
    def active:boolean false
    def enabled:boolean false
    def typingBold:boolean false
    def typingItalic:boolean false
    def typingUnderline:boolean false
    def typingFont:string "Open Sans"
    def typingSize:double 11.0
    def typingColor:string "000000"
    def caretBlink:boolean true
    def suppressUndo:boolean false

    Constructor () {
    }

    fn bindDocument:void (doc:RichDocument) {
        adapter.bind(doc)
        active = false
        history.reset()
    }

    fn setEnabled:void (on:boolean) {
        enabled = on
        if (on == false) {
            active = false
        }
    }

    fn isEnabled:boolean () {
        return enabled
    }

    fn isActive:boolean () {
        return (enabled && active)
    }

    fn setCaret:void (paragraphId:int offset:int) {
        def len:int (adapter.textLength(paragraphId))
        if (offset < 0) {
            offset = 0
        }
        if (offset > len) {
            offset = len
        }
        def p:DocumentPosition (DocumentPosition.create(paragraphId offset))
        sel.anchor = (p.copy())
        sel.focus = (p.copy())
        active = true
    }

    fn setRange:void (paragraphId:int a:int b:int) {
        def len:int (adapter.textLength(paragraphId))
        if (a < 0) {
            a = 0
        }
        if (b < 0) {
            b = 0
        }
        if (a > len) {
            a = len
        }
        if (b > len) {
            b = len
        }
        sel.anchor = (DocumentPosition.create(paragraphId a))
        sel.focus = (DocumentPosition.create(paragraphId b))
        active = true
    }

    ; Move the moving end of the selection and leave the anchor where it is.
    ; A drag and a shift-click are the same gesture, and both may cross a
    ; paragraph break — `orderedEnds` puts the two ends into document order, so
    ; nothing below here cares which way round they are.
    fn extendTo:void (paragraphId:int offset:int) {
        if (active == false) {
            this.setCaret(paragraphId offset)
            return
        }
        def len:int (adapter.textLength(paragraphId))
        if (len < 0) {
            return
        }
        if (offset < 0) {
            offset = 0
        }
        if (offset > len) {
            offset = len
        }
        sel.focus = (DocumentPosition.create(paragraphId offset))
    }

    fn caret:DocumentPosition () {
        return (sel.focus.copy())
    }

    fn selection:DocumentRange () {
        return sel
    }

    fn pushUndo:void (op:DocEditOp) {
        ; Undo/redo replay through the same edit primitives; their ops must not
        ; land back on the stack.
        if suppressUndo {
            return
        }
        ; Stamped with the action it belongs to, trimmed only when no action
        ; is open, and the redo stack dropped because a new edit makes every
        ; undone op unreachable — one call, and none of those three rules
        ; written here.
        history.record(op)
    }

    ; One action, however many primitives it takes. Nested safely, so a paste
    ; that is an insert and a split and another insert is still one undo.
    fn beginAction:void () {
        history.begin()
    }

    fn endAction:void () {
        history.end()
    }

    ; --- multi-paragraph selection -------------------------------------------
    ; DocumentRange is anchor→focus in the order the user dragged. These give it
    ; in document order, so a backwards or multi-paragraph selection behaves the
    ; same as a forward one. Results land in the out arrays as
    ; [paragraphId, offset].
    fn orderedEnds:void (startOut:[int] endOut:[int]) {
        clear startOut
        clear endOut
        def aPid:int sel.anchor.paragraphId
        def bPid:int sel.focus.paragraphId
        def aOff:int sel.anchor.textOffset
        def bOff:int sel.focus.textOffset
        def swap:boolean false
        if (aPid == bPid) {
            if (aOff > bOff) {
                swap = true
            }
        } {
            def ao:int (adapter.bodyOrderOf(aPid))
            def bo:int (adapter.bodyOrderOf(bPid))
            if (ao > bo) {
                swap = true
            }
        }
        if swap {
            push startOut bPid
            push startOut bOff
            push endOut aPid
            push endOut aOff
        } {
            push startOut aPid
            push startOut aOff
            push endOut bPid
            push endOut bOff
        }
    }

    fn spansParagraphs:boolean () {
        if (sel.isCollapsed()) {
            return false
        }
        return ((sel.sameParagraph()) == false)
    }

    ; Selected text, "\n" between paragraphs — what Ctrl+C puts on the clipboard.
    fn selectedText:string () {
        if ((this.isActive()) == false) {
            return ""
        }
        if (sel.isCollapsed()) {
            return ""
        }
        def a:[int]
        def b:[int]
        this.orderedEnds(a b)
        def sPid:int (itemAt a 0)
        def sOff:int (itemAt a 1)
        def ePid:int (itemAt b 0)
        def eOff:int (itemAt b 1)
        if (sPid == ePid) {
            def t:string (adapter.getText(sPid))
            def x0:int sOff
            def x1:int eOff
            if (x1 > (strlen t)) {
                x1 = (strlen t)
            }
            if (x0 < 0) {
                x0 = 0
            }
            if (x0 >= x1) {
                return ""
            }
            return (substring t x0 x1)
        }
        def sOrder:int (adapter.bodyOrderOf(sPid))
        def eOrder:int (adapter.bodyOrderOf(ePid))
        if ((sOrder < 0) || (eOrder < 0)) {
            return ""
        }
        def out:string ""
        def o:int sOrder
        while (o <= eOrder) {
            def pid:int (adapter.bodyParagraphIdAt(o))
            def txt:string (adapter.getText(pid))
            def piece:string txt
            if (o == sOrder) {
                def s0:int sOff
                if (s0 > (strlen txt)) {
                    s0 = (strlen txt)
                }
                piece = (substring txt s0 (strlen txt))
            }
            if (o == eOrder) {
                def base:string piece
                def e0:int eOff
                if (o == sOrder) {
                    e0 = (eOff - sOff)
                }
                if (e0 < 0) {
                    e0 = 0
                }
                if (e0 > (strlen base)) {
                    e0 = (strlen base)
                }
                piece = (substring base 0 e0)
            }
            if (o > sOrder) {
                out = (out + "\n")
            }
            out = (out + piece)
            o = (o + 1)
        }
        return out
    }

    ; Delete across paragraphs: trim the first, empty the ones between, trim the
    ; last, then merge them all back into the first.
    fn deleteSelectionMulti:void () {
        def a:[int]
        def b:[int]
        this.orderedEnds(a b)
        def sPid:int (itemAt a 0)
        def sOff:int (itemAt a 1)
        def ePid:int (itemAt b 0)
        def eOff:int (itemAt b 1)
        def sOrder:int (adapter.bodyOrderOf(sPid))
        def eOrder:int (adapter.bodyOrderOf(ePid))
        if ((sOrder < 0) || (eOrder < 0)) {
            return
        }
        if (eOrder <= sOrder) {
            return
        }
        def op:DocEditOp (new DocEditOp)
        op.kind = (DocEditKind.deleteSpan())
        op.paragraphId = sPid
        op.start = sOff
        op.oldText = (this.selectedText())
        ; tail of the first paragraph
        adapter.replaceRange(sPid sOff (adapter.textLength(sPid)) "")
        ; whole paragraphs in between
        def o:int (sOrder + 1)
        while (o < eOrder) {
            def midPid:int (adapter.bodyParagraphIdAt(o))
            adapter.replaceRange(midPid 0 (adapter.textLength(midPid)) "")
            o = (o + 1)
        }
        ; head of the last paragraph
        def eTail:int eOff
        if (eTail > (adapter.textLength(ePid))) {
            eTail = (adapter.textLength(ePid))
        }
        adapter.replaceRange(ePid 0 eTail "")
        ; collapse the now-empty run back into the first paragraph
        def merges:int (eOrder - sOrder)
        def m:int 0
        while (m < merges) {
            def nextPid:int (adapter.bodyParagraphIdAt(sOrder + 1))
            if (nextPid <= 0) {
                m = merges
            } {
                adapter.mergePrevious(nextPid)
                m = (m + 1)
            }
        }
        this.pushUndo(op)
        this.setCaret(sPid sOff)
    }

    fn deleteSelection:void () {
        if (sel.isCollapsed()) {
            return
        }
        if ((sel.sameParagraph()) == false) {
            this.deleteSelectionMulti()
            return
        }
        def pid:int sel.anchor.paragraphId
        def a:int (sel.startOffset())
        def b:int (sel.endOffset())
        def old:string (substring (adapter.getText(pid)) a b)
        def op:DocEditOp (new DocEditOp)
        op.kind = 0
        op.paragraphId = pid
        op.start = a
        op.end = a
        op.oldText = old
        op.newText = ""
        adapter.replaceRange(pid a b "")
        this.pushUndo(op)
        this.setCaret(pid a)
    }

    fn insertText:void (text:string) {
        if ((this.isActive()) == false) {
            return
        }
        if ((strlen text) == 0) {
            return
        }
        if ((sel.sameParagraph()) == false) {
            return
        }
        if ((sel.isCollapsed()) == false) {
            this.deleteSelection()
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        def op:DocEditOp (new DocEditOp)
        op.kind = 0
        op.paragraphId = pid
        op.start = off
        op.end = (off + (strlen text))
        op.oldText = ""
        op.newText = text
        adapter.replaceRange(pid off off text)
        def upTo:int (off + (strlen text))
        if typingBold {
            adapter.applyRun(pid off upTo "bold" true 0.0 "")
        }
        if typingItalic {
            adapter.applyRun(pid off upTo "italic" true 0.0 "")
        }
        if typingUnderline {
            adapter.applyRun(pid off upTo "underline" true 0.0 "")
        }
        this.pushUndo(op)
        this.setCaret(pid (off + (strlen text)))
    }

    fn backspace:void () {
        if ((this.isActive()) == false) {
            return
        }
        if ((sel.sameParagraph()) == false) {
            return
        }
        if ((sel.isCollapsed()) == false) {
            this.deleteSelection()
            return
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        if (off > 0) {
            def old:string (substring (adapter.getText(pid)) (off - 1) off)
            def op:DocEditOp (new DocEditOp)
            op.kind = 0
            op.paragraphId = pid
            op.start = (off - 1)
            op.end = (off - 1)
            op.oldText = old
            op.newText = ""
            adapter.replaceRange(pid (off - 1) off "")
            this.pushUndo(op)
            this.setCaret(pid (off - 1))
            return
        }
        def dest:DocumentPosition (adapter.mergePrevious(pid))
        if (dest.paragraphId > 0) {
            def op2:DocEditOp (new DocEditOp)
            op2.kind = (DocEditKind.mergeParagraph())
            op2.paragraphId = pid
            op2.secondId = dest.paragraphId
            op2.start = dest.textOffset
            this.pushUndo(op2)
            this.setCaret(dest.paragraphId dest.textOffset)
        }
    }

    fn deleteForward:void () {
        if ((this.isActive()) == false) {
            return
        }
        if ((sel.isCollapsed()) == false) {
            this.deleteSelection()
            return
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        def len:int (adapter.textLength(pid))
        if (off < len) {
            def old:string (substring (adapter.getText(pid)) off (off + 1))
            def op:DocEditOp (new DocEditOp)
            op.kind = 0
            op.paragraphId = pid
            op.start = off
            op.end = off
            op.oldText = old
            op.newText = ""
            adapter.replaceRange(pid off (off + 1) "")
            this.pushUndo(op)
            this.setCaret(pid off)
        }
    }

    fn splitAtCaret:void () {
        if ((this.isActive()) == false) {
            return
        }
        if ((sel.isCollapsed()) == false) {
            this.deleteSelection()
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        ; Word: Enter on an empty list item ends the list instead of adding
        ; another empty bullet, so there is a way out of a list from the keyboard.
        def cur:Paragraph (adapter.findParagraph(pid))
        if (cur.listNumId > 0) {
            if ((strlen cur.text) == 0) {
                def op0:DocEditOp (new DocEditOp)
                op0.kind = (DocEditKind.listEnd())
                op0.paragraphId = pid
                op0.start = cur.listNumId
                op0.end = cur.listLevel
                op0.newText = cur.listFmt
                op0.oldText = cur.listText
                op0.secondId = cur.listKind
                this.pushUndo(op0)
                cur.listNumId = 0
                cur.listKind = 0
                cur.listLevel = 0
                cur.listFmt = ""
                cur.listText = ""
                return
            }
        }
        def newId:int (adapter.splitParagraph(pid off))
        def op:DocEditOp (new DocEditOp)
        op.kind = (DocEditKind.splitParagraph())
        op.paragraphId = pid
        op.start = off
        op.secondId = newId
        this.pushUndo(op)
        this.setCaret(newId 0)
    }

    ; --- clipboard paste ------------------------------------------------------
    ; Word's behaviour: the paragraph is split at the caret and the table lands
    ; between the halves, with the caret on the paragraph that follows it.
    fn pasteTable:boolean (tbl:ClipboardTable) {
        if ((this.isActive()) == false) {
            return false
        }
        if ((tbl.rowCount()) == 0) {
            return false
        }
        def pid:int sel.focus.paragraphId
        this.splitAtCaret()
        def afterId:int sel.focus.paragraphId
        def doc:RichDocument (adapter.doc)
        def t:DocumentTable (adapter.insertTableBefore(afterId))
        def cols:int (tbl.columnCount())
        if (cols < 1) {
            cols = 1
        }
        ; Spread the table across the text column, as Word does for a paste.
        def widthPx:int (doc.section.contentWidthPx())
        def totalTwips:int (to_int (((to_double widthPx) * 1440.0) / 96.0))
        def per:int (to_int (totalTwips / cols))
        if (per < 240) {
            per = 240
        }
        clear t.colWidthsTwips
        def ci:int 0
        while (ci < cols) {
            push t.colWidthsTwips per
            ci = (ci + 1)
        }
        def ri:int 0
        while (ri < (tbl.rowCount())) {
            def src:ClipRow (tbl.rowAt(ri))
            def row:DocTableRow (new DocTableRow)
            def cj:int 0
            while (cj < (array_length src.cells)) {
                def sc:ClipCell (itemAt src.cells cj)
                def cell:DocTableCell (new DocTableCell)
                if (sc.gridSpan > 1) {
                    cell.gridSpan = sc.gridSpan
                }
                if ((strlen sc.fillHex) == 6) {
                    cell.fillHex = sc.fillHex
                }
                def p:Paragraph (doc.addParagraphOnly())
                p.styleId = "Normal"
                p.spaceBeforePt = 0.0
                p.spaceAfterPt = 0.0
                p.lineSpacing = 1.0
                if (sc.align == "center") {
                    p.align = 1
                }
                if (sc.align == "right") {
                    p.align = 2
                }
                def span:TextSpan (TextSpan.create(0 0))
                span.bold = sc.bold
                span.fontFamily = typingFont
                p.appendText(sc.text span)
                push cell.paragraphs p
                push row.cells cell
                cj = (cj + 1)
            }
            push t.rows row
            ri = (ri + 1)
        }
        def op:DocEditOp (new DocEditOp)
        op.kind = (DocEditKind.pasteTable())
        op.paragraphId = pid
        op.secondId = afterId
        op.start = t.id
        this.pushUndo(op)
        this.setCaret(afterId 0)
        return true
    }

    ; A chart pasted from the grid. Same shape as a table paste — the paragraph
    ; splits and the chart lands between the halves — but what is inserted is
    ; the chart's own JSON document, not a rendering of it, so it stays
    ; editable here.
    fn pasteChart:int (json:string w:int h:int) {
        if ((this.isActive()) == false) {
            return 0
        }
        if ((strlen json) == 0) {
            return 0
        }
        def pid:int sel.focus.paragraphId
        this.splitAtCaret()
        def afterId:int sel.focus.paragraphId
        def c:DocChart (adapter.insertChartBefore(afterId json))
        if (w > 0) {
            c.widthPx = w
        }
        if (h > 0) {
            c.heightPx = h
        }
        def op:DocEditOp (new DocEditOp)
        op.kind = (DocEditKind.pasteChart())
        op.paragraphId = pid
        op.secondId = afterId
        op.start = c.id
        this.pushUndo(op)
        this.setCaret(afterId 0)
        return c.id
    }

    ; --- editing a chart in the document --------------------------------------
    ; The chart is a Vela document, so an edit is: decode, change one thing,
    ; regenerate the specification through the same generator the spreadsheet
    ; uses, encode again. Nothing here writes a specification by hand.
    fn editChart:boolean (chartId:int what:string arg:string) {
        def c:DocChart (adapter.doc.chartById(chartId))
        if (c.id != chartId) {
            return false
        }
        def doc:ChartDoc (ChartDocCodec.decode(c.json))
        if (doc.ok == false) {
            return false
        }
        def changed:boolean false
        if (what == "kind") {
            def want:int (DocxEditController.intOr(arg doc.chart.kind))
            if (want != doc.chart.kind) {
                if (doc.suits(want)) {
                    doc.chart.kind = want
                    changed = true
                }
            }
        }
        if (what == "kind.next") {
            def step:int (DocxEditController.intOr(arg 1))
            def next:int (DocxEditController.nextSuitable(doc doc.chart.kind step))
            if (next != doc.chart.kind) {
                doc.chart.kind = next
                changed = true
            }
        }
        if (what == "style") {
            def st:int (DocxEditController.intOr(arg doc.chart.style))
            if (st >= (ChartStyle.lowest())) {
                if (st <= (ChartStyle.highest())) {
                    doc.chart.style = st
                    changed = true
                }
            }
        }
        if (what == "style.next") {
            def sstep:int (DocxEditController.intOr(arg 1))
            def ns:int (doc.chart.style + sstep)
            while (ns > (ChartStyle.highest())) {
                ns = (ns - (ChartStyle.highest()))
            }
            while (ns < (ChartStyle.lowest())) {
                ns = (ns + (ChartStyle.highest()))
            }
            doc.chart.style = ns
            changed = true
        }
        if (what == "title") {
            doc.chart.title = arg
            changed = true
        }
        if (what == "legend") {
            doc.chart.showLegend = (doc.chart.showLegend == false)
            changed = true
        }
        if (what == "width") {
            def nw:int (DocxEditController.intOr(arg c.widthPx))
            if (nw >= 120) {
                c.widthPx = nw
                doc.chart.w = nw
                changed = true
            }
        }
        if (what == "height") {
            def nh:int (DocxEditController.intOr(arg c.heightPx))
            if (nh >= 90) {
                c.heightPx = nh
                doc.chart.h = nh
                changed = true
            }
        }
        if (changed == false) {
            return false
        }
        doc.rebuildSpec(c.widthPx c.heightPx)
        c.json = (ChartDocCodec.encode(doc.cells doc.chart))
        return true
    }

    sfn intOr:int (s:string fallback:int) {
        if ((strlen s) == 0) {
            return fallback
        }
        def v@(optional):int (to_int s)
        if v {
            return (unwrap v)
        }
        return fallback
    }

    ; The next kind this chart's own numbers can actually be drawn as. Walking
    ; past the ones that do not suit is what makes "next chart type" a usable
    ; control rather than a way to reach an error message.
    sfn nextSuitable:int (doc:ChartDoc from:int step:int) {
        def dir:int 1
        if (step < 0) {
            dir = -1
        }
        def k:int from
        def guard:int 0
        while (guard < (ChartKind.highest())) {
            k = (k + dir)
            if (k > (ChartKind.highest())) {
                k = (ChartKind.lowest())
            }
            if (k < (ChartKind.lowest())) {
                k = (ChartKind.highest())
            }
            if (doc.suits(k)) {
                return k
            }
            guard = (guard + 1)
        }
        return from
    }

    fn deleteChart:boolean (chartId:int) {
        return (adapter.removeChartBlock(chartId))
    }

    ; Plain text paste: newlines become paragraph splits.
    ; Pasting is ONE action however many primitives it takes. It used to push
    ; one op per line and one per split — three lines were five undos, and
    ; twenty presses still did not get the document back to where it started.
    fn pasteText:boolean (text:string) {
        if ((this.isActive()) == false) {
            return false
        }
        if ((strlen text) == 0) {
            return false
        }
        this.beginAction()
        def ok:boolean (this.pasteLines(text))
        this.endAction()
        return ok
    }

    fn pasteLines:boolean (text:string) {
        def lines:[string] (strsplit text "\n")
        def i:int 0
        def n:int (array_length lines)
        while (i < n) {
            def line:string (itemAt lines i)
            def len:int (strlen line)
            if (len > 0) {
                if ((charAt line (len - 1)) == 13) {
                    line = (substring line 0 (len - 1))
                }
            }
            if ((strlen line) > 0) {
                this.insertText(line)
            }
            if (i < (n - 1)) {
                this.splitAtCaret()
            }
            i = (i + 1)
        }
        return true
    }

    fn toggleBold:void () {
        this.toggleRun("bold")
    }

    ; Bold, italic and underline are the same operation with one field
    ; changed. Writing the second and third out longhand is how the third one
    ; ends up with a subtly different answer for an empty selection.
    fn toggleRun:void (what:string) {
        if ((this.isActive()) == false) {
            return
        }
        if (sel.isCollapsed()) {
            ; Nothing selected: the switch applies to what you type NEXT,
            ; which is what Word does.
            if (what == "bold") {
                typingBold = (typingBold == false)
            }
            if (what == "italic") {
                typingItalic = (typingItalic == false)
            }
            if (what == "underline") {
                typingUnderline = (typingUnderline == false)
            }
            return
        }
        if ((sel.sameParagraph()) == false) {
            this.toggleRunMulti(what)
            return
        }
        def pid:int sel.anchor.paragraphId
        def a:int (sel.startOffset())
        def b:int (sel.endOffset())
        def turnOn:boolean true
        if (adapter.rangeIsOn(pid a b what)) {
            turnOn = false
        }
        adapter.applyRun(pid a b what turnOn 0.0 "")
        this.rememberTyping(what turnOn)
        ; Only bold has an undo op of its own; the others ride the document
        ; snapshot the same way a paste does.
        if (what == "bold") {
            def op:DocEditOp (new DocEditOp)
            op.kind = (DocEditKind.bold())
            op.paragraphId = pid
            op.start = a
            op.end = b
            op.boldSet = true
            op.boldVal = turnOn
            this.pushUndo(op)
        }
    }

    fn rememberTyping:void (what:string on:boolean) {
        if (what == "bold") {
            typingBold = on
        }
        if (what == "italic") {
            typingItalic = on
        }
        if (what == "underline") {
            typingUnderline = on
        }
    }

    ; What the caret is standing in, for a toolbar that has to show it.
    fn caretIsOn:boolean (what:string) {
        if ((this.isActive()) == false) {
            return false
        }
        if (sel.isCollapsed()) {
            if (what == "bold") {
                return typingBold
            }
            if (what == "italic") {
                return typingItalic
            }
            if (what == "underline") {
                return typingUnderline
            }
            return false
        }
        if ((sel.sameParagraph()) == false) {
            return false
        }
        return (adapter.rangeIsOn(sel.anchor.paragraphId (sel.startOffset()) (sel.endOffset()) what))
    }

    ; The face and the size the toolbar should show.
    ;
    ; With something selected that is what the selection is; with nothing
    ; selected it is what you would get if you typed — the typing state, which
    ; is the same rule `caretIsOn` follows for bold. Reading the run under the
    ; caret in both cases made "bigger text" with no selection look like it had
    ; done nothing: the size HAD changed, and the number beside the button
    ; still said what the old letters said.
    fn caretFont:string () {
        if ((this.isActive()) == false) {
            return typingFont
        }
        if (sel.isCollapsed()) {
            return typingFont
        }
        def nm:string (adapter.runFontOf(sel.focus.paragraphId sel.focus.textOffset))
        if ((strlen nm) == 0) {
            return typingFont
        }
        return nm
    }

    fn caretSize:double () {
        if ((this.isActive()) == false) {
            return typingSize
        }
        if (sel.isCollapsed()) {
            return typingSize
        }
        def pt:double (adapter.runSizeOf(sel.focus.paragraphId sel.focus.textOffset))
        if (pt <= 0.0) {
            return typingSize
        }
        return pt
    }

    ; Putting the caret somewhere adopts the run it landed in, so the toolbar
    ; describes the text you are standing in rather than the last thing you
    ; asked for somewhere else.
    fn adoptRunAtCaret:void () {
        if ((this.isActive()) == false) {
            return
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        def nm:string (adapter.runFontOf(pid off))
        if ((strlen nm) > 0) {
            typingFont = nm
        }
        def pt:double (adapter.runSizeOf(pid off))
        if (pt > 0.0) {
            typingSize = pt
        }
        def len:int (adapter.textLength(pid))
        def probeEnd:int (off + 1)
        if (probeEnd > len) {
            probeEnd = len
        }
        if (off < probeEnd) {
            typingBold = (adapter.rangeIsOn(pid off probeEnd "bold"))
            typingItalic = (adapter.rangeIsOn(pid off probeEnd "italic"))
            typingUnderline = (adapter.rangeIsOn(pid off probeEnd "underline"))
        }
    }

    ; A point size or a colour over the selection. Neither is a toggle: there
    ; is a value, and it is applied.
    fn setRunSize:void (pt:double) {
        typingSize = pt
        this.applyToSelection("size" false pt "")
    }

    fn setRunColor:void (hex:string) {
        typingColor = hex
        this.applyToSelection("color" false 0.0 hex)
    }

    fn applyToSelection:void (what:string on:boolean num:double text:string) {
        if ((this.isActive()) == false) {
            return
        }
        if (sel.isCollapsed()) {
            return
        }
        if (sel.sameParagraph()) {
            adapter.applyRun(sel.anchor.paragraphId (sel.startOffset()) (sel.endOffset()) what on num text)
            return
        }
        def a:[int]
        def b:[int]
        this.orderedEnds(a b)
        def sOrder:int (adapter.bodyOrderOf((itemAt a 0)))
        def eOrder:int (adapter.bodyOrderOf((itemAt b 0)))
        if ((sOrder < 0) || (eOrder < 0)) {
            return
        }
        def o:int sOrder
        while (o <= eOrder) {
            def pid:int (adapter.bodyParagraphIdAt(o))
            def len:int (adapter.textLength(pid))
            def x0:int 0
            def x1:int len
            if (o == sOrder) {
                x0 = (itemAt a 1)
            }
            if (o == eOrder) {
                x1 = (itemAt b 1)
            }
            if (x1 > len) {
                x1 = len
            }
            if (x0 < x1) {
                adapter.applyRun(pid x0 x1 what on num text)
            }
            o = (o + 1)
        }
    }

    fn toggleBoldMulti:void () {
        this.toggleRunMulti("bold")
    }

    ; A toggle over a selection that crosses paragraphs: one pass to decide the
    ; new value (Word turns it ON unless the WHOLE selection already has it),
    ; then apply that to each paragraph's slice.
    fn toggleRunMulti:void (what:string) {
        def a:[int]
        def b:[int]
        this.orderedEnds(a b)
        def sPid:int (itemAt a 0)
        def sOff:int (itemAt a 1)
        def ePid:int (itemAt b 0)
        def eOff:int (itemAt b 1)
        def sOrder:int (adapter.bodyOrderOf(sPid))
        def eOrder:int (adapter.bodyOrderOf(ePid))
        if ((sOrder < 0) || (eOrder < 0)) {
            return
        }
        def allOn:boolean true
        def o:int sOrder
        while (o <= eOrder) {
            def pid:int (adapter.bodyParagraphIdAt(o))
            def len:int (adapter.textLength(pid))
            def x0:int 0
            def x1:int len
            if (o == sOrder) {
                x0 = sOff
            }
            if (o == eOrder) {
                x1 = eOff
            }
            if (x1 > len) {
                x1 = len
            }
            if (x0 < x1) {
                if ((adapter.rangeIsOn(pid x0 x1 what)) == false) {
                    allOn = false
                }
            }
            o = (o + 1)
        }
        def turnOn:boolean true
        if allOn {
            turnOn = false
        }
        def o2:int sOrder
        while (o2 <= eOrder) {
            def pid2:int (adapter.bodyParagraphIdAt(o2))
            def len2:int (adapter.textLength(pid2))
            def y0:int 0
            def y1:int len2
            if (o2 == sOrder) {
                y0 = sOff
            }
            if (o2 == eOrder) {
                y1 = eOff
            }
            if (y1 > len2) {
                y1 = len2
            }
            if (y0 < y1) {
                adapter.applyRun(pid2 y0 y1 what turnOn 0.0 "")
            }
            o2 = (o2 + 1)
        }
        this.rememberTyping(what turnOn)
    }

    fn setFont:void (font:string) {
        typingFont = font
        if ((this.isActive()) == false) {
            return
        }
        if (sel.isCollapsed()) {
            return
        }
        if ((sel.sameParagraph()) == false) {
            return
        }
        adapter.applyFont(sel.anchor.paragraphId (sel.startOffset()) (sel.endOffset()) font)
    }

    ; --- caret movement -------------------------------------------------------
    ; `extend` grows the selection from the anchor (Shift+key); otherwise the
    ; selection collapses to the new caret.
    fn placeCaret:void (pid:int off:int extend:boolean) {
        if (pid <= 0) {
            return
        }
        def len:int (adapter.textLength(pid))
        if (off < 0) {
            off = 0
        }
        if (off > len) {
            off = len
        }
        if extend {
            sel.focus = (DocumentPosition.create(pid off))
            active = true
        } {
            this.setCaret(pid off)
        }
    }

    fn moveLeft:void (extend:boolean) {
        if ((this.isActive()) == false) {
            return
        }
        ; Collapsing a selection with a bare Left goes to its start, like Word.
        if ((extend == false) && ((sel.isCollapsed()) == false)) {
            def a:[int]
            def b:[int]
            this.orderedEnds(a b)
            this.setCaret((itemAt a 0) (itemAt a 1))
            return
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        if (off > 0) {
            this.placeCaret(pid (off - 1) extend)
            return
        }
        def order:int (adapter.bodyOrderOf(pid))
        if (order <= 0) {
            return
        }
        def prev:int (adapter.bodyParagraphIdAt(order - 1))
        this.placeCaret(prev (adapter.textLength(prev)) extend)
    }

    fn moveRight:void (extend:boolean) {
        if ((this.isActive()) == false) {
            return
        }
        if ((extend == false) && ((sel.isCollapsed()) == false)) {
            def a:[int]
            def b:[int]
            this.orderedEnds(a b)
            this.setCaret((itemAt b 0) (itemAt b 1))
            return
        }
        def pid:int sel.focus.paragraphId
        def off:int sel.focus.textOffset
        if (off < (adapter.textLength(pid))) {
            this.placeCaret(pid (off + 1) extend)
            return
        }
        def order:int (adapter.bodyOrderOf(pid))
        def count:int (adapter.bodyParagraphCount())
        if (order < 0) {
            return
        }
        if ((order + 1) >= count) {
            return
        }
        def next:int (adapter.bodyParagraphIdAt(order + 1))
        this.placeCaret(next 0 extend)
    }

    ; The visual line holding (paragraphId, offset), searched across every page
    ; so Up/Down and PageUp/PageDown can cross page boundaries. Fills
    ; [pageIndex, lineIndex]; page -1 when the paragraph is not laid out.
    ;
    ; Wrapping can drop trailing characters, so a caret at the very end of a
    ; paragraph may sit past the last laid line. Falling back to that
    ; paragraph's first / last line keeps the caret findable — without it,
    ; Ctrl+End reported "no line" and the view stayed on the wrong page.
    fn findLineFor:void (layout:DocxLayout pid:int off:int out:[int]) {
        clear out
        push out -1
        push out -1
        def firstPage:int -1
        def firstLine:int -1
        def firstStart:int 0
        def lastPage:int -1
        def lastLine:int -1
        def lastEnd:int 0
        def pi:int 0
        while (pi < (layout.pageCount())) {
            def page:LaidPage (layout.pageAt(pi))
            def li:int 0
            while (li < (array_length page.lines)) {
                def line:LaidLine (itemAt page.lines li)
                if (LaidLineKind.isBodyText(line.kind)) {
                    if (line.paraIndex == pid) {
                        if ((off >= line.docStart) && (off <= line.docEnd)) {
                            clear out
                            push out pi
                            push out li
                            return
                        }
                        if (firstPage < 0) {
                            firstPage = pi
                            firstLine = li
                            firstStart = line.docStart
                        }
                        lastPage = pi
                        lastLine = li
                        lastEnd = line.docEnd
                    }
                }
                li = (li + 1)
            }
            pi = (pi + 1)
        }
        if (lastPage < 0) {
            return
        }
        clear out
        if (off < firstStart) {
            push out firstPage
            push out firstLine
            return
        }
        push out lastPage
        push out lastLine
    }

    fn caretLine:void (layout:DocxLayout out:[int]) {
        clear out
        push out -1
        push out -1
        if ((this.isActive()) == false) {
            return
        }
        this.findLineFor(layout sel.focus.paragraphId sel.focus.textOffset out)
    }

    ; Body lines in document order, flattened across pages. Returns the flat
    ; index of the caret's line, or -1.
    ; Lines the caret can occupy, in document order across pages. Picture lines
    ; count when their paragraph holds nothing else, so ↑ / ↓ can step onto a
    ; standalone image and Enter can add a line next to it.
    fn caretStopLine:boolean (line:LaidLine) {
        if (line.paraIndex <= 0) {
            return false
        }
        if (LaidLineKind.isBodyText(line.kind)) {
            return true
        }
        if (line.kind == (LaidLineKind.image())) {
            def p:Paragraph (unwrap line.paragraphRef)
            if ((strlen p.text) == 0) {
                return true
            }
        }
        return false
    }

    fn flatBodyLines:void (layout:DocxLayout outPage:[int] outLine:[int]) {
        clear outPage
        clear outLine
        def pi:int 0
        while (pi < (layout.pageCount())) {
            def page:LaidPage (layout.pageAt(pi))
            def li:int 0
            while (li < (array_length page.lines)) {
                def line:LaidLine (itemAt page.lines li)
                if (this.caretStopLine(line)) {
                    ; An image-only paragraph also emits an empty text line;
                    ; keep just one stop for it.
                    def dup:boolean false
                    if (line.kind == (LaidLineKind.image())) {
                        def k:int 0
                        while (k < (array_length outPage)) {
                            if ((itemAt outPage k) == pi) {
                                def prevPage:LaidPage (layout.pageAt(pi))
                                def prevLine:LaidLine (itemAt prevPage.lines (itemAt outLine k))
                                if (prevLine.paraIndex == line.paraIndex) {
                                    dup = true
                                }
                            }
                            k = (k + 1)
                        }
                    }
                    if (dup == false) {
                        push outPage pi
                        push outLine li
                    }
                }
                li = (li + 1)
            }
            pi = (pi + 1)
        }
    }

    fn flatIndexOfCaret:int (layout:DocxLayout pages:[int] lines:[int]) {
        def cur:[int]
        this.caretLine(layout cur)
        def cp:int (itemAt cur 0)
        def cl:int (itemAt cur 1)
        if (cp < 0) {
            return -1
        }
        def i:int 0
        while (i < (array_length pages)) {
            if (((itemAt pages i) == cp) && ((itemAt lines i) == cl)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Put the caret on `line` at the horizontal position `wantX` (screen px).
    fn caretToLineAtX:void (layout:DocxLayout line:LaidLine wantX:int extend:boolean) {
        def p:Paragraph (unwrap line.paragraphRef)
        if (p.id <= 0) {
            return
        }
        def tr:UITextRenderer (unwrap layout.tr)
        def fontPx:double line.fontSizePx
        def localX:int (wantX - line.x)
        if (localX < 0) {
            localX = 0
        }
        def display:string line.text
        if ((strlen line.listPrefix) > 0) {
            if ((indexOf display line.listPrefix) == 0) {
                localX = (localX - (DocxTextMetrics.measurePlain(tr line.listPrefix fontPx line.bold)))
                if (localX < 0) {
                    localX = 0
                }
            }
        }
        def off:int (DocxTextMetrics.offsetAtX(tr p fontPx line.docStart line.docEnd localX))
        this.placeCaret(p.id off extend)
    }

    ; Vertical movement by `delta` visual lines, keeping the caret's X. Crossing
    ; a page boundary is just another step in the flattened line list.
    fn moveVertical:void (layout:DocxLayout delta:int extend:boolean) {
        if ((this.isActive()) == false) {
            return
        }
        def pages:[int]
        def lines:[int]
        this.flatBodyLines(layout pages lines)
        def total:int (array_length pages)
        if (total == 0) {
            return
        }
        def at:int (this.flatIndexOfCaret(layout pages lines))
        if (at < 0) {
            return
        }
        def wantX:int (this.caretPixelX(layout (itemAt pages at)))
        if (wantX < 0) {
            def curPage:LaidPage (layout.pageAt((itemAt pages at)))
            def curLine:LaidLine (itemAt curPage.lines (itemAt lines at))
            wantX = curLine.x
        }
        def target:int (at + delta)
        if (target < 0) {
            target = 0
        }
        if (target >= total) {
            target = (total - 1)
        }
        if (target == at) {
            ; Already at the edge: snap to the start / end of the document.
            def edgePage:LaidPage (layout.pageAt((itemAt pages at)))
            def edgeLine:LaidLine (itemAt edgePage.lines (itemAt lines at))
            def p0:Paragraph (unwrap edgeLine.paragraphRef)
            if (delta < 0) {
                this.placeCaret(p0.id edgeLine.docStart extend)
            } {
                this.placeCaret(p0.id edgeLine.docEnd extend)
            }
            return
        }
        def tPage:LaidPage (layout.pageAt((itemAt pages target)))
        def tLine:LaidLine (itemAt tPage.lines (itemAt lines target))
        this.caretToLineAtX(layout tLine wantX extend)
    }

    fn moveUp:void (layout:DocxLayout extend:boolean) {
        this.moveVertical(layout -1 extend)
    }

    fn moveDown:void (layout:DocxLayout extend:boolean) {
        this.moveVertical(layout 1 extend)
    }

    ; Lines a PageUp / PageDown step covers: the caret's page, minus one line of
    ; overlap so the line you were reading stays visible.
    fn linesPerPage:int (layout:DocxLayout) {
        def cur:[int]
        this.caretLine(layout cur)
        def cp:int (itemAt cur 0)
        if (cp < 0) {
            cp = 0
        }
        if (cp >= (layout.pageCount())) {
            return 1
        }
        def page:LaidPage (layout.pageAt(cp))
        def count:int 0
        def li:int 0
        while (li < (array_length page.lines)) {
            def line:LaidLine (itemAt page.lines li)
            if (LaidLineKind.isBodyText(line.kind)) {
                if (line.paraIndex > 0) {
                    count = (count + 1)
                }
            }
            li = (li + 1)
        }
        if (count > 1) {
            count = (count - 1)
        }
        if (count < 1) {
            count = 1
        }
        return count
    }

    fn pageUp:void (layout:DocxLayout extend:boolean) {
        this.moveVertical(layout (0 - (this.linesPerPage(layout))) extend)
    }

    fn pageDown:void (layout:DocxLayout extend:boolean) {
        this.moveVertical(layout (this.linesPerPage(layout)) extend)
    }

    ; Home / End work on the VISUAL line, so a wrapped paragraph behaves the way
    ; it looks rather than jumping to the paragraph ends.
    fn moveLineEdge:void (layout:DocxLayout toEnd:boolean extend:boolean) {
        if ((this.isActive()) == false) {
            return
        }
        def cur:[int]
        this.caretLine(layout cur)
        def cp:int (itemAt cur 0)
        def cl:int (itemAt cur 1)
        if (cp < 0) {
            def pid:int sel.focus.paragraphId
            if toEnd {
                this.placeCaret(pid (adapter.textLength(pid)) extend)
            } {
                this.placeCaret(pid 0 extend)
            }
            return
        }
        def page:LaidPage (layout.pageAt(cp))
        def line:LaidLine (itemAt page.lines cl)
        def p:Paragraph (unwrap line.paragraphRef)
        if toEnd {
            this.placeCaret(p.id line.docEnd extend)
        } {
            this.placeCaret(p.id line.docStart extend)
        }
    }

    fn moveDocEdge:void (toEnd:boolean extend:boolean) {
        if ((this.isActive()) == false) {
            return
        }
        def count:int (adapter.bodyParagraphCount())
        if (count == 0) {
            return
        }
        if toEnd {
            def lastId:int (adapter.bodyParagraphIdAt(count - 1))
            this.placeCaret(lastId (adapter.textLength(lastId)) extend)
        } {
            this.placeCaret((adapter.bodyParagraphIdAt(0)) 0 extend)
        }
    }

    ; --- Tab: move between table cells ---------------------------------------
    ; Word's Tab in a table steps to the next cell and SELECTS its contents, so
    ; typing replaces them; Shift+Tab steps back. Wrapping past the last cell of
    ; a row continues on the next row, and past the last cell of the table it
    ; leaves for the paragraph after it.
    fn selectCellContents:void (pid:int) {
        if (pid <= 0) {
            return
        }
        def len:int (adapter.textLength(pid))
        sel.anchor = (DocumentPosition.create(pid 0))
        sel.focus = (DocumentPosition.create(pid len))
        active = true
    }

    fn inTable:boolean () {
        if ((this.isActive()) == false) {
            return false
        }
        def at:[int]
        adapter.tableCellOf(sel.focus.paragraphId at)
        return ((itemAt at 0) >= 0)
    }

    ; Returns true when the Tab was consumed as cell navigation.
    fn tabCell:boolean (forward:boolean) {
        if ((this.isActive()) == false) {
            return false
        }
        def at:[int]
        adapter.tableCellOf(sel.focus.paragraphId at)
        def blk:int (itemAt at 0)
        if (blk < 0) {
            ; Not in a table. Tab just before one steps into its first cell,
            ; Shift+Tab just after one into its last — otherwise leave it alone.
            def pid:int sel.focus.paragraphId
            if forward {
                def nextTbl:int (adapter.tableBlockAfterParagraph(pid))
                if (nextTbl >= 0) {
                    def firstId:int (adapter.cellParagraphId(nextTbl 0 0))
                    if (firstId > 0) {
                        this.selectCellContents(firstId)
                        return true
                    }
                }
                return false
            }
            def prevTbl:int (adapter.tableBlockBeforeParagraph(pid))
            if (prevTbl >= 0) {
                def lastRow:int ((adapter.rowCountOfTable(prevTbl)) - 1)
                def lastCell:int ((adapter.cellCountInRow(prevTbl lastRow)) - 1)
                def lastId:int (adapter.cellParagraphId(prevTbl lastRow lastCell))
                if (lastId > 0) {
                    this.selectCellContents(lastId)
                    return true
                }
            }
            return false
        }
        def row:int (itemAt at 1)
        def cell:int (itemAt at 2)
        def rows:int (adapter.rowCountOfTable(blk))
        if forward {
            def nextCell:int (cell + 1)
            def nextRow:int row
            if (nextCell >= (adapter.cellCountInRow(blk row))) {
                nextCell = 0
                nextRow = (row + 1)
            }
            if (nextRow >= rows) {
                ; Word never tabs out the bottom of a table: it adds a row.
                def added:int (adapter.appendTableRow(blk))
                if (added <= 0) {
                    return true
                }
                def op:DocEditOp (new DocEditOp)
                op.kind = (DocEditKind.tableRow())
                op.start = blk
                this.pushUndo(op)
                def newId:int (adapter.cellParagraphId(blk (added - 1) 0))
                if (newId > 0) {
                    this.setCaret(newId 0)
                }
                return true
            }
            def nid:int (adapter.cellParagraphId(blk nextRow nextCell))
            if (nid > 0) {
                this.selectCellContents(nid)
            }
            return true
        }
        def prevCell:int (cell - 1)
        def prevRow:int row
        if (prevCell < 0) {
            prevRow = (row - 1)
            if (prevRow >= 0) {
                prevCell = ((adapter.cellCountInRow(blk prevRow)) - 1)
            }
        }
        if (prevRow < 0) {
            def before:int (adapter.bodyParagraphBeforeBlock(blk))
            if (before > 0) {
                this.setCaret(before (adapter.textLength(before)))
                return true
            }
            return true
        }
        def pid2:int (adapter.cellParagraphId(blk prevRow prevCell))
        if (pid2 > 0) {
            this.selectCellContents(pid2)
        }
        return true
    }

    fn selectAll:void () {
        def count:int (adapter.bodyParagraphCount())
        if (count == 0) {
            return
        }
        def firstId:int (adapter.bodyParagraphIdAt(0))
        def lastId:int (adapter.bodyParagraphIdAt(count - 1))
        sel.anchor = (DocumentPosition.create(firstId 0))
        sel.focus = (DocumentPosition.create(lastId (adapter.textLength(lastId))))
        active = true
    }

    ; --- undo and redo, which are ONE function with a direction ---------------
    ;
    ; They used to be two switches over `op.kind`, and they drifted: `undo`
    ; knew five kinds and `redo` knew one. Redo of anything else did nothing to
    ; the document — and pushed the op back onto the undo stack anyway, so the
    ; NEXT undo ran it a second time and invented text that had never been
    ; there. Written as one function that cannot happen: a kind is handled in
    ; both directions or in neither.
    fn applyOp:boolean (op:DocEditOp forward:boolean) {
        if (op.kind == (DocEditKind.text())) {
            if forward {
                adapter.replaceRange(op.paragraphId op.start (op.start + (strlen op.oldText)) op.newText)
                this.setCaret(op.paragraphId (op.start + (strlen op.newText)))
            } {
                adapter.replaceRange(op.paragraphId op.start (op.start + (strlen op.newText)) op.oldText)
                this.setCaret(op.paragraphId (op.start + (strlen op.oldText)))
            }
            return true
        }
        if (op.kind == (DocEditKind.listEnd())) {
            def lp:Paragraph (adapter.findParagraph(op.paragraphId))
            if forward {
                ; Ending the list again: clear what undo put back.
                lp.listNumId = 0
                lp.listKind = 0
                lp.listLevel = 0
                lp.listFmt = ""
                lp.listText = ""
            } {
                ; Restore the list membership that "Enter on an empty item"
                ; cleared.
                lp.listNumId = op.start
                lp.listLevel = op.end
                lp.listFmt = op.newText
                lp.listText = op.oldText
                lp.listKind = op.secondId
            }
            this.setCaret(op.paragraphId 0)
            return true
        }
        if (op.kind == (DocEditKind.tableRow())) {
            def blkIdx:int op.start
            if forward {
                def added:int (adapter.appendTableRow(blkIdx))
                if (added > 0) {
                    def firstId:int (adapter.cellParagraphId(blkIdx (added - 1) 0))
                    if (firstId > 0) {
                        this.setCaret(firstId 0)
                    }
                }
                return true
            }
            ; Undo the row Tab appended, and step back into the last cell.
            if (adapter.removeLastTableRow(blkIdx)) {
                def lastRow:int ((adapter.rowCountOfTable(blkIdx)) - 1)
                def lastCell:int ((adapter.cellCountInRow(blkIdx lastRow)) - 1)
                def backId:int (adapter.cellParagraphId(blkIdx lastRow lastCell))
                if (backId > 0) {
                    this.setCaret(backId (adapter.textLength(backId)))
                }
            }
            return true
        }
        if (op.kind == (DocEditKind.deleteSpan())) {
            suppressUndo = true
            if forward {
                ; Delete the span again: select exactly what undo put back and
                ; drop it, which is the same primitive the original edit used.
                this.setCaret(op.paragraphId op.start)
                this.selectForward(op.oldText)
                this.deleteSelection()
            } {
                ; Put the text back, newlines re-splitting.
                this.setCaret(op.paragraphId op.start)
                this.pasteText(op.oldText)
                this.setCaret(op.paragraphId op.start)
            }
            suppressUndo = false
            return true
        }
        if (op.kind == (DocEditKind.splitParagraph())) {
            if forward {
                ; The SAME id back, not a fresh one: the ops after this in the
                ; same action still name the paragraph this split created.
                def again:int (adapter.splitParagraphAs(op.paragraphId op.start op.secondId))
                op.secondId = again
                this.setCaret(again 0)
            } {
                ; Rejoin the two halves. Enter used to record a kind NOTHING
                ; could undo — neither direction knew a 1 — so pressing it
                ; made an op that stopped every undo below it dead.
                def joined:DocumentPosition (adapter.mergePrevious(op.secondId))
                if (joined.paragraphId > 0) {
                    this.setCaret(joined.paragraphId joined.textOffset)
                }
            }
            return true
        }
        if (op.kind == (DocEditKind.mergeParagraph())) {
            if forward {
                def dest2:DocumentPosition (adapter.mergePrevious(op.paragraphId))
                if (dest2.paragraphId > 0) {
                    this.setCaret(dest2.paragraphId dest2.textOffset)
                }
            } {
                ; Split them apart again where the join fell, with the id the
                ; paragraph had before the merge.
                def re:int (adapter.splitParagraphAs(op.secondId op.start op.paragraphId))
                op.paragraphId = re
                this.setCaret(re 0)
            }
            return true
        }
        if (op.kind == (DocEditKind.bold())) {
            ; What the op records is what bold was turned TO, so the inverse is
            ; turning it the other way. A range that was MIXED before the
            ; toggle comes back uniform rather than mixed — the op would have
            ; to carry the run boundaries to do better, and it does not.
            def want:boolean op.boldVal
            if (forward == false) {
                want = (op.boldVal == false)
            }
            adapter.applyRun(op.paragraphId op.start op.end "bold" want 0.0 "")
            return true
        }
        if (op.kind == (DocEditKind.pasteTable())) {
            if forward {
                ; The table's content is gone once undo removed it, so a redo
                ; that pretended otherwise would put an empty table back.
                ; Refusing is the honest answer, and refusing WITHOUT moving
                ; the op is what keeps the two stacks in step.
                return false
            }
            adapter.removeTableById(op.start)
            def back:DocumentPosition (adapter.mergePrevious(op.secondId))
            if (back.paragraphId > 0) {
                this.setCaret(back.paragraphId back.textOffset)
            } {
                this.setCaret(op.paragraphId (adapter.textLength(op.paragraphId)))
            }
            return true
        }
        if (op.kind == (DocEditKind.pasteChart())) {
            if forward {
                return false
            }
            ; A chart paste is the same shape as a table paste: the chart goes,
            ; and the paragraph it split rejoins. This used to record itself as
            ; a multi-paragraph DELETE — 5, one more than the table's 4 — so
            ; undo ran the delete's restore path and the chart stayed.
            adapter.removeChartBlock(op.start)
            def cback:DocumentPosition (adapter.mergePrevious(op.secondId))
            if (cback.paragraphId > 0) {
                this.setCaret(cback.paragraphId cback.textOffset)
            } {
                this.setCaret(op.paragraphId (adapter.textLength(op.paragraphId)))
            }
            return true
        }
        return false
    }

    ; Select `text` forward from the caret, across paragraph breaks.
    fn selectForward:void (text:string) {
        def steps:int (strlen text)
        def i:int 0
        while (i < steps) {
            this.moveRight(true)
            i = (i + 1)
        }
    }

    ; One press of undo is one ACTION: the top op, and every op below it that
    ; was stamped with the same transaction.
    fn undo:void () {
        if ((history.canUndo()) == false) {
            return
        }
        def span:int (history.undoSpan())
        def moved:int 0
        while (moved < span) {
            def top:DocEditOp (history.peekUndo())
            if ((this.applyOp(top false)) == false) {
                ; An op that could not be undone stays where it is. Moving it
                ; anyway is how the two stacks come apart.
                return
            }
            history.moveUndoToRedo()
            moved = (moved + 1)
        }
    }

    fn redo:void () {
        if ((history.canRedo()) == false) {
            return
        }
        def span:int (history.redoSpan())
        def moved:int 0
        while (moved < span) {
            def top:DocEditOp (history.peekRedo())
            if ((this.applyOp(top true)) == false) {
                return
            }
            history.moveRedoToUndo()
            moved = (moved + 1)
        }
    }

    ; Hit-test using laid lines on the current page (same metrics as paint).
    ; Prefer the line whose content box contains (x,y). Y-only matching used to
    ; pick the last table-cell line on a row (always the rightmost column).
    fn hitTest:DocumentPosition (layout:DocxLayout pageIndex:int x:int y:int) {
        def miss:DocumentPosition (DocumentPosition.create(0 0))
        if ((pageIndex < 0) || (pageIndex >= (layout.pageCount()))) {
            return miss
        }
        def page:LaidPage (layout.pageAt(pageIndex))
        def best:LaidLine
        def found:boolean false
        def bestBoxW:int 1000000
        def i:int 0
        while (i < (array_length page.lines)) {
            def line:LaidLine (itemAt page.lines i)
            if (LaidLineKind.isBodyText(line.kind)) {
                def bw:int line.boxW
                if (bw < 4) {
                    bw = line.width
                }
                if (bw < 4) {
                    bw = 4
                }
                def bx:int line.boxX
                if ((y >= line.y) && (y < (line.y + line.height))) {
                    if ((x >= bx) && (x < (bx + bw))) {
                        ; Innermost box wins when boxes nest / overlap.
                        if ((found == false) || (bw <= bestBoxW)) {
                            best = line
                            found = true
                            bestBoxW = bw
                        }
                    }
                }
            }
            i = (i + 1)
        }
        ; Clicking the picture itself puts the caret in the paragraph that owns
        ; it — before it on the left half, after it on the right — so there is a
        ; way to land next to an image and press Enter. Only when no text line
        ; already claimed the point.
        if (found == false) {
            def ii:int 0
            while (ii < (array_length page.lines)) {
                def imgLine:LaidLine (itemAt page.lines ii)
                if (imgLine.kind == (LaidLineKind.image())) {
                    if ((y >= imgLine.y) && (y < (imgLine.y + imgLine.height))) {
                        if ((x >= imgLine.x) && (x < (imgLine.x + imgLine.width))) {
                            def ip:Paragraph (unwrap imgLine.paragraphRef)
                            if (ip.id > 0) {
                                def half:int (imgLine.x + (idiv imgLine.width 2))
                                if (x < half) {
                                    return (DocumentPosition.create(ip.id 0))
                                }
                                return (DocumentPosition.create(ip.id (strlen ip.text)))
                            }
                        }
                    }
                }
                ii = (ii + 1)
            }
        }
        if (found == false) {
            ; Nearest body line by distance to its content box (2D).
            def bestDist:int 1000000
            def j:int 0
            while (j < (array_length page.lines)) {
                def line2:LaidLine (itemAt page.lines j)
                if (LaidLineKind.isBodyText(line2.kind)) {
                    def bw2:int line2.boxW
                    if (bw2 < 4) {
                        bw2 = line2.width
                    }
                    if (bw2 < 4) {
                        bw2 = 4
                    }
                    def bx2:int line2.boxX
                    def by2:int line2.y
                    def bh2:int line2.height
                    def dx:int 0
                    if (x < bx2) {
                        dx = (bx2 - x)
                    } {
                        if (x >= (bx2 + bw2)) {
                            dx = (x - ((bx2 + bw2) - 1))
                        }
                    }
                    def dy:int 0
                    if (y < by2) {
                        dy = (by2 - y)
                    } {
                        if (y >= (by2 + bh2)) {
                            dy = (y - ((by2 + bh2) - 1))
                        }
                    }
                    def d:int ((dx * dx) + (dy * dy))
                    if (d < bestDist) {
                        bestDist = d
                        best = line2
                        found = true
                    }
                }
                j = (j + 1)
            }
        }
        if (found == false) {
            return miss
        }
        def p:Paragraph (unwrap best.paragraphRef)
        if (p.id <= 0) {
            return miss
        }
        def tr:UITextRenderer (unwrap layout.tr)
        def fontPx:double best.fontSizePx
        if (fontPx < 8.0) {
            fontPx = 8.0
        }
        ; Map x → offset within this visual line, then to document offset.
        def localX:int (x - best.x)
        if (localX < 0) {
            localX = 0
        }
        def display:string best.text
        def prefixLen:int 0
        if ((strlen best.listPrefix) > 0) {
            if ((indexOf display best.listPrefix) == 0) {
                prefixLen = (strlen best.listPrefix)
            }
        }
        if (prefixLen > 0) {
            localX = (localX - (DocxTextMetrics.measurePlain(tr (substring display 0 prefixLen) fontPx best.bold)))
            if (localX < 0) {
                localX = 0
            }
        }
        ; Measure through the same per-span faces the painter used, so a click
        ; inside a bold run lands on the character under the pointer.
        def docOff:int (DocxTextMetrics.offsetAtX(tr p fontPx best.docStart best.docEnd localX))
        def plen:int (strlen p.text)
        if (docOff > plen) {
            docOff = plen
        }
        if (docOff < 0) {
            docOff = 0
        }
        return (DocumentPosition.create(p.id docOff))
    }

    ; --- caret geometry -------------------------------------------------------
    ; All three share findLineFor, so the caret, its height and the selection
    ; agree about which line the caret is on — including a caret past the last
    ; laid character of a paragraph.
    fn caretPixelX:int (layout:DocxLayout pageIndex:int) {
        if ((this.isActive()) == false) {
            return -1
        }
        def at:[int]
        this.caretLine(layout at)
        if ((itemAt at 0) != pageIndex) {
            return -1
        }
        def page:LaidPage (layout.pageAt(pageIndex))
        def line:LaidLine (itemAt page.lines (itemAt at 1))
        def c:DocumentPosition (this.caret())
        def tr:UITextRenderer (unwrap layout.tr)
        def fontPx:double line.fontSizePx
        def display:string line.text
        def x:int line.x
        if ((strlen line.listPrefix) > 0) {
            if ((indexOf display line.listPrefix) == 0) {
                x = (x + (DocxTextMetrics.measurePlain(tr line.listPrefix fontPx line.bold)))
            }
        }
        def upTo:int c.textOffset
        if (upTo > line.docEnd) {
            upTo = line.docEnd
        }
        if (upTo < line.docStart) {
            upTo = line.docStart
        }
        def para:Paragraph (unwrap line.paragraphRef)
        x = (x + (DocxTextMetrics.measureRange(tr para fontPx line.docStart upTo)))
        return x
    }

    fn caretPixelY:int (layout:DocxLayout pageIndex:int) {
        if ((this.isActive()) == false) {
            return -1
        }
        def at:[int]
        this.caretLine(layout at)
        if ((itemAt at 0) != pageIndex) {
            return -1
        }
        def page:LaidPage (layout.pageAt(pageIndex))
        def line:LaidLine (itemAt page.lines (itemAt at 1))
        return line.y
    }

    fn caretHeight:int (layout:DocxLayout pageIndex:int) {
        if ((this.isActive()) == false) {
            return 14
        }
        def at:[int]
        this.caretLine(layout at)
        if ((itemAt at 0) != pageIndex) {
            return 14
        }
        def page:LaidPage (layout.pageAt(pageIndex))
        def line:LaidLine (itemAt page.lines (itemAt at 1))
        return line.height
    }
}

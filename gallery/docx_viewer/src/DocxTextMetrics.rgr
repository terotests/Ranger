; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; DocxTextMetrics - ONE measurement authority for paragraph text.
; ==============================================================================
;
; The painter draws a visual line run by run, switching the font face per
; TextSpan (regular vs bold). Anything that asks "how far along the line is
; offset N?" — caret X, click hit-test, selection rectangles — has to measure
; the SAME way, or a click inside a bold run lands on the wrong character and
; the selection box stops short of the glyphs it is meant to cover.
;
; Every one of those callers goes through here, so paint and measure cannot
; drift apart. Face selection mirrors DocxView.setPaintFace exactly.
;
; Note: like the painter, a run is measured at the visual line's size. Per-span
; font SIZE is not honoured yet — layout wraps the paragraph at one size, so
; measuring at another would put the caret outside the painted text. Per-span
; FAMILY is not honoured for the same reason: `tr.wrap` breaks the paragraph in
; one face, and measuring the pieces in another would put the line ends
; somewhere the breaks are not.
;
; ITALIC now is. It used to be neither measured nor painted: `applyFace` took
; one argument, `bold`, so every italic run in every document opened here was
; drawn upright — and Word's italic button and its Ctrl+I changed the model and
; nothing on the page. The face naming and the walk when a face is missing are
; `OfficeFont`'s, shared with the .pptx reader.
; ==============================================================================

Import "RichDocument.rgr"
Import "../../game_engine/ui/UITextRenderer.rgr"
Import "../../office/text/OfficeFont.rgr"

class DocxTextMetrics {
    ; Select the face for the next draw or measure.
    ;
    ; It must go through `fontFamily`, NOT tr.rt.setFont: UITextRenderer calls
    ; applyFace() at the top of measureWidth / wrap / getCachedLine, which resets
    ; the rasterizer from `fontFamily`. Poking rt directly is undone by the very
    ; next call — which is why bold runs used to be measured, and drawn, in the
    ; regular face. The raster cache key already includes fontFamily, so no cache
    ; flush is needed here.
    ; The family this reader draws with. Per-span families are parsed and kept
    ; on the model; honouring them here needs the wrap path to honour them too,
    ; which is the next piece of work rather than this one.
    sfn family:string () {
        return "Open Sans"
    }

    sfn applyFace:void (tr:UITextRenderer bold:boolean) {
        DocxTextMetrics.applyStyle(tr bold false)
    }

    sfn applyStyle:void (tr:UITextRenderer bold:boolean italic:boolean) {
        def fam:string (DocxTextMetrics.family())
        OfficeFont.apply(tr fam bold italic fam)
    }

    sfn safeSize:double (px:double) {
        if (px < 8.0) {
            return 8.0
        }
        return px
    }

    ; The span covering `off`, or the nearest one. Spans are half-open
    ; [start,end); an offset past the last span belongs to the last span, which
    ; is what puts a caret at the end of a paragraph in the style of the text
    ; in front of it.
    sfn spanAt@(optional):TextSpan (p:Paragraph off:int) {
        def i:int 0
        def n:int (array_length p.spans)
        while (i < n) {
            def sp:TextSpan (itemAt p.spans i)
            if ((off >= sp.start) && (off < sp.end)) {
                def hit@(optional):TextSpan sp
                return hit
            }
            i = (i + 1)
        }
        if (n > 0) {
            def last:TextSpan (itemAt p.spans (n - 1))
            if (off >= last.end) {
                def lastHit@(optional):TextSpan last
                return lastHit
            }
            def firstHit@(optional):TextSpan (itemAt p.spans 0)
            return firstHit
        }
        def none@(optional):TextSpan
        return none
    }

    ; Is the character at `off` painted bold?
    sfn boldAt:boolean (p:Paragraph off:int) {
        def hit@(optional):TextSpan (DocxTextMetrics.spanAt(p off))
        if (null? hit) {
            return false
        }
        def sp:TextSpan (unwrap hit)
        return sp.bold
    }

    ; ...and slanted? This is what was missing: without it a run switched face
    ; only where the WEIGHT changed, so an italic word inside plain text was
    ; measured and drawn in the same upright face as its neighbours.
    sfn italicAt:boolean (p:Paragraph off:int) {
        def hit@(optional):TextSpan (DocxTextMetrics.spanAt(p off))
        if (null? hit) {
            return false
        }
        def sp:TextSpan (unwrap hit)
        return sp.italic
    }

    ; One number for "which face draws this character", so a run break can be
    ; a single comparison rather than one per style bit — and so a bit added
    ; later cannot be forgotten in one of the two walks below.
    sfn faceKeyAt:int (p:Paragraph off:int) {
        def key:int 0
        if (DocxTextMetrics.boldAt(p off)) {
            key = (key + 1)
        }
        if (DocxTextMetrics.italicAt(p off)) {
            key = (key + 2)
        }
        return key
    }

    sfn keyBold:boolean (key:int) {
        return ((key % 2) == 1)
    }

    sfn keyItalic:boolean (key:int) {
        return (((idiv key 2) % 2) == 1)
    }

    ; Width of p.text[from,to) as painted: contiguous same-face runs, each
    ; measured with that face active.
    sfn measureRange:int (tr:UITextRenderer p:Paragraph linePx:double from:int to:int) {
        def size:double (DocxTextMetrics.safeSize(linePx))
        def len:int (strlen p.text)
        def a:int from
        def b:int to
        if (a < 0) {
            a = 0
        }
        if (b > len) {
            b = len
        }
        if (a >= b) {
            return 0
        }
        def total:int 0
        def runStart:int a
        def runKey:int (DocxTextMetrics.faceKeyAt(p a))
        def i:int (a + 1)
        while (i <= b) {
            def atEnd:boolean (i == b)
            def key:int runKey
            if (atEnd == false) {
                key = (DocxTextMetrics.faceKeyAt(p i))
            }
            if (atEnd || (key != runKey)) {
                DocxTextMetrics.applyStyle(tr (DocxTextMetrics.keyBold(runKey)) (DocxTextMetrics.keyItalic(runKey)))
                total = (total + (to_int (tr.measureWidth((substring p.text runStart i) size))))
                runStart = i
                runKey = key
            }
            i = (i + 1)
        }
        return total
    }

    ; Inverse of measureRange: the offset in [from,to] whose painted position is
    ; nearest targetX (measured from the start of `from`). Splits on glyph
    ; midpoints so a click lands on the closer side of a character.
    sfn offsetAtX:int (tr:UITextRenderer p:Paragraph linePx:double from:int to:int targetX:int) {
        def len:int (strlen p.text)
        def a:int from
        def b:int to
        if (a < 0) {
            a = 0
        }
        if (b > len) {
            b = len
        }
        if (a >= b) {
            return a
        }
        if (targetX <= 0) {
            return a
        }
        def size:double (DocxTextMetrics.safeSize(linePx))
        def acc:int 0
        def runStart:int a
        def runKey:int (DocxTextMetrics.faceKeyAt(p a))
        def i:int (a + 1)
        while (i <= b) {
            def atEnd:boolean (i == b)
            def key:int runKey
            if (atEnd == false) {
                key = (DocxTextMetrics.faceKeyAt(p i))
            }
            if (atEnd || (key != runKey)) {
                DocxTextMetrics.applyStyle(tr (DocxTextMetrics.keyBold(runKey)) (DocxTextMetrics.keyItalic(runKey)))
                def runW:int (to_int (tr.measureWidth((substring p.text runStart i) size)))
                if (targetX < (acc + runW)) {
                    ; Inside this run — walk it with the run's own face.
                    def k:int runStart
                    while (k < i) {
                        def w0:int (to_int (tr.measureWidth((substring p.text runStart k) size)))
                        def w1:int (to_int (tr.measureWidth((substring p.text runStart (k + 1)) size)))
                        def mid:int (idiv ((acc + w0) + (acc + w1)) 2)
                        if (targetX < mid) {
                            return k
                        }
                        k = (k + 1)
                    }
                    return i
                }
                acc = (acc + runW)
                runStart = i
                runKey = key
            }
            i = (i + 1)
        }
        return b
    }

    ; List markers / chrome are painted with the line's own face, not a span.
    sfn measurePlain:int (tr:UITextRenderer text:string linePx:double bold:boolean) {
        return (DocxTextMetrics.measureStyled(tr text linePx bold false))
    }

    sfn measureStyled:int (tr:UITextRenderer text:string linePx:double bold:boolean italic:boolean) {
        if ((strlen text) == 0) {
            return 0
        }
        DocxTextMetrics.applyStyle(tr bold italic)
        return (to_int (tr.measureWidth(text (DocxTextMetrics.safeSize(linePx)))))
    }
}

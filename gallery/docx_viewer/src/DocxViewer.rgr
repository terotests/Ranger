; ==============================================================================
; DocxViewer - load .docx → RichDocument → SoftCanvas pages (+ optional edit).
; ==============================================================================

Import "DocxPackage.rgr"
Import "WordMlParser.rgr"
Import "WordNumbering.rgr"
Import "RichDocument.rgr"
Import "DocxView.rgr"
Import "DocxEditController.rgr"
Import "ClipboardTable.rgr"
Import "../../datagrid/src/ChartDoc.rgr"
Import "../../text_editor/src/TextEditCore.rgr"

class DocxViewer {
    def parser:WordMlParser (new WordMlParser)
    def view:DocxView (new DocxView)
    def doc:RichDocument (new RichDocument)
    def numbering:WordNumbering (new WordNumbering)
    def edit:DocxEditController (new DocxEditController)
    def lastError:string ""
    def currentPage:int 0
    ; How far down the current page the window is looking, in scene pixels.
    ;
    ; The viewer had no such thing: a scroll gesture only ever TURNED PAGES,
    ; so a document could not be read down. A trackpad flick jumped a whole
    ; page and everything between the two positions went past unseen, which is
    ; not slow scrolling — it is no scrolling at all.
    def scrollY:int 0
    ; How tall the window is that is looking at the page. The host sets it;
    ; without it there is nothing to say how far down a page can be scrolled
    ; before the bottom of the paper is on screen.
    def viewportH:int 0

    Constructor () {
    }

    fn init:void (fontDir:string) {
        view.init(fontDir)
    }

    fn openFile:boolean (dir:string file:string) {
        lastError = ""
        def pkg:DocxPackage (new DocxPackage)
        if ((pkg.open(dir file)) == false) {
            lastError = ("failed to open " + file)
            return false
        }
        if ((pkg.hasPart("word/document.xml")) == false) {
            lastError = "missing word/document.xml"
            pkg.close()
            return false
        }
        doc = (parser.parsePackage(pkg))
        numbering = parser.numbering
        pkg.close()
        if ((strlen doc.title) == 0) {
            doc.title = file
        }
        edit.bindDocument(doc)
        ; A different document: nothing the layout holds is about this one.
        view.layout.invalidate()
        currentPage = 0
        return true
    }

    ; A document the caller already has, rather than one read from a package.
    ; The bench builds one in memory, and so does anything that wants to drive
    ; this viewer without a file behind it.
    fn attachDocument:void (d:RichDocument) {
        doc = d
        if ((strlen doc.title) == 0) {
            doc.title = "untitled"
        }
        edit.bindDocument(doc)
        ; A different document: nothing the layout holds is about this one.
        view.layout.invalidate()
        currentPage = 0
        this.renderPage(0)
    }

    ; The same, from bytes. `openFile` is this with a file read in front of it.
    fn openBytes:boolean (data:buffer name:string) {
        lastError = ""
        def pkg:DocxPackage (new DocxPackage)
        if ((pkg.openBytes(data name)) == false) {
            lastError = ("failed to open " + name)
            return false
        }
        if ((pkg.hasPart("word/document.xml")) == false) {
            lastError = "missing word/document.xml"
            pkg.close()
            return false
        }
        doc = (parser.parsePackage(pkg))
        numbering = parser.numbering
        pkg.close()
        if ((strlen doc.title) == 0) {
            doc.title = name
        }
        edit.bindDocument(doc)
        ; A different document: nothing the layout holds is about this one.
        view.layout.invalidate()
        currentPage = 0
        return true
    }

    ; The page as an EVGDisplayList, for a backend that draws rather than
    ; receives a picture. Same layout and same painting as `renderPage`.
    fn pageDisplayList:EVGDisplayList (page:int) {
        def dl:EVGDisplayList (view.buildDisplayList(doc page numbering edit (edit.isEnabled())))
        currentPage = view.pageIndex
        return dl
    }

    fn sceneJson:string (page:int) {
        def dl:EVGDisplayList (this.pageDisplayList(page))
        def body:string (dl.toJson())
        return ("{\"width\":" + (EVGDisplayList.num((to_double (view.sceneWidth())))) + ",\"height\":" + (EVGDisplayList.num((to_double (view.sceneHeight())))) + ",\"list\":" + body + "}")
    }

    ; Every image part this document carries, and their bytes — a host with no
    ; file server hands them to the renderer itself.
    fn imagePartsJson:string () {
        def names:[string]
        def i:int 0
        while (i < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(i))
            def j:int 0
            while (j < (array_length p.images)) {
                def im:DocImage (itemAt p.images j)
                if ((buffer_length im.bytes) > 0) {
                    def seen:boolean false
                    def k:int 0
                    while (k < (array_length names)) {
                        if ((itemAt names k) == im.partPath) {
                            seen = true
                        }
                        k = (k + 1)
                    }
                    if (seen == false) {
                        push names im.partPath
                    }
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        def out:string "["
        def n:int 0
        while (n < (array_length names)) {
            if (n > 0) {
                out = (out + ",")
            }
            out = (out + "\"" + (itemAt names n) + "\"")
            n = (n + 1)
        }
        return (out + "]")
    }

    fn imageBytes:buffer (part:string) {
        def i:int 0
        while (i < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(i))
            def j:int 0
            while (j < (array_length p.images)) {
                def im:DocImage (itemAt p.images j)
                if (im.partPath == part) {
                    return im.bytes
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return (buffer_alloc 0)
    }

    fn document:RichDocument () {
        return doc
    }

    fn editor:DocxEditController () {
        return edit
    }

    fn setEditMode:void (on:boolean) {
        edit.setEnabled(on)
    }

    fn editMode:boolean () {
        return (edit.isEnabled())
    }

    ; present() silently clamps an out-of-range page to the last one. Adopting
    ; the page it actually drew keeps currentPage from ever naming a page that
    ; does not exist — otherwise page N and a phantom page N+1 both report
    ; success while showing the same content.
    fn renderPage:void (page:int) {
        if (edit.isEnabled()) {
            view.presentWithEdit(doc page numbering edit)
        } {
            view.present(doc page numbering)
        }
        currentPage = view.pageIndex
    }

    fn renderAll:void (maxPages:int) {
        view.presentAll(doc numbering maxPages)
    }

    fn pageCount:int () {
        return (view.layout.pageCount())
    }

    fn pageWidth:int () {
        return (view.width())
    }

    fn pageHeight:int () {
        return (view.height())
    }

    fn writePng:void (dir:string file:string) {
        view.writePng(dir file)
    }

    fn pngBytes:buffer () {
        return (view.pngBytes())
    }

    fn plainText:string () {
        return (doc.plainText())
    }

    fn inspectJson:string () {
        return (doc.inspectJson())
    }

    ; --- editing surface for window host ---

    fn clickAt:void (x:int y:int extendSelection:boolean) {
        if ((edit.isEnabled()) == false) {
            return
        }
        this.renderPage(currentPage)
        def pos:DocumentPosition (edit.hitTest(view.layout currentPage x y))
        if (pos.paragraphId <= 0) {
            return
        }
        if extendSelection {
            if (edit.isActive()) {
                ; Move the FOCUS and keep the anchor, whichever paragraph the
                ; point landed in. This used to give up when the two ends were
                ; in different paragraphs and collapse to a caret instead —
                ; which is a selection you cannot make across a paragraph
                ; break, by shift-clicking or by dragging, even though
                ; `orderedEnds` and every edit below it handle a multi-
                ; paragraph range perfectly well.
                edit.extendTo(pos.paragraphId pos.textOffset)
            } {
                edit.setCaret(pos.paragraphId pos.textOffset)
            }
        } {
            edit.setCaret(pos.paragraphId pos.textOffset)
        }
        ; The toolbar describes the run the caret is in, so the caret has to
        ; pick that up when it moves somewhere new.
        edit.adoptRunAtCaret()
        this.renderPage(currentPage)
    }

    ; The pointer moving with the button held: the same thing as a shift-click,
    ; and the reason a drag paints a selection rather than only ever moving the
    ; caret. Nothing used to call this, because the host never said the button
    ; was still down and the app never asked.
    fn dragTo:void (x:int y:int) {
        if ((edit.isEnabled()) == false) {
            return
        }
        if ((edit.isActive()) == false) {
            return
        }
        this.renderPage(currentPage)
        def pos:DocumentPosition (edit.hitTest(view.layout currentPage x y))
        if (pos.paragraphId <= 0) {
            return
        }
        def before:DocumentPosition (edit.caret())
        if ((before.paragraphId == pos.paragraphId) && (before.textOffset == pos.textOffset)) {
            return
        }
        edit.extendTo(pos.paragraphId pos.textOffset)
        this.renderPage(currentPage)
    }

    fn typeText:void (text:string) {
        if ((edit.isEnabled()) == false) {
            return
        }
        edit.insertText(text)
        this.renderPage(currentPage)
    }

    fn keyBackspace:void () {
        edit.backspace()
        this.renderPage(currentPage)
    }

    fn keyDelete:void () {
        edit.deleteForward()
        this.renderPage(currentPage)
    }

    fn keyEnter:void () {
        edit.splitAtCaret()
        this.renderPage(currentPage)
    }

    ; --- caret movement -------------------------------------------------------
    ; Layout lives in the view, so every movement re-lays out first (cheap:
    ; renderPage already does it) and then follows the caret onto its page, so
    ; Up / Down / PageUp / PageDown walk across page boundaries.
    fn pageOfCaret:int () {
        def cur:[int]
        edit.caretLine(view.layout cur)
        def cp:int (itemAt cur 0)
        if (cp < 0) {
            return currentPage
        }
        return cp
    }

    fn followCaret:void () {
        def target:int (this.pageOfCaret())
        if (target != currentPage) {
            currentPage = target
        }
        this.renderPage(currentPage)
    }

    ; --- reading rather than editing -----------------------------------------
    ; Every movement below moves a CARET, and `edit` does nothing at all when
    ; editing is off. That is the whole of "PageDown does not go to the next
    ; page": in a document you are only reading there is no caret to move, and
    ; nobody had said what the key should do instead.
    ;
    ; What it should do is what it does in every reader — turn the page. The
    ; keys are the same keys and the hosts already send them, so none of them
    ; has to learn anything; the key simply now means something on both sides
    ; of the edit switch.
    ;
    ; The viewer draws one page at a time, so paging IS the scroll here. A
    ; continuous ribbon of pages is a different layout and a bigger change
    ; than this; what a reader needs first is for the key to do something.
    fn goToPage:boolean (p:int) {
        def want:int p
        def n:int (this.pageCount())
        if (want < 0) {
            want = 0
        }
        if (n > 0) {
            if (want > (n - 1)) {
                want = (n - 1)
            }
        }
        if (want == currentPage) {
            return false
        }
        ; A page arrived at by a button or a key starts at its top. `scrollBy`
        ; sets its own position afterwards, which is what lets a gesture carry
        ; travel across the boundary instead of landing at the top of the next
        ; page whatever the reader did.
        scrollY = 0
        this.renderPage(want)
        return true
    }

    fn turnPage:boolean (delta:int) {
        return (this.goToPage((currentPage + delta)))
    }

    ; How far the page can be scrolled before its bottom edge is on screen.
    ; Zero for a page shorter than the window, which then does not scroll at
    ; all and turns on the first gesture instead.
    fn maxScrollY:int () {
        if (viewportH <= 0) {
            return 0
        }
        def h:int (view.sceneHeight())
        if (h <= viewportH) {
            return 0
        }
        return (h - viewportH)
    }

    ; A wheel notch or a swipe, in scene pixels, positive downwards.
    ;
    ; The page scrolls, and when it runs out the next one begins — which is
    ; how every reader of paged documents behaves and what this did not do.
    ; Travel past the bottom of a page is not thrown away: it carries into the
    ; top of the next one, so a long flick crosses a page boundary without
    ; stopping dead at it and without skipping the paper in between.
    ;
    ; A page shorter than the window has nowhere to scroll, so the first
    ; gesture turns it. That is the old behaviour, and it is still right for
    ; the case it was written for.
    fn scrollBy:boolean (dy:int) {
        if (dy == 0) {
            return false
        }
        def moved:boolean false
        def want:int (scrollY + dy)
        def guard:int 0
        while (guard < 64) {
            guard = (guard + 1)
            def maxY:int (this.maxScrollY())
            if (want > maxY) {
                def over:int (want - maxY)
                if (this.turnPage(1)) {
                    moved = true
                    ; The travel left over is spent on the NEW page, and only
                    ; as far as the new page can take it. Without that clamp a
                    ; page with nowhere to scroll — one shorter than the
                    ; window — hands the whole gesture straight to the page
                    ; after it, and one flick runs through the entire
                    ; document.
                    def room:int (this.maxScrollY())
                    def rest:int (over - 1)
                    if (rest > room) {
                        rest = room
                    }
                    want = rest
                    scrollY = 0
                } {
                    want = maxY
                    guard = 64
                }
            } {
                if (want < 0) {
                    if (this.turnPage(-1)) {
                        moved = true
                        def newMax:int (this.maxScrollY())
                        def back:int ((newMax + want) + 1)
                        if (back < 0) {
                            back = 0
                        }
                        want = back
                        scrollY = newMax
                    } {
                        want = 0
                        guard = 64
                    }
                } {
                    guard = 64
                }
            }
        }
        def maxEnd:int (this.maxScrollY())
        if (want > maxEnd) {
            want = maxEnd
        }
        if (want < 0) {
            want = 0
        }
        if (want != scrollY) {
            moved = true
        }
        scrollY = want
        return moved
    }


    fn keyLeft:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(-1)
            return
        }
        edit.moveLeft(extend)
        this.followCaret()
    }

    ; Ctrl+Left / Ctrl+Right. The word rule is `OfficeCaretMotion`'s, shared
    ; with the slide editor, so a document and a deck jump the same gaps.
    fn keyWordLeft:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            return
        }
        edit.moveWordLeft(extend)
        this.followCaret()
    }

    fn keyWordRight:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            return
        }
        edit.moveWordRight(extend)
        this.followCaret()
    }

    fn keyRight:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(1)
            return
        }
        edit.moveRight(extend)
        this.followCaret()
    }

    fn keyUp:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(-1)
            return
        }
        edit.moveUp(view.layout extend)
        this.followCaret()
    }

    fn keyDown:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(1)
            return
        }
        edit.moveDown(view.layout extend)
        this.followCaret()
    }

    fn keyPageUp:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(-1)
            return
        }
        edit.pageUp(view.layout extend)
        this.followCaret()
    }

    fn keyPageDown:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(1)
            return
        }
        edit.pageDown(view.layout extend)
        this.followCaret()
    }

    fn keyHome:void (extend:boolean ctrl:boolean) {
        if ((edit.isEnabled()) == false) {
            this.goToPage(0)
            return
        }
        if ctrl {
            edit.moveDocEdge(false extend)
        } {
            edit.moveLineEdge(view.layout false extend)
        }
        this.followCaret()
    }

    fn keyEnd:void (extend:boolean ctrl:boolean) {
        if ((edit.isEnabled()) == false) {
            this.goToPage(((this.pageCount()) - 1))
            return
        }
        if ctrl {
            edit.moveDocEdge(true extend)
        } {
            edit.moveLineEdge(view.layout true extend)
        }
        this.followCaret()
    }

    ; Tab / Shift+Tab: next / previous table cell, selecting its contents the
    ; way Word does. Outside a table it steps into an adjacent one if there is
    ; one; it does not insert a tab character (no tab-stop rendering yet).
    fn keyTab:boolean (backward:boolean) {
        if ((edit.isEnabled()) == false) {
            return false
        }
        def moved:boolean false
        if backward {
            moved = (edit.tabCell(false))
        } {
            moved = (edit.tabCell(true))
        }
        if moved {
            this.followCaret()
        }
        return moved
    }

    fn caretInTable:boolean () {
        return (edit.inTable())
    }

    fn keySelectAll:void () {
        edit.selectAll()
        this.renderPage(currentPage)
    }

    ; --- clipboard out --------------------------------------------------------
    fn copySelection:string () {
        return (edit.selectedText())
    }

    fn cutSelection:string () {
        def text:string (edit.selectedText())
        if ((strlen text) > 0) {
            edit.deleteSelection()
            this.followCaret()
        }
        return text
    }

    fn setPage:int (page:int) {
        this.renderPage(page)
        return currentPage
    }

    fn keyUndo:void () {
        edit.undo()
        this.renderPage(currentPage)
    }

    fn keyRedo:void () {
        edit.redo()
        this.renderPage(currentPage)
    }

    ; Clipboard paste from the host. `html` is the text/html flavour (what a
    ; spreadsheet copy puts next to the TSV) and lands as a real table; `text`
    ; is the text/plain fallback. Returns true when something was inserted.
    fn pasteClipboard:boolean (html:string text:string) {
        if ((edit.isEnabled()) == false) {
            return false
        }
        if ((edit.isActive()) == false) {
            return false
        }
        ; A chart first: the HTML a chart copy puts on the clipboard is an
        ; <img> carrying the chart's whole Vela document as an attribute. Read
        ; as a table it would be nothing; read as a picture it would be dead
        ; pixels. Read as what it is, it stays a chart.
        if ((strlen html) > 0) {
            def cdoc:ChartDoc (ChartDocCodec.fromHtml(html))
            if cdoc.ok {
                def json:string (ChartDocCodec.jsonFromHtml(html))
                def made:int (edit.pasteChart(json cdoc.chart.w cdoc.chart.h))
                if (made > 0) {
                    view.selectedChartId = made
                    this.renderPage(currentPage)
                    return true
                }
            }
        }
        def tbl:ClipboardTable (new ClipboardTable)
        def got:boolean false
        if ((strlen html) > 0) {
            got = (tbl.parseHtml(html))
        }
        if (got == false) {
            if (ClipboardTable.looksTabular(text)) {
                got = (tbl.parseTsv(text))
            }
        }
        if got {
            def done:boolean (edit.pasteTable(tbl))
            this.renderPage(currentPage)
            return done
        }
        def typed:boolean (edit.pasteText(text))
        this.renderPage(currentPage)
        return typed
    }

    ; --- charts in the document -----------------------------------------------
    ; Everything a host needs to make a pasted chart editable: find one under
    ; the pointer, select it, and change it. Each edit regenerates the chart's
    ; specification from its own numbers, so what is drawn afterwards is a real
    ; chart of that kind rather than the old picture with a new label.
    fn chartAtPoint:int (x:int y:int) {
        def pg:LaidPage (view.layout.pageAt(view.pageIndex))
        def i:int 0
        while (i < (array_length pg.lines)) {
            def line:LaidLine (itemAt pg.lines i)
            if (line.kind == (LaidLineKind.chart())) {
                if (x >= line.x) {
                    if (x <= (line.x + line.width)) {
                        if (y >= line.y) {
                            if (y <= (line.y + line.height)) {
                                return line.chartId
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return 0
    }

    fn selectChart:void (id:int) {
        view.selectedChartId = id
        this.renderPage(currentPage)
    }

    fn selectedChart:int () {
        return view.selectedChartId
    }

    ; Click-to-select, so a chart behaves like the pictures beside it. Returns
    ; true when the click landed on one, so the host knows the caret should not
    ; move there.
    fn clickChart:boolean (x:int y:int) {
        def id:int (this.chartAtPoint(x y))
        if (id == 0) {
            if (view.selectedChartId != 0) {
                view.selectedChartId = 0
                this.renderPage(currentPage)
            }
            return false
        }
        this.selectChart(id)
        return true
    }

    fn editChart:boolean (what:string arg:string) {
        def id:int view.selectedChartId
        if (id == 0) {
            return false
        }
        def done:boolean (edit.editChart(id what arg))
        if done {
            ; The render cache is keyed by chart id and box, and the chart it
            ; describes has changed, so the old picture has to go.
            view.charts.forget(id)
            this.renderPage(currentPage)
        }
        return done
    }

    fn deleteChart:boolean () {
        def id:int view.selectedChartId
        if (id == 0) {
            return false
        }
        def done:boolean (edit.deleteChart(id))
        if done {
            view.charts.forget(id)
            view.selectedChartId = 0
            this.renderPage(currentPage)
        }
        return done
    }

    ; --- drawings in the document --------------------------------------------
    ; A drawing behaves like a chart to the pointer: click to select, and a
    ; frame says so. What can be done to one is smaller — it is geometry made
    ; elsewhere, so it can be made bigger or smaller, and drawn again from new
    ; source by whoever drew it — and `DocDrawing` carries what that takes.
    fn drawingAtPoint:int (x:int y:int) {
        def pg:LaidPage (view.layout.pageAt(view.pageIndex))
        def i:int 0
        while (i < (array_length pg.lines)) {
            def line:LaidLine (itemAt pg.lines i)
            if (line.kind == (LaidLineKind.drawing())) {
                if (x >= line.x) {
                    if (x <= (line.x + line.width)) {
                        if (y >= line.y) {
                            if (y <= (line.y + line.height)) {
                                return line.drawingId
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return 0
    }

    fn selectDrawing:void (id:int) {
        view.selectedDrawingId = id
        this.renderPage(currentPage)
    }

    fn selectedDrawing:int () {
        return view.selectedDrawingId
    }

    fn clickDrawing:boolean (x:int y:int) {
        def id:int (this.drawingAtPoint(x y))
        if (id == 0) {
            if (view.selectedDrawingId != 0) {
                view.selectedDrawingId = 0
                this.renderPage(currentPage)
            }
            return false
        }
        this.selectDrawing(id)
        return true
    }

    ; --- resizing a drawing by its corners ------------------------------------
    ; The frame the selected drawing gets has a handle on each corner, and a
    ; press on one starts a drag that sets the drawing's width — the height
    ; follows, because a diagram stretched out of proportion is a different
    ; diagram. `drawingHandleAt` says which corner, if any, is under a point;
    ; the app routes the press, the moves and the release here.
    def dragDrawingId:int 0
    def dragCorner:int 0
    def dragStartW:int 0
    def dragStartH:int 0
    def dragStartX:int 0
    def dragStartY:int 0

    ; The laid-out line of a drawing on the page the viewer is on, or a line
    ; with no drawing in it when the drawing is on another page.
    fn drawingLine:LaidLine (id:int) {
        def pg:LaidPage (view.layout.pageAt(view.pageIndex))
        def i:int 0
        while (i < (array_length pg.lines)) {
            def line:LaidLine (itemAt pg.lines i)
            if (line.kind == (LaidLineKind.drawing())) {
                if (line.drawingId == id) {
                    return line
                }
            }
            i = (i + 1)
        }
        return (new LaidLine)
    }

    ; Which corner handle of the selected drawing's frame is under the point:
    ; 1 top-left, 2 top-right, 3 bottom-left, 4 bottom-right, 0 for none. A
    ; handle is eight pixels square and takes a press from two more around
    ; it, which is what makes the corner of a drawing something a pointer
    ; can find.
    ; How far apart two integers are. Ranger has `fabs` for doubles and
    ; nothing for ints, and a hit test on pixels wants ints.
    sfn away:int (a:int b:int) {
        if (a < b) { return (b - a) }
        return (a - b)
    }

    fn drawingHandleAt:int (x:int y:int) {
        if (view.selectedDrawingId == 0) {
            return 0
        }
        def line:LaidLine (this.drawingLine(view.selectedDrawingId))
        if (line.drawingId == 0) {
            return 0
        }
        def k:int 1
        while (k <= 4) {
            def hx:int (DocxView.handleX(line k))
            def hy:int (DocxView.handleY(line k))
            if ((DocxViewer.away(x hx)) <= 6) {
                if ((DocxViewer.away(y hy)) <= 6) {
                    return k
                }
            }
            k = (k + 1)
        }
        return 0
    }

    ; A press on a handle: remember where the drag starts from, so every
    ; move sets the size from the press rather than from the move before it
    ; and a jittery hand does not accumulate.
    fn beginDrawingDrag:boolean (x:int y:int) {
        def k:int (this.drawingHandleAt(x y))
        if (k == 0) {
            return false
        }
        def line:LaidLine (this.drawingLine(view.selectedDrawingId))
        dragDrawingId = view.selectedDrawingId
        dragCorner = k
        dragStartW = line.width
        dragStartH = line.height
        dragStartX = x
        dragStartY = y
        return true
    }

    fn draggingDrawing:boolean () {
        return (dragDrawingId != 0)
    }

    ; The pointer moved with a handle held. Whichever axis the hand moved
    ; further along decides the new width — a drag straight down on the
    ; bottom-right corner grows the drawing too — and the height follows the
    ; drawing's own proportion. The left-hand corners grow it leftwards,
    ; which on a drawing that starts at the margin means the same thing.
    fn dragDrawingTo:boolean (x:int y:int) {
        if (dragDrawingId == 0) {
            return false
        }
        if (dragStartW <= 0) {
            return false
        }
        def dx:int (x - dragStartX)
        def dy:int (y - dragStartY)
        if ((dragCorner == 1) || (dragCorner == 3)) { dx = (0 - dx) }
        if ((dragCorner == 1) || (dragCorner == 2)) { dy = (0 - dy) }
        def fromX:int (dragStartW + dx)
        def fromY:int dragStartW
        if (dragStartH > 0) {
            fromY = (to_int (((to_double (dragStartH + dy)) * (to_double dragStartW)) / (to_double dragStartH)))
        }
        def w:int fromX
        if ((DocxViewer.away(fromY dragStartW)) > (DocxViewer.away(fromX dragStartW))) {
            w = fromY
        }
        if (w < 24) { w = 24 }
        def dr:DocDrawing (doc.drawingById(dragDrawingId))
        if (dr.id != dragDrawingId) {
            return false
        }
        def h:int (to_int (((to_double w) * (to_double dragStartH)) / (to_double dragStartW)))
        if (h < 12) { h = 12 }
        if ((dr.widthPx == w) && (dr.heightPx == h)) {
            return false
        }
        dr.widthPx = w
        dr.heightPx = h
        doc.touch()
        view.layout.invalidate()
        this.renderPage(currentPage)
        ; The layout will not let a drawing past the column; what it drew is
        ; the size the drawing has, so a drag out over the margin does not
        ; leave a width nobody can see behind for the next press to fight.
        def laid:LaidLine (this.drawingLine(dragDrawingId))
        if (laid.drawingId == dragDrawingId) {
            if (laid.width < dr.widthPx) {
                dr.widthPx = laid.width
                dr.heightPx = laid.height
            }
        }
        return true
    }

    fn endDrawingDrag:boolean () {
        if (dragDrawingId == 0) {
            return false
        }
        dragDrawingId = 0
        dragCorner = 0
        return true
    }

    ; The selected drawing, scaled: 1.1 is a tenth bigger, 0.9 a tenth
    ; smaller. The natural size is untouched — the painter scales the marks
    ; between the two — so growing and shrinking are each other's inverse
    ; and nothing is lost on the way.
    fn resizeDrawing:boolean (factor:double) {
        def id:int view.selectedDrawingId
        if (id == 0) {
            return false
        }
        if (factor <= 0.0) {
            return false
        }
        def dr:DocDrawing (doc.drawingById(id))
        if (dr.id != id) {
            return false
        }
        def w:int (to_int (((to_double dr.widthPx) * factor) + 0.5))
        def h:int (to_int (((to_double dr.heightPx) * factor) + 0.5))
        if (w < 24) { return false }
        if (h < 12) { return false }
        dr.widthPx = w
        dr.heightPx = h
        doc.touch()
        view.layout.invalidate()
        this.renderPage(currentPage)
        return true
    }

    ; The selected drawing's provenance, for a host that wants to show its
    ; source, and the drawing itself for one that can draw it again.
    fn selectedDrawingModel:DocDrawing () {
        return (doc.drawingById(view.selectedDrawingId))
    }

    ; A drawing drawn again: whoever holds the reader for its notation hands
    ; over the new tree and its natural size, and the box keeps its width so a
    ; redraw does not undo a resize.
    fn replaceDrawing:boolean (id:int root:EVGElement naturalW:double naturalH:double source:string) {
        def dr:DocDrawing (doc.drawingById(id))
        if (dr.id != id) {
            return false
        }
        if ((naturalW <= 0.0) || (naturalH <= 0.0)) {
            return false
        }
        dr.root = root
        dr.naturalW = naturalW
        dr.naturalH = naturalH
        dr.source = source
        dr.note = ""
        def w:double (to_double dr.widthPx)
        dr.heightPx = (to_int (((w * naturalH) / naturalW) + 0.5))
        if (dr.heightPx < 12) { dr.heightPx = 12 }
        doc.touch()
        view.layout.invalidate()
        this.renderPage(currentPage)
        return true
    }

    ; The chart's own document, for a host that wants to show or export it.
    fn chartJson:string (id:int) {
        def c:DocChart (doc.chartById(id))
        return c.json
    }

    fn toggleBold:void () {
        edit.toggleBold()
        this.renderPage(currentPage)
    }

    fn setFont:void (font:string) {
        edit.setFont(font)
        this.renderPage(currentPage)
    }

    fn caretInfoJson:string () {
        if ((edit.isActive()) == false) {
            return "{\"active\":false}"
        }
        def c:DocumentPosition (edit.caret())
        def sel:DocumentRange (edit.selection())
        def a:int (sel.startOffset())
        def b:int (sel.endOffset())
        def boldFlag:string "false"
        if (edit.typingBold) {
            boldFlag = "true"
        }
        return ("{\"active\":true,\"paragraphId\":" + (to_string c.paragraphId) + ",\"offset\":" + (to_string c.textOffset) + ",\"selStart\":" + (to_string a) + ",\"selEnd\":" + (to_string b) + ",\"boldTyping\":" + boldFlag + "}")
    }
}

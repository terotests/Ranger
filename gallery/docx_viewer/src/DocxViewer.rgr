; ==============================================================================
; DocxViewer - load .docx → RichDocument → SoftCanvas pages (+ optional edit).
; ==============================================================================

Import "DocxPackage.rgr"
Import "WordMlParser.rgr"
Import "WordNumbering.rgr"
Import "RichDocument.rgr"
Import "DocxView.rgr"
Import "DocxEditController.rgr"
Import "ClipboardTable.rgr"
Import "../../datagrid/src/ChartDoc.rgr"
Import "../../text_editor/src/TextEditCore.rgr"

class DocxViewer {
    def parser:WordMlParser (new WordMlParser)
    def view:DocxView (new DocxView)
    def doc:RichDocument (new RichDocument)
    def numbering:WordNumbering (new WordNumbering)
    def edit:DocxEditController (new DocxEditController)
    def lastError:string ""
    def currentPage:int 0
    ; Wheel / swipe travel not yet spent on a page turn.
    def scrollAccum:int 0

    Constructor () {
    }

    fn init:void (fontDir:string) {
        view.init(fontDir)
    }

    fn openFile:boolean (dir:string file:string) {
        lastError = ""
        def pkg:DocxPackage (new DocxPackage)
        if ((pkg.open(dir file)) == false) {
            lastError = ("failed to open " + file)
            return false
        }
        if ((pkg.hasPart("word/document.xml")) == false) {
            lastError = "missing word/document.xml"
            pkg.close()
            return false
        }
        doc = (parser.parsePackage(pkg))
        numbering = parser.numbering
        pkg.close()
        if ((strlen doc.title) == 0) {
            doc.title = file
        }
        edit.bindDocument(doc)
        currentPage = 0
        return true
    }

    ; The same, from bytes. `openFile` is this with a file read in front of it.
    fn openBytes:boolean (data:buffer name:string) {
        lastError = ""
        def pkg:DocxPackage (new DocxPackage)
        if ((pkg.openBytes(data name)) == false) {
            lastError = ("failed to open " + name)
            return false
        }
        if ((pkg.hasPart("word/document.xml")) == false) {
            lastError = "missing word/document.xml"
            pkg.close()
            return false
        }
        doc = (parser.parsePackage(pkg))
        numbering = parser.numbering
        pkg.close()
        if ((strlen doc.title) == 0) {
            doc.title = name
        }
        edit.bindDocument(doc)
        currentPage = 0
        return true
    }

    ; The page as an EVGDisplayList, for a backend that draws rather than
    ; receives a picture. Same layout and same painting as `renderPage`.
    fn pageDisplayList:EVGDisplayList (page:int) {
        def dl:EVGDisplayList (view.buildDisplayList(doc page numbering edit (edit.isEnabled())))
        currentPage = view.pageIndex
        return dl
    }

    fn sceneJson:string (page:int) {
        def dl:EVGDisplayList (this.pageDisplayList(page))
        def body:string (dl.toJson())
        return ("{\"width\":" + (EVGDisplayList.num((to_double (view.sceneWidth())))) + ",\"height\":" + (EVGDisplayList.num((to_double (view.sceneHeight())))) + ",\"list\":" + body + "}")
    }

    ; Every image part this document carries, and their bytes — a host with no
    ; file server hands them to the renderer itself.
    fn imagePartsJson:string () {
        def names:[string]
        def i:int 0
        while (i < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(i))
            def j:int 0
            while (j < (array_length p.images)) {
                def im:DocImage (itemAt p.images j)
                if ((buffer_length im.bytes) > 0) {
                    def seen:boolean false
                    def k:int 0
                    while (k < (array_length names)) {
                        if ((itemAt names k) == im.partPath) {
                            seen = true
                        }
                        k = (k + 1)
                    }
                    if (seen == false) {
                        push names im.partPath
                    }
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        def out:string "["
        def n:int 0
        while (n < (array_length names)) {
            if (n > 0) {
                out = (out + ",")
            }
            out = (out + "\"" + (itemAt names n) + "\"")
            n = (n + 1)
        }
        return (out + "]")
    }

    fn imageBytes:buffer (part:string) {
        def i:int 0
        while (i < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(i))
            def j:int 0
            while (j < (array_length p.images)) {
                def im:DocImage (itemAt p.images j)
                if (im.partPath == part) {
                    return im.bytes
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return (buffer_alloc 0)
    }

    fn document:RichDocument () {
        return doc
    }

    fn editor:DocxEditController () {
        return edit
    }

    fn setEditMode:void (on:boolean) {
        edit.setEnabled(on)
    }

    fn editMode:boolean () {
        return (edit.isEnabled())
    }

    ; present() silently clamps an out-of-range page to the last one. Adopting
    ; the page it actually drew keeps currentPage from ever naming a page that
    ; does not exist — otherwise page N and a phantom page N+1 both report
    ; success while showing the same content.
    fn renderPage:void (page:int) {
        if (edit.isEnabled()) {
            view.presentWithEdit(doc page numbering edit)
        } {
            view.present(doc page numbering)
        }
        currentPage = view.pageIndex
    }

    fn renderAll:void (maxPages:int) {
        view.presentAll(doc numbering maxPages)
    }

    fn pageCount:int () {
        return (view.layout.pageCount())
    }

    fn pageWidth:int () {
        return (view.width())
    }

    fn pageHeight:int () {
        return (view.height())
    }

    fn writePng:void (dir:string file:string) {
        view.writePng(dir file)
    }

    fn pngBytes:buffer () {
        return (view.pngBytes())
    }

    fn plainText:string () {
        return (doc.plainText())
    }

    fn inspectJson:string () {
        return (doc.inspectJson())
    }

    ; --- editing surface for window host ---

    fn clickAt:void (x:int y:int extendSelection:boolean) {
        if ((edit.isEnabled()) == false) {
            return
        }
        this.renderPage(currentPage)
        def pos:DocumentPosition (edit.hitTest(view.layout currentPage x y))
        if (pos.paragraphId <= 0) {
            return
        }
        if extendSelection {
            if (edit.isActive()) {
                if (edit.sel.anchor.paragraphId == pos.paragraphId) {
                    edit.sel.focus = (pos.copy())
                } {
                    edit.setCaret(pos.paragraphId pos.textOffset)
                }
            } {
                edit.setCaret(pos.paragraphId pos.textOffset)
            }
        } {
            edit.setCaret(pos.paragraphId pos.textOffset)
        }
        ; The toolbar describes the run the caret is in, so the caret has to
        ; pick that up when it moves somewhere new.
        edit.adoptRunAtCaret()
        this.renderPage(currentPage)
    }

    fn typeText:void (text:string) {
        if ((edit.isEnabled()) == false) {
            return
        }
        edit.insertText(text)
        this.renderPage(currentPage)
    }

    fn keyBackspace:void () {
        edit.backspace()
        this.renderPage(currentPage)
    }

    fn keyDelete:void () {
        edit.deleteForward()
        this.renderPage(currentPage)
    }

    fn keyEnter:void () {
        edit.splitAtCaret()
        this.renderPage(currentPage)
    }

    ; --- caret movement -------------------------------------------------------
    ; Layout lives in the view, so every movement re-lays out first (cheap:
    ; renderPage already does it) and then follows the caret onto its page, so
    ; Up / Down / PageUp / PageDown walk across page boundaries.
    fn pageOfCaret:int () {
        def cur:[int]
        edit.caretLine(view.layout cur)
        def cp:int (itemAt cur 0)
        if (cp < 0) {
            return currentPage
        }
        return cp
    }

    fn followCaret:void () {
        def target:int (this.pageOfCaret())
        if (target != currentPage) {
            currentPage = target
        }
        this.renderPage(currentPage)
    }

    ; --- reading rather than editing -----------------------------------------
    ; Every movement below moves a CARET, and `edit` does nothing at all when
    ; editing is off. That is the whole of "PageDown does not go to the next
    ; page": in a document you are only reading there is no caret to move, and
    ; nobody had said what the key should do instead.
    ;
    ; What it should do is what it does in every reader — turn the page. The
    ; keys are the same keys and the hosts already send them, so none of them
    ; has to learn anything; the key simply now means something on both sides
    ; of the edit switch.
    ;
    ; The viewer draws one page at a time, so paging IS the scroll here. A
    ; continuous ribbon of pages is a different layout and a bigger change
    ; than this; what a reader needs first is for the key to do something.
    fn goToPage:boolean (p:int) {
        def want:int p
        def n:int (this.pageCount())
        if (want < 0) {
            want = 0
        }
        if (n > 0) {
            if (want > (n - 1)) {
                want = (n - 1)
            }
        }
        if (want == currentPage) {
            return false
        }
        this.renderPage(want)
        return true
    }

    fn turnPage:boolean (delta:int) {
        return (this.goToPage((currentPage + delta)))
    }

    ; A wheel notch or a swipe, in scene pixels, positive downwards.
    ;
    ; The travel is ACCUMULATED rather than turned into a page each time: one
    ; flick of a trackpad is a great many small deltas, and a page per delta
    ; would throw a reader half way through the document. A page turns once
    ; the travel adds up to a good part of one, and the remainder is kept so
    ; two half-flicks in the same direction still turn a page.
    fn scrollBy:boolean (dy:int) {
        if (dy == 0) {
            return false
        }
        ; A change of direction is a new gesture, not a continuation.
        if (dy > 0) {
            if (scrollAccum < 0) {
                scrollAccum = 0
            }
        } {
            if (scrollAccum > 0) {
                scrollAccum = 0
            }
        }
        scrollAccum = (scrollAccum + dy)
        def step:int (this.pageTurnTravel())
        def turned:boolean false
        while (scrollAccum >= step) {
            scrollAccum = (scrollAccum - step)
            if (this.turnPage(1)) {
                turned = true
            } {
                scrollAccum = 0
            }
        }
        while (scrollAccum <= (0 - step)) {
            scrollAccum = (scrollAccum + step)
            if (this.turnPage(-1)) {
                turned = true
            } {
                scrollAccum = 0
            }
        }
        return turned
    }

    ; How far a gesture has to travel to be worth a page. A third of the page
    ; is about one comfortable flick and is short enough that a deliberate
    ; drag still feels connected to the paper.
    fn pageTurnTravel:int () {
        def h:int (this.pageHeight())
        if (h < 300) {
            return 100
        }
        return (idiv h 3)
    }

    fn keyLeft:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(-1)
            return
        }
        edit.moveLeft(extend)
        this.followCaret()
    }

    fn keyRight:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(1)
            return
        }
        edit.moveRight(extend)
        this.followCaret()
    }

    fn keyUp:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(-1)
            return
        }
        edit.moveUp(view.layout extend)
        this.followCaret()
    }

    fn keyDown:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(1)
            return
        }
        edit.moveDown(view.layout extend)
        this.followCaret()
    }

    fn keyPageUp:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(-1)
            return
        }
        edit.pageUp(view.layout extend)
        this.followCaret()
    }

    fn keyPageDown:void (extend:boolean) {
        if ((edit.isEnabled()) == false) {
            this.turnPage(1)
            return
        }
        edit.pageDown(view.layout extend)
        this.followCaret()
    }

    fn keyHome:void (extend:boolean ctrl:boolean) {
        if ((edit.isEnabled()) == false) {
            this.goToPage(0)
            return
        }
        if ctrl {
            edit.moveDocEdge(false extend)
        } {
            edit.moveLineEdge(view.layout false extend)
        }
        this.followCaret()
    }

    fn keyEnd:void (extend:boolean ctrl:boolean) {
        if ((edit.isEnabled()) == false) {
            this.goToPage(((this.pageCount()) - 1))
            return
        }
        if ctrl {
            edit.moveDocEdge(true extend)
        } {
            edit.moveLineEdge(view.layout true extend)
        }
        this.followCaret()
    }

    ; Tab / Shift+Tab: next / previous table cell, selecting its contents the
    ; way Word does. Outside a table it steps into an adjacent one if there is
    ; one; it does not insert a tab character (no tab-stop rendering yet).
    fn keyTab:boolean (backward:boolean) {
        if ((edit.isEnabled()) == false) {
            return false
        }
        def moved:boolean false
        if backward {
            moved = (edit.tabCell(false))
        } {
            moved = (edit.tabCell(true))
        }
        if moved {
            this.followCaret()
        }
        return moved
    }

    fn caretInTable:boolean () {
        return (edit.inTable())
    }

    fn keySelectAll:void () {
        edit.selectAll()
        this.renderPage(currentPage)
    }

    ; --- clipboard out --------------------------------------------------------
    fn copySelection:string () {
        return (edit.selectedText())
    }

    fn cutSelection:string () {
        def text:string (edit.selectedText())
        if ((strlen text) > 0) {
            edit.deleteSelection()
            this.followCaret()
        }
        return text
    }

    fn setPage:int (page:int) {
        this.renderPage(page)
        return currentPage
    }

    fn keyUndo:void () {
        edit.undo()
        this.renderPage(currentPage)
    }

    fn keyRedo:void () {
        edit.redo()
        this.renderPage(currentPage)
    }

    ; Clipboard paste from the host. `html` is the text/html flavour (what a
    ; spreadsheet copy puts next to the TSV) and lands as a real table; `text`
    ; is the text/plain fallback. Returns true when something was inserted.
    fn pasteClipboard:boolean (html:string text:string) {
        if ((edit.isEnabled()) == false) {
            return false
        }
        if ((edit.isActive()) == false) {
            return false
        }
        ; A chart first: the HTML a chart copy puts on the clipboard is an
        ; <img> carrying the chart's whole Vela document as an attribute. Read
        ; as a table it would be nothing; read as a picture it would be dead
        ; pixels. Read as what it is, it stays a chart.
        if ((strlen html) > 0) {
            def cdoc:ChartDoc (ChartDocCodec.fromHtml(html))
            if cdoc.ok {
                def json:string (ChartDocCodec.jsonFromHtml(html))
                def made:int (edit.pasteChart(json cdoc.chart.w cdoc.chart.h))
                if (made > 0) {
                    view.selectedChartId = made
                    this.renderPage(currentPage)
                    return true
                }
            }
        }
        def tbl:ClipboardTable (new ClipboardTable)
        def got:boolean false
        if ((strlen html) > 0) {
            got = (tbl.parseHtml(html))
        }
        if (got == false) {
            if (ClipboardTable.looksTabular(text)) {
                got = (tbl.parseTsv(text))
            }
        }
        if got {
            def done:boolean (edit.pasteTable(tbl))
            this.renderPage(currentPage)
            return done
        }
        def typed:boolean (edit.pasteText(text))
        this.renderPage(currentPage)
        return typed
    }

    ; --- charts in the document -----------------------------------------------
    ; Everything a host needs to make a pasted chart editable: find one under
    ; the pointer, select it, and change it. Each edit regenerates the chart's
    ; specification from its own numbers, so what is drawn afterwards is a real
    ; chart of that kind rather than the old picture with a new label.
    fn chartAtPoint:int (x:int y:int) {
        def pg:LaidPage (view.layout.pageAt(view.pageIndex))
        def i:int 0
        while (i < (array_length pg.lines)) {
            def line:LaidLine (itemAt pg.lines i)
            if (line.kind == 6) {
                if (x >= line.x) {
                    if (x <= (line.x + line.width)) {
                        if (y >= line.y) {
                            if (y <= (line.y + line.height)) {
                                return line.chartId
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return 0
    }

    fn selectChart:void (id:int) {
        view.selectedChartId = id
        this.renderPage(currentPage)
    }

    fn selectedChart:int () {
        return view.selectedChartId
    }

    ; Click-to-select, so a chart behaves like the pictures beside it. Returns
    ; true when the click landed on one, so the host knows the caret should not
    ; move there.
    fn clickChart:boolean (x:int y:int) {
        def id:int (this.chartAtPoint(x y))
        if (id == 0) {
            if (view.selectedChartId != 0) {
                view.selectedChartId = 0
                this.renderPage(currentPage)
            }
            return false
        }
        this.selectChart(id)
        return true
    }

    fn editChart:boolean (what:string arg:string) {
        def id:int view.selectedChartId
        if (id == 0) {
            return false
        }
        def done:boolean (edit.editChart(id what arg))
        if done {
            ; The render cache is keyed by chart id and box, and the chart it
            ; describes has changed, so the old picture has to go.
            view.charts.forget(id)
            this.renderPage(currentPage)
        }
        return done
    }

    fn deleteChart:boolean () {
        def id:int view.selectedChartId
        if (id == 0) {
            return false
        }
        def done:boolean (edit.deleteChart(id))
        if done {
            view.charts.forget(id)
            view.selectedChartId = 0
            this.renderPage(currentPage)
        }
        return done
    }

    ; The chart's own document, for a host that wants to show or export it.
    fn chartJson:string (id:int) {
        def c:DocChart (doc.chartById(id))
        return c.json
    }

    fn toggleBold:void () {
        edit.toggleBold()
        this.renderPage(currentPage)
    }

    fn setFont:void (font:string) {
        edit.setFont(font)
        this.renderPage(currentPage)
    }

    fn caretInfoJson:string () {
        if ((edit.isActive()) == false) {
            return "{\"active\":false}"
        }
        def c:DocumentPosition (edit.caret())
        def sel:DocumentRange (edit.selection())
        def a:int (sel.startOffset())
        def b:int (sel.endOffset())
        def boldFlag:string "false"
        if (edit.typingBold) {
            boldFlag = "true"
        }
        return ("{\"active\":true,\"paragraphId\":" + (to_string c.paragraphId) + ",\"offset\":" + (to_string c.textOffset) + ",\"selStart\":" + (to_string a) + ",\"selEnd\":" + (to_string b) + ",\"boldTyping\":" + boldFlag + "}")
    }
}

; ==============================================================================
; DocxViewer - load .docx → RichDocument → SoftCanvas pages.
; ==============================================================================

Import "DocxPackage.rgr"
Import "WordMlParser.rgr"
Import "RichDocument.rgr"
Import "DocxView.rgr"

class DocxViewer {
    def parser:WordMlParser (new WordMlParser)
    def view:DocxView (new DocxView)
    def doc:RichDocument (new RichDocument)
    def lastError:string ""

    Constructor () {
    }

    fn init:void (fontDir:string) {
        view.init(fontDir)
    }

    fn openFile:boolean (dir:string file:string) {
        lastError = ""
        def pkg:DocxPackage (new DocxPackage)
        if ((pkg.open(dir file)) == false) {
            lastError = ("failed to open " + file)
            return false
        }
        if ((pkg.hasPart("word/document.xml")) == false) {
            lastError = "missing word/document.xml"
            pkg.close()
            return false
        }
        doc = (parser.parsePackage(pkg))
        pkg.close()
        if ((strlen doc.title) == 0) {
            doc.title = file
        }
        return true
    }

    fn document:RichDocument () {
        return doc
    }

    fn renderPage:void (page:int) {
        view.present(doc page)
    }

    fn pageCount:int () {
        return (view.layout.pageCount())
    }

    fn writePng:void (dir:string file:string) {
        view.writePng(dir file)
    }

    fn plainText:string () {
        return (doc.plainText())
    }
}

; ==============================================================================
; docx_demo - render sample .docx fixtures to PNG pages.
; ==============================================================================

Import "DocxViewer.rgr"

class DocxDemo {
    sfn renderOne:void (viewer:DocxViewer dir:string file:string outName:string) {
        print ("-- " + file)
        if ((viewer.openFile(dir file)) == false) {
            print ("FAIL open: " + viewer.lastError)
            return
        }
        def d:RichDocument (viewer.document())
        viewer.renderPage(0)
        viewer.writePng("gallery/docx_viewer" outName)
        print ("  paragraphs=" + (to_string (d.paragraphCount())))
        print ("  tables=" + (to_string (array_length d.tables)))
        print ("  pages=" + (to_string (viewer.pageCount())))
        print ("  text: " + (substring (viewer.plainText()) 0 80))
        print ("  wrote gallery/docx_viewer/" + outName)
    }

    sfn main:void () {
        def viewer:DocxViewer (new DocxViewer)
        viewer.init("gallery/pdf_writer/assets/fonts")
        def fix:string "gallery/docx_viewer/fixtures"
        DocxDemo.renderOne(viewer fix "hello.docx" "docx_hello.png")
        DocxDemo.renderOne(viewer fix "styles_demo.docx" "docx_styles.png")
        DocxDemo.renderOne(viewer fix "lists_demo.docx" "docx_lists.png")
        DocxDemo.renderOne(viewer fix "images_demo.docx" "docx_images.png")
        DocxDemo.renderOne(viewer fix "05-table-basic.docx" "docx_table.png")
        DocxDemo.renderOne(viewer fix "20-business-report.docx" "docx_business_p0.png")
        ; page with table/image features when available
        if ((viewer.openFile(fix "20-business-report.docx"))) {
            def n:int (viewer.pageCount())
            def pg:int 0
            if (n > 1) {
                pg = 1
            }
            viewer.renderPage(pg)
            viewer.writePng("gallery/docx_viewer" "docx_business_features.png")
            print ("  wrote business features page " + (to_string pg))
        }
        print "docx_demo done"
    }
}

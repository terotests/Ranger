; ==============================================================================
; DocxLayout - flow layout + simple pagination for RichDocument.
; ==============================================================================

Import "RichDocument.rgr"
Import "WordNumbering.rgr"
Import "../../game_engine/ui/UITextRenderer.rgr"

class LaidLine {
    def paraIndex:int 0
    def text:string ""
    def x:int 0
    def y:int 0
    def baseline:int 0
    def height:int 0
    def spanStart:int 0
    def align:int 0
    def listPrefix:string ""
    ; 0 = text, 1 = image
    def kind:int 0
    def imageIndex:int 0
    def width:int 0

    Constructor () {
    }
}

class LaidPage {
    def index:int 0
    def lines:[LaidLine]
    def width:int 0
    def height:int 0

    Constructor () {
    }
}

class DocxLayout {
    def pages:[LaidPage]
    def tr:UITextRenderer
    def contentW:int 500
    def numbering:WordNumbering (new WordNumbering)

    Constructor () {
    }

    sfn ptToPx:double (pt:double) {
        return ((pt * 96.0) / 72.0)
    }

    fn layout:void (doc:RichDocument textRenderer:UITextRenderer nums:WordNumbering) {
        tr = textRenderer
        numbering = nums
        clear pages
        def page:LaidPage (new LaidPage)
        page.width = (doc.section.pageWidthPx())
        page.height = (doc.section.pageHeightPx())
        page.index = 0
        push pages page

        def ml:int (doc.section.marginLeftPx())
        def mt:int (doc.section.marginTopPx())
        def mr:int (doc.section.marginRightPx())
        def mb:int (doc.section.marginBottomPx())
        contentW = ((page.width - ml) - mr)
        if (contentW < 40) {
            contentW = 40
        }
        def y:int mt
        def maxY:int (page.height - mb)
        def listCounters:[int:int]

        def pi:int 0
        while (pi < (doc.paragraphCount())) {
            def p:Paragraph (doc.paragraphAt(pi))
            def before:int (to_int (DocxLayout.ptToPx(p.spaceBeforePt)))
            def after:int (to_int (DocxLayout.ptToPx(p.spaceAfterPt)))
            y = (y + before)

            def prefix:string ""
            def indent:int (to_int (DocxLayout.ptToPx(p.indentLeftPt)))
            if (p.listNumId > 0) {
                def lv:NumLevel (numbering.levelFor(p.listNumId p.listLevel))
                numbering.bumpCounter(listCounters p.listNumId p.listLevel lv.start)
                prefix = (numbering.formatMarker(p.listNumId p.listLevel listCounters))
            }

            def fontPx:double 14.0
            if ((array_length p.spans) > 0) {
                def s0:TextSpan (itemAt p.spans 0)
                fontPx = (DocxLayout.ptToPx(s0.fontSizePt))
            }
            if (fontPx < 8.0) {
                fontPx = 8.0
            }
            def lh:int (to_int ((tr.lineHeight(fontPx)) + 2.0))
            if (lh < 12) {
                lh = 12
            }

            if ((strlen p.text) > 0) {
                def full:string (prefix + p.text)
                def wrapW:double (to_double (contentW - indent))
                if (wrapW < 40.0) {
                    wrapW = 40.0
                }
                def wrapped:[string] (tr.wrap(full fontPx wrapW))
                if ((array_length wrapped) == 0) {
                    push wrapped ""
                }
                def li:int 0
                while (li < (array_length wrapped)) {
                    if ((y + lh) > maxY) {
                        def np:LaidPage (new LaidPage)
                        np.width = page.width
                        np.height = page.height
                        np.index = (array_length pages)
                        push pages np
                        page = np
                        y = mt
                    }
                    def line:LaidLine (new LaidLine)
                    line.kind = 0
                    line.paraIndex = pi
                    line.text = (itemAt wrapped li)
                    line.height = lh
                    line.y = y
                    line.baseline = (y + (to_int (fontPx * 0.8)))
                    line.align = p.align
                    line.listPrefix = prefix
                    def tw:int (to_int (tr.measureWidth(line.text fontPx)))
                    def x0:int (ml + indent)
                    if (p.align == 1) {
                        x0 = (ml + (to_int (((contentW - indent) - tw) / 2)))
                    }
                    if (p.align == 2) {
                        x0 = (ml + ((contentW - indent) - tw))
                    }
                    if (x0 < ml) {
                        x0 = ml
                    }
                    line.x = x0
                    push page.lines line
                    y = (y + lh)
                    li = (li + 1)
                }
            } {
                if ((array_length p.images) == 0) {
                    ; empty paragraph still advances a bit
                    y = (y + (idiv lh 2))
                }
            }

            ; Images attached to the paragraph (DrawingML)
            def ii:int 0
            while (ii < (array_length p.images)) {
                def dimg:DocImage (itemAt p.images ii)
                def iw:int dimg.widthPx
                def ih:int dimg.heightPx
                if (iw > contentW) {
                    def scale:double ((to_double contentW) / (to_double iw))
                    iw = contentW
                    ih = (to_int ((to_double ih) * scale))
                }
                if ((y + ih) > maxY) {
                    def np2:LaidPage (new LaidPage)
                    np2.width = page.width
                    np2.height = page.height
                    np2.index = (array_length pages)
                    push pages np2
                    page = np2
                    y = mt
                }
                def iline:LaidLine (new LaidLine)
                iline.kind = 1
                iline.paraIndex = pi
                iline.imageIndex = ii
                iline.x = ml
                iline.y = y
                iline.height = ih
                iline.width = iw
                iline.align = p.align
                if (p.align == 1) {
                    iline.x = (ml + (to_int ((contentW - iw) / 2)))
                }
                if (p.align == 2) {
                    iline.x = (ml + (contentW - iw))
                }
                push page.lines iline
                y = (y + ih + 8)
                ii = (ii + 1)
            }

            y = (y + after)
            pi = (pi + 1)
        }
    }

    fn pageCount:int () {
        return (array_length pages)
    }

    fn pageAt:LaidPage (i:int) {
        return (itemAt pages i)
    }
}

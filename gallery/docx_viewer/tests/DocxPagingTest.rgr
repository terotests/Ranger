; ==============================================================================
; DocxPagingTest — reading a document is not editing one, but the keys still
; have to do something.
; ==============================================================================
;
; "Word had a problem: PageDown, or the cursor going down, did not move to the
; next page." It did not, and the reason is one line: every caret movement in
; the viewer asks `edit` to move a caret, and `edit` does nothing at all when
; editing is off. There is no caret in a document you are only reading, so
; there was nothing for the key to move — and nobody had said what it should
; do instead.
;
; What it should do is what it does in every reader: turn the page. The keys
; are the same keys, so nothing above had to learn anything; the key simply
; means something on both sides of the edit switch now. The wheel and a swipe
; are the same question asked with a different gesture, so they arrive as
; travel and the viewer decides when that adds up to a page — deciding it
; there rather than in each host is what keeps the window and the serverless
; page feeling the same.
;
;   npm run docx_viewer:paging:test
; ==============================================================================

Import "../src/DocxViewer.rgr"

class PagingCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class DocxPagingTest {
    sfn open:DocxViewer (name:string) {
        def v:DocxViewer (new DocxViewer)
        if ((v.openFile("gallery/docx_viewer/fixtures" name)) == false) {
            print ("  could not open " + name)
        }
        v.renderPage(0)
        return v
    }

    sfn main:void () {
        def c:PagingCheck (new PagingCheck)
        print "== DocxPagingTest =="

        ; A fixture with more than one page, or none of this can be asked.
        def v:DocxViewer (DocxPagingTest.open("08-pages.docx"))
        def pages:int (v.pageCount())
        print ("  pages=" + (to_string pages))
        c.ok("the fixture has pages to turn" (pages > 1))
        c.ok("reading, not editing" ((v.editMode()) == false))
        c.eqInt("starts on the first page" v.currentPage 0)

        print "-- the keys turn the page --"
        v.keyPageDown(false)
        c.eqInt("PageDown goes forward" v.currentPage 1)
        v.keyPageUp(false)
        c.eqInt("PageUp comes back" v.currentPage 0)
        v.keyDown(false)
        c.eqInt("Down goes forward too" v.currentPage 1)
        v.keyUp(false)
        c.eqInt("Up comes back" v.currentPage 0)
        v.keyRight(false)
        c.eqInt("Right goes forward" v.currentPage 1)
        v.keyLeft(false)
        c.eqInt("Left comes back" v.currentPage 0)
        v.keyEnd(false false)
        c.eqInt("End is the last page" v.currentPage (pages - 1))
        v.keyHome(false false)
        c.eqInt("Home is the first" v.currentPage 0)

        print "-- and stop at the ends --"
        v.keyPageUp(false)
        c.eqInt("there is nothing before the first page" v.currentPage 0)
        def g:int 0
        while (g < (pages + 4)) {
            v.keyPageDown(false)
            g = (g + 1)
        }
        c.eqInt("and nothing after the last" v.currentPage (pages - 1))

        print "-- a wheel or a swipe reads the page down --"
        ; This used to check that travel was BANKED until it was worth a page,
        ; and then the page jumped. That is what a reader complained about: the
        ; paper could not be read down at all, only skipped, and everything
        ; between the two positions went past unseen. A trackpad made it worse,
        ; because whether a page turned depended on how many of its dozens of
        ; small deltas the host had managed to deliver.
        ;
        ; Now the page scrolls and turns when it runs out. `DocxScrollTest`
        ; covers that in full; what belongs here is the paged half of it.
        def w:DocxViewer (DocxPagingTest.open("08-pages.docx"))
        w.viewportH = 400
        c.ok("there is paper below the window" ((w.maxScrollY()) > 0))
        ; A few small deltas — a trackpad sends dozens of these per flick —
        ; move the paper and do not throw the reader through the document.
        def small:int 0
        while (small < 4) {
            w.scrollBy(30)
            small = (small + 1)
        }
        c.eqInt("small gestures move the paper" w.scrollY 120)
        c.eqInt("and turn nothing" w.currentPage 0)
        ; Past the bottom of the page, the next one begins.
        def rest:int ((w.maxScrollY()) - w.scrollY)
        w.scrollBy(rest)
        c.eqInt("still on the first page at its foot" w.currentPage 0)
        c.eqInt("with the whole page above the window" w.scrollY (w.maxScrollY()))
        w.scrollBy(60)
        c.eqInt("and over the edge onto the second" w.currentPage 1)
        w.scrollBy(-500)
        c.eqInt("and back" w.currentPage 0)
        c.ok("a zero delta is not a gesture" ((w.scrollBy(0)) == false))

        ; A host that ships whole pages — the PNG one — sets no viewport, and
        ; that is its way of saying there is nothing to scroll within a page.
        ; Every gesture then turns exactly one page, which is the behaviour
        ; that host wants and the one it used to get by accident.
        def pg:DocxViewer (DocxPagingTest.open("08-pages.docx"))
        c.eqInt("with no viewport there is no room" (pg.maxScrollY()) 0)
        pg.scrollBy(40)
        c.eqInt("so one gesture is one page" pg.currentPage 1)
        pg.scrollBy(40)
        c.eqInt("and the next is the next" pg.currentPage 2)

        print "-- editing still edits --"
        def e:DocxViewer (DocxPagingTest.open("08-pages.docx"))
        e.setEditMode(true)
        c.ok("edit mode is on" (e.editMode()))
        def startPage:int e.currentPage
        e.keyRight(false)
        ; A caret step inside the first page must not turn it.
        c.eqInt("Right moves the caret, not the page" e.currentPage startPage)

        print ""
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

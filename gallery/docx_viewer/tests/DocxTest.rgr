; ==============================================================================
; DocxTest - parse + layout checks for the DOCX viewer prototype.
; ==============================================================================

Import "../src/DocxViewer.rgr"
Import "../src/WordXml.rgr"
Import "../src/WordMlParser.rgr"
Import "../src/WordNumbering.rgr"
Import "../src/WordStyleResolver.rgr"
Import "../src/RichDocument.rgr"
Import "../src/DocxLayout.rgr"
Import "../src/ClipboardTable.rgr"
Import "../src/DocxTextMetrics.rgr"
Import "../../text_editor/src/TextEditCore.rgr"

class Checker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }
}

class DocxTest {
    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen hay)
        def m:int (strlen needle)
        if (m == 0) {
            return true
        }
        if (m > n) {
            return false
        }
        def i:int 0
        while (i <= (n - m)) {
            if ((substring hay i (i + m)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; List marker DocxLayout painted for a paragraph ("2. ", "- ", …), or "".
    sfn markerOf:string (v:DocxViewer paragraphId:int) {
        def pi:int 0
        while (pi < (v.view.layout.pageCount())) {
            def pg:LaidPage (v.view.layout.pageAt(pi))
            def li:int 0
            while (li < (array_length pg.lines)) {
                def ln:LaidLine (itemAt pg.lines li)
                if (ln.paraIndex == paragraphId) {
                    if (ln.docStart == 0) {
                        return ln.listPrefix
                    }
                }
                li = (li + 1)
            }
            pi = (pi + 1)
        }
        return ""
    }

    sfn main:void () {
        def c:Checker (new Checker)
        def fix:string "gallery/docx_viewer/fixtures"

        print "== WordXml entities =="
        c.eqStr("lt" (WordXml.decodeEntities("a&lt;b")) "a<b")
        c.eqStr("amp" (WordXml.decodeEntities("x&amp;y")) "x&y")

        print "== style basedOn chain + loop guard =="
        def stylesXml:string "<w:styles xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\"><w:docDefaults><w:rPrDefault><w:rPr><w:sz w:val=\"22\"/></w:rPr></w:rPrDefault></w:docDefaults><w:style w:type=\"paragraph\" w:styleId=\"Normal\"><w:name w:val=\"Normal\"/><w:rPr><w:sz w:val=\"22\"/></w:rPr></w:style><w:style w:type=\"paragraph\" w:styleId=\"BaseA\"><w:basedOn w:val=\"Normal\"/><w:rPr><w:b/><w:color w:val=\"112233\"/></w:rPr></w:style><w:style w:type=\"paragraph\" w:styleId=\"ChildB\"><w:basedOn w:val=\"BaseA\"/><w:pPr><w:jc w:val=\"center\"/></w:pPr><w:rPr><w:sz w:val=\"28\"/></w:rPr></w:style><w:style w:type=\"paragraph\" w:styleId=\"LoopX\"><w:basedOn w:val=\"LoopY\"/></w:style><w:style w:type=\"paragraph\" w:styleId=\"LoopY\"><w:basedOn w:val=\"LoopX\"/></w:style></w:styles>"
        def res:WordStyleResolver (new WordStyleResolver)
        res.parseStylesXml(stylesXml)
        def ps:ResolvedParagraphStyle (res.resolveParagraphStyle("ChildB"))
        c.ok("child inherit bold" ps.run.bold)
        c.eqStr("child inherit color" ps.run.colorHex "112233")
        c.ok("child size override" (ps.run.fontSizePt == 14.0))
        c.eqInt("child align center" ps.align 1)
        def loopPs:ResolvedParagraphStyle (res.resolveParagraphStyle("LoopX"))
        c.ok("loop does not hang" ((strlen loopPs.run.colorHex) >= 0))

        print "== parse hello.docx =="
        def viewer:DocxViewer (new DocxViewer)
        viewer.init("gallery/pdf_writer/assets/fonts")
        c.ok("open hello" (viewer.openFile(fix "hello.docx")))
        def doc:RichDocument (viewer.document())
        c.ok("has paragraphs" ((doc.paragraphCount()) >= 3))
        def plain:string (doc.plainText())
        c.ok("has Hello" ((indexOf plain "Hello") >= 0))
        c.ok("has world" ((indexOf plain "world") >= 0))
        def p0:Paragraph (doc.paragraphAt(0))
        c.ok("title has spans" ((array_length p0.spans) >= 1))
        def p1:Paragraph (doc.paragraphAt(1))
        def hasBold:boolean false
        def si:int 0
        while (si < (array_length p1.spans)) {
            def sp:TextSpan (itemAt p1.spans si)
            if sp.bold {
                hasBold = true
            }
            si = (si + 1)
        }
        c.ok("mixed run bold" hasBold)

        print "== styles_demo align =="
        c.ok("open styles" (viewer.openFile(fix "styles_demo.docx")))
        def d2:RichDocument (viewer.document())
        def foundCenter:boolean false
        def foundRight:boolean false
        def i:int 0
        while (i < (d2.paragraphCount())) {
            def p:Paragraph (d2.paragraphAt(i))
            if (p.align == 1) {
                foundCenter = true
            }
            if (p.align == 2) {
                foundRight = true
            }
            i = (i + 1)
        }
        c.ok("has center" foundCenter)
        c.ok("has right" foundRight)

        print "== lists_demo =="
        c.ok("open lists" (viewer.openFile(fix "lists_demo.docx")))
        def d3:RichDocument (viewer.document())
        def bullets:int 0
        def nums:int 0
        def nested:int 0
        def j:int 0
        while (j < (d3.paragraphCount())) {
            def lp:Paragraph (d3.paragraphAt(j))
            if (lp.listKind == 1) {
                bullets = (bullets + 1)
            }
            if (lp.listKind == 2) {
                nums = (nums + 1)
            }
            if (lp.listLevel > 0) {
                nested = (nested + 1)
            }
            j = (j + 1)
        }
        c.eqInt("bullet paras" bullets 3)
        c.ok("numbered paras>=3" (nums >= 3))
        c.ok("nested list level" (nested >= 2))
        def markers:string ""
        def counters:[int:int]
        def mj:int 0
        while (mj < (d3.paragraphCount())) {
            def mp:Paragraph (d3.paragraphAt(mj))
            if (mp.listNumId == 3) {
                def lv:NumLevel (viewer.numbering.levelFor(mp.listNumId mp.listLevel))
                viewer.numbering.bumpCounter(counters mp.listNumId mp.listLevel lv.start)
                markers = (markers + (viewer.numbering.formatMarker(mp.listNumId mp.listLevel counters)))
                markers = (markers + "|")
            }
            mj = (mj + 1)
        }
        c.ok("outline has 1." ((indexOf markers "1.") >= 0))
        c.ok("outline has letter" ((indexOf markers "a)") >= 0) || ((indexOf markers "1.a") >= 0))

        print "== images_demo =="
        c.ok("open images" (viewer.openFile(fix "images_demo.docx")))
        def d4:RichDocument (viewer.document())
        def imgCount:int 0
        def okImg:int 0
        def k:int 0
        while (k < (d4.paragraphCount())) {
            def ip:Paragraph (d4.paragraphAt(k))
            def ii:int 0
            while (ii < (array_length ip.images)) {
                imgCount = (imgCount + 1)
                def dimg:DocImage (itemAt ip.images ii)
                if dimg.ok {
                    okImg = (okImg + 1)
                }
                ii = (ii + 1)
            }
            k = (k + 1)
        }
        c.eqInt("image count" imgCount 1)
        c.eqInt("decoded jpeg" okImg 1)

        print "== tables =="
        c.ok("open table basic" (viewer.openFile(fix "05-table-basic.docx")))
        def dt:RichDocument (viewer.document())
        c.ok("has table" ((array_length dt.tables) >= 1))
        def t0:DocumentTable (itemAt dt.tables 0)
        c.ok("table rows>=2" ((array_length t0.rows) >= 2))
        c.ok("table cols" ((array_length t0.colWidthsTwips) >= 2))
        viewer.renderPage(0)
        c.ok("table page painted" ((buffer_length (viewer.view.raw())) > 1000))

        c.ok("open table merged" (viewer.openFile(fix "07-table-merged.docx")))
        def dm:RichDocument (viewer.document())
        def hasSpan:boolean false
        def ti:int 0
        while (ti < (array_length dm.tables)) {
            def tm:DocumentTable (itemAt dm.tables ti)
            def ri:int 0
            while (ri < (array_length tm.rows)) {
                def row:DocTableRow (itemAt tm.rows ri)
                def ci:int 0
                while (ci < (array_length row.cells)) {
                    def cell:DocTableCell (itemAt row.cells ci)
                    if (cell.gridSpan > 1) {
                        hasSpan = true
                    }
                    ci = (ci + 1)
                }
                ri = (ri + 1)
            }
            ti = (ti + 1)
        }
        c.ok("gridSpan present" hasSpan)

        print "== pagination =="
        c.ok("open pages" (viewer.openFile(fix "08-pages.docx")))
        viewer.renderPage(0)
        c.ok("multi page" ((viewer.pageCount()) >= 2))
        c.ok("open page break" (viewer.openFile(fix "09-page-break.docx")))
        viewer.renderPage(0)
        c.ok("page break pages>=2" ((viewer.pageCount()) >= 2))

        print "== landscape / sections =="
        c.ok("open landscape" (viewer.openFile(fix "10-landscape-section.docx")))
        def dl:RichDocument (viewer.document())
        def foundLand:boolean false
        def si2:int 0
        while (si2 < (dl.sectionCount())) {
            def sec:DocSection (dl.sectionAt(si2))
            if sec.landscape {
                foundLand = true
            }
            if (sec.pageWTwips > sec.pageHTwips) {
                foundLand = true
            }
            si2 = (si2 + 1)
        }
        c.ok("landscape section" foundLand)
        viewer.renderPage(0)
        c.ok("landscape pages>=1" ((viewer.pageCount()) >= 1))

        print "== header/footer =="
        c.ok("open hf" (viewer.openFile(fix "12-header-footer.docx")))
        def dh:RichDocument (viewer.document())
        def hfOk:boolean false
        def hi:int 0
        while (hi < (dh.sectionCount())) {
            def hs:DocSection (dh.sectionAt(hi))
            if ((array_length hs.headerParas) > 0) {
                hfOk = true
            }
            if ((array_length hs.footerParas) > 0) {
                hfOk = true
            }
            hi = (hi + 1)
        }
        c.ok("header or footer paras" hfOk)
        viewer.renderPage(0)
        c.ok("hf render" ((buffer_length (viewer.view.raw())) > 1000))

        print "== mixed images =="
        c.ok("open mixed images" (viewer.openFile(fix "13-images-mixed.docx")))
        def di:RichDocument (viewer.document())
        def imgs:int 0
        def okImgs:int 0
        def pngOk:boolean false
        def mi:int 0
        while (mi < (di.paragraphCount())) {
            def mp2:Paragraph (di.paragraphAt(mi))
            def ii2:int 0
            while (ii2 < (array_length mp2.images)) {
                imgs = (imgs + 1)
                def im:DocImage (itemAt mp2.images ii2)
                if im.ok {
                    okImgs = (okImgs + 1)
                }
                if (im.format == "png") {
                    if im.ok {
                        pngOk = true
                    }
                }
                ii2 = (ii2 + 1)
            }
            mi = (mi + 1)
        }
        c.ok("mixed image count>=2" (imgs >= 2))
        c.ok("decoded images>=1" (okImgs >= 1))
        c.ok("png decoded or jpeg fallback" (pngOk || (okImgs >= 1)))

        print "== business report =="
        c.ok("open report" (viewer.openFile(fix "20-business-report.docx")))
        def dr:RichDocument (viewer.document())
        c.ok("report tables" ((array_length dr.tables) >= 1))
        c.ok("report blocks" ((dr.blockCount()) >= 5))
        viewer.renderPage(0)
        c.ok("report multipage" ((viewer.pageCount()) >= 3))
        c.ok("inspect json" ((indexOf (viewer.inspectJson()) "paragraphs") >= 0))

        print "== edit core (single paragraph) =="
        c.ok("open hello for edit" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def edoc:RichDocument (viewer.document())
        def epara:Paragraph (edoc.paragraphAt(1))
        def before:string epara.text
        viewer.edit.setCaret(epara.id 0)
        viewer.typeText("X")
        def after:string ((viewer.document().paragraphAt(1)).text)
        c.ok("insert at start" ((indexOf after "X") == 0))
        viewer.keyBackspace()
        c.eqStr("backspace restores" ((viewer.document().paragraphAt(1)).text) before)
        viewer.edit.setCaret(epara.id (strlen ((viewer.document().paragraphAt(1)).text)))
        def countBefore:int (viewer.document().paragraphCount())
        viewer.keyEnter()
        c.ok("enter split paras" ((viewer.document().paragraphCount()) > countBefore))
        ; re-open clean for remaining tests
        c.ok("reopen hello" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(false)

        print "== hit-test table cells (x box, not last-on-row) =="
        c.ok("open table for hit" (viewer.openFile(fix "05-table-basic.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def hitLayout:DocxLayout viewer.view.layout
        def hitPage:LaidPage (hitLayout.pageAt(0))
        def leftLine:LaidLine
        def rightLine:LaidLine
        def havePair:boolean false
        def hi:int 0
        while (hi < (array_length hitPage.lines)) {
            def hl:LaidLine (itemAt hitPage.lines hi)
            if (hl.kind == 0) {
                if (hl.boxW > 20) {
                    if ((strlen hl.text) > 0) {
                        def hj:int (hi + 1)
                        while (hj < (array_length hitPage.lines)) {
                            def hr:LaidLine (itemAt hitPage.lines hj)
                            if (hr.kind == 0) {
                                if (hr.y == hl.y) {
                                    if (hr.boxX > (hl.boxX + 10)) {
                                        if (hr.boxW > 20) {
                                            if ((strlen hr.text) > 0) {
                                                leftLine = hl
                                                rightLine = hr
                                                havePair = true
                                                hj = (array_length hitPage.lines)
                                                hi = (array_length hitPage.lines)
                                            }
                                        }
                                    }
                                }
                            }
                            hj = (hj + 1)
                        }
                    }
                }
            }
            hi = (hi + 1)
        }
        c.ok("same-row cell pair" havePair)
        if havePair {
            def lx:int (leftLine.boxX + (idiv leftLine.boxW 2))
            def ly:int (leftLine.y + (idiv leftLine.height 2))
            def rx:int (rightLine.boxX + (idiv rightLine.boxW 2))
            def ry:int (rightLine.y + (idiv rightLine.height 2))
            def hitL:DocumentPosition (viewer.edit.hitTest(hitLayout 0 lx ly))
            def hitR:DocumentPosition (viewer.edit.hitTest(hitLayout 0 rx ry))
            c.eqInt("click left cell" hitL.paragraphId leftLine.paraIndex)
            c.eqInt("click right cell" hitR.paragraphId rightLine.paraIndex)
            c.ok("left != right cell" (hitL.paragraphId != hitR.paragraphId))
        }
        viewer.setEditMode(false)

        print "== edit preserves run style on backspace =="
        c.ok("open styles for edit" (viewer.openFile(fix "styles_demo.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def sdoc:RichDocument (viewer.document())
        def titleP:Paragraph (sdoc.paragraphAt(0))
        def titleId:int titleP.id
        def titleBefore:string titleP.text
        c.ok("title has text" ((strlen titleBefore) > 3))
        def titleSpan0:TextSpan (itemAt titleP.spans 0)
        def titleSize:double titleSpan0.fontSizePt
        def titleBold:boolean titleSpan0.bold
        c.ok("title sized or styled" ((titleSize > 11.0) || titleBold || ((strlen titleP.styleId) > 0)))
        viewer.edit.setCaret(titleId (strlen titleBefore))
        viewer.keyBackspace()
        def titleAfter:Paragraph ((viewer.document().paragraphAt(0)))
        c.eqInt("backspace shortens" (strlen titleAfter.text) ((strlen titleBefore) - 1))
        c.ok("title still has spans" ((array_length titleAfter.spans) >= 1))
        def titleSpan1:TextSpan (itemAt titleAfter.spans 0)
        c.ok("font size preserved" (titleSpan1.fontSizePt == titleSize))
        c.ok("bold flag preserved" (titleSpan1.bold == titleBold))

        print "== selection + bold =="
        c.ok("reopen hello for sel" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def hdoc:RichDocument (viewer.document())
        def hp:Paragraph (hdoc.paragraphAt(1))
        def bodyText:string hp.text
        c.ok("body text" ((strlen bodyText) > 5))
        viewer.edit.setRange(hp.id 0 5)
        def sel:DocumentRange (viewer.edit.selection())
        c.ok("selection not collapsed" ((sel.isCollapsed()) == false))
        c.eqInt("sel start" (sel.startOffset()) 0)
        c.eqInt("sel end" (sel.endOffset()) 5)
        viewer.toggleBold()
        def hp2:Paragraph ((viewer.document().paragraphAt(1)))
        c.ok("range is bold" (viewer.edit.adapter.rangeIsBold(hp2.id 0 5)))
        viewer.renderPage(0)
        c.ok("bold render" ((buffer_length (viewer.view.raw())) > 1000))
        viewer.setEditMode(false)

        print "== measurement follows the painted face (mixed runs) =="
        c.ok("open styles for metrics" (viewer.openFile(fix "styles_demo.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def mdoc:RichDocument (viewer.document())
        ; Build a paragraph whose second half is bold: measuring it in one face
        ; is wrong, which is what used to misplace the caret in bold runs.
        def mp:Paragraph (mdoc.paragraphAt(1))
        mp.text = "regularBOLDTEXT"
        clear mp.spans
        def spA:TextSpan (TextSpan.create(0 7))
        spA.bold = false
        push mp.spans spA
        def spB:TextSpan (TextSpan.create(7 15))
        spB.bold = true
        push mp.spans spB
        viewer.renderPage(0)
        def mtr:UITextRenderer viewer.view.ctx.tr
        def sizePx:double 16.0
        def wholeSpanAware:int (DocxTextMetrics.measureRange(mtr mp sizePx 0 15))
        def headW:int (DocxTextMetrics.measureRange(mtr mp sizePx 0 7))
        def tailW:int (DocxTextMetrics.measureRange(mtr mp sizePx 7 15))
        c.ok("range splits at the run boundary" (wholeSpanAware == (headW + tailW)))
        ; Same characters measured entirely in the regular face: the bold tail
        ; is wider, so a single-face measure under-reports the line.
        DocxTextMetrics.applyFace(mtr false)
        def wholeOneFace:int (to_int (mtr.measureWidth("regularBOLDTEXT" sizePx)))
        c.ok("bold run is wider than one-face measure" (wholeSpanAware > wholeOneFace))
        ; offsetAtX must invert measureRange exactly, on both sides of the run
        ; boundary — this is what makes a click land on the right character.
        def probe:int 0
        def inverseOk:boolean true
        while (probe <= 15) {
            def px:int (DocxTextMetrics.measureRange(mtr mp sizePx 0 probe))
            def back:int (DocxTextMetrics.offsetAtX(mtr mp sizePx 0 15 px))
            if (back != probe) {
                inverseOk = false
            }
            probe = (probe + 1)
        }
        c.ok("offsetAtX inverts measureRange at every offset" inverseOk)
        def midBold:int (DocxTextMetrics.measureRange(mtr mp sizePx 0 11))
        c.eqInt("click inside the bold run" (DocxTextMetrics.offsetAtX(mtr mp sizePx 0 15 midBold)) 11)
        c.eqInt("click before the text" (DocxTextMetrics.offsetAtX(mtr mp sizePx 0 15 -20)) 0)
        c.eqInt("click past the end" (DocxTextMetrics.offsetAtX(mtr mp sizePx 0 15 100000)) 15)
        viewer.setEditMode(false)

        print "== arrow keys move and extend =="
        c.ok("open pages for arrows" (viewer.openFile(fix "08-pages.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def adoc:RichDocument (viewer.document())
        def ap0:Paragraph (adoc.paragraphAt(0))
        viewer.edit.setCaret(ap0.id 0)
        viewer.keyRight(false)
        def c1:DocumentPosition (viewer.edit.caret())
        c.eqInt("right moves one char" c1.textOffset 1)
        viewer.keyLeft(false)
        c.eqInt("left moves back" ((viewer.edit.caret()).textOffset) 0)
        ; Left at offset 0 of the first paragraph has nowhere to go.
        viewer.keyLeft(false)
        c.eqInt("left at doc start holds" ((viewer.edit.caret()).textOffset) 0)
        ; Right at the end of a paragraph steps into the next one.
        def ap0len:int (strlen ap0.text)
        viewer.edit.setCaret(ap0.id ap0len)
        viewer.keyRight(false)
        def c2:DocumentPosition (viewer.edit.caret())
        c.ok("right crosses into next paragraph" (c2.paragraphId != ap0.id))
        c.eqInt("lands at its start" c2.textOffset 0)
        viewer.keyLeft(false)
        def c3:DocumentPosition (viewer.edit.caret())
        c.eqInt("left crosses back" c3.paragraphId ap0.id)
        c.eqInt("to the paragraph end" c3.textOffset ap0len)
        ; Shift+Right extends instead of moving.
        viewer.edit.setCaret(ap0.id 0)
        viewer.keyRight(true)
        viewer.keyRight(true)
        def asel:DocumentRange (viewer.edit.selection())
        c.ok("shift right extends" ((asel.isCollapsed()) == false))
        c.eqInt("anchor stays" asel.anchor.textOffset 0)
        c.eqInt("focus moved" asel.focus.textOffset 2)
        ; A bare arrow collapses the selection to its edge.
        viewer.keyLeft(false)
        c.ok("bare arrow collapses" ((viewer.edit.selection()).isCollapsed()))
        c.eqInt("collapses to start" ((viewer.edit.caret()).textOffset) 0)

        print "== up / down keep the column and cross pages =="
        viewer.edit.setCaret(ap0.id 0)
        viewer.keyDown(false)
        def d1:DocumentPosition (viewer.edit.caret())
        c.ok("down moved somewhere" ((d1.paragraphId != ap0.id) || (d1.textOffset != 0)))
        viewer.keyUp(false)
        def u1:DocumentPosition (viewer.edit.caret())
        c.eqInt("up returns to the first paragraph" u1.paragraphId ap0.id)
        ; Walk down far enough to leave page 0 on a multi-page fixture.
        c.ok("fixture is multipage" ((viewer.pageCount()) > 1))
        def steps:int 0
        while (steps < 400) {
            viewer.keyDown(false)
            steps = (steps + 1)
        }
        c.ok("down reached a later page" ((viewer.pageOfCaret()) > 0))
        def lastPara:DocumentPosition (viewer.edit.caret())
        c.ok("caret still valid" (lastPara.paragraphId > 0))

        print "== Home / End / Ctrl+Home / Ctrl+End =="
        viewer.setPage(0)
        def hdoc2:RichDocument (viewer.document())
        def hpara:Paragraph (hdoc2.paragraphAt(1))
        viewer.edit.setCaret(hpara.id 3)
        viewer.keyEnd(false false)
        def he:DocumentPosition (viewer.edit.caret())
        c.ok("end is at or past the caret" (he.textOffset >= 3))
        viewer.keyHome(false false)
        def hh:DocumentPosition (viewer.edit.caret())
        c.ok("home is at or before the caret" (hh.textOffset <= 3))
        viewer.keyEnd(false true)
        def ce:DocumentPosition (viewer.edit.caret())
        def lastOrder:int ((viewer.edit.adapter.bodyParagraphCount()) - 1)
        c.eqInt("ctrl end is the last paragraph" ce.paragraphId (viewer.edit.adapter.bodyParagraphIdAt(lastOrder)))
        ; Ctrl+End must also bring the VIEW to the caret's page. Wrapping can
        ; drop trailing characters, leaving the caret past the last laid line —
        ; that used to resolve to "no line" and the view stayed put.
        def endPage:int (viewer.pageOfCaret())
        c.ok("ctrl end followed onto a later page" (endPage > 0))
        c.ok("caret geometry resolves there" ((viewer.edit.caretPixelX(viewer.view.layout endPage)) >= 0))
        c.ok("caret height resolves there" ((viewer.edit.caretHeight(viewer.view.layout endPage)) > 0))
        def endPara:Paragraph (viewer.edit.adapter.findParagraph(ce.paragraphId))
        def probeAt:[int]
        viewer.edit.findLineFor(viewer.view.layout ce.paragraphId (strlen endPara.text) probeAt)
        c.ok("offset past the last laid line still finds one" ((itemAt probeAt 0) >= 0))
        viewer.keyHome(false true)
        def ch2:DocumentPosition (viewer.edit.caret())
        c.eqInt("ctrl home is the first paragraph" ch2.paragraphId (viewer.edit.adapter.bodyParagraphIdAt(0)))
        c.eqInt("at offset 0" ch2.textOffset 0)
        c.eqInt("ctrl home followed back to page 0" (viewer.pageOfCaret()) 0)

        print "== PageDown / PageUp step by a page of lines =="
        viewer.setPage(0)
        viewer.edit.setCaret((viewer.edit.adapter.bodyParagraphIdAt(0)) 0)
        def beforePage:int (viewer.pageOfCaret())
        viewer.keyPageDown(false)
        def afterDown:DocumentPosition (viewer.edit.caret())
        c.ok("page down moved the caret" (afterDown.paragraphId > 0))
        def downOrder:int (viewer.edit.adapter.bodyOrderOf(afterDown.paragraphId))
        c.ok("page down advanced" (downOrder > 0))
        viewer.keyPageUp(false)
        def afterUp:DocumentPosition (viewer.edit.caret())
        def upOrder:int (viewer.edit.adapter.bodyOrderOf(afterUp.paragraphId))
        c.ok("page up came back" (upOrder < downOrder))

        print "== multi-paragraph selection =="
        c.ok("reopen hello for multisel" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def sdoc:RichDocument (viewer.document())
        def sp0:Paragraph (sdoc.paragraphAt(0))
        def sp1:Paragraph (sdoc.paragraphAt(1))
        viewer.edit.setCaret(sp0.id 2)
        viewer.edit.sel.focus = (DocumentPosition.create(sp1.id 4))
        c.ok("selection spans paragraphs" (viewer.edit.spansParagraphs()))
        def multiText:string (viewer.edit.selectedText())
        c.ok("selected text has a newline" (DocxTest.hasSub(multiText "\n")))
        c.ok("starts inside the first paragraph" (DocxTest.hasSub(multiText (substring sp0.text 2 (strlen sp0.text)))))
        c.ok("ends inside the second" (DocxTest.hasSub(multiText (substring sp1.text 0 4))))
        ; Backwards drag must give the same text.
        viewer.edit.sel.anchor = (DocumentPosition.create(sp1.id 4))
        viewer.edit.sel.focus = (DocumentPosition.create(sp0.id 2))
        c.eqStr("backwards drag reads the same" (viewer.edit.selectedText()) multiText)
        viewer.renderPage(0)
        c.ok("multi selection paints" ((buffer_length (viewer.view.raw())) > 1000))

        print "== delete across paragraphs joins them =="
        def p0Before:string sp0.text
        def p1Before:string sp1.text
        def blocksBeforeDel:int (sdoc.blockCount())
        viewer.edit.sel.anchor = (DocumentPosition.create(sp0.id 2))
        viewer.edit.sel.focus = (DocumentPosition.create(sp1.id 4))
        viewer.edit.deleteSelection()
        def joined:Paragraph (viewer.edit.adapter.findParagraph(sp0.id))
        c.eqStr("joined text" joined.text ((substring p0Before 0 2) + (substring p1Before 4 (strlen p1Before))))
        c.eqInt("one block fewer" (sdoc.blockCount()) (blocksBeforeDel - 1))
        c.eqInt("caret at the join" ((viewer.edit.caret()).textOffset) 2)
        viewer.keyUndo()
        def restored0:Paragraph (viewer.edit.adapter.findParagraph(sp0.id))
        c.eqStr("undo restores the first paragraph" restored0.text p0Before)
        c.eqInt("undo restores the block" (sdoc.blockCount()) blocksBeforeDel)

        print "== select all + copy / cut =="
        c.ok("reopen hello for copy" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def cdoc:RichDocument (viewer.document())
        def cp0:Paragraph (cdoc.paragraphAt(0))
        viewer.edit.setCaret(cp0.id 0)
        viewer.keySelectAll()
        def allText:string (viewer.copySelection())
        c.ok("select all copied something" ((strlen allText) > 10))
        c.ok("copy spans paragraphs" (DocxTest.hasSub(allText "\n")))
        c.ok("copy does not change the document" ((strlen cp0.text) > 0))
        ; Cut hands back the same text and empties the document body.
        viewer.keySelectAll()
        def cutText:string (viewer.cutSelection())
        c.eqStr("cut returns the selection" cutText allText)
        def afterCut:Paragraph (viewer.edit.adapter.findParagraph(cp0.id))
        c.eqInt("cut emptied the text" (strlen afterCut.text) 0)
        viewer.keyUndo()
        c.ok("undo restores after cut" ((strlen ((viewer.edit.adapter.findParagraph(cp0.id)).text)) > 0))
        viewer.setEditMode(false)

        print "== the caret can reach an image =="
        c.ok("open images fixture" (viewer.openFile(fix "images_demo.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        ; Find a laid picture line.
        def imgPage:int -1
        def imgIdx:int -1
        def ip0:int 0
        while (ip0 < (viewer.view.layout.pageCount())) {
            def ipg:LaidPage (viewer.view.layout.pageAt(ip0))
            def il0:int 0
            while (il0 < (array_length ipg.lines)) {
                def iln:LaidLine (itemAt ipg.lines il0)
                if (iln.kind == 1) {
                    if (imgPage < 0) {
                        imgPage = ip0
                        imgIdx = il0
                    }
                }
                il0 = (il0 + 1)
            }
            ip0 = (ip0 + 1)
        }
        c.ok("fixture has a picture" (imgPage >= 0))
        def ipg2:LaidPage (viewer.view.layout.pageAt(imgPage))
        def picture:LaidLine (itemAt ipg2.lines imgIdx)
        def picPara:Paragraph (unwrap picture.paragraphRef)
        c.ok("picture belongs to a paragraph" (picPara.id > 0))
        ; Clicking the left half lands before it, the right half behind it —
        ; picture lines used to be invisible to the hit-test entirely.
        viewer.setPage(imgPage)
        def leftX:int (picture.x + (idiv picture.width 4))
        def midY:int (picture.y + (idiv picture.height 2))
        def hitLeft:DocumentPosition (viewer.edit.hitTest(viewer.view.layout imgPage leftX midY))
        c.eqInt("click on the picture finds its paragraph" hitLeft.paragraphId picPara.id)
        c.eqInt("left half is before it" hitLeft.textOffset 0)
        def rightX:int ((picture.x + picture.width) - (idiv picture.width 4))
        def hitRight:DocumentPosition (viewer.edit.hitTest(viewer.view.layout imgPage rightX midY))
        c.eqInt("right half is the same paragraph" hitRight.paragraphId picPara.id)
        c.eqInt("and sits behind it" hitRight.textOffset (strlen picPara.text))
        ; With the caret there, Enter adds an empty line next to the picture.
        def blocksBeforeImg:int ((viewer.document()).blockCount())
        viewer.edit.setCaret(picPara.id (strlen picPara.text))
        viewer.keyEnter()
        def afterImgDoc:RichDocument (viewer.document())
        c.eqInt("Enter next to a picture adds a paragraph" (afterImgDoc.blockCount()) (blocksBeforeImg + 1))
        def newLinePos:DocumentPosition (viewer.edit.caret())
        def newLinePara:Paragraph (viewer.edit.adapter.findParagraph(newLinePos.paragraphId))
        c.eqInt("and it is empty" (strlen newLinePara.text) 0)
        viewer.typeText("after the picture")
        c.eqStr("which can be typed into" newLinePara.text "after the picture")
        viewer.renderPage(imgPage)
        c.ok("still renders" ((buffer_length (viewer.view.raw())) > 1000))
        viewer.setEditMode(false)

        print "== Enter inside a list makes a new list item =="
        c.ok("open lists fixture" (viewer.openFile(fix "lists_demo.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def ldoc:RichDocument (viewer.document())
        ; Find a decimal-numbered item and the one after it in the same list.
        def numId:int 0
        def firstNum:int 0
        def secondNum:int 0
        def li2:int 0
        while (li2 < (ldoc.paragraphCount())) {
            def lp:Paragraph (ldoc.paragraphAt(li2))
            if (lp.listNumId > 0) {
                if (lp.listFmt == "decimal") {
                    if (firstNum == 0) {
                        firstNum = lp.id
                        numId = lp.listNumId
                    } {
                        if (secondNum == 0) {
                            if (lp.listNumId == numId) {
                                if (lp.listLevel == 0) {
                                    secondNum = lp.id
                                }
                            }
                        }
                    }
                }
            }
            li2 = (li2 + 1)
        }
        c.ok("found a numbered list" (firstNum > 0))
        c.ok("with a following item" (secondNum > 0))
        def markerBefore:string (DocxTest.markerOf(viewer secondNum))
        c.eqStr("second item numbered 2" markerBefore "2. ")
        ; Enter at the end of the first item, then type: Word makes item 2 and
        ; pushes the old 2 down to 3.
        viewer.edit.setCaret(firstNum (viewer.edit.adapter.textLength(firstNum)))
        viewer.keyEnter()
        viewer.typeText("inserted item")
        def newPos:DocumentPosition (viewer.edit.caret())
        def newPara:Paragraph (viewer.edit.adapter.findParagraph(newPos.paragraphId))
        c.ok("new paragraph is a list item" (newPara.listNumId > 0))
        c.eqInt("same list" newPara.listNumId numId)
        c.eqInt("same level" newPara.listLevel 0)
        c.eqStr("same format" newPara.listFmt "decimal")
        c.eqStr("new item text" newPara.text "inserted item")
        viewer.renderPage(0)
        c.eqStr("new item numbered 2" (DocxTest.markerOf(viewer newPara.id)) "2. ")
        c.eqStr("the old item 2 became 3" (DocxTest.markerOf(viewer secondNum)) "3. ")
        c.ok("no unnumbered gap" ((strlen (DocxTest.markerOf(viewer newPara.id))) > 0))

        print "== Enter on an empty list item leaves the list =="
        ; Caret is at the end of "inserted item"; Enter gives an empty item,
        ; and Enter again should drop out of the list (Word).
        viewer.keyEnter()
        def emptyPos:DocumentPosition (viewer.edit.caret())
        def emptyPara:Paragraph (viewer.edit.adapter.findParagraph(emptyPos.paragraphId))
        c.ok("empty item is still in the list" (emptyPara.listNumId > 0))
        c.eqInt("and is empty" (strlen emptyPara.text) 0)
        viewer.keyEnter()
        c.eqInt("second Enter ends the list" emptyPara.listNumId 0)
        c.eqInt("no marker left" (strlen emptyPara.listFmt) 0)
        viewer.renderPage(0)
        c.eqStr("and paints no marker" (DocxTest.markerOf(viewer emptyPara.id)) "")
        viewer.keyUndo()
        c.ok("undo puts it back in the list" (emptyPara.listNumId > 0))
        viewer.setEditMode(false)

        print "== Tab moves between table cells =="
        c.ok("open table fixture" (viewer.openFile(fix "05-table-basic.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def tdoc:RichDocument (viewer.document())
        def tbl0:DocumentTable (itemAt tdoc.tables 0)
        def trow0:DocTableRow (itemAt tbl0.rows 0)
        def tc00:DocTableCell (itemAt trow0.cells 0)
        def tp00:Paragraph (itemAt tc00.paragraphs 0)
        def tc01:DocTableCell (itemAt trow0.cells 1)
        def tp01:Paragraph (itemAt tc01.paragraphs 0)
        ; Cell paragraphs are not body blocks, so plain caret order cannot see
        ; them — Tab is the way across.
        c.eqInt("cell paragraph has no body order" (viewer.edit.adapter.bodyOrderOf(tp00.id)) -1)
        def cellAt:[int]
        viewer.edit.adapter.tableCellOf(tp00.id cellAt)
        c.ok("locates the table block" ((itemAt cellAt 0) >= 0))
        c.eqInt("row 0" (itemAt cellAt 1) 0)
        c.eqInt("cell 0" (itemAt cellAt 2) 0)
        viewer.edit.setCaret(tp00.id 0)
        c.ok("caret is in a table" (viewer.caretInTable()))
        c.ok("tab consumed" (viewer.keyTab(false)))
        def afterTab:DocumentPosition (viewer.edit.caret())
        c.eqInt("tab moved to the next cell" afterTab.paragraphId tp01.id)
        ; Word selects the cell contents so typing replaces them.
        def tabSel:DocumentRange (viewer.edit.selection())
        c.ok("cell contents selected" ((tabSel.isCollapsed()) == false))
        c.eqInt("selection starts at 0" (tabSel.startOffset()) 0)
        c.eqInt("selection covers the cell" (tabSel.endOffset()) (strlen tp01.text))
        c.eqStr("selected text is the cell" (viewer.edit.selectedText()) tp01.text)
        ; Shift+Tab goes back.
        viewer.keyTab(true)
        c.eqInt("shift tab returns" ((viewer.edit.caret()).paragraphId) tp00.id)

        print "== Tab wraps rows and leaves the table =="
        def lastRowIdx:int ((array_length tbl0.rows) - 1)
        def lastRow:DocTableRow (itemAt tbl0.rows lastRowIdx)
        def lastCellIdx:int ((array_length lastRow.cells) - 1)
        ; End of a row continues on the next row's first cell.
        def row0Last:DocTableCell (itemAt trow0.cells ((array_length trow0.cells) - 1))
        def row0LastPara:Paragraph (itemAt row0Last.paragraphs 0)
        def row1:DocTableRow (itemAt tbl0.rows 1)
        def row1First:DocTableCell (itemAt row1.cells 0)
        def row1FirstPara:Paragraph (itemAt row1First.paragraphs 0)
        viewer.edit.setCaret(row0LastPara.id 0)
        viewer.keyTab(false)
        c.eqInt("tab wraps to the next row" ((viewer.edit.caret()).paragraphId) row1FirstPara.id)
        ; Shift+Tab from the first cell of a row goes back to the previous row's last cell.
        viewer.keyTab(true)
        c.eqInt("shift tab wraps back" ((viewer.edit.caret()).paragraphId) row0LastPara.id)
        ; Word never tabs out the bottom of a table — it adds a row.
        def rowsBefore:int (array_length tbl0.rows)
        def lastCell:DocTableCell (itemAt lastRow.cells lastCellIdx)
        def lastCellPara:Paragraph (itemAt lastCell.paragraphs 0)
        viewer.edit.setCaret(lastCellPara.id 0)
        viewer.keyTab(false)
        c.eqInt("a row was appended" (array_length tbl0.rows) (rowsBefore + 1))
        def newRow:DocTableRow (itemAt tbl0.rows rowsBefore)
        c.eqInt("new row matches the column count" (array_length newRow.cells) (array_length lastRow.cells))
        def newFirst:DocTableCell (itemAt newRow.cells 0)
        def newFirstPara:Paragraph (itemAt newFirst.paragraphs 0)
        c.eqInt("caret is in the new row" ((viewer.edit.caret()).paragraphId) newFirstPara.id)
        c.eqStr("new cell starts empty" newFirstPara.text "")
        c.ok("still inside the table" (viewer.caretInTable()))
        viewer.renderPage(0)
        c.ok("renders with the new row" ((buffer_length (viewer.view.raw())) > 1000))
        ; Typing into the fresh cell works like any other.
        viewer.typeText("added")
        c.eqStr("typed into the new cell" newFirstPara.text "added")
        viewer.keyUndo()
        viewer.keyUndo()
        c.eqInt("undo removes the appended row" (array_length tbl0.rows) rowsBefore
)
        viewer.setEditMode(false)
        c.ok("tab is inert outside edit mode" ((viewer.keyTab(false)) == false))

        print "== page index never names a page that does not exist =="
        c.ok("open pages for clamp" (viewer.openFile(fix "08-pages.docx")))
        viewer.renderPage(0)
        def pc:int (viewer.pageCount())
        c.ok("fixture is multipage" (pc > 1))
        viewer.renderPage((pc - 1))
        c.eqInt("last page renders as itself" viewer.currentPage (pc - 1))
        ; present() clamps an out-of-range page to the last one. If currentPage
        ; kept the requested index the host would advertise a page that renders
        ; as a copy of the last one — the duplicated-page report.
        viewer.renderPage((pc + 3))
        c.eqInt("past the end reports the last page" viewer.currentPage (pc - 1))
        viewer.renderPage(-5)
        c.eqInt("before the start reports page 0" viewer.currentPage 0)
        c.eqInt("setPage returns what it drew" (viewer.setPage(999)) (pc - 1))
        c.eqInt("pageOfCaret stays in range" (viewer.pageOfCaret()) viewer.currentPage)

        print "== adding rows paginates without duplicating content =="
        c.ok("reopen hello for growth" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def gdoc:RichDocument (viewer.document())
        def lastIdx:int ((gdoc.paragraphCount()) - 1)
        def growPara:Paragraph (gdoc.paragraphAt(lastIdx))
        viewer.edit.setCaret(growPara.id (strlen growPara.text))
        c.eqInt("starts on one page" (viewer.pageCount()) 1)
        def added:int 0
        while (added < 90) {
            viewer.keyEnter()
            viewer.typeText(("appended row " + (to_string added) + " with enough text to fill out the line"))
            added = (added + 1)
        }
        c.ok("grew past one page" ((viewer.pageCount()) > 1))
        ; Every laid body line is a slice (paragraph, docStart, docEnd). The same
        ; slice appearing twice is literally the same text on two pages.
        def seen:[string]
        def dups:int 0
        def gp:int 0
        while (gp < (viewer.view.layout.pageCount())) {
            def gpage:LaidPage (viewer.view.layout.pageAt(gp))
            def gl:int 0
            while (gl < (array_length gpage.lines)) {
                def gln:LaidLine (itemAt gpage.lines gl)
                if (gln.kind == 0) {
                    if (gln.paraIndex > 0) {
                        def key:string ((((to_string gln.paraIndex) + ":") + (to_string gln.docStart)) + "-" + (to_string gln.docEnd))
                        def si2:int 0
                        def found2:boolean false
                        while (si2 < (array_length seen)) {
                            if ((itemAt seen si2) == key) {
                                found2 = true
                            }
                            si2 = (si2 + 1)
                        }
                        if found2 {
                            dups = (dups + 1)
                        } {
                            push seen key
                        }
                    }
                }
                gl = (gl + 1)
            }
            gp = (gp + 1)
        }
        c.eqInt("no line laid on two pages" dups 0)
        ; Each page must also hold something of its own.
        def emptyPages:int 0
        def ep:int 0
        while (ep < (viewer.view.layout.pageCount())) {
            def epage:LaidPage (viewer.view.layout.pageAt(ep))
            def bodyLines:int 0
            def el:int 0
            while (el < (array_length epage.lines)) {
                def eln:LaidLine (itemAt epage.lines el)
                if (eln.kind == 0) {
                    if (eln.paraIndex > 0) {
                        bodyLines = (bodyLines + 1)
                    }
                }
                el = (el + 1)
            }
            if (bodyLines == 0) {
                emptyPages = (emptyPages + 1)
            }
            ep = (ep + 1)
        }
        c.eqInt("no blank page" emptyPages 0)
        viewer.setEditMode(false)

        print "== clipboard HTML → ClipboardTable =="
        ; Exactly what gallery/datagrid GridApp.copySelection puts on the
        ; text/html flavour of the clipboard.
        def gridHtml:string "<table border=\"1\" cellspacing=\"0\" cellpadding=\"4\"><tr><td style=\"background-color:#DDEBF7;font-weight:bold;\">Region</td><td style=\"font-weight:bold;\">Q1</td></tr><tr><td>North &amp; South</td><td style=\"text-align:right;\">1&lt;2</td></tr></table>"
        def ct:ClipboardTable (new ClipboardTable)
        c.ok("parses grid html" (ct.parseHtml(gridHtml)))
        c.eqInt("rows" (ct.rowCount()) 2)
        c.eqInt("cols" (ct.columnCount()) 2)
        def r0:ClipRow (ct.rowAt(0))
        def cell00:ClipCell (itemAt r0.cells 0)
        c.eqStr("header text" cell00.text "Region")
        c.ok("header bold" cell00.bold)
        c.eqStr("header fill" cell00.fillHex "DDEBF7")
        def r1:ClipRow (ct.rowAt(1))
        def cell10:ClipCell (itemAt r1.cells 0)
        c.eqStr("entity decode &" cell10.text "North & South")
        def cell11:ClipCell (itemAt r1.cells 1)
        c.eqStr("entity decode <" cell11.text "1<2")
        c.eqStr("align right" cell11.align "right")

        print "== clipboard HTML from Excel itself =="
        ; Excel's real shape: <style> block, fragment comments, unquoted and
        ; single-quoted attributes, void <col>, <b> inside a cell.
        def excelHtml:string "<html xmlns:o=\"urn:schemas-microsoft-com:office:office\"><head><meta charset=utf-8><style>.xl65 { color:red; }</style></head><body><table border=0 cellpadding=0 cellspacing=0 width=192 style='border-collapse:collapse'><!--StartFragment--><col width=64><col width=64><tr height=20 style='height:15.0pt'><td height=20 width=64 style='height:15.0pt;background:#FFFF00'><b>Item</b></td><td colspan=2 style='text-align:center'>Cost&nbsp;A</td></tr><tr><td>Bolt</td><td>1.25</td><td>x</td></tr><!--EndFragment--></table></body></html>"
        def ex:ClipboardTable (new ClipboardTable)
        c.ok("parses excel html" (ex.parseHtml(excelHtml)))
        c.eqInt("excel rows" (ex.rowCount()) 2)
        c.eqInt("excel cols (colspan counted)" (ex.columnCount()) 3)
        def er0:ClipRow (ex.rowAt(0))
        def ec00:ClipCell (itemAt er0.cells 0)
        c.eqStr("excel cell text" ec00.text "Item")
        c.ok("excel <b> detected" ec00.bold)
        c.eqStr("excel bare-attr fill" ec00.fillHex "FFFF00")
        def ec01:ClipCell (itemAt er0.cells 1)
        c.eqInt("excel colspan" ec01.gridSpan 2)
        c.eqStr("nbsp decoded" ec01.text "Cost A")
        c.ok("style block not treated as text" ((ex.rowCount()) == 2))

        print "== clipboard TSV fallback =="
        def tsv:ClipboardTable (new ClipboardTable)
        c.ok("tsv looks tabular" (ClipboardTable.looksTabular("a\tb")))
        c.ok("plain line is not tabular" ((ClipboardTable.looksTabular("hello")) == false))
        c.ok("parses tsv" (tsv.parseTsv("a\tb\nc\td\n")))
        c.eqInt("tsv rows" (tsv.rowCount()) 2)
        c.eqInt("tsv cols" (tsv.columnCount()) 2)
        def tr1:ClipRow (tsv.rowAt(1))
        def tc1:ClipCell (itemAt tr1.cells 1)
        c.eqStr("tsv cell" tc1.text "d")

        print "== paste a spreadsheet selection as a new table =="
        c.ok("reopen hello for paste" (viewer.openFile(fix "hello.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def pdoc:RichDocument (viewer.document())
        def blocksBefore:int (pdoc.blockCount())
        def target:Paragraph (pdoc.paragraphAt(1))
        def targetLen:int (strlen target.text)
        viewer.edit.setCaret(target.id targetLen)
        c.ok("paste html" (viewer.pasteClipboard(gridHtml "Region\tQ1\nNorth & South\t1<2")))
        def pdoc2:RichDocument (viewer.document())
        ; split adds a paragraph block, paste adds a table block
        c.eqInt("two blocks added" (pdoc2.blockCount()) (blocksBefore + 2))
        def tblBlock:int -1
        def bi2:int 0
        while (bi2 < (pdoc2.blockCount())) {
            def blk:DocBlock (pdoc2.blockAt(bi2))
            if (blk.kind == 1) {
                tblBlock = bi2
            }
            bi2 = (bi2 + 1)
        }
        c.ok("table block present" (tblBlock >= 0))
        def newTbl:DocumentTable ((pdoc2.blockAt(tblBlock)).table)
        c.eqInt("table rows" (newTbl.rowCount()) 2)
        c.eqInt("table cols" (newTbl.columnCount()) 2)
        def trow0:DocTableRow (itemAt newTbl.rows 0)
        def tcell0:DocTableCell (itemAt trow0.cells 0)
        def tcellPara:Paragraph (itemAt tcell0.paragraphs 0)
        c.eqStr("cell paragraph text" tcellPara.text "Region")
        c.eqStr("cell fill carried" tcell0.fillHex "DDEBF7")
        def cellSpan:TextSpan (itemAt tcellPara.spans 0)
        c.ok("cell bold carried" cellSpan.bold)
        c.ok("column widths set" ((array_length newTbl.colWidthsTwips) == 2))
        c.ok("widths positive" ((itemAt newTbl.colWidthsTwips 0) > 0))
        ; the table must sit before the paragraph the caret moved to
        def caretPos:DocumentPosition (viewer.edit.caret())
        def caretBlock:int (viewer.edit.adapter.blockIndexOfParagraph(caretPos.paragraphId))
        c.ok("caret paragraph follows the table" (caretBlock > tblBlock))
        viewer.renderPage(0)
        c.ok("renders with table" ((buffer_length (viewer.view.raw())) > 1000))
        c.ok("still paginates" ((viewer.pageCount()) >= 1))

        print "== undo removes the pasted table =="
        viewer.keyUndo()
        def pdoc3:RichDocument (viewer.document())
        c.eqInt("blocks back to start" (pdoc3.blockCount()) blocksBefore)
        def stillTable:boolean false
        def bi3:int 0
        while (bi3 < (pdoc3.blockCount())) {
            def blk3:DocBlock (pdoc3.blockAt(bi3))
            if (blk3.kind == 1) {
                stillTable = true
            }
            bi3 = (bi3 + 1)
        }
        c.ok("table gone" (stillTable == false))
        def rejoined:Paragraph (viewer.edit.adapter.findParagraph(target.id))
        c.eqInt("paragraph rejoined" (strlen rejoined.text) targetLen)
        viewer.renderPage(0)
        c.ok("renders after undo" ((buffer_length (viewer.view.raw())) > 1000))
        viewer.setEditMode(false)

        print "== paste needs an active caret =="
        c.ok("reopen for guard" (viewer.openFile(fix "hello.docx")))
        c.ok("no paste without edit mode" ((viewer.pasteClipboard(gridHtml "")) == false))

        print "== render page =="
        c.ok("open hello again" (viewer.openFile(fix "hello.docx")))
        viewer.renderPage(0)
        c.ok("framebuffer" ((buffer_length (viewer.view.raw())) > 1000))
        c.ok("pages>=1" ((viewer.pageCount()) >= 1))

        ; --- glyphs a text face does not have --------------------------------
        ;
        ; Word writes its bullet levels as geometric shapes — ● ○ ▪ — and Open
        ; Sans has none of them, so every list drew a column of empty boxes;
        ; an emoji in running text drew one too. `FontManager` has had
        ; per-codepoint fallback all along; what was missing was a face to fall
        ; back TO.
        print "== glyphs that need a fallback face =="
        c.ok("open the glyph fixture" (viewer.openFile(fix "22-glyph-fallback.docx")))
        def tr:UITextRenderer viewer.view.ctx.tr
        def digitW:double (tr.measureWidth("0" 24.0))
        def circle:double (tr.measureWidth("●" 24.0))
        def ring:double (tr.measureWidth("○" 24.0))
        def square:double (tr.measureWidth("▪" 24.0))
        def emoji:double (tr.measureWidth((EVGCodepoint.toStr(128518)) 24.0))
        c.ok("a filled circle measures as a real glyph" (circle > (digitW * 0.5)))
        c.ok("a hollow one too" (ring > (digitW * 0.5)))
        c.ok("and a small square" (square > 2.0))
        c.ok("an emoji is wider than a digit" (emoji > digitW))
        ; A codepoint NOTHING has must still measure and still draw, rather
        ; than reading glyph tables out of a face that was never loaded.
        def weird:double (tr.measureWidth((EVGCodepoint.toStr(984567)) 24.0))
        c.ok("a codepoint no face has still measures" (weird >= 0.0))
        viewer.renderPage(0)
        c.ok("and the page with all of them draws" ((buffer_length (viewer.view.raw())) > 1000))

        ; --- twips round, they do not truncate --------------------------------
        ;
        ; Fifteen twips to the pixel, so anything not a multiple of fifteen
        ; lands between two — and `to_int` floors, which also sends a negative
        ; outdent a whole pixel the wrong way.
        print "== twips to pixels =="
        c.eqInt("a whole inch is 96px" (DocxLayout.twipsToPx(1440)) 96)
        c.eqInt("half an inch is 48" (DocxLayout.twipsToPx(720)) 48)
        c.eqInt("160 twips rounds up, not down" (DocxLayout.twipsToPx(160)) 11)
        c.eqInt("100 twips rounds to 7" (DocxLayout.twipsToPx(100)) 7)
        c.eqInt("an outdent rounds away from zero" (DocxLayout.twipsToPx(0 - 100)) (0 - 7))
        c.eqInt("and a small one does not become a pixel" (DocxLayout.twipsToPx(0 - 40)) (0 - 3))
        c.eqInt("an inch of EMU is 96px" (DocImage.emuToPx(914400)) 96)
        c.eqInt("and a negative one is -96" (DocImage.emuToPx(0 - 914400)) (0 - 96))

        ; --- the layout is kept until the document changes ---------------------
        ;
        ; Drawing one page used to lay out ALL of them, so a frame cost what
        ; the document was long. The document says when it has moved on, and
        ; that number is the whole dependency.
        print "== the layout is not rebuilt to draw the same page =="
        c.ok("open a document with several pages" (viewer.openFile(fix "08-pages.docx")))
        viewer.renderPage(0)
        def rev0:int (viewer.document()).revision
        def pages0:int (viewer.pageCount())
        viewer.renderPage(0)
        c.ok("drawing again changes nothing" (((viewer.document()).revision) == rev0))
        c.ok("and the pages are still there" ((viewer.pageCount()) == pages0))
        viewer.setEditMode(true)
        viewer.clickAt(120 120 false)
        viewer.typeText("z")
        def rev1:int (viewer.document()).revision
        c.ok("typing says the document moved on" (rev1 > rev0))
        viewer.keyUndo()
        c.ok("and so does undoing it" ((((viewer.document()).revision)) > rev1))
        viewer.setEditMode(false)

        ; --- a laid line names exactly the text it paints ----------------------
        ;
        ; Every map between a pixel and a document offset is built on this:
        ; `line.text` is what gets drawn, `[docStart, docEnd)` is what the
        ; caret, the click and the selection measure. They have to be the same
        ; characters.
        ;
        ; They were not. `tr.wrap` breaks at a space and DROPS it, and the
        ; layout advanced its cursor by the chunk's own length, so line two of
        ; a paragraph claimed to start one character before it did — and the
        ; error accumulated, so by the fourth wrapped line the offsets were two
        ; characters behind the glyphs. The caret drew two characters right of
        ; where it belonged, a click landed on a different character than the
        ; one under the pointer, and typing put the text in where the offsets
        ; said rather than where the caret was: a word appeared a couple of
        ; letters to the left, inside the previous one.
        ;
        ; 208 of this document's 290 lines were wrong.
        print "== a laid line names exactly the text it paints =="
        c.ok("open a document that wraps a lot" (viewer.openFile(fix "20-business-report.docx")))
        viewer.renderPage(0)
        def lineChecked:int 0
        def lineBad:int 0
        def firstBad:string ""
        def lp:int 0
        while (lp < (viewer.view.layout.pageCount())) {
            def lpage:LaidPage (viewer.view.layout.pageAt(lp))
            def lni:int 0
            while (lni < (array_length lpage.lines)) {
                def lline:LaidLine (itemAt lpage.lines lni)
                if (lline.kind == 0) {
                    def lpara:Paragraph lline.paragraphRef
                    if (lpara.id > 0) {
                        def shown:string lline.text
                        if ((strlen lline.listPrefix) > 0) {
                            if ((indexOf shown lline.listPrefix) == 0) {
                                shown = (substring shown (strlen lline.listPrefix) (strlen shown))
                            }
                        }
                        def la:int lline.docStart
                        def lb:int lline.docEnd
                        if (lb > (strlen lpara.text)) {
                            lb = (strlen lpara.text)
                        }
                        def named:string ""
                        if (lb > la) {
                            named = (substring lpara.text la lb)
                        }
                        lineChecked = (lineChecked + 1)
                        if (shown != named) {
                            lineBad = (lineBad + 1)
                            if ((strlen firstBad) == 0) {
                                firstBad = (("painted '" + shown) + ("' but named '" + named) + "'")
                            }
                        }
                    }
                }
                lni = (lni + 1)
            }
            lp = (lp + 1)
        }
        c.ok("there are wrapped lines to check" (lineChecked > 100))
        if (lineBad > 0) {
            print ("    " + firstBad)
        }
        c.eqInt("every line names the text it paints" lineBad 0)

        ; --- dragging the mouse paints a selection -----------------------------
        ;
        ; Two halves, and both were missing. The app only ever looked at a
        ; PRESS, so a move with the button held did nothing at all; and
        ; extending gave up when the two ends were in different paragraphs and
        ; collapsed to a caret, so even a shift-click could not select across a
        ; paragraph break — though every edit below it handles such a range.
        print "== dragging selects, across paragraphs too =="
        c.ok("open the report to select in" (viewer.openFile(fix "20-business-report.docx")))
        viewer.setEditMode(true)
        viewer.renderPage(0)
        def dragPage:LaidPage (viewer.view.layout.pageAt(0))
        def firstLine:int -1
        def laterLine:int -1
        def dl:int 0
        while (dl < (array_length dragPage.lines)) {
            def dline:LaidLine (itemAt dragPage.lines dl)
            if (dline.kind == 0) {
                def dpara:Paragraph dline.paragraphRef
                if ((dpara.id > 0) && ((strlen dline.text) > 8)) {
                    if (firstLine < 0) {
                        firstLine = dl
                    } {
                        if (laterLine < 0) {
                            def firstOne:LaidLine (itemAt dragPage.lines firstLine)
                            def firstPara:Paragraph firstOne.paragraphRef
                            if (dpara.id != firstPara.id) {
                                laterLine = dl
                            }
                        }
                    }
                }
            }
            dl = (dl + 1)
        }
        c.ok("two lines in different paragraphs to drag between" ((firstLine >= 0) && (laterLine >= 0)))
        if ((firstLine >= 0) && (laterLine >= 0)) {
            def from:LaidLine (itemAt dragPage.lines firstLine)
            def to:LaidLine (itemAt dragPage.lines laterLine)
            viewer.clickAt((from.x + 4) (from.y + 2) false)
            def anchorPara:int ((viewer.edit.caret()).paragraphId)
            c.ok("the press put a caret down" (anchorPara > 0))
            c.ok("and nothing is selected yet" ((viewer.edit.selection()).isCollapsed()))
            ; The drag, ending in a different paragraph further down.
            viewer.dragTo((to.x + 20) (to.y + 2))
            c.ok("dragging selected something" (((viewer.edit.selection()).isCollapsed()) == false))
            def startAt:[int]
            def endAt:[int]
            viewer.edit.orderedEnds(startAt endAt)
            c.ok("the selection spans two paragraphs" ((itemAt startAt 0) != (itemAt endAt 0)))
            c.eqInt("and it starts where the press was" (itemAt startAt 0) anchorPara)
            ; Dragging back onto the first line collapses it again.
            viewer.dragTo((from.x + 4) (from.y + 2))
            c.ok("dragging back to the press point clears it" ((viewer.edit.selection()).isCollapsed()))
        }
        viewer.setEditMode(false)

        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

; ==============================================================================
; docx_bench — what a long document costs to edit
; ==============================================================================
;
; The instrument the pptx side grew in its scale phase, pointed at this one.
; The question is the same and cannot be argued about: WHICH of these numbers
; follow the size of the document?
;
;   layout           the whole document laid out from scratch
;   page frame       one page's display list — what a host pays per frame
;   keystroke        a character typed, through the editor
;   undo             one step back
;   page turn        moving to another page and drawing it
;
;   npm run docx:bench
;   npm run docx:bench -- 2000
; ==============================================================================

Import "../src/DocxViewer.rgr"

class DocxBench {
    sfn report:void (name:string ms:double) {
        def whole:int (to_int ms)
        def frac:int (to_int ((ms - (to_double whole)) * 100.0))
        if (frac < 0) {
            frac = (0 - frac)
        }
        def f:string (to_string frac)
        while ((strlen f) < 2) {
            f = ("0" + f)
        }
        print (("  " + name + ": " + (to_string whole) + "." + f + " ms"))
    }

    sfn per:void (name:string ms:double n:int) {
        if (n <= 0) {
            return
        }
        DocxBench.report(name (ms / (to_double n)))
    }

    ; A document of `n` paragraphs, a heading every tenth, and a run of bold in
    ; each — about what a report carries, and enough of them that a per-frame
    ; walk over the whole document shows up in the number.
    sfn buildDoc:RichDocument (n:int) {
        def doc (new RichDocument)
        def i:int 0
        while (i < n) {
            def p:Paragraph (doc.addParagraph())
            if ((i % 10) == 0) {
                p.styleId = "Heading1"
                p.text = ("Section " + (to_string ((idiv i 10) + 1)))
            } {
                p.styleId = "Normal"
                p.text = ("Paragraph " + (to_string (i + 1)) + " of a report long enough that laying it all out for every frame would be the thing that costs.")
            }
            def span (new TextSpan)
            span.start = 0
            span.end = (strlen p.text)
            if ((i % 10) == 0) {
                span.bold = true
            }
            push p.spans span
            i = (i + 1)
        }
        return doc
    }

    sfn main:void () {
        def n:int 500
        def argCount:int (shell_arg_cnt)
        if (argCount > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                n = (unwrap parsed)
            }
        }
        print ("== docx_bench paragraphs=" + (to_string n) + " ==")

        def v (new DocxViewer())
        def t0:double (wall_clock_ms)
        v.init("gallery/pdf_writer/assets/fonts")
        def t1:double (wall_clock_ms)
        DocxBench.report("init + fonts" (t1 - t0))

        def t2:double (wall_clock_ms)
        def doc:RichDocument (DocxBench.buildDoc(n))
        def t3:double (wall_clock_ms)
        DocxBench.report("build the document" (t3 - t2))

        def t4:double (wall_clock_ms)
        v.attachDocument(doc)
        def t5:double (wall_clock_ms)
        DocxBench.report("attach + first layout" (t5 - t4))
        print ("  paragraphs=" + (to_string (array_length doc.paragraphs)) + " pages=" + (to_string (v.pageCount())))

        ; --- frames -------------------------------------------------------------
        def frames:int 30
        def t6:double (wall_clock_ms)
        def f:int 0
        while (f < frames) {
            def dl:EVGDisplayList (v.pageDisplayList(0))
            f = (f + 1)
        }
        def t7:double (wall_clock_ms)
        DocxBench.per("page frame" (t7 - t6) frames)

        ; --- editing ------------------------------------------------------------
        v.setEditMode(true)
        v.clickAt(120 120 false)
        def keys:int 60
        def t8:double (wall_clock_ms)
        def k:int 0
        while (k < keys) {
            v.typeText("x")
            k = (k + 1)
        }
        def t9:double (wall_clock_ms)
        DocxBench.per("keystroke (with the page redrawn)" (t9 - t8) keys)

        def undos:int 30
        def tA:double (wall_clock_ms)
        def u:int 0
        while (u < undos) {
            v.keyUndo()
            u = (u + 1)
        }
        def tB:double (wall_clock_ms)
        DocxBench.per("undo" (tB - tA) undos)

        ; --- paging -------------------------------------------------------------
        def pages:int 20
        def tC:double (wall_clock_ms)
        def p2:int 0
        while (p2 < pages) {
            def want:int (p2 % (v.pageCount()))
            v.renderPage(want)
            p2 = (p2 + 1)
        }
        def tD:double (wall_clock_ms)
        DocxBench.per("turn the page + draw (20 different pages)" (tD - tC) pages)
        ; …and the same count of turns over TWO pages. A page turn is the
        ; rasterizer, not the document: what differs between these two numbers
        ; is how many pages' worth of glyphs had to be rendered for the first
        ; time, and what does not differ is the length of the document.
        def tE:double (wall_clock_ms)
        def p3:int 0
        while (p3 < pages) {
            v.renderPage((p3 % 2))
            p3 = (p3 + 1)
        }
        def tF:double (wall_clock_ms)
        DocxBench.per("turn the page + draw (between two pages)" (tF - tE) pages)
        print "done"
    }
}

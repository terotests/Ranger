; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxRenderApi — the same decks, drawn. PNG now, PDF beside it.
; ==============================================================================
;
; This is the half of the published surface that needs a rasterizer and fonts,
; kept apart from `PptxApi` on purpose. That file imports a ZIP reader, an XML
; parser and a writer; this one imports a canvas, a font manager and an image
; decoder. A build step that rewrites the text of a template pays for the first
; and not the second, and the split is what makes that true — in Ranger an
; import is not lazy, so the only way to not carry something is to not name it.
;
; WHY FONTS ARE PASSED IN RATHER THAN FOUND. There is no file system in a
; browser, and this has to work in one: the playground draws the deck it just
; generated. So a renderer is given its faces — `useFontDir` on a desktop where
; a directory exists, `addFont` / `addFace` everywhere else — and a renderer
; with no faces at all still draws, in the bitmap fallback, rather than
; refusing. That fallback is visibly wrong, which is the intended outcome: a
; blank page and a page in the wrong font are both wrong, and only one of them
; tells you why.
;
; WHY THE FACE POOL MATTERS AND NOT ONLY THE FAMILY. `FontManager` falls back
; per CODEPOINT across every loaded face. An emoji, a geometric bullet and an
; Arabic letter are each absent from a Latin text face, so a deck containing
; one draws `.notdef` — a filled box — unless a face that HAS the codepoint is
; in the pool. `useFontDir` loads that pool; a caller adding faces by hand has
; to add them too, and `standardFaces` names the ones this repository ships.
; ==============================================================================

Import "PptxApi.rgr"
Import "../src/PptxView.rgr"
Import "../../pdf_writer/src/raster/PNGEncoder.rgr"
Import "../../pdf_writer/src/raster/RasterBuffer.rgr"
Import "../../pdf_writer/src/core/EVGPDFRenderer.rgr"
Import "../../office/export/EVGListToElements.rgr"

class PptxRenderer {
    ; The slide painter — the same one the desktop editor and the browser build
    ; draw with, so a PNG from here and a screenshot of the editor are the same
    ; picture.
    def view:PptxView (new PptxView())
    def ready:boolean false
    def error:string ""
    ; Whether the last PDF carried the deck's pictures. True since
    ; `EVGPDFRenderer.registerImage` — the renderer used to resolve a picture's
    ; `src` as a path on disk while a document names its pictures by package
    ; part, so there was no way to give it the bytes at all and a deck with a
    ; logo on it died on ENOENT. It is still a field rather than a constant
    ; because a picture this reader could not DECODE is still one the PDF will
    ; not have, and a caller is entitled to know before sending the file.
    def imagesPrinted:boolean true

    Constructor () {
        view.initBare(64 64)
    }

    ; Every face in a directory laid out the way this repository's font
    ; assets are: the four Open Sans styles as the text family, then the
    ; emoji, bullet and Arabic faces joined to the fallback pool.
    ;
    ; `gallery/pdf_writer/assets/fonts` is that directory.
    fn useFontDir:PptxRenderer (dir:string) {
        view.init(64 64 dir)
        ready = true
        return this
    }

    ; One face, named, from its bytes. The first call for a family makes that
    ; family; later calls with the same name add its bold, italic and bold
    ; italic — `FontManager` keys a face by family AND style.
    fn addFont:PptxRenderer (family:string data:buffer) {
        def got:boolean (view.ctx.tr.loadFontBytes(family data))
        if got {
            ready = true
        } {
            error = ("the bytes given for " + family + " are not a font this reader can load")
        }
        return this
    }

    ; A face that joins the per-codepoint fallback pool WITHOUT becoming a
    ; family anything is drawn in. This is how an emoji face is added: text
    ; stays in the text font and a 😀 is answered from here.
    fn addFace:PptxRenderer (data:buffer) {
        def got:boolean (view.ctx.tr.addFaceBytes(data))
        if (got == false) {
            error = "the bytes given are not a font this reader can load"
        }
        return this
    }

    ; The faces this repository ships and every editor here loads, in the order
    ; they are loaded — which is the order the fallback walk takes them in.
    ; Handed out so a browser can fetch exactly this list and be sure it
    ; measures what the desktop measures.
    sfn standardFaces:[string] () {
        def out:[string] (
            [] _:string (
                "Open_Sans/OpenSans-Regular.ttf"
                "Open_Sans/OpenSans-Bold.ttf"
                "Open_Sans/OpenSans-Italic.ttf"
                "Open_Sans/OpenSans-BoldItalic.ttf"
                "Noto_Emoji/NotoEmoji-Regular.ttf"
                "Noto_Sans/NotoSans-Regular.ttf"
                "El_Messiri/ElMessiri-Regular.ttf"
                "El_Messiri/ElMessiri-Bold.ttf"
            )
        )
        return out
    }

    ; The 187 preset geometries, as the catalogue text. Without it the painter
    ; falls back to the hand-written table and every shape the specification
    ; defines and nobody typed in comes out as a rectangle.
    ; `gallery/office/geom/assets/presets.txt` is the file.
    fn usePresets:PptxRenderer (text:string) {
        view.converter.loadPresets(text)
        return this
    }

    ; --- PNG --------------------------------------------------------------------
    ;
    ; `scale` is a multiplier on 96 dots per inch, which is what a slide point
    ; means on a screen: 1.0 gives a 960pt-wide deck at 1280 pixels, 2.0 at
    ; 2560. It is not a pixel width on purpose — a deck's pages can differ in
    ; size, and a caller asking for "twice as sharp" means that whatever the
    ; page is.
    fn toPng:buffer (deck:PptxDeck index:int scale:double) {
        def empty:buffer (buffer_alloc 0)
        if (deck.ok == false) {
            error = "the deck is not open"
            return empty
        }
        def slideRef:PptxSlideRef (deck.slideAt(index))
        if ((slideRef.exists()) == false) {
            error = ("there is no slide " + (to_string index))
            return empty
        }
        def s:double scale
        if (s <= 0.0) {
            s = 1.0
        }
        def slide:PptxSlide (slideRef.model())
        ; The pictures the slide draws have to be in the painter's cache before
        ; it paints, or every image on the page comes out as an empty box. The
        ; presentation is passed rather than the slide so a picture shared with
        ; a master or a layout is found too.
        view.cachePresentationImages(deck.pres)
        view.renderOracleSlide(slide s)
        def rb (new RasterBuffer)
        rb.width = view.pageW
        rb.height = view.pageH
        rb.pixels = (view.raw())
        def png (new PNGEncoder)
        return (png.encodeToBuffer(rb))
    }

    fn pngWidth:int () {
        return view.pageW
    }

    fn pngHeight:int () {
        return view.pageH
    }

    ; --- PDF --------------------------------------------------------------------
    ;
    ; One slide, as a vector page at the slide's own size — a 960x540pt deck
    ; becomes a 960x540pt page, because a PDF unit IS a typographic point and
    ; a deck already states its size in them. Nothing is rasterized: the text
    ; is text a reader can select and search, and the shapes are path
    ; operators.
    ;
    ; The route is DISPLAY LIST, not the element tree `slideToEvg` builds.
    ; That distinction is the whole reason this works: the display list is what
    ; the software canvas, the WebGL backend and the browser all paint, so it
    ; is where every fidelity fix in this gallery has gone — the 187 preset
    ; geometries, the bidirectional reordering, the resolved fonts, the group
    ; rotation. The element tree is a coarse approximation that predates all of
    ; it. Printing the approximation would give a PDF that disagreed with the
    ; screen in exactly the places the screen was carefully made right.
    ;
    ; `EVGListToElements` converts one to the other so the PDF writer needs no
    ; second input format, and it is deliberately not pptx-specific: the .docx
    ; reader and the spreadsheet emit the same display lists.
    fn toPdf:buffer (deck:PptxDeck index:int) {
        def empty:buffer (buffer_alloc 0)
        if (deck.ok == false) {
            error = "the deck is not open"
            return empty
        }
        def slideRef:PptxSlideRef (deck.slideAt(index))
        if ((slideRef.exists()) == false) {
            error = ("there is no slide " + (to_string index))
            return empty
        }
        def slide:PptxSlide (slideRef.model())
        view.cachePresentationImages(deck.pres)

        ; The scale is 72/96 — see `slideList`. `ptToPx` multiplies by 96/72
        ; for the screen and a PDF unit IS a point, so this cancels it and one
        ; slide point becomes one PDF unit. Left at 1.0 the page comes out a
        ; third too large in both directions and still looks right on its own,
        ; which is how that kind of mistake survives review.
        def dl:EVGDisplayList (this.slideList(deck slide index))
        def bg:EVGColor (this.slideBg(slide))
        def root:EVGElement (EVGListToElements.convert(dl slide.width slide.height bg))

        ; `cachePresentationImages` above filled the view's cache; the
        ; renderer is built after it so `pdfRenderer` has something to hand
        ; over.
        def renderer:EVGPDFRenderer (this.pdfRenderer(slide.width slide.height))
        def out:buffer (renderer.render(root))
        return out
    }

    ; The renderer, set up the way both PDF paths need it. It is one method
    ; because the two used to be two, and the multi-page one quietly missed
    ; `setMeasurer` — which does not fail, it falls back to guessed widths, so
    ; every line on every page was laid out against a font nobody measured.
    fn pdfRenderer:EVGPDFRenderer (w:double h:double) {
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)
        renderer.setPageSize(w h)
        renderer.setFontManager(view.ctx.tr.fm)
        def measurer (new TTFTextMeasurer(view.ctx.tr.fm))
        renderer.setMeasurer(measurer)
        ; The deck's pictures, by the same name the display list will use for
        ; them. The painter has already decoded every one of them into the
        ; view's cache — a .pptx carries its media inside the ZIP and names it
        ; by package part, so there is no path for the PDF writer to open and
        ; it used to die trying.
        def parts:[string] (keys view.imageCache)
        def i:int 0
        while (i < (array_length parts)) {
            def part:string (itemAt parts i)
            def pix@(optional):ImageBuffer (get view.imageCache part)
            if (!null? pix) {
                renderer.registerImage(part (unwrap pix))
            }
            i = (i + 1)
        }
        imagesPrinted = true
        return renderer
    }

    ; The display list for one slide, at PDF scale. Shared by both PDF paths
    ; so a page in a deck and the same page on its own cannot come out
    ; differently.
    fn slideList:EVGDisplayList (deck:PptxDeck slide:PptxSlide index:int) {
        view.converter.setScale(72.0 / 96.0)
        view.converter.slideNumber = (index + 1)
        return (view.converter.slideToDisplayList(slide))
    }

    fn slideBg:EVGColor (slide:PptxSlide) {
        def bg:EVGColor (EVGColor.parse("#FFFFFF"))
        if slide.bg.isSet {
            bg = (view.converter.colorFrom(slide.bg))
        }
        return bg
    }

    ; --- the whole deck, one file -----------------------------------------------
    ;
    ; Every slide becomes a page of one PDF, in order. This is what a deck IS
    ; to anyone who wants to print it or send it, and doing it slide by slide
    ; and stitching afterwards would embed the fonts once per page — the same
    ; face, subsetted separately, as many times as there are slides.
    ;
    ; A deck whose slides differ in size gets the FIRST slide's size for every
    ; page, because a section states one page size for all the pages under it.
    ; That is a real limit and it is stated rather than hidden: PowerPoint has
    ; one size per presentation, so a deck that hits it was assembled from two.
    fn toPdfDeck:buffer (deck:PptxDeck) {
        def empty:buffer (buffer_alloc 0)
        if (deck.ok == false) {
            error = "the deck is not open"
            return empty
        }
        def n:int (deck.slideCount())
        if (n == 0) {
            error = "the deck has no slides"
            return empty
        }
        def firstRef:PptxSlideRef (deck.slideAt(0))
        def first:PptxSlide (firstRef.model())
        def pw:double first.width
        def ph:double first.height

        view.cachePresentationImages(deck.pres)
        def root:EVGElement (EVGListToElements.printRoot(pw ph))
        def section:EVGElement (EVGListToElements.sectionOf(root))
        def i:int 0
        while (i < n) {
            def ref:PptxSlideRef (deck.slideAt(i))
            def slide:PptxSlide (ref.model())
            def dl:EVGDisplayList (this.slideList(deck slide i))
            def bg:EVGColor (this.slideBg(slide))
            def pg:EVGElement (EVGListToElements.pageFrom(dl pw ph bg true))
            section.addChild(pg)
            i = (i + 1)
        }
        def renderer:EVGPDFRenderer (this.pdfRenderer(pw ph))
        def out:buffer (renderer.render(root))
        return out
    }
}

; ==============================================================================
; pptx_web.rgr — the slide viewer, in the browser, with no host behind it.
; ==============================================================================
;
; The viewer already produced a display list and the WebGL host already drew it;
; the only thing between them was HTTP. Ranger compiles to JavaScript, so the
; viewer can be in the page instead — same PptxApp, same EVGDisplayList, same
; evg-webgl.js, no server.
;
; A browser cannot read files, and the viewer used the file system for the fonts
; and the deck. Both take bytes now (`loadFontBytes`, `loadBytes` over
; `OpcPackage.openBytes`), so the page fetches or is handed them.
;
; The deck's pictures come with it: the parser already pulled every image part
; out of the package and left the bytes on the model, so the page turns those
; into textures directly rather than asking a server for them — which is also
; why pictures now appear in the WebGL path at all.
; ==============================================================================

Import "../src/PptxApp.rgr"

class PptxWeb {
    def app:PptxApp (new PptxApp)
    def input:UIInput (new UIInput)
    def note:string ""

    Constructor () {
    }

    fn start:void (w:int h:int) {
        app.W = w
        app.H = h
        ; This host draws the display list itself, with WebGL. The CPU
        ; framebuffer behind `render` is never read here, and painting it was
        ; the most expensive thing in a browser profile — nine hundred thousand
        ; pixels per pointer move, plus a second build of the frame to do it.
        app.wantRaster = false
        app.initBare()
    }

    ; The preset shape catalogue, as text. A browser cannot read the file
    ; beside the module, so the page fetches it and hands it over here —
    ; the same shape of hand-off as the fonts above it.
    fn loadPresets:void (text:string) {
        app.loadPresets(text)
    }

    ; The window changed shape. A browser is the only host here whose surface
    ; can change under it — a phone rotates, a desktop window is dragged — and
    ; the chrome's breakpoints are re-evaluated from this.
    fn resize:void (w:int h:int) {
        app.resize(w h)
        app.render()
    }

    ; Whether a finger is what is pointing at this page. Nothing in the
    ; window's size says so: a laptop with a touchscreen is wide and coarse at
    ; the same time, and a phone in landscape is neither narrow nor a mouse.
    fn setCoarsePointer:void (coarse:boolean) {
        app.setCoarsePointer(coarse)
        app.render()
    }

    ; The chrome's breakpoints, for a host that wants its own.
    fn setChromeCss:void (css:string) {
        app.setChromeCss(css)
        app.render()
    }

    fn addFont:boolean (family:string data:buffer) {
        return (app.addFontBytes(family data))
    }

    fn addFace:boolean (data:buffer) {
        return (app.addFaceBytes(data))
    }

    fn openDeck:boolean (data:buffer name:string) {
        def ok:boolean (app.loadBytes(data name))
        if (ok == false) {
            note = "could not open the deck"
        } {
            note = ""
        }
        return ok
    }

    fn slideCount:int () {
        return (app.slideCount())
    }

    fn slideIndex:int () {
        return app.index
    }

    fn gotoSlide:void (i:int) {
        app.gotoSlide(i)
    }

    fn next:void () {
        app.nextSlide()
    }

    fn prev:void () {
        app.prevSlide()
    }

    ; The same input contract the hosted build used, one frame per call.
    fn pointer:void (x:int y:int down:boolean) {
        input.newFrame()
        input.setPointerPos(x y)
        input.setPointerDown(down)
        app.update(input)
    }

    ; --- the application frame ------------------------------------------------
    ; The deck now has the same chrome the spreadsheet and the document have —
    ; the shared toolbar, the shared window layer, the shared command table —
    ; so a host reaches all three by the same names it uses there.
    fn run:boolean (id:string arg:string) {
        def ok:boolean (app.runCommand(id arg))
        app.render()
        return ok
    }

    fn commands:string () {
        return (app.commands.toJson())
    }

    fn takeFileRequest:string () {
        def want:string app.fileRequest
        app.fileRequest = ""
        return want
    }

    ; A press, a move and a release, so the window layer works here too: a
    ; page that only ever sent presses could open a picker and never let a
    ; person drag it.
    fn pointerAt:boolean (x:int y:int pressed:boolean down:boolean released:boolean) {
        def took:boolean (app.pointer(x y pressed down released))
        app.render()
        return took
    }

    fn key:void (name:string) {
        this.keyMod(name false false)
    }

    ; The same key, with what was held down while it was pressed: shift is a
    ; bigger nudge and a second shape added to the selection, so a host that
    ; cannot say so can only ever click one thing.
    fn keyMod:void (name:string shift:boolean ctrl:boolean) {
        def code:int (PptxWeb.keyByName(name))
        if (code == 0) {
            return
        }
        input.newFrame()
        input.setModifiers(shift ctrl)
        input.pushKey(code)
        app.update(input)
    }

    ; Characters. With ctrl held these are the chords (z undo, b bold, …);
    ; without it they are text going into the selected shape.
    fn type:void (text:string shift:boolean ctrl:boolean) {
        if ((strlen text) == 0) {
            return
        }
        input.newFrame()
        input.setModifiers(shift ctrl)
        input.pushText(text)
        app.update(input)
    }

    ; What the pointer is holding while it moves. A press that cannot say
    ; whether shift was down cannot add to a selection.
    fn mods:void (shift:boolean ctrl:boolean) {
        app.setMods(shift ctrl)
    }

    ; The deck as a package, for the page to hand to the browser. A tab has
    ; no file system, so "save" here is bytes and a download.
    fn saveBytes:buffer () {
        return (app.deckBytes())
    }

    fn suggestedName:string () {
        return (app.suggestedName())
    }

    ; The wheel, in NOTCHES — positive up, one per detent, the way a mouse
    ; reports it. The app works in pixels of travel, so the conversion is
    ; here, at the edge, where the unit is known.
    ;
    ; Both units have an entry point on purpose. When the app changed from
    ; notches to pixels I changed one of the two hosts that call in here and
    ; not the other, and the one I missed went on sending ±1 — which the app
    ; then read as one PIXEL, negated. The panel crawled, backwards. A unit
    ; that is only written down in a comment is a unit that will be got wrong
    ; by the next caller; a unit in the method name cannot be.
    fn scroll:void (x:int y:int delta:int) {
        this.scrollPixels(x y (0 - (delta * 40)))
    }

    ; The wheel or a swipe, in PIXELS of travel, positive downwards — what a
    ; trackpad actually reports, and what a host should send if it has the
    ; number.
    fn scrollPixels:void (x:int y:int dy:int) {
        this.scrollPixels2(x y 0 dy)
    }

    ; …and with the sideways travel too, which a trackpad reports and a mouse
    ; does not. It matters when the thumbnails are a strip along the TOP —
    ; every narrow window — because there "further along the deck" is
    ; sideways, and a reader flicking at a horizontal row of pictures moves
    ; their fingers whichever way feels right.
    ;
    ; `dx` and `dy` arrive in the BROWSER's convention, positive right and
    ; positive down, because that is what `wheel` hands the page. `UIInput`
    ; keeps X the other way round — positive LEFT — so the negation is here,
    ; at the edge, rather than in the app.
    fn scrollPixels2:void (x:int y:int dx:int dy:int) {
        input.newFrame()
        input.setPointerPos(x y)
        input.addScroll(dy)
        input.addScrollX((0 - dx))
        app.update(input)
    }

    ; The list state of the paragraph the caret is in, as JSON — the level it
    ; sits at and whether it is a list item at all. A page that can only ask
    ; "is the editor on" cannot check that Tab indented anything.
    fn caretParagraph:string () {
        return (app.editor.caretParagraphJson())
    }

    fn slidePanelWidth:int () {
        return (app.panelWidth())
    }

    ; Whether a point is over the thumbnails — which the PAGE cannot work out,
    ; because the panel is a column down the side in a wide window and a strip
    ; along the top in a narrow one, and only the app knows which it is today.
    ;
    ; The page used to ask `slidePanelWidth()` and compare, and that answers 0
    ; for the strip, so on every narrow window the wheel was swallowed before
    ; it reached the app and the thumbnails could not be scrolled at all.
    fn overSlidePanel:boolean (x:int y:int) {
        return (app.panelInBand(x y))
    }

    fn editing:boolean () {
        return app.editMode
    }

    ; Whether there is a caret in a shape right now. A page that can only ask
    ; "is the editor on" cannot tell a selected box from one being typed in.
    fn editingText:boolean () {
        return (app.editor.isEditingText())
    }

    ; --- the show -------------------------------------------------------------
    ;
    ; A browser has a clock and the app does not, so the page drives the show's
    ; time: every animation frame while a show is running, and none at all when
    ; it is not.

    fn presenting:boolean () {
        return app.presenting
    }

    fn tick:void (seconds:double) {
        app.tick(seconds)
    }

    ; True while something is still moving, so the page knows whether to ask
    ; for another frame: a still slide costs nothing.
    fn animating:boolean () {
        if (app.presenting == false) {
            return false
        }
        if (app.showLength > 0.0) {
            return true
        }
        def slide@(optional):PptxSlide (app.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        return (s.transition.afterSeconds > 0.0)
    }

    fn selectionCount:int () {
        return (app.editor.selectionCount())
    }

    ; Where the selection is on screen, in window pixels. The page has no idea
    ; how a slide point becomes a pixel — that is the app's arithmetic — so it
    ; has to be able to ask.
    fn selectionBox:string () {
        def b:PptxEditRect (app.editor.selectionBounds())
        def sc:double (app.ptScale())
        def x:double ((b.x * sc) + (app.slideOriginX()))
        def y:double ((b.y * sc) + (app.slideOriginY()))
        def w:double (b.w * sc)
        def h:double (b.h * sc)
        return ("{\"x\":" + (EVGDisplayList.num(x)) + ",\"y\":" + (EVGDisplayList.num(y)) + ",\"w\":" + (EVGDisplayList.num(w)) + ",\"h\":" + (EVGDisplayList.num(h)) + ",\"count\":" + (to_string (app.editor.selectionCount())) + "}")
    }

    ; A picture the page handed over, as bytes, named after the file it came
    ; from — the package path is the viewer's own invention.
    fn insertPicture:boolean (name:string data:buffer) {
        def ok:boolean (app.insertPicture(name data))
        app.render()
        return ok
    }

    sfn keyByName:int (name:string) {
        if (name == "left")     { return (UIKey.left()) }
        if (name == "right")    { return (UIKey.right()) }
        if (name == "up")       { return (UIKey.up()) }
        if (name == "down")     { return (UIKey.down()) }
        if (name == "home")     { return (UIKey.home()) }
        if (name == "end")      { return (UIKey.end()) }
        ; These used to be spelled as arrows, which was harmless while an arrow
        ; only ever meant the deck. It nudges a selected shape now, so the page
        ; keys have to be themselves.
        if (name == "pageUp")   { return (UIKey.pageUp()) }
        if (name == "pageDown") { return (UIKey.pageDown()) }
        if (name == "del")      { return (UIKey.del()) }
        if (name == "escape")   { return (UIKey.escape()) }
        if (name == "backspace") { return (UIKey.backspace()) }
        if (name == "enter")    { return (UIKey.enter()) }
        if (name == "f2")       { return (UIKey.f2()) }
        if (name == "f5")       { return (UIKey.f5()) }
        if (name == "tab")      { return (UIKey.tab()) }
        return (UIKey.none())
    }

    fn scene:string () {
        return (app.sceneJson())
    }

    ; The frame as typed arrays. The page reads the arrays it is handed rather
    ; than parsing 1.5 MB of JSON out of `scene` — see `EVGSceneBinary`.
    fn sceneBinary:EVGSceneBinary () {
        return (app.sceneBinary())
    }

    ; ONE slide, alone, at a width the caller chooses: no chrome, no panel, no
    ; selection handles. The frame `scene` returns is the editor; this is the
    ; deck. A page that wants to print, or to export a picture, needs the
    ; second one and had no way to ask for it.
    fn slideScene:string (i:int widthPx:int) {
        return (app.slideSceneJson(i widthPx))
    }

    fn imageParts:string () {
        return (app.imagePartsJson())
    }

    fn imageBytes:buffer (part:string) {
        return (app.imageBytes(part))
    }

    fn status:string () {
        return app.view.status
    }

    fn deckName:string () {
        return app.view.deckName
    }
}

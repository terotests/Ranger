; ==============================================================================
; PptxEdit - editing core for the PPTX scene (selection, transforms, history)
; ==============================================================================
;
; The viewer's model was always mutable — nothing here parses or paints. This
; is the layer between a host's pointer and `PptxModel`: what is selected, what
; a drag does to it, and how to take it back.
;
; Written against the OOXML model directly, not against any editor's document
; format. Coordinates are the model's: points (1/72"), origin at the slide's
; top-left, rotation in degrees clockwise about the shape's centre.
;
; History is whole-deck snapshots rather than an operation log. A shape is a
; tree (a group holds shapes, a shape holds paragraphs, a paragraph holds runs)
; and every operation below can touch several of them at once, so the cheap
; correct thing is to copy the deck and keep the copies. An op log is the later
; optimization, and it needs the ops to be settled first.
; ==============================================================================

Import "PptxModel.rgr"
Import "PptxTextEdit.rgr"
Import "PptxResolver.rgr"
Import "../../office/editor/OfficeHistory.rgr"

; A rectangle in slide points. Ranger returns one value; a bounding box is four.
class PptxEditRect {
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0

    Constructor () {
    }

    sfn of:PptxEditRect (x:double y:double w:double h:double) {
        def r (new PptxEditRect())
        r.x = x
        r.y = y
        r.w = w
        r.h = h
        return r
    }

    fn right:double () {
        return (x + w)
    }

    fn bottom:double () {
        return (y + h)
    }

    fn midX:double () {
        return (x + (w * 0.5))
    }

    fn midY:double () {
        return (y + (h * 0.5))
    }
}

; ------------------------------------------------------------------------------
; Deep copy. Every field, because a snapshot that shares one object with the
; live deck is a snapshot that changes under you.
; ------------------------------------------------------------------------------
class PptxClone {
    sfn color:PptxColor (src:PptxColor) {
        def c (new PptxColor())
        c.isSet = src.isSet
        c.isScheme = src.isScheme
        c.scheme = src.scheme
        c.srgb = src.srgb
        c.alpha = src.alpha
        c.baked = src.baked
        c.copyModsFrom(src)
        return c
    }

    sfn gradient:PptxGradient (src:PptxGradient) {
        def g (new PptxGradient())
        g.isSet = src.isSet
        g.dir = src.dir
        g.c1 = (PptxClone.color(src.c1))
        g.c2 = (PptxClone.color(src.c2))
        return g
    }

    sfn shadow:PptxShadow (src:PptxShadow) {
        def s (new PptxShadow())
        s.isSet = src.isSet
        s.offsetXPt = src.offsetXPt
        s.offsetYPt = src.offsetYPt
        s.blurPt = src.blurPt
        s.color = (PptxClone.color(src.color))
        s.alpha = src.alpha
        return s
    }

    sfn run:PptxTextRun (src:PptxTextRun) {
        def r (new PptxTextRun())
        r.text = src.text
        r.field = src.field
        r.fontFamily = src.fontFamily
        r.resolvedFontSig = src.resolvedFontSig
        r.resolvedColorSig = src.resolvedColorSig
        r.resolvedSizeSig = src.resolvedSizeSig
        r.fontSizePt = src.fontSizePt
        r.sizeSet = src.sizeSet
        r.boldSet = src.boldSet
        r.bold = src.bold
        r.italicSet = src.italicSet
        r.italic = src.italic
        r.color = (PptxClone.color(src.color))
        r.highlight = (PptxClone.color(src.highlight))
        return r
    }

    sfn paragraph:PptxParagraph (src:PptxParagraph) {
        def p (new PptxParagraph())
        p.align = src.align
        p.alignSet = src.alignSet
        p.spaceBeforePt = src.spaceBeforePt
        p.spaceAfterPt = src.spaceAfterPt
        p.lineSpacingPct = src.lineSpacingPct
        p.level = src.level
        p.hasBullet = src.hasBullet
        p.bulletSet = src.bulletSet
        p.bulletChar = src.bulletChar
        p.marginLeftPt = src.marginLeftPt
        p.marginSet = src.marginSet
        p.indentPt = src.indentPt
        p.indentSet = src.indentSet
        p.bulletColor = (PptxClone.color(src.bulletColor))
        p.bulletSizePct = src.bulletSizePct
        p.bulletSizePt = src.bulletSizePt
        p.bulletFont = src.bulletFont
        def i:int 0
        while (i < (array_length src.runs)) {
            def r:PptxTextRun (itemAt src.runs i)
            push p.runs (PptxClone.run(r))
            i = (i + 1)
        }
        return p
    }

    sfn textBody:PptxTextBody (src:PptxTextBody) {
        def t (new PptxTextBody())
        t.insetL = src.insetL
        t.insetT = src.insetT
        t.insetR = src.insetR
        t.insetB = src.insetB
        t.insetsSet = src.insetsSet
        t.anchor = src.anchor
        t.anchorSet = src.anchorSet
        t.wrap = src.wrap
        t.hasDefRPr = src.hasDefRPr
        t.defFontSizePt = src.defFontSizePt
        t.defBold = src.defBold
        t.defItalic = src.defItalic
        t.defFontFamily = src.defFontFamily
        t.defColor = (PptxClone.color(src.defColor))
        t.defAlign = src.defAlign
        def i:int 0
        while (i < (array_length src.paragraphs)) {
            def p:PptxParagraph (itemAt src.paragraphs i)
            push t.paragraphs (PptxClone.paragraph(p))
            i = (i + 1)
        }
        return t
    }

    sfn tableCell:PptxTableCell (src:PptxTableCell) {
        def c (new PptxTableCell())
        c.text = src.text
        c.fill = (PptxClone.color(src.fill))
        c.bold = src.bold
        c.fontSizePt = src.fontSizePt
        c.align = src.align
        return c
    }

    sfn chart:PptxChart (src:PptxChart) {
        def c (new PptxChart())
        c.chartType = src.chartType
        c.title = src.title
        def i:int 0
        while (i < (array_length src.categories)) {
            push c.categories (itemAt src.categories i)
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length src.series)) {
            def s:PptxChartSeries (itemAt src.series j)
            def out (new PptxChartSeries())
            out.name = s.name
            def k:int 0
            while (k < (array_length s.values)) {
                push out.values (itemAt s.values k)
                k = (k + 1)
            }
            push c.series out
            j = (j + 1)
        }
        return c
    }

    ; Image bytes are shared on purpose: the parser owns them, nothing edits
    ; them, and copying a JPEG per undo step is the one copy worth avoiding.
    sfn shape:PptxShape (src:PptxShape) {
        def s (new PptxShape())
        s.kind = src.kind
        s.editId = src.editId
        s.shapeId = src.shapeId
        s.name = src.name
        s.x = src.x
        s.y = src.y
        s.width = src.width
        s.height = src.height
        s.hasXfrm = src.hasXfrm
        s.rotation = src.rotation
        s.flipH = src.flipH
        s.flipV = src.flipV
        s.preset = src.preset
        s.adj = src.adj
        s.noFill = src.noFill
        s.noLine = src.noLine
        s.headEnd = src.headEnd
        s.tailEnd = src.tailEnd
        s.fillRef = src.fillRef
        s.fillRefColor = (PptxClone.color(src.fillRefColor))
        s.lineRef = src.lineRef
        s.lineRefColor = (PptxClone.color(src.lineRefColor))
        s.effectRef = src.effectRef
        s.fontRefColor = (PptxClone.color(src.fontRefColor))
        s.fill = (PptxClone.color(src.fill))
        s.fillGrad = (PptxClone.gradient(src.fillGrad))
        s.line = (PptxClone.color(src.line))
        s.lineWidthPt = src.lineWidthPt
        s.shadow = (PptxClone.shadow(src.shadow))
        s.hasText = src.hasText
        s.text = (PptxClone.textBody(src.text))
        s.imageRid = src.imageRid
        s.imagePart = src.imagePart
        s.imageBytes = src.imageBytes
        s.imageOk = src.imageOk
        s.locked = src.locked
        s.altText = src.altText
        s.hasStyle = src.hasStyle
        s.fontRef = src.fontRef
        s.styleFillSig = src.styleFillSig
        s.styleLineSig = src.styleLineSig
        s.sheetXfrmSig = src.sheetXfrmSig
        s.isPlaceholder = src.isPlaceholder
        s.phType = src.phType
        s.phIdx = src.phIdx
        s.inherited = src.inherited
        s.hasPath = src.hasPath
        def pi:int 0
        while (pi < (array_length src.pathUnit)) {
            push s.pathUnit (itemAt src.pathUnit pi)
            pi = (pi + 1)
        }
        s.tableRows = src.tableRows
        s.tableCols = src.tableCols
        def ci:int 0
        while (ci < (array_length src.tableCells)) {
            def cell:PptxTableCell (itemAt src.tableCells ci)
            push s.tableCells (PptxClone.tableCell(cell))
            ci = (ci + 1)
        }
        s.chart = (PptxClone.chart(src.chart))
        s.chX = src.chX
        s.chY = src.chY
        s.chW = src.chW
        s.chH = src.chH
        def i:int 0
        while (i < (array_length src.children)) {
            def child:PptxShape (itemAt src.children i)
            push s.children (PptxClone.shape(child))
            i = (i + 1)
        }
        return s
    }

    sfn sheet:PptxSheet (src:PptxSheet) {
        def out (new PptxSheet())
        out.partPath = src.partPath
        out.dirty = src.dirty
        out.bg = (PptxClone.color(src.bg))
        def i:int 0
        while (i < (array_length src.shapes)) {
            push out.shapes (PptxClone.shape((itemAt src.shapes i)))
            i = (i + 1)
        }
        return out
    }

    sfn section:PptxSection (src:PptxSection) {
        def out (new PptxSection())
        out.name = src.name
        out.id = src.id
        def i:int 0
        while (i < (array_length src.slideIds)) {
            push out.slideIds (itemAt src.slideIds i)
            i = (i + 1)
        }
        return out
    }

    sfn opaqueInto:void (src:[PptxOpaque] dst:[PptxOpaque]) {
        def i:int 0
        while (i < (array_length src)) {
            def so:PptxOpaque (itemAt src i)
            def op (new PptxOpaque())
            op.name = so.name
            op.afterShapes = so.afterShapes
            op.source.copyFrom(so.source)
            push dst op
            i = (i + 1)
        }
    }

    sfn slide:PptxSlide (src:PptxSlide) {
        def sl (new PptxSlide())
        sl.partPath = src.partPath
        sl.dirty = src.dirty
        sl.revision = src.revision
        sl.width = src.width
        sl.height = src.height
        sl.bg = (PptxClone.color(src.bg))
        sl.layoutPart = src.layoutPart
        sl.masterPart = src.masterPart
        sl.notes = (PptxClone.shape(src.notes))
        sl.notesPart = src.notesPart
        sl.slideId = src.slideId
        sl.key = src.key
        def tr (new PptxTransition())
        tr.isSet = src.transition.isSet
        tr.kind = src.transition.kind
        tr.dir = src.transition.dir
        tr.seconds = src.transition.seconds
        tr.onClick = src.transition.onClick
        tr.afterSeconds = src.transition.afterSeconds
        sl.transition = tr
        def bi:int 0
        while (bi < (array_length src.build)) {
            def b:PptxBuildStep (itemAt src.build bi)
            def step (new PptxBuildStep())
            step.editId = b.editId
            step.shapeId = b.shapeId
            step.kind = b.kind
            step.dir = b.dir
            step.seconds = b.seconds
            step.paragraph = b.paragraph
            step.start = b.start
            push sl.build step
            bi = (bi + 1)
        }
        def i:int 0
        while (i < (array_length src.shapes)) {
            def sh:PptxShape (itemAt src.shapes i)
            push sl.shapes (PptxClone.shape(sh))
            i = (i + 1)
        }
        ; What the slide carries and this model does not describe. A snapshot
        ; that dropped these would delete a deck's SmartArt on the first undo,
        ; which is exactly the failure the source spans exist to prevent.
        PptxClone.opaqueInto(src.opaque sl.opaque)
        PptxClone.opaqueInto(src.sldHead sl.sldHead)
        PptxClone.opaqueInto(src.sldTail sl.sldTail)
        return sl
    }
}

; One point in the undo stack: the slides, which slide was in front of you, and
; what was selected — restoring geometry without the selection loses your place.
; What the format painter carries: how a shape is filled, outlined, shadowed
; and lettered, with none of its geometry and none of its words.
class PptxFormat {
    def fill:PptxColor (new PptxColor())
    def grad:PptxGradient (new PptxGradient())
    def line:PptxColor (new PptxColor())
    def lineWidthPt:double 0.0
    def shadow:PptxShadow (new PptxShadow())
    def hasText:boolean false
    def bold:boolean false
    def italic:boolean false
    def sizePt:double 18.0
    def sizeSet:boolean false
    def family:string ""
    def color:PptxColor (new PptxColor())
    def align:string "l"
    def alignSet:boolean false

    Constructor () {
    }
}

class PptxEditSnapshot {
    def label:string ""
    def slideIndex:int 0
    def slides:[PptxSlide]
    def selection:[int]
    ; The master and layout sheets, because they can be edited too, and the
    ; sections, because reordering the deck moves them.
    def sheetKeys:[string]
    def sheetValues:[PptxSheet]
    def sheetIsMaster:[boolean]
    def sections:[PptxSection]
    def sheetPart:string ""

    Constructor () {
        def s:[PptxSlide]
        slides = s
        def sel:[int]
        selection = sel
        def sk:[string]
        sheetKeys = sk
        def sv:[PptxSheet]
        sheetValues = sv
        def sm:[boolean]
        sheetIsMaster = sm
        def sc:[PptxSection]
        sections = sc
    }
}

class PptxEditor {
    def doc:PptxPresentation (new PptxPresentation())
    def slideIndex:int 0
    def selection:[int]
    ; The snapshots and the cap — `gallery/office/editor`, the same file the
    ; document and the spreadsheet keep their ops in. A deck step is a whole
    ; snapshot rather than an operation, and the shared history does not care
    ; what it holds: nothing is asked of the type parameter.
    def history:OfficeHistory@(PptxEditSnapshot) (new OfficeHistory@(PptxEditSnapshot) ())
    def nextId:int 1
    def dirty:boolean false
    def attached:boolean false
    ; Alignment guides the last snapped move produced, in slide points, for a
    ; host that wants to draw them.
    def snapEnabled:boolean true
    def snapTolPt:double 3.0
    def guideX:[double]
    def guideY:[double]
    def minSizePt:double 4.0
    ; Text editing. Zero means the deck is being arranged rather than written
    ; in — a shape is picked up and moved, not typed into.
    def editingId:int 0
    def caret:PptxTextPos (new PptxTextPos())
    ; Where a turning selection started, so every frame of the drag turns from
    ; the same place rather than from the last frame's answer.
    def rotActive:boolean false
    def rotPivotX:double 0.0
    def rotPivotY:double 0.0
    ; The live angle of a multi-shape rotation, and the box the selection had
    ; when it started.
    ;
    ; The chrome needs both. A single shape's frame turns with the shape,
    ; because the shape IS the selection; several shapes have no such angle,
    ; so the frame stayed square while everything inside it turned — which is
    ; how it was reported. And it cannot be the current bounds turned either:
    ; those are the axis-aligned box of shapes that are themselves turning, so
    ; it grows as the drag goes on and stops hugging anything.
    def rotDeg:double 0.0
    def rotBox:PptxEditRect (PptxEditRect.of(0.0 0.0 0.0 0.0))
    def rotStartX:[double]
    def rotStartY:[double]
    def rotStartDeg:[double]
    def anchor:PptxTextPos (new PptxTextPos())
    ; What was copied, and where a drag on empty canvas started. The clipboard
    ; is the editor's own — a browser tab cannot read the system one without
    ; asking, and a deck's shapes are not text anyway.
    def clip:[PptxShape]
    def gridEnabled:boolean false
    def gridPt:double 9.0
    def format:PptxFormat (new PptxFormat())
    def formatSet:boolean false
    ; Never reused, so a revision names one state of one slide even after an
    ; undo has thrown a later one away.
    def nextRevision:int 0
    ; --- history, shared ------------------------------------------------------
    ;
    ; A step used to copy the WHOLE deck, which is right while the operation
    ; set is still moving and wrong once it has stopped: at five hundred slides
    ; a keystroke cost thirty milliseconds, three frames, because four hundred
    ; and ninety-nine slides were copied to record a change to one.
    ;
    ; So a step copies only the slides that CHANGED, and every step shares the
    ; rest. The cache below holds one clone per slide, tagged with the revision
    ; it was taken at; a capture asks it for each slide and only pays for the
    ; ones whose revision has moved on. Nothing in it is ever a live object —
    ; it stores copies — and `restoreSnapshot` copies out of it again, so a
    ; shared clone can never be reached by an edit.
    ;
    ; The invariant the whole thing rests on: **a slide's revision changes
    ; whenever its content does.** `pushSnapshot` and `pushCoalesced` bump the
    ; slide the step is on before capturing, and the two operations that
    ; rewrite EVERY slide — `remergeChrome` and `retheme` — bump all of them.
    def nextSlideKey:int 1
    def cloneRev:[int:int]
    def cloneVal:[int:PptxSlide]
    ; For re-resolving a palette colour; the same mapping the loader used.
    def resolver:PptxResolver (new PptxResolver())
    ; Editing a master or a layout: the sheet stands in for the slide, so
    ; every operation that knows how to move a shape works on it unchanged.
    def sheetPart:string ""
    def sheetSlide:PptxSlide (new PptxSlide())

    Constructor () {
    }

    ; --- deck ----------------------------------------------------------------

    fn attach:void (pres:PptxPresentation) {
        doc = pres
        slideIndex = 0
        nextId = 1
        dirty = false
        attached = true
        this.assignIds()
        this.clearSelection()
        history.reset()
        history.limit = 60
        this.pushSnapshot("open")
        dirty = false
    }

    fn assignIds:void () {
        def si:int 0
        while (si < (array_length doc.slides)) {
            def slide:PptxSlide (itemAt doc.slides si)
            def i:int 0
            while (i < (array_length slide.shapes)) {
                def sh:PptxShape (itemAt slide.shapes i)
                this.assignIdTo(sh)
                i = (i + 1)
            }
            this.assignIdTo(slide.notes)
            this.linkBuild(slide)
            if (slide.key == 0) {
                slide.key = nextSlideKey
                nextSlideKey = (nextSlideKey + 1)
            }
            si = (si + 1)
        }
    }

    ; A build step names its shape by the number the FILE uses; everything in
    ; the editor names shapes by `editId`, because a file's number is rewritten
    ; on every save. Link them once, when the deck is attached.
    fn linkBuild:void (slide:PptxSlide) {
        def kept:[PptxBuildStep]
        def i:int 0
        while (i < (array_length slide.build)) {
            def step:PptxBuildStep (itemAt slide.build i)
            def k:int 0
            while (k < (array_length slide.shapes)) {
                def sh:PptxShape (itemAt slide.shapes k)
                if (sh.shapeId == step.shapeId) {
                    step.editId = sh.editId
                }
                k = (k + 1)
            }
            ; A step naming a shape that is not on the slide animates nothing.
            if (step.editId > 0) {
                push kept step
            }
            i = (i + 1)
        }
        slide.build = kept
    }

    fn assignIdTo:void (shape:PptxShape) {
        shape.editId = nextId
        nextId = (nextId + 1)
        def i:int 0
        while (i < (array_length shape.children)) {
            def child:PptxShape (itemAt shape.children i)
            this.assignIdTo(child)
            i = (i + 1)
        }
    }

    fn slideCount:int () {
        return (array_length doc.slides)
    }

    fn currentSlide@(optional):PptxSlide () {
        if ((strlen sheetPart) > 0) {
            def editing@(optional):PptxSlide sheetSlide
            return editing
        }
        if (slideIndex < 0) {
            def __none@(optional):PptxSlide
            return __none
        }
        if (slideIndex >= (array_length doc.slides)) {
            def __none2@(optional):PptxSlide
            return __none2
        }
        def hit@(optional):PptxSlide (itemAt doc.slides slideIndex)
        return hit
    }

    fn gotoSlide:void (i:int) {
        if (i < 0) {
            return
        }
        if (i >= (array_length doc.slides)) {
            return
        }
        slideIndex = i
        this.clearSelection()
    }

    fn slideWidth:double () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (!null? slide) {
            def s:PptxSlide (unwrap slide)
            return s.width
        }
        return doc.slideWidth
    }

    fn slideHeight:double () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (!null? slide) {
            def s:PptxSlide (unwrap slide)
            return s.height
        }
        return doc.slideHeight
    }

    ; The shapes a user may touch: what the slide itself declares. Master and
    ; layout chrome is drawn on the slide but is not on it — clicking the
    ; footer of a template should not offer to drag the template.
    fn editableShapes:[PptxShape] () {
        def out:[PptxShape]
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return out
        }
        def s:PptxSlide (unwrap slide)
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            if (sh.inherited == false) {
                push out sh
            }
            i = (i + 1)
        }
        return out
    }

    fn findShape@(optional):PptxShape (id:int) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            def __none@(optional):PptxShape
            return __none
        }
        def s:PptxSlide (unwrap slide)
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            def hit@(optional):PptxShape (PptxEditor.findIn(sh id))
            if (!null? hit) {
                return hit
            }
            i = (i + 1)
        }
        ; The notes are a shape too, and not one on the slide.
        if (s.notes.editId == id) {
            def notesHit@(optional):PptxShape s.notes
            return notesHit
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    sfn findIn@(optional):PptxShape (shape:PptxShape id:int) {
        if (shape.editId == id) {
            def self@(optional):PptxShape shape
            return self
        }
        def i:int 0
        while (i < (array_length shape.children)) {
            def child:PptxShape (itemAt shape.children i)
            def hit@(optional):PptxShape (PptxEditor.findIn(child id))
            if (!null? hit) {
                return hit
            }
            i = (i + 1)
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    ; --- selection -----------------------------------------------------------

    fn clearSelection:void () {
        def s:[int]
        selection = s
        editingId = 0
    }

    fn selectionCount:int () {
        return (array_length selection)
    }

    fn isSelected:boolean (id:int) {
        def i:int 0
        while (i < (array_length selection)) {
            if ((itemAt selection i) == id) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn select:void (id:int) {
        this.clearSelection()
        if (id > 0) {
            push selection id
        }
    }

    fn addToSelection:void (id:int) {
        if (id <= 0) {
            return
        }
        if (this.isSelected(id)) {
            return
        }
        push selection id
    }

    fn toggleSelection:void (id:int) {
        if (id <= 0) {
            return
        }
        if (this.isSelected(id)) {
            def out:[int]
            def i:int 0
            while (i < (array_length selection)) {
                def v:int (itemAt selection i)
                if (v != id) {
                    push out v
                }
                i = (i + 1)
            }
            selection = out
            return
        }
        push selection id
    }

    fn selectAll:void () {
        this.clearSelection()
        def shapes:[PptxShape] (this.editableShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            push selection sh.editId
            i = (i + 1)
        }
    }

    fn selectedShapes:[PptxShape] () {
        def out:[PptxShape]
        def i:int 0
        while (i < (array_length selection)) {
            def id:int (itemAt selection i)
            def hit@(optional):PptxShape (this.findShape(id))
            if (!null? hit) {
                push out (unwrap hit)
            }
            i = (i + 1)
        }
        return out
    }

    fn firstSelected@(optional):PptxShape () {
        def shapes:[PptxShape] (this.selectedShapes())
        if ((array_length shapes) == 0) {
            def __none@(optional):PptxShape
            return __none
        }
        def hit@(optional):PptxShape (itemAt shapes 0)
        return hit
    }

    ; --- hit testing ---------------------------------------------------------

    sfn containsPoint:boolean (shape:PptxShape px:double py:double) {
        def cx:double (shape.x + (shape.width * 0.5))
        def cy:double (shape.y + (shape.height * 0.5))
        def dx:double (px - cx)
        def dy:double (py - cy)
        def rx:double dx
        def ry:double dy
        if ((shape.rotation > 0.001) || (shape.rotation < -0.001)) {
            def rad:double ((0.0 - shape.rotation) * 0.017453292519943295)
            def cs:double (cos rad)
            def sn:double (sin rad)
            rx = ((dx * cs) - (dy * sn))
            ry = ((dx * sn) + (dy * cs))
        }
        def hw:double (shape.width * 0.5)
        def hh:double (shape.height * 0.5)
        def ax:double (fabs rx)
        def ay:double (fabs ry)
        if (ax > hw) {
            return false
        }
        if (ay > hh) {
            return false
        }
        return true
    }

    ; Topmost first: the last shape painted is the one under the pointer.
    fn hitTest:int (px:double py:double) {
        def shapes:[PptxShape] (this.editableShapes())
        def i:int ((array_length shapes) - 1)
        while (i >= 0) {
            def sh:PptxShape (itemAt shapes i)
            if (PptxEditor.containsPoint(sh px py)) {
                return sh.editId
            }
            i = (i - 1)
        }
        return 0
    }

    fn selectAt:boolean (px:double py:double additive:boolean) {
        def id:int (this.hitTest(px py))
        if (id == 0) {
            if (additive == false) {
                this.clearSelection()
            }
            return false
        }
        if additive {
            this.toggleSelection(id)
            return true
        }
        if (this.isSelected(id)) {
            return true
        }
        this.select(id)
        return true
    }

    ; --- bounds --------------------------------------------------------------

    fn selectionBounds:PptxEditRect () {
        def shapes:[PptxShape] (this.selectedShapes())
        if ((array_length shapes) == 0) {
            return (PptxEditRect.of(0.0 0.0 0.0 0.0))
        }
        def first:PptxShape (itemAt shapes 0)
        def x0:double first.x
        def y0:double first.y
        def x1:double (first.x + first.width)
        def y1:double (first.y + first.height)
        def i:int 1
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (sh.x < x0) {
                x0 = sh.x
            }
            if (sh.y < y0) {
                y0 = sh.y
            }
            def r:double (sh.x + sh.width)
            def b:double (sh.y + sh.height)
            if (r > x1) {
                x1 = r
            }
            if (b > y1) {
                y1 = b
            }
            i = (i + 1)
        }
        return (PptxEditRect.of(x0 y0 (x1 - x0) (y1 - y0)))
    }

    ; --- history -------------------------------------------------------------

    ; A copy of this slide that the history may share. The cache answers with
    ; the copy it already has when the slide has not moved on since; otherwise
    ; it makes one and remembers it.
    ; A name of its own for a slide that has just come into the deck.
    fn freshKey:void (slide:PptxSlide) {
        slide.key = nextSlideKey
        nextSlideKey = (nextSlideKey + 1)
    }

    fn sharedClone:PptxSlide (slide:PptxSlide) {
        if (slide.key == 0) {
            slide.key = nextSlideKey
            nextSlideKey = (nextSlideKey + 1)
        }
        def have@(optional):int (get cloneRev slide.key)
        if (!null? have) {
            if ((unwrap have) == slide.revision) {
                def cached@(optional):PptxSlide (get cloneVal slide.key)
                if (!null? cached) {
                    return (unwrap cached)
                }
            }
        }
        def copy:PptxSlide (PptxClone.slide(slide))
        set cloneRev slide.key slide.revision
        set cloneVal slide.key copy
        return copy
    }

    ; The slide a step is about has changed, so the copy the history holds of
    ; it is out of date. Called BEFORE the capture, which is what makes the
    ; sharing sound.
    fn touchSlide:void (slide:PptxSlide) {
        nextRevision = (nextRevision + 1)
        slide.revision = nextRevision
        slide.dirty = true
    }

    ; Two operations rewrite every slide in the deck rather than the one in
    ; front of you — re-merging the chrome and re-theming the colours — and
    ; both have to say so, or the history shares copies of slides that have
    ; quietly changed underneath it.
    fn touchAllSlides:void () {
        def i:int 0
        while (i < (array_length doc.slides)) {
            this.touchSlide((itemAt doc.slides i))
            i = (i + 1)
        }
    }

    fn captureSnapshot:PptxEditSnapshot (label:string) {
        def snap (new PptxEditSnapshot())
        snap.label = label
        snap.slideIndex = slideIndex
        def i:int 0
        while (i < (array_length doc.slides)) {
            def sl:PptxSlide (itemAt doc.slides i)
            push snap.slides (this.sharedClone(sl))
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length selection)) {
            push snap.selection (itemAt selection j)
            j = (j + 1)
        }
        def mkeys:[string] (keys doc.masters)
        def mi:int 0
        while (mi < (array_length mkeys)) {
            def mk:string (itemAt mkeys mi)
            def ms@(optional):PptxSheet (get doc.masters mk)
            if (!null? ms) {
                push snap.sheetKeys mk
                push snap.sheetValues (PptxClone.sheet((unwrap ms)))
                push snap.sheetIsMaster true
            }
            mi = (mi + 1)
        }
        def lkeys:[string] (keys doc.layouts)
        def li:int 0
        while (li < (array_length lkeys)) {
            def lk:string (itemAt lkeys li)
            def ls@(optional):PptxSheet (get doc.layouts lk)
            if (!null? ls) {
                push snap.sheetKeys lk
                push snap.sheetValues (PptxClone.sheet((unwrap ls)))
                push snap.sheetIsMaster false
            }
            li = (li + 1)
        }
        def qi:int 0
        while (qi < (array_length doc.sections)) {
            push snap.sections (PptxClone.section((itemAt doc.sections qi)))
            qi = (qi + 1)
        }
        snap.sheetPart = sheetPart
        return snap
    }

    fn pushSnapshot:void (label:string) {
        ; The slide this step is about has changed, and it has to say so BEFORE
        ; the capture: the history shares the copies of the slides that did
        ; not, and it tells them apart by revision.
        if (label != "open") {
            def cur0@(optional):PptxSlide (this.currentSlide())
            if (!null? cur0) {
                this.touchSlide((unwrap cur0))
            }
        }
        def snap:PptxEditSnapshot (this.captureSnapshot(label))
        ; Everything a step does to the stack: the redo tail goes, because a
        ; new step makes it unreachable, and the oldest steps fall off the
        ; bottom rather than the stack growing without end — a deck copy is
        ; not free. Both rules are the shared file's.
        history.record(snap)
        dirty = true
        ; An operation inside a master writes through to the sheet: the ops
        ; replace the shape array rather than mutating it in place.
        if ((strlen sheetPart) > 0) {
            def live@(optional):PptxSheet (this.sheetFor(sheetPart))
            if (!null? live) {
                def ls2:PptxSheet (unwrap live)
                ls2.shapes = sheetSlide.shapes
                ls2.bg = sheetSlide.bg
                ls2.dirty = true
            }
        }
    }

    fn restoreSnapshot:void (snap:PptxEditSnapshot) {
        ; The other half of the sharing. A snapshot's copy of a slide and the
        ; live slide with the same key and the same revision are the same
        ; state, so the live one is already what the undo wants and is kept
        ; where it stands. Only the slides that actually differ are copied out
        ; — and copied they must be, because what the snapshot holds is shared
        ; with every other step that did not change them.
        def liveByKey:[int:PptxSlide]
        def li:int 0
        while (li < (array_length doc.slides)) {
            def live:PptxSlide (itemAt doc.slides li)
            if (live.key > 0) {
                set liveByKey live.key live
            }
            li = (li + 1)
        }
        def slides:[PptxSlide]
        def i:int 0
        while (i < (array_length snap.slides)) {
            def sl:PptxSlide (itemAt snap.slides i)
            def same:boolean false
            if (sl.key > 0) {
                def hit@(optional):PptxSlide (get liveByKey sl.key)
                if (!null? hit) {
                    def lv:PptxSlide (unwrap hit)
                    if (lv.revision == sl.revision) {
                        push slides lv
                        same = true
                    }
                }
            }
            if (same == false) {
                push slides (PptxClone.slide(sl))
            }
            i = (i + 1)
        }
        doc.slides = slides
        ; Stay on the slide you are looking at. The snapshot remembers which
        ; slide the step was taken on, and that is the fallback — undoing a
        ; deleted slide has to go back to it — but undoing an edit should not
        ; move the deck under you the way it did when the answer was always
        ; the snapshot's own index.
        def want:int slideIndex
        if (want >= (array_length doc.slides)) {
            want = snap.slideIndex
        }
        if (want < 0) {
            want = snap.slideIndex
        }
        slideIndex = want
        if (slideIndex >= (array_length doc.slides)) {
            slideIndex = ((array_length doc.slides) - 1)
        }
        if (slideIndex < 0) {
            slideIndex = 0
        }
        ; What was selected before the step is the fallback, not the answer.
        ; Undoing a move should leave the shape you moved selected — so the
        ; live selection is kept for every id the restored deck still has, and
        ; the snapshot's own selection is what comes back when it has none
        ; (undoing a delete, where those ids exist again).
        def keep:[int]
        def i2:int 0
        while (i2 < (array_length selection)) {
            def id:int (itemAt selection i2)
            def hit@(optional):PptxShape (this.findShape(id))
            if (!null? hit) {
                push keep id
            }
            i2 = (i2 + 1)
        }
        if ((array_length keep) == 0) {
            def j:int 0
            while (j < (array_length snap.selection)) {
                push keep (itemAt snap.selection j)
                j = (j + 1)
            }
        }
        selection = keep
        ; The sheets and the sections come back with the slides.
        def masters:[string:PptxSheet]
        def layouts:[string:PptxSheet]
        def si:int 0
        while (si < (array_length snap.sheetKeys)) {
            def key:string (itemAt snap.sheetKeys si)
            def sheet:PptxSheet (PptxClone.sheet((itemAt snap.sheetValues si)))
            if ((itemAt snap.sheetIsMaster si)) {
                set masters key sheet
            } {
                set layouts key sheet
            }
            si = (si + 1)
        }
        if ((array_length snap.sheetKeys) > 0) {
            doc.masters = masters
            doc.layouts = layouts
        }
        def sections:[PptxSection]
        def qi:int 0
        while (qi < (array_length snap.sections)) {
            push sections (PptxClone.section((itemAt snap.sections qi)))
            qi = (qi + 1)
        }
        doc.sections = sections
        ; Stay in the master you are in, the same way you stay on the slide you
        ; are on: the snapshot remembers which sheet the step was taken in, and
        ; that is the fallback rather than the answer.
        def wantSheet:string sheetPart
        if ((strlen wantSheet) == 0) {
            wantSheet = snap.sheetPart
        }
        sheetPart = ""
        if ((strlen wantSheet) > 0) {
            this.editSheet(wantSheet)
        }
    }

    ; The top of the undo side is the state the deck is IN, so there has to be
    ; one below it to go back to.
    fn canUndo:boolean () {
        return ((history.depth()) > 1)
    }

    fn canRedo:boolean () {
        return (history.canRedo())
    }

    fn undo:boolean () {
        if ((this.canUndo()) == false) {
            return false
        }
        def cur:PptxEditSnapshot (history.popUndo())
        history.pushRedo(cur)
        def snap:PptxEditSnapshot (history.peekUndo())
        this.restoreSnapshot(snap)
        dirty = true
        return true
    }

    ; The same function with the direction turned around.
    fn redo:boolean () {
        if ((this.canRedo()) == false) {
            return false
        }
        def snap:PptxEditSnapshot (history.popRedo())
        history.pushUndo(snap)
        this.restoreSnapshot(snap)
        dirty = true
        return true
    }

    ; Every step the deck can reach, forwards and back — the stack used to be
    ; one array with a cursor in it, and this is the same number.
    fn historyDepth:int () {
        return ((history.depth()) + (history.redoDepth()))
    }

    ; --- transforms ----------------------------------------------------------

    fn applyMove:void (dx:double dy:double) {
        def shapes:[PptxShape] (this.movableShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            sh.x = (sh.x + dx)
            sh.y = (sh.y + dy)
            sh.hasXfrm = true
            i = (i + 1)
        }
    }

    fn moveSelection:boolean (dx:double dy:double) {
        if ((array_length selection) == 0) {
            return false
        }
        this.applyMove(dx dy)
        this.clearGuides()
        this.pushSnapshot("move")
        return true
    }

    fn clearGuides:void () {
        def gx:[double]
        guideX = gx
        def gy:[double]
        guideY = gy
    }

    ; Edges worth lining up against: the slide's own thirds — left, centre,
    ; right — and every edge and centre of the shapes that are staying put.
    fn snapLinesX:[double] () {
        def out:[double]
        push out 0.0
        def sw:double (this.slideWidth())
        push out (sw * 0.5)
        push out sw
        def shapes:[PptxShape] (this.editableShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if ((this.isSelected(sh.editId)) == false) {
                push out sh.x
                push out (sh.x + (sh.width * 0.5))
                push out (sh.x + sh.width)
            }
            i = (i + 1)
        }
        return out
    }

    fn snapLinesY:[double] () {
        def out:[double]
        push out 0.0
        def sh2:double (this.slideHeight())
        push out (sh2 * 0.5)
        push out sh2
        def shapes:[PptxShape] (this.editableShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if ((this.isSelected(sh.editId)) == false) {
                push out sh.y
                push out (sh.y + (sh.height * 0.5))
                push out (sh.y + sh.height)
            }
            i = (i + 1)
        }
        return out
    }

    ; The nudge that would put one of `edges` onto one of `lines`, or 0 when
    ; nothing is near enough. `outLine` gets the line that was matched.
    sfn nearestSnap:double (edges:[double] lines:[double] tol:double) {
        def best:double 0.0
        def bestDist:double tol
        def found:boolean false
        def i:int 0
        while (i < (array_length edges)) {
            def e:double (itemAt edges i)
            def j:int 0
            while (j < (array_length lines)) {
                def l:double (itemAt lines j)
                def diff:double (l - e)
                def dist:double (fabs diff)
                if (dist <= bestDist) {
                    if (found == false) {
                        best = diff
                        bestDist = dist
                        found = true
                    } {
                        if (dist < bestDist) {
                            best = diff
                            bestDist = dist
                        }
                    }
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return best
    }

    ; The line a snapped edge landed on, for drawing. Recomputed rather than
    ; carried out of `nearestSnap`, which returns one value.
    sfn matchedLine:double (edges:[double] lines:[double] tol:double) {
        def bestLine:double 0.0
        def bestDist:double tol
        def found:boolean false
        def i:int 0
        while (i < (array_length edges)) {
            def e:double (itemAt edges i)
            def j:int 0
            while (j < (array_length lines)) {
                def l:double (itemAt lines j)
                def dist:double (fabs (l - e))
                if (dist <= bestDist) {
                    if (found == false) {
                        bestLine = l
                        bestDist = dist
                        found = true
                    } {
                        if (dist < bestDist) {
                            bestLine = l
                            bestDist = dist
                        }
                    }
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return bestLine
    }

    ; A drag that lines up with what is already on the slide. The delta the
    ; host asked for is nudged, not replaced — a shape never jumps to a guide
    ; it was not already next to.
    fn moveSelectionSnapped:boolean (dx:double dy:double) {
        if ((array_length selection) == 0) {
            return false
        }
        def adj:PptxEditRect (this.snapDelta(dx dy))
        this.applyMove(adj.x adj.y)
        this.pushSnapshot("move")
        return true
    }

    ; x / y of the returned rect are the adjusted delta; w / h are unused.
    ; Guides are left in `guideX` / `guideY` for the host to paint.
    fn snapDelta:PptxEditRect (dx:double dy:double) {
        this.clearGuides()
        if (snapEnabled == false) {
            return (PptxEditRect.of(dx dy 0.0 0.0))
        }
        def b:PptxEditRect (this.selectionBounds())
        if (b.w <= 0.0) {
            return (PptxEditRect.of(dx dy 0.0 0.0))
        }
        def ex:[double]
        push ex (b.x + dx)
        push ex ((b.midX()) + dx)
        push ex ((b.right()) + dx)
        def ey:[double]
        push ey (b.y + dy)
        push ey ((b.midY()) + dy)
        push ey ((b.bottom()) + dy)
        def linesX:[double] (this.snapLinesX())
        def linesY:[double] (this.snapLinesY())
        ; With the grid on, the grid line nearest each moving edge is a
        ; candidate like any other — so a shape lands on the grid when nothing
        ; better is near, and on its neighbour's edge when one is.
        if gridEnabled {
            def gi:int 0
            while (gi < (array_length ex)) {
                push linesX (PptxEditor.snapToStep((itemAt ex gi) gridPt))
                gi = (gi + 1)
            }
            def gj:int 0
            while (gj < (array_length ey)) {
                push linesY (PptxEditor.snapToStep((itemAt ey gj) gridPt))
                gj = (gj + 1)
            }
        }
        def ax:double (PptxEditor.nearestSnap(ex linesX snapTolPt))
        def ay:double (PptxEditor.nearestSnap(ey linesY snapTolPt))
        if ((fabs ax) > 0.0001) {
            push guideX (PptxEditor.matchedLine(ex linesX snapTolPt))
        }
        if ((fabs ay) > 0.0001) {
            push guideY (PptxEditor.matchedLine(ey linesY snapTolPt))
        }
        return (PptxEditRect.of((dx + ax) (dy + ay) 0.0 0.0))
    }

    ; Handles, clockwise from the top-left: 0 nw, 1 n, 2 ne, 3 e, 4 se, 5 s,
    ; 6 sw, 7 w. A multiple selection scales inside its own box, so the shapes
    ; keep their arrangement.
    fn resizeSelection:boolean (handle:int dx:double dy:double) {
        def ok:boolean (this.applyResize(handle dx dy))
        if (ok == false) {
            return false
        }
        this.pushSnapshot("resize")
        return true
    }

    ; The same arithmetic without a history step, for a drag in progress: a
    ; pointer that moves thirty times between press and release is one edit.
    fn applyResize:boolean (handle:int dx:double dy:double) {
        if ((array_length selection) == 0) {
            return false
        }
        def b:PptxEditRect (this.selectionBounds())
        if (b.w <= 0.0) {
            return false
        }
        if (b.h <= 0.0) {
            return false
        }
        def nx:double b.x
        def ny:double b.y
        def nw:double b.w
        def nh:double b.h
        def west:boolean false
        def east:boolean false
        def north:boolean false
        def south:boolean false
        if (handle == 0) {
            west = true
            north = true
        }
        if (handle == 1) {
            north = true
        }
        if (handle == 2) {
            east = true
            north = true
        }
        if (handle == 3) {
            east = true
        }
        if (handle == 4) {
            east = true
            south = true
        }
        if (handle == 5) {
            south = true
        }
        if (handle == 6) {
            west = true
            south = true
        }
        if (handle == 7) {
            west = true
        }
        if west {
            nx = (b.x + dx)
            nw = (b.w - dx)
        }
        if east {
            nw = (b.w + dx)
        }
        if north {
            ny = (b.y + dy)
            nh = (b.h - dy)
        }
        if south {
            nh = (b.h + dy)
        }
        if (nw < minSizePt) {
            if west {
                nx = ((b.x + b.w) - minSizePt)
            }
            nw = minSizePt
        }
        if (nh < minSizePt) {
            if north {
                ny = ((b.y + b.h) - minSizePt)
            }
            nh = minSizePt
        }
        def sx:double (nw / b.w)
        def sy:double (nh / b.h)
        def shapes:[PptxShape] (this.movableShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            def relX:double (sh.x - b.x)
            def relY:double (sh.y - b.y)
            sh.x = (nx + (relX * sx))
            sh.y = (ny + (relY * sy))
            sh.width = (sh.width * sx)
            sh.height = (sh.height * sy)
            sh.hasXfrm = true
            i = (i + 1)
        }
        return true
    }

    ; --- turning a selection ---------------------------------------------------
    ;
    ; Turning every shape by the same angle about ITS OWN centre leaves them
    ; all exactly where they were and spins each in place. That is not a
    ; rotation of the selection — it is several rotations that happen to share
    ; an angle, and on screen a group came apart instead of turning.
    ;
    ; A selection turns about the selection's centre: each shape keeps its own
    ; angle relative to the group, and its centre travels round that pivot.

    sfn spinAbout:void (shapes:[PptxShape] pivotX:double pivotY:double delta:double) {
        def rad:double ((delta * 3.141592653589793) / 180.0)
        def co:double (cos rad)
        def si:double (sin rad)
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            def cx:double ((sh.x + (sh.width * 0.5)) - pivotX)
            def cy:double ((sh.y + (sh.height * 0.5)) - pivotY)
            def nx:double (((cx * co) - (cy * si)) + pivotX)
            def ny:double (((cx * si) + (cy * co)) + pivotY)
            sh.x = (nx - (sh.width * 0.5))
            sh.y = (ny - (sh.height * 0.5))
            sh.rotation = (PptxEditor.normalizeDeg((sh.rotation + delta)))
            i = (i + 1)
        }
    }

    ; Where every shape was when the turn started. A drag reports the pointer's
    ; ABSOLUTE angle every frame, so each frame puts the shapes back and turns
    ; them once from there; adding a delta to what the last frame produced
    ; would compound rounding all the way round the circle.
    fn beginRotate:void () {
        def shapes:[PptxShape] (this.movableShapes())
        def sx:[double]
        def sy:[double]
        def sr:[double]
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            push sx sh.x
            push sy sh.y
            push sr sh.rotation
            i = (i + 1)
        }
        rotStartX = sx
        rotStartY = sy
        rotStartDeg = sr
        def b:PptxEditRect (this.selectionBounds())
        rotPivotX = (b.midX())
        rotPivotY = (b.midY())
        rotBox = b
        rotDeg = 0.0
        rotActive = true
    }

    fn endRotate:void () {
        rotActive = false
        rotDeg = 0.0
    }

    fn applyRotate:void (deg:double) {
        def shapes:[PptxShape] (this.movableShapes())
        ; One shape turns about itself, and the handle points where the
        ; pointer does — the angle IS the shape's angle. With more than one
        ; there is no such shape, so the selection as a whole takes the angle
        ; and everything in it comes along.
        if ((array_length shapes) < 2) {
            def i:int 0
            while (i < (array_length shapes)) {
                def sh:PptxShape (itemAt shapes i)
                sh.rotation = (PptxEditor.normalizeDeg(deg))
                i = (i + 1)
            }
            return
        }
        if (rotActive == false) {
            this.beginRotate()
        }
        if ((array_length rotStartX) != (array_length shapes)) {
            this.beginRotate()
        }
        def r:int 0
        while (r < (array_length shapes)) {
            def sh2:PptxShape (itemAt shapes r)
            sh2.x = (itemAt rotStartX r)
            sh2.y = (itemAt rotStartY r)
            sh2.rotation = (itemAt rotStartDeg r)
            r = (r + 1)
        }
        rotDeg = deg
        PptxEditor.spinAbout(shapes rotPivotX rotPivotY deg)
    }

    fn rotateSelection:boolean (deg:double) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.movableShapes())
        if ((array_length shapes) > 1) {
            def b:PptxEditRect (this.selectionBounds())
            PptxEditor.spinAbout(shapes (b.midX()) (b.midY()) deg)
        } {
            def i:int 0
            while (i < (array_length shapes)) {
                def sh:PptxShape (itemAt shapes i)
                sh.rotation = (PptxEditor.normalizeDeg((sh.rotation + deg)))
                i = (i + 1)
            }
        }
        this.pushSnapshot("rotate")
        return true
    }

    fn setSelectionRotation:boolean (deg:double) {
        if ((array_length selection) == 0) {
            return false
        }
        def norm:double (PptxEditor.normalizeDeg(deg))
        def shapes:[PptxShape] (this.movableShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            sh.rotation = norm
            i = (i + 1)
        }
        this.pushSnapshot("rotate")
        return true
    }

    sfn normalizeDeg:double (deg:double) {
        def d:double deg
        while (d < 0.0) {
            d = (d + 360.0)
        }
        while (d >= 360.0) {
            d = (d - 360.0)
        }
        return d
    }

    ; --- the shape list ------------------------------------------------------

    fn replaceShapes:void (list:[PptxShape]) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return
        }
        def s:PptxSlide (unwrap slide)
        s.shapes = list
    }

    ; Master and layout chrome is always at the front of a resolved slide, so
    ; the authored shapes are the tail — and the tail is the only part whose
    ; order a user owns.
    fn firstAuthoredIndex:int () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0
        }
        def s:PptxSlide (unwrap slide)
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            if (sh.inherited == false) {
                return i
            }
            i = (i + 1)
        }
        return (array_length s.shapes)
    }

    fn addShapeAt:int (preset:string x:double y:double w:double h:double) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0
        }
        def s:PptxSlide (unwrap slide)
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.editId = nextId
        nextId = (nextId + 1)
        sh.name = ("Shape " + (to_string sh.editId))
        sh.preset = preset
        sh.x = x
        sh.y = y
        sh.width = w
        sh.height = h
        sh.hasXfrm = true
        sh.fill = (PptxColor.srgbOf("4472C4"))
        push s.shapes sh
        this.select(sh.editId)
        this.pushSnapshot("insert shape")
        return sh.editId
    }

    fn addTextBox:int (x:double y:double w:double h:double text:string) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0
        }
        def s:PptxSlide (unwrap slide)
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.editId = nextId
        nextId = (nextId + 1)
        sh.name = ("TextBox " + (to_string sh.editId))
        sh.preset = "rect"
        sh.x = x
        sh.y = y
        sh.width = w
        sh.height = h
        sh.hasXfrm = true
        sh.hasText = true
        PptxEditor.setBodyText(sh.text text)
        push s.shapes sh
        this.select(sh.editId)
        this.pushSnapshot("insert text")
        return sh.editId
    }

    fn addPicture:int (part:string bytes:buffer x:double y:double w:double h:double) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0
        }
        def s:PptxSlide (unwrap slide)
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.picture())
        sh.editId = nextId
        nextId = (nextId + 1)
        sh.name = ("Picture " + (to_string sh.editId))
        sh.x = x
        sh.y = y
        sh.width = w
        sh.height = h
        sh.hasXfrm = true
        sh.imagePart = part
        sh.imageBytes = bytes
        push s.shapes sh
        this.select(sh.editId)
        this.pushSnapshot("insert picture")
        return sh.editId
    }

    fn deleteSelection:boolean () {
        if ((array_length selection) == 0) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def kept:[PptxShape]
        def removed:int 0
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            def drop:boolean false
            if (sh.inherited == false) {
                if (this.isSelected(sh.editId)) {
                    if (sh.locked == false) {
                        drop = true
                    }
                }
            }
            if drop {
                removed = (removed + 1)
            } {
                push kept sh
            }
            i = (i + 1)
        }
        if (removed == 0) {
            return false
        }
        s.shapes = kept
        this.clearSelection()
        this.pushSnapshot("delete")
        return true
    }

    fn duplicateSelection:boolean () {
        if ((array_length selection) == 0) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def copies:[PptxShape]
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            def copy:PptxShape (PptxClone.shape(sh))
            copy.x = (copy.x + 10.0)
            copy.y = (copy.y + 10.0)
            this.assignIdTo(copy)
            push s.shapes copy
            push copies copy
            i = (i + 1)
        }
        this.clearSelection()
        def j:int 0
        while (j < (array_length copies)) {
            def c:PptxShape (itemAt copies j)
            push selection c.editId
            j = (j + 1)
        }
        this.pushSnapshot("duplicate")
        return true
    }

    ; --- z-order -------------------------------------------------------------

    fn reorder:boolean (mode:string) {
        if ((array_length selection) == 0) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def base:int (this.firstAuthoredIndex())
        def head:[PptxShape]
        def tail:[PptxShape]
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            if (i < base) {
                push head sh
            } {
                push tail sh
            }
            i = (i + 1)
        }
        def out:[PptxShape]
        if (mode == "front") {
            def a:int 0
            while (a < (array_length tail)) {
                def sh2:PptxShape (itemAt tail a)
                if ((this.isSelected(sh2.editId)) == false) {
                    push out sh2
                }
                a = (a + 1)
            }
            def b:int 0
            while (b < (array_length tail)) {
                def sh3:PptxShape (itemAt tail b)
                if (this.isSelected(sh3.editId)) {
                    push out sh3
                }
                b = (b + 1)
            }
        }
        if (mode == "back") {
            def c:int 0
            while (c < (array_length tail)) {
                def sh4:PptxShape (itemAt tail c)
                if (this.isSelected(sh4.editId)) {
                    push out sh4
                }
                c = (c + 1)
            }
            def d:int 0
            while (d < (array_length tail)) {
                def sh5:PptxShape (itemAt tail d)
                if ((this.isSelected(sh5.editId)) == false) {
                    push out sh5
                }
                d = (d + 1)
            }
        }
        if (mode == "forward") {
            out = (this.stepOrder(tail true))
        }
        if (mode == "backward") {
            out = (this.stepOrder(tail false))
        }
        if ((array_length out) != (array_length tail)) {
            return false
        }
        def merged:[PptxShape]
        def h:int 0
        while (h < (array_length head)) {
            push merged (itemAt head h)
            h = (h + 1)
        }
        def t:int 0
        while (t < (array_length out)) {
            push merged (itemAt out t)
            t = (t + 1)
        }
        s.shapes = merged
        this.pushSnapshot(("order " + mode))
        return true
    }

    ; One place up or down the pile, per selected shape, without letting two
    ; selected shapes swap past each other.
    fn stepOrder:[PptxShape] (tail:[PptxShape] up:boolean) {
        def out:[PptxShape]
        def i:int 0
        while (i < (array_length tail)) {
            push out (itemAt tail i)
            i = (i + 1)
        }
        def n:int (array_length out)
        if up {
            def k:int (n - 2)
            while (k >= 0) {
                def cur:PptxShape (itemAt out k)
                def above:PptxShape (itemAt out (k + 1))
                if (this.isSelected(cur.editId)) {
                    if ((this.isSelected(above.editId)) == false) {
                        set_at out k above
                        set_at out (k + 1) cur
                    }
                }
                k = (k - 1)
            }
        } {
            def m:int 1
            while (m < n) {
                def cur2:PptxShape (itemAt out m)
                def below:PptxShape (itemAt out (m - 1))
                if (this.isSelected(cur2.editId)) {
                    if ((this.isSelected(below.editId)) == false) {
                        set_at out m below
                        set_at out (m - 1) cur2
                    }
                }
                m = (m + 1)
            }
        }
        return out
    }

    fn bringToFront:boolean () {
        return (this.reorder("front"))
    }

    fn sendToBack:boolean () {
        return (this.reorder("back"))
    }

    fn bringForward:boolean () {
        return (this.reorder("forward"))
    }

    fn sendBackward:boolean () {
        return (this.reorder("backward"))
    }

    ; --- group / ungroup -----------------------------------------------------

    ; A group's children keep slide coordinates and the group's child box is
    ; its own bounds, so the viewer's chOff / chExt mapping is the identity —
    ; grouping moves nothing on screen, which is the whole contract.
    fn groupSelection:boolean () {
        if ((array_length selection) < 2) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def b:PptxEditRect (this.selectionBounds())
        def grp (new PptxShape())
        grp.kind = (PptxShapeKind.group())
        grp.editId = nextId
        nextId = (nextId + 1)
        grp.name = ("Group " + (to_string grp.editId))
        grp.x = b.x
        grp.y = b.y
        grp.width = b.w
        grp.height = b.h
        grp.hasXfrm = true
        grp.chX = b.x
        grp.chY = b.y
        grp.chW = b.w
        grp.chH = b.h
        def kept:[PptxShape]
        def taken:int 0
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            def move:boolean false
            if (sh.inherited == false) {
                if (this.isSelected(sh.editId)) {
                    move = true
                }
            }
            if move {
                push grp.children sh
                taken = (taken + 1)
            } {
                push kept sh
            }
            i = (i + 1)
        }
        if (taken < 2) {
            return false
        }
        push kept grp
        s.shapes = kept
        this.select(grp.editId)
        this.pushSnapshot("group")
        return true
    }

    fn ungroupSelection:boolean () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def out:[PptxShape]
        def freed:[int]
        def opened:int 0
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            def open:boolean false
            if (sh.kind == (PptxShapeKind.group())) {
                if (sh.inherited == false) {
                    if (this.isSelected(sh.editId)) {
                        open = true
                    }
                }
            }
            if open {
                opened = (opened + 1)
                def sx:double 1.0
                def sy:double 1.0
                if (sh.chW > 0.0) {
                    sx = (sh.width / sh.chW)
                }
                if (sh.chH > 0.0) {
                    sy = (sh.height / sh.chH)
                }
                def c:int 0
                while (c < (array_length sh.children)) {
                    def child:PptxShape (itemAt sh.children c)
                    child.x = (sh.x + ((child.x - sh.chX) * sx))
                    child.y = (sh.y + ((child.y - sh.chY) * sy))
                    child.width = (child.width * sx)
                    child.height = (child.height * sy)
                    child.rotation = (PptxEditor.normalizeDeg((child.rotation + sh.rotation)))
                    child.hasXfrm = true
                    push out child
                    push freed child.editId
                    c = (c + 1)
                }
            } {
                push out sh
            }
            i = (i + 1)
        }
        if (opened == 0) {
            return false
        }
        s.shapes = out
        this.clearSelection()
        def j:int 0
        while (j < (array_length freed)) {
            push selection (itemAt freed j)
            j = (j + 1)
        }
        this.pushSnapshot("ungroup")
        return true
    }

    ; --- align / distribute --------------------------------------------------

    ; One shape lines up against the slide; several line up against each other.
    ; PowerPoint does the same, and it is the only reading that makes "centre"
    ; mean something in both cases.
    fn alignSelection:boolean (mode:string) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.movableShapes())
        def b:PptxEditRect (this.selectionBounds())
        if ((array_length shapes) < 2) {
            b = (PptxEditRect.of(0.0 0.0 (this.slideWidth()) (this.slideHeight())))
        }
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (mode == "left") {
                sh.x = b.x
            }
            if (mode == "hcenter") {
                sh.x = ((b.midX()) - (sh.width * 0.5))
            }
            if (mode == "right") {
                sh.x = ((b.right()) - sh.width)
            }
            if (mode == "top") {
                sh.y = b.y
            }
            if (mode == "vcenter") {
                sh.y = ((b.midY()) - (sh.height * 0.5))
            }
            if (mode == "bottom") {
                sh.y = ((b.bottom()) - sh.height)
            }
            sh.hasXfrm = true
            i = (i + 1)
        }
        this.pushSnapshot(("align " + mode))
        return true
    }

    ; Equal gaps between the outermost two, which is what "distribute" means
    ; once more than two shapes are involved.
    fn distributeSelection:boolean (horizontal:boolean) {
        if ((array_length selection) < 3) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def n:int (array_length shapes)
        def order:[PptxShape]
        def i:int 0
        while (i < n) {
            push order (itemAt shapes i)
            i = (i + 1)
        }
        def a:int 0
        while (a < n) {
            def b2:int (a + 1)
            while (b2 < n) {
                def sa:PptxShape (itemAt order a)
                def sb:PptxShape (itemAt order b2)
                def ka:double sa.x
                def kb:double sb.x
                if (horizontal == false) {
                    ka = sa.y
                    kb = sb.y
                }
                if (kb < ka) {
                    set_at order a sb
                    set_at order b2 sa
                }
                b2 = (b2 + 1)
            }
            a = (a + 1)
        }
        def firstShape:PptxShape (itemAt order 0)
        def lastShape:PptxShape (itemAt order (n - 1))
        if horizontal {
            def span:double ((lastShape.x - firstShape.x) / (to_double (n - 1)))
            def k:int 1
            while (k < (n - 1)) {
                def sh:PptxShape (itemAt order k)
                sh.x = (firstShape.x + (span * (to_double k)))
                sh.hasXfrm = true
                k = (k + 1)
            }
        } {
            def spanY:double ((lastShape.y - firstShape.y) / (to_double (n - 1)))
            def m:int 1
            while (m < (n - 1)) {
                def sh2:PptxShape (itemAt order m)
                sh2.y = (firstShape.y + (spanY * (to_double m)))
                sh2.hasXfrm = true
                m = (m + 1)
            }
        }
        this.pushSnapshot("distribute")
        return true
    }

    ; --- style ---------------------------------------------------------------

    fn setFillHex:boolean (hex:string) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            sh.fill = (PptxColor.srgbOf(hex))
            sh.fillGrad.isSet = false
            i = (i + 1)
        }
        this.pushSnapshot("fill")
        return true
    }

    fn clearFill:boolean () {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            def none (new PptxColor())
            sh.fill = none
            sh.fillGrad.isSet = false
            i = (i + 1)
        }
        this.pushSnapshot("fill none")
        return true
    }

    fn setLineHex:boolean (hex:string widthPt:double) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            sh.line = (PptxColor.srgbOf(hex))
            sh.lineWidthPt = widthPt
            i = (i + 1)
        }
        this.pushSnapshot("line")
        return true
    }

    fn setOpacity:boolean (alpha:double) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            sh.fill.alpha = alpha
            i = (i + 1)
        }
        this.pushSnapshot("opacity")
        return true
    }

    fn setPreset:boolean (preset:string) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (sh.kind == (PptxShapeKind.shape())) {
                sh.preset = preset
                sh.hasPath = false
            }
            i = (i + 1)
        }
        this.pushSnapshot("preset")
        return true
    }

    ; --- text ----------------------------------------------------------------

    sfn firstRun@(optional):PptxTextRun (body:PptxTextBody) {
        if ((array_length body.paragraphs) == 0) {
            def __none@(optional):PptxTextRun
            return __none
        }
        def p:PptxParagraph (itemAt body.paragraphs 0)
        if ((array_length p.runs) == 0) {
            def __none2@(optional):PptxTextRun
            return __none2
        }
        def hit@(optional):PptxTextRun (itemAt p.runs 0)
        return hit
    }

    ; Replace a body with one paragraph per line, keeping the first run's look
    ; so retyping a title does not reset it to 18pt black.
    sfn setBodyText:void (body:PptxTextBody text:string) {
        def proto (new PptxTextRun())
        def existing@(optional):PptxTextRun (PptxEditor.firstRun(body))
        if (!null? existing) {
            def e:PptxTextRun (unwrap existing)
            proto.fontFamily = e.fontFamily
            proto.fontSizePt = e.fontSizePt
            proto.sizeSet = e.sizeSet
            proto.boldSet = e.boldSet
            proto.bold = e.bold
            proto.italicSet = e.italicSet
            proto.italic = e.italic
            proto.color = (PptxClone.color(e.color))
        }
        def align:string "l"
        def alignSet:boolean false
        if ((array_length body.paragraphs) > 0) {
            def p0:PptxParagraph (itemAt body.paragraphs 0)
            align = p0.align
            alignSet = p0.alignSet
        }
        def paras:[PptxParagraph]
        def start:int 0
        def n:int (strlen text)
        def i:int 0
        while (i <= n) {
            def atEnd:boolean (i == n)
            def isBreak:boolean false
            if (atEnd == false) {
                if ((charAt text i) == 10) {
                    isBreak = true
                }
            }
            if (atEnd || isBreak) {
                def piece:string (substring text start i)
                def para (new PptxParagraph())
                para.align = align
                para.alignSet = alignSet
                def run (new PptxTextRun())
                run.text = piece
                run.fontFamily = proto.fontFamily
                run.fontSizePt = proto.fontSizePt
                run.sizeSet = proto.sizeSet
                run.bold = proto.bold
                run.boldSet = proto.boldSet
                run.italic = proto.italic
                run.italicSet = proto.italicSet
                run.color = (PptxClone.color(proto.color))
                push para.runs run
                push paras para
                start = (i + 1)
            }
            i = (i + 1)
        }
        body.paragraphs = paras
    }

    fn setShapeText:boolean (id:int text:string) {
        def hit@(optional):PptxShape (this.findShape(id))
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        sh.hasText = true
        PptxEditor.setBodyText(sh.text text)
        this.pushSnapshot("text")
        return true
    }

    fn selectionText:string () {
        def hit@(optional):PptxShape (this.firstSelected())
        if (null? hit) {
            return ""
        }
        def sh:PptxShape (unwrap hit)
        if (sh.hasText == false) {
            return ""
        }
        return (sh.text.plainText())
    }

    fn setTextBold:boolean (bold:boolean) {
        if (this.styleTextRange("bold" bold 0.0 "")) {
            return true
        }
        return (this.applyRunStyle("bold" bold 0.0 ""))
    }

    fn setTextItalic:boolean (italic:boolean) {
        if (this.styleTextRange("italic" italic 0.0 "")) {
            return true
        }
        return (this.applyRunStyle("italic" italic 0.0 ""))
    }

    fn setTextSizePt:boolean (size:double) {
        if (this.styleTextRange("size" false size "")) {
            return true
        }
        return (this.applyRunStyle("size" false size ""))
    }

    fn setTextColorHex:boolean (hex:string) {
        if (this.styleTextRange("color" false 0.0 hex)) {
            return true
        }
        return (this.applyRunStyle("color" false 0.0 hex))
    }

    fn applyRunStyle:boolean (what:string flag:boolean size:double hex:string) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def touched:int 0
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if sh.hasText {
                touched = (touched + 1)
                def pi:int 0
                while (pi < (array_length sh.text.paragraphs)) {
                    def para:PptxParagraph (itemAt sh.text.paragraphs pi)
                    def ri:int 0
                    while (ri < (array_length para.runs)) {
                        def run:PptxTextRun (itemAt para.runs ri)
                        if (what == "bold") {
                            run.bold = flag
                            run.boldSet = true
                        }
                        if (what == "italic") {
                            run.italic = flag
                            run.italicSet = true
                        }
                        if (what == "size") {
                            run.fontSizePt = size
                            run.sizeSet = true
                        }
                        if (what == "color") {
                            run.color = (PptxColor.srgbOf(hex))
                        }
                        ri = (ri + 1)
                    }
                    pi = (pi + 1)
                }
            }
            i = (i + 1)
        }
        if (touched == 0) {
            return false
        }
        this.pushSnapshot(("text " + what))
        return true
    }

    fn setTextAlign:boolean (align:string) {
        if ((array_length selection) == 0) {
            return false
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def touched:int 0
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if sh.hasText {
                touched = (touched + 1)
                def pi:int 0
                while (pi < (array_length sh.text.paragraphs)) {
                    def para:PptxParagraph (itemAt sh.text.paragraphs pi)
                    para.align = align
                    para.alignSet = true
                    pi = (pi + 1)
                }
            }
            i = (i + 1)
        }
        if (touched == 0) {
            return false
        }
        this.pushSnapshot("align text")
        return true
    }

    ; --- slides --------------------------------------------------------------

    fn addSlide:boolean () {
        def slide (new PptxSlide())
        slide.dirty = true
        this.freshKey(slide)
        slide.width = doc.slideWidth
        slide.height = doc.slideHeight
        slide.bg = (PptxColor.srgbOf("FFFFFF"))
        def out:[PptxSlide]
        def at:int (slideIndex + 1)
        def i:int 0
        while (i < (array_length doc.slides)) {
            if (i == at) {
                push out slide
            }
            push out (itemAt doc.slides i)
            i = (i + 1)
        }
        if (at >= (array_length doc.slides)) {
            push out slide
        }
        doc.slides = out
        slideIndex = at
        this.clearSelection()
        this.pushSnapshot("new slide")
        return true
    }

    fn duplicateSlide:boolean () {
        def cur@(optional):PptxSlide (this.currentSlide())
        if (null? cur) {
            return false
        }
        def src:PptxSlide (unwrap cur)
        def copy:PptxSlide (PptxClone.slide(src))
        ; A copy is a new slide, not the one it was copied from: it cannot
        ; claim the part its original lives in, and it cannot keep its key
        ; either — two slides answering to the same name is a history that
        ; shares the wrong copy and a panel that draws the wrong thumbnail.
        copy.partPath = ""
        copy.dirty = true
        this.freshKey(copy)
        copy.revision = 0
        def j:int 0
        while (j < (array_length copy.shapes)) {
            def sh:PptxShape (itemAt copy.shapes j)
            this.assignIdTo(sh)
            j = (j + 1)
        }
        def out:[PptxSlide]
        def i:int 0
        while (i < (array_length doc.slides)) {
            push out (itemAt doc.slides i)
            if (i == slideIndex) {
                push out copy
            }
            i = (i + 1)
        }
        doc.slides = out
        slideIndex = (slideIndex + 1)
        this.clearSelection()
        this.pushSnapshot("duplicate slide")
        return true
    }

    fn deleteSlide:boolean () {
        if ((array_length doc.slides) <= 1) {
            return false
        }
        def out:[PptxSlide]
        def i:int 0
        while (i < (array_length doc.slides)) {
            if (i != slideIndex) {
                push out (itemAt doc.slides i)
            }
            i = (i + 1)
        }
        doc.slides = out
        if (slideIndex >= (array_length doc.slides)) {
            slideIndex = ((array_length doc.slides) - 1)
        }
        this.clearSelection()
        this.pushSnapshot("delete slide")
        return true
    }

    ; Straight to an index, which is what a drag in the slide panel means.
    fn moveSlideTo:boolean (target:int) {
        def n:int (array_length doc.slides)
        if (target < 0) {
            return false
        }
        if (target >= n) {
            return false
        }
        if (target == slideIndex) {
            return false
        }
        def moved:PptxSlide (itemAt doc.slides slideIndex)
        def out:[PptxSlide]
        def i:int 0
        while (i < n) {
            if (i != slideIndex) {
                def at:int (array_length out)
                if (at == target) {
                    push out moved
                }
                push out (itemAt doc.slides i)
            }
            i = (i + 1)
        }
        if ((array_length out) < n) {
            push out moved
        }
        doc.slides = out
        def k:int 0
        while (k < (array_length doc.slides)) {
            if (((itemAt doc.slides k)) == moved) {
                slideIndex = k
            }
            k = (k + 1)
        }
        this.pushSnapshot("move slide")
        return true
    }

    fn moveSlide:boolean (delta:int) {
        def target:int (slideIndex + delta)
        if (target < 0) {
            return false
        }
        if (target >= (array_length doc.slides)) {
            return false
        }
        def moved:PptxSlide (itemAt doc.slides slideIndex)
        def other:PptxSlide (itemAt doc.slides target)
        set_at doc.slides target moved
        set_at doc.slides slideIndex other
        slideIndex = target
        this.pushSnapshot("move slide")
        return true
    }


    ; --- typing --------------------------------------------------------------

    ; Keystrokes are one edit, not one edit each: a step whose label matches
    ; the one on top of the stack replaces it instead of pushing.
    fn pushCoalesced:void (label:string) {
        if ((history.depth()) > 0) {
            def top:PptxEditSnapshot (history.peekUndo())
            if (top.label == label) {
                ; A coalesced step replaces the one on top rather than
                ; adding another, and it still changed a slide — so the
                ; slide is marked before the capture, exactly as it is for
                ; a step of its own.
                def cur@(optional):PptxSlide (this.currentSlide())
                if (!null? cur) {
                    this.touchSlide((unwrap cur))
                }
                def snap:PptxEditSnapshot (this.captureSnapshot(label))
                history.replaceTop(snap)
                dirty = true
                return
            }
        }
        this.pushSnapshot(label)
    }

    ; --- typing into a SELECTED shape, with no caret in it yet ----------------
    ;
    ; These two edit the end of the shape's text, and they used to do it by
    ; taking the whole body out as one plain string, changing that string, and
    ; building the body again from it. Which flattened the shape:
    ; `setBodyText` gives every paragraph ONE run in the style of the FIRST
    ; one, so a box holding an orange link and white prose came back entirely
    ; orange, a bold word came back plain, and the empty paragraphs between
    ; items were gone — on the FIRST backspace, before a single character had
    ; been typed.
    ;
    ; The caret machinery next door has always inserted and deleted by run.
    ; So these do the same thing, at the end of the text rather than at a
    ; caret: `insertAt` and `deleteRange` split and rejoin runs and leave every
    ; other run, and every paragraph's own bullet, level and spacing, alone.
    ;
    ; `setBodyText` is still right where it is used — a new shape's text, a
    ; whole body replaced on purpose — because there the flattening IS the
    ; intent. It is only wrong as a way of editing what is already there.

    fn appendText:boolean (s:string) {
        def hit@(optional):PptxShape (this.firstSelected())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        sh.hasText = true
        def end:PptxTextPos (PptxTextEdit.docEnd(sh.text))
        PptxTextEdit.insertAt(sh.text end s)
        this.pushCoalesced("typing")
        return true
    }

    fn backspaceText:boolean () {
        def hit@(optional):PptxShape (this.firstSelected())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        if (sh.hasText == false) {
            return false
        }
        def end:PptxTextPos (PptxTextEdit.docEnd(sh.text))
        ; One character back, not one string unit back: `moveLeft` steps over a
        ; surrogate pair, and chopping the last unit off a plain string cut an
        ; emoji in half.
        def from:PptxTextPos (PptxTextEdit.moveLeft(sh.text end))
        if (from.isSame(end)) {
            return false
        }
        PptxTextEdit.deleteRange(sh.text from end)
        this.pushCoalesced("typing")
        return true
    }


    ; --- the caret ------------------------------------------------------------

    fn isEditingText:boolean () {
        return (editingId > 0)
    }

    fn editingShape@(optional):PptxShape () {
        if (editingId <= 0) {
            def __none@(optional):PptxShape
            return __none
        }
        return (this.findShape(editingId))
    }

    fn beginTextEdit:boolean (id:int) {
        def hit@(optional):PptxShape (this.findShape(id))
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        if (sh.kind == (PptxShapeKind.picture())) {
            return false
        }
        if (sh.kind == (PptxShapeKind.group())) {
            return false
        }
        ; A table and a chart carry their own content. Setting `hasText` on
        ; one would give it a second, empty text body that the writer would
        ; then have to explain — and a click can now reach this, where before
        ; only a deliberate F2 could.
        if (sh.kind == (PptxShapeKind.table())) {
            return false
        }
        if (sh.kind == (PptxShapeKind.chart())) {
            return false
        }
        sh.hasText = true
        if ((array_length sh.text.paragraphs) == 0) {
            def para (new PptxParagraph())
            para.align = sh.text.defAlign
            push sh.text.paragraphs para
        }
        ; Selecting clears the caret — picking a different shape stops typing
        ; into the last one — so the selection is made FIRST and the caret set
        ; after it.
        this.select(id)
        editingId = id
        def end:PptxTextPos (PptxTextEdit.docEnd(sh.text))
        caret = end
        anchor = (end.copy())
        return true
    }

    fn endTextEdit:void () {
        editingId = 0
    }

    fn textSelectionEmpty:boolean () {
        return (caret.isSame(anchor))
    }

    fn selectedText:string () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return ""
        }
        def sh:PptxShape (unwrap hit)
        return (PptxTextEdit.textInRange(sh.text anchor caret))
    }

    fn caretText:string () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return ""
        }
        def sh:PptxShape (unwrap hit)
        return (sh.text.plainText())
    }

    fn setCaretPos:void (para:int col:int extend:boolean) {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return
        }
        def sh:PptxShape (unwrap hit)
        def pos:PptxTextPos (PptxTextPos.of(para col))
        PptxTextEdit.clamp(sh.text pos)
        caret = pos
        if (extend == false) {
            anchor = (pos.copy())
        }
    }

    fn selectAllText:void () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return
        }
        def sh:PptxShape (unwrap hit)
        anchor = (PptxTextEdit.docStart(sh.text))
        caret = (PptxTextEdit.docEnd(sh.text))
    }

    ; "left" "right" "up" "down" "home" "end" "wordLeft" "wordRight"
    fn moveCaretBy:boolean (dir:string extend:boolean) {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        def body:PptxTextBody sh.text
        ; An unextended move out of a selection collapses to its near end,
        ; which is what a left arrow means when something is selected.
        if (extend == false) {
            if ((this.textSelectionEmpty()) == false) {
                def cmpv:int (PptxTextEdit.cmp(anchor caret))
                if (dir == "left") {
                    if (cmpv < 0) {
                        caret = (anchor.copy())
                    }
                    anchor = (caret.copy())
                    return true
                }
                if (dir == "right") {
                    if (cmpv > 0) {
                        caret = (anchor.copy())
                    }
                    anchor = (caret.copy())
                    return true
                }
            }
        }
        def next:PptxTextPos (caret.copy())
        if (dir == "left") {
            next = (PptxTextEdit.moveLeft(body caret))
        }
        if (dir == "right") {
            next = (PptxTextEdit.moveRight(body caret))
        }
        if (dir == "up") {
            next = (PptxTextEdit.moveUp(body caret))
        }
        if (dir == "down") {
            next = (PptxTextEdit.moveDown(body caret))
        }
        if (dir == "home") {
            next = (PptxTextEdit.lineStart(body caret))
        }
        if (dir == "end") {
            next = (PptxTextEdit.lineEnd(body caret))
        }
        if (dir == "wordLeft") {
            next = (PptxTextEdit.wordLeft(body caret))
        }
        if (dir == "wordRight") {
            next = (PptxTextEdit.wordRight(body caret))
        }
        caret = next
        if (extend == false) {
            anchor = (next.copy())
        }
        return true
    }

    fn dropSelectedText:boolean () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        if (this.textSelectionEmpty()) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        def at:PptxTextPos (PptxTextEdit.deleteRange(sh.text anchor caret))
        caret = at
        anchor = (at.copy())
        return true
    }

    fn typeAtCaret:boolean (text:string) {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        if ((strlen text) == 0) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        this.dropSelectedText()
        def at:PptxTextPos (PptxTextEdit.insertAt(sh.text caret text))
        caret = at
        anchor = (at.copy())
        this.pushCoalesced("typing")
        return true
    }

    fn newlineAtCaret:boolean () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        this.dropSelectedText()
        def at:PptxTextPos (PptxTextEdit.splitAt(sh.text caret))
        caret = at
        anchor = (at.copy())
        this.pushSnapshot("newline")
        return true
    }

    fn backspaceAtCaret:boolean () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        if ((this.textSelectionEmpty()) == false) {
            this.dropSelectedText()
            this.pushCoalesced("typing")
            return true
        }
        def from:PptxTextPos (PptxTextEdit.moveLeft(sh.text caret))
        if (from.isSame(caret)) {
            return false
        }
        def at:PptxTextPos (PptxTextEdit.deleteRange(sh.text from caret))
        caret = at
        anchor = (at.copy())
        this.pushCoalesced("typing")
        return true
    }

    fn deleteAtCaret:boolean () {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        if ((this.textSelectionEmpty()) == false) {
            this.dropSelectedText()
            this.pushCoalesced("typing")
            return true
        }
        def to:PptxTextPos (PptxTextEdit.moveRight(sh.text caret))
        if (to.isSame(caret)) {
            return false
        }
        def at:PptxTextPos (PptxTextEdit.deleteRange(sh.text caret to))
        caret = at
        anchor = (at.copy())
        this.pushCoalesced("typing")
        return true
    }

    ; A style command while a caret is in the text means the SELECTION, and a
    ; style command otherwise means the whole shape. Both are what a user
    ; expects, and the difference is only which one is in front of them.
    ; --- lists ----------------------------------------------------------------
    ;
    ; A bullet and a number are properties of a PARAGRAPH, not of a run, so
    ; these act on whole paragraphs: the ones the caret spans when there is a
    ; caret, and every paragraph of every selected shape when there is not —
    ; which is how a person turns a whole box into a list without first
    ; selecting its text.

    fn listParagraphs:[PptxParagraph] () {
        def out:[PptxParagraph]
        def hit@(optional):PptxShape (this.editingShape())
        if (!null? hit) {
            def sh:PptxShape (unwrap hit)
            def a:int anchor.para
            def b:int caret.para
            if (a > b) {
                def swap:int a
                a = b
                b = swap
            }
            def i:int a
            while (i <= b) {
                if (i < (array_length sh.text.paragraphs)) {
                    push out (itemAt sh.text.paragraphs i)
                }
                i = (i + 1)
            }
            return out
        }
        def shapes:[PptxShape] (this.selectedShapes())
        def si:int 0
        while (si < (array_length shapes)) {
            def s2:PptxShape (itemAt shapes si)
            if s2.hasText {
                def pi:int 0
                while (pi < (array_length s2.text.paragraphs)) {
                    push out (itemAt s2.text.paragraphs pi)
                    pi = (pi + 1)
                }
            }
            si = (si + 1)
        }
        return out
    }

    ; "none", "bullet" or "number", read off the first paragraph the command
    ; would act on — which is what a toggle needs in order to know whether it
    ; is turning a list on or off.
    fn listKind:string () {
        def paras:[PptxParagraph] (this.listParagraphs())
        if ((array_length paras) == 0) {
            return "none"
        }
        def first:PptxParagraph (itemAt paras 0)
        if (first.hasBullet == false) {
            return "none"
        }
        if first.bulletAutoNum {
            return "number"
        }
        return "bullet"
    }

    fn setListKind:boolean (kind:string) {
        def paras:[PptxParagraph] (this.listParagraphs())
        if ((array_length paras) == 0) {
            return false
        }
        def i:int 0
        while (i < (array_length paras)) {
            def para:PptxParagraph (itemAt paras i)
            ; Stated on the paragraph, so the layout's inherited list style
            ; does not put the bullet back that this just took away.
            para.bulletSet = true
            if (kind == "none") {
                para.hasBullet = false
                para.bulletAutoNum = false
            }
            if (kind == "bullet") {
                para.hasBullet = true
                para.bulletAutoNum = false
                if ((strlen para.bulletChar) == 0) {
                    para.bulletChar = "\u2022"
                }
            }
            if (kind == "number") {
                para.hasBullet = true
                para.bulletAutoNum = true
            }
            i = (i + 1)
        }
        this.pushSnapshot(("list " + kind))
        return true
    }

    ; One level in or out. The level is what the layout indents by and what
    ; the numbering counts within, so a sub-list starts at one — and when the
    ; deck stated its own `marL`, that moves with the level too, or nothing
    ; on screen would change.
    fn indentList:boolean (delta:int) {
        def paras:[PptxParagraph] (this.listParagraphs())
        if ((array_length paras) == 0) {
            return false
        }
        def moved:int 0
        def i:int 0
        while (i < (array_length paras)) {
            def para:PptxParagraph (itemAt paras i)
            def want:int (para.level + delta)
            if (want < 0) {
                want = 0
            }
            if (want > 8) {
                want = 8
            }
            if (want != para.level) {
                if para.marginSet {
                    para.marginLeftPt = (para.marginLeftPt + ((to_double (want - para.level)) * 18.0))
                    if (para.marginLeftPt < 0.0) {
                        para.marginLeftPt = 0.0
                    }
                }
                para.level = want
                moved = (moved + 1)
            }
            i = (i + 1)
        }
        if (moved == 0) {
            return false
        }
        this.pushSnapshot("list indent")
        return true
    }

    fn styleTextRange:boolean (what:string flag:boolean size:double text:string) {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        if (this.textSelectionEmpty()) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        PptxTextEdit.applyStyle(sh.text anchor caret what flag size text)
        this.pushSnapshot(("text " + what))
        return true
    }

    fn selectionIsAll:boolean (what:string) {
        def hit@(optional):PptxShape (this.editingShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        return (PptxTextEdit.rangeIsAll(sh.text anchor caret what))
    }


    ; --- what a drag over empty canvas selects --------------------------------

    sfn rectsOverlap:boolean (ax:double ay:double aw:double ah:double bx:double by:double bw:double bh:double) {
        if ((ax + aw) < bx) {
            return false
        }
        if ((bx + bw) < ax) {
            return false
        }
        if ((ay + ah) < by) {
            return false
        }
        if ((by + bh) < ay) {
            return false
        }
        return true
    }

    ; A rubber band takes what it TOUCHES rather than only what it encloses:
    ; the enclosing rule is PowerPoint's and it makes a band across a row of
    ; shapes select nothing at all.
    fn selectInRect:int (x:double y:double w:double h:double additive:boolean) {
        if (additive == false) {
            this.clearSelection()
        }
        def rx:double x
        def ry:double y
        def rw:double w
        def rh:double h
        if (rw < 0.0) {
            rx = (x + w)
            rw = (0.0 - w)
        }
        if (rh < 0.0) {
            ry = (y + h)
            rh = (0.0 - h)
        }
        def shapes:[PptxShape] (this.editableShapes())
        def hits:int 0
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (PptxEditor.rectsOverlap(rx ry rw rh sh.x sh.y sh.width sh.height)) {
                this.addToSelection(sh.editId)
                hits = (hits + 1)
            }
            i = (i + 1)
        }
        return hits
    }

    ; --- the clipboard --------------------------------------------------------

    fn copySelection:int () {
        def shapes:[PptxShape] (this.selectedShapes())
        if ((array_length shapes) == 0) {
            return 0
        }
        def out:[PptxShape]
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            push out (PptxClone.shape(sh))
            i = (i + 1)
        }
        clip = out
        return (array_length out)
    }

    fn cutSelection:int () {
        def n:int (this.copySelection())
        if (n == 0) {
            return 0
        }
        this.deleteSelection()
        return n
    }

    fn clipboardCount:int () {
        return (array_length clip)
    }

    ; Pasting on the slide it was copied from offsets, so the copy is visible;
    ; pasting on another slide puts it where it was, which is what makes
    ; copying a header from one slide to the next useful.
    fn pasteClipboard:boolean (offset:boolean) {
        if ((array_length clip) == 0) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def pasted:[int]
        def i:int 0
        while (i < (array_length clip)) {
            def src:PptxShape (itemAt clip i)
            def copy:PptxShape (PptxClone.shape(src))
            if offset {
                copy.x = (copy.x + 10.0)
                copy.y = (copy.y + 10.0)
            }
            copy.locked = false
            this.assignIdTo(copy)
            push s.shapes copy
            push pasted copy.editId
            i = (i + 1)
        }
        this.clearSelection()
        def j:int 0
        while (j < (array_length pasted)) {
            push selection (itemAt pasted j)
            j = (j + 1)
        }
        this.pushSnapshot("paste")
        return true
    }

    ; --- locking --------------------------------------------------------------

    ; Mirroring, which is a flag rather than a transform: the box stays where
    ; it is and what is drawn in it is read the other way round.
    fn flipSelection:boolean (horizontal:boolean) {
        def shapes:[PptxShape] (this.movableShapes())
        if ((array_length shapes) == 0) {
            return false
        }
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if horizontal {
                sh.flipH = (sh.flipH == false)
            } {
                sh.flipV = (sh.flipV == false)
            }
            i = (i + 1)
        }
        this.pushSnapshot("flip")
        return true
    }

    fn setLocked:boolean (locked:boolean) {
        def shapes:[PptxShape] (this.selectedShapes())
        if ((array_length shapes) == 0) {
            return false
        }
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            sh.locked = locked
            i = (i + 1)
        }
        this.pushSnapshot("lock")
        return true
    }

    fn selectionLocked:boolean () {
        def shapes:[PptxShape] (this.selectedShapes())
        if ((array_length shapes) == 0) {
            return false
        }
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (sh.locked == false) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; The shapes a transform may touch: everything selected that is not locked.
    fn movableShapes:[PptxShape] () {
        def out:[PptxShape]
        def shapes:[PptxShape] (this.selectedShapes())
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (sh.locked == false) {
                push out sh
            }
            i = (i + 1)
        }
        return out
    }

    ; --- the grid -------------------------------------------------------------

    sfn snapToStep:double (v:double step:double) {
        if (step <= 0.0) {
            return v
        }
        ; Rounded on the magnitude, sign put back: `to_int` floors, so
        ; subtracting a half on the negative side rounds away from zero twice
        ; and -11 on a 9pt grid lands on -18.
        def n:double (v / step)
        def neg:boolean (n < 0.0)
        def mag:double n
        if neg {
            mag = (0.0 - n)
        }
        def k:int (to_int (mag + 0.5))
        def out:double ((to_double k) * step)
        if neg {
            return (0.0 - out)
        }
        return out
    }

    fn setGrid:void (on:boolean) {
        gridEnabled = on
    }


    ; --- the format painter ---------------------------------------------------

    fn copyFormat:boolean () {
        def hit@(optional):PptxShape (this.firstSelected())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        def f (new PptxFormat())
        f.fill = (PptxClone.color(sh.fill))
        f.grad = (PptxClone.gradient(sh.fillGrad))
        f.line = (PptxClone.color(sh.line))
        f.lineWidthPt = sh.lineWidthPt
        f.shadow = (PptxClone.shadow(sh.shadow))
        if sh.hasText {
            if ((array_length sh.text.paragraphs) > 0) {
                def para:PptxParagraph (itemAt sh.text.paragraphs 0)
                f.align = para.align
                f.alignSet = para.alignSet
                if ((array_length para.runs) > 0) {
                    def run:PptxTextRun (itemAt para.runs 0)
                    f.hasText = true
                    f.bold = run.bold
                    f.italic = run.italic
                    f.sizePt = run.fontSizePt
                    f.sizeSet = run.sizeSet
                    f.family = run.fontFamily
                    f.color = (PptxClone.color(run.color))
                }
            }
        }
        format = f
        formatSet = true
        return true
    }

    fn hasFormat:boolean () {
        return formatSet
    }

    ; Painted onto everything selected that is not locked. Text properties
    ; reach a shape only if it HAS text — a picture does not become bold.
    fn applyFormat:boolean () {
        if (formatSet == false) {
            return false
        }
        def shapes:[PptxShape] (this.movableShapes())
        if ((array_length shapes) == 0) {
            return false
        }
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if (sh.kind != (PptxShapeKind.picture())) {
                sh.fill = (PptxClone.color(format.fill))
                sh.fillGrad = (PptxClone.gradient(format.grad))
            }
            sh.line = (PptxClone.color(format.line))
            sh.lineWidthPt = format.lineWidthPt
            sh.shadow = (PptxClone.shadow(format.shadow))
            if sh.hasText {
                def pi:int 0
                while (pi < (array_length sh.text.paragraphs)) {
                    def para:PptxParagraph (itemAt sh.text.paragraphs pi)
                    if format.alignSet {
                        para.align = format.align
                        para.alignSet = true
                    }
                    if format.hasText {
                        def ri:int 0
                        while (ri < (array_length para.runs)) {
                            def run:PptxTextRun (itemAt para.runs ri)
                            run.bold = format.bold
                            run.boldSet = true
                            run.italic = format.italic
                            run.italicSet = true
                            run.fontSizePt = format.sizePt
                            run.sizeSet = format.sizeSet
                            run.fontFamily = format.family
                            run.color = (PptxClone.color(format.color))
                            ri = (ri + 1)
                        }
                    }
                    pi = (pi + 1)
                }
            }
            i = (i + 1)
        }
        this.pushSnapshot("format")
        return true
    }


    ; --- the theme ------------------------------------------------------------
    ;
    ; A deck's colours mostly come from its palette, and the resolver keeps
    ; that provenance now, so re-theming is: put a new palette in the theme and
    ; ask every colour that came from one to resolve again.

    sfn paletteNames:[string] () {
        return ([] _:string ( "office" "forest" "berry" "slate" "sunset" ))
    }

    sfn paletteColors:[string] (name:string) {
        ; dk1 lt1 dk2 lt2 accent1..6 hlink folHlink
        if (name == "forest") {
            return ([] _:string ( "1E2B22" "FFFFFF" "375845" "EAF2EC" "217346" "6BA644" "9BC53D" "C7D96A" "2F6F5E" "48A9A6" "1F6F54" "6B7C74" ))
        }
        if (name == "berry") {
            return ([] _:string ( "2B1A22" "FFFFFF" "5A2B3F" "F6EAF0" "B0295E" "E0518A" "F08CB4" "8E44AD" "C2185B" "6A1B4D" "AD1457" "7B5E6B" ))
        }
        if (name == "slate") {
            return ([] _:string ( "1B1F24" "FFFFFF" "36414D" "EDF1F5" "3D5A80" "5C82B2" "98C1D9" "6C7A89" "2F4858" "8FA6B8" "2C5F8A" "6E7B87" ))
        }
        if (name == "sunset") {
            return ([] _:string ( "2A1B12" "FFFFFF" "5A3924" "FBEEE4" "E4572E" "F5A623" "F2C14E" "C1440E" "8C3503" "A44A3F" "D2691E" "8B6F5E" ))
        }
        return ([] _:string ( "000000" "FFFFFF" "44546A" "E7E6E6" "4472C4" "ED7D31" "A5A5A5" "FFC000" "5B9BD5" "70AD47" "0563C1" "954F72" ))
    }

    fn applyPalette:boolean (name:string) {
        def cols:[string] (PptxEditor.paletteColors(name))
        if ((array_length cols) < 12) {
            return false
        }
        def slots:[string] ([] _:string ( "dk1" "lt1" "dk2" "lt2" "accent1" "accent2" "accent3" "accent4" "accent5" "accent6" "hlink" "folHlink" ))
        def i:int 0
        while (i < (array_length slots)) {
            doc.theme.setColor((itemAt slots i) (itemAt cols i))
            i = (i + 1)
        }
        this.retheme()
        this.pushSnapshot(("theme " + name))
        return true
    }

    fn setThemeColor:boolean (slot:string hex:string) {
        if ((strlen slot) == 0) {
            return false
        }
        doc.theme.setColor(slot hex)
        this.retheme()
        this.pushSnapshot("theme colour")
        return true
    }

    ; Every colour in the deck that came from the palette, resolved again —
    ; including the master and layout sheets, so a layout applied afterwards
    ; arrives in the new colours too.
    fn retheme:void () {
        ; As with `remergeChrome`: every slide changes, so every slide says so.
        this.touchAllSlides()
        def si:int 0
        while (si < (array_length doc.slides)) {
            def slide:PptxSlide (itemAt doc.slides si)
            this.rethemeColor(slide.bg)
            def i:int 0
            while (i < (array_length slide.shapes)) {
                this.rethemeShape((itemAt slide.shapes i))
                i = (i + 1)
            }
            this.rethemeShape(slide.notes)
            slide.dirty = true
            nextRevision = (nextRevision + 1)
            slide.revision = nextRevision
            si = (si + 1)
        }
        def mkeys:[string] (keys doc.masters)
        def mi:int 0
        while (mi < (array_length mkeys)) {
            def sheet@(optional):PptxSheet (get doc.masters (itemAt mkeys mi))
            if (!null? sheet) {
                this.rethemeSheet((unwrap sheet))
            }
            mi = (mi + 1)
        }
        def lkeys:[string] (keys doc.layouts)
        def li:int 0
        while (li < (array_length lkeys)) {
            def lsheet@(optional):PptxSheet (get doc.layouts (itemAt lkeys li))
            if (!null? lsheet) {
                this.rethemeSheet((unwrap lsheet))
            }
            li = (li + 1)
        }
    }

    fn rethemeSheet:void (sheet:PptxSheet) {
        this.rethemeColor(sheet.bg)
        def i:int 0
        while (i < (array_length sheet.shapes)) {
            this.rethemeShape((itemAt sheet.shapes i))
            i = (i + 1)
        }
    }

    fn rethemeShape:void (shape:PptxShape) {
        this.rethemeColor(shape.fill)
        this.rethemeColor(shape.line)
        this.rethemeColor(shape.fillGrad.c1)
        this.rethemeColor(shape.fillGrad.c2)
        this.rethemeColor(shape.shadow.color)
        this.rethemeColor(shape.text.defColor)
        def pi:int 0
        while (pi < (array_length shape.text.paragraphs)) {
            def para:PptxParagraph (itemAt shape.text.paragraphs pi)
            def ri:int 0
            while (ri < (array_length para.runs)) {
                this.rethemeColor(((itemAt para.runs ri).color))
                ri = (ri + 1)
            }
            pi = (pi + 1)
        }
        def ci:int 0
        while (ci < (array_length shape.tableCells)) {
            this.rethemeColor(((itemAt shape.tableCells ci).fill))
            ci = (ci + 1)
        }
        def k:int 0
        while (k < (array_length shape.children)) {
            this.rethemeShape((itemAt shape.children k))
            k = (k + 1)
        }
    }

    fn rethemeColor:void (c:PptxColor) {
        if (c.isSet == false) {
            return
        }
        if (c.isScheme == false) {
            return
        }
        def key:string (resolver.mapSchemeName(c.scheme))
        c.srgb = (doc.theme.colorOf(key))
    }

    fn themeColor:string (slot:string) {
        return (doc.theme.colorOf(slot))
    }

    ; --- the layout -----------------------------------------------------------

    fn layoutParts:[string] () {
        return (keys doc.layouts)
    }

    fn slideLayout:string () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return ""
        }
        return ((unwrap slide).layoutPart)
    }

    ; Picking a layout swaps the chrome the slide inherits — the master's, then
    ; the new layout's — and leaves everything the slide itself declares where
    ; it is. It is the same merge the resolver does at load, done again with a
    ; different layout.
    fn applyLayout:boolean (part:string) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def sheet@(optional):PptxSheet (get doc.layouts part)
        if (null? sheet) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def layout:PptxSheet (unwrap sheet)
        def authored:[PptxShape]
        def i:int 0
        while (i < (array_length s.shapes)) {
            def sh:PptxShape (itemAt s.shapes i)
            if (sh.inherited == false) {
                push authored sh
            }
            i = (i + 1)
        }
        def merged:[PptxShape]
        def master@(optional):PptxSheet (get doc.masters s.masterPart)
        if (null? master) {
            def mkeys:[string] (keys doc.masters)
            if ((array_length mkeys) > 0) {
                master = (get doc.masters (itemAt mkeys 0))
            }
        }
        if (!null? master) {
            def ms:PptxSheet (unwrap master)
            def mi:int 0
            while (mi < (array_length ms.shapes)) {
                def mshape:PptxShape (itemAt ms.shapes mi)
                if (mshape.isPlaceholder == false) {
                    def mc:PptxShape (PptxClone.shape(mshape))
                    mc.inherited = true
                    this.assignIdTo(mc)
                    push merged mc
                }
                mi = (mi + 1)
            }
        }
        def li:int 0
        while (li < (array_length layout.shapes)) {
            def lshape:PptxShape (itemAt layout.shapes li)
            if (lshape.isPlaceholder == false) {
                def lc:PptxShape (PptxClone.shape(lshape))
                lc.inherited = true
                this.assignIdTo(lc)
                push merged lc
            }
            li = (li + 1)
        }
        def j:int 0
        while (j < (array_length authored)) {
            push merged (itemAt authored j)
            j = (j + 1)
        }
        s.shapes = merged
        s.layoutPart = part
        if (layout.bg.isSet) {
            if (s.bg.isSet == false) {
                s.bg = (PptxClone.color(layout.bg))
            }
        }
        this.clearSelection()
        this.pushSnapshot("layout")
        return true
    }

    ; --- the slide's own background -------------------------------------------

    fn setSlideBackground:boolean (hex:string) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        s.bg = (PptxColor.srgbOf(hex))
        this.pushSnapshot("background")
        return true
    }

    fn setSlideBackgroundScheme:boolean (scheme:string) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def c (new PptxColor())
        c.isSet = true
        c.isScheme = true
        c.scheme = scheme
        c.srgb = (doc.theme.colorOf((resolver.mapSchemeName(scheme))))
        s.bg = c
        this.pushSnapshot("background")
        return true
    }

    fn clearSlideBackground:boolean () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        def none (new PptxColor())
        s.bg = none
        this.pushSnapshot("background")
        return true
    }

    ; --- the notes ------------------------------------------------------------

    fn notesShape@(optional):PptxShape () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            def __none@(optional):PptxShape
            return __none
        }
        def s:PptxSlide (unwrap slide)
        if (s.notes.editId == 0) {
            this.assignIdTo(s.notes)
        }
        s.notes.hasText = true
        if ((array_length s.notes.text.paragraphs) == 0) {
            def para (new PptxParagraph())
            push s.notes.text.paragraphs para
        }
        def hit@(optional):PptxShape s.notes
        return hit
    }

    fn notesText:string () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return ""
        }
        return ((unwrap slide).notesText())
    }

    fn setNotes:boolean (text:string) {
        def hit@(optional):PptxShape (this.notesShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        PptxEditor.setBodyText(sh.text text)
        this.pushSnapshot("notes")
        return true
    }

    fn editNotes:boolean () {
        def hit@(optional):PptxShape (this.notesShape())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        ; The notes are not on the slide, so editing them is not a selection:
        ; the caret goes there without anything being picked up.
        this.clearSelection()
        editingId = sh.editId
        def end:PptxTextPos (PptxTextEdit.docEnd(sh.text))
        caret = end
        anchor = (end.copy())
        return true
    }

    fn isEditingNotes:boolean () {
        if (editingId <= 0) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s:PptxSlide (unwrap slide)
        return (s.notes.editId == editingId)
    }


    ; --- editing a master or a layout -----------------------------------------
    ;
    ; A sheet is a slide with a different name — the same shapes, the same
    ; geometry — so editing one is standing a slide in front of the editor and
    ; letting every operation work as it always does. What comes back out is
    ; copied into the sheet, and the slides that inherit from it are re-merged.

    fn sheetFor@(optional):PptxSheet (part:string) {
        def m@(optional):PptxSheet (get doc.masters part)
        if (!null? m) {
            return m
        }
        def l@(optional):PptxSheet (get doc.layouts part)
        return l
    }

    fn editSheet:boolean (part:string) {
        def sheet@(optional):PptxSheet (this.sheetFor(part))
        if (null? sheet) {
            return false
        }
        def sh:PptxSheet (unwrap sheet)
        def stand (new PptxSlide())
        stand.partPath = part
        stand.width = doc.slideWidth
        stand.height = doc.slideHeight
        stand.bg = sh.bg
        stand.shapes = sh.shapes
        def i:int 0
        while (i < (array_length stand.shapes)) {
            def s2:PptxShape (itemAt stand.shapes i)
            if (s2.editId == 0) {
                this.assignIdTo(s2)
            }
            i = (i + 1)
        }
        sheetSlide = stand
        sheetPart = part
        this.clearSelection()
        return true
    }

    fn isEditingSheet:boolean () {
        return ((strlen sheetPart) > 0)
    }

    fn editingSheetPart:string () {
        return sheetPart
    }

    fn masterParts:[string] () {
        return (keys doc.masters)
    }

    ; Copy what was done back onto the sheet, and give every slide that follows
    ; it its chrome again.
    fn exitSheet:boolean () {
        if ((strlen sheetPart) == 0) {
            return false
        }
        def part:string sheetPart
        def sheet@(optional):PptxSheet (this.sheetFor(part))
        if (!null? sheet) {
            def sh:PptxSheet (unwrap sheet)
            sh.shapes = sheetSlide.shapes
            sh.bg = sheetSlide.bg
            sh.dirty = true
        }
        sheetPart = ""
        this.clearSelection()
        this.remergeChrome()
        return true
    }

    ; The resolver's merge, run again for every slide: master chrome, then
    ; layout chrome, then whatever the slide itself declares.
    fn remergeChrome:void () {
        ; Every slide is rewritten here, not just the one in front of you, and
        ; the history has to be told — it shares its copies of the slides that
        ; did not change, and tells them apart by revision.
        this.touchAllSlides()
        def si:int 0
        while (si < (array_length doc.slides)) {
            def slide:PptxSlide (itemAt doc.slides si)
            def authored:[PptxShape]
            def i:int 0
            while (i < (array_length slide.shapes)) {
                def sh:PptxShape (itemAt slide.shapes i)
                if (sh.inherited == false) {
                    push authored sh
                }
                i = (i + 1)
            }
            def merged:[PptxShape]
            def master@(optional):PptxSheet (get doc.masters slide.masterPart)
            if (null? master) {
                def mkeys:[string] (keys doc.masters)
                if ((array_length mkeys) > 0) {
                    master = (get doc.masters (itemAt mkeys 0))
                }
            }
            if (!null? master) {
                def ms:PptxSheet (unwrap master)
                def mi:int 0
                while (mi < (array_length ms.shapes)) {
                    def mshape:PptxShape (itemAt ms.shapes mi)
                    if (mshape.isPlaceholder == false) {
                        def mc:PptxShape (PptxClone.shape(mshape))
                        mc.inherited = true
                        this.assignIdTo(mc)
                        push merged mc
                    }
                    mi = (mi + 1)
                }
            }
            def layout@(optional):PptxSheet (get doc.layouts slide.layoutPart)
            if (!null? layout) {
                def ls:PptxSheet (unwrap layout)
                def li:int 0
                while (li < (array_length ls.shapes)) {
                    def lshape:PptxShape (itemAt ls.shapes li)
                    if (lshape.isPlaceholder == false) {
                        def lc:PptxShape (PptxClone.shape(lshape))
                        lc.inherited = true
                        this.assignIdTo(lc)
                        push merged lc
                    }
                    li = (li + 1)
                }
            }
            def j:int 0
            while (j < (array_length authored)) {
                push merged (itemAt authored j)
                j = (j + 1)
            }
            slide.shapes = merged
            si = (si + 1)
        }
    }


    ; --- what every slide says: footers and page numbers -----------------------
    ;
    ; These belong on the master, which is where PowerPoint keeps them: put one
    ; there and every slide that follows the master has it, without a copy per
    ; slide to keep in step.

    fn masterSheet@(optional):PptxSheet () {
        def mkeys:[string] (keys doc.masters)
        if ((array_length mkeys) == 0) {
            def __none@(optional):PptxSheet
            return __none
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (!null? slide) {
            def s:PptxSlide (unwrap slide)
            def own@(optional):PptxSheet (get doc.masters s.masterPart)
            if (!null? own) {
                return own
            }
        }
        return (get doc.masters (itemAt mkeys 0))
    }

    sfn namedShape@(optional):PptxShape (sheet:PptxSheet name:string) {
        def i:int 0
        while (i < (array_length sheet.shapes)) {
            def sh:PptxShape (itemAt sheet.shapes i)
            if (sh.name == name) {
                def hit@(optional):PptxShape sh
                return hit
            }
            i = (i + 1)
        }
        def __none@(optional):PptxShape
        return __none
    }

    fn dropNamed:void (sheet:PptxSheet name:string) {
        def kept:[PptxShape]
        def i:int 0
        while (i < (array_length sheet.shapes)) {
            def sh:PptxShape (itemAt sheet.shapes i)
            if (sh.name != name) {
                push kept sh
            }
            i = (i + 1)
        }
        sheet.shapes = kept
    }

    fn showSlideNumbers:boolean (on:boolean) {
        def sheet@(optional):PptxSheet (this.masterSheet())
        if (null? sheet) {
            return false
        }
        def ms:PptxSheet (unwrap sheet)
        this.dropNamed(ms "Slide Number Placeholder")
        if on {
            def sh (new PptxShape())
            sh.name = "Slide Number Placeholder"
            sh.kind = (PptxShapeKind.shape())
            sh.hasXfrm = true
            sh.width = 60.0
            sh.height = 20.0
            sh.x = ((doc.slideWidth - sh.width) - 24.0)
            sh.y = ((doc.slideHeight - sh.height) - 12.0)
            sh.hasText = true
            def para (new PptxParagraph())
            para.align = "r"
            para.alignSet = true
            def run (new PptxTextRun())
            run.field = "slidenum"
            run.text = (to_string (slideIndex + 1))
            run.fontSizePt = 12.0
            run.sizeSet = true
            run.color = (PptxColor.srgbOf("595959"))
            push para.runs run
            push sh.text.paragraphs para
            this.assignIdTo(sh)
            push ms.shapes sh
        }
        ms.dirty = true
        this.remergeChrome()
        this.pushSnapshot("slide numbers")
        return true
    }

    fn slideNumbersShown:boolean () {
        def sheet@(optional):PptxSheet (this.masterSheet())
        if (null? sheet) {
            return false
        }
        def hit@(optional):PptxShape (PptxEditor.namedShape((unwrap sheet) "Slide Number Placeholder"))
        return (!null? hit)
    }

    fn setFooter:boolean (text:string) {
        def sheet@(optional):PptxSheet (this.masterSheet())
        if (null? sheet) {
            return false
        }
        def ms:PptxSheet (unwrap sheet)
        this.dropNamed(ms "Footer Placeholder")
        if ((strlen text) > 0) {
            def sh (new PptxShape())
            sh.name = "Footer Placeholder"
            sh.kind = (PptxShapeKind.shape())
            sh.hasXfrm = true
            sh.width = (doc.slideWidth * 0.5)
            sh.height = 20.0
            sh.x = ((doc.slideWidth - sh.width) * 0.5)
            sh.y = ((doc.slideHeight - sh.height) - 12.0)
            sh.hasText = true
            def para (new PptxParagraph())
            para.align = "ctr"
            para.alignSet = true
            def run (new PptxTextRun())
            run.text = text
            run.fontSizePt = 12.0
            run.sizeSet = true
            run.color = (PptxColor.srgbOf("595959"))
            push para.runs run
            push sh.text.paragraphs para
            this.assignIdTo(sh)
            push ms.shapes sh
        }
        ms.dirty = true
        this.remergeChrome()
        this.pushSnapshot("footer")
        return true
    }

    fn footerText:string () {
        def sheet@(optional):PptxSheet (this.masterSheet())
        if (null? sheet) {
            return ""
        }
        def hit@(optional):PptxShape (PptxEditor.namedShape((unwrap sheet) "Footer Placeholder"))
        if (null? hit) {
            return ""
        }
        return (((unwrap hit).text.plainText()))
    }

    ; --- the show: transitions and builds -------------------------------------
    ;
    ; What a slide does when it arrives, and what it does once it is there.
    ; Both are per slide and both survive a save, which is the only thing that
    ; makes them worth having in an editor rather than in the player.

    fn setTransition:boolean (kind:string dir:string seconds:double) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s0:PptxSlide (unwrap slide)
        def tr:PptxTransition s0.transition
        if ((strlen kind) == 0) {
            tr.isSet = false
            tr.kind = ""
            tr.dir = ""
        } {
            tr.isSet = true
            tr.kind = kind
            tr.dir = dir
            if (seconds > 0.0) {
                tr.seconds = seconds
            }
        }
        this.pushSnapshot("transition")
        return true
    }

    fn transitionKind:string () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return ""
        }
        def s0:PptxSlide (unwrap slide)
        if (s0.transition.isSet == false) {
            return ""
        }
        return s0.transition.kind
    }

    ; Advance on a timer as well as on a click. Zero seconds turns it off.
    fn setAdvanceAfter:boolean (seconds:double) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s0:PptxSlide (unwrap slide)
        s0.transition.afterSeconds = seconds
        if (seconds > 0.0) {
            s0.transition.isSet = true
            if ((strlen s0.transition.kind) == 0) {
                s0.transition.kind = "fade"
            }
        }
        this.pushSnapshot("advance")
        return true
    }

    fn buildCount:int () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0
        }
        def s0:PptxSlide (unwrap slide)
        return (array_length s0.build)
    }

    ; Give every selected shape a step of its own, in the order they were
    ; selected — which is what "animate these, one click each" means.
    fn animateSelection:boolean (kind:string seconds:double) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        if ((array_length selection) == 0) {
            return false
        }
        def s0:PptxSlide (unwrap slide)
        def i:int 0
        while (i < (array_length selection)) {
            def id:int (itemAt selection i)
            def already:boolean false
            def k:int 0
            while (k < (array_length s0.build)) {
                def old:PptxBuildStep (itemAt s0.build k)
                if (old.editId == id) {
                    if (old.paragraph < 0) {
                        already = true
                        old.kind = kind
                        if (seconds > 0.0) {
                            old.seconds = seconds
                        }
                    }
                }
                k = (k + 1)
            }
            if (already == false) {
                def step (new PptxBuildStep())
                step.editId = id
                step.kind = kind
                if (seconds > 0.0) {
                    step.seconds = seconds
                }
                push s0.build step
            }
            i = (i + 1)
        }
        this.pushSnapshot("animate")
        return true
    }

    fn clearAnimation:boolean () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s0:PptxSlide (unwrap slide)
        if ((array_length s0.build) == 0) {
            return false
        }
        def empty:[PptxBuildStep]
        s0.build = empty
        this.pushSnapshot("clear animation")
        return true
    }

    ; Move a step earlier or later in the build, which is the whole of an
    ; animation pane that is worth having: the ORDER is the interesting part.
    fn moveBuildStep:boolean (from:int to:int) {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return false
        }
        def s0:PptxSlide (unwrap slide)
        def n:int (array_length s0.build)
        if (from < 0) {
            return false
        }
        if (from >= n) {
            return false
        }
        if (to < 0) {
            return false
        }
        if (to >= n) {
            return false
        }
        if (from == to) {
            return false
        }
        def moved:PptxBuildStep (itemAt s0.build from)
        def out:[PptxBuildStep]
        def i:int 0
        while (i < n) {
            if (i != from) {
                if ((array_length out) == to) {
                    push out moved
                }
                push out (itemAt s0.build i)
            }
            i = (i + 1)
        }
        if ((array_length out) < n) {
            push out moved
        }
        s0.build = out
        this.pushSnapshot("build order")
        return true
    }

    ; Which shapes are visible at a given step of the build. Step 0 is the
    ; slide as it arrives: everything that is not animated. Each click after
    ; that turns one more step on.
    fn shapeVisibleAt:boolean (slide:PptxSlide shape:PptxShape step:int) {
        def i:int 0
        while (i < (array_length slide.build)) {
            def b:PptxBuildStep (itemAt slide.build i)
            if (b.editId == shape.editId) {
                if (b.paragraph < 0) {
                    return (step > i)
                }
            }
            i = (i + 1)
        }
        return true
    }

    ; --- sections -------------------------------------------------------------
    ;
    ; A run of slides under a name. The file names its members by slide id, so
    ; the deck answers "which section is slide 3 in" by asking which section
    ; holds that slide's id.

    fn sectionCount:int () {
        return (array_length doc.sections)
    }

    fn sectionNameAt:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (array_length doc.sections)) {
            return ""
        }
        return ((itemAt doc.sections i).name)
    }

    fn ensureSlideIds:void () {
        def next:int 256
        def i:int 0
        while (i < (array_length doc.slides)) {
            def slide:PptxSlide (itemAt doc.slides i)
            if (slide.slideId >= next) {
                next = (slide.slideId + 1)
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length doc.slides)) {
            def s2:PptxSlide (itemAt doc.slides j)
            if (s2.slideId == 0) {
                s2.slideId = next
                next = (next + 1)
            }
            j = (j + 1)
        }
    }

    ; The section a slide belongs to, or -1. Slides before the first section
    ; belong to none, which is what PowerPoint shows too.
    fn sectionOfSlide:int (index:int) {
        if (index < 0) {
            return (0 - 1)
        }
        if (index >= (array_length doc.slides)) {
            return (0 - 1)
        }
        def id:int ((itemAt doc.slides index).slideId)
        if (id == 0) {
            return (0 - 1)
        }
        def si:int 0
        while (si < (array_length doc.sections)) {
            def sec:PptxSection (itemAt doc.sections si)
            def k:int 0
            while (k < (array_length sec.slideIds)) {
                if ((itemAt sec.slideIds k) == id) {
                    return si
                }
                k = (k + 1)
            }
            si = (si + 1)
        }
        return (0 - 1)
    }

    ; Where in the deck a section begins, or the slide count when none of its
    ; slides are in the deck any more.
    fn sectionStart:int (sec:PptxSection) {
        def best:int (array_length doc.slides)
        def i:int 0
        while (i < (array_length doc.slides)) {
            def slide:PptxSlide (itemAt doc.slides i)
            def k:int 0
            while (k < (array_length sec.slideIds)) {
                if ((itemAt sec.slideIds k) == slide.slideId) {
                    if (i < best) {
                        best = i
                    }
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return best
    }

    ; Start a section at the slide in front of you: it runs from there to the
    ; slide before the next section begins, which is what cutting a deck into
    ; parts means — the slides in between change hands.
    fn addSection:boolean (name:string) {
        this.ensureSlideIds()
        def limit:int (array_length doc.slides)
        def li:int 0
        while (li < (array_length doc.sections)) {
            def other0:PptxSection (itemAt doc.sections li)
            def at:int (this.sectionStart(other0))
            if (at > slideIndex) {
                if (at < limit) {
                    limit = at
                }
            }
            li = (li + 1)
        }
        def sec (new PptxSection())
        sec.name = name
        def i:int slideIndex
        while (i < limit) {
            def slide:PptxSlide (itemAt doc.slides i)
            push sec.slideIds slide.slideId
            i = (i + 1)
        }
        ; A slide can only be in one section, and a section with nothing left
        ; in it is not a section any more.
        def kept:[PptxSection]
        def si:int 0
        while (si < (array_length doc.sections)) {
            def other:PptxSection (itemAt doc.sections si)
            def stay:[int]
            def k:int 0
            while (k < (array_length other.slideIds)) {
                def id:int (itemAt other.slideIds k)
                def claimed:boolean false
                def n:int 0
                while (n < (array_length sec.slideIds)) {
                    if ((itemAt sec.slideIds n) == id) {
                        claimed = true
                    }
                    n = (n + 1)
                }
                if (claimed == false) {
                    push stay id
                }
                k = (k + 1)
            }
            other.slideIds = stay
            if ((array_length stay) > 0) {
                push kept other
            }
            si = (si + 1)
        }
        push kept sec
        doc.sections = kept
        this.sortSections()
        this.pushSnapshot("section")
        return true
    }

    ; Sections read in deck order, so the panel can write each name once above
    ; the run it names.
    fn sortSections:void () {
        def out:[PptxSection]
        def used:[boolean]
        def i:int 0
        while (i < (array_length doc.sections)) {
            push used false
            i = (i + 1)
        }
        def taken:int 0
        while (taken < (array_length doc.sections)) {
            def best:int (0 - 1)
            def bestAt:int 0
            def k:int 0
            while (k < (array_length doc.sections)) {
                if ((itemAt used k) == false) {
                    def at:int (this.sectionStart((itemAt doc.sections k)))
                    if (best < 0) {
                        best = k
                        bestAt = at
                    } {
                        if (at < bestAt) {
                            best = k
                            bestAt = at
                        }
                    }
                }
                k = (k + 1)
            }
            if (best < 0) {
                taken = (array_length doc.sections)
            } {
                set_at used best true
                push out (itemAt doc.sections best)
                taken = (taken + 1)
            }
        }
        doc.sections = out
    }

    fn renameSection:boolean (i:int name:string) {
        if (i < 0) {
            return false
        }
        if (i >= (array_length doc.sections)) {
            return false
        }
        def sec:PptxSection (itemAt doc.sections i)
        sec.name = name
        this.pushSnapshot("rename section")
        return true
    }

    fn removeSection:boolean (i:int) {
        if (i < 0) {
            return false
        }
        if (i >= (array_length doc.sections)) {
            return false
        }
        def out:[PptxSection]
        def k:int 0
        while (k < (array_length doc.sections)) {
            if (k != i) {
                push out (itemAt doc.sections k)
            }
            k = (k + 1)
        }
        doc.sections = out
        this.pushSnapshot("remove section")
        return true
    }

}

; ==============================================================================
; PptxTextLayout - a shape's text broken into lines, once, for everyone
; ==============================================================================
;
; The painter used to hand the renderer a `maxWidth` and let it decide where a
; line breaks, and the caret assumed a paragraph was one line. Both were true
; separately and could not be true together: nothing in the program knew where
; the second line of a wrapped paragraph started.
;
; This is that knowledge, computed once from the model and the measurer, and
; used by three things — the painter, the caret, and the click that puts the
; caret somewhere. A line records which paragraph and which columns it covers,
; so a position in the text and a position on the screen convert both ways.
;
; Coordinates are painter pixels, with the pt→px factor handed in.
; ==============================================================================

Import "PptxModel.rgr"
Import "PptxTextMeasure.rgr"
Import "../../office/text/OfficeText.rgr"
Import "../../evg/EVGCodepoint.rgr"

class PptxTextLine {
    def para:int 0
    def startCol:int 0
    def endCol:int 0
    def x:double 0.0         ; where the text of this line starts
    def y:double 0.0         ; top of the line box
    def w:double 0.0         ; measured width, trailing spaces trimmed
    def h:double 0.0         ; line height
    def size:double 18.0     ; px of the tallest run on it
    def align:string "left"
    def first:boolean false  ; first line of its paragraph
    def bullet:string ""     ; drawn before the first line, when there is one
    def bulletX:double 0.0
    def bulletSize:double 14.0

    ; The scale this line was laid out at, glyphs and all.
    ;
    ; It is not always the host's scale. A body whose face was substituted is
    ; shrunk to fit by `substituteFit`, and the painter then lays out AND
    ; draws at that reduced scale. Anything that measures into a line after
    ; the fact — the caret, the selection band, the column a click landed on —
    ; has to use the same number or it measures glyphs that were never drawn
    ; at that size. It used to use the host's scale, and the caret drifted to
    ; the right of the text by however much the body had been shrunk: a pixel
    ; on a short label, and further with every column on a long one, which is
    ; exactly the "slightly wrong place" a person notices while typing.
    def scale:double 1.0

    Constructor () {
    }
}

class PptxTextLayout {
    ; --- measuring a slice of a paragraph ------------------------------------

    sfn paraText:string (para:PptxParagraph) {
        def out:string ""
        def i:int 0
        while (i < (array_length para.runs)) {
            def run:PptxTextRun (itemAt para.runs i)
            out = (out + run.text)
            i = (i + 1)
        }
        return out
    }

    ; The width of columns [from, to) of a paragraph, run by run, because a
    ; slice can cross a run boundary and the halves are different sizes.
    sfn measureSlice:double (para:PptxParagraph from:int to:int m:PptxTextMeasure scale:double) {
        if (to <= from) {
            return 0.0
        }
        def total:double 0.0
        def at:int 0
        def i:int 0
        while (i < (array_length para.runs)) {
            def run:PptxTextRun (itemAt para.runs i)
            def len:int (strlen run.text)
            def s0:int at
            def s1:int (at + len)
            def a:int from
            def b:int to
            if (a < s0) {
                a = s0
            }
            if (b > s1) {
                b = s1
            }
            if (b > a) {
                def piece:string (substring run.text (a - s0) (b - s0))
                def size:double (run.fontSizePt * scale)
                total = (total + (m.widthOfIn(piece size run.bold run.italic run.fontFamily)))
            }
            at = s1
            i = (i + 1)
        }
        return total
    }

    sfn maxRunSize:double (para:PptxParagraph from:int to:int scale:double) {
        def best:double 0.0
        def at:int 0
        def i:int 0
        while (i < (array_length para.runs)) {
            def run:PptxTextRun (itemAt para.runs i)
            def len:int (strlen run.text)
            def s0:int at
            def s1:int (at + len)
            def overlaps:boolean true
            if (s1 <= from) {
                overlaps = false
            }
            if (s0 >= to) {
                overlaps = false
            }
            if (len == 0) {
                if (i == 0) {
                    overlaps = true
                }
            }
            if overlaps {
                def size:double (run.fontSizePt * scale)
                if (size > best) {
                    best = size
                }
            }
            at = s1
            i = (i + 1)
        }
        if (best <= 0.0) {
            best = (18.0 * scale)
        }
        return best
    }

    ; --- breaking ------------------------------------------------------------

    ; One rule, in `EVGCodepoint`, so this wrapper and the one the .docx
    ; reader goes through cannot disagree about where a line may break.
    sfn isSpace:boolean (c:int) {
        return (EVGCodepoint.isSpace(c))
    }

    ; The column after the next run of spaces, i.e. where the next line could
    ; start if this were the break. A chunk is "word + the spaces after it",
    ; which is what makes trailing spaces belong to the line above.
    ; What a numbered item is numbered.
    ;
    ; The file does not store the number. It stores that the paragraph is
    ; numbered, in which scheme, and where a run of them starts counting; the
    ; number is the paragraph's position among the numbered ones directly
    ; above it at the same level. A paragraph that is not numbered, or is at a
    ; shallower level, ends the run — which is what makes a sub-list restart
    ; at one and the list it interrupted carry on afterwards.
    sfn autoNumber:string (body:PptxTextBody at:int) {
        def para:PptxParagraph (itemAt body.paragraphs at)
        def n:int para.bulletStartAt
        def i:int (at - 1)
        def counting:boolean true
        while (counting) {
            if (i < 0) {
                counting = false
            } {
                def prev:PptxParagraph (itemAt body.paragraphs i)
                if (prev.level < para.level) {
                    ; The item this one is nested under: the sub-list starts
                    ; over rather than continuing its parent's count.
                    counting = false
                } {
                    if (prev.level == para.level) {
                        if (prev.bulletAutoNum == false) {
                            counting = false
                        } {
                            n = (n + 1)
                        }
                    }
                    ; A DEEPER level between two items is the sub-list under
                    ; the earlier one, and does not interrupt this count.
                }
                i = (i - 1)
            }
        }
        return (PptxTextLayout.numberIn(para.bulletScheme n))
    }

    ; The ordinal written the way the scheme asks for it. The schemes here are
    ; the ones a deck actually uses; anything else counts in arabic, which is
    ; wrong in style but never wrong in order.
    sfn numberIn:string (scheme:string n:int) {
        def body:string (to_string n)
        if ((indexOf scheme "alphaLc") == 0) {
            body = (PptxTextLayout.alpha(n false))
        }
        if ((indexOf scheme "alphaUc") == 0) {
            body = (PptxTextLayout.alpha(n true))
        }
        if ((indexOf scheme "romanLc") == 0) {
            body = (PptxTextLayout.roman(n false))
        }
        if ((indexOf scheme "romanUc") == 0) {
            body = (PptxTextLayout.roman(n true))
        }
        if (PptxTextLayout.tailIs(scheme "ParenBoth")) {
            return ("(" + body + ")")
        }
        if (PptxTextLayout.tailIs(scheme "ParenR")) {
            return (body + ")")
        }
        return (body + ".")
    }

    sfn tailIs:boolean (s:string tail:string) {
        def n:int (strlen s)
        def t:int (strlen tail)
        if (t > n) {
            return false
        }
        return ((substring s (n - t) n) == tail)
    }

    ; a, b, … z, aa, ab — the spreadsheet column rule, which is what these
    ; schemes use once they run past 26.
    sfn alpha:string (n:int upper:boolean) {
        def letters:string "abcdefghijklmnopqrstuvwxyz"
        if upper {
            letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        }
        if (n < 1) {
            return (substring letters 0 1)
        }
        def out:string ""
        def v:int n
        while (v > 0) {
            def r:int ((v - 1) % 26)
            out = ((substring letters r (r + 1)) + out)
            v = (idiv (v - 1) 26)
        }
        return out
    }

    sfn roman:string (n:int upper:boolean) {
        if (n < 1) {
            return "i"
        }
        if (n > 3999) {
            return (to_string n)
        }
        def vals:[int] ([] _:int ( 1000 900 500 400 100 90 50 40 10 9 5 4 1 ))
        def syms:[string] ([] _:string ( "m" "cm" "d" "cd" "c" "xc" "l" "xl" "x" "ix" "v" "iv" "i" ))
        if upper {
            syms = ([] _:string ( "M" "CM" "D" "CD" "C" "XC" "L" "XL" "X" "IX" "V" "IV" "I" ))
        }
        def out:string ""
        def v:int n
        def i:int 0
        while (i < (array_length vals)) {
            def val:int (itemAt vals i)
            while (v >= val) {
                out = (out + (itemAt syms i))
                v = (v - val)
            }
            i = (i + 1)
        }
        return out
    }

    ; Where this line has to stop regardless of width: the next line break in
    ; the paragraph, or the end of it.
    sfn nextBreak:int (text:string from:int n:int) {
        def i:int from
        while (i < n) {
            if ((charAt text i) == 10) {
                return i
            }
            i = (i + 1)
        }
        return n
    }

    sfn nextChunk:int (text:string from:int) {
        def n:int (strlen text)
        def i:int from
        def inWord:boolean true
        while (inWord) {
            if (i >= n) {
                inWord = false
            } {
                def c:int (charAt text i)
                if (PptxTextLayout.isSpace(c)) {
                    inWord = false
                } {
                    i = (i + 1)
                    ; A hyphen ends the chunk AFTER itself, so it stays on the
                    ; line above — see `EVGCodepoint.breaksAfter`. Not when it
                    ; is the chunk's first character: "-5" is not a place to
                    ; break, and a chunk of nothing but a hyphen would loop.
                    if (EVGCodepoint.breaksAfter(c)) {
                        if (i > (from + 1)) {
                            inWord = false
                        }
                    }
                }
            }
        }
        def inSpace:boolean true
        while (inSpace) {
            if (i >= n) {
                inSpace = false
            } {
                if (PptxTextLayout.isSpace((charAt text i))) {
                    i = (i + 1)
                } {
                    inSpace = false
                }
            }
        }
        if (i <= from) {
            return (from + 1)
        }
        return i
    }

    sfn trimEndCol:int (text:string from:int to:int) {
        def end:int to
        while (end > from) {
            if (PptxTextLayout.isSpace((charAt text (end - 1)))) {
                end = (end - 1)
            } {
                return end
            }
        }
        return from
    }

    ; --- the layout ----------------------------------------------------------
    ;
    ; `x` / `y` / `w` / `h` are the shape's box in painter pixels; the insets
    ; are taken out here, the same way the painter used to take them out.

    ; Which edge a paragraph is aligned to.
    ;
    ; A paragraph that STATES an alignment gets it. One that does not is
    ; aligned to the start of its own reading direction: left for a
    ; left-to-right paragraph, RIGHT for a right-to-left one. That is what
    ; PowerPoint does, and it is the only thing it can do — DrawingML has no
    ; "start" or "end" the way Word's `w:jc` does, so an unstated alignment
    ; has to be resolved from the direction rather than defaulted to a side.
    ;
    ; The deck this was reported on is the ordinary case: an Arabic body with
    ; no `<a:pPr>` at all, so no `algn` and no `rtl` either. Every line of it
    ; came out ragged against the LEFT edge of the box while PowerPoint had it
    ; flush against the right.
    ;
    ; Where the direction comes from, in order: what the paragraph says, and
    ; failing that what its text says — which is the same first-strong-
    ; character rule the bidirectional algorithm resolves a paragraph level
    ; with, and is exactly the question `OfficeText.isRtl` answers.
    sfn alignOf:string (para:PptxParagraph text:string) {
        if para.alignSet {
            return para.align
        }
        if (para.rtl == 1) {
            return "r"
        }
        if (para.rtl == 0) {
            return para.align
        }
        if (OfficeText.isRtl(text)) {
            return "r"
        }
        return para.align
    }

    sfn layout:[PptxTextLine] (body:PptxTextBody m:PptxTextMeasure scale:double x:double y:double w:double h:double) {
        def out:[PptxTextLine]
        def padL:double (body.insetL * scale)
        def padT:double (body.insetT * scale)
        def padR:double (body.insetR * scale)
        def padB:double (body.insetB * scale)
        def contentW:double ((w - padL) - padR)
        if (contentW < 8.0) {
            contentW = 8.0
        }
        def contentH:double ((h - padT) - padB)
        def contentX:double (x + padL)

        def total:double 0.0
        def pi:int 0
        while (pi < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs pi)
            def text:string (PptxTextLayout.paraText(para))
            def n:int (strlen text)
            def align:string (PptxTextLayout.alignOf(para text))
            ; Where the text starts, and where the bullet hangs. The deck says
            ; both — `marL` is the text's left edge and `indent` is the bullet's
            ; offset from it, negative for the hanging bullet every list has —
            ; and only when it says neither is a level's worth invented.
            def indent:double 0.0
            if para.marginSet {
                indent = (para.marginLeftPt * scale)
            } {
                indent = ((to_double para.level) * 18.0 * scale)
            }
            def bullet:string ""
            def bulletW:double 0.0
            def textSize:double (PptxTextLayout.maxRunSize(para 0 n scale))
            def bulletSize:double textSize
            if (para.bulletSizePt > 0.0) {
                bulletSize = (para.bulletSizePt * scale)
            } {
                if (para.bulletSizePct != 100.0) {
                    bulletSize = (textSize * (para.bulletSizePct / 100.0))
                }
            }
            if para.hasBullet {
                bullet = (para.bulletChar + " ")
                if para.bulletAutoNum {
                    bullet = ((PptxTextLayout.autoNumber(body pi)) + " ")
                }
                bulletW = (m.widthOf(bullet bulletSize false false))
                if (para.indentSet == false) {
                    indent = (indent + (12.0 * scale))
                }
            }
            def avail:double (contentW - indent - bulletW)
            if (avail < 8.0) {
                avail = 8.0
            }
            def spacing:double (para.lineSpacingPct / 100.0)
            if (spacing < 0.8) {
                spacing = 1.0
            }
            total = (total + (para.spaceBeforePt * scale))

            def start:int 0
            def more:boolean true
            def firstLine:boolean true
            while (more) {
                ; A line break INSIDE the paragraph: `<a:br/>`, which a deck
                ; writes wherever someone pressed shift+Enter, and a newline
                ; left in a run's text. Both end the line here whatever room
                ; is left on it, so this line's text stops at `limit` and the
                ; wrap below only ever looks inside that.
                def limit:int (PptxTextLayout.nextBreak(text start n))
                def end:int limit
                if body.wrap {
                    end = start
                    def acc:double 0.0
                    def cursor:int start
                    def stop:boolean false
                    while (stop == false) {
                        if (cursor >= limit) {
                            stop = true
                        } {
                            def nextAt:int (PptxTextLayout.nextChunk(text cursor))
                            if (nextAt > limit) {
                                nextAt = limit
                            }
                            def chunkW:double (PptxTextLayout.measureSlice(para cursor nextAt m scale))
                            def fits:boolean true
                            if ((acc + chunkW) > avail) {
                                fits = false
                            }
                            if fits {
                                acc = (acc + chunkW)
                                cursor = nextAt
                                end = nextAt
                            } {
                                if (end > start) {
                                    stop = true
                                } {
                                    ; Nothing fits, and the chunk is a single
                                    ; word wider than the box. It goes on the
                                    ; line ANYWAY and overflows.
                                    ;
                                    ; This used to break between letters, which
                                    ; is a thing no office program does: neither
                                    ; PowerPoint nor Word nor Google Slides
                                    ; hyphenates on its own, and a label chopped
                                    ; mid-word reads as a bug in the document
                                    ; rather than as a box that is too small.
                                    ; The author can see a word sticking out;
                                    ; they cannot see why "Käyttöliittymät"
                                    ; became "Käyttöliittymä" and "t".
                                    end = nextAt
                                    stop = true
                                }
                            }
                        }
                    }
                    if (end <= start) {
                        end = limit
                        if (limit > start) {
                            end = (start + 1)
                        }
                    }
                }
                def line (new PptxTextLine())
                line.para = pi
                line.startCol = start
                line.endCol = end
                line.first = firstLine
                line.align = align
                line.size = (PptxTextLayout.maxRunSize(para start end scale))
                def lineH:double (line.size * spacing * 1.2)
                if (lineH < (line.size * 1.15)) {
                    lineH = (line.size * 1.15)
                }
                line.h = lineH
                def visibleEnd:int (PptxTextLayout.trimEndCol(text start end))
                line.w = (PptxTextLayout.measureSlice(para start visibleEnd m scale))
                def lineX:double (contentX + indent)
                if (para.indentSet == false) {
                    lineX = ((contentX + indent) + bulletW)
                }
                if (align == "ctr") {
                    lineX = (lineX + ((avail - line.w) * 0.5))
                }
                if (align == "r") {
                    lineX = (lineX + (avail - line.w))
                }
                line.x = lineX
                line.y = total
                line.scale = scale
                if firstLine {
                    line.bullet = bullet
                    ; A hanging indent puts the bullet where `indent` says, to
                    ; the LEFT of the text; without one it sits immediately in
                    ; front of it.
                    if para.indentSet {
                        line.bulletX = ((contentX + indent) + (para.indentPt * scale))
                    } {
                        line.bulletX = ((contentX + indent) - bulletW)
                    }
                    if (bulletW > 0.0) {
                        line.bulletX = (contentX + ((to_double para.level) * 18.0 * scale))
                    }
                    line.bulletSize = bulletSize
                }
                push out line
                total = (total + lineH)
                firstLine = false
                start = end
                ; The break itself belongs to neither line.
                if (start < n) {
                    if ((charAt text start) == 10) {
                        start = (start + 1)
                        ; A break as the last thing in a paragraph still opens
                        ; a line, empty, the way it does everywhere else.
                        if (start >= n) {
                            def tail (new PptxTextLine())
                            tail.para = pi
                            tail.startCol = start
                            tail.endCol = start
                            tail.first = false
                            tail.align = align
                            tail.size = (PptxTextLayout.maxRunSize(para 0 n scale))
                            tail.h = (tail.size * spacing * 1.2)
                            tail.x = (contentX + indent)
                            tail.y = total
                            tail.scale = scale
                            push out tail
                            total = (total + tail.h)
                        }
                    }
                }
                if (start >= n) {
                    more = false
                }
            }
            total = (total + (para.spaceAfterPt * scale))
            pi = (pi + 1)
        }

        ; Anchoring: now that every line is known, so is the block's height.
        def originY:double (y + padT)
        if (body.anchor == "ctr") {
            originY = (y + padT + ((contentH - total) * 0.5))
        }
        if (body.anchor == "b") {
            originY = (y + padT + (contentH - total))
        }
        ; No clamp to the top of the box.
        ;
        ; Text taller than the box it is in OVERFLOWS, and which way it
        ; overflows is exactly what the anchor decides: a bottom-anchored
        ; block keeps its last line on the box's bottom edge and grows
        ; upward, a centred one grows both ways. Clamping the origin to the
        ; top of the box turned every one of those into a top-anchored block
        ; that spilled DOWNWARD instead — a title bottom-anchored in its
        ; placeholder, which is how a deck puts a title above a subtitle, came
        ; out written over the subtitle.
        ;
        ; PowerPoint and Google Slides both let it overflow. Nothing is lost
        ; by allowing it: the shape has no clip, so the only thing the clamp
        ; ever achieved was moving the overflow to the wrong end.
        def li:int 0
        while (li < (array_length out)) {
            def ln:PptxTextLine (itemAt out li)
            ln.y = (ln.y + originY)
            li = (li + 1)
        }
        return out
    }

    ; --- looking a position up -----------------------------------------------

    sfn lineIndexFor:int (lines:[PptxTextLine] para:int col:int) {
        def best:int (0 - 1)
        def i:int 0
        while (i < (array_length lines)) {
            def ln:PptxTextLine (itemAt lines i)
            if (ln.para == para) {
                if (col >= ln.startCol) {
                    best = i
                }
                if (best < 0) {
                    best = i
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; The nearest line to a y, for a click that landed between or outside them.
    sfn lineAtY:int (lines:[PptxTextLine] py:double) {
        if ((array_length lines) == 0) {
            return (0 - 1)
        }
        def best:int 0
        def bestDist:double 1000000.0
        def i:int 0
        while (i < (array_length lines)) {
            def ln:PptxTextLine (itemAt lines i)
            def mid:double (ln.y + (ln.h * 0.5))
            def d:double (fabs (py - mid))
            if (d < bestDist) {
                bestDist = d
                best = i
            }
            i = (i + 1)
        }
        return best
    }
}

    ; A deck the caller already has, rather than one read from a file. The
    ; bench builds one in memory, and so does anything that wants to drive this
    ; app without a package behind it.
    fn attachPresentation:boolean (pres:PptxPresentation name:string) {
        presentation = pres
        view.deckName = name
        index = 0
        loaded = true
        editor.attach(presentation)
        view.status = ((to_string (presentation.slideCount())) + " slides")
        return true
    }

    fn load:boolean (fullPath:string) {
        lastPath = fullPath
        parser.close()
        parser = (new PptxParser())
        def ok:boolean (parser.open(fullPath))
        if (ok == false) {
            loaded = false
            view.status = "failed to open"
            return false
        }
        def raw:PptxPresentation (parser.parsePresentation())
        presentation = (resolver.resolvePresentation(raw))
        view.cachePresentationImages(presentation)
        view.deckName = (this.basenameOf(fullPath))
        index = 0
        loaded = true
        editor.attach(presentation)
        view.status = ((to_string (presentation.slideCount())) + " slides")
        return true
    }

    fn loadParts:boolean (path:string name:string) {
        lastPath = (path + "/" + name)
        parser.close()
        parser = (new PptxParser())
        def ok:boolean (parser.openParts(path name))
        if (ok == false) {
            loaded = false
            view.status = "failed to open"
            return false
        }
        def raw:PptxPresentation (parser.parsePresentation())
        presentation = (resolver.resolvePresentation(raw))
        view.cachePresentationImages(presentation)
        view.deckName = name
        index = 0
        loaded = true
        editor.attach(presentation)
        view.status = ((to_string (presentation.slideCount())) + " slides")
        return true
    }

    ; A deck from bytes: the browser build has no file system, so it fetches
    ; (or is handed) the .pptx and passes it in whole.
    fn loadBytes:boolean (bytes:buffer name:string) {
        ; The format comes from the CONTENT, not from the name. An ODF package
        ; states what it is in its first hundred bytes — first entry, stored,
        ; uncompressed — which is a better answer than an extension and the
        ; only one a dropped buffer has at all.
        def odfKind:string (OdfPackage.sniffKind(bytes))
        if (odfKind == "presentation") {
            return (this.loadOdpBytes(bytes name))
        }
        isOdp = false
        lastPath = name
        parser.close()
        parser = (new PptxParser())
        def ok:boolean (parser.openBytes(bytes name))
        if (ok == false) {
            loaded = false
            view.status = "failed to open"
            return false
        }
        def raw:PptxPresentation (parser.parsePresentation())
        presentation = (resolver.resolvePresentation(raw))
        view.cachePresentationImages(presentation)
        view.deckName = name
        index = 0
        loaded = true
        editor.attach(presentation)
        view.status = ((to_string (presentation.slideCount())) + " slides")
        return true
    }

    ; Start without reading a font directory. The faces arrive as bytes.
    fn initBare:void () {
        view.initBare(W H)
        this.initFrame()
        ; Through the same path a later resize takes. Setting W and H and
        ; calling this is how every host starts, and without it the FIRST
        ; frame is the only one the chrome's breakpoints never reached: the
        ; deck went to the top of a phone and the slide was still being fitted
        ; around a column that was no longer there.
        this.resize(W H)
    }

    ; Fill the Font dropdown, and put the selection's own typeface on its face.
    ;
    ; The entries are added once — the faces a page loads it loads at startup,
    ; so the list does not change while the app runs, and rebuilding it every
    ; frame would reset the open menu under the reader's hand. The LABEL is
    ; settled every frame, because the selection changes constantly and the
    ; whole point of putting the chooser on the strip is that it says what the
    ; text in front of you is set in.
    fn refreshFonts:void () {
        def at:int (toolbar.indexOfLabel("Font"))
        if (at < 0) {
            return
        }
        def menu:ToolItem (toolbar.at(at))
        def names:[string] (this.choosableFonts())
        def sig:string ""
        def si:int 0
        while (si < (array_length names)) {
            sig = (sig + ((itemAt names si) + ","))
            si = (si + 1)
        }
        if (sig != fontsListed) {
            fontsListed = sig
            toolbar.clearUnderMenu(at)
            def i:int 0
            while (i < (array_length names)) {
                def name:string (itemAt names i)
                toolbar.addUnderMenu(at "text.font" name name (ToolIcon.textBox()))
                i = (i + 1)
            }
        }
        ; "Font" when the selection is in more than one typeface, or in none
        ; this page can name — the honest answer, rather than whichever run
        ; happened to come first.
        def now:string (editor.selectionFamily())
        if ((strlen now) > 0) {
            menu.label = now
        } {
            menu.label = "Font"
        }
    }

    ; What the Font chooser may offer: the faces this build can draw with,
    ; and then whatever the OPEN DECK is already set in.
    ;
    ; The second half matters more than it looks. A deck from PowerPoint is in
    ; Calibri, and this page has no Calibri — it measures and draws Calibri
    ; text in Open Sans, which is what a viewer without a face is supposed to
    ; do. But the FILE says Calibri, and a reader adding a line to that deck
    ; wants the new line to say Calibri too, so that it matches everywhere
    ; else the deck is opened. A chooser that offered only what this page can
    ; draw would make it impossible to stay in the deck's own typeface.
    fn choosableFonts:[string] () {
        def out:[string] (view.ctx.tr.familyNames())
        def si:int 0
        while (si < (presentation.slideCount())) {
            def sl:PptxSlide (itemAt presentation.slides si)
            this.collectFamilies(sl.shapes out)
            si = (si + 1)
        }
        return out
    }

    fn collectFamilies:void (shapes:[PptxShape] out:[string]) {
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            if sh.hasText {
                def pi:int 0
                while (pi < (array_length sh.text.paragraphs)) {
                    def para:PptxParagraph (itemAt sh.text.paragraphs pi)
                    def ri:int 0
                    while (ri < (array_length para.runs)) {
                        def run:PptxTextRun (itemAt para.runs ri)
                        PptxApp.pushOnce(out run.fontFamily)
                        ri = (ri + 1)
                    }
                    pi = (pi + 1)
                }
            }
            this.collectFamilies(sh.children out)
            i = (i + 1)
        }
    }

    sfn pushOnce:void (out:[string] name:string) {
        if ((strlen name) == 0) {
            return
        }
        def i:int 0
        while (i < (array_length out)) {
            if ((itemAt out i) == name) {
                return
            }
            i = (i + 1)
        }
        push out name
    }

    fn addFontBytes:boolean (family:string data:buffer) {
        return (view.ctx.tr.loadFontBytes(family data))
    }

    fn addFaceBytes:boolean (data:buffer) {
        return (view.ctx.tr.addFaceBytes(data))
    }

    ; --- the deck's pictures, for a host with no file server ------------------
    ; The bytes are already on the model — the parser pulled them out of the
    ; package. A browser needs them as objects it can turn into textures, so
    ; they are handed over rather than served.
    fn imagePartsJson:string () {
        if isOdp {
            return (this.odpImagePartsJson())
        }
        def names:[string]
        def si:int 0
        while (si < (presentation.slideCount())) {
            def slide:PptxSlide (itemAt presentation.slides si)
            def j:int 0
            while (j < (array_length slide.shapes)) {
                PptxApp.collectImageParts((itemAt slide.shapes j) names)
                j = (j + 1)
            }
            si = (si + 1)
        }
        def out:string "["
        def i:int 0
        while (i < (array_length names)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "\"" + (itemAt names i) + "\"")
            i = (i + 1)
        }
        return (out + "]")
    }

    sfn collectImageParts:void (shape:PptxShape names:[string]) {
        if (shape.kind == (PptxShapeKind.picture())) {
            if ((strlen shape.imagePart) > 0) {
                if ((buffer_length shape.imageBytes) > 0) {
                    def seen:boolean false
                    def k:int 0
                    while (k < (array_length names)) {
                        if ((itemAt names k) == shape.imagePart) {
                            seen = true
                        }
                        k = (k + 1)
                    }
                    if (seen == false) {
                        push names shape.imagePart
                    }
                }
            }
        }
        def i:int 0
        while (i < (array_length shape.children)) {
            PptxApp.collectImageParts((itemAt shape.children i) names)
            i = (i + 1)
        }
    }

    fn imageBytes:buffer (part:string) {
        if isOdp {
            return (this.odpImageBytes(part))
        }
        def si:int 0
        while (si < (presentation.slideCount())) {
            def slide:PptxSlide (itemAt presentation.slides si)
            def j:int 0
            while (j < (array_length slide.shapes)) {
                def found:buffer (PptxApp.findImageBytes((itemAt slide.shapes j) part))
                if ((buffer_length found) > 0) {
                    return found
                }
                j = (j + 1)
            }
            si = (si + 1)
        }
        return (buffer_alloc 0)
    }

    sfn findImageBytes:buffer (shape:PptxShape part:string) {
        if (shape.kind == (PptxShapeKind.picture())) {
            if (shape.imagePart == part) {
                return shape.imageBytes
            }
        }
        def i:int 0
        while (i < (array_length shape.children)) {
            def found:buffer (PptxApp.findImageBytes((itemAt shape.children i) part))
            if ((buffer_length found) > 0) {
                return found
            }
            i = (i + 1)
        }
        return (buffer_alloc 0)
    }

    fn basenameOf:string (fullPath:string) {
        def slash:int (lastIndexOf fullPath "/")
        if (slash >= 0) {
            return (substring fullPath (slash + 1) (strlen fullPath))
        }
        return fullPath
    }

    fn slideCount:int () {
        if isOdp {
            return (odpDoc.pageCount())
        }
        return (presentation.slideCount())
    }

    ; --- the .odp page, in the same window ------------------------------------
    ;
    ; Deliberately the same three steps the deck takes — scale, origin, offset
    ; the list into place — because they are the window's steps and not the
    ; format's. What differs is one call, and that is the whole claim this
    ; branch is here to test.
    fn paintOdpPage:void (framed:EVGDisplayList) {
        if ((odpDoc.pageCount()) == 0) {
            return
        }
        def sc:double (this.ptScale())
        def ox:double (this.slideOriginX())
        def oy:double (this.slideOriginY())
        framed.addFrame((ox - 1.0) (oy - 1.0) ((odpDoc.widthPt * sc) + 2.0) ((odpDoc.heightPt * sc) + 2.0) 1.0 (EVGColor.rgb(70 78 96)))
        odpConv.setScale((sc / (96.0 / 72.0)))
        odpConv.measure.attach(view.ctx view.fontFamily)
        def dl:EVGDisplayList (odpConv.pageToDisplayList(odpDoc index))
        PptxApp.offsetList(dl (to_int ox) (to_int oy))
        PptxApp.appendList(framed dl)
    }

    ; An .odp from bytes. Called by `loadBytes` when the package says it is
    ; one, and by nothing else — the sniff happens once, at the door.
    fn loadOdpBytes:boolean (bytes:buffer name:string) {
        odpParser.close()
        odpParser = (new OdpParser())
        def ok:boolean (odpParser.openBytes(bytes name))
        if (ok == false) {
            isOdp = false
            loaded = false
            view.status = "failed to open"
            return false
        }
        odpDoc = (odpParser.parsePresentation())
        def freshThumbs:[int:EVGDisplayList]
        odpThumbs = freshThumbs
        odpThumbW = 0
        isOdp = true
        loaded = true
        lastPath = name
        view.deckName = name
        index = 0
        odpConv.measure.attach(view.ctx view.fontFamily)
        view.status = ((to_string (odpDoc.pageCount())) + " slides")
        return true
    }

    ; The pictures an .odp holds, for a host with no file server. Same
    ; contract as the deck's — a list of package paths, then the bytes for
    ; one — so `pptx-host.mjs` needed no second mechanism and no change.
    fn odpImagePartsJson:string () {
        def names:[string]
        def i:int 0
        while (i < (odpDoc.pageCount())) {
            def page:OdpPage (itemAt odpDoc.pages i)
            def j:int 0
            while (j < (array_length page.shapes)) {
                PptxApp.collectOdpImages((itemAt page.shapes j) names)
                j = (j + 1)
            }
            i = (i + 1)
        }
        def out:string "["
        def k:int 0
        while (k < (array_length names)) {
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + "\"" + (itemAt names k) + "\"")
            k = (k + 1)
        }
        return (out + "]")
    }

    sfn collectOdpImages:void (shape:OdpShape names:[string]) {
        if ((strlen shape.imagePart) > 0) {
            if ((buffer_length shape.imageBytes) > 0) {
                def seen:boolean false
                def k:int 0
                while (k < (array_length names)) {
                    if ((itemAt names k) == shape.imagePart) {
                        seen = true
                    }
                    k = (k + 1)
                }
                if (seen == false) {
                    push names shape.imagePart
                }
            }
        }
        def i:int 0
        while (i < (array_length shape.children)) {
            PptxApp.collectOdpImages((itemAt shape.children i) names)
            i = (i + 1)
        }
    }

    fn odpImageBytes:buffer (part:string) {
        def i:int 0
        while (i < (odpDoc.pageCount())) {
            def page:OdpPage (itemAt odpDoc.pages i)
            def j:int 0
            while (j < (array_length page.shapes)) {
                def found:buffer (PptxApp.findOdpImageBytes((itemAt page.shapes j) part))
                if ((buffer_length found) > 0) {
                    return found
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return (buffer_alloc 0)
    }

    sfn findOdpImageBytes:buffer (shape:OdpShape part:string) {
        if (shape.imagePart == part) {
            if ((buffer_length shape.imageBytes) > 0) {
                return shape.imageBytes
            }
        }
        def i:int 0
        while (i < (array_length shape.children)) {
            def found:buffer (PptxApp.findOdpImageBytes((itemAt shape.children i) part))
            if ((buffer_length found) > 0) {
                return found
            }
            i = (i + 1)
        }
        return (buffer_alloc 0)
    }

    fn currentSlide@(optional):PptxSlide () {
        ; While the master is open it stands in for the slide: the same paint,
        ; the same pointer, the same tools — only the shapes come from the
        ; sheet, which is the whole point of editing it here.
        if (editor.isEditingSheet()) {
            return (editor.currentSlide())
        }
        if (loaded == false) {
            def __missing@(optional):PptxSlide
            return __missing
        }
        if (index < 0) {
            def __missing2@(optional):PptxSlide
            return __missing2
        }
        if (index >= (array_length presentation.slides)) {
            def __missing3@(optional):PptxSlide
            return __missing3
        }
        def hit@(optional):PptxSlide (itemAt presentation.slides index)
        return hit
    }

    fn nextSlide:void () {
        def n:int (this.slideCount())
        if (n <= 0) {
            return
        }
        if (index < (n - 1)) {
            index = (index + 1)
        }
    }

    fn prevSlide:void () {
        if (index > 0) {
            index = (index - 1)
        }
    }

    fn gotoSlide:void (i:int) {
        def n:int (this.slideCount())
        if (n <= 0) {
            return
        }
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        index = i
        editor.slideIndex = i
        editor.clearSelection()
        this.ensureSlideVisible()
    }

    ; --- the chrome, at the size it is actually being shown --------------------
    ;
    ; A deck editor on a phone is the same program as one on a desktop, and
    ; the difference between them is entirely numbers: how wide the slide
    ; list is, whether the notes are worth their vertical space, how big a
    ; button has to be to hit with a thumb. Those numbers live here, as a
    ; stylesheet, because a stylesheet has `@media` and an `if` in `resize`
    ; would not — and because a host that wants different breakpoints can
    ; replace the string instead of patching the app.
    ;
    ; A width of zero folds a thing away.
    sfn defaultChromeCss:string () {
        return (".slide-panel { width: 150px }"
              + " .notes { height: 92px }"
              + " .toolbar { height: 34px; padding-left: 5px }"
              + " .toolbar-tabs { height: 28px }"
              + " .toolbar-button { width: 30px; height: 54px }"
              ; A tablet: the list of slides is worth less than the slide.
              + " @media (max-width: 900px) { .slide-panel { width: 96px } }"
              ; A phone: the notes are the first thing to go — they are the
              ; least useful thing on a small screen and the most expensive,
              ; because they cost height, which is what a phone has least of.
              ; A phone: the deck goes ACROSS THE TOP. A phone is narrow and
              ; tall, so a column down the side spends the dimension there is
              ; least of — and it is the dimension the slide itself needs,
              ; because a slide is wider than it is tall. A width of zero and
              ; a height turns the column into a strip.
              + " @media (max-width: 640px) { .slide-panel { width: 0px; height: 76px } .notes { height: 0px } }"
              ; A thumb is not a mouse. 44px is what WCAG 2.2 asks for, and
              ; nothing about a window's WIDTH says which is on it — a laptop
              ; with a touchscreen is wide and coarse at the same time.
              + " @media (pointer: coarse) { .toolbar { height: 48px; padding-left: 8px } .toolbar-button { width: 44px; height: 66px } }")
    }

    fn setChromeCss:void (css:string) {
        chromeCss = css
        chromeSheet = (new EVGStyleSheet())
        chromeSheet.parse(css)
        this.applyChrome()
    }

    ; Say the pointer is a finger. Nothing in a window's size can tell you
    ; this, and getting it wrong makes every button either too small to hit
    ; or too big to fit.
    fn setCoarsePointer:void (coarse:boolean) {
        coarsePointer = coarse
        this.applyChrome()
    }

    fn applyChrome:void () {
        if ((chromeSheet.getRuleCount()) == 0) {
            chromeSheet.parse((PptxApp.defaultChromeCss()))
        }
        chromeSheet.setViewport((to_double W) (to_double H) coarsePointer)
        def panel (EVGElement.createDiv())
        panel.className = "slide-panel"
        chromeSheet.applyTree(panel "")
        if (panel.width.isPixels()) {
            panelW = (to_int panel.width.pixels)
        }
        ; A width makes it a column and a height makes it a strip. Saying it
        ; this way means a breakpoint can turn one into the other without the
        ; stylesheet needing a word for "orientation" that CSS does not have.
        if (panel.height.isPixels()) {
            panelH = (to_int panel.height.pixels)
        }
        def notes (EVGElement.createDiv())
        notes.className = "notes"
        chromeSheet.applyTree(notes "")
        if (notes.height.isPixels()) {
            notesH = (to_int notes.height.pixels)
        }
        toolbar.applyStyle(chromeSheet)
    }

    fn resize:void (nw:int nh:int) {
        W = nw
        H = nh
        this.applyChrome()
        toolbarH = (toolbar.heightFor(W))
        view.chromeH = (((toolbarH + statusH) + (this.notesHeight())) + (this.panelHeight()))
        view.chromeW = ((this.panelWidth()) + (this.propsWidth()))
        view.resize(W H)
    }

    ; Turn the interface around, or back. One flag: the strip mirrors itself
    ; and anything drawn through EVGLayout mirrors because `direction`
    ; inherits from the root. The DECK's own direction is a separate question
    ; — `a:pPr rtl` says which way a paragraph runs and that is not the
    ; reader's to override.
    fn setUiRtl:void (on:boolean) {
        uiRtl = on
        toolbar.rtl = on
        toolbar.uiRtl = on
    }

    ; A right-to-left deck opens with the interface turned around, and a
    ; left-to-right one opens with it the right way up — including when the
    ; deck before it was Arabic.
    ;
    ; It used to only ever turn it ON, and gave a reason: "a reader who turned
    ; it off is not overruled by the next deck they open". That reader is
    ; already protected by `uiRtlChosen`, which is what records a decision. The
    ; early return on `uiRtl` protected nobody and made the mode STICKY:
    ; open an Arabic deck, then open an English one, and the interface stayed
    ; mirrored with nothing on screen to explain why.
    fn adoptDeckDirection:void () {
        if uiRtlChosen {
            return
        }
        this.setUiRtl((this.deckIsRtl()))
    }

    ; Does anything in this deck run right to left? Groups included — a
    ; paragraph does not stop being Arabic for being inside one, and the walk
    ; that only looked at a slide's top-level shapes missed exactly the shapes
    ; a diagram keeps its text in.
    fn deckIsRtl:boolean () {
        def si:int 0
        while (si < (array_length presentation.slides)) {
            def sl:PptxSlide (itemAt presentation.slides si)
            def shi:int 0
            while (shi < (array_length sl.shapes)) {
                if (this.shapeIsRtl((itemAt sl.shapes shi))) {
                    return true
                }
                shi = (shi + 1)
            }
            si = (si + 1)
        }
        return false
    }

    fn shapeIsRtl:boolean (sh:PptxShape) {
        def pi:int 0
        while (pi < (array_length sh.text.paragraphs)) {
            def pa:PptxParagraph (itemAt sh.text.paragraphs pi)
            if (pa.rtl == 1) {
                return true
            }
            pi = (pi + 1)
        }
        def ci:int 0
        while (ci < (array_length sh.children)) {
            if (this.shapeIsRtl((itemAt sh.children ci))) {
                return true
            }
            ci = (ci + 1)
        }
        return false
    }

    ; --- the command surface --------------------------------------------------
    fn runCommand:boolean (id:string arg:string) {
        ; Printing is the host's: this program can lay a slide out and draw
        ; it, and it has no idea what printers exist. `fileRequest` is the
        ; same channel saving already goes out on.
        if (id == "file.print") {
            fileRequest = "print"
            return true
        }
        if (id == "view.rtl") {
            ; Any use of this switch is a decision, and the automatic half
            ; leaves it alone from here on — in BOTH directions.
            ;
            ; The latch used to go down only when the reader turned the
            ; interface off, which was right while the automatic half could
            ; only ever turn it ON. Now that it can also turn it off, a reader
            ; who turned it on by hand over a left-to-right document would have
            ; it taken away again by the next one they opened.
            def next:boolean (uiRtl == false)
            uiRtlChosen = true
            this.setUiRtl(next)
            return true
        }
        if (id == "file.open") {
            fileRequest = "open"
            return true
        }
        if (id == "slide.next") {
            this.nextSlide()
            return true
        }
        if (id == "slide.prev") {
            this.prevSlide()
            return true
        }
        if (id == "slide.first") {
            this.gotoSlide(0)
            return true
        }
        if (id == "slide.last") {
            this.gotoSlide(((this.slideCount()) - 1))
            return true
        }
        if (id == "slide.pick") {
            if ((strlen arg) == 0) {
                this.openSlideDialog()
                return true
            }
            return (this.runCommand("slide.goto" arg))
        }
        if (id == "slide.goto") {
            def want@(optional):int (to_int arg)
            if (!null? want) {
                this.gotoSlide((unwrap want))
                return true
            }
            return false
        }
        ; Saving. With no argument the app can only say that it wants to —
        ; a browser tab and a file system disagree about what a path is, and
        ; the host is the one that knows.
        if (id == "file.save") {
            if ((strlen arg) == 0) {
                fileRequest = "save"
                return true
            }
            def cut:int (PptxApp.lastSlash(arg))
            def dir:string "."
            def base:string arg
            if (cut >= 0) {
                dir = (substring arg 0 cut)
                base = (substring arg (cut + 1) (strlen arg))
            }
            return (this.saveDeck(dir base))
        }
        if (id == "dialog.close") {
            slideDialog.close()
            return true
        }
        return (this.runEditCommand(id arg))
    }

    ; --- the slide picker -----------------------------------------------------
    ; A window rather than a host widget, so every host offers the same one.
    fn buildDialogs:void () {
        if dialogsReady {
            return
        }
        slideDialog.w = 220
        slideDialog.title = "Go to slide"
        windows.add(slideDialog)
        dialogsReady = true
    }

    fn openSlideDialog:void () {
        this.buildDialogs()
        def n:int (this.slideCount())
        slideDialog.reset()
        slideDialog.addLabel("Slide")
        slideDialog.beginColumns(4)
        def i:int 0
        while (i < n) {
            if (i < 40) {
                slideDialog.addRadio((1601 + i) (to_string (i + 1)) 1 (i == index))
            }
            i = (i + 1)
        }
        slideDialog.endColumns()
        def ids:[int]
        def labels:[string]
        push ids 1691
        push labels "Close"
        slideDialog.addButtonRow(ids labels 1691)
        slideDialog.finish()
        slideDialog.openWithin((idiv (W - slideDialog.w) 2) (toolbarH + 24) W H)
        windows.raise(slideDialog)
    }

    fn pollDialogs:void () {
        if slideDialog.visible {
            def picked:int (slideDialog.selectedInGroup(1))
            if (picked >= 1601) {
                def want:int (picked - 1601)
                if (want != index) {
                    this.gotoSlide(want)
                }
            }
            if (slideDialog.activated == 1691) {
                slideDialog.close()
            }
        }
    }

    ; --- input ----------------------------------------------------------------
    ; Windows, then the strip, then the slide. Same order as everywhere else.
    ; The pointer, and whether the frame has to be drawn again because of it.
    ;
    ; The hosts redraw when this says true, and a bare hover over the strip
    ; said false: the hot item changed, the highlight and the tooltip were
    ; computed correctly, and nothing ever painted them. It read as a toolbar
    ; with no hover and no tooltips at all, which is what it was reported as.
    ;
    ; The hover is settled HERE rather than inside the routing below, so that
    ; it is right whoever ends up taking the event — moving off a button and
    ; onto the notes strip used to leave the button lit, because the notes
    ; took the move before the strip was asked.
    fn pointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        def wasHot:int toolbar.hot
        toolbar.hot = (toolbar.hit(px py))
        def took:boolean (this.routePointer(px py pressed down released))
        if (wasHot != toolbar.hot) {
            return true
        }
        return took
    }

    fn routePointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        ; While the deck is being shown there is nothing else on screen to
        ; press, and the click means what it means to an audience: go on.
        if presenting {
            return (this.showPointer(px py pressed down released))
        }
        ; Before the window manager, which consumes anything inside a window —
        ; right for a caption, wrong for a body the picker drew itself.
        if (this.pickerPointer(px py pressed)) {
            return true
        }
        if (windows.handlePointer(px py pressed down released)) {
            picker.pollClose()
            this.pollDialogs()
            return true
        }
        ; The notes are under the slide and the panel beside it, so both are
        ; asked before the slide is.
        if (this.notesPointer(px py pressed down released)) {
            return true
        }
        if (this.panelPointer(px py pressed down released)) {
            return true
        }
        ; …and the properties panel down the other side. Before the slide, or
        ; a press on a swatch falls through onto the canvas and drops the very
        ; selection the panel is about.
        if (this.propsPointer(px py pressed)) {
            return true
        }
        if pressed {
            ; A press on a page name shows that page. Checked before the
            ; buttons, because the two rows are one strip and the names sit
            ; where a button never does.
            def tb:int (toolbar.hitTab(px py))
            if (tb >= 0) {
                toolbar.selectTab(tb)
                return true
            }
            if (toolbar.hot >= 0) {
                ; A dropdown opens its list instead of running something.
                if (toolbar.pressItem(toolbar.hot)) {
                    return true
                }
                def t:ToolItem (toolbar.at(toolbar.hot))
                return (this.runCommand(t.command t.arg))
            }
        }
        ; The slide is a canvas, not a page: a click selects and a drag moves.
        ;
        ; Clicking the left or right third of it used to turn the page, which
        ; is how a deck is READ and the exact opposite of how one is edited —
        ; the first click anyone made on a shape moved the deck out from under
        ; them. Turning the page is the panel, the arrow keys, and the strip;
        ; a present mode can have the click back (phase E6).
        if editMode {
            if (this.editPointer(px py pressed down released)) {
                return true
            }
        }
        return false
    }

    ; The pointer while presenting: a click goes on, unless a pen is out — and
    ; then it draws, because that is what a pen is for.
    ; Which step of the build the selected shape is, so the build can be
    ; reordered by picking the shape rather than by counting steps.
    fn selectedBuildStep:int () {
        def slide@(optional):PptxSlide (editor.currentSlide())
        if (null? slide) {
            return (0 - 1)
        }
        def s0:PptxSlide (unwrap slide)
        def sel:[int] editor.selection
        def i:int 0
        while (i < (array_length s0.build)) {
            def step:PptxBuildStep (itemAt s0.build i)
            def k:int 0
            while (k < (array_length sel)) {
                if ((itemAt sel k) == step.editId) {
                    return i
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    fn showPointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        def sx:double (this.screenToSlideX(px))
        def sy:double (this.screenToSlideY(py))
        if (penMode == "laser") {
            laserX = sx
            laserY = sy
            return true
        }
        if (penMode == "pen") {
            if pressed {
                def pts:[double]
                push pts sx
                push pts sy
                push inkSlides index
                push inkPoints pts
                push inkColors penHex
                inkDrawing = true
                return true
            }
            if down {
                if inkDrawing {
                    if ((array_length inkPoints) > 0) {
                        def last:[double] (itemAt inkPoints ((array_length inkPoints) - 1))
                        ; Only record a point that moved: a held pointer would
                        ; otherwise grow the stroke by a frame's worth of the
                        ; same coordinate every frame.
                        def n:int (array_length last)
                        def far:boolean true
                        if (n >= 2) {
                            def dx:double (sx - (itemAt last (n - 2)))
                            def dy:double (sy - (itemAt last (n - 1)))
                            if (((dx * dx) + (dy * dy)) < 1.0) {
                                far = false
                            }
                        }
                        if far {
                            push last sx
                            push last sy
                        }
                    }
                    return true
                }
            }
            if released {
                inkDrawing = false
                return true
            }
            return true
        }
        if released {
            this.presentNext()
            return true
        }
        return true
    }

    ; The keyboard while presenting. Everything is one key away, because a
    ; presenter is not looking at the screen they are pressing.
    fn showKey:boolean (k:int shift:boolean) {
        if (k == (UIKey.escape())) {
            if ((strlen penMode) > 0) {
                penMode = ""
                return true
            }
            this.stopPresenting()
            return true
        }
        if (k == (UIKey.right())) {
            this.presentNext()
            return true
        }
        if (k == (UIKey.down())) {
            this.presentNext()
            return true
        }
        if (k == (UIKey.pageDown())) {
            this.presentNext()
            return true
        }
        if (k == (UIKey.enter())) {
            this.presentNext()
            return true
        }
        if (k == (UIKey.left())) {
            this.presentPrev()
            return true
        }
        if (k == (UIKey.up())) {
            this.presentPrev()
            return true
        }
        if (k == (UIKey.pageUp())) {
            this.presentPrev()
            return true
        }
        if (k == (UIKey.backspace())) {
            this.presentPrev()
            return true
        }
        if (k == (UIKey.home())) {
            def from:int index
            this.gotoSlide(0)
            presentStep = 0
            this.beginTransition(from)
            return true
        }
        if (k == (UIKey.end())) {
            def from2:int index
            this.gotoSlide(((this.slideCount()) - 1))
            presentStep = 0
            this.beginTransition(from2)
            return true
        }
        return false
    }

    ; The letters a presenter reaches for: space goes on, B blanks the screen,
    ; P and L put a pen or a laser out, E rubs the ink off, N shows the notes.
    fn showChar:boolean (ch:string) {
        if (ch == " ") {
            this.presentNext()
            return true
        }
        if ((ch == "p") || (ch == "P")) {
            return (this.setPen("pen"))
        }
        if ((ch == "l") || (ch == "L")) {
            return (this.setPen("laser"))
        }
        if ((ch == "e") || (ch == "E")) {
            return (this.clearInk())
        }
        if ((ch == "n") || (ch == "N")) {
            presenterView = (presenterView == false)
            return true
        }
        if ((ch == "b") || (ch == "B")) {
            showBlank = (showBlank == false)
            return true
        }
        return false
    }

    fn update:void (input:UIInput) {
        modShift = input.shiftDown
        modCtrl = input.ctrlDown
        ; The show takes the whole keyboard and the whole pointer: nothing else
        ; is on screen to reach.
        if presenting {
            def ki:int 0
            while (ki < (input.keyCount())) {
                this.showKey((input.keyAt(ki)) input.shiftDown)
                ki = (ki + 1)
            }
            def ti:int 0
            while (ti < (strlen input.textInput)) {
                this.showChar((substring input.textInput ti (ti + 1)))
                ti = (ti + 1)
            }
            this.pointer(input.pointerX input.pointerY input.pointerPressed input.pointerDown input.pointerReleased)
            this.render()
            return
        }
        if input.ctrlDown {
            this.editChords(input.textInput)
        }
        def i:int 0
        while (i < (input.keyCount())) {
            def k:int (input.keyAt(i))
            def taken:boolean false
            ; Page keys always turn the page, whatever is selected. The arrows
            ; cannot: with a shape picked up they nudge it, which is what every
            ; editor does — so there has to be a key that means the deck.
            if (k == (UIKey.pageDown())) {
                this.runCommand("slide.next" "")
                taken = true
            }
            if (k == (UIKey.pageUp())) {
                this.runCommand("slide.prev" "")
                taken = true
            }
            if (taken == false) {
                if editMode {
                    taken = (this.textKey(k input.shiftDown))
                }
            }
            if (k == (UIKey.f5())) {
                this.runCommand("show.start" "")
                taken = true
            }
            ; Tab in a text box is what every editor uses to indent a list
            ; item, and shift+Tab to take it back out.
            if (k == (UIKey.tab())) {
                if (editor.isEditingText()) {
                    if input.shiftDown {
                        taken = (this.runCommand("text.outdent" ""))
                    } {
                        taken = (this.runCommand("text.indent" ""))
                    }
                }
            }
            if (taken == false) {
                if (k == (UIKey.f2())) {
                    taken = (this.startTextEdit())
                }
                if (k == (UIKey.enter())) {
                    if (taken == false) {
                        taken = (this.startTextEdit())
                    }
                }
            }
            if (k == (UIKey.escape())) {
                if slideDialog.visible {
                    slideDialog.close()
                    taken = true
                }
                ; Escape puts an armed tool down. Before the dialog check
                ; would be wrong — a dialog over the slide is the nearer
                ; thing — and after everything else would mean a reader with
                ; a tool armed could not get out of it without using it.
                if (taken == false) {
                    if (this.cancelPendingTool()) {
                        taken = true
                    }
                }
            }
            ; Only if nothing above has already dealt with the key.
            ;
            ; This assigned `taken` unconditionally, which meant every branch
            ; above it ran AND THEN this one did. Typing in a text box, the
            ; right arrow moved the caret and then nudged the shape a point to
            ; the right — the box crept across the slide as you read back what
            ; you had written. Enter started editing and then appended a
            ; newline at the END of the text rather than at the caret. Escape
            ; closed a dialog and then cleared the selection behind it.
            if (taken == false) {
                if editMode {
                    taken = (this.editKey(k input.shiftDown))
                }
            }
            if (taken == false) {
                if (k == (UIKey.right())) {
                    this.runCommand("slide.next" "")
                }
                if (k == (UIKey.left())) {
                    this.runCommand("slide.prev" "")
                }
                if (k == (UIKey.home())) {
                    this.runCommand("slide.first" "")
                }
                if (k == (UIKey.end())) {
                    this.runCommand("slide.last" "")
                }
            }
            i = (i + 1)
        }
        ; Typing goes into the selected shape. Not a caret yet — text arrives
        ; at the end of what is there, and backspace takes it off the end.
        if editMode {
            if (input.ctrlDown == false) {
                if ((strlen input.textInput) > 0) {
                    this.syncEditor()
                    if (editor.isEditingText()) {
                        editor.typeAtCaret(input.textInput)
                    } {
                        editor.appendText(input.textInput)
                    }
                }
            }
        }
        ; PIXELS of travel, positive downwards — the unit the gesture arrives
        ; in, rather than notches. See `scrollPanelPixels`: a trackpad swipe is
        ; dozens of small wheel events, and counting each of them as a whole
        ; notch scrolled a hundred slides past in one flick.
        ; Over the PANEL, wherever the panel is. This used to ask whether the
        ; pointer was left of `panelWidth()`, and `panelWidth()` answers 0 when
        ; the panel is a strip along the TOP rather than a column down the side
        ; — which is the layout every narrow window gets. So in that layout the
        ; test was `x < 0`, never true, and the thumbnails could not be
        ; scrolled at all: reported as "two fingers on the trackpad do not move
        ; the thumbnails". `panelInBand` is the same question the panel's own
        ; press handling asks, and it knows about both layouts.
        if (this.panelInBand(input.pointerX input.pointerY)) {
            ; A strip runs ACROSS, so a two-finger swipe sideways moves it as
            ; readily as one downwards — a reader flicking at a horizontal row
            ; of thumbnails means "further along" whichever way their fingers
            ; went. A column takes only the vertical travel, because sideways
            ; there means nothing.
            ;
            ; Note the sign. `scrollDelta` is positive DOWNWARDS and
            ; `scrollDeltaX` positive LEFTWARDS — `UIInput` says so and the
            ; spreadsheet negates it on the way in for the same reason. Both
            ; directions have to end up meaning "further along the deck", so
            ; the sideways one is subtracted.
            def travel:int input.scrollDelta
            if (this.panelOnTop()) {
                travel = (travel - input.scrollDeltaX)
            }
            if (travel != 0) {
                this.scrollPanelPixels(travel)
            }
        }
        this.pointer(input.pointerX input.pointerY input.pointerPressed input.pointerDown input.pointerReleased)
        this.render()
    }

    ; The slide, the strip above it, the status line under it, and whatever
    ; windows are open. One display list, as everything here is.
    fn buildFrame:EVGDisplayList () {
        if presenting {
            return (this.buildShowFrame())
        }
        def framed:EVGDisplayList (new EVGDisplayList)
        framed.addRect(0.0 0.0 (to_double W) (to_double H) (EVGColor.rgb(40 44 58)))
        ; Where the panel has scrolled itself to is settled every frame, panel
        ; drawn or not: the slide the reader is on has to be in view by the
        ; time anyone asks where the thumbnails are, and a host drawing the
        ; panel on its own timetable would otherwise see a stale scroll.
        this.settlePanelScroll()
        if framePanel {
            this.paintPanel(framed)
        }
        if isOdp {
            this.paintOdpPage(framed)
        } {
            def slide@(optional):PptxSlide (this.currentSlide())
            if (!null? slide) {
                def sl:PptxSlide (unwrap slide)
                def sc:double (this.ptScale())
                def ox:double (this.slideOriginX())
                def oy:double (this.slideOriginY())
                ; The page, and the desk it is on. A slide drawn into the corner
                ; of a window that is a different shape reads as a rendering
                ; fault.
                framed.addFrame((ox - 1.0) (oy - 1.0) ((sl.width * sc) + 2.0) ((sl.height * sc) + 2.0) 1.0 (EVGColor.rgb(70 78 96)))
                def dl:EVGDisplayList (view.buildDisplayList(sl))
                PptxApp.offsetList(dl (to_int ox) (to_int oy))
                PptxApp.appendList(framed dl)
            }
        }
        if editMode {
            this.paintEditOverlay(framed)
        }
        this.paintNotes(framed)
        this.paintProps(framed)
        if editMode {
            this.paintCaret(framed)
        }
        toolbarView.attach(view.ctx view.fontFamily)
        toolbarView.theme = theme
        ; A right-to-left deck opens turned around. Checked here because this
        ; app has no single load hook, and it costs one walk of the deck per
        ; frame only while the answer is still no — once turned around this
        ; returns on its first line.
        this.adoptDeckDirection()
        ; The band is as tall as the page showing on it needs, and pages
        ; differ — one with a big button on it is taller than one without.
        ; Settling this only on resize left the strip short after a page
        ; change, with the bottom of the button drawn over the slide.
        toolbarH = (toolbar.heightFor(W))
        toolbar.boldOn = (this.selectionBold())
        toolbar.italicOn = (this.selectionItalic())
        this.refreshFonts()
        toolbar.refresh(index (this.slideCount()))
        toolbarView.paint(framed toolbar 0 0 W toolbarH)

        def sy:int (H - statusH)
        framed.addRect(0.0 (to_double sy) (to_double W) (to_double statusH) theme.bg)
        framed.addRect(0.0 (to_double sy) (to_double W) 1.0 theme.line)
        def label:string ((view.deckName + "   ") + (to_string (index + 1)) + " / " + (to_string (this.slideCount())))
        if ((strlen view.status) > 0) {
            label = ((label + "   ") + view.status)
        }
        if ((strlen status) > 0) {
            label = ((label + "   ") + status)
        }
        def es:string (this.editStatus())
        if ((strlen es) > 0) {
            label = ((label + "   ") + es)
        }
        toolbarView.pushText(framed label 8.0 (to_double (sy + 4)) 12.0 theme.dim)

        ; An open dropdown hangs BELOW the strip, so it is drawn after
        ; everything the strip sits on top of and before the windows, which
        ; are the only thing that belongs above it.
        toolbarView.paintOverlay(framed toolbar)

        def wi:int 0
        while (wi < (array_length windows.windows)) {
            def wnd:EVGWindow (itemAt windows.windows wi)
            wnd.paint(framed view.ctx.tr W H)
            wnd.paintOverlay(framed view.ctx.tr)
            wi = (wi + 1)
        }
        ; The picker's body, over its own window's chrome.
        picker.paint(framed)
        return framed
    }

    ; --- the show, painted ----------------------------------------------------
    ;
    ; No strip, no panel, no status line: the deck fills the window, and the
    ; only things drawn over it are the ones a presenter puts there — ink, a
    ; laser dot, and on the presenter's own screen the notes and the clock.

    fn buildShowFrame:EVGDisplayList () {
        def framed:EVGDisplayList (new EVGDisplayList)
        framed.addRect(0.0 0.0 (to_double W) (to_double H) (EVGColor.rgb(0 0 0)))
        if showBlank {
            ; A blanked screen is black and says so, so nobody thinks the
            ; machine has died.
            toolbarView.attach(view.ctx view.fontFamily)
            toolbarView.theme = theme
            toolbarView.pushText(framed "B to come back" 16.0 ((to_double H) - 26.0) 12.0 (EVGColor.rgb(70 74 86)))
            return framed
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return framed
        }
        def sl:PptxSlide (unwrap slide)
        def sc:double (this.ptScale())
        def ox:double (this.slideOriginX())
        def oy:double (this.slideOriginY())
        def wpx:double (sl.width * sc)
        def hpx:double (sl.height * sc)
        def t:double (this.showProgress())
        def running:boolean (showLength > 0.0)
        if running {
            if (showFrom < 0) {
                running = false
            }
        }
        if (running == false) {
            this.paintShowSlide(framed sl ox oy sc)
        } {
            this.paintTransition(framed sl ox oy sc wpx hpx t)
        }
        ; Ink and the laser sit over the slide, at the slide's own scale.
        this.paintInk(framed ox oy sc)
        if presenterView {
            this.paintPresenter(framed)
        }
        return framed
    }

    ; The slide, with the build applied: a shape whose step has not been
    ; reached is not drawn at all.
    fn paintShowSlide:void (dl:EVGDisplayList sl:PptxSlide ox:double oy:double sc:double) {
        def hidden:[PptxShape]
        def i:int 0
        while (i < (array_length sl.shapes)) {
            def sh:PptxShape (itemAt sl.shapes i)
            if ((editor.shapeVisibleAt(sl sh presentStep)) == false) {
                push hidden sh
            }
            i = (i + 1)
        }
        def kept:[PptxShape] sl.shapes
        if ((array_length hidden) > 0) {
            def show:[PptxShape]
            def k:int 0
            while (k < (array_length sl.shapes)) {
                def sh2:PptxShape (itemAt sl.shapes k)
                if (editor.shapeVisibleAt(sl sh2 presentStep)) {
                    push show sh2
                }
                k = (k + 1)
            }
            sl.shapes = show
        }
        def sub:EVGDisplayList (view.buildDisplayListAt(sl (this.showScale())))
        sl.shapes = kept
        PptxApp.offsetList(sub (to_int ox) (to_int oy))
        PptxApp.appendList(dl sub)
    }

    ; What a transition looks like. A wipe or a push moves the incoming page
    ; into place — the slide is drawn where it will end up and clipped, or
    ; drawn offset and clipped, which is the same picture for a viewer and much
    ; less arithmetic than compositing two scenes. A fade goes through black,
    ; because a display list has no way to draw one scene at half strength.
    fn paintTransition:void (dl:EVGDisplayList sl:PptxSlide ox:double oy:double sc:double wpx:double hpx:double t:double) {
        def kind:string sl.transition.kind
        def dir:string sl.transition.dir
        def from@(optional):PptxSlide (this.slideAt(showFrom))
        if (kind == "fade") {
            ; First half: the slide being left, going dark. Second half: the
            ; new one, coming out of the dark.
            if (t < 0.5) {
                if (!null? from) {
                    def prev:PptxSlide (unwrap from)
                    def sub:EVGDisplayList (view.buildDisplayListAt(prev (this.showScale())))
                    PptxApp.offsetList(sub (to_int ox) (to_int oy))
                    PptxApp.appendList(dl sub)
                }
                dl.addRect(ox oy wpx hpx (EVGColor.create(0.0 0.0 0.0 (t * 2.0))))
            } {
                this.paintShowSlide(dl sl ox oy sc)
                dl.addRect(ox oy wpx hpx (EVGColor.create(0.0 0.0 0.0 ((1.0 - t) * 2.0))))
            }
            return
        }
        ; Everything else moves. `push` takes the old page with it; `wipe` and
        ; `cover` leave it where it is and slide the new one over. The entry
        ; vector is a whole page in the direction the effect names, so the new
        ; page comes in at `(1 - t)` of it and the old one leaves at `-t`.
        def vx:double 0.0
        def vy:double 0.0
        if (dir == "u") {
            vy = hpx
        }
        if (dir == "d") {
            vy = (0.0 - hpx)
        }
        if (dir == "l") {
            vx = wpx
        }
        if (dir == "r") {
            vx = (0.0 - wpx)
        }
        if (vx == 0.0) {
            if (vy == 0.0) {
                ; No direction stated: come in from the left, which is what a
                ; wipe with nothing said does.
                vx = wpx
            }
        }
        def back:double (1.0 - t)
        dl.addClip(ox oy wpx hpx)
        if (!null? from) {
            def prev2:PptxSlide (unwrap from)
            def old2:EVGDisplayList (view.buildDisplayListAt(prev2 (this.showScale())))
            def px:double ox
            def py:double oy
            if (kind == "push") {
                px = (ox - (vx * t))
                py = (oy - (vy * t))
            }
            PptxApp.offsetList(old2 (to_int px) (to_int py))
            PptxApp.appendList(dl old2)
        }
        def sub2:EVGDisplayList (view.buildDisplayListAt(sl (this.showScale())))
        PptxApp.offsetList(sub2 (to_int (ox + (vx * back))) (to_int (oy + (vy * back))))
        PptxApp.appendList(dl sub2)
        dl.addClipEnd()
    }

    ; Ink is kept in slide points, not window pixels, so it stays where it was
    ; drawn when the window is resized or the presenter's screen is a different
    ; shape from the one the audience sees.
    fn paintInk:void (dl:EVGDisplayList ox:double oy:double sc:double) {
        def i:int 0
        while (i < (array_length inkSlides)) {
            if ((itemAt inkSlides i) == index) {
                def pts:[double] (itemAt inkPoints i)
                def col:EVGColor (EVGColor.parse(("#" + (itemAt inkColors i))))
                def k:int 0
                while ((k + 3) < (array_length pts)) {
                    def x1:double (ox + ((itemAt pts k) * sc))
                    def y1:double (oy + ((itemAt pts (k + 1)) * sc))
                    def x2:double (ox + ((itemAt pts (k + 2)) * sc))
                    def y2:double (oy + ((itemAt pts (k + 3)) * sc))
                    this.pushLine(dl x1 y1 x2 y2 3.0 col)
                    k = (k + 2)
                }
            }
            i = (i + 1)
        }
        if (penMode == "laser") {
            if (laserX >= 0.0) {
                def lx:double (ox + (laserX * sc))
                def ly:double (oy + (laserY * sc))
                dl.addRect((lx - 9.0) (ly - 9.0) 18.0 18.0 (EVGColor.rgba(230 40 60 0.25)))
                dl.addRect((lx - 4.0) (ly - 4.0) 8.0 8.0 (EVGColor.rgba(255 60 80 0.95)))
            }
        }
    }

    ; The presenter's own screen: what is on the wall, what comes next, the
    ; notes for the slide that is up, and how long the show has been running.
    fn paintPresenter:void (dl:EVGDisplayList) {
        def right:double ((to_double W) * 0.62)
        def panelW:double (((to_double W) - right) - 16.0)
        dl.addRect(0.0 0.0 (to_double W) 40.0 (EVGColor.rgb(18 20 26)))
        toolbarView.attach(view.ctx view.fontFamily)
        toolbarView.theme = theme
        def clock:string (PptxApp.clockText(showClock))
        toolbarView.pushText(dl clock 16.0 12.0 16.0 (EVGColor.rgb(220 226 240)))
        def where:string ((to_string (index + 1)) + " / " + (to_string (this.slideCount())))
        def steps:int (editor.buildCount())
        if (steps > 0) {
            where = (where + "   step " + (to_string presentStep) + " / " + (to_string steps))
        }
        toolbarView.pushText(dl where 120.0 12.0 13.0 (EVGColor.rgb(150 160 185)))
        ; What is next, drawn the way the panel draws a thumbnail: the slide's
        ; own scene, small.
        def nx:double (right + 8.0)
        def ny:double 52.0
        def nh:double 0.0
        def nextIdx:int (index + 1)
        toolbarView.pushText(dl "Next" nx (ny - 16.0) 12.0 (EVGColor.rgb(150 160 185)))
        if (nextIdx < (this.slideCount())) {
            def nslide:PptxSlide (itemAt presentation.slides nextIdx)
            def nscale:double (panelW / (nslide.width * (96.0 / 72.0)))
            nh = ((nslide.height * (96.0 / 72.0)) * nscale)
            dl.addRect(nx ny panelW nh (EVGColor.rgb(255 255 255)))
            view.converter.setScale(nscale)
            view.converter.slideNumber = (nextIdx + 1)
            def sub:EVGDisplayList (view.converter.slideToDisplayList(nslide))
            PptxApp.offsetList(sub (to_int nx) (to_int ny))
            dl.addClip(nx ny panelW nh)
            PptxApp.appendList(dl sub)
            dl.addClipEnd()
            dl.addFrame(nx ny panelW nh 1.0 (EVGColor.rgb(70 78 96)))
        } {
            nh = 60.0
            dl.addRect(nx ny panelW nh (EVGColor.rgb(24 27 34)))
            toolbarView.pushText(dl "End of the deck" (nx + 10.0) (ny + 22.0) 12.0 (EVGColor.rgb(120 130 150)))
        }
        ; The notes, under it.
        def noteY:double ((ny + nh) + 26.0)
        toolbarView.pushText(dl "Notes" nx (noteY - 16.0) 12.0 (EVGColor.rgb(150 160 185)))
        def noteH:double (((to_double H) - noteY) - 16.0)
        dl.addRect(nx noteY panelW noteH (EVGColor.rgb(24 27 34)))
        def slide@(optional):PptxSlide (this.currentSlide())
        if (!null? slide) {
            def s0:PptxSlide (unwrap slide)
            dl.addClip(nx noteY panelW noteH)
            def box:PptxEditRect (PptxEditRect.of((nx + 8.0) (noteY + 8.0) (panelW - 16.0) (noteH - 16.0)))
            def lines:[PptxTextLine] (this.lineBoxesIn(s0.notes box 1.0))
            def li:int 0
            while (li < (array_length lines)) {
                def line:PptxTextLine (itemAt lines li)
                def para:PptxParagraph (itemAt s0.notes.text.paragraphs line.para)
                def full:string (PptxTextLayout.paraText(para))
                def piece:string (substring full line.startCol line.endCol)
                ; Reordered and shaped on the way into the list, like every
                ; other string that goes into it.
                ;
                ; This one was not, and it was the only text in the deck
                ; viewer that was not. It looked RIGHT in the browser, because
                ; `fillText` runs the bidirectional algorithm itself and was
                ; doing the work for us, and it was wrong everywhere else —
                ; the software canvas draws the string it is handed, so the
                ; notes came out in the order they are stored in. One rule,
                ; broken in one place, hidden by a backend that happened to
                ; paper over it.
                def shown:string (OfficeText.forDisplayDir(piece para.rtl))
                toolbarView.pushText(dl shown line.x line.y 13.0 (EVGColor.rgb(215 220 232)))
                li = (li + 1)
            }
            dl.addClipEnd()
        }
    }

    sfn clockText:string (seconds:double) {
        def total:int (to_int seconds)
        def mm:int (idiv total 60)
        def ss:int (total % 60)
        def m:string (to_string mm)
        def s2:string (to_string ss)
        if ((strlen s2) < 2) {
            s2 = ("0" + s2)
        }
        if ((strlen m) < 2) {
            m = ("0" + m)
        }
        return (m + ":" + s2)
    }

    fn slideAt@(optional):PptxSlide (i:int) {
        if (i < 0) {
            def __none@(optional):PptxSlide
            return __none
        }
        if (i >= (array_length presentation.slides)) {
            def __none2@(optional):PptxSlide
            return __none2
        }
        def hit@(optional):PptxSlide (itemAt presentation.slides i)
        return hit
    }

    sfn offsetList:void (src:EVGDisplayList dx:int dy:int) {
        def i:int 0
        while (i < (array_length src.cmds)) {
            def c:EVGDrawCmd (itemAt src.cmds i)
            if (c.kind != 5) {
                c.x = (c.x + (to_double dx))
                c.y = (c.y + (to_double dy))
                def pi:int 0
                while (pi < (array_length c.pts)) {
                    def even:boolean ((pi % 2) == 0)
                    if even {
                        set_at c.pts pi ((itemAt c.pts pi) + (to_double dx))
                    } {
                        set_at c.pts pi ((itemAt c.pts pi) + (to_double dy))
                    }
                    pi = (pi + 1)
                }
            }
            i = (i + 1)
        }
    }

    sfn intAt:int (m:[int:int] key:int) {
        def hit@(optional):int (get m key)
        return (?? hit (0 - 999999))
    }

    sfn appendList:void (into:EVGDisplayList src:EVGDisplayList) {
        def i:int 0
        while (i < (array_length src.cmds)) {
            push into.cmds (itemAt src.cmds i)
            i = (i + 1)
        }
    }

    ; Rasterize the frame into the CPU framebuffer. A host that draws the
    ; display list ITSELF — the browser, through WebGL — never looks at that
    ; framebuffer, and painting it anyway was the single most expensive thing
    ; in a browser profile: a pointer move rasterized nine hundred thousand
    ; pixels that nothing ever read, and built the frame a second time to do
    ; it. Such a host sets `wantRaster` false and asks for `sceneJson`.
    fn render:void () {
        view.slideIndex = index
        view.slideCount = (this.slideCount())
        if (wantRaster == false) {
            return
        }
        def dl:EVGDisplayList (this.buildFrame())
        view.paintSoftCanvas(dl)
    }

    ; Paint slide i at 96dpi into SoftCanvas (no viewer chrome). Used by the
    ; LibreOffice visual oracle so pixel sizes line up with pdftoppm -r 96.
    fn renderOracleSlide:boolean (slideIndex:int) {
        if (loaded == false) {
            return false
        }
        if (slideIndex < 0) {
            return false
        }
        if (slideIndex >= (array_length presentation.slides)) {
            return false
        }
        def slide:PptxSlide (itemAt presentation.slides slideIndex)
        view.renderOracleSlide(slide 1.0)
        W = view.pageW
        H = view.pageH
        return true
    }

    fn raw:buffer () {
        return (view.raw())
    }

    ; OPC media bytes for the WebGL host (`/part/ppt/media/...`). Only
    ; `ppt/media/` is exposed — slide XML and other package parts stay private.
    fn readMediaPart:buffer (part:string) {
        if ((strlen part) < 11) {
            return (buffer_alloc 0)
        }
        if ((indexOf part "..") >= 0) {
            return (buffer_alloc 0)
        }
        if ((indexOf part "ppt/media/") != 0) {
            return (buffer_alloc 0)
        }
        return (parser.pkg.readBinary(part))
    }

    fn sceneJson:string () {
        view.slideIndex = index
        view.slideCount = (this.slideCount())
        def dl:EVGDisplayList (this.buildFrame())
        def body:string (dl.toJson())
        return ("{\"width\":" + (EVGDisplayList.num((to_double W))) + ",\"height\":" + (EVGDisplayList.num((to_double H))) + ",\"list\":" + body + "}")
    }

    ; The same frame as typed arrays instead of text.
    ;
    ; `sceneJson` above is what every host has used; on a chart-heavy slide it
    ; is five sixths of the frame. See the banner on `EVGSceneBinary` for the
    ; measurements and for why the two describe the same picture to the unit.
    fn sceneBinary:EVGSceneBinary () {
        view.slideIndex = index
        view.slideCount = (this.slideCount())
        def dl:EVGDisplayList (this.buildFrame())
        def bin:EVGSceneBinary (dl.toBinary())
        bin.width = (to_double W)
        bin.height = (to_double H)
        return bin
    }

    ; The frame WITHOUT the thumbnails, and the thumbnails on their own.
    ;
    ; A host that draws both gets the same picture as `sceneBinary`, and pays
    ; for the panel only when `panelStamp` changes. See `framePanel` for what
    ; that is worth: on a six-slide chart deck the panel is four fifths of
    ; every frame, and it is the same four fifths every frame.
    fn sceneBinaryNoPanel:EVGSceneBinary () {
        view.slideIndex = index
        view.slideCount = (this.slideCount())
        def dl:EVGDisplayList (this.buildSceneFrame())
        def bin:EVGSceneBinary (dl.toBinary())
        bin.width = (to_double W)
        bin.height = (to_double H)
        return bin
    }

    fn panelBinary:EVGSceneBinary () {
        def dl:EVGDisplayList (this.buildPanelFrame())
        def bin:EVGSceneBinary (dl.toBinary())
        bin.width = (to_double W)
        bin.height = (to_double H)
        return bin
    }

    ; One slide as its own scene, at a stated width in pixels.
    ;
    ; `sceneJson` is the editor — chrome, panel, handles and all. Printing and
    ; exporting want the slide by itself, and at a size they choose rather
    ; than the size the window happens to be, so this builds it directly
    ; instead of trying to subtract the editor from the frame.
    fn slideSceneJson:string (i:int widthPx:int) {
        if (i < 0) {
            return "{\"width\":0,\"height\":0,\"list\":{\"cmds\":[]}}"
        }
        if (i >= (this.slideCount())) {
            return "{\"width\":0,\"height\":0,\"list\":{\"cmds\":[]}}"
        }
        def slide:PptxSlide (itemAt presentation.slides i)
        def px:double (96.0 / 72.0)
        def natural:double (slide.width * px)
        if (natural <= 0.0) {
            return "{\"width\":0,\"height\":0,\"list\":{\"cmds\":[]}}"
        }
        def scale:double ((to_double widthPx) / natural)
        def dl:EVGDisplayList (view.buildDisplayListAt(slide scale))
        def w:double (natural * scale)
        def h:double ((slide.height * px) * scale)
        return ("{\"width\":" + (EVGDisplayList.num(w)) + ",\"height\":" + (EVGDisplayList.num(h)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; Build an EVGElement tree for the current slide (PDF/HTML/export path).
    fn currentEvg@(optional):EVGElement () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            def __missing@(optional):EVGElement
            return __missing
        }
        def hit@(optional):EVGElement (converter.slideToEvg((unwrap slide)))
        return hit
    }

    fn kindName:string (kind:int) {
        if (kind == 1) {
            return "picture"
        }
        if (kind == 2) {
            return "group"
        }
        if (kind == 3) {
            return "connector"
        }
        if (kind == 4) {
            return "table"
        }
        if (kind == 5) {
            return "chart"
        }
        return "shape"
    }

    fn jsonEscape:string (v:string) {
        def out:string "\""
        def i:int 0
        while (i < (strlen v)) {
            def c:int (charAt v i)
            if (c == 34) {
                out = (out + "\\\"")
            } {
                if (c == 92) {
                    out = (out + "\\\\")
                } {
                    if (c == 10) {
                        out = (out + "\\n")
                    } {
                        if (c == 13) {
                            out = (out + "\\r")
                        } {
                            if (c == 9) {
                                out = (out + "\\t")
                            } {
                                if (c < 32) {
                                    out = (out + " ")
                                } {
                                    out = (out + (strfromcode c))
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (out + "\"")
    }

    fn shapeJson:string (shape:PptxShape) {
        def out:string "{"
        out = (out + "\"kind\":" + (this.jsonEscape((this.kindName(shape.kind)))))
        out = (out + ",\"name\":" + (this.jsonEscape(shape.name)))
        out = (out + ",\"preset\":" + (this.jsonEscape(shape.preset)))
        out = (out + ",\"x\":" + (EVGDisplayList.num(shape.x)))
        out = (out + ",\"y\":" + (EVGDisplayList.num(shape.y)))
        out = (out + ",\"w\":" + (EVGDisplayList.num(shape.width)))
        out = (out + ",\"h\":" + (EVGDisplayList.num(shape.height)))
        out = (out + ",\"rotation\":" + (EVGDisplayList.num(shape.rotation)))
        out = (out + ",\"hasText\":" + (to_string shape.hasText))
        if shape.hasText {
            out = (out + ",\"text\":" + (this.jsonEscape((shape.text.plainText()))))
            def runCount:int 0
            def pi:int 0
            while (pi < (array_length shape.text.paragraphs)) {
                def para:PptxParagraph (itemAt shape.text.paragraphs pi)
                runCount = (runCount + (array_length para.runs))
                pi = (pi + 1)
            }
            out = (out + ",\"runs\":" + (to_string runCount))
            out = (out + ",\"paragraphs\":" + (to_string (array_length shape.text.paragraphs)))
        }
        if (shape.kind == (PptxShapeKind.table())) {
            def blob:string ""
            def ti:int 0
            while (ti < (array_length shape.tableCells)) {
                def cell:PptxTableCell (itemAt shape.tableCells ti)
                if ((strlen cell.text) > 0) {
                    if ((strlen blob) > 0) {
                        blob = (blob + "\n")
                    }
                    blob = (blob + cell.text)
                }
                ti = (ti + 1)
            }
            out = (out + ",\"text\":" + (this.jsonEscape(blob)))
            out = (out + ",\"tableRows\":" + (to_string shape.tableRows))
            out = (out + ",\"tableCols\":" + (to_string shape.tableCols))
        }
        if (shape.kind == (PptxShapeKind.chart())) {
            out = (out + ",\"chartType\":" + (this.jsonEscape(shape.chart.chartType)))
            if ((strlen shape.chart.title) > 0) {
                out = (out + ",\"text\":" + (this.jsonEscape(shape.chart.title)))
            }
        }
        if (shape.fill.isSet) {
            out = (out + ",\"fill\":" + (this.jsonEscape(shape.fill.srgb)))
            out = (out + ",\"fillScheme\":" + (to_string shape.fill.isScheme))
        }
        if (shape.kind == (PptxShapeKind.picture())) {
            out = (out + ",\"imagePart\":" + (this.jsonEscape(shape.imagePart)))
            out = (out + ",\"imageBytes\":" + (to_string (buffer_length shape.imageBytes)))
        }
        if (shape.kind == (PptxShapeKind.group())) {
            out = (out + ",\"children\":" + (to_string (array_length shape.children)))
        }
        out = (out + ",\"inherited\":" + (to_string shape.inherited))
        if shape.isPlaceholder {
            out = (out + ",\"phType\":" + (this.jsonEscape(shape.phType)))
            out = (out + ",\"phIdx\":" + (to_string shape.phIdx))
        }
        out = (out + "}")
        return out
    }

    ; Structured summary for the feature harness (parse → resolve → render).
    fn inspectJson:string () {
        def out:string "{"
        out = (out + "\"loaded\":" + (to_string loaded))
        out = (out + ",\"path\":" + (this.jsonEscape(lastPath)))
        out = (out + ",\"slides\":" + (to_string (this.slideCount())))
        out = (out + ",\"slideWidth\":" + (EVGDisplayList.num(presentation.slideWidth)))
        out = (out + ",\"slideHeight\":" + (EVGDisplayList.num(presentation.slideHeight)))
        out = (out + ",\"theme\":{")
        out = (out + "\"accent1\":" + (this.jsonEscape((presentation.theme.colorOf("accent1")))))
        out = (out + ",\"accent2\":" + (this.jsonEscape((presentation.theme.colorOf("accent2")))))
        out = (out + ",\"dk1\":" + (this.jsonEscape((presentation.theme.colorOf("dk1")))))
        out = (out + ",\"lt1\":" + (this.jsonEscape((presentation.theme.colorOf("lt1")))))
        out = (out + ",\"majorFont\":" + (this.jsonEscape(presentation.theme.majorFont)))
        out = (out + ",\"minorFont\":" + (this.jsonEscape(presentation.theme.minorFont)))
        out = (out + "}")
        out = (out + ",\"slide\":[")
        def si:int 0
        while (si < (array_length presentation.slides)) {
            if (si > 0) {
                out = (out + ",")
            }
            def slide:PptxSlide (itemAt presentation.slides si)
            def dl:EVGDisplayList (converter.slideToDisplayList(slide))
            def page:EVGElement (converter.slideToEvg(slide))
            def authored:int 0
            def aj:int 0
            while (aj < (array_length slide.shapes)) {
                def ash:PptxShape (itemAt slide.shapes aj)
                if (ash.inherited == false) {
                    authored = (authored + 1)
                }
                aj = (aj + 1)
            }
            out = (out + "{")
            out = (out + "\"index\":" + (to_string si))
            out = (out + ",\"part\":" + (this.jsonEscape(slide.partPath)))
            out = (out + ",\"layoutPart\":" + (this.jsonEscape(slide.layoutPart)))
            out = (out + ",\"masterPart\":" + (this.jsonEscape(slide.masterPart)))
            out = (out + ",\"shapeCount\":" + (to_string authored))
            out = (out + ",\"resolvedShapeCount\":" + (to_string (array_length slide.shapes)))
            out = (out + ",\"displayListCmds\":" + (to_string (dl.count())))
            out = (out + ",\"evgChildren\":" + (to_string (page.getChildCount())))
            if (slide.bg.isSet) {
                out = (out + ",\"bg\":" + (this.jsonEscape(slide.bg.srgb)))
            }
            out = (out + ",\"shapes\":[")
            def j:int 0
            while (j < (array_length slide.shapes)) {
                if (j > 0) {
                    out = (out + ",")
                }
                out = (out + (this.shapeJson((itemAt slide.shapes j))))
                j = (j + 1)
            }
            out = (out + "]}")
            si = (si + 1)
        }
        out = (out + "]}")
        return out
    }

    fn close:void () {
        parser.close()
        loaded = false
    }

    ; --- editing --------------------------------------------------------------
    ;
    ; The viewer's geometry is points; the window's is pixels. Everything the
    ; pointer says has to cross that line, and this is the only place it does.

    ; While the deck is being shown the slide is not in a frame, it IS the
    ; frame — so the area it is fitted into is the window, or the part of it the
    ; presenter's screen leaves beside the notes.
    fn showAreaX:double () {
        if (presenterView == false) {
            return 0.0
        }
        return 16.0
    }

    fn showAreaY:double () {
        if (presenterView == false) {
            return 0.0
        }
        return 52.0
    }

    fn showAreaW:double () {
        if (presenterView == false) {
            return (to_double W)
        }
        return (((to_double W) * 0.60) - 24.0)
    }

    fn showAreaH:double () {
        if (presenterView == false) {
            return (to_double H)
        }
        return ((to_double H) - 104.0)
    }

    ; The page box in points, whichever format is open.
    ;
    ; Every geometry helper below used to start by unwrapping a `PptxSlide`
    ; and reading two fields off it. None of them wanted the slide: fitting a
    ; page into a window, centring it, and turning a click back into page
    ; coordinates are questions about a SIZE. Asking for the size instead is
    ; what lets a second format use the same window without a second copy of
    ; this arithmetic.
    fn pageWidthPt:double () {
        if isOdp {
            return odpDoc.widthPt
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0.0
        }
        def s:PptxSlide (unwrap slide)
        return s.width
    }

    fn pageHeightPt:double () {
        if isOdp {
            return odpDoc.heightPt
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return 0.0
        }
        def s:PptxSlide (unwrap slide)
        return s.height
    }

    fn ptScale:double () {
        def pw:double (this.pageWidthPt())
        def ph:double (this.pageHeightPt())
        if (pw <= 0.0) {
            return (96.0 / 72.0)
        }
        if presenting {
            return (this.showScaleForSize(pw ph))
        }
        def f:double (view.fitScaleFor(pw ph))
        return ((96.0 / 72.0) * f)
    }

    ; What the converter wants: the fit factor, not the point-to-pixel scale.
    fn showScale:double () {
        return ((this.ptScale()) / (96.0 / 72.0))
    }

    fn showScaleFor:double (s:PptxSlide) {
        return (this.showScaleForSize(s.width s.height))
    }

    fn showScaleForSize:double (widthPt:double heightPt:double) {
        def px:double (96.0 / 72.0)
        def wpx:double (widthPt * px)
        def hpx:double (heightPt * px)
        if (wpx <= 0.0) {
            return px
        }
        if (hpx <= 0.0) {
            return px
        }
        def sx:double ((this.showAreaW()) / wpx)
        def sy:double ((this.showAreaH()) / hpx)
        def f:double sx
        if (sy < sx) {
            f = sy
        }
        return (px * f)
    }

    ; Where the slide's top-left corner sits in the window. The fit-to-window
    ; scale leaves a margin on one axis; the page is centred in it.
    fn slideOriginX:double () {
        def pw:double (this.pageWidthPt())
        if (pw <= 0.0) {
            return 0.0
        }
        def sc:double (this.ptScale())
        def wpx:double (pw * sc)
        if presenting {
            return ((this.showAreaX()) + (((this.showAreaW()) - wpx) * 0.5))
        }
        def left:double (to_double (this.panelWidth()))
        ; Centred in what is left BETWEEN the two panels, not in what is left
        ; after the one on the left. With only a left panel the difference is
        ; nothing; with a properties panel on the right as well, a slide
        ; centred the old way sits half under it.
        def right:double (to_double (this.propsWidth()))
        def dx:double (left + (((((to_double W) - left) - right) - wpx) * 0.5))
        if (dx < left) {
            return left
        }
        return dx
    }

    fn slideOriginY:double () {
        def top:double (to_double (toolbarH + (this.panelHeight())))
        def ph:double (this.pageHeightPt())
        if (ph <= 0.0) {
            return top
        }
        def sc:double (this.ptScale())
        def hpx:double (ph * sc)
        if presenting {
            return ((this.showAreaY()) + (((this.showAreaH()) - hpx) * 0.5))
        }
        def avail:double (to_double (((((H - toolbarH) - (this.panelHeight())) - statusH) - (this.notesHeight()))))
        def dy:double ((avail - hpx) * 0.5)
        if (dy < 0.0) {
            return top
        }
        return (top + dy)
    }

    fn screenToSlideX:double (px:int) {
        def sc:double (this.ptScale())
        if (sc <= 0.0) {
            return 0.0
        }
        return (((to_double px) - (this.slideOriginX())) / sc)
    }

    fn screenToSlideY:double (py:int) {
        def sc:double (this.ptScale())
        if (sc <= 0.0) {
            return 0.0
        }
        return (((to_double py) - (this.slideOriginY())) / sc)
    }

    fn syncEditor:void () {
        editor.slideIndex = index
    }

    fn syncFromEditor:void () {
        def n:int (array_length presentation.slides)
        def i:int editor.slideIndex
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        index = i
        editor.slideIndex = i
        ; …and bring the panel with it. `gotoSlide` has always done this, but
        ; everything that moves the current slide from the EDITOR side came
        ; through here and did not: adding a slide, undoing one, and every
        ; call an API script makes. A deck of forty slides answered "slide 31"
        ; in the status line while the thumbnails still showed one to eight,
        ; so a script that adds a slide appeared to have done nothing.
        this.ensureSlideVisible()
    }

    ; Handles, clockwise from the top-left, on the selection's box.
    ; The handle geometry moved to `EVGSelectChrome` when the book editor
    ; needed the same eight handles in the same order. These two stay as the
    ; names the rest of this file calls.
    sfn handleCx:double (x0:double x1:double idx:int) {
        return (EVGSelectChrome.handleCx(x0 x1 idx))
    }

    sfn handleCy:double (y0:double y1:double idx:int) {
        return (EVGSelectChrome.handleCy(y0 y1 idx))
    }

    ; The rotation handle stands off the top of the box, where every editor
    ; puts it.
    ; Where the rotation handle stands: above the top edge of the selection,
    ; and never underneath the toolbar.
    ;
    ; The clamp is the whole point of this being a function. A shape near the
    ; top of the slide put its handle at y=67 with a toolbar 68 tall, and
    ; `editPointer` rejects everything above `toolbarH` as a click on the
    ; strip — so the handle was DRAWN, `handleAt` found it, and pressing it
    ; did nothing at all. A control you can see and cannot use is worse than
    ; one that is not there, because the reader keeps trying.
    fn rotateHandleY:double (y0:double) {
        def y:double (y0 - 18.0)
        def floorY:double (to_double (toolbarH + 8))
        if (y < floorY) {
            return floorY
        }
        return y
    }

    ; One shape, turned: its selection turns with it. Several shapes, or none
    ; turned, and the box is the upright one that contains them — which is
    ; what PowerPoint draws too, because there is no single angle to draw at.
    fn selectionAngle:double () {
        if ((editor.selectionCount()) != 1) {
            ; Several shapes have no angle of their own, but while they are
            ; being turned together they have the drag's. Without this the
            ; frame stayed square around contents that were plainly turning.
            if editor.rotActive {
                return editor.rotDeg
            }
            return 0.0
        }
        def hit@(optional):PptxShape (editor.firstSelected())
        if (null? hit) {
            return 0.0
        }
        def sh:PptxShape (unwrap hit)
        return sh.rotation
    }

    ; Where handle `idx` is on screen, rotation included. -1 asks for the
    ; rotation handle, which stands off the top edge in the shape's own
    ; direction rather than straight up the window.
    fn handlePos:[double] (idx:int) {
        def out:[double]
        def sc:double (this.ptScale())
        def ox:double (this.slideOriginX())
        def oy:double (this.slideOriginY())
        ; While several shapes are being turned together the frame is the box
        ; they started in, turned — not the box they are in NOW. The current
        ; bounds are the axis-aligned extent of shapes that are themselves
        ; turning, so they grow with the drag and the frame stops hugging
        ; anything.
        def b:PptxEditRect (editor.selectionBounds())
        if ((editor.selectionCount()) != 1) {
            if editor.rotActive {
                b = editor.rotBox
            }
        }
        def x0:double ((b.x * sc) + ox)
        def y0:double ((b.y * sc) + oy)
        def x1:double (((b.right()) * sc) + ox)
        def y1:double (((b.bottom()) * sc) + oy)
        def hx:double (PptxApp.handleCx(x0 x1 idx))
        def hy:double (PptxApp.handleCy(y0 y1 idx))
        if (idx == 8) {
            hx = ((x0 + x1) * 0.5)
            hy = (this.rotateHandleY(y0))
        }
        def deg:double (this.selectionAngle())
        if ((deg > 0.001) || (deg < -0.001)) {
            def cx:double ((x0 + x1) * 0.5)
            def cy:double ((y0 + y1) * 0.5)
            def p:[double] (PptxToEvg.rotateAbout(hx hy cx cy deg))
            push out (itemAt p 0)
            push out (itemAt p 1)
            return out
        }
        push out hx
        push out hy
        return out
    }

    ; The four corners of the selection box, turned with it.
    fn selectionCorners:[double] () {
        def out:[double]
        def i:int 0
        while (i < 8) {
            def useIt:boolean false
            if (i == 0) {
                useIt = true
            }
            if (i == 2) {
                useIt = true
            }
            if (i == 4) {
                useIt = true
            }
            if (i == 6) {
                useIt = true
            }
            if useIt {
                def p:[double] (this.handlePos(i))
                push out (itemAt p 0)
                push out (itemAt p 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; A line as a quad, because the display list's frame is axis-aligned and a
    ; turned box has no axis-aligned edges.
    fn pushLine:void (dl:EVGDisplayList x0:double y0:double x1:double y1:double thickness:double col:EVGColor) {
        def dx:double (x1 - x0)
        def dy:double (y1 - y0)
        def len:double (sqrt ((dx * dx) + (dy * dy)))
        if (len < 0.0001) {
            return
        }
        def nx:double (((0.0 - dy) / len) * (thickness * 0.5))
        def ny:double ((dx / len) * (thickness * 0.5))
        def pts:[double]
        push pts (x0 + nx)
        push pts (y0 + ny)
        push pts (x1 + nx)
        push pts (y1 + ny)
        push pts (x1 - nx)
        push pts (y1 - ny)
        push pts (x0 - nx)
        push pts (y0 - ny)
        dl.addPolygon(pts col)
    }

    fn pushQuadOutline:void (dl:EVGDisplayList corners:[double] thickness:double col:EVGColor) {
        if ((array_length corners) < 8) {
            return
        }
        def i:int 0
        while (i < 4) {
            def j:int ((i + 1) % 4)
            this.pushLine(dl (itemAt corners (i * 2)) (itemAt corners ((i * 2) + 1)) (itemAt corners (j * 2)) (itemAt corners ((j * 2) + 1)) thickness col)
            i = (i + 1)
        }
    }

    fn handleAt:int (px:int py:int) {
        if ((editor.selectionCount()) == 0) {
            return -1
        }
        def sc:double (this.ptScale())
        def ox:double (this.slideOriginX())
        def oy:double (this.slideOriginY())
        def b:PptxEditRect (editor.selectionBounds())
        def x0:double ((b.x * sc) + ox)
        def y0:double ((b.y * sc) + oy)
        def x1:double (((b.right()) * sc) + ox)
        def y1:double (((b.bottom()) * sc) + oy)
        def fx:double (to_double px)
        def fy:double (to_double py)
        def rot:[double] (this.handlePos(8))
        if ((fabs (fx - (itemAt rot 0))) <= 7.0) {
            if ((fabs (fy - (itemAt rot 1))) <= 7.0) {
                return 8
            }
        }
        def i:int 0
        while (i < 8) {
            def p:[double] (this.handlePos(i))
            def dx:double (fabs (fx - (itemAt p 0)))
            def dy:double (fabs (fy - (itemAt p 1)))
            if (dx <= 6.0) {
                if (dy <= 6.0) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; A press picks something up, a drag carries it, and the release is the
    ; single history step. Nothing between press and release is undoable on
    ; its own — a drag is one edit however many frames it took.
    fn editPointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        if (py < toolbarH) {
            return false
        }
        if (py >= ((H - statusH) - (this.notesHeight()))) {
            return false
        }
        def sx:double (this.screenToSlideX(px))
        def sy:double (this.screenToSlideY(py))
        if pressed {
            this.syncEditor()
            ; An armed tool takes the press before anything else on the slide:
            ; the whole point of arming one is that the next drag means "put
            ; it here" and not "select what is under here".
            if ((strlen pendingTool) > 0) {
                dragMode = 5
                marqueeX = sx
                marqueeY = sy
                marqueeW = 0.0
                marqueeH = 0.0
                dragLastX = sx
                dragLastY = sy
                dragMoved = false
                return true
            }
            ; While a caret is in a shape, a click inside that shape moves the
            ; caret rather than picking the shape up again.
            if (editor.isEditingText()) {
                def edited@(optional):PptxShape (editor.editingShape())
                if (!null? edited) {
                    def es:PptxShape (unwrap edited)
                    def sxPt:double (this.screenToSlideX(px))
                    def syPt:double (this.screenToSlideY(py))
                    if (PptxEditor.containsPoint(es sxPt syPt)) {
                        def at:PptxTextPos (this.caretFromPoint(es px py))
                        editor.setCaretPos(at.para at.col modShift)
                        dragMode = 0
                        return true
                    }
                }
                editor.endTextEdit()
            }
            def h:int (this.handleAt(px py))
            if (h >= 0) {
                dragMode = 2
                if (h == 8) {
                    dragMode = 4
                    ; Where everything is before the turn starts, so each
                    ; frame turns from there.
                    editor.beginRotate()
                }
                dragHandle = h
                dragLastX = sx
                dragLastY = sy
                dragMoved = false
                return true
            }
            def hitId:int (editor.hitTest(sx sy))
            clickedSelected = false
            clickX = px
            clickY = py
            if (hitId > 0) {
                if (modShift == false) {
                    if ((editor.selectionCount()) == 1) {
                        def already@(optional):PptxShape (editor.firstSelected())
                        if (!null? already) {
                            def a:PptxShape (unwrap already)
                            clickedSelected = (a.editId == hitId)
                        }
                    }
                }
            }
            editor.selectAt(sx sy modShift)
            dragMode = 0
            if (hitId > 0) {
                dragMode = 1
                dragLastX = sx
                dragLastY = sy
                dragMoved = false
            } {
                ; Nothing under the pointer: a drag from here is a rubber band.
                dragMode = 3
                marqueeX = sx
                marqueeY = sy
                marqueeW = 0.0
                marqueeH = 0.0
                dragLastX = sx
                dragLastY = sy
                dragMoved = false
            }
            return true
        }
        if released {
            if (dragMode > 0) {
                if (dragMode == 5) {
                    this.placePendingTool()
                    marqueeW = 0.0
                    marqueeH = 0.0
                    dragMode = 0
                    return true
                }
                if (dragMode == 3) {
                    ; A band that never moved is a click on empty canvas, and
                    ; that already cleared the selection.
                    if dragMoved {
                        editor.selectInRect(marqueeX marqueeY marqueeW marqueeH modShift)
                    }
                    marqueeW = 0.0
                    marqueeH = 0.0
                } {
                    if dragMoved {
                        if (dragMode == 1) {
                            editor.pushSnapshot("move")
                        } {
                            if (dragMode == 4) {
                                editor.pushSnapshot("rotate")
                            } {
                                editor.pushSnapshot("resize")
                            }
                        }
                    }
                }
                editor.clearGuides()
                editor.endRotate()
                def wasClick:boolean false
                if (dragMode == 1) {
                    if (dragMoved == false) {
                        wasClick = clickedSelected
                    }
                }
                dragMode = 0
                dragHandle = -1
                if wasClick {
                    this.startTextEditAt(clickX clickY)
                }
                clickedSelected = false
                return true
            }
            return false
        }
        if (dragMode > 0) {
            if down {
                def dx:double (sx - dragLastX)
                def dy:double (sy - dragLastY)
                if (dragMode == 1) {
                    def adj:PptxEditRect (editor.snapDelta(dx dy))
                    editor.applyMove(adj.x adj.y)
                    ; Follow the shape rather than the pointer, so a snapped
                    ; edge stays put until the pointer has really left it.
                    dragLastX = (dragLastX + adj.x)
                    dragLastY = (dragLastY + adj.y)
                }
                if (dragMode == 2) {
                    ; A turned shape is resized along its OWN axes: dragging
                    ; the right-hand handle of a shape lying on its side has to
                    ; make it longer, not taller. The pointer's movement is
                    ; turned back by the shape's angle before the box hears
                    ; about it.
                    def deg:double (this.selectionAngle())
                    def ldx:double dx
                    def ldy:double dy
                    if ((deg > 0.001) || (deg < -0.001)) {
                        def local:[double] (PptxToEvg.rotateAbout(dx dy 0.0 0.0 (0.0 - deg)))
                        ldx = (itemAt local 0)
                        ldy = (itemAt local 1)
                    } {
                        ; Square to the slide, so the edge under the hand can be
                        ; lined up with the other shapes and with the grid, and
                        ; a guide drawn where it landed — the same help moving a
                        ; shape has always had. A TURNED box is resized in its
                        ; own frame, where the snap lines mean nothing, so it is
                        ; left alone rather than snapped to a line that is not
                        ; where it looks.
                        def fit:PptxEditRect (editor.snapResize(dragHandle dx dy))
                        ldx = fit.x
                        ldy = fit.y
                    }
                    editor.applyResize(dragHandle ldx ldy)
                    dragLastX = sx
                    dragLastY = sy
                }
                if (dragMode == 3) {
                    marqueeW = (sx - marqueeX)
                    marqueeH = (sy - marqueeY)
                }
                ; Placing a tool draws the same rectangle a rubber band does,
                ; and for the same reason: the reader has to see the shape of
                ; the thing before they let go of it.
                if (dragMode == 5) {
                    marqueeW = (sx - marqueeX)
                    marqueeH = (sy - marqueeY)
                }
                if (dragMode == 4) {
                    ; The pointer's angle about the point the turn STARTED
                    ; from, with the handle standing at twelve o'clock.
                    ;
                    ; It used to recompute the centre from the selection's
                    ; bounds every frame, and for a group that is a centre
                    ; that MOVES: `spinAbout` carries each shape around the
                    ; pivot, so the bounding box of the selection swings as
                    ; the group turns. Measured over a full turn of two
                    ; shapes the recomputed centre wandered from (360,135) to
                    ; (450,22) and back — a hundred and forty points away
                    ; from where the turn began. The group still ended up
                    ; rotated about the right point, because `applyRotate`
                    ; uses the captured pivot; what was wrong was the ANGLE,
                    ; so the group did not follow the pointer and the handle
                    ; felt like it was fighting the hand holding it.
                    def cx:double editor.rotPivotX
                    def cy:double editor.rotPivotY
                    def ang:double (atan2 (sy - cy) (sx - cx))
                    def deg:double (((ang * 180.0) / 3.141592653589793) + 90.0)
                    if modShift {
                        deg = (PptxEditor.snapToStep(deg 15.0))
                    }
                    editor.applyRotate(deg)
                }
                dragMoved = true
                return true
            }
        }
        return false
    }

    ; Put the armed tool down where it was dragged.
    ;
    ; A drag gives the box its rectangle. A CLICK — a drag that never moved —
    ; gives a sensible default box centred on where the reader clicked, which
    ; is what somebody who does not know the tool wants a drag to be, and it
    ; still lands where they pointed rather than at a fixed spot on the slide.
    ;
    ; The box arrives EMPTY and with the caret in it. It used to arrive
    ; carrying the word "Text", which every reader then had to select and
    ; delete before writing their own — a placeholder is only kind when the
    ; program cannot put the caret where the words go, and it can.
    fn placePendingTool:void () {
        if ((strlen pendingTool) == 0) {
            return
        }
        def tool:string pendingTool
        pendingTool = ""
        view.status = ""
        def x0:double marqueeX
        def y0:double marqueeY
        def w0:double marqueeW
        def h0:double marqueeH
        if (w0 < 0.0) {
            x0 = (x0 + w0)
            w0 = (0.0 - w0)
        }
        if (h0 < 0.0) {
            y0 = (y0 + h0)
            h0 = (0.0 - h0)
        }
        ; Too small to have been meant as a rectangle: treat it as a click.
        def minW:double ((this.slideW()) * 0.04)
        def minH:double ((this.slideH()) * 0.04)
        def drewIt:boolean true
        if (w0 < minW) {
            drewIt = false
        }
        if (h0 < minH) {
            drewIt = false
        }
        if (w0 < minW) {
            w0 = ((this.slideW()) * 0.34)
            x0 = (x0 - (w0 * 0.5))
        }
        if (h0 < minH) {
            h0 = ((this.slideH()) * 0.1)
            y0 = (y0 - (h0 * 0.5))
        }
        if (x0 < 0.0) {
            x0 = 0.0
        }
        if (y0 < 0.0) {
            y0 = 0.0
        }
        if (tool == "text") {
            def newId:int (editor.addTextBox(x0 y0 w0 h0 ""))
            if (newId > 0) {
                editor.beginTextEdit(newId)
                view.status = ""
            }
            return
        }
        ; A shape. An entry that carries its own outline — every emoji — goes
        ; in as a custom geometry rather than a preset name, because there is
        ; no preset called "panda". Everything else stays a NAME: PowerPoint
        ; draws a preset from its own geometry at whatever size the shape is,
        ; and a flattened copy of it would not.
        ; The catalogue is asked but not required. `rect` and `ellipse` are
        ; preset names the toolbar arms directly and the catalogue has never
        ; heard of them — insisting on an entry meant the two buttons on the
        ; Insert tab drew nothing at all.
        def entry:ShapeEntry (shapes.find(tool))
        def known:boolean (entry.id == tool)
        if known {
            ; A shape that states the proportion it needs keeps it when the
            ; reader only CLICKED — a panda in a box they did not draw is a
            ; wide panda. A box they did draw is theirs, aspect or not.
            if (drewIt == false) {
                if (entry.aspect > 0.0) {
                    def wAspect:double (h0 * entry.aspect)
                    x0 = (x0 + ((w0 - wAspect) * 0.5))
                    w0 = wAspect
                }
            }
            if (entry.hasPath()) {
                this.insertOutline(entry x0 y0 w0 h0)
                return
            }
        }
        editor.addShapeAt(tool x0 y0 w0 h0)
    }

    ; Arm a tool. The next drag on the slide says where it goes and how big.
    ;
    ; `what` is either "text" or a name the shape catalogue knows — which is
    ; the same vocabulary the picker hands back, so a preset and an emoji arm
    ; the same way and `placePendingTool` sorts out which is which.
    fn armTool:boolean (what:string) {
        this.setEditMode(true)
        editor.endTextEdit()
        editor.clearSelection()
        pendingTool = what
        if (what == "text") {
            view.status = "drag on the slide to place a text box"
        } {
            view.status = "drag on the slide to draw the shape"
        }
        return true
    }

    ; Put the tool down without using it. Escape, and a click on the strip.
    fn cancelPendingTool:boolean () {
        if ((strlen pendingTool) == 0) {
            return false
        }
        pendingTool = ""
        view.status = ""
        if (dragMode == 5) {
            dragMode = 0
            marqueeW = 0.0
            marqueeH = 0.0
        }
        return true
    }

    fn setMods:void (shift:boolean ctrl:boolean) {
        modShift = shift
        modCtrl = ctrl
    }

    ; Whether what is open can be edited at all. `.odp` is read-only here —
    ; PLAN_FORMATS.md targets L1 for it, and there is no ODF writer — so the
    ; honest thing is to say so once, in a method a UI can ask, rather than to
    ; let an edit land in a model nothing will ever save.
    ;
    ; This is `DocumentFormatAdapter.capabilities` in embryo: the question a
    ; shell should ask is "can this be edited", never "is the extension
    ; .pptx".
    fn canEdit:boolean () {
        return (isOdp == false)
    }

    fn setEditMode:void (on:boolean) {
        if on {
            if ((this.canEdit()) == false) {
                editMode = false
                toolbar.editOn = false
                return
            }
        }
        editMode = on
        toolbar.editOn = on
        if (on == false) {
            editor.clearSelection()
            editor.clearGuides()
            dragMode = 0
        }
    }

    fn nudge:boolean (dx:double dy:double) {
        if ((editor.selectionCount()) == 0) {
            return false
        }
        this.syncEditor()
        return (editor.moveSelection(dx dy))
    }

    ; Bold and italic are toggles, and what they toggle from is whatever the
    ; first run of the first selected shape says.
    fn selectionBold:boolean () {
        def hit@(optional):PptxShape (editor.firstSelected())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        def run@(optional):PptxTextRun (PptxEditor.firstRun(sh.text))
        if (null? run) {
            return false
        }
        def r:PptxTextRun (unwrap run)
        return r.bold
    }

    fn selectionItalic:boolean () {
        def hit@(optional):PptxShape (editor.firstSelected())
        if (null? hit) {
            return false
        }
        def sh:PptxShape (unwrap hit)
        def run@(optional):PptxTextRun (PptxEditor.firstRun(sh.text))
        if (null? run) {
            return false
        }
        def r:PptxTextRun (unwrap run)
        return r.italic
    }

    ; A picture from the host.
    ;
    ; The name the file arrived under is not used to identify it. It used to
    ; be — the part was `ppt/media/` plus whatever the user's file was called —
    ; and two consequences followed. A second file also called `logo.png` was
    ; silently shown and saved as the first one, because the decode cache and
    ; the writer's media table both already had that key. And a file called
    ; `image1.png`, the name every OOXML package gives its own media, collided
    ; with the deck's own picture, so the inserted bytes were dropped
    ; altogether. The part is derived from the content instead, which cannot
    ; do either.
    ;
    ; The picture is also given its own shape. It used to be forced to 3:5
    ; whatever it actually was, so every inserted photograph came in squashed
    ; or stretched; the size in its header decides now, and the old guess is
    ; kept only for the formats whose header we do not read.
    fn insertPicture:boolean (name:string bytes:buffer) {
        if (loaded == false) {
            return false
        }
        if ((buffer_length bytes) == 0) {
            return false
        }
        this.syncEditor()
        def assetId:string (assets.intern(bytes (OfficeAssetStore.mimeForPath(name)) ""))
        def asset:OfficeAsset (assets.assetOf(assetId))
        def ext:string (OfficeAssetStore.extensionForMime(asset.mimeType))
        def part:string (("ppt/media/" + asset.hash) + ext)
        view.cacheImage(part bytes)
        def w:double ((this.slideW()) * 0.35)
        def h:double (w * 0.6)
        if (asset.width > 0) {
            if (asset.height > 0) {
                h = (w * ((to_double asset.height) / (to_double asset.width)))
                ; A very tall picture is fitted to the slide's height rather
                ; than run off the bottom of it.
                def maxH:double ((this.slideH()) * 0.8)
                if (h > maxH) {
                    def shrink:double (maxH / h)
                    h = maxH
                    w = (w * shrink)
                }
            }
        }
        def x:double (((this.slideW()) - w) * 0.5)
        def y:double (((this.slideH()) - h) * 0.5)
        def id:int (editor.addPicture(part bytes x y w h))
        def added@(optional):PptxShape (editor.findShape(id))
        if (!null? added) {
            def sh:PptxShape (unwrap added)
            view.cacheShapeImages(sh)
        }
        this.setEditMode(true)
        return (id > 0)
    }

    ; --- accessibility --------------------------------------------------------
    ;
    ; What the deck MEANS, beside what it looks like. A screen reader cannot
    ; read a canvas — before this, a presentation opened here was a blank
    ; window to anyone using one. The spreadsheet and the document viewer both
    ; publish this already; `EVGA11yTree` lives in `gallery/evg` because it is
    ; none of theirs.
    fn a11yTree:EVGA11yTree () {
        def selected:int 0
        def hit@(optional):PptxShape (editor.firstSelected())
        if (!null? hit) {
            def sh:PptxShape (unwrap hit)
            selected = sh.editId
        }
        return (PptxA11y.build(presentation index selected))
    }

    fn a11yJson:string () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.toJson())
    }

    ; The same tree as indented text, so a refactor that silently drops a name
    ; shows up as a diff rather than as a bug report from the one person who
    ; noticed.
    fn a11yDump:string () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.dump())
    }

    ; The page's own aspect, which the thumbnail strip sizes itself from. With
    ; a .odp open these used to answer with `presentation.slideWidth` — the
    ; DEFAULT of an empty deck — so every thumbnail was drawn in 4:3 with a
    ; white band under a 16:9 page.
    fn slideW:double () {
        if isOdp {
            return odpDoc.widthPt
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return presentation.slideWidth
        }
        def s:PptxSlide (unwrap slide)
        return s.width
    }

    fn slideH:double () {
        if isOdp {
            return odpDoc.heightPt
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return presentation.slideHeight
        }
        def s:PptxSlide (unwrap slide)
        return s.height
    }

    ; --- the editing commands -------------------------------------------------
    ; Every one of them is a command id, so a toolbar button, a keyboard chord
    ; and a host over a socket all reach the same code.
    fn runEditCommand:boolean (id:string arg:string) {
        if (id == "edit.toggle") {
            def want:boolean (editMode == false)
            this.setEditMode(want)
            return true
        }
        if (loaded == false) {
            return false
        }
        this.syncEditor()
        if (id == "edit.undo") {
            def ok:boolean (editor.undo())
            this.syncFromEditor()
            return ok
        }
        if (id == "edit.redo") {
            def ok2:boolean (editor.redo())
            this.syncFromEditor()
            return ok2
        }
        if (id == "edit.delete") {
            return (editor.deleteSelection())
        }
        if (id == "edit.duplicate") {
            return (editor.duplicateSelection())
        }
        if (id == "edit.copy") {
            return ((editor.copySelection()) > 0)
        }
        if (id == "edit.cut") {
            return ((editor.cutSelection()) > 0)
        }
        if (id == "edit.paste") {
            return (editor.pasteClipboard(true))
        }
        if (id == "format.copy") {
            return (editor.copyFormat())
        }
        if (id == "format.paste") {
            return (editor.applyFormat())
        }
        if (id == "edit.flip.h") {
            return (editor.flipSelection(true))
        }
        if (id == "edit.flip.v") {
            return (editor.flipSelection(false))
        }
        if (id == "edit.lock") {
            def locked:boolean (editor.selectionLocked())
            return (editor.setLocked((locked == false)))
        }
        if (id == "view.notes") {
            notesVisible = (notesVisible == false)
            view.chromeH = (((toolbarH + statusH) + (this.notesHeight())) + (this.panelHeight()))
            if (notesVisible == false) {
                if (editor.isEditingNotes()) {
                    editor.endTextEdit()
                }
            }
            return true
        }
        if (id == "notes.edit") {
            notesVisible = true
            view.chromeH = (((toolbarH + statusH) + (this.notesHeight())) + (this.panelHeight()))
            return (editor.editNotes())
        }
        if (id == "notes.set") {
            return (editor.setNotes(arg))
        }
        if (id == "theme.palette") {
            return (editor.applyPalette(arg))
        }
        if (id == "theme.color") {
            def cut:int (indexOf arg ":")
            if (cut < 0) {
                return false
            }
            def slot:string (substring arg 0 cut)
            def hex:string (substring arg (cut + 1) (strlen arg))
            return (editor.setThemeColor(slot hex))
        }
        if (id == "slide.layout") {
            return (editor.applyLayout(arg))
        }
        if (id == "slide.background") {
            if ((strlen arg) == 0) {
                return (editor.clearSlideBackground())
            }
            return (editor.setSlideBackground(arg))
        }
        ; The master is edited in the same frame as a slide: what changes is
        ; which sheet the shapes come from, so every tool keeps working.
        if (id == "master.edit") {
            if (editor.isEditingSheet()) {
                editor.exitSheet()
                return true
            }
            def slide@(optional):PptxSlide (editor.currentSlide())
            if (null? slide) {
                return false
            }
            def s0:PptxSlide (unwrap slide)
            def part:string s0.masterPart
            if ((strlen part) == 0) {
                return false
            }
            this.setEditMode(true)
            return (editor.editSheet(part))
        }
        if (id == "master.exit") {
            if ((editor.isEditingSheet()) == false) {
                return false
            }
            editor.exitSheet()
            return true
        }
        if (id == "footer.set") {
            return (editor.setFooter(arg))
        }
        if (id == "slide.numbers") {
            def on:boolean (editor.slideNumbersShown())
            return (editor.showSlideNumbers((on == false)))
        }
        if (id == "section.add") {
            def name:string arg
            if ((strlen name) == 0) {
                name = ("Section " + (to_string ((editor.sectionCount()) + 1)))
            }
            return (editor.addSection(name))
        }
        if (id == "section.rename") {
            def at:int (editor.sectionOfSlide(index))
            if (at < 0) {
                return false
            }
            if ((strlen arg) == 0) {
                return false
            }
            return (editor.renameSection(at arg))
        }
        if (id == "section.remove") {
            def at2:int (editor.sectionOfSlide(index))
            if (at2 < 0) {
                return false
            }
            return (editor.removeSection(at2))
        }
        ; --- the show ---------------------------------------------------------
        if (id == "show.start") {
            return (this.startPresenting())
        }
        if (id == "show.stop") {
            return (this.stopPresenting())
        }
        if (id == "show.next") {
            return (this.presentNext())
        }
        if (id == "show.prev") {
            return (this.presentPrev())
        }
        if (id == "show.presenter") {
            presenterView = (presenterView == false)
            return true
        }
        if (id == "show.blank") {
            showBlank = (showBlank == false)
            return true
        }
        if (id == "show.pen") {
            return (this.setPen("pen"))
        }
        if (id == "show.laser") {
            return (this.setPen("laser"))
        }
        if (id == "show.ink.clear") {
            return (this.clearInk())
        }
        if (id == "slide.transition") {
            ; "kind" or "kind:dir" or "kind:dir:seconds" — one string, because
            ; a command table carries one argument.
            def kind:string arg
            def dir:string ""
            def secs:double 0.0
            def cut:int (indexOf arg ":")
            if (cut >= 0) {
                kind = (substring arg 0 cut)
                def rest:string (substring arg (cut + 1) (strlen arg))
                def cut2:int (indexOf rest ":")
                if (cut2 >= 0) {
                    dir = (substring rest 0 cut2)
                    def sv@(optional):double (str2double (substring rest (cut2 + 1) (strlen rest)))
                    secs = (?? sv 0.0)
                } {
                    dir = rest
                }
            }
            return (editor.setTransition(kind dir secs))
        }
        if (id == "slide.advance") {
            def av@(optional):double (str2double arg)
            return (editor.setAdvanceAfter((?? av 0.0)))
        }
        if (id == "shape.animate") {
            def eff:string arg
            if ((strlen eff) == 0) {
                eff = "fade"
            }
            return (editor.animateSelection(eff 0.0))
        }
        if (id == "shape.animate.clear") {
            return (editor.clearAnimation())
        }
        if (id == "build.earlier") {
            def at:int (this.selectedBuildStep())
            if (at <= 0) {
                return false
            }
            return (editor.moveBuildStep(at (at - 1)))
        }
        if (id == "build.later") {
            def at2:int (this.selectedBuildStep())
            if (at2 < 0) {
                return false
            }
            return (editor.moveBuildStep(at2 (at2 + 1)))
        }
        if (id == "view.panel") {
            panelVisible = (panelVisible == false)
            view.chromeW = (this.panelWidth())
            return true
        }
        if (id == "view.grid") {
            editor.setGrid((editor.gridEnabled == false))
            return true
        }
        if (id == "view.props") {
            propsVisible = (propsVisible == false)
            this.resize(W H)
            return true
        }
        if (id == "view.snap") {
            editor.snapEnabled = (editor.snapEnabled == false)
            return true
        }
        if (id == "edit.selectall") {
            if (editor.isEditingText()) {
                editor.selectAllText()
                return true
            }
            editor.selectAll()
            return true
        }
        if (id == "text.edit") {
            if (editor.isEditingText()) {
                editor.endTextEdit()
                return true
            }
            this.setEditMode(true)
            return (this.startTextEdit())
        }
        if (id == "edit.front") {
            return (editor.bringToFront())
        }
        if (id == "edit.back") {
            return (editor.sendToBack())
        }
        if (id == "edit.forward") {
            return (editor.bringForward())
        }
        if (id == "edit.backward") {
            return (editor.sendBackward())
        }
        if (id == "edit.group") {
            return (editor.groupSelection())
        }
        if (id == "edit.ungroup") {
            return (editor.ungroupSelection())
        }
        ; Aligning the TEXT in the selected shapes. The values are
        ; DrawingML's own, which is what the model and the writer speak.
        if (id == "text.align.left") {
            return (editor.setTextAlign("l"))
        }
        if (id == "text.align.center") {
            return (editor.setTextAlign("ctr"))
        }
        if (id == "text.align.right") {
            return (editor.setTextAlign("r"))
        }
        if (id == "edit.align.left") {
            return (editor.alignSelection("left"))
        }
        if (id == "edit.align.hcenter") {
            return (editor.alignSelection("hcenter"))
        }
        if (id == "edit.align.right") {
            return (editor.alignSelection("right"))
        }
        if (id == "edit.align.top") {
            return (editor.alignSelection("top"))
        }
        if (id == "edit.align.vcenter") {
            return (editor.alignSelection("vcenter"))
        }
        if (id == "edit.align.bottom") {
            return (editor.alignSelection("bottom"))
        }
        if (id == "edit.distribute.h") {
            return (editor.distributeSelection(true))
        }
        if (id == "edit.distribute.v") {
            return (editor.distributeSelection(false))
        }
        if (id == "edit.bold") {
            def b:boolean (this.selectionBold())
            return (editor.setTextBold((b == false)))
        }
        if (id == "edit.italic") {
            def it:boolean (this.selectionItalic())
            return (editor.setTextItalic((it == false)))
        }
        ; Lists. Both toggle: asking for the list a paragraph already is turns
        ; it off, which is what every editor's list button does.
        if (id == "text.bullet") {
            if ((editor.listKind()) == "bullet") {
                return (editor.setListKind("none"))
            }
            return (editor.setListKind("bullet"))
        }
        if (id == "text.number") {
            if ((editor.listKind()) == "number") {
                return (editor.setListKind("none"))
            }
            return (editor.setListKind("number"))
        }
        ; The typeface, by name. `arg` is a family the page has a face for —
        ; the chooser only ever offers those — and an empty one is a no-op
        ; rather than a run set to nothing.
        if (id == "text.font") {
            return (editor.setTextFamily(arg))
        }
        if (id == "text.indent") {
            return (editor.indentList(1))
        }
        if (id == "text.outdent") {
            return (editor.indentList(0 - 1))
        }
        if (id == "edit.fill") {
            if ((strlen arg) == 0) {
                return (editor.clearFill())
            }
            return (editor.setFillHex(arg))
        }
        if (id == "edit.line") {
            ; Keep whatever thickness the shape already has. Passing 1.0 here
            ; meant that recolouring an outline silently reset a 3pt rule to a
            ; hairline — the properties panel makes that obvious, because the
            ; width row would jump every time a colour was picked.
            def keep:double 1.0
            def lin@(optional):PptxShape (editor.firstSelected())
            if (!null? lin) {
                def ls:PptxShape (unwrap lin)
                if (ls.lineWidthPt > 0.0) {
                    keep = ls.lineWidthPt
                }
            }
            if ((strlen arg) == 0) {
                return (editor.clearLine())
            }
            return (editor.setLineHex(arg keep))
        }
        ; The outline's thickness on its own, in points.
        if (id == "edit.linewidth") {
            def wv@(optional):double (str2double arg)
            return (editor.setLineWidthPt((?? wv 0.0)))
        }
        ; The text's colour. `edit.text` next to it sets the text ITSELF,
        ; which is a different job with a confusingly similar name.
        if (id == "edit.textcolor") {
            return (editor.setTextColorHex(arg))
        }
        if (id == "edit.text") {
            def sel@(optional):PptxShape (editor.firstSelected())
            if (null? sel) {
                return false
            }
            def sh:PptxShape (unwrap sel)
            return (editor.setShapeText(sh.editId arg))
        }
        ; Any shape in the catalogue, by id. `shape.rect` and `shape.ellipse`
        ; below are what a toolbar button with no argument sends, and they are
        ; left alone: this is the same insert with a name in it.
        ; The shared browser. The SAME command id in the book editor opens
        ; the same window over its own catalogue.
        if (id == "shape.pick") {
            picker.open(windows W H)
            return true
        }
        if (id == "shape.insert") {
            if ((strlen arg) == 0) {
                return false
            }
            ; Bound to a local: `(obj.m()).field` does not resolve in Ranger.
            def entry:ShapeEntry (shapes.find(arg))
            if (entry.id != arg) {
                return false
            }
            ; The tool is ARMED, not used. The shape appears where the reader
            ; drags it, the way every other editor does it — dropping it at a
            ; fixed spot on the slide meant they could not see where it was
            ; going, and the picker was still sitting over the slide hiding
            ; the answer. So the picker shuts and the next drag decides.
            picker.close()
            return (this.armTool(arg))
        }
        if (id == "shape.rect") {
            return (this.armTool("rect"))
        }
        if (id == "shape.ellipse") {
            return (this.armTool("ellipse"))
        }
        if (id == "text.add") {
            return (this.armTool("text"))
        }
        if (id == "picture.add") {
            fileRequest = "image"
            return true
        }
        if (id == "slide.add") {
            def okAdd:boolean (editor.addSlide())
            this.syncFromEditor()
            return okAdd
        }
        if (id == "slide.duplicate") {
            def okDup:boolean (editor.duplicateSlide())
            this.syncFromEditor()
            return okDup
        }
        if (id == "slide.delete") {
            def okDel:boolean (editor.deleteSlide())
            this.syncFromEditor()
            return okDel
        }
        if (id == "slide.moveup") {
            def okUp:boolean (editor.moveSlide(0 - 1))
            this.syncFromEditor()
            return okUp
        }
        if (id == "slide.movedown") {
            def okDown:boolean (editor.moveSlide(1))
            this.syncFromEditor()
            return okDown
        }
        return false
    }

    ; --- keys -----------------------------------------------------------------

    fn editKey:boolean (k:int shift:boolean) {
        ; Nothing here applies while the caret is in a text box. These keys
        ; move, delete and deselect SHAPES, and every one of them means
        ; something else entirely to somebody typing: the arrows move the
        ; caret, Delete takes out a character rather than the box around it.
        ;
        ; The dispatch above already tries `textKey` first, but a guard that
        ; lives only in the caller is a guard one edit away from being gone —
        ; which is exactly what happened.
        if (editor.isEditingText()) {
            return false
        }
        def step:double 1.0
        if shift {
            step = 10.0
        }
        if (k == (UIKey.left())) {
            return (this.nudge((0.0 - step) 0.0))
        }
        if (k == (UIKey.right())) {
            return (this.nudge(step 0.0))
        }
        if (k == (UIKey.up())) {
            return (this.nudge(0.0 (0.0 - step)))
        }
        if (k == (UIKey.down())) {
            return (this.nudge(0.0 step))
        }
        if (k == (UIKey.del())) {
            this.syncEditor()
            return (editor.deleteSelection())
        }
        if (k == (UIKey.backspace())) {
            this.syncEditor()
            return (editor.backspaceText())
        }
        if (k == (UIKey.enter())) {
            this.syncEditor()
            return (editor.appendText("\n"))
        }
        if (k == (UIKey.escape())) {
            editor.clearSelection()
            return true
        }
        return false
    }

    ; Ctrl chords arrive as characters with the modifier held, the same way
    ; the text editor reads them.
    fn editChords:void (text:string) {
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            def ch:int (charAt text i)
            if ((ch == 101) || (ch == 69)) {
                this.runEditCommand("edit.toggle" "")
            }
            if ((ch == 122) || (ch == 90)) {
                this.runEditCommand("edit.undo" "")
            }
            if ((ch == 121) || (ch == 89)) {
                this.runEditCommand("edit.redo" "")
            }
            if ((ch == 97) || (ch == 65)) {
                if (editor.isEditingText()) {
                    editor.selectAllText()
                } {
                    this.runEditCommand("edit.selectall" "")
                }
            }
            if ((ch == 100) || (ch == 68)) {
                this.runEditCommand("edit.duplicate" "")
            }
            if ((ch == 99) || (ch == 67)) {
                this.runEditCommand("edit.copy" "")
            }
            if ((ch == 120) || (ch == 88)) {
                this.runEditCommand("edit.cut" "")
            }
            if ((ch == 118) || (ch == 86)) {
                this.runEditCommand("edit.paste" "")
            }
            if ((ch == 103) || (ch == 71)) {
                this.runEditCommand("edit.group" "")
            }
            if ((ch == 98) || (ch == 66)) {
                this.runEditCommand("edit.bold" "")
            }
            if ((ch == 105) || (ch == 73)) {
                this.runEditCommand("edit.italic" "")
            }
            i = (i + 1)
        }
    }

    ; --- the overlay ----------------------------------------------------------
    ; Selection is chrome, not content: it goes into the same display list as
    ; the slide, after it, so WebGL and SoftCanvas both get it for nothing and
    ; an exported deck has none of it.
    fn paintEditOverlay:void (dl:EVGDisplayList) {
        def slideOpt@(optional):PptxSlide (this.currentSlide())
        if (null? slideOpt) {
            return
        }
        def slide:PptxSlide (unwrap slideOpt)
        def sc:double (this.ptScale())
        def ox:double (this.slideOriginX())
        def oy:double (this.slideOriginY())
        def sw:double (slide.width * sc)
        def sh:double (slide.height * sc)
        def guide:EVGColor (EVGColor.rgb(232 84 120))
        def gi:int 0
        while (gi < (array_length editor.guideX)) {
            def gx:double (((itemAt editor.guideX gi) * sc) + ox)
            dl.addRect(gx oy 1.0 sh guide)
            gi = (gi + 1)
        }
        def gj:int 0
        while (gj < (array_length editor.guideY)) {
            def gy:double (((itemAt editor.guideY gj) * sc) + oy)
            dl.addRect(ox gy sw 1.0 guide)
            gj = (gj + 1)
        }
        ; The grid, when it is on: faint dots at the step things snap to.
        if editor.gridEnabled {
            def step:double (editor.gridPt * sc)
            if (step > 6.0) {
                def dot:EVGColor (EVGColor.rgba(120 130 160 0.5))
                def gx:double 0.0
                while (gx <= sw) {
                    def gy2:double 0.0
                    while (gy2 <= sh) {
                        dl.addRect((ox + gx) (oy + gy2) 1.0 1.0 dot)
                        gy2 = (gy2 + step)
                    }
                    gx = (gx + step)
                }
            }
        }
        ; The rubber band, while one is being dragged — and the box being
        ; placed, which is the same rectangle drawn the same way, because it
        ; means the same thing to the hand holding it.
        if ((dragMode == 3) || (dragMode == 5)) {
            def mx:double marqueeX
            def my:double marqueeY
            def mw:double marqueeW
            def mh:double marqueeH
            if (mw < 0.0) {
                mx = (marqueeX + marqueeW)
                mw = (0.0 - marqueeW)
            }
            if (mh < 0.0) {
                my = (marqueeY + marqueeH)
                mh = (0.0 - marqueeH)
            }
            def bandX:double ((mx * sc) + ox)
            def bandY:double ((my * sc) + oy)
            dl.addRect(bandX bandY (mw * sc) (mh * sc) (EVGColor.rgba(90 140 230 0.15)))
            dl.addFrame(bandX bandY (mw * sc) (mh * sc) 1.0 (EVGColor.rgb(90 140 230)))
        }
        def sel:[PptxShape] (editor.selectedShapes())
        if ((array_length sel) == 0) {
            return
        }
        def thin:EVGColor (EVGColor.rgb(120 160 235))
        def i:int 0
        while (i < (array_length sel)) {
            def s2:PptxShape (itemAt sel i)
            def sx0:double ((s2.x * sc) + ox)
            def sy0:double ((s2.y * sc) + oy)
            def sw2:double (s2.width * sc)
            def sh2:double (s2.height * sc)
            def turned2:boolean false
            if ((s2.rotation > 0.001) || (s2.rotation < -0.001)) {
                turned2 = true
            }
            if turned2 {
                def corners:[double] (PptxView.rotatedCorners(sx0 sy0 sw2 sh2 s2.rotation))
                this.pushQuadOutline(dl corners 1.0 thin)
            } {
                dl.addFrame(sx0 sy0 sw2 sh2 1.0 thin)
            }
            i = (i + 1)
        }
        def b:PptxEditRect (editor.selectionBounds())
        def x0:double ((b.x * sc) + ox)
        def y0:double ((b.y * sc) + oy)
        def x1:double (((b.right()) * sc) + ox)
        def y1:double (((b.bottom()) * sc) + oy)
        def box:EVGColor (EVGColor.rgb(40 90 200))
        def angle:double (this.selectionAngle())
        def turnedSel:boolean false
        if ((angle > 0.001) || (angle < -0.001)) {
            turnedSel = true
        }
        if turnedSel {
            this.pushQuadOutline(dl (this.selectionCorners()) 1.5 box)
        } {
            dl.addFrame(x0 y0 (x1 - x0) (y1 - y0) 1.0 box)
        }
        def white:EVGColor (EVGColor.rgb(255 255 255))
        ; A locked selection shows the box and no handles: there is nothing to
        ; drag, and drawing handles that do nothing is a lie.
        def locked:boolean (editor.selectionLocked())
        if locked {
            def bar:EVGColor (EVGColor.rgb(150 150 160))
            dl.addFrame((x0 - 2.0) (y0 - 2.0) ((x1 - x0) + 4.0) ((y1 - y0) + 4.0) 1.0 bar)
            return
        }
        def hi:int 0
        while (hi < 8) {
            def p:[double] (this.handlePos(hi))
            def hx:double (itemAt p 0)
            def hy:double (itemAt p 1)
            dl.addRect((hx - 4.0) (hy - 4.0) 8.0 8.0 white)
            dl.addFrame((hx - 4.0) (hy - 4.0) 8.0 8.0 1.0 box)
            hi = (hi + 1)
        }
        ; The rotation handle, on its stalk — which leans with the shape.
        def rotP:[double] (this.handlePos(8))
        def topP:[double] (this.handlePos(1))
        def rotX:double (itemAt rotP 0)
        def rotY:double (itemAt rotP 1)
        this.pushLine(dl (itemAt topP 0) (itemAt topP 1) rotX rotY 1.0 box)
        dl.addRect((rotX - 4.0) (rotY - 4.0) 8.0 8.0 white)
        dl.addFrame((rotX - 4.0) (rotY - 4.0) 8.0 8.0 1.0 box)
    }

    ; --- saving ---------------------------------------------------------------

    sfn lastSlash:int (path:string) {
        def i:int ((strlen path) - 1)
        while (i >= 0) {
            def c:int (charAt path i)
            if (c == 47) {
                return i
            }
            if (c == 92) {
                return i
            }
            i = (i - 1)
        }
        return (0 - 1)
    }

    ; Saving keeps the file that was opened: `saveOver` copies every part of
    ; the original package through and rewrites only the slides that were
    ; touched, so the master, the layouts and everything else the model does
    ; not describe survive an edit. A deck that came from nowhere — a browser
    ; that was handed bytes and lost them, or a deck built in memory — is
    ; written from the model instead.
    fn saveDeck:boolean (path:string name:string) {
        if (loaded == false) {
            return false
        }
        def writer (new PptxWriter())
        if (parser.pkg.isOpen) {
            writer.saveOver(presentation parser.pkg path name)
        } {
            writer.save(presentation path name)
        }
        PptxWriter.markSaved(presentation)
        editor.dirty = false
        status = ("saved " + name)
        return true
    }

    ; The same package as bytes, for a host with no file system.
    fn deckBytes:buffer () {
        def writer (new PptxWriter())
        if (loaded == false) {
            return (buffer_alloc 0)
        }
        if (parser.pkg.isOpen) {
            return (writer.toBufferOver(presentation parser.pkg))
        }
        return (writer.toBuffer(presentation))
    }

    fn suggestedName:string () {
        def n:string view.deckName
        if ((strlen n) == 0) {
            return "deck.pptx"
        }
        return n
    }

    fn editStatus:string () {
        if (editMode == false) {
            return ""
        }
        def n:int (editor.selectionCount())
        def out:string "edit"
        if (editor.isEditingText()) {
            out = "typing"
        }
        ; Editing the master is a different place to be standing, and the one
        ; thing worth saying about it is that you are not on a slide.
        if (editor.isEditingSheet()) {
            out = (out + " · master")
        }
        if (n == 1) {
            out = (out + " · 1 selected")
        }
        if (n > 1) {
            out = ((out + " · ") + (to_string n) + " selected")
        }
        if (editor.dirty) {
            out = (out + " · changed")
        }
        return out
    }


    ; --- the caret on screen --------------------------------------------------
    ;
    ; The model says "paragraph 2, column 7"; the window needs a rectangle.
    ; Between them is measurement, which only the host has — the converter
    ; knows where a paragraph starts, the text renderer knows how wide a string
    ; is in the font it will actually be drawn in.

    fn shapeScreenBox:PptxEditRect (sh:PptxShape) {
        def sc:double (this.ptScale())
        def ox:double (this.slideOriginX())
        def oy:double (this.slideOriginY())
        return (PptxEditRect.of(((sh.x * sc) + ox) ((sh.y * sc) + oy) (sh.width * sc) (sh.height * sc)))
    }

    fn lineBoxesFor:[PptxTextLine] (sh:PptxShape) {
        def box:PptxEditRect (this.shapeScreenBox(sh))
        return (this.lineBoxesIn(sh box (this.ptScale())))
    }

    ; The same layout, in a box of the host's choosing at a scale of its own —
    ; which is what lets the notes strip be edited by the same caret as a
    ; shape, without the notes pretending to be on the slide.
    fn lineBoxesIn:[PptxTextLine] (sh:PptxShape box:PptxEditRect scale:double) {
        view.converter.setScale((scale / (96.0 / 72.0)))
        view.converter.slideNumber = (index + 1)
        return (view.converter.lineBoxes(sh box.x box.y box.w box.h))
    }

    ; Where a column sits on a line, measured through the same object the
    ; painter measured with — so the caret is where the glyphs are, on the
    ; second line of a wrapped paragraph as much as on the first.
    fn caretXOnLine:double (sh:PptxShape line:PptxTextLine col:int) {
        return (this.caretXOnLineAt(sh line col (this.ptScale())))
    }

    ; The `scale` here is the host's, and it is NOT the one the slice is
    ; measured at: the line carries the scale it was actually laid out and
    ; drawn at, which is smaller whenever the body's face was substituted and
    ; shrunk to fit. Measuring at the host's scale put the caret to the right
    ; of the glyphs, further with every column along the line.
    fn caretXOnLineAt:double (sh:PptxShape line:PptxTextLine col:int scale:double) {
        def body:PptxTextBody sh.text
        if (line.para >= (array_length body.paragraphs)) {
            return line.x
        }
        def para:PptxParagraph (itemAt body.paragraphs line.para)
        def at:int col
        if (at < line.startCol) {
            at = line.startCol
        }
        if (at > line.endCol) {
            at = line.endCol
        }
        def drawn:double line.scale
        if (drawn <= 0.0) {
            drawn = scale
        }
        return (line.x + (PptxTextLayout.measureSlice(para line.startCol at view.converter.measure drawn)))
    }

    fn caretRect:PptxEditRect (sh:PptxShape pos:PptxTextPos) {
        if (editor.isEditingNotes()) {
            return (this.caretRectIn(sh pos (this.notesTextRect()) (this.notesScale())))
        }
        return (this.caretRectIn(sh pos (this.shapeScreenBox(sh)) (this.ptScale())))
    }

    fn caretRectIn:PptxEditRect (sh:PptxShape pos:PptxTextPos box:PptxEditRect scale:double) {
        def lines:[PptxTextLine] (this.lineBoxesIn(sh box scale))
        if ((array_length lines) == 0) {
            def fallback:PptxEditRect (this.shapeScreenBox(sh))
            return (PptxEditRect.of(fallback.x fallback.y 2.0 (fallback.h * 0.5)))
        }
        def idx:int (PptxTextLayout.lineIndexFor(lines pos.para pos.col))
        if (idx < 0) {
            idx = 0
        }
        def line:PptxTextLine (itemAt lines idx)
        def x:double (this.caretXOnLineAt(sh line pos.col scale))
        return (PptxEditRect.of(x line.y 2.0 line.h))
    }

    ; The inverse: a click lands on a line, and then on the column whose edge
    ; is nearest to it.
    fn caretFromPoint:PptxTextPos (sh:PptxShape px:int py:int) {
        return (this.caretFromPointIn(sh px py (this.shapeScreenBox(sh)) (this.ptScale())))
    }

    fn caretFromPointIn:PptxTextPos (sh:PptxShape px:int py:int box:PptxEditRect scale:double) {
        def out:PptxTextPos (PptxTextPos.of(0 0))
        def lines:[PptxTextLine] (this.lineBoxesIn(sh box scale))
        if ((array_length lines) == 0) {
            return out
        }
        def idx:int (PptxTextLayout.lineAtY(lines (to_double py)))
        if (idx < 0) {
            idx = 0
        }
        def line:PptxTextLine (itemAt lines idx)
        def fx:double (to_double px)
        def best:int line.startCol
        def bestDist:double 1000000.0
        def col:int line.startCol
        while (col <= line.endCol) {
            def cx:double (this.caretXOnLineAt(sh line col scale))
            def d:double (fabs (cx - fx))
            if (d < bestDist) {
                bestDist = d
                best = col
            }
            col = (col + 1)
        }
        out.para = line.para
        out.col = best
        return out
    }

    ; --- typing ---------------------------------------------------------------

    ; Click a shape to pick it up, click it again to type in it — with the
    ; caret where the click landed, not at the start, because a person who
    ; clicked the middle of a word meant the middle of that word. A double
    ; click reaches the same place: its second release is a click on a shape
    ; that the first one already selected.
    fn startTextEditAt:boolean (px:int py:int) {
        if ((this.startTextEdit()) == false) {
            return false
        }
        def sel@(optional):PptxShape (editor.firstSelected())
        if (null? sel) {
            return true
        }
        def sh:PptxShape (unwrap sel)
        def at:PptxTextPos (this.caretFromPoint(sh px py))
        editor.setCaretPos(at.para at.col false)
        return true
    }

    fn startTextEdit:boolean () {
        if ((editor.selectionCount()) != 1) {
            return false
        }
        def sel@(optional):PptxShape (editor.firstSelected())
        if (null? sel) {
            return false
        }
        def sh:PptxShape (unwrap sel)
        return (editor.beginTextEdit(sh.editId))
    }

    fn textKey:boolean (k:int shift:boolean) {
        if ((editor.isEditingText()) == false) {
            return false
        }
        if (k == (UIKey.left())) {
            return (editor.moveCaretBy("left" shift))
        }
        if (k == (UIKey.right())) {
            return (editor.moveCaretBy("right" shift))
        }
        if (k == (UIKey.up())) {
            return (editor.moveCaretBy("up" shift))
        }
        if (k == (UIKey.down())) {
            return (editor.moveCaretBy("down" shift))
        }
        if (k == (UIKey.home())) {
            return (editor.moveCaretBy("home" shift))
        }
        if (k == (UIKey.end())) {
            return (editor.moveCaretBy("end" shift))
        }
        if (k == (UIKey.backspace())) {
            return (editor.backspaceAtCaret())
        }
        if (k == (UIKey.del())) {
            return (editor.deleteAtCaret())
        }
        ; A newline goes where the caret is, not at the end of the box. It
        ; used to fall through to `appendText`, so pressing Enter in the
        ; middle of a paragraph put the break after the last word instead.
        ;
        ; And in a list Enter is a decision rather than an insertion — on an
        ; item with nothing in it, it steps out of the list instead of adding
        ; another empty bullet. `enterAtCaret` is where that is decided; it
        ; types the newline itself in every other case.
        ;
        ; There was a second, identical `if` under this one calling
        ; `newlineAtCaret`. It could never run, and it was the branch anyone
        ; reading this would have assumed was the live one.
        if (k == (UIKey.enter())) {
            return (editor.enterAtCaret())
        }
        if (k == (UIKey.escape())) {
            editor.endTextEdit()
            return true
        }
        return false
    }

    ; The caret and what it has selected, drawn into the same list as the
    ; slide — a highlight per paragraph the selection touches, then the caret
    ; on top of it.
    fn paintCaret:void (dl:EVGDisplayList) {
        if ((editor.isEditingText()) == false) {
            return
        }
        def hit@(optional):PptxShape (editor.editingShape())
        if (null? hit) {
            return
        }
        def sh:PptxShape (unwrap hit)
        def caretBox:PptxEditRect (this.shapeScreenBox(sh))
        def caretScale:double (this.ptScale())
        if (editor.isEditingNotes()) {
            caretBox = (this.notesTextRect())
            caretScale = (this.notesScale())
        }
        def lines:[PptxTextLine] (this.lineBoxesIn(sh caretBox caretScale))
        if ((editor.textSelectionEmpty()) == false) {
            def a:PptxTextPos editor.anchor
            def b:PptxTextPos editor.caret
            def start:PptxTextPos a
            def end:PptxTextPos b
            if ((PptxTextEdit.cmp(a b)) > 0) {
                start = b
                end = a
            }
            def wash:EVGColor (EVGColor.rgba(90 140 230 0.28))
            ; A highlight per LINE the selection touches, not per paragraph —
            ; a wrapped paragraph is several lines and the selection stops
            ; where each of them does.
            def i:int 0
            while (i < (array_length lines)) {
                def line:PptxTextLine (itemAt lines i)
                def covered:boolean true
                if (line.para < start.para) {
                    covered = false
                }
                if (line.para > end.para) {
                    covered = false
                }
                if (line.para == start.para) {
                    if (line.endCol < start.col) {
                        covered = false
                    }
                }
                if (line.para == end.para) {
                    if (line.startCol > end.col) {
                        covered = false
                    }
                }
                if covered {
                    def from:int line.startCol
                    def to:int line.endCol
                    if (line.para == start.para) {
                        if (start.col > from) {
                            from = start.col
                        }
                    }
                    if (line.para == end.para) {
                        if (end.col < to) {
                            to = end.col
                        }
                    }
                    def x0:double (this.caretXOnLineAt(sh line from caretScale))
                    def x1:double (this.caretXOnLineAt(sh line to caretScale))
                    def wsel:double (x1 - x0)
                    if (wsel < 2.0) {
                        wsel = 2.0
                    }
                    dl.addRect(x0 line.y wsel line.h wash)
                }
                i = (i + 1)
            }
        }
        def r:PptxEditRect (this.caretRect(sh editor.caret))
        dl.addRect(r.x r.y r.w r.h (EVGColor.rgb(20 30 60)))
    }

    ; --- the slide panel ------------------------------------------------------
    ;
    ; A strip of the slides down the left, and each of them is the SAME scene
    ; the viewer paints, at a small scale — no second renderer, no cache to go
    ; stale, no idea of what a slide looks like that can drift from the real
    ; one. A thumbnail is the slide's own display list scaled and moved, which
    ; both backends draw without being told what a thumbnail is.
    ;
    ; Only the ones on screen are built. That is also what E7 means by
    ; virtualizing it: the rule is already here, the deck is just never long
    ; enough yet to notice.

    ; The deck runs along ONE axis, and which axis is the only difference
    ; between the column a desktop shows and the strip a phone does. Every
    ; measurement below is stated as "along the deck" or "across it", so the
    ; painter, the hit test, the scroll and the drag do not each need to know.
    fn panelOnTop:boolean () {
        if (panelVisible == false) {
            return false
        }
        return (panelH > 0)
    }

    ; What the panel takes out of the WIDTH — zero when it is a strip on top.
    fn panelWidth:int () {
        if (panelVisible == false) {
            return 0
        }
        if (panelH > 0) {
            return 0
        }
        return panelW
    }

    ; …and out of the HEIGHT, which is zero when it is a column on the side.
    fn panelHeight:int () {
        if (panelVisible == false) {
            return 0
        }
        if (panelH > 0) {
            return panelH
        }
        return 0
    }

    fn panelThumbW:int () {
        if (this.panelOnTop()) {
            ; Across the strip the height is given and the width follows the
            ; slide's own shape, which is the opposite of the column.
            def h:double (to_double (this.panelThumbH()))
            def sw:double (this.slideW())
            def sh:double (this.slideH())
            if (sh <= 0.0) {
                return 80
            }
            return (to_int ((h * sw) / sh))
        }
        return ((this.panelWidth()) - 34)
    }

    fn panelThumbH:int () {
        if (this.panelOnTop()) {
            ; Room for the slide number under it and the selection frame
            ; around it.
            def h:int (panelH - 26)
            if (h < 24) {
                h = 24
            }
            return h
        }
        def w:double (to_double (this.panelThumbW()))
        def sw:double (this.slideW())
        def sh:double (this.slideH())
        if (sw <= 0.0) {
            return 60
        }
        return (to_int ((w * sh) / sw))
    }

    ; The pitch from one thumbnail to the next, ALONG the deck.
    fn panelStep:int () {
        if (this.panelOnTop()) {
            return ((this.panelThumbW()) + 12)
        }
        return ((this.panelThumbH()) + 12)
    }

    ; Where the first thumbnail starts along the deck. The column leaves room
    ; above it for a section name; the strip leaves room in front of it for
    ; the same reason.
    fn panelStart:int () {
        if (this.panelOnTop()) {
            return 26
        }
        return (toolbarH + 20)
    }

    ; …and where the deck sits ACROSS its own axis.
    fn panelCross:int () {
        if (this.panelOnTop()) {
            return (toolbarH + 6)
        }
        return 26
    }

    fn panelThumbX:int () {
        return (this.panelCross())
    }

    ; Kept for the column, which is what everything that asks by name means.
    fn panelTop:int () {
        return (this.panelStart())
    }

    fn panelThumbXAt:int (i:int) {
        if (this.panelOnTop()) {
            return (((this.panelStart()) + (i * (this.panelStep()))) - panelScroll)
        }
        return (this.panelCross())
    }

    fn panelThumbYAt:int (i:int) {
        if (this.panelOnTop()) {
            return (this.panelCross())
        }
        return (((this.panelStart()) + (i * (this.panelStep()))) - panelScroll)
    }

    fn panelThumbY:int (i:int) {
        return (this.panelThumbYAt(i))
    }

    ; The pointer's position along the deck.
    fn panelAlong:int (px:int py:int) {
        if (this.panelOnTop()) {
            return px
        }
        return py
    }

    ; The band the panel occupies, whichever way round it is.
    fn panelInBand:boolean (px:int py:int) {
        if (panelVisible == false) {
            return false
        }
        if (py < toolbarH) {
            return false
        }
        if (py >= (H - statusH)) {
            return false
        }
        if (this.panelOnTop()) {
            return (py < (toolbarH + panelH))
        }
        return (px < (this.panelWidth()))
    }

    fn panelSlideAt:int (px:int py:int) {
        if ((this.panelInBand(px py)) == false) {
            return (0 - 1)
        }
        def along:int (this.panelAlong(px py))
        def extent:int (this.panelThumbH())
        if (this.panelOnTop()) {
            extent = (this.panelThumbW())
        }
        def n:int (this.slideCount())
        def i:int 0
        while (i < n) {
            def at:int (((this.panelStart()) + (i * (this.panelStep()))) - panelScroll)
            if (along >= at) {
                if (along < (at + extent)) {
                    return i
                }
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; Where a drag would drop the slide it is carrying: between two thumbnails
    ; rather than on one, which is the difference between reordering and
    ; replacing.
    fn panelDropIndex:int (along:int) {
        def n:int (this.slideCount())
        def step:int (this.panelStep())
        def top:int ((this.panelStart()) - panelScroll)
        def rel:int (along - top)
        if (rel < 0) {
            return 0
        }
        def idx:int (idiv (rel + (idiv step 2)) step)
        if (idx < 0) {
            idx = 0
        }
        if (idx > n) {
            idx = n
        }
        return idx
    }

    ; How far down the panel can go before it runs out of thumbnails.
    fn panelMaxScroll:int () {
        def total:int ((this.slideCount()) * (this.panelStep()))
        def visible:int ((H - toolbarH) - statusH)
        if (this.panelOnTop()) {
            visible = W
        }
        def maxScroll:int (total - visible)
        if (maxScroll < 0) {
            return 0
        }
        return maxScroll
    }

    ; Bring the panel back inside what there is to show.
    ;
    ; This is called before the panel is PAINTED rather than only when it is
    ; scrolled, and that is the whole point of it. `panelScroll` outlives the
    ; deck: open a long deck, scroll to the end of it, open a short one, and
    ; the offset from the long deck is still there — the new deck's thumbnails
    ; are laid out two thousand pixels above the top of the panel, and the
    ; panel comes up EMPTY. It reads as thumbnails that failed to be made,
    ; which is what makes it so hard to place: nothing is wrong with the
    ; thumbnails or with the cache that holds them.
    ;
    ; Clamping where the panel is drawn rather than where it is scrolled
    ; covers every way the deck can get shorter under a scrolled panel —
    ; opening another deck, deleting slides, undoing an insert, or a window
    ; that just got taller — instead of one of them.
    fn clampPanelScroll:void () {
        def maxScroll:int (this.panelMaxScroll())
        if (panelScroll > maxScroll) {
            panelScroll = maxScroll
        }
        if (panelScroll < 0) {
            panelScroll = 0
        }
    }

    ; The slide the panel last scrolled itself to show. -1 means "never".
    ;
    ; The panel has to follow the SELECTION, and it was following only one of
    ; the ways the selection moves: `gotoSlide` asked it to, and `nextSlide`
    ; and `prevSlide` — the arrow keys and the buttons on the strip —
    ; did not. Twenty slides in, the panel was still showing the first seven.
    ;
    ; Recording what it last followed, and checking that where the panel is
    ; PAINTED, covers every way the index can change instead of the three
    ; that existed when this was written. It also leaves a reader who scrolls
    ; the panel by hand alone, which calling it on every frame would not:
    ; scrolling does not change the index, so nothing pulls the panel back.
    def panelFollowedIndex:int -1

    fn followSelectionInPanel:void () {
        if (panelFollowedIndex == index) {
            return
        }
        panelFollowedIndex = index
        this.ensureSlideVisible()
    }

    ; A wheel or a swipe over the panel, in PIXELS of travel, positive
    ; downwards — the same unit the gesture arrives in.
    ;
    ; It used to take notches and multiply by 40, and the web host sent one
    ; notch per wheel EVENT. A mouse fires one event per notch, so that was
    ; right for a mouse and wrong by a factor of thirty for a trackpad: one
    ; two-finger swipe is dozens of small events, each of which became a full
    ; 40-pixel notch. A hundred slides went past in one flick.
    fn scrollPanelPixels:void (dy:int) {
        panelScroll = (panelScroll + dy)
        this.clampPanelScroll()
    }

    ; The same, in wheel notches, for hosts that speak notches.
    ; One catalogue outline as a slide shape.
    ;
    ; The path arrives in the 0..1 box and `pathUnit` wants the same, so the
    ; only work here is keeping the contours apart: `flattenRingsPlain` gives
    ; them as rings and `pathEnds` is where each one stops.
    fn insertOutline:int (entry:ShapeEntry x:double y:double w:double h:double) {
        def parser (new SVGPathParser())
        parser.parse(entry.pathData)
        def rings:[PathRing] (parser.flattenRingsPlain(16))
        def pts:[double]
        def ends:[int]
        def i:int 0
        while (i < (array_length rings)) {
            def ring:PathRing (itemAt rings i)
            if ((array_length ring.pts) >= 6) {
                def k:int 0
                while (k < (array_length ring.pts)) {
                    push pts (itemAt ring.pts k)
                    k = (k + 1)
                }
                push ends (array_length pts)
            }
            i = (i + 1)
        }
        if ((array_length pts) < 6) {
            return 0
        }
        ; One ring needs no boundaries, and leaving them off keeps the shape
        ; identical to everything that existed before `pathEnds` did.
        def only:[int]
        if ((array_length ends) > 1) {
            only = ends
        }
        return (editor.addPathShapeAt(pts only x y w h))
    }

    ; A shape was chosen. Everything above this line is shared with the book
    ; editor; this is the line that is not, and it is one line: the deck stores
    ; the preset NAME for PowerPoint to draw.
    fn pickerPointer:boolean (px:int py:int pressed:boolean) {
        if (pressed == false) {
            return false
        }
        if ((picker.isOpen()) == false) {
            return false
        }
        if ((picker.press(px py)) == false) {
            return false
        }
        if (picker.hasChoice()) {
            def id:string (picker.take())
            this.runCommand("shape.insert" id)
        }
        return true
    }

    fn scrollPanel:void (delta:int) {
        ; While the browser is up it is the thing being read.
        if (picker.wheel(delta)) {
            return
        }
        this.scrollPanelPixels((0 - (delta * 40)))
    }

    fn ensureSlideVisible:void () {
        if (panelVisible == false) {
            return
        }
        def at:int (((this.panelStart()) + (index * (this.panelStep()))) - panelScroll)
        def near:int toolbarH
        def far:int (H - statusH)
        def extent:int (this.panelThumbH())
        if (this.panelOnTop()) {
            near = 0
            far = W
            extent = (this.panelThumbW())
        }
        if (at < near) {
            panelScroll = (panelScroll - (near - at))
        }
        if ((at + extent) > far) {
            panelScroll = (panelScroll + (((at + extent) - far) + 10))
        }
        if (panelScroll < 0) {
            panelScroll = 0
        }
    }

    fn panelPointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        if (panelVisible == false) {
            return false
        }
        if pressed {
            ; The panel is only its own band: a press above it belongs to the
            ; strip, and swallowing that makes the toolbar dead.
            if ((this.panelInBand(px py)) == false) {
                return false
            }
            def hit:int (this.panelSlideAt(px py))
            if (hit >= 0) {
                this.gotoSlide(hit)
                panelDrag = hit
                panelDropAt = hit
                return true
            }
            return true
        }
        if (panelDrag >= 0) {
            if down {
                panelDropAt = (this.panelDropIndex((this.panelAlong(px py))))
                return true
            }
        }
        if released {
            if (panelDrag >= 0) {
                def target:int panelDropAt
                if (target > panelDrag) {
                    target = (target - 1)
                }
                if (target != panelDrag) {
                    this.syncEditor()
                    editor.moveSlideTo(target)
                    this.syncFromEditor()
                }
                panelDrag = (0 - 1)
                panelDropAt = (0 - 1)
                return true
            }
        }
        return false
    }

    ; How many thumbnails the last frame actually built. The panel only builds
    ; the ones on screen — that is what E7 means by virtualizing it — and this
    ; is the number that proves it, since a deck ten times longer must not cost
    ; ten times more to draw.
    fn panelBuiltLastFrame:int () {
        return panelBuilt
    }

    fn panelKeptLastFrame:int () {
        return thumbKept
    }

    ; The thumbnail for this slide, at this place and this width — from the
    ; cache when the slide has not changed and has not moved, and built when it
    ; has. A slide with no key (a deck never attached to the editor) is never
    ; cached, because there is nothing to key it by.
    fn thumbnailFor:EVGDisplayList (slide:PptxSlide i:int tx:int ty:int tw:int) {
        def key:int slide.key
        if (key > 0) {
            def rev@(optional):int (get thumbRev key)
            if (!null? rev) {
                if ((unwrap rev) == slide.revision) {
                    if ((PptxApp.intAt(thumbX key) == tx) && (PptxApp.intAt(thumbY key) == ty)) {
                        if (PptxApp.intAt(thumbW key) == tw) {
                            def hit@(optional):EVGDisplayList (get thumbList key)
                            if (!null? hit) {
                                thumbKept = (thumbKept + 1)
                                return (unwrap hit)
                            }
                        }
                    }
                }
            }
        }
        def scale:double ((to_double tw) / (slide.width * (96.0 / 72.0)))
        view.converter.setScale(scale)
        view.converter.slideNumber = (i + 1)
        def sub:EVGDisplayList (view.converter.slideToDisplayList(slide))
        panelBuilt = (panelBuilt + 1)
        PptxApp.offsetList(sub tx ty)
        if (key > 0) {
            ; Bounded rather than clever: a deck scrolled end to end would
            ; otherwise keep a picture of every slide it passed.
            if (thumbCount > 64) {
                thumbCount = 0
                def r2:[int:int]
                thumbRev = r2
                def x2:[int:int]
                thumbX = x2
                def y2:[int:int]
                thumbY = y2
                def w2:[int:int]
                thumbW = w2
                def l2:[int:EVGDisplayList]
                thumbList = l2
            }
            def known@(optional):int (get thumbRev key)
            if (null? known) {
                thumbCount = (thumbCount + 1)
            }
            set thumbRev key slide.revision
            set thumbX key tx
            set thumbY key ty
            set thumbW key tw
            set thumbList key sub
        }
        return sub
    }

    ; The panel follows the current slide and stays inside its own bounds.
    ; Called once a frame from `buildFrame`, whether or not the panel is being
    ; painted into it — see `framePanel`.
    fn settlePanelScroll:void () {
        if (panelVisible == false) {
            return
        }
        this.followSelectionInPanel()
        this.clampPanelScroll()
    }

    ; The frame WITHOUT the thumbnails, for a host that draws them separately.
    fn buildSceneFrame:EVGDisplayList () {
        def was:boolean framePanel
        framePanel = false
        def out:EVGDisplayList (this.buildFrame())
        framePanel = was
        return out
    }

    ; …and the thumbnails on their own, in the same window coordinates, so a
    ; host draws this list and then that one and gets the frame back.
    fn buildPanelFrame:EVGDisplayList () {
        def out:EVGDisplayList (new EVGDisplayList)
        if presenting {
            return out
        }
        this.settlePanelScroll()
        this.paintPanel(out)
        return out
    }

    ; What the panel would draw, as a short string. Same string, same picture:
    ; a host keeps the last list it decoded while this does not change, which
    ; is what takes the thumbnails out of the per-frame cost entirely.
    ;
    ; Everything the panel's appearance depends on is in here — where it is
    ; and how big, how far it has scrolled, which slide is ringed, where a
    ; dragged slide would land — and then each slide's identity and revision,
    ; which is exactly what the thumbnail cache is keyed by. A slide edited on
    ; another page of the deck changes its revision, so its thumbnail is
    ; rebuilt; nothing else is.
    fn panelStamp:string () {
        if (panelVisible == false) {
            return "off"
        }
        def out:string (((to_string W) + "x") + ((to_string H) + ":"))
        out = (out + ((to_string toolbarH) + "/") + ((to_string statusH) + "/") + ((to_string panelH) + "/") + ((to_string panelW) + ":"))
        out = (out + ((to_string panelScroll) + "@") + ((to_string index) + ":"))
        out = (out + ((to_string panelDrag) + ">") + ((to_string panelDropAt) + ";"))
        def n:int (this.slideCount())
        ; A .odp's pages are not in `presentation.slides` — that array is
        ; EMPTY while one is open, which is exactly the trap `thumbnailAt`
        ; was added for. Those thumbnails are cached by width alone, since a
        ; .odp is read-only here, so the page count and the panel's geometry
        ; are the whole of what can change about them.
        if isOdp {
            return (out + ((to_string n) + "odp"))
        }
        def i:int 0
        while (i < n) {
            if (i < (array_length presentation.slides)) {
                def sl:PptxSlide (itemAt presentation.slides i)
                out = (out + ((to_string sl.key) + ".") + ((to_string sl.revision) + ","))
            }
            i = (i + 1)
        }
        return out
    }

    ; A thumbnail for slide `i`, from whichever reader owns the document.
    ;
    ; This used to be `itemAt presentation.slides i` written inline in the
    ; panel, and with a .odp open that indexes an EMPTY array. It did not
    ; crash in the browser test, which is the part worth writing down: the
    ; .odp fixture has exactly as many pages as the .pptx it was converted
    ; from, so every index was still in range and the panel quietly drew the
    ; PREVIOUS document's thumbnails beside the new one's slide. A screenshot
    ; found it; 113 passing assertions did not.
    fn thumbnailAt:EVGDisplayList (i:int tx:int ty:int tw:int) {
        if isOdp {
            return (this.odpThumbnailFor(i tx ty tw))
        }
        if (i < 0) {
            return (new EVGDisplayList)
        }
        if (i >= (array_length presentation.slides)) {
            return (new EVGDisplayList)
        }
        def slide:PptxSlide (itemAt presentation.slides i)
        return (this.thumbnailFor(slide i tx ty tw))
    }

    ; The .odp panel's own cache. The deck's is keyed by a slide's revision
    ; because a slide can be edited; a .odp is read-only here, so the only
    ; thing that can invalidate one of these is the thumbnail changing width.
    fn odpThumbnailFor:EVGDisplayList (i:int tx:int ty:int tw:int) {
        if (odpThumbW != tw) {
            def fresh:[int:EVGDisplayList]
            odpThumbs = fresh
            odpThumbW = tw
        }
        ; What is cached is the page at the origin. Where it goes on screen
        ; changes as the panel scrolls, so the copy handed back is the one
        ; that gets moved — caching a positioned list would put every
        ; thumbnail where the first frame happened to want it.
        if ((has odpThumbs i) == false) {
            def scale:double ((to_double tw) / (odpDoc.widthPt * (96.0 / 72.0)))
            odpConv.setScale(scale)
            odpConv.measure.attach(view.ctx view.fontFamily)
            set odpThumbs i (odpConv.pageToDisplayList(odpDoc i))
        }
        def cached:EVGDisplayList (unwrap (get odpThumbs i))
        def out (new EVGDisplayList)
        PptxApp.appendList(out cached)
        PptxApp.offsetList(out tx ty)
        return out
    }

    fn paintPanel:void (dl:EVGDisplayList) {
        panelBuilt = 0
        thumbKept = 0
        if (panelVisible == false) {
            return
        }
        def onTop:boolean (this.panelOnTop())
        def bandBg:EVGColor (EVGColor.rgb(32 36 47))
        def top:double (to_double toolbarH)
        if onTop {
            dl.addRect(0.0 top (to_double W) (to_double panelH) bandBg)
            dl.addRect(0.0 (to_double ((toolbarH + panelH) - 1)) (to_double W) 1.0 theme.line)
        } {
            def w:int (this.panelWidth())
            def height:double (to_double (((H - toolbarH) - statusH) - (this.notesHeight())))
            dl.addRect(0.0 top (to_double w) height bandBg)
            dl.addRect((to_double (w - 1)) top 1.0 height theme.line)
        }
        def n:int (this.slideCount())
        def tw:int (this.panelThumbW())
        def th:int (this.panelThumbH())
        def i:int 0
        while (i < n) {
            def tx:int (this.panelThumbXAt(i))
            def ty:int (this.panelThumbYAt(i))
            ; Only what is on screen is built — a hundred-slide deck must not
            ; cost a hundred display lists to show a dozen thumbnails.
            def visible:boolean true
            if onTop {
                if ((tx + tw) < 0) {
                    visible = false
                }
                if (tx > W) {
                    visible = false
                }
            } {
                if ((ty + th) < toolbarH) {
                    visible = false
                }
                if (ty > (H - statusH)) {
                    visible = false
                }
            }
            if visible {
                dl.addRect((to_double tx) (to_double ty) (to_double tw) (to_double th) (EVGColor.rgb(255 255 255)))
                def sub:EVGDisplayList (this.thumbnailAt(i tx ty tw))
                dl.addClip((to_double tx) (to_double ty) (to_double tw) (to_double th))
                PptxApp.appendList(dl sub)
                dl.addClipEnd()
                def border:EVGColor theme.line
                if (i == index) {
                    border = (EVGColor.rgb(90 140 230))
                    dl.addFrame((to_double (tx - 2)) (to_double (ty - 2)) (to_double (tw + 4)) (to_double (th + 4)) 2.0 border)
                } {
                    dl.addFrame((to_double tx) (to_double ty) (to_double tw) (to_double th) 1.0 border)
                }
                ; The number: beside a column's thumbnail, under a strip's,
                ; because a strip has no room to its left.
                if onTop {
                    toolbarView.pushText(dl (to_string (i + 1)) (to_double tx) (to_double ((ty + th) + 3)) 11.0 theme.dim)
                } {
                    toolbarView.pushText(dl (to_string (i + 1)) 6.0 (to_double (ty + 4)) 11.0 theme.dim)
                }
                ; A section names the run of slides that starts here, so it is
                ; written once, above the first of them.
                def sec:int (editor.sectionOfSlide(i))
                if (sec >= 0) {
                    def prev:int (0 - 1)
                    if (i > 0) {
                        prev = (editor.sectionOfSlide((i - 1)))
                    }
                    if (sec != prev) {
                        ; A section name is the deck's text, not ours. There
                        ; is no room above a strip's thumbnails, so a strip
                        ; does not write them — a name drawn over the toolbar
                        ; is worse than one not drawn.
                        if (onTop == false) {
                            def secName:string (editor.sectionNameAt(sec))
                            toolbarView.pushText(dl (OfficeText.forDisplay(secName)) (to_double tx) (to_double (ty - 13)) 11.0 (EVGColor.rgb(150 170 210)))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        ; Where a dragged slide would land.
        if (panelDrag >= 0) {
            if (panelDropAt >= 0) {
                def drop:int ((((this.panelStart()) + (panelDropAt * (this.panelStep()))) - panelScroll) - 4)
                def mark:EVGColor (EVGColor.rgb(232 84 120))
                if onTop {
                    dl.addRect((to_double drop) (to_double (this.panelCross())) 2.0 (to_double th) mark)
                } {
                    dl.addRect((to_double (this.panelCross())) (to_double drop) (to_double tw) 2.0 mark)
                }
            }
        }
    }


    ; --- the notes strip ------------------------------------------------------
    ;
    ; The speaker's notes, under the slide, edited by the same caret that edits
    ; a shape — because they ARE a shape, one that is not on the slide. The
    ; strip is just the box that shape is laid out in.

    ; What the properties panel takes out of the WIDTH. Zero when it is off,
    ; and zero on a narrow window — the same call the slide panel makes, and
    ; for the same reason: a column spends width, and width is what a phone
    ; has least of.
    fn propsWidth:int () {
        if (propsVisible == false) {
            return 0
        }
        if (W < 820) {
            return 0
        }
        return propsW
    }

    ; The band itself: below the strip, above the status line, hard right.
    fn propsRect:PptxEditRect () {
        def w:double (to_double (this.propsWidth()))
        def y:double (to_double toolbarH)
        def h:double (to_double ((H - toolbarH) - statusH))
        return (PptxEditRect.of(((to_double W) - w) y w h))
    }

    fn notesHeight:int () {
        if (notesVisible == false) {
            return 0
        }
        return notesH
    }

    fn notesScale:double () {
        ; Readable at any zoom: the notes are not part of the picture, so they
        ; do not shrink with it.
        return 1.0
    }

    fn notesRect:PptxEditRect () {
        def x:double (to_double (this.panelWidth()))
        def h:double (to_double (this.notesHeight()))
        def y:double (to_double ((H - statusH) - (this.notesHeight())))
        ; …and stops where the properties panel starts, or the notes are drawn
        ; underneath it and the text runs on out of sight.
        def w:double ((((to_double W) - x) - (to_double (this.propsWidth()))))
        return (PptxEditRect.of(x y w h))
    }

    fn notesTextRect:PptxEditRect () {
        def r:PptxEditRect (this.notesRect())
        return (PptxEditRect.of((r.x + 10.0) (r.y + 20.0) (r.w - 20.0) (r.h - 26.0)))
    }

    fn notesPointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        if (notesVisible == false) {
            return false
        }
        def r:PptxEditRect (this.notesRect())
        def fx:double (to_double px)
        def fy:double (to_double py)
        if (fy < r.y) {
            return false
        }
        if (fy >= (r.y + r.h)) {
            return false
        }
        if (fx < r.x) {
            return false
        }
        if pressed {
            this.syncEditor()
            if ((editor.isEditingNotes()) == false) {
                editor.editNotes()
            }
            def hit@(optional):PptxShape (editor.notesShape())
            if (!null? hit) {
                def sh:PptxShape (unwrap hit)
                def at:PptxTextPos (this.caretFromPointIn(sh px py (this.notesTextRect()) (this.notesScale())))
                editor.setCaretPos(at.para at.col modShift)
            }
            return true
        }
        return true
    }

    ; --- the properties panel --------------------------------------------------
    ;
    ; Fill, outline, outline width and text colour, down the right-hand side,
    ; each row SHOWING what the selection is set to as well as offering to
    ; change it. Reading a value used to be impossible: `edit.fill` took a hex
    ; string and answered nothing, so the only way to find out what a shape
    ; was filled with was to look at it and guess.
    ;
    ; The swatches are the DECK's own theme colours, not a fixed palette. A
    ; deck's accents are the colours its author meant to be used, and a
    ; chooser offering a generic rainbow beside them is a chooser that makes
    ; every slide look like it was edited by two different people.
    fn paintProps:void (dl:EVGDisplayList) {
        clear propHitX
        clear propHitY
        clear propHitW
        clear propHitH
        clear propHitCmd
        clear propHitArg
        if ((this.propsWidth()) == 0) {
            return
        }
        def r:PptxEditRect (this.propsRect())
        dl.addRect(r.x r.y r.w r.h (EVGColor.rgb(32 36 47)))
        dl.addRect(r.x r.y 1.0 r.h theme.line)
        def x:double (r.x + 12.0)
        def y:double (r.y + 10.0)
        def inner:double (r.w - 24.0)

        ; Nothing selected is worth saying out loud. A panel of dead controls
        ; reads as a broken panel; a panel that says why is a panel.
        if ((editor.selectionCount()) == 0) {
            toolbarView.pushText(dl "Nothing selected" x (y + 4.0) 12.0 theme.dim)
            toolbarView.pushText(dl "Click a shape to change" x (y + 24.0) 11.0 (EVGColor.rgb(110 118 134)))
            toolbarView.pushText(dl "how it looks." x (y + 38.0) 11.0 (EVGColor.rgb(110 118 134)))
            return
        }

        def hit@(optional):PptxShape (editor.firstSelected())
        def fillHex:string ""
        def lineHex:string ""
        def widthPt:double 0.0
        if (!null? hit) {
            def sh:PptxShape (unwrap hit)
            if sh.fill.isSet {
                fillHex = sh.fill.srgb
            }
            if sh.line.isSet {
                lineHex = sh.line.srgb
            }
            widthPt = sh.lineWidthPt
        }

        y = (this.propsSwatchRow(dl "Fill" x y inner fillHex "edit.fill"))
        y = (y + 8.0)
        y = (this.propsSwatchRow(dl "Line" x y inner lineHex "edit.line"))
        y = (y + 8.0)
        y = (this.propsWidthRow(dl x y inner widthPt))
        y = (y + 8.0)
        y = (this.propsSwatchRow(dl "Text" x y inner (editor.selectionColorHex()) "edit.textcolor"))
    }

    ; One labelled row: the name, the current colour beside it, and the
    ; swatches under it. Answers the y the next row starts at.
    fn propsSwatchRow:double (dl:EVGDisplayList label:string x:double y:double w:double now:string cmd:string) {
        toolbarView.pushText(dl label x y 11.0 theme.dim)
        ; The current value, right of the label. This is the half of the panel
        ; that was missing entirely: a control that only SETS leaves a reader
        ; guessing what is set.
        def cw:double 34.0
        def cx:double ((x + w) - cw)
        if ((strlen now) > 0) {
            dl.addRect(cx (y - 2.0) cw 14.0 (PptxApp.hexColor(now)))
            dl.addFrame(cx (y - 2.0) cw 14.0 1.0 (EVGColor.rgb(90 98 118)))
        } {
            ; No colour of its own — inherited, or none at all. Said in words,
            ; because an empty box and a white one look the same.
            toolbarView.pushText(dl "—" (cx + 12.0) y 11.0 (EVGColor.rgb(110 118 134)))
        }
        def top:double (y + 18.0)
        def names:[string] (PptxApp.swatchNames())
        def per:int 6
        def cell:double ((w - 5.0) / (to_double per))
        def i:int 0
        while (i < (array_length names)) {
            def hex:string (this.swatchHex((itemAt names i)))
            def col:int (i % per)
            def row:int (idiv i per)
            def sx:double (x + ((to_double col) * cell))
            def sy:double (top + ((to_double row) * (cell + 3.0)))
            dl.addRect(sx sy (cell - 3.0) (cell - 3.0) (PptxApp.hexColor(hex)))
            ; The one the selection is already set to is ringed, so a reader
            ; can see where they are in the palette rather than only where
            ; they might go.
            if (hex == now) {
                dl.addFrame((sx - 1.0) (sy - 1.0) (cell - 1.0) (cell - 1.0) 2.0 (EVGColor.rgb(90 140 230)))
            } {
                dl.addFrame(sx sy (cell - 3.0) (cell - 3.0) 1.0 (EVGColor.rgb(70 78 96)))
            }
            this.addPropHit((to_int sx) (to_int sy) (to_int (cell - 3.0)) (to_int (cell - 3.0)) cmd hex)
            i = (i + 1)
        }
        def rows:int (idiv (((array_length names) + per) - 1) per)
        def below:double (top + ((to_double rows) * (cell + 3.0)))
        ; "None" only where none is a thing a shape can be. A line has to be
        ; removable and so does a fill; text always has a colour.
        if (cmd != "edit.textcolor") {
            toolbarView.pushText(dl "None" (x + 2.0) (below + 2.0) 11.0 (EVGColor.rgb(150 158 178)))
            dl.addFrame(x below 40.0 15.0 1.0 (EVGColor.rgb(70 78 96)))
            this.addPropHit((to_int x) (to_int below) 40 15 cmd "")
            below = (below + 19.0)
        }
        return below
    }

    ; The outline's thickness, as the few widths anybody picks.
    fn propsWidthRow:double (dl:EVGDisplayList x:double y:double w:double now:double) {
        toolbarView.pushText(dl "Line width" x y 11.0 theme.dim)
        def steps:[double] ([] _:double ( 0.75 1.5 3.0 6.0 ))
        def cell:double ((w - 6.0) / 4.0)
        def top:double (y + 16.0)
        def i:int 0
        while (i < (array_length steps)) {
            def pt:double (itemAt steps i)
            def sx:double (x + ((to_double i) * (cell + 2.0)))
            def on:boolean false
            if ((fabs (now - pt)) < 0.01) {
                on = true
            }
            def bg:EVGColor (EVGColor.rgb(46 52 66))
            if on {
                bg = (EVGColor.rgb(60 90 150))
            }
            dl.addRect(sx top cell 18.0 bg)
            dl.addFrame(sx top cell 18.0 1.0 (EVGColor.rgb(70 78 96)))
            ; A rule as thick as the width it stands for — the number is in
            ; the tooltip's place and the picture is the point.
            dl.addRect((sx + 4.0) ((top + 9.0) - (pt * 0.5)) (cell - 8.0) pt (EVGColor.rgb(225 230 240)))
            this.addPropHit((to_int sx) (to_int top) (to_int cell) 18 "edit.linewidth" (PptxApp.ptText(pt)))
            i = (i + 1)
        }
        return (top + 22.0)
    }

    ; Which control the panel drew for `cmd` with `arg`, or -1 when it drew
    ; none. With `propsControlX` and the three beside it, that is enough for a
    ; test to press the panel the way a reader does rather than reaching past
    ; it into the commands — the whole risk in adding a panel is that a
    ; control ends up somewhere a press cannot reach, and a test that calls
    ; `runCommand` proves nothing about that.
    fn propsControlAt:int (cmd:string arg:string) {
        def i:int 0
        while (i < (array_length propHitCmd)) {
            if ((itemAt propHitCmd i) == cmd) {
                if ((itemAt propHitArg i) == arg) {
                    return i
                }
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    fn propsControlX:int (i:int) {
        return (itemAt propHitX i)
    }

    fn propsControlY:int (i:int) {
        return (itemAt propHitY i)
    }

    fn propsControlW:int (i:int) {
        return (itemAt propHitW i)
    }

    fn propsControlH:int (i:int) {
        return (itemAt propHitH i)
    }

    fn propsControlCount:int () {
        return (array_length propHitCmd)
    }

    fn addPropHit:void (x:int y:int w:int h:int cmd:string arg:string) {
        push propHitX x
        push propHitY y
        push propHitW w
        push propHitH h
        push propHitCmd cmd
        push propHitArg arg
    }

    ; A press in the panel. Answers true when it was the panel's.
    fn propsPointer:boolean (px:int py:int pressed:boolean) {
        if (pressed == false) {
            return false
        }
        if ((this.propsWidth()) == 0) {
            return false
        }
        def r:PptxEditRect (this.propsRect())
        if ((to_double px) < r.x) {
            return false
        }
        if ((to_double py) < r.y) {
            return false
        }
        if ((to_double py) > (r.y + r.h)) {
            return false
        }
        def i:int 0
        while (i < (array_length propHitX)) {
            def hx:int (itemAt propHitX i)
            def hy:int (itemAt propHitY i)
            if (px >= hx) {
                if (py >= hy) {
                    if (px < (hx + (itemAt propHitW i))) {
                        if (py < (hy + (itemAt propHitH i))) {
                            this.runCommand((itemAt propHitCmd i) (itemAt propHitArg i))
                            return true
                        }
                    }
                }
            }
            i = (i + 1)
        }
        ; Inside the band but not on a control: still the panel's, or the
        ; press falls through and drops the selection the panel is about.
        return true
    }

    ; The theme slots a swatch row offers, in the order a deck's own palette
    ; is written. Black and white last, because they are the two a reader
    ; reaches for when the theme has nothing right.
    sfn swatchNames:[string] () {
        return ([] _:string ( "accent1" "accent2" "accent3" "accent4" "accent5" "accent6" "dk1" "dk2" "lt2" "bg1" "black" "white" ))
    }

    fn swatchHex:string (name:string) {
        if (name == "black") {
            return "000000"
        }
        if (name == "white") {
            return "FFFFFF"
        }
        def hex:string (presentation.theme.colorOf(name))
        if ((strlen hex) == 0) {
            return "808080"
        }
        return hex
    }

    sfn hexColor:EVGColor (hex:string) {
        return (EVGColor.parse(("#" + hex)))
    }

    ; A width as the string the command takes. Whole numbers without a point,
    ; because "1.5" and "3" are what a reader would write.
    sfn ptText:string (pt:double) {
        return (to_string pt)
    }

    fn paintOdpNotes:void (dl:EVGDisplayList r:PptxEditRect) {
        def page@(optional):OdpPage (odpDoc.pageAt(index))
        if (null? page) {
            return
        }
        def p:OdpPage (unwrap page)
        if ((strlen p.notes) == 0) {
            toolbarView.pushText(dl "No speaker notes on this slide" (r.x + 10.0) (r.y + 24.0) 12.0 (EVGColor.rgb(150 155 165)))
            return
        }
        def lines:[string] (strsplit p.notes "\n")
        def y:double (r.y + 24.0)
        def i:int 0
        while (i < (array_length lines)) {
            if (y < ((r.y + r.h) - 4.0)) {
                toolbarView.pushText(dl (itemAt lines i) (r.x + 10.0) y 12.0 (EVGColor.rgb(40 44 58)))
                y = (y + 16.0)
            }
            i = (i + 1)
        }
    }

    fn paintNotes:void (dl:EVGDisplayList) {
        if (notesVisible == false) {
            return
        }
        def r:PptxEditRect (this.notesRect())
        dl.addRect(r.x r.y r.w r.h (EVGColor.rgb(246 247 250)))
        dl.addRect(r.x r.y r.w 1.0 theme.line)
        def label:string "Notes"
        if (editor.isEditingNotes()) {
            label = "Notes — typing"
        }
        toolbarView.pushText(dl label (r.x + 10.0) (r.y + 4.0) 11.0 theme.dim)
        if isOdp {
            ; ODF keeps the speaker notes INSIDE the `draw:page` rather than in
            ; a part of their own, so there is no notes shape to edit — the
            ; text is read straight off the page and shown.
            this.paintOdpNotes(dl r)
            return
        }
        def hit@(optional):PptxShape (editor.notesShape())
        if (null? hit) {
            return
        }
        def sh:PptxShape (unwrap hit)
        if ((strlen (sh.text.plainText())) == 0) {
            if ((editor.isEditingNotes()) == false) {
                toolbarView.pushText(dl "Click here to write what you will say" (r.x + 10.0) (r.y + 24.0) 12.0 (EVGColor.rgb(150 155 165)))
                return
            }
        }
        def box:PptxEditRect (this.notesTextRect())
        def lines:[PptxTextLine] (this.lineBoxesIn(sh box (this.notesScale())))
        def li:int 0
        while (li < (array_length lines)) {
            def line:PptxTextLine (itemAt lines li)
            if (line.y < ((r.y + r.h) - 4.0)) {
                def npara:PptxParagraph (itemAt sh.text.paragraphs line.para)
                def text:string (PptxTextLayout.paraText(npara))
                def piece:string (substring text line.startCol line.endCol)
                ; Reordered and shaped on the way in, like every other string
                ; that goes into the list. See `paintNotes` above: this is the
                ; second of the two places the notes are drawn, and it was raw
                ; for the same reason.
                def nshown:string (OfficeText.forDisplayDir(piece npara.rtl))
                toolbarView.pushText(dl nshown line.x line.y line.size (EVGColor.rgb(40 44 58)))
            }
            li = (li + 1)
        }
    }

}

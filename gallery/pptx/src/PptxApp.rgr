; ==============================================================================
; PptxApp - UIInput → slide navigation → SoftCanvas / sceneJson
; ==============================================================================
;
; Same host contract as the text editor: a platform fills UIInput each frame;
; this app never touches SDL/DOM directly.
; ==============================================================================

Import "PptxParser.rgr"
Import "PptxResolver.rgr"
Import "PptxModel.rgr"
Import "PptxView.rgr"
Import "PptxToEvg.rgr"
Import "../../game_engine/ui/UIInput.rgr"
Import "../../evg/EVGElement.rgr"

class PptxApp {
    def parser:PptxParser (new PptxParser())
    def resolver:PptxResolver (new PptxResolver())
    def presentation:PptxPresentation (new PptxPresentation())
    def view:PptxView (new PptxView())
    def converter:PptxToEvg (new PptxToEvg())
    def index:int 0
    def W:int 960
    def H:int 720
    def loaded:boolean false
    def lastPath:string ""

    Constructor () {
    }

    fn init:void (fontDir:string) {
        view.init(W H fontDir)
    }

    fn load:boolean (fullPath:string) {
        lastPath = fullPath
        parser.close()
        parser = (new PptxParser())
        def ok:boolean (parser.open(fullPath))
        if (ok == false) {
            loaded = false
            view.status = "failed to open"
            return false
        }
        def raw:PptxPresentation (parser.parsePresentation())
        presentation = (resolver.resolvePresentation(raw))
        index = 0
        loaded = true
        view.status = ((to_string (presentation.slideCount())) + " slides")
        return true
    }

    fn loadParts:boolean (path:string name:string) {
        lastPath = (path + "/" + name)
        parser.close()
        parser = (new PptxParser())
        def ok:boolean (parser.openParts(path name))
        if (ok == false) {
            loaded = false
            view.status = "failed to open"
            return false
        }
        def raw:PptxPresentation (parser.parsePresentation())
        presentation = (resolver.resolvePresentation(raw))
        index = 0
        loaded = true
        view.status = ((to_string (presentation.slideCount())) + " slides")
        return true
    }

    fn slideCount:int () {
        return (presentation.slideCount())
    }

    fn currentSlide@(optional):PptxSlide () {
        if (loaded == false) {
            def __missing@(optional):PptxSlide
            return __missing
        }
        if (index < 0) {
            def __missing2@(optional):PptxSlide
            return __missing2
        }
        if (index >= (array_length presentation.slides)) {
            def __missing3@(optional):PptxSlide
            return __missing3
        }
        def hit@(optional):PptxSlide (itemAt presentation.slides index)
        return hit
    }

    fn nextSlide:void () {
        def n:int (this.slideCount())
        if (n <= 0) {
            return
        }
        if (index < (n - 1)) {
            index = (index + 1)
        }
    }

    fn prevSlide:void () {
        if (index > 0) {
            index = (index - 1)
        }
    }

    fn gotoSlide:void (i:int) {
        def n:int (this.slideCount())
        if (n <= 0) {
            return
        }
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        index = i
    }

    fn resize:void (nw:int nh:int) {
        W = nw
        H = nh
        view.resize(W H)
    }

    fn update:void (input:UIInput) {
        def i:int 0
        while (i < (input.keyCount())) {
            def k:int (input.keyAt(i))
            if (k == (UIKey.right())) {
                this.nextSlide()
            }
            if (k == (UIKey.left())) {
                this.prevSlide()
            }
            if (k == (UIKey.home())) {
                this.gotoSlide(0)
            }
            if (k == (UIKey.end())) {
                this.gotoSlide(((this.slideCount()) - 1))
            }
            i = (i + 1)
        }
        ; Click left/right thirds to navigate
        if input.pointerPressed {
            if (input.pointerX < (idiv W 3)) {
                this.prevSlide()
            }
            if (input.pointerX > ((idiv (W * 2) 3))) {
                this.nextSlide()
            }
        }
        this.render()
    }

    fn render:void () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return
        }
        view.render((unwrap slide) index (this.slideCount()))
    }

    fn raw:buffer () {
        return (view.raw())
    }

    fn sceneJson:string () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return "{\"width\":0,\"height\":0,\"list\":{\"cmds\":[]}}"
        }
        return (view.sceneJson((unwrap slide) index (this.slideCount())))
    }

    ; Build an EVGElement tree for the current slide (PDF/HTML/export path).
    fn currentEvg@(optional):EVGElement () {
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            def __missing@(optional):EVGElement
            return __missing
        }
        def hit@(optional):EVGElement (converter.slideToEvg((unwrap slide)))
        return hit
    }

    fn close:void () {
        parser.close()
        loaded = false
    }
}

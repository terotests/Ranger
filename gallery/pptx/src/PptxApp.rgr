; ==============================================================================
; PptxApp - UIInput → slide navigation → SoftCanvas / sceneJson
; ==============================================================================
;
; Same host contract as the text editor: a platform fills UIInput each frame;
; this app never touches SDL/DOM directly.
; ==============================================================================

Import "PptxParser.rgr"
Import "PptxResolver.rgr"
Import "PptxModel.rgr"
Import "PptxView.rgr"
Import "../../odp/OdpParser.rgr"
Import "../../odp/OdpToEvg.rgr"
Import "PptxEdit.rgr"
Import "PptxWriter.rgr"
Import "PptxToEvg.rgr"
Import "../../office/assets/OfficeAsset.rgr"
Import "PptxA11y.rgr"
Import "../../game_engine/ui/UIInput.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGToolbarView.rgr"
Import "../../evg/EVGWindow.rgr"
Import "../../evg/EVGCommands.rgr"
Import "../../evg/EVGSelectChrome.rgr"
Import "../../office/geom/OfficeShapeCatalog.rgr"
Import "../../office/ui/OfficeShapePicker.rgr"
Import "../../office/geom/OfficeEmojiShapes.rgr"

; Which buttons a slide viewer has. The strip is the shared one — the same
; component the spreadsheet's and the document's are — and this is the only
; part that is about slides.
class PptxToolbar extends EVGToolbar {
    ; What the direction switch is showing. The strip needs it to draw the
    ; button pressed; the app owns the decision.
    def uiRtl:boolean false

    ; The strip cannot work out whether the deck is being edited any more than
    ; it can work out which slide you are on; the app sets it before paint.
    def editOn:boolean false

    Constructor () {
    }

    ; The strip, in named pages. A deck viewer's commands split cleanly:
    ; Home is moving around the deck, Insert puts a shape or a picture on the
    ; slide, Arrange is what you do to the shapes once they are there, and
    ; Slides is about the deck itself. Thirty buttons in one band made all
    ; four look like one undifferentiated wall of pictures.
    fn build:void () {
        clear items
        clear tabs
        this.addTab("Home")
        this.add("file.open" "" "Open a deck" (ToolIcon.openFile()))
        ; The two a beginner reaches for first carry their names.
        this.addLabeled("file.save" "" "Save" (ToolIcon.save()))
        this.addLabeled("file.print" "" "Print" (ToolIcon.printDoc()))
        this.addSeparator()
        this.add("slide.first" "" "First slide" (ToolIcon.navFirst()))
        this.add("slide.prev" "" "Previous slide" (ToolIcon.navPrev()))
        this.add("slide.next" "" "Next slide" (ToolIcon.navNext()))
        this.add("slide.last" "" "Last slide" (ToolIcon.navLast()))
        this.addSeparator()
        ; The typeface, where the slide counter used to be.
        ;
        ; That counter read "3 / 12" and opened a grid of numbered buttons.
        ; Four nav buttons sit to its left and the whole deck is drawn down
        ; the side as thumbnails, so it was the third way to do the same
        ; thing and the worst of the three — while the one thing a reader
        ; reaches for constantly, the font of the text they have selected,
        ; was nowhere on the strip at all. `slide.pick` is still a command;
        ; it just no longer takes the best slot on the tab.
        ;
        ; The entries are filled in at `refreshFonts`, from the faces the page
        ; has actually loaded — a chooser offering a typeface nothing can draw
        ; would measure with one face and paint with another.
        this.addDropdown("Font" (ToolIcon.textBox()))
        this.addSeparator()
        ; The editing half of the strip. It is always here — the buttons are
        ; live only while `edit.toggle` is pressed, which is what tells you
        ; the deck can be changed at all.
        this.add("edit.toggle" "" "Edit the slide" (ToolIcon.editMode()))
        this.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        this.add("edit.redo" "" "Redo" (ToolIcon.redo()))

        this.addTab("Insert")
        ; The text box is what somebody opens Insert to do, so it is drawn as
        ; the thing on the page rather than as one of four identical squares.
        this.addLarge("text.add" "" "Text Box" (ToolIcon.textBox()))
        this.addSeparator()
        this.add("shape.rect" "" "Insert a box" (ToolIcon.shapeRect()))
        this.add("shape.ellipse" "" "Insert an ellipse" (ToolIcon.shapeEllipse()))
        this.add("shape.pick" "" "More shapes and emoji" (ToolIcon.shapes()))
        this.add("picture.add" "" "Insert a picture" (ToolIcon.picture()))

        this.addTab("Arrange")
        this.add("edit.copy" "" "Copy" (ToolIcon.copy()))
        this.add("edit.paste" "" "Paste" (ToolIcon.paste()))
        this.add("edit.lock" "" "Lock or unlock" (ToolIcon.lock()))
        this.add("edit.flip.h" "" "Flip across" (ToolIcon.flipH()))
        this.add("edit.flip.v" "" "Flip down" (ToolIcon.flipV()))
        this.add("edit.duplicate" "" "Duplicate" (ToolIcon.duplicate()))
        this.add("edit.delete" "" "Delete" (ToolIcon.trash()))
        this.add("edit.front" "" "Bring to front" (ToolIcon.bringFront()))
        this.add("edit.back" "" "Send to back" (ToolIcon.sendBack()))
        this.add("edit.group" "" "Group" (ToolIcon.group()))
        this.add("edit.ungroup" "" "Ungroup" (ToolIcon.ungroup()))
        ; Moving shapes to line up with each other, which is what Align meant
        ; on the Format tab and should never have.
        this.addDropdown("Line up" (ToolIcon.arrangeLeft()))
        this.addUnder("edit.align.left" "" "Left edges" (ToolIcon.arrangeLeft()))
        this.addUnder("edit.align.hcenter" "" "Centres, across" (ToolIcon.arrangeCenter()))
        this.addUnder("edit.align.right" "" "Right edges" (ToolIcon.arrangeRight()))

        this.addTab("Format")
        ; Align, on the FORMAT tab, means the text inside the shape — which is
        ; what a reader who has just selected a text box is asking for. It used
        ; to move the shape across the slide instead, which is a different job
        ; and now lives under Arrange. Three buttons became one list because
        ; only one of the three is ever wanted at a time.
        ;
        ; Master reached the same complaint from the other side while this
        ; branch was open: it kept `edit.align.*` here and gave the three their
        ; own pictures so that lining SHAPES up could not be mistaken for
        ; aligning TEXT. Both halves are kept — the shape ones moved to Arrange
        ; above rather than staying here, since that is where the rest of
        ; moving things about lives, and they take master's new icons, which is
        ; what stops the two Lefts from sharing one picture.
        this.addDropdown("Align" (ToolIcon.alignLeft()))
        this.addUnder("text.align.left" "" "Left" (ToolIcon.alignLeft()))
        this.addUnder("text.align.center" "" "Centre" (ToolIcon.alignCenter()))
        this.addUnder("text.align.right" "" "Right" (ToolIcon.alignRight()))
        this.add("format.copy" "" "Pick up the formatting" (ToolIcon.paint()))
        this.add("format.paste" "" "Paint it on" (ToolIcon.formatPaste()))
        this.add("edit.bold" "" "Bold text" (ToolIcon.bold()))
        this.add("edit.italic" "" "Italic text" (ToolIcon.italic()))
        this.add("text.bullet" "" "Bulleted list" (ToolIcon.bulletList()))
        this.add("text.number" "" "Numbered list" (ToolIcon.numberList()))
        this.add("text.outdent" "" "Outdent the list" (ToolIcon.indentLess()))
        this.add("text.indent" "" "Indent the list" (ToolIcon.indentMore()))

        this.addTab("Slides")
        this.add("view.notes" "" "Show the notes" (ToolIcon.comment()))
        this.add("view.props" "" "Show fill, line and text" (ToolIcon.fill()))
        this.add("theme.palette" "office" "Recolour the deck" (ToolIcon.palette()))
        this.add("slide.add" "" "New slide" (ToolIcon.slideAdd()))
        this.add("slide.duplicate" "" "Duplicate slide" (ToolIcon.slideCopy()))
        this.add("slide.delete" "" "Delete slide" (ToolIcon.slideDel()))
        this.addSeparator()
        this.add("show.start" "" "Show the deck" (ToolIcon.play()))
        this.addSeparator()
        this.add("view.rtl" "" "Right-to-left layout" (ToolIcon.textRtl()))
    }

    ; The one button that shows a value rather than a picture. The strip
    ; cannot work this out — it has never heard of a slide.
    ; Whether the text under the caret is bold or italic. The strip cannot
    ; work this out — it has never heard of a run — so the app puts the
    ; answers here before the strip is painted, the same way `editOn` arrives.
    def boldOn:boolean false
    def italicOn:boolean false

    fn refresh:void (index:int count:int) {
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            t.pressed = false
            if (t.command == "edit.toggle") {
                t.pressed = editOn
            }
            if (t.command == "view.rtl") {
                t.pressed = uiRtl
            }
            ; Bold and Italic are toggles and have to LOOK like it. They were
            ; plain buttons: pressing Bold made the text bold and the button
            ; went on looking exactly as it had, so the only way to find out
            ; whether bold was on was to look at the letters and guess.
            if (t.command == "edit.bold") {
                t.pressed = boldOn
            }
            if (t.command == "edit.italic") {
                t.pressed = italicOn
            }
            i = (i + 1)
        }
    }
}

class PptxApp {
    def parser:PptxParser (new PptxParser())
    ; --- the other presentation format ---------------------------------------
    ; A second READER and a second painter, never a second half of one model.
    ; `gallery/odp` imports nothing from here and this imports nothing of its
    ; internals: the two meet at `EVGDisplayList`, which is the layer both
    ; formats were always going to have in common. PLAN_FORMATS.md Phase 1.
    def odpParser:OdpParser (new OdpParser())
    def odpDoc:OdpPresentation (new OdpPresentation())
    def odpConv:OdpToEvg (new OdpToEvg())
    ; Which reader owns what is on screen. This is the flag the format
    ; adapter (PLAN_FORMATS.md 1.8) exists to delete; until it does, it is
    ; ONE flag set in ONE place — `loadBytes` — rather than an extension
    ; compared in twenty.
    def isOdp:boolean false
    def odpThumbs:[int:EVGDisplayList]
    def odpThumbW:int 0
    def resolver:PptxResolver (new PptxResolver())
    def presentation:PptxPresentation (new PptxPresentation())
    def view:PptxView (new PptxView())
    def converter:PptxToEvg (new PptxToEvg())
    def index:int 0
    def W:int 960
    def H:int 720
    def loaded:boolean false
    def lastPath:string ""
    ; The frame: the shared strip, the shared window layer, the shared command
    ; table. A slide viewer used to draw its own dark band with a string in it,
    ; which was a third toolbar in a third style that nothing else could use.
    ; Whether the interface is mirrored. Not the deck's direction — that is
    ; the file's business and is read from `a:pPr rtl` — this is which way the
    ; PROGRAM is laid out around it.
    def uiRtl:boolean false
    ; Has the reader turned the interface back to left-to-right by hand?
    ; While they have, the automatic half stays quiet: a program that keeps
    ; undoing a deliberate choice every time a file is opened is worse than
    ; one that never guessed.
    def uiRtlChosen:boolean false
    def toolbar:PptxToolbar (new PptxToolbar)
    def toolbarView:EVGToolbarView (new EVGToolbarView)
    def windows:EVGWindowManager (new EVGWindowManager)
    def commands:GridCommandTable (new GridCommandTable)
    def theme:EVGToolbarTheme (new EVGToolbarTheme)
    def toolbarH:int 30
    def statusH:int 22
    def status:string ""
    def fileRequest:string ""
    ; Editing. The viewer is the default and the editor is a mode on top of
    ; it — a deck you opened to read cannot be changed by a stray click.
    def editor:PptxEditor (new PptxEditor())
    ; Pictures the host handed in, identified by their content. Nothing here
    ; is used for drawing — it is what stops one inserted file from being
    ; mistaken for another because they were called the same thing.
    def assets:OfficeAssetStore (new OfficeAssetStore())
    ; The deck opens ready to be edited. It used to open read-only, with the
    ; editor behind a toolbar toggle, which meant the first thing anyone did —
    ; click the slide — turned the page instead of picking a shape up.
    def editMode:boolean true
    def dragMode:int 0          ; 0 none, 1 move, 2 resize, 3 marquee, 4 rotate, 5 placing
    ; The rubber band, in slide points, while a drag over empty canvas is
    ; happening.
    ; A tool waiting to be put down: "" for none, "text" for a text box.
    ;
    ; Inserting used to drop a box at a fixed fraction of the slide, so two of
    ; them landed at EXACTLY the same place and the second hid the first; the
    ; caret was not in it, so typing did nothing until you found and
    ; double-clicked it; and it arrived carrying the literal word "Text",
    ; which you then had to select and delete. Four steps and a collision to
    ; write one label.
    ;
    ; This is how every drawing program has done it for thirty years: pick the
    ; tool, drag out the box, type. The pointer says the tool is armed, a
    ; click without a drag gives a sensible default box, and Escape puts the
    ; tool down again.
    def pendingTool:string ""
    def marqueeX:double 0.0
    def marqueeY:double 0.0
    def marqueeW:double 0.0
    def marqueeH:double 0.0
    def dragHandle:int -1
    def dragLastX:double 0.0    ; slide points
    def dragLastY:double 0.0
    ; A press that lands on the shape ALREADY selected, and lets go without
    ; moving it, is how a person asks to type in it. Held from the press so
    ; the release can tell "clicked the thing that was already picked" from
    ; "picked something new" — the selection itself cannot say, because by the
    ; time the release arrives the shape is selected either way.
    def clickedSelected:boolean false
    def clickX:int 0
    def clickY:int 0
    def dragMoved:boolean false
    def modShift:boolean false
    def modCtrl:boolean false
    ; The speaker's notes, under the slide.
    def notesVisible:boolean true
    def notesH:int 92
    ; The chrome's stylesheet — see `defaultChromeCss`. Parsed once and
    ; re-evaluated on every resize, because that is when the media conditions
    ; can change.
    def chromeCss:string ""
    def chromeSheet:EVGStyleSheet (new EVGStyleSheet())
    def coarsePointer:boolean false
    ; The properties panel: fill, line and text down the right-hand side.
    ;
    ; What a shape looks like was previously reachable only by knowing that a
    ; command called `edit.fill` existed and finding something to type a hex
    ; string into. The four things a reader changes constantly — what a shape
    ; is filled with, what its outline is and how thick, and what colour its
    ; text is — now have a place that is always on screen and that SHOWS the
    ; current value rather than only setting a new one. A swatch you can read
    ; is half of what the panel is for.
    def propsW:int 168
    def propsVisible:boolean true
    ; Where the panel's rows ended up last time it was painted, so a press can
    ; be matched to one. Parallel arrays rather than a class: a row is a
    ; rectangle, a command and an argument, and nothing else.
    def propHitX:[int]
    def propHitY:[int]
    def propHitW:[int]
    def propHitH:[int]
    def propHitCmd:[string]
    def propHitArg:[string]

    ; The slide panel: the deck down the left-hand side.
    def panelW:int 150
    def panelVisible:boolean true
    def panelScroll:int 0
    ; Whether `buildFrame` paints the thumbnails into the frame it returns.
    ;
    ; It always did, and that turned out to be the most expensive thing a
    ; frame does. On a six-slide chart deck the panel is 7,500 of the frame's
    ; 9,400 commands — and none of them change while a reader drags a shape.
    ; Every one was re-encoded to the binary bridge, re-decoded in JavaScript
    ; and re-drawn, sixty times a second, to show a picture identical to the
    ; last one. Measured: 103 ms a frame with the panel in, 40 ms with it out.
    ;
    ; So a host that knows how may ask for the two separately — `buildFrame`
    ; without the panel, and `buildPanelFrame` only when `panelStamp` says the
    ; thumbnails have actually changed. Hosts that do not care keep asking for
    ; one list and get exactly what they always did.
    def framePanel:boolean true
    ; Which families the Font dropdown was last filled with, joined. The list
    ; is rebuilt only when that string changes — opening a deck in a typeface
    ; nothing else uses adds one, and nothing else does — because rebuilding a
    ; menu every frame would take it out from under the reader's hand while it
    ; was open.
    def fontsListed:string ""
    ; The deck as a STRIP ACROSS THE TOP rather than a column down the side,
    ; which is what a phone wants: a phone is narrow and tall, so a column
    ; spends the dimension there is least of. Nonzero height means the strip;
    ; the stylesheet says which by giving `.slide-panel` a width or a height.
    def panelH:int 0
    def panelDrag:int -1
    def panelDropAt:int -1
    def panelBuilt:int 0
    ; --- the panel's thumbnails, kept ----------------------------------------
    ;
    ; A thumbnail is the slide's own scene at a small scale, which is what made
    ; the panel cost nothing to invent and everything to draw: at a hundred
    ; slides the panel was seven eighths of every frame, because the dozen
    ; thumbnails on screen were converted again for each one.
    ;
    ; They are kept now, keyed by the slide and tagged with the revision, the
    ; place and the width they were built at — a slide that has not changed and
    ; has not moved is the same picture, and that is the whole test. Nothing
    ; here is ever mutated after it is stored: the frame borrows the commands
    ; and is thrown away, and a thumbnail that has moved is built again rather
    ; than shifted, since shifting one would write into what the cache holds.
    def thumbRev:[int:int]
    def thumbX:[int:int]
    def thumbY:[int:int]
    def thumbW:[int:int]
    def thumbList:[int:EVGDisplayList]
    def thumbKept:int 0
    def thumbCount:int 0
    ; The slide picker. Ids: 1601.. the slides, 1691 Close.
    def slideDialog:EVGWindow (new EVGWindow)
    def dialogsReady:boolean false

    ; --- showing the deck -----------------------------------------------------
    ; Present mode is the viewer with everything else turned off, plus a clock:
    ; a transition and a build are pictures that change over time, so the frame
    ; has to know how much time has passed since the last one.
    def presenting:boolean false
    ; Which step of the current slide's build has been reached. 0 is the slide
    ; as it arrives.
    def presentStep:int 0
    ; Seconds since the current transition started, and how long it runs. When
    ; `showLength` is zero nothing is animating.
    def showTime:double 0.0
    def showLength:double 0.0
    ; The slide being left, while a transition is running.
    def showFrom:int -1
    ; Seconds on this slide (for a slide that advances itself) and on the whole
    ; show (for the presenter's clock).
    def slideClock:double 0.0
    def showClock:double 0.0
    ; The presenter's own screen: the slide, what is next, the notes, a clock.
    def presenterView:boolean false
    ; Drawing on the slide while it is being shown. "" nothing, "pen" ink that
    ; stays, "laser" a dot that does not.
    def penMode:string ""
    def penHex:string "E8465C"
    ; Ink, in slide points, as flat x,y runs — one array per stroke, with the
    ; slide it was drawn on beside it.
    def inkSlides:[int]
    def inkPoints:[[double]]
    def inkColors:[string]
    def inkDrawing:boolean false
    def laserX:double (0.0 - 1.0)
    def laserY:double 0.0
    ; A blanked screen: B during a show, which is what a presenter presses when
    ; the slide is not the thing to look at any more.
    def showBlank:boolean false
    ; Whether `render` paints the CPU framebuffer. A host that draws the
    ; display list itself turns this off; everything headless leaves it on,
    ; because the framebuffer IS its output.
    def wantRaster:boolean true

    Constructor () {
        ; The emoji outlines. They cost the /office/ page about a megabyte —
        ; the playground bundle goes from 2.39 MB to 3.40 MB — which was not
        ; worth paying while this editor could only hold ONE contour per shape
        ; and had to refuse them. `PptxShape.pathEnds` fixed that, so they are
        ; here now and a panda keeps its eye patches.
        OfficeEmojiShapes.fill(shapes)
        picker.attach(shapes)
    }

    fn init:void (fontDir:string) {
        view.init(W H fontDir)
        ; The converter would find the catalogue on its own at the first
        ; shape it draws; doing it here means an app that has initialised has
        ; a catalogue, rather than one that acquires it at a moment nothing
        ; can name.
        view.converter.ensurePresets()
        this.initFrame()
    }

    ; The 187 preset geometries. The converter finds the asset on its own
    ; wherever there is a filesystem; this is for the host that has no
    ; filesystem and the bytes instead — the browser fetches the file and
    ; hands them over here, before anything is drawn.
    fn loadPresets:void (text:string) {
        view.converter.loadPresets(text)
        ; The same bytes to the catalogue. It can list its shapes without them
        ; but cannot produce an outline, and the book editor needs outlines —
        ; so both are fed from the one call a host already makes.
        shapes.loadPresets(text)
        ; Both painters draw the same 187 geometries, so both are handed the
        ; same catalogue at the same moment. A browser cannot read the file
        ; beside the module; the page fetches it once.
        odpConv.loadPresets(text)
    }

    ; The 187 preset geometries as a catalogue somebody can browse. This
    ; editor has been able to DRAW all of them since the presets landed and
    ; could only ever INSERT two of them, because nothing named the rest.
    ; Shared with the book editor, which turns an entry into a path instead.
    def shapes:OfficeShapeCatalog (new OfficeShapeCatalog())

    ; The shared shape browser. Both editors put up the SAME window over the
    ; same catalogue; what differs is only the one line that acts on the id it
    ; hands back — which is the whole claim the shared work makes.
    def picker:OfficeShapePicker (new OfficeShapePicker)


    ; The strip, the command table, and the room they take out of the window.
    ; `view.chromeH` is what the slide's fit-to-window scale keeps clear, so it
    ; has to be the whole frame rather than the old status band alone.
    fn initFrame:void () {
        toolbar.build()
        toolbar.editOn = editMode
        toolbarH = (toolbar.heightFor(W))
        view.chromeH = (((toolbarH + statusH) + (this.notesHeight())) + (this.panelHeight()))
        view.chromeW = ((this.panelWidth()) + (this.propsWidth()))
        this.registerCommands()
    }

    ; --- present mode ---------------------------------------------------------
    ;
    ; The deck as it is shown rather than as it is made: no strip, no panel, no
    ; notes, no status line, the slide as large as the window allows, and a
    ; clock — because a transition and a build are pictures that change over
    ; time. A host drives the clock with `tick`; one that never calls it gets a
    ; show where every transition is already finished, which is the right
    ; answer for a test and for a still.

    fn startPresenting:boolean () {
        if (loaded == false) {
            return false
        }
        presenting = true
        this.setEditMode(false)
        presentStep = 0
        showFrom = -1
        showTime = 0.0
        showLength = 0.0
        slideClock = 0.0
        showClock = 0.0
        penMode = ""
        laserX = (0.0 - 1.0)
        return true
    }

    fn stopPresenting:boolean () {
        if (presenting == false) {
            return false
        }
        presenting = false
        showLength = 0.0
        showFrom = -1
        penMode = ""
        inkDrawing = false
        return true
    }

    ; Seconds since the last frame. Everything that moves in present mode moves
    ; from here, so a headless host that never calls it sees a still picture and
    ; a browser that calls it every frame sees the show.
    fn tick:void (seconds:double) {
        if (seconds <= 0.0) {
            return
        }
        if (presenting == false) {
            return
        }
        showClock = (showClock + seconds)
        slideClock = (slideClock + seconds)
        if (showLength > 0.0) {
            showTime = (showTime + seconds)
            if (showTime >= showLength) {
                showLength = 0.0
                showTime = 0.0
                showFrom = -1
            }
        }
        ; A slide that advances itself does so once its time is up, and only
        ; when nothing is still building on it.
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return
        }
        def s0:PptxSlide (unwrap slide)
        def after:double s0.transition.afterSeconds
        if (after > 0.0) {
            if (slideClock >= after) {
                if (presentStep >= (array_length s0.build)) {
                    this.presentNext()
                }
            }
        }
    }

    ; How far through the transition we are, 0 to 1. 1 means it is over.
    fn showProgress:double () {
        if (showLength <= 0.0) {
            return 1.0
        }
        def t:double (showTime / showLength)
        if (t < 0.0) {
            return 0.0
        }
        if (t > 1.0) {
            return 1.0
        }
        return t
    }

    ; One click forward: the next step of the build if there is one, otherwise
    ; the next slide.
    fn presentNext:boolean () {
        if (presenting == false) {
            return false
        }
        def slide@(optional):PptxSlide (this.currentSlide())
        if (!null? slide) {
            def s0:PptxSlide (unwrap slide)
            if (presentStep < (array_length s0.build)) {
                presentStep = (presentStep + 1)
                return true
            }
        }
        if (index >= ((this.slideCount()) - 1)) {
            return false
        }
        def from:int index
        this.gotoSlide((index + 1))
        presentStep = 0
        this.beginTransition(from)
        return true
    }

    ; One click back. A build is not run backwards step by step — going back
    ; puts you on the slide before, fully built, which is what a presenter
    ; means by "back".
    fn presentPrev:boolean () {
        if (presenting == false) {
            return false
        }
        if (presentStep > 0) {
            presentStep = (presentStep - 1)
            return true
        }
        if (index <= 0) {
            return false
        }
        def from:int index
        this.gotoSlide((index - 1))
        def slide@(optional):PptxSlide (this.currentSlide())
        if (!null? slide) {
            def s0:PptxSlide (unwrap slide)
            presentStep = (array_length s0.build)
        }
        this.beginTransition(from)
        return true
    }

    ; Start the transition onto the slide now in front. It does NOT touch the
    ; build step: going forward reaches a slide unbuilt and going back reaches
    ; one fully built, and each caller says which — resetting it here undid
    ; the second.
    fn beginTransition:void (from:int) {
        slideClock = 0.0
        showFrom = -1
        showLength = 0.0
        showTime = 0.0
        def slide@(optional):PptxSlide (this.currentSlide())
        if (null? slide) {
            return
        }
        def s0:PptxSlide (unwrap slide)
        if (s0.transition.isSet == false) {
            return
        }
        if (s0.transition.seconds <= 0.0) {
            return
        }
        if (s0.transition.kind == "cut") {
            return
        }
        showFrom = from
        showLength = s0.transition.seconds
    }

    ; --- ink -------------------------------------------------------------------

    fn setPen:boolean (mode:string) {
        if (mode == penMode) {
            penMode = ""
            return true
        }
        penMode = mode
        return true
    }

    fn clearInk:boolean () {
        def slides:[int]
        def pts:[[double]]
        def cols:[string]
        def i:int 0
        while (i < (array_length inkSlides)) {
            if ((itemAt inkSlides i) != index) {
                push slides (itemAt inkSlides i)
                push pts (itemAt inkPoints i)
                push cols (itemAt inkColors i)
            }
            i = (i + 1)
        }
        def changed:boolean ((array_length slides) != (array_length inkSlides))
        inkSlides = slides
        inkPoints = pts
        inkColors = cols
        return changed
    }

    fn inkStrokeCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length inkSlides)) {
            if ((itemAt inkSlides i) == index) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }


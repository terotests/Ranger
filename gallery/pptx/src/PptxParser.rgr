; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxParser - OPC package → PptxPresentation / raw slides
; ==============================================================================
;
; Reads presentation.xml for slide order + size, then each slide part into a
; PptxSlide with shapes / pictures / groups / text. Theme and master inheritance
; are left to PptxResolver — this layer only materialises what the XML says.
; ==============================================================================

Import "../../ooxml/OpcPackage.rgr"
Import "../../xml/XmlCore.rgr"
Import "PptxModel.rgr"
Import "PptxGeom.rgr"

class PptxParser {
    def pkg:OpcPackage (new OpcPackage())
    def xmlParser:XmlParser (new XmlParser())

    Constructor () {
    }

    fn close:void () {
        pkg.close()
    }

    fn open:boolean (fullPath:string) {
        return (pkg.open(fullPath))
    }

    fn openParts:boolean (path:string name:string) {
        return (pkg.openParts(path name))
    }

    fn openBytes:boolean (bytes:buffer name:string) {
        return (pkg.openBytes(bytes name))
    }

    fn parseDoubleAttr:double (node:XmlNode name:string) {
        def s:string (node.attr(name))
        if ((strlen s) == 0) {
            return 0.0
        }
        def d@(optional):double (str2double s)
        return (?? d 0.0)
    }

    ; A percentage attribute in DrawingML is in thousandths of a percent, so
    ; 100000 is 1.0. `fallback` is what "not stated" means for this modifier.
    fn parsePercent:double (node:XmlNode name:string fallback:double) {
        def hit@(optional):XmlNode (node.firstChild(name))
        if (null? hit) {
            return fallback
        }
        def v@(optional):double (str2double ((unwrap hit).attr("val")))
        if (null? v) {
            return fallback
        }
        return ((unwrap v) / 100000.0)
    }

    ; The adjustments a colour carries: they are children of the colour
    ; element, not of the fill, and they are what a theme's fill styles are
    ; made of — a style is `phClr` plus a chain of these.
    fn parseColorMods:void (node:XmlNode col:PptxColor) {
        col.lumMod = (this.parsePercent(node "lumMod" 1.0))
        col.lumOff = (this.parsePercent(node "lumOff" 0.0))
        col.tint = (this.parsePercent(node "tint" 0.0))
        col.shade = (this.parsePercent(node "shade" 0.0))
        col.satMod = (this.parsePercent(node "satMod" 1.0))
        def a@(optional):XmlNode (node.firstChild("alpha"))
        if (!null? a) {
            def av@(optional):double (str2double ((unwrap a).attr("val")))
            if (!null? av) {
                col.alpha = ((unwrap av) / 100000.0)
            }
        }
    }

    ; The colour a `srgbClr` / `schemeClr` / `sysClr` element states, with its
    ; adjustments. `parent` is the element that HOLDS the colour.
    fn colorIn@(optional):PptxColor (parent:XmlNode) {
        def srgb@(optional):XmlNode (parent.firstChild("srgbClr"))
        if (!null? srgb) {
            def sn:XmlNode (unwrap srgb)
            def hex:string (sn.attr("val"))
            if ((strlen hex) == 6) {
                def out:PptxColor (PptxColor.srgbOf(hex))
                this.parseColorMods(sn out)
                def hit@(optional):PptxColor out
                return hit
            }
        }
        def sch@(optional):XmlNode (parent.firstChild("schemeClr"))
        if (!null? sch) {
            def sc:XmlNode (unwrap sch)
            def name:string (sc.attr("val"))
            if ((strlen name) > 0) {
                def out2:PptxColor (PptxColor.schemeOf(name))
                this.parseColorMods(sc out2)
                def hit2@(optional):PptxColor out2
                return hit2
            }
        }
        ; `sysClr` states the system's own colour and, helpfully, the last one
        ; it resolved to — which is the only value a file can be read with.
        def sys@(optional):XmlNode (parent.firstChild("sysClr"))
        if (!null? sys) {
            def sy:XmlNode (unwrap sys)
            def last:string (sy.attr("lastClr"))
            if ((strlen last) == 6) {
                def out3:PptxColor (PptxColor.srgbOf(last))
                this.parseColorMods(sy out3)
                def hit3@(optional):PptxColor out3
                return hit3
            }
        }
        def __missing@(optional):PptxColor
        return __missing
    }

    fn parseColor@(optional):PptxColor (parent:XmlNode) {
        ; Look for solidFill → srgbClr | schemeClr under parent
        def solid@(optional):XmlNode (parent.firstChild("solidFill"))
        if (null? solid) {
            ; Also allow parent itself to be solidFill
            if (parent.name == "solidFill") {
                solid = parent
            }
        }
        if (null? solid) {
            def __missing@(optional):PptxColor
            return __missing
        }
        return (this.colorIn((unwrap solid)))
    }

    fn parseXfrm:void (xfrm:XmlNode shape:PptxShape) {
        shape.hasXfrm = true
        def rotS:string (xfrm.attr("rot"))
        if ((strlen rotS) > 0) {
            def rd@(optional):double (str2double rotS)
            def rot:double (?? rd 0.0)
            shape.rotation = (PptxUnits.rotToDeg(rot))
        }
        if ((xfrm.attr("flipH")) == "1") {
            shape.flipH = true
        }
        if ((xfrm.attr("flipV")) == "1") {
            shape.flipV = true
        }
        def off@(optional):XmlNode (xfrm.firstChild("off"))
        if (!null? off) {
            def o:XmlNode (unwrap off)
            shape.x = (PptxUnits.emuToPt((this.parseDoubleAttr(o "x"))))
            shape.y = (PptxUnits.emuToPt((this.parseDoubleAttr(o "y"))))
            shape.hasOff = true
        }
        def ext@(optional):XmlNode (xfrm.firstChild("ext"))
        if (!null? ext) {
            def e:XmlNode (unwrap ext)
            shape.width = (PptxUnits.emuToPt((this.parseDoubleAttr(e "cx"))))
            shape.height = (PptxUnits.emuToPt((this.parseDoubleAttr(e "cy"))))
            ; Stated, and stated as a SIZE. `cx="0"` is a degenerate box that
            ; a writer leaves behind, not an instruction to draw nothing, and
            ; treating it as stated is what stopped the layout's real size
            ; from ever being asked for.
            if ((shape.width > 0.0) && (shape.height > 0.0)) {
                shape.hasExt = true
            }
        }
        def chOff@(optional):XmlNode (xfrm.firstChild("chOff"))
        if (!null? chOff) {
            def co:XmlNode (unwrap chOff)
            shape.chX = (PptxUnits.emuToPt((this.parseDoubleAttr(co "x"))))
            shape.chY = (PptxUnits.emuToPt((this.parseDoubleAttr(co "y"))))
        }
        def chExt@(optional):XmlNode (xfrm.firstChild("chExt"))
        if (!null? chExt) {
            def ce:XmlNode (unwrap chExt)
            shape.chW = (PptxUnits.emuToPt((this.parseDoubleAttr(ce "cx"))))
            shape.chH = (PptxUnits.emuToPt((this.parseDoubleAttr(ce "cy"))))
        }
    }

    fn applyRPrToRun:void (rp:XmlNode run:PptxTextRun) {
        def sz:string (rp.attr("sz"))
        if ((strlen sz) > 0) {
            def sd@(optional):double (str2double sz)
            run.fontSizePt = (PptxUnits.hundredthsPtToPt((?? sd 1800.0)))
            run.sizeSet = true
        }
        ; What the run SAID, not just whether it said yes. `b="0"` takes a word
        ; out of a bold placeholder; no `b` at all lets the placeholder decide.
        ; The list-level parser below has always read it this way.
        def bAttr:string (rp.attr("b"))
        if ((strlen bAttr) > 0) {
            run.bold = (bAttr == "1")
            run.boldSet = true
        }
        def iAttr:string (rp.attr("i"))
        if ((strlen iAttr) > 0) {
            run.italic = (iAttr == "1")
            run.italicSet = true
        }
        def latin@(optional):XmlNode (rp.firstChild("latin"))
        if (!null? latin) {
            def ln:XmlNode (unwrap latin)
            def tf:string (ln.attr("typeface"))
            if ((strlen tf) > 0) {
                run.fontFamily = tf
            }
        }
        def col@(optional):PptxColor (this.parseColor(rp))
        if (!null? col) {
            run.color = (unwrap col)
            run.colorStated = true
        }
        def hl@(optional):XmlNode (rp.firstChild("highlight"))
        if (!null? hl) {
            def hc@(optional):PptxColor (this.colorIn((unwrap hl)))
            if (!null? hc) {
                run.highlight = (unwrap hc)
            }
        }
    }

    ; --- list styles ----------------------------------------------------------
    ;
    ; `a:lvl1pPr` … `a:lvl9pPr`, or `a:defPPr` standing for all of them. Every
    ; value carries a flag rather than a default, because these are merged down
    ; a chain and a level that says nothing must not overwrite one that does.

    fn parseLevelStyle:void (node:XmlNode lvl:PptxLevelStyle) {
        def algn:string (node.attr("algn"))
        if ((strlen algn) > 0) {
            lvl.align = algn
            lvl.alignSet = true
        }
        def marL:string (node.attr("marL"))
        if ((strlen marL) > 0) {
            def m@(optional):double (str2double marL)
            lvl.marginLeftPt = (PptxUnits.emuToPt((?? m 0.0)))
            lvl.marginSet = true
        }
        def indent:string (node.attr("indent"))
        if ((strlen indent) > 0) {
            def d@(optional):double (str2double indent)
            lvl.indentPt = (PptxUnits.emuToPt((?? d 0.0)))
            lvl.indentSet = true
        }
        def spcBef@(optional):XmlNode (node.firstChild("spcBef"))
        if (!null? spcBef) {
            def v:double (this.spacingPoints((unwrap spcBef)))
            if (v >= 0.0) {
                lvl.spaceBeforePt = v
                lvl.spaceBeforeSet = true
            }
        }
        def spcAft@(optional):XmlNode (node.firstChild("spcAft"))
        if (!null? spcAft) {
            def v2:double (this.spacingPoints((unwrap spcAft)))
            if (v2 >= 0.0) {
                lvl.spaceAfterPt = v2
                lvl.spaceAfterSet = true
            }
        }
        def lnSpc@(optional):XmlNode (node.firstChild("lnSpc"))
        if (!null? lnSpc) {
            def pct@(optional):XmlNode ((unwrap lnSpc).firstChild("spcPct"))
            if (!null? pct) {
                def pv@(optional):double (str2double ((unwrap pct).attr("val")))
                lvl.lineSpacingPct = ((?? pv 100000.0) / 1000.0)
                lvl.lineSpacingSet = true
            }
        }
        ; The bullet.
        def none@(optional):XmlNode (node.firstChild("buNone"))
        if (!null? none) {
            lvl.bulletKind = "none"
        }
        def ch@(optional):XmlNode (node.firstChild("buChar"))
        if (!null? ch) {
            def c:string ((unwrap ch).attr("char"))
            lvl.bulletKind = "char"
            if ((strlen c) > 0) {
                lvl.bulletChar = c
            }
        }
        def num@(optional):XmlNode (node.firstChild("buAutoNum"))
        if (!null? num) {
            def nn:XmlNode (unwrap num)
            lvl.bulletKind = "autonum"
            def sch:string (nn.attr("type"))
            if ((strlen sch) > 0) {
                lvl.bulletScheme = sch
            }
            def st:string (nn.attr("startAt"))
            if ((strlen st) > 0) {
                def sv@(optional):int (str2int st)
                lvl.bulletStartAt = (?? sv 1)
            }
        }
        def bf@(optional):XmlNode (node.firstChild("buFont"))
        if (!null? bf) {
            def tf:string ((unwrap bf).attr("typeface"))
            if ((strlen tf) > 0) {
                lvl.bulletFont = tf
            }
        }
        def bc@(optional):XmlNode (node.firstChild("buClr"))
        if (!null? bc) {
            def col@(optional):PptxColor (this.colorIn((unwrap bc)))
            if (!null? col) {
                lvl.bulletColor = (unwrap col)
            }
        }
        def bsp@(optional):XmlNode (node.firstChild("buSzPct"))
        if (!null? bsp) {
            def pv2@(optional):double (str2double ((unwrap bsp).attr("val")))
            lvl.bulletSizePct = ((?? pv2 100000.0) / 1000.0)
            lvl.bulletSizePctSet = true
        }
        def bst@(optional):XmlNode (node.firstChild("buSzPts"))
        if (!null? bst) {
            def tv@(optional):double (str2double ((unwrap bst).attr("val")))
            lvl.bulletSizePt = (PptxUnits.hundredthsPtToPt((?? tv 1800.0)))
            lvl.bulletSizePtSet = true
        }
        ; The run properties this level gives its text.
        def rpr@(optional):XmlNode (node.firstChild("defRPr"))
        if (null? rpr) {
            return
        }
        def rp:XmlNode (unwrap rpr)
        def sz:string (rp.attr("sz"))
        if ((strlen sz) > 0) {
            def sd@(optional):double (str2double sz)
            lvl.fontSizePt = (PptxUnits.hundredthsPtToPt((?? sd 1800.0)))
            lvl.sizeSet = true
        }
        def b:string (rp.attr("b"))
        if ((strlen b) > 0) {
            lvl.bold = (b == "1")
            lvl.boldSet = true
        }
        def it:string (rp.attr("i"))
        if ((strlen it) > 0) {
            lvl.italic = (it == "1")
            lvl.italicSet = true
        }
        def latin@(optional):XmlNode (rp.firstChild("latin"))
        if (!null? latin) {
            def tf2:string ((unwrap latin).attr("typeface"))
            if ((strlen tf2) > 0) {
                lvl.fontFamily = tf2
            }
        }
        def col2@(optional):PptxColor (this.parseColor(rp))
        if (!null? col2) {
            lvl.color = (unwrap col2)
        }
    }

    ; A `spcBef` / `spcAft` in points, or -1 when it is stated as a percentage
    ; this reader does not turn into points without knowing the font size.
    fn spacingPoints:double (node:XmlNode) {
        def pts@(optional):XmlNode (node.firstChild("spcPts"))
        if (!null? pts) {
            def v@(optional):double (str2double ((unwrap pts).attr("val")))
            return (PptxUnits.hundredthsPtToPt((?? v 0.0)))
        }
        return (0.0 - 1.0)
    }

    fn parseListStyle:void (node:XmlNode style:PptxListStyle) {
        def any:boolean false
        def def0@(optional):XmlNode (node.firstChild("defPPr"))
        if (!null? def0) {
            ; `defPPr` stands for every level that does not state itself.
            def i:int 0
            while (i < 9) {
                this.parseLevelStyle((unwrap def0) (style.at(i)))
                i = (i + 1)
            }
            any = true
        }
        def names:[string] ([] _:string ( "lvl1pPr" "lvl2pPr" "lvl3pPr" "lvl4pPr" "lvl5pPr" "lvl6pPr" "lvl7pPr" "lvl8pPr" "lvl9pPr" ))
        def k:int 0
        while (k < 9) {
            def hit@(optional):XmlNode (node.firstChild((itemAt names k)))
            if (!null? hit) {
                this.parseLevelStyle((unwrap hit) (style.at(k)))
                any = true
            }
            k = (k + 1)
        }
        if any {
            style.isSet = true
        }
    }

    fn parseLstStyleDefaults:void (txBody:XmlNode body:PptxTextBody) {
        def lst@(optional):XmlNode (txBody.firstChild("lstStyle"))
        if (null? lst) {
            return
        }
        def ls:XmlNode (unwrap lst)
        this.parseListStyle(ls body.listStyle)
        ; Prefer lvl1pPr, then defPPr
        def lvl@(optional):XmlNode (ls.firstChild("lvl1pPr"))
        if (null? lvl) {
            lvl = (ls.firstChild("defPPr"))
        }
        if (null? lvl) {
            return
        }
        def ln:XmlNode (unwrap lvl)
        def algn:string (ln.attr("algn"))
        if ((strlen algn) > 0) {
            body.defAlign = algn
        }
        def defRPr@(optional):XmlNode (ln.firstChild("defRPr"))
        if (null? defRPr) {
            return
        }
        def rp:XmlNode (unwrap defRPr)
        body.hasDefRPr = true
        def sz:string (rp.attr("sz"))
        if ((strlen sz) > 0) {
            def sd@(optional):double (str2double sz)
            body.defFontSizePt = (PptxUnits.hundredthsPtToPt((?? sd 1800.0)))
        }
        def defB:string (rp.attr("b"))
        if ((strlen defB) > 0) {
            body.defBold = (defB == "1")
            body.defBoldSet = true
        }
        def defI:string (rp.attr("i"))
        if ((strlen defI) > 0) {
            body.defItalic = (defI == "1")
            body.defItalicSet = true
        }
        def latin@(optional):XmlNode (rp.firstChild("latin"))
        if (!null? latin) {
            def tf:string ((unwrap latin).attr("typeface"))
            if ((strlen tf) > 0) {
                body.defFontFamily = tf
            }
        }
        def col@(optional):PptxColor (this.parseColor(rp))
        if (!null? col) {
            body.defColor = (unwrap col)
        }
    }

    fn parseTextBody:PptxTextBody (txBody:XmlNode) {
        def body (new PptxTextBody())
        def bodyPr@(optional):XmlNode (txBody.firstChild("bodyPr"))
        if (!null? bodyPr) {
            def bp:XmlNode (unwrap bodyPr)
            def lIns:string (bp.attr("lIns"))
            if ((strlen lIns) > 0) {
                def ld@(optional):double (str2double lIns)
                body.insetL = (PptxUnits.emuToPt((?? ld 0.0)))
                body.insetsSet = true
            }
            def tIns:string (bp.attr("tIns"))
            if ((strlen tIns) > 0) {
                def td@(optional):double (str2double tIns)
                body.insetT = (PptxUnits.emuToPt((?? td 0.0)))
                body.insetsSet = true
            }
            def rIns:string (bp.attr("rIns"))
            if ((strlen rIns) > 0) {
                def rd@(optional):double (str2double rIns)
                body.insetR = (PptxUnits.emuToPt((?? rd 0.0)))
                body.insetsSet = true
            }
            def bIns:string (bp.attr("bIns"))
            if ((strlen bIns) > 0) {
                def bd@(optional):double (str2double bIns)
                body.insetB = (PptxUnits.emuToPt((?? bd 0.0)))
                body.insetsSet = true
            }
            def anc:string (bp.attr("anchor"))
            if ((strlen anc) > 0) {
                body.anchor = anc
                body.anchorSet = true
            }
            def wrap:string (bp.attr("wrap"))
            if (wrap == "none") {
                body.wrap = false
            }
            ; `a:normAutofit` — PowerPoint already worked out how much the text
            ; had to shrink to fit this box and wrote the answer down. Drawing
            ; it at full size in a box sized for the shrunken version is the
            ; overflow a reader that ignores this always has.
            def fit@(optional):XmlNode (bp.firstChild("normAutofit"))
            if (!null? fit) {
                def fn:XmlNode (unwrap fit)
                def fs:string (fn.attr("fontScale"))
                if ((strlen fs) > 0) {
                    def fv@(optional):double (str2double fs)
                    body.fontScale = ((?? fv 100000.0) / 100000.0)
                }
                def ls2:string (fn.attr("lnSpcReduction"))
                if ((strlen ls2) > 0) {
                    def lv2@(optional):double (str2double ls2)
                    body.lineScale = (1.0 - ((?? lv2 0.0) / 100000.0))
                }
            }
        }
        this.parseLstStyleDefaults(txBody body)
        def paras:[XmlNode] (txBody.childrenNamed("p"))
        def i:int 0
        while (i < (array_length paras)) {
            def pnode:XmlNode (itemAt paras i)
            def para (new PptxParagraph())
            def pPr@(optional):XmlNode (pnode.firstChild("pPr"))
            if (!null? pPr) {
                def pp:XmlNode (unwrap pPr)
                def algn:string (pp.attr("algn"))
                if ((strlen algn) > 0) {
                    para.align = algn
                    para.alignSet = true
                }
                ; The direction, read before the alignment default below
                ; because it decides what "unaligned" means.
                def rtlS:string (pp.attr("rtl"))
                if ((strlen rtlS) > 0) {
                    para.rtl = 0
                    if ((rtlS == "1") || (rtlS == "true")) {
                        para.rtl = 1
                    }
                }
                ; A right-to-left paragraph with no `algn` on it is set
                ; against the RIGHT edge of its box. PowerPoint does not write
                ; an alignment for that — the direction IS the alignment — so
                ; a reader that only looks at `algn` puts every Arabic
                ; paragraph in the deck against the left edge.
                if (para.rtl == 1) {
                    if (para.alignSet == false) {
                        para.align = "r"
                    }
                }
                def lvlS:string (pp.attr("lvl"))
                if ((strlen lvlS) > 0) {
                    def lv@(optional):int (str2int lvlS)
                    para.level = (?? lv 0)
                }
                ; A stated margin or indent — including a stated zero, which is
                ; how a deck cancels the level's indent for one paragraph.
                def marL2:string (pp.attr("marL"))
                if ((strlen marL2) > 0) {
                    def mv@(optional):double (str2double marL2)
                    para.marginLeftPt = (PptxUnits.emuToPt((?? mv 0.0)))
                    para.marginSet = true
                }
                def ind2:string (pp.attr("indent"))
                if ((strlen ind2) > 0) {
                    def iv@(optional):double (str2double ind2)
                    para.indentPt = (PptxUnits.emuToPt((?? iv 0.0)))
                    para.indentSet = true
                }
                ; A paragraph can state its bullet's colour, size and face as
                ; well as its character — and a deck saved out of this reader
                ; does exactly that, because there is no master left to inherit
                ; them from.
                def buClr@(optional):XmlNode (pp.firstChild("buClr"))
                if (!null? buClr) {
                    def bcol@(optional):PptxColor (this.colorIn((unwrap buClr)))
                    if (!null? bcol) {
                        para.bulletColor = (unwrap bcol)
                    }
                }
                def buSzPct@(optional):XmlNode (pp.firstChild("buSzPct"))
                if (!null? buSzPct) {
                    def bp@(optional):double (str2double ((unwrap buSzPct).attr("val")))
                    para.bulletSizePct = ((?? bp 100000.0) / 1000.0)
                }
                def buSzPts@(optional):XmlNode (pp.firstChild("buSzPts"))
                if (!null? buSzPts) {
                    def bt@(optional):double (str2double ((unwrap buSzPts).attr("val")))
                    para.bulletSizePt = (PptxUnits.hundredthsPtToPt((?? bt 1800.0)))
                }
                def buFont@(optional):XmlNode (pp.firstChild("buFont"))
                if (!null? buFont) {
                    def btf:string ((unwrap buFont).attr("typeface"))
                    if ((strlen btf) > 0) {
                        para.bulletFont = btf
                    }
                }
                def buChar@(optional):XmlNode (pp.firstChild("buChar"))
                def buNone@(optional):XmlNode (pp.firstChild("buNone"))
                def buAuto@(optional):XmlNode (pp.firstChild("buAutoNum"))
                if (!null? buNone) {
                    para.hasBullet = false
                    para.bulletSet = true
                } {
                    if (!null? buChar) {
                        para.hasBullet = true
                        para.bulletSet = true
                        def ch:string ((unwrap buChar).attr("char"))
                        if ((strlen ch) > 0) {
                            para.bulletChar = ch
                        }
                    } {
                        if (!null? buAuto) {
                            def ba:XmlNode (unwrap buAuto)
                            para.hasBullet = true
                            para.bulletAutoNum = true
                            para.bulletSet = true
                            def bsch:string (ba.attr("type"))
                            if ((strlen bsch) > 0) {
                                para.bulletScheme = bsch
                            }
                            def bst:string (ba.attr("startAt"))
                            if ((strlen bst) > 0) {
                                def bsv@(optional):int (str2int bst)
                                para.bulletStartAt = (?? bsv 1)
                            }
                        } {
                            if (!null? buFont) {
                                para.hasBullet = true
                                para.bulletSet = true
                            }
                        }
                    }
                }
                def spcBef@(optional):XmlNode (pp.firstChild("spcBef"))
                if (!null? spcBef) {
                    def spc:XmlNode (unwrap spcBef)
                    def pts@(optional):XmlNode (spc.firstChild("spcPts"))
                    if (!null? pts) {
                        def pv@(optional):double (str2double ((unwrap pts).attr("val")))
                        para.spaceBeforePt = ((?? pv 0.0) / 100.0)
                    }
                }
                def spcAft@(optional):XmlNode (pp.firstChild("spcAft"))
                if (!null? spcAft) {
                    def spa:XmlNode (unwrap spcAft)
                    def pts2@(optional):XmlNode (spa.firstChild("spcPts"))
                    if (!null? pts2) {
                        def pv2@(optional):double (str2double ((unwrap pts2).attr("val")))
                        para.spaceAfterPt = ((?? pv2 0.0) / 100.0)
                    }
                }
                def lnSpc@(optional):XmlNode (pp.firstChild("lnSpc"))
                if (!null? lnSpc) {
                    def lsp:XmlNode (unwrap lnSpc)
                    def pct@(optional):XmlNode (lsp.firstChild("spcPct"))
                    if (!null? pct) {
                        def pcv@(optional):double (str2double ((unwrap pct).attr("val")))
                        para.lineSpacingPct = ((?? pcv 100000.0) / 1000.0)
                    }
                }
            }
            ; Runs and FIELDS, in the order the paragraph has them: a page
            ; number sits between words often enough that reading the runs
            ; first and the fields after would reorder the line.
            def j:int 0
            while (j < (pnode.childCount())) {
                def child:XmlNode (pnode.childAt(j))
                def isRun:boolean false
                def isField:boolean false
                def isBreak:boolean false
                if (child.isText == false) {
                    if (child.name == "r") {
                        isRun = true
                    }
                    if (child.name == "fld") {
                        isField = true
                    }
                    ; `<a:br/>` — shift+Enter. A line inside a paragraph, not
                    ; a paragraph of its own: it keeps the paragraph's bullet,
                    ; its number and its spacing. Carried as a newline in the
                    ; run text, which is what the layout breaks on and what
                    ; the writer turns back into a `br`.
                    if (child.name == "br") {
                        isBreak = true
                    }
                }
                if isBreak {
                    def brk (new PptxTextRun())
                    def brPr@(optional):XmlNode (child.firstChild("rPr"))
                    if (!null? brPr) {
                        this.applyRPrToRun((unwrap brPr) brk)
                    }
                    brk.text = "\n"
                    push para.runs brk
                }
                if (isRun || isField) {
                    def run (new PptxTextRun())
                    def rPr@(optional):XmlNode (child.firstChild("rPr"))
                    if (!null? rPr) {
                        this.applyRPrToRun((unwrap rPr) run)
                    }
                    def t@(optional):XmlNode (child.firstChild("t"))
                    if (!null? t) {
                        def tn:XmlNode (unwrap t)
                        run.text = (tn.textContent())
                    }
                    if isField {
                        run.field = (child.attr("type"))
                        if ((strlen run.field) == 0) {
                            run.field = "slidenum"
                        }
                    }
                    push para.runs run
                }
                j = (j + 1)
            }
            push body.paragraphs para
            i = (i + 1)
        }
        return body
    }

    fn parsePlaceholderAttrs:void (sp:XmlNode shape:PptxShape) {
        def nv@(optional):XmlNode (sp.firstChild("nvSpPr"))
        if (null? nv) {
            ; Pictures use nvPicPr
            nv = (sp.firstChild("nvPicPr"))
        }
        if (null? nv) {
            return
        }
        def nvPr@(optional):XmlNode ((unwrap nv).firstChild("nvPr"))
        if (null? nvPr) {
            return
        }
        def ph@(optional):XmlNode ((unwrap nvPr).firstChild("ph"))
        if (null? ph) {
            return
        }
        def phn:XmlNode (unwrap ph)
        shape.isPlaceholder = true
        def typ:string (phn.attr("type"))
        if ((strlen typ) > 0) {
            shape.phType = typ
        } {
            ; OOXML: omitted type means body
            shape.phType = "body"
        }
        def idxS:string (phn.attr("idx"))
        if ((strlen idxS) > 0) {
            def id@(optional):int (str2int idxS)
            shape.phIdx = (?? id -1)
        }
    }

    fn parseDirectColor@(optional):PptxColor (parent:XmlNode) {
        def srgb@(optional):XmlNode (parent.firstChild("srgbClr"))
        if (!null? srgb) {
            def hex:string ((unwrap srgb).attr("val"))
            if ((strlen hex) == 6) {
                def hit@(optional):PptxColor (PptxColor.srgbOf(hex))
                return hit
            }
        }
        def sch@(optional):XmlNode (parent.firstChild("schemeClr"))
        if (!null? sch) {
            def name:string ((unwrap sch).attr("val"))
            if ((strlen name) > 0) {
                def hit2@(optional):PptxColor (PptxColor.schemeOf(name))
                return hit2
            }
        }
        def viaSolid@(optional):PptxColor (this.parseColor(parent))
        return viaSolid
    }

    fn parseGradient@(optional):PptxGradient (parent:XmlNode) {
        def gf@(optional):XmlNode (parent.firstChild("gradFill"))
        if (null? gf) {
            def __missing@(optional):PptxGradient
            return __missing
        }
        def gnode:XmlNode (unwrap gf)
        def g (new PptxGradient())
        g.isSet = true
        def lin@(optional):XmlNode (gnode.firstChild("lin"))
        if (!null? lin) {
            def angS:string ((unwrap lin).attr("ang"))
            def ang@(optional):double (str2double angS)
            def a:double (?? ang 0.0)
            if (a > 2700000.0) {
                g.dir = 0
            } {
                g.dir = 1
            }
        }
        def gsLst@(optional):XmlNode (gnode.firstChild("gsLst"))
        if (!null? gsLst) {
            def lst:XmlNode (unwrap gsLst)
            def stops:[XmlNode] (lst.childrenNamed("gs"))
            if ((array_length stops) > 0) {
                def c0@(optional):PptxColor (this.parseDirectColor((itemAt stops 0)))
                if (!null? c0) {
                    g.c1 = (unwrap c0)
                }
            }
            if ((array_length stops) > 1) {
                def last:int ((array_length stops) - 1)
                def c1@(optional):PptxColor (this.parseDirectColor((itemAt stops last)))
                if (!null? c1) {
                    g.c2 = (unwrap c1)
                }
            }
        }
        if (g.c1.isSet == false) {
            g.c1 = (PptxColor.srgbOf("4472C4"))
        }
        if (g.c2.isSet == false) {
            g.c2 = (PptxColor.srgbOf("FFFFFF"))
        }
        def hit@(optional):PptxGradient g
        return hit
    }

    fn parseShadow:void (spPr:XmlNode shape:PptxShape) {
        def eff@(optional):XmlNode (spPr.firstChild("effectLst"))
        if (null? eff) {
            return
        }
        def outer@(optional):XmlNode ((unwrap eff).firstChild("outerShdw"))
        if (null? outer) {
            return
        }
        def o:XmlNode (unwrap outer)
        shape.shadow.isSet = true
        def blurS:string (o.attr("blurRad"))
        if ((strlen blurS) > 0) {
            def bd@(optional):double (str2double blurS)
            shape.shadow.blurPt = (PptxUnits.emuToPt((?? bd 0.0)))
        }
        def distS:string (o.attr("dist"))
        def dirS:string (o.attr("dir"))
        def dist:double 0.0
        if ((strlen distS) > 0) {
            def dd@(optional):double (str2double distS)
            dist = (PptxUnits.emuToPt((?? dd 0.0)))
        }
        def dirDeg:double 45.0
        if ((strlen dirS) > 0) {
            def dr@(optional):double (str2double dirS)
            dirDeg = (PptxUnits.rotToDeg((?? dr 2700000.0)))
        }
        ; Approximate offset from polar dist/dir (dir 0 = right in DrawingML)
        ; Use simple quadrant: default down-right.
        shape.shadow.offsetXPt = (dist * 0.7)
        shape.shadow.offsetYPt = (dist * 0.7)
        if (dirDeg > 90.0) {
            if (dirDeg < 180.0) {
                shape.shadow.offsetXPt = (0.0 - (dist * 0.7))
            }
        }
        def col@(optional):PptxColor (this.parseColor(o))
        if (!null? col) {
            shape.shadow.color = (unwrap col)
        } {
            ; Often srgbClr is direct child of outerShdw
            def srgb@(optional):XmlNode (o.firstChild("srgbClr"))
            if (!null? srgb) {
                def hex:string ((unwrap srgb).attr("val"))
                if ((strlen hex) == 6) {
                    shape.shadow.color = (PptxColor.srgbOf(hex))
                }
                def alpha@(optional):XmlNode ((unwrap srgb).firstChild("alpha"))
                if (!null? alpha) {
                    def av@(optional):double (str2double ((unwrap alpha).attr("val")))
                    ; alpha is 1000ths of a percent (100000 = opaque)
                    shape.shadow.alpha = ((?? av 35000.0) / 100000.0)
                }
            }
            def sch@(optional):XmlNode (o.firstChild("schemeClr"))
            if (!null? sch) {
                shape.shadow.color = (PptxColor.schemeOf(((unwrap sch).attr("val"))))
            }
        }
        if (shape.shadow.color.isSet == false) {
            shape.shadow.color = (PptxColor.srgbOf("000000"))
        }
    }

    fn parseCustGeomPath:void (spPr:XmlNode shape:PptxShape) {
        def cust@(optional):XmlNode (spPr.firstChild("custGeom"))
        if (null? cust) {
            return
        }
        def pathLst@(optional):XmlNode ((unwrap cust).firstChild("pathLst"))
        if (null? pathLst) {
            return
        }
        ; EVERY path, not the first one.
        ;
        ; This read `firstChild("path")` and stopped, which is correct for the
        ; one-ring shapes a viewer draws and wrong for anything with a hole in
        ; it: a `<a:pathLst>` with four `<a:path>` under it came back as its
        ; outer contour and nothing else. It also silently discarded the other
        ; half of every shape this writer now produces.
        def paths:[XmlNode] ((unwrap pathLst).childrenNamed("path"))
        if ((array_length paths) == 0) {
            return
        }
        def data:string ""
        def pi:int 0
        while (pi < (array_length paths)) {
            data = (data + (this.custPathData((itemAt paths pi))))
            pi = (pi + 1)
        }
        if ((strlen data) == 0) {
            return
        }
        ; One contour per `<a:path>`, kept apart. `pathEnds` is left empty for
        ; the ordinary one-ring case so nothing downstream has to look at it.
        def rings:[PathRing] (PptxGeom.flattenDataRings(data))
        def pts:[double]
        def ends:[int]
        def ri:int 0
        while (ri < (array_length rings)) {
            def ring:PathRing (itemAt rings ri)
            def k:int 0
            while (k < (array_length ring.pts)) {
                push pts (itemAt ring.pts k)
                k = (k + 1)
            }
            push ends (array_length pts)
            ri = (ri + 1)
        }
        if ((array_length pts) >= 4) {
            shape.hasPath = true
            shape.pathUnit = pts
            if ((array_length rings) > 1) {
                shape.pathEnds = ends
            }
            ; Kept, because the flattening above is about to lose it and the
            ; painter cannot tell a filled shape from a drawn line without it.
            shape.pathClosed = ((indexOf data "Z") >= 0)
        }
    }

    ; @internal One `<a:path>` as SVG path data.
    ;
    ; DrawingML's path grammar is not SVG's, but it says the same things, so it
    ; is TRANSLATED here and flattened by EVG's own path stack. That is what
    ; makes `cubicBezTo`, `quadBezTo` and `arcTo` draw at all: they used to be
    ; skipped, so a curved custom shape came out as a polygon of whichever of
    ; its points happened to be straight lines.
    fn custPathData:string (pnode:XmlNode) {
        def wS:string (pnode.attr("w"))
        def hS:string (pnode.attr("h"))
        def pw:double 1.0
        def ph:double 1.0
        if ((strlen wS) > 0) {
            def wd@(optional):double (str2double wS)
            pw = (?? wd 1.0)
        }
        if ((strlen hS) > 0) {
            def hd@(optional):double (str2double hS)
            ph = (?? hd 1.0)
        }
        if (pw < 1.0) { pw = 1.0 }
        if (ph < 1.0) { ph = 1.0 }
        def data:string ""
        def curX:double 0.0
        def curY:double 0.0
        def i:int 0
        while (i < (pnode.childCount())) {
            def ch:XmlNode (pnode.childAt(i))
            if (ch.isText == false) {
                def kids:[XmlNode] (ch.childrenNamed("pt"))
                if (ch.name == "moveTo") {
                    if ((array_length kids) >= 1) {
                        def m0:XmlNode (itemAt kids 0)
                        curX = ((this.parseDoubleAttr(m0 "x")) / pw)
                        curY = ((this.parseDoubleAttr(m0 "y")) / ph)
                        data = ((data + " M ") + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "lnTo") {
                    if ((array_length kids) >= 1) {
                        def l0:XmlNode (itemAt kids 0)
                        curX = ((this.parseDoubleAttr(l0 "x")) / pw)
                        curY = ((this.parseDoubleAttr(l0 "y")) / ph)
                        data = ((data + " L ") + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "cubicBezTo") {
                    if ((array_length kids) >= 3) {
                        def c1:XmlNode (itemAt kids 0)
                        def c2:XmlNode (itemAt kids 1)
                        def c3:XmlNode (itemAt kids 2)
                        def x1:double ((this.parseDoubleAttr(c1 "x")) / pw)
                        def y1:double ((this.parseDoubleAttr(c1 "y")) / ph)
                        def x2:double ((this.parseDoubleAttr(c2 "x")) / pw)
                        def y2:double ((this.parseDoubleAttr(c2 "y")) / ph)
                        curX = ((this.parseDoubleAttr(c3 "x")) / pw)
                        curY = ((this.parseDoubleAttr(c3 "y")) / ph)
                        data = ((data + " C ") + (PptxGeom.pathNum(x1)) + "," + (PptxGeom.pathNum(y1)) + " " + (PptxGeom.pathNum(x2)) + "," + (PptxGeom.pathNum(y2)) + " " + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "quadBezTo") {
                    if ((array_length kids) >= 2) {
                        def q1:XmlNode (itemAt kids 0)
                        def q2:XmlNode (itemAt kids 1)
                        def qx:double ((this.parseDoubleAttr(q1 "x")) / pw)
                        def qy:double ((this.parseDoubleAttr(q1 "y")) / ph)
                        curX = ((this.parseDoubleAttr(q2 "x")) / pw)
                        curY = ((this.parseDoubleAttr(q2 "y")) / ph)
                        data = ((data + " Q ") + (PptxGeom.pathNum(qx)) + "," + (PptxGeom.pathNum(qy)) + " " + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "arcTo") {
                    ; An arc is stated from where the pen is, as two radii and
                    ; two angles; SVG states it as two radii and where the pen
                    ; ENDS, plus which of the four arcs between them is meant.
                    def wR:double ((this.parseDoubleAttr(ch "wR")) / pw)
                    def hR:double ((this.parseDoubleAttr(ch "hR")) / ph)
                    def stDeg:double ((this.parseDoubleAttr(ch "stAng")) / 60000.0)
                    def swDeg:double ((this.parseDoubleAttr(ch "swAng")) / 60000.0)
                    def rad:double 0.017453292519943295
                    def st:double (stDeg * rad)
                    def en:double ((stDeg + swDeg) * rad)
                    def ccx:double (curX - (wR * (cos st)))
                    def ccy:double (curY - (hR * (sin st)))
                    def ex:double (ccx + (wR * (cos en)))
                    def ey:double (ccy + (hR * (sin en)))
                    def large:string "0"
                    def spanAbs:double (fabs swDeg)
                    if (spanAbs > 180.0) {
                        large = "1"
                    }
                    def sweep:string "0"
                    if (swDeg > 0.0) {
                        sweep = "1"
                    }
                    def rx:double (fabs wR)
                    def ry:double (fabs hR)
                    data = ((data + " A ") + (PptxGeom.pathNum(rx)) + "," + (PptxGeom.pathNum(ry)) + " 0 " + large + " " + sweep + " " + (PptxGeom.pathNum(ex)) + "," + (PptxGeom.pathNum(ey)))
                    curX = ex
                    curY = ey
                }
                if (ch.name == "close") {
                    data = (data + " Z")
                }
            }
            i = (i + 1)
        }
        return data
    }

    fn parseSpPr:void (spPr:XmlNode shape:PptxShape) {
        def xfrm@(optional):XmlNode (spPr.firstChild("xfrm"))
        if (!null? xfrm) {
            this.parseXfrm((unwrap xfrm) shape)
        }
        def geom@(optional):XmlNode (spPr.firstChild("prstGeom"))
        if (!null? geom) {
            def g:XmlNode (unwrap geom)
            def prst:string (g.attr("prst"))
            if ((strlen prst) > 0) {
                shape.preset = prst
            }
        }
        this.parseCustGeomPath(spPr shape)
        def fill@(optional):PptxColor (this.parseColor(spPr))
        if (!null? fill) {
            shape.fill = (unwrap fill)
        }
        def prst@(optional):XmlNode (spPr.firstChild("prstGeom"))
        if (!null? prst) {
            def av@(optional):XmlNode ((unwrap prst).firstChild("avLst"))
            if (!null? av) {
                def gds:[XmlNode] ((unwrap av).childrenNamed("gd"))
                def gi:int 0
                while (gi < (array_length gds)) {
                    def gd:XmlNode (itemAt gds gi)
                    def gname:string (gd.attr("name"))
                    def fmla:string (gd.attr("fmla"))
                    def sp:int (indexOf fmla " ")
                    if (sp >= 0) {
                        def num:string (substring fmla (sp + 1) (strlen fmla))
                        def nv@(optional):double (str2double num)
                        if (!null? nv) {
                            def raw:double (unwrap nv)
                            ; EVERY adjustment, under its own name, in the
                            ; unit the formulas use — hundred-thousandths.
                            ;
                            ; Only the one called `adj` was read before, and
                            ; only as a fraction for the rounded rectangle.
                            ; A callout states four and an arrow two, so a
                            ; deck's arrows came out with the author's head
                            ; length and the default shaft width.
                            push shape.adjNames gname
                            push shape.adjValues raw
                            if (gname == "adj") {
                                shape.adj = (raw / 100000.0)
                            }
                        }
                    }
                    gi = (gi + 1)
                }
            }
        }
        def grad@(optional):PptxGradient (this.parseGradient(spPr))
        if (!null? grad) {
            shape.fillGrad = (unwrap grad)
        }
        ; noFill explicitly clears
        def nf@(optional):XmlNode (spPr.firstChild("noFill"))
        if (!null? nf) {
            shape.fill = (new PptxColor())
            shape.fillGrad = (new PptxGradient())
            shape.noFill = true
        }
        def ln@(optional):XmlNode (spPr.firstChild("ln"))
        if (!null? ln) {
            def lineNode:XmlNode (unwrap ln)
            def w:string (lineNode.attr("w"))
            if ((strlen w) > 0) {
                def wd@(optional):double (str2double w)
                shape.lineWidthPt = (PptxUnits.emuToPt((?? wd 0.0)))
            }
            def lc@(optional):PptxColor (this.parseColor(lineNode))
            if (!null? lc) {
                shape.line = (unwrap lc)
            }
            def lnf@(optional):XmlNode (lineNode.firstChild("noFill"))
            if (!null? lnf) {
                shape.noLine = true
                shape.line = (new PptxColor())
            }
            ; The arrowheads a connector carries. A line with an arrow on it is
            ; a different picture from a line without one, and it is these two
            ; elements that say so.
            def head@(optional):XmlNode (lineNode.firstChild("headEnd"))
            if (!null? head) {
                shape.headEnd = ((unwrap head).attr("type"))
            }
            def tail@(optional):XmlNode (lineNode.firstChild("tailEnd"))
            if (!null? tail) {
                shape.tailEnd = ((unwrap tail).attr("type"))
            }
        }
        this.parseShadow(spPr shape)
    }

    fn parseShape:PptxShape (sp:XmlNode) {
        def shape (new PptxShape())
        shape.kind = (PptxShapeKind.shape())
        def nv@(optional):XmlNode (sp.firstChild("nvSpPr"))
        if (!null? nv) {
            def nvn:XmlNode (unwrap nv)
            def cNv@(optional):XmlNode (nvn.firstChild("cNvPr"))
            if (!null? cNv) {
                def cn:XmlNode (unwrap cNv)
                shape.name = (cn.attr("name"))
                shape.altText = (cn.attr("descr"))
                def sid@(optional):int (str2int (cn.attr("id")))
                shape.shapeId = (?? sid 0)
            }
            ; `a:spLocks` is how a deck says a shape is not to be dragged.
            ; Any of the three we care about counts as locked, because an
            ; editor that let you move a shape it refuses to resize would be
            ; the worst of both.
            def sp2@(optional):XmlNode (nvn.firstChild("cNvSpPr"))
            if (!null? sp2) {
                def locks@(optional):XmlNode ((unwrap sp2).firstChild("spLocks"))
                if (!null? locks) {
                    def ln:XmlNode (unwrap locks)
                    if ((ln.attr("noMove")) == "1") {
                        shape.locked = true
                    }
                    if ((ln.attr("noResize")) == "1") {
                        shape.locked = true
                    }
                    if ((ln.attr("noSelect")) == "1") {
                        shape.locked = true
                    }
                }
            }
        }
        this.parsePlaceholderAttrs(sp shape)
        def spPr@(optional):XmlNode (sp.firstChild("spPr"))
        if (!null? spPr) {
            this.parseSpPr((unwrap spPr) shape)
        }
        this.parseStyle(sp shape)
        def tx@(optional):XmlNode (sp.firstChild("txBody"))
        if (!null? tx) {
            shape.hasText = true
            shape.text = (this.parseTextBody((unwrap tx)))
        }
        return shape
    }

    fn parsePicture:PptxShape (pic:XmlNode slidePart:string) {
        def shape (new PptxShape())
        shape.kind = (PptxShapeKind.picture())
        def nv@(optional):XmlNode (pic.firstChild("nvPicPr"))
        if (!null? nv) {
            def nvn:XmlNode (unwrap nv)
            def cNv@(optional):XmlNode (nvn.firstChild("cNvPr"))
            if (!null? cNv) {
                def cn:XmlNode (unwrap cNv)
                shape.name = (cn.attr("name"))
                shape.altText = (cn.attr("descr"))
                def sid@(optional):int (str2int (cn.attr("id")))
                shape.shapeId = (?? sid 0)
            }
        }
        def blipFill@(optional):XmlNode (pic.firstChild("blipFill"))
        if (!null? blipFill) {
            def bf:XmlNode (unwrap blipFill)
            def blip@(optional):XmlNode (bf.firstChild("blip"))
            if (!null? blip) {
                def b:XmlNode (unwrap blip)
                def rid:string (b.attr("r:embed"))
                if ((strlen rid) == 0) {
                    rid = (b.attr("embed"))
                }
                shape.imageRid = rid
                if ((strlen rid) > 0) {
                    shape.imagePart = (pkg.resolveRelationship(slidePart rid))
                    if ((strlen shape.imagePart) > 0) {
                        shape.imageBytes = (pkg.readBinary(shape.imagePart))
                    }
                }
            }
        }
        def spPr@(optional):XmlNode (pic.firstChild("spPr"))
        if (!null? spPr) {
            this.parseSpPr((unwrap spPr) shape)
        }
        return shape
    }

    fn parseGroup:PptxShape (grp:XmlNode slidePart:string) {
        def shape (new PptxShape())
        shape.kind = (PptxShapeKind.group())
        def nv@(optional):XmlNode (grp.firstChild("nvGrpSpPr"))
        if (!null? nv) {
            def nvn:XmlNode (unwrap nv)
            def cNv@(optional):XmlNode (nvn.firstChild("cNvPr"))
            if (!null? cNv) {
                def cn:XmlNode (unwrap cNv)
                shape.name = (cn.attr("name"))
                shape.altText = (cn.attr("descr"))
                def sid@(optional):int (str2int (cn.attr("id")))
                shape.shapeId = (?? sid 0)
            }
        }
        def grpSpPr@(optional):XmlNode (grp.firstChild("grpSpPr"))
        if (!null? grpSpPr) {
            def gsp:XmlNode (unwrap grpSpPr)
            def xfrm@(optional):XmlNode (gsp.firstChild("xfrm"))
            if (!null? xfrm) {
                this.parseXfrm((unwrap xfrm) shape)
            }
        }
        ; Children: sp / pic / grpSp / cxnSp
        def i:int 0
        while (i < (grp.childCount())) {
            def child:XmlNode (grp.childAt(i))
            if (child.isText == false) {
                def parsed@(optional):PptxShape (this.parseTreeChild(child slidePart))
                if (!null? parsed) {
                    push shape.children (unwrap parsed)
                }
            }
            i = (i + 1)
        }
        return shape
    }

    fn parseTableLine:void (tcPr:XmlNode name:string out:PptxTableLine) {
        def hit@(optional):XmlNode (tcPr.firstChild(name))
        if (null? hit) {
            return
        }
        def node:XmlNode (unwrap hit)
        out.isSet = true
        def w:string (node.attr("w"))
        if ((strlen w) > 0) {
            def wv@(optional):double (str2double w)
            out.widthPt = (PptxUnits.emuToPt((?? wv 9525.0)))
        }
        def nf@(optional):XmlNode (node.firstChild("noFill"))
        if (!null? nf) {
            out.isSet = false
            return
        }
        def solid@(optional):XmlNode (node.firstChild("solidFill"))
        if (!null? solid) {
            def col@(optional):PptxColor (this.colorIn((unwrap solid)))
            if (!null? col) {
                out.color = (unwrap col)
            }
        }
    }

    fn tableMargin:double (node:XmlNode name:string fallback:double) {
        def v:string (node.attr(name))
        if ((strlen v) == 0) {
            return fallback
        }
        def d@(optional):double (str2double v)
        if (null? d) {
            return fallback
        }
        return (PptxUnits.emuToPt((unwrap d)))
    }

    fn parseTableCell:PptxTableCell (tc:XmlNode) {
        def cell (new PptxTableCell())
        ; A covered cell of a merge draws nothing; the cell that spans over it
        ; is the one with the words.
        if ((tc.attr("hMerge")) == "1") {
            cell.merged = true
        }
        if ((tc.attr("vMerge")) == "1") {
            cell.merged = true
        }
        def span@(optional):int (str2int (tc.attr("gridSpan")))
        if (!null? span) {
            def sv:int (unwrap span)
            if (sv > 1) {
                cell.gridSpan = sv
            }
        }
        def rspan@(optional):int (str2int (tc.attr("rowSpan")))
        if (!null? rspan) {
            def rv:int (unwrap rspan)
            if (rv > 1) {
                cell.rowSpan = rv
            }
        }
        def txBody@(optional):XmlNode (tc.find("txBody"))
        if (!null? txBody) {
            def body:PptxTextBody (this.parseTextBody((unwrap txBody)))
            cell.body = body
            cell.text = (body.plainText())
            if ((array_length body.paragraphs) > 0) {
                def para:PptxParagraph (itemAt body.paragraphs 0)
                cell.align = para.align
                if ((array_length para.runs) > 0) {
                    def run:PptxTextRun (itemAt para.runs 0)
                    cell.fontSizePt = run.fontSizePt
                    cell.bold = run.bold
                }
            }
        }
        def tcPr@(optional):XmlNode (tc.firstChild("tcPr"))
        if (!null? tcPr) {
            def pr:XmlNode (unwrap tcPr)
            def fill@(optional):PptxColor (this.parseColor(pr))
            if (!null? fill) {
                cell.fill = (unwrap fill)
            }
            def anchor:string (pr.attr("anchor"))
            if ((strlen anchor) > 0) {
                cell.anchor = anchor
            }
            cell.marLPt = (this.tableMargin(pr "marL" cell.marLPt))
            cell.marRPt = (this.tableMargin(pr "marR" cell.marRPt))
            cell.marTPt = (this.tableMargin(pr "marT" cell.marTPt))
            cell.marBPt = (this.tableMargin(pr "marB" cell.marBPt))
            this.parseTableLine(pr "lnL" cell.lnL)
            this.parseTableLine(pr "lnR" cell.lnR)
            this.parseTableLine(pr "lnT" cell.lnT)
            this.parseTableLine(pr "lnB" cell.lnB)
        }
        return cell
    }

    fn parseTable:PptxShape (tbl:XmlNode x:double y:double w:double h:double) {
        def shape (new PptxShape())
        shape.kind = (PptxShapeKind.table())
        shape.name = "Table"
        shape.x = x
        shape.y = y
        shape.width = w
        shape.height = h
        shape.hasXfrm = true
        shape.hasOff = true
        shape.hasExt = ((w > 0.0) && (h > 0.0))
        def grid@(optional):XmlNode (tbl.firstChild("tblGrid"))
        def cols:int 0
        if (!null? grid) {
            def gcs:[XmlNode] ((unwrap grid).childrenNamed("gridCol"))
            cols = (array_length gcs)
            def gi:int 0
            while (gi < (array_length gcs)) {
                def gc:XmlNode (itemAt gcs gi)
                push shape.tableColW (PptxUnits.emuToPt((this.parseDoubleAttr(gc "w"))))
                gi = (gi + 1)
            }
        }
        def rows:[XmlNode] (tbl.childrenNamed("tr"))
        shape.tableRows = (array_length rows)
        shape.tableCols = cols
        ; A table's real size is the grid it states, not the frame around it:
        ; PowerPoint treats `p:xfrm/a:ext` as advisory and some writers put a
        ; round placeholder there (3000000 × 3000000), which drew every table
        ; in those decks as a small square with the text piled up inside it.
        def gridW:double 0.0
        def gw:int 0
        while (gw < (array_length shape.tableColW)) {
            gridW = (gridW + (itemAt shape.tableColW gw))
            gw = (gw + 1)
        }
        if (gridW > 0.0) {
            shape.width = gridW
        }
        def ri:int 0
        while (ri < (array_length rows)) {
            def tr:XmlNode (itemAt rows ri)
            push shape.tableRowH (PptxUnits.emuToPt((this.parseDoubleAttr(tr "h"))))
            def tcs:[XmlNode] (tr.childrenNamed("tc"))
            if ((array_length tcs) > shape.tableCols) {
                shape.tableCols = (array_length tcs)
            }
            def ci:int 0
            while (ci < (array_length tcs)) {
                push shape.tableCells (this.parseTableCell((itemAt tcs ci)))
                ci = (ci + 1)
            }
            ; Pad row if short
            while (ci < shape.tableCols) {
                push shape.tableCells (new PptxTableCell())
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        def gridH:double 0.0
        def gh:int 0
        while (gh < (array_length shape.tableRowH)) {
            gridH = (gridH + (itemAt shape.tableRowH gh))
            gh = (gh + 1)
        }
        ; A row's stated height is a MINIMUM — it grows to fit its words — so
        ; the sum of them wins over the frame only when it is the larger.
        if (gridH > shape.height) {
            shape.height = gridH
        }
        return shape
    }

    fn parseChartPart:PptxChart (chartPart:string) {
        def chart (new PptxChart())
        def xml:string (pkg.readXml(chartPart))
        if ((strlen xml) == 0) {
            return chart
        }
        def root@(optional):XmlNode (xmlParser.parse(xml))
        if (null? root) {
            return chart
        }
        def doc:XmlNode (unwrap root)
        def title@(optional):XmlNode (doc.find("title"))
        if (!null? title) {
            def t:XmlNode (unwrap title)
            def tv@(optional):XmlNode (t.find("t"))
            if (!null? tv) {
                chart.title = ((unwrap tv).textContent())
            }
        }
        def bar@(optional):XmlNode (doc.find("barChart"))
        if (!null? bar) {
            chart.chartType = "bar"
        }
        def line@(optional):XmlNode (doc.find("lineChart"))
        if (!null? line) {
            chart.chartType = "line"
        }
        def pie@(optional):XmlNode (doc.find("pieChart"))
        if (!null? pie) {
            chart.chartType = "pie"
        }
        ; Categories from first ser/cat/strRef/strCache or numCache
        def ser@(optional):XmlNode (doc.find("ser"))
        if (null? ser) {
            return chart
        }
        def snode:XmlNode (unwrap ser)
        def series (new PptxChartSeries())
        def tx@(optional):XmlNode (snode.firstChild("tx"))
        if (!null? tx) {
            def vt@(optional):XmlNode ((unwrap tx).find("v"))
            if (!null? vt) {
                series.name = ((unwrap vt).textContent())
            }
        }
        def cat@(optional):XmlNode (snode.firstChild("cat"))
        if (!null? cat) {
            def cache@(optional):XmlNode ((unwrap cat).find("strCache"))
            if (null? cache) {
                cache = ((unwrap cat).find("numCache"))
            }
            if (!null? cache) {
                def pts2:[XmlNode] ((unwrap cache).childrenNamed("pt"))
                def pi:int 0
                while (pi < (array_length pts2)) {
                    def pt:XmlNode (itemAt pts2 pi)
                    def v@(optional):XmlNode (pt.firstChild("v"))
                    if (!null? v) {
                        push chart.categories ((unwrap v).textContent())
                    }
                    pi = (pi + 1)
                }
            }
        }
        def val@(optional):XmlNode (snode.firstChild("val"))
        if (!null? val) {
            def ncache@(optional):XmlNode ((unwrap val).find("numCache"))
            if (!null? ncache) {
                def vpts:[XmlNode] ((unwrap ncache).childrenNamed("pt"))
                def vi:int 0
                while (vi < (array_length vpts)) {
                    def vp:XmlNode (itemAt vpts vi)
                    def vv@(optional):XmlNode (vp.firstChild("v"))
                    if (!null? vv) {
                        def vd@(optional):double (str2double ((unwrap vv).textContent()))
                        push series.values (?? vd 0.0)
                    }
                    vi = (vi + 1)
                }
            }
        }
        push chart.series series
        return chart
    }

    fn parseGraphicFrame@(optional):PptxShape (gf:XmlNode slidePart:string) {
        def x:double 0.0
        def y:double 0.0
        def w:double 0.0
        def h:double 0.0
        ; The frame's own name and id: a table or a chart is a shape like any
        ; other to everything above here, and it needs to be findable by name.
        def frameName:string ""
        def frameAlt:string ""
        def frameId:int 0
        def nv@(optional):XmlNode (gf.firstChild("nvGraphicFramePr"))
        if (!null? nv) {
            def cNv@(optional):XmlNode ((unwrap nv).firstChild("cNvPr"))
            if (!null? cNv) {
                def cn:XmlNode (unwrap cNv)
                frameName = (cn.attr("name"))
                frameAlt = (cn.attr("descr"))
                def fid@(optional):int (str2int (cn.attr("id")))
                frameId = (?? fid 0)
            }
        }
        def xfrm@(optional):XmlNode (gf.find("xfrm"))
        if (!null? xfrm) {
            def tmp (new PptxShape())
            this.parseXfrm((unwrap xfrm) tmp)
            x = tmp.x
            y = tmp.y
            w = tmp.width
            h = tmp.height
        }
        ; Table?
        def tbl@(optional):XmlNode (gf.find("tbl"))
        if (!null? tbl) {
            def table:PptxShape (this.parseTable((unwrap tbl) x y w h))
            if ((strlen frameName) > 0) {
                table.name = frameName
            }
            table.altText = frameAlt
            table.shapeId = frameId
            def hit@(optional):PptxShape table
            return hit
        }
        ; Chart via graphicData / chart r:id
        def chartEl@(optional):XmlNode (gf.find("chart"))
        if (!null? chartEl) {
            def rid:string ((unwrap chartEl).attr("r:id"))
            if ((strlen rid) == 0) {
                rid = ((unwrap chartEl).attr("id"))
            }
            def shape (new PptxShape())
            shape.kind = (PptxShapeKind.chart())
            shape.name = "Chart"
            if ((strlen frameName) > 0) {
                shape.name = frameName
            }
            shape.altText = frameAlt
            shape.shapeId = frameId
            shape.x = x
            shape.y = y
            shape.width = w
            shape.height = h
            shape.hasXfrm = true
            shape.hasOff = true
            shape.hasExt = ((w > 0.0) && (h > 0.0))
            if ((strlen rid) > 0) {
                def part:string (pkg.resolveRelationship(slidePart rid))
                if ((strlen part) > 0) {
                    shape.chart = (this.parseChartPart(part))
                }
            }
            def hit2@(optional):PptxShape shape
            return hit2
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    fn parseTreeChild@(optional):PptxShape (node:XmlNode slidePart:string) {
        if (node.name == "sp") {
            def hit@(optional):PptxShape (this.parseShape(node))
            return hit
        }
        if (node.name == "pic") {
            def hit2@(optional):PptxShape (this.parsePicture(node slidePart))
            return hit2
        }
        if (node.name == "grpSp") {
            def hit3@(optional):PptxShape (this.parseGroup(node slidePart))
            return hit3
        }
        if (node.name == "cxnSp") {
            def shape (new PptxShape())
            shape.kind = (PptxShapeKind.connector())
            def nv@(optional):XmlNode (node.firstChild("nvCxnSpPr"))
            if (!null? nv) {
                def cNv@(optional):XmlNode ((unwrap nv).firstChild("cNvPr"))
                if (!null? cNv) {
                    def cn:XmlNode (unwrap cNv)
                    shape.name = (cn.attr("name"))
                    shape.altText = (cn.attr("descr"))
                    def sid@(optional):int (str2int (cn.attr("id")))
                    shape.shapeId = (?? sid 0)
                }
            }
            def spPr@(optional):XmlNode (node.firstChild("spPr"))
            if (!null? spPr) {
                this.parseSpPr((unwrap spPr) shape)
            }
            this.parseStyle(node shape)
            def hit4@(optional):PptxShape shape
            return hit4
        }
        if (node.name == "graphicFrame") {
            return (this.parseGraphicFrame(node slidePart))
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    ; The shape tree, in order — and everything in it that is not a shape.
    ;
    ; A child this reader does not know is not noise. It is SmartArt, an
    ; embedded object, ink, or an `mc:AlternateContent` block holding a
    ; rendering of something newer than this reader. Walking past it is right;
    ; FORGETTING it is what makes a save delete it, so each one is remembered
    ; as the span it occupies in the part, and where in z-order it sat.
    ;
    ; `nvGrpSpPr` and `grpSpPr` are the tree's own properties rather than
    ; children of it, and the writer emits its own; they are the two things
    ; here that are genuinely skipped.
    fn parseSpTreeInto:void (tree:XmlNode partPath:string shapes:[PptxShape] opaque:[PptxOpaque]) {
        def i:int 0
        while (i < (tree.childCount())) {
            def child:XmlNode (tree.childAt(i))
            if (child.isText == false) {
                if ((child.name != "nvGrpSpPr") && (child.name != "grpSpPr")) {
                    def parsed@(optional):PptxShape (this.parseTreeChild(child partPath))
                    if (!null? parsed) {
                        push shapes (unwrap parsed)
                    } {
                        def keep (new PptxOpaque())
                        keep.name = child.name
                        keep.afterShapes = (array_length shapes)
                        keep.source.set(partPath child.srcStart child.srcEnd)
                        ; A span that came back empty is a span that cannot be
                        ; put back, and an empty one written out would be a
                        ; silent hole rather than a preserved element.
                        if (keep.source.known) {
                            push opaque keep
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn parseSheet:PptxSheet (partPath:string) {
        def sheet (new PptxSheet())
        sheet.partPath = partPath
        def xml:string (pkg.readXml(partPath))
        if ((strlen xml) == 0) {
            return sheet
        }
        def root@(optional):XmlNode (xmlParser.parse(xml))
        if (null? root) {
            return sheet
        }
        def doc:XmlNode (unwrap root)
        def cSld@(optional):XmlNode (doc.find("cSld"))
        if (!null? cSld) {
            def cs:XmlNode (unwrap cSld)
            def bg@(optional):XmlNode (cs.firstChild("bg"))
            if (!null? bg) {
                def bgNode:XmlNode (unwrap bg)
                def bgPr@(optional):XmlNode (bgNode.firstChild("bgPr"))
                if (!null? bgPr) {
                    def col@(optional):PptxColor (this.parseColor((unwrap bgPr)))
                    if (!null? col) {
                        sheet.bg = (unwrap col)
                    }
                }
            }
            def spTree@(optional):XmlNode (cs.firstChild("spTree"))
            if (!null? spTree) {
                this.parseSpTreeInto((unwrap spTree) partPath sheet.shapes sheet.opaque)
            }
        }
        ; `p:txStyles` — a master's own typography, in three list styles. Most
        ; placeholders in most decks state nothing at all and take everything
        ; from here, so a reader that skips it draws a deck in its own defaults
        ; rather than in the deck's.
        def tx@(optional):XmlNode (doc.firstChild("txStyles"))
        if (!null? tx) {
            def t:XmlNode (unwrap tx)
            def ttl@(optional):XmlNode (t.firstChild("titleStyle"))
            if (!null? ttl) {
                this.parseListStyle((unwrap ttl) sheet.titleStyle)
            }
            def bdy@(optional):XmlNode (t.firstChild("bodyStyle"))
            if (!null? bdy) {
                this.parseListStyle((unwrap bdy) sheet.bodyStyle)
            }
            def oth@(optional):XmlNode (t.firstChild("otherStyle"))
            if (!null? oth) {
                this.parseListStyle((unwrap oth) sheet.otherStyle)
            }
        }
        return sheet
    }

    fn ensureSheet@(optional):PptxSheet (cache:[string:PptxSheet] partPath:string) {
        if ((strlen partPath) == 0) {
            def __missing@(optional):PptxSheet
            return __missing
        }
        def existing@(optional):PptxSheet (get cache partPath)
        if (!null? existing) {
            return existing
        }
        def sheet:PptxSheet (this.parseSheet(partPath))
        set cache partPath sheet
        def hit@(optional):PptxSheet sheet
        return hit
    }

    ; The speaker's notes, which live in a part of their own that the slide
    ; points at. Only the body placeholder is notes — a notes slide also holds
    ; a thumbnail of the slide and its number, and neither is anything anyone
    ; typed.
    fn parseNotes:void (slide:PptxSlide) {
        def part:string (pkg.findRelationshipByType(slide.partPath "/notesSlide"))
        if ((strlen part) == 0) {
            return
        }
        slide.notesPart = part
        def xml:string (pkg.readXml(part))
        if ((strlen xml) == 0) {
            return
        }
        def root@(optional):XmlNode (xmlParser.parse(xml))
        if (null? root) {
            return
        }
        def doc:XmlNode (unwrap root)
        def tree@(optional):XmlNode (doc.find("spTree"))
        if (null? tree) {
            return
        }
        def shapes:[XmlNode] ((unwrap tree).childrenNamed("sp"))
        def i:int 0
        while (i < (array_length shapes)) {
            def sp:XmlNode (itemAt shapes i)
            def shape:PptxShape (this.parseShape(sp))
            def isBody:boolean false
            if (shape.isPlaceholder) {
                if (shape.phType == "body") {
                    isBody = true
                }
            }
            if isBody {
                slide.notes = shape
                slide.notes.inherited = false
                return
            }
            i = (i + 1)
        }
    }

    ; Children of `<p:sld>` this model has no room for, split at the point
    ; where the transition and the timing go. The schema orders them
    ; `cSld, clrMapOvr, transition, timing, extLst`, so an element kept from
    ; before that point has to go back before it and one from after has to go
    ; back after — putting them all at one end writes a part PowerPoint
    ; rejects.
    fn parseSlideLevel:void (slide:PptxSlide partPath:string doc:XmlNode) {
        ; Where the modelled middle is. Anything at or after it is "tail".
        def pivot:int (doc.childCount())
        def i:int 0
        while (i < (doc.childCount())) {
            def c:XmlNode (doc.childAt(i))
            if (c.isText == false) {
                if ((c.name == "transition") || (c.name == "timing")) {
                    if (i < pivot) {
                        pivot = i
                    }
                }
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (doc.childCount())) {
            def ch:XmlNode (doc.childAt(j))
            if (ch.isText == false) {
                def modelled:boolean false
                if (ch.name == "cSld") {
                    modelled = true
                }
                if (ch.name == "transition") {
                    modelled = true
                }
                if (ch.name == "timing") {
                    modelled = true
                }
                if (modelled == false) {
                    def keep (new PptxOpaque())
                    keep.name = ch.name
                    keep.afterShapes = j
                    keep.source.set(partPath ch.srcStart ch.srcEnd)
                    if (keep.source.known) {
                        if (j < pivot) {
                            push slide.sldHead keep
                        } {
                            push slide.sldTail keep
                        }
                    }
                }
            }
            j = (j + 1)
        }
    }

    fn parseSlide:PptxSlide (partPath:string width:double height:double) {
        def slide (new PptxSlide())
        slide.partPath = partPath
        slide.width = width
        slide.height = height
        def xml:string (pkg.readXml(partPath))
        if ((strlen xml) == 0) {
            return slide
        }
        def root@(optional):XmlNode (xmlParser.parse(xml))
        if (null? root) {
            return slide
        }
        def doc:XmlNode (unwrap root)
        ; Background
        def cSld@(optional):XmlNode (doc.find("cSld"))
        if (!null? cSld) {
            def cs:XmlNode (unwrap cSld)
            def bg@(optional):XmlNode (cs.firstChild("bg"))
            if (!null? bg) {
                def bgNode:XmlNode (unwrap bg)
                def bgPr@(optional):XmlNode (bgNode.firstChild("bgPr"))
                if (!null? bgPr) {
                    def col@(optional):PptxColor (this.parseColor((unwrap bgPr)))
                    if (!null? col) {
                        slide.bg = (unwrap col)
                    }
                }
            }
            def spTree@(optional):XmlNode (cs.firstChild("spTree"))
            if (!null? spTree) {
                this.parseSpTreeInto((unwrap spTree) partPath slide.shapes slide.opaque)
            }
        }
        ; Everything else `<p:sld>` holds. `cSld`, the transition and the
        ; timing are modelled; a colour map override, an extension list, a
        ; custom data list or an `mc:AlternateContent` block are not, and a
        ; rewrite used to drop all of them — including replacing a real colour
        ; map override with a plain one.
        this.parseSlideLevel(slide partPath doc)
        ; How the slide arrives, and what is built on it once it has.
        this.parseTransition(slide doc)
        def timing@(optional):XmlNode (doc.find("timing"))
        if (!null? timing) {
            this.parseTiming(slide (unwrap timing))
        }
        ; Layout relationship
        slide.layoutPart = (pkg.findRelationshipByType(partPath "/slideLayout"))
        this.parseNotes(slide)
        return slide
    }

    ; `p:transition` names its effect by the element inside it — `<p:fade/>`,
    ; `<p:push dir="u"/>` — with the speed as a word and the real length, when
    ; a writer states one, in milliseconds out in the extension list.
    fn parseTransition:void (slide:PptxSlide doc:XmlNode) {
        def hit@(optional):XmlNode (doc.find("transition"))
        if (null? hit) {
            return
        }
        def node:XmlNode (unwrap hit)
        def tr:PptxTransition (slide.transition)
        tr.isSet = true
        def i:int 0
        while (i < (array_length node.children)) {
            def c:XmlNode (itemAt node.children i)
            if (c.isText == false) {
                if ((strlen tr.kind) == 0) {
                    if (c.name != "extLst") {
                        tr.kind = c.name
                        tr.dir = (c.attr("dir"))
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen tr.kind) == 0) {
            tr.kind = "fade"
        }
        def spd:string (node.attr("spd"))
        if (spd == "slow") {
            tr.seconds = 1.5
        }
        if (spd == "med") {
            tr.seconds = 0.75
        }
        if (spd == "fast") {
            tr.seconds = 0.4
        }
        ; A stated duration beats the speed word.
        def dur:string (node.attr("p14:dur"))
        if ((strlen dur) == 0) {
            def ext@(optional):XmlNode (node.find("dur"))
            if (!null? ext) {
                dur = ((unwrap ext).attr("val"))
            }
        }
        if ((strlen dur) > 0) {
            def ms@(optional):double (str2double dur)
            if (!null? ms) {
                def v:double (unwrap ms)
                if (v > 0.0) {
                    tr.seconds = (v / 1000.0)
                }
            }
        }
        def click:string (node.attr("advClick"))
        if (click == "0") {
            tr.onClick = false
        }
        def adv:string (node.attr("advTm"))
        if ((strlen adv) > 0) {
            def at@(optional):double (str2double adv)
            if (!null? at) {
                tr.afterSeconds = ((unwrap at) / 1000.0)
            }
        }
    }

    ; A slide's build, read out of `p:timing`. The tree is deep — a sequence of
    ; click groups, each a tree of parallel and sequential nodes — and what is
    ; wanted from it is flat: which shape, which paragraph, what effect, and
    ; whether it waits for a click. So the walk looks for the INNERMOST `p:par`
    ; that names a shape, which is one effect, and reads the answer off it.
    fn parseTiming:void (slide:PptxSlide node:XmlNode) {
        this.collectBuild(slide node)
    }

    fn collectBuild:boolean (slide:PptxSlide node:XmlNode) {
        def deeper:boolean false
        def i:int 0
        while (i < (array_length node.children)) {
            def c:XmlNode (itemAt node.children i)
            if (c.isText == false) {
                if (this.collectBuild(slide c)) {
                    deeper = true
                }
            }
            i = (i + 1)
        }
        if deeper {
            return true
        }
        if (node.name != "par") {
            return false
        }
        def tgt@(optional):XmlNode (node.find("spTgt"))
        if (null? tgt) {
            return false
        }
        def sp:XmlNode (unwrap tgt)
        def spid@(optional):int (str2int (sp.attr("spid")))
        if (null? spid) {
            return false
        }
        def step (new PptxBuildStep())
        step.shapeId = (unwrap spid)
        def eff@(optional):XmlNode (node.find("animEffect"))
        if (!null? eff) {
            def filter:string ((unwrap eff).attr("filter"))
            if ((strlen filter) > 0) {
                step.kind = filter
            }
        }
        def rng@(optional):XmlNode (node.find("pRg"))
        if (!null? rng) {
            def st@(optional):int (str2int ((unwrap rng).attr("st")))
            if (!null? st) {
                step.paragraph = (unwrap st)
            }
        }
        def ctn@(optional):XmlNode (node.firstChild("cTn"))
        if (!null? ctn) {
            def cn:XmlNode (unwrap ctn)
            def kind:string (cn.attr("nodeType"))
            if (kind == "withEffect") {
                step.start = "with"
            }
            if (kind == "afterEffect") {
                step.start = "after"
            }
            def dur:string (cn.attr("dur"))
            if ((strlen dur) > 0) {
                def ms@(optional):double (str2double dur)
                if (!null? ms) {
                    def v:double (unwrap ms)
                    if (v > 0.0) {
                        step.seconds = (v / 1000.0)
                    }
                }
            }
        }
        push slide.build step
        return true
    }

    ; `a:fmtScheme`: the fills, outlines and effects that a shape's `<p:style>`
    ; indexes into. Every colour in here is the placeholder `phClr` carrying
    ; the modifiers that make the style what it is, so what is stored is the
    ; MODIFIERS — the colour itself arrives from the shape.
    fn parseFormatScheme:void (theme:PptxTheme doc:XmlNode) {
        def fmt@(optional):XmlNode (doc.find("fmtScheme"))
        if (null? fmt) {
            return
        }
        def node:XmlNode (unwrap fmt)
        def fills@(optional):XmlNode (node.firstChild("fillStyleLst"))
        if (!null? fills) {
            def fl:XmlNode (unwrap fills)
            def i:int 0
            while (i < (fl.childCount())) {
                def c:XmlNode (fl.childAt(i))
                if (c.isText == false) {
                    push theme.fillStyles (this.parseFillStyle(c))
                }
                i = (i + 1)
            }
        }
        def lines@(optional):XmlNode (node.firstChild("lnStyleLst"))
        if (!null? lines) {
            def ll:XmlNode (unwrap lines)
            def k:int 0
            while (k < (ll.childCount())) {
                def c2:XmlNode (ll.childAt(k))
                if (c2.isText == false) {
                    def st (new PptxLineStyle())
                    st.isSet = true
                    def w:string (c2.attr("w"))
                    if ((strlen w) > 0) {
                        def wv@(optional):double (str2double w)
                        st.widthPt = (PptxUnits.emuToPt((?? wv 9525.0)))
                    }
                    def solid@(optional):XmlNode (c2.firstChild("solidFill"))
                    if (!null? solid) {
                        def col@(optional):PptxColor (this.colorIn((unwrap solid)))
                        if (!null? col) {
                            st.color = (unwrap col)
                        }
                    }
                    push theme.lineStyles st
                }
                k = (k + 1)
            }
        }
        def effects@(optional):XmlNode (node.firstChild("effectStyleLst"))
        if (!null? effects) {
            def el:XmlNode (unwrap effects)
            def e:int 0
            while (e < (el.childCount())) {
                def c3:XmlNode (el.childAt(e))
                if (c3.isText == false) {
                    def shadow@(optional):XmlNode (c3.find("outerShdw"))
                    push theme.effectShadows (!null? shadow)
                }
                e = (e + 1)
            }
        }
    }

    fn parseFillStyle:PptxFillStyle (node:XmlNode) {
        def st (new PptxFillStyle())
        st.isSet = true
        if (node.name == "noFill") {
            st.kind = 2
            return st
        }
        if (node.name == "gradFill") {
            st.kind = 1
            def stops:[PptxColor] (this.gradientStops(node))
            if ((array_length stops) > 0) {
                st.c1 = (itemAt stops 0)
                st.c2 = (itemAt stops ((array_length stops) - 1))
            }
            st.dir = (PptxParser.gradientDir(node))
            return st
        }
        ; Anything else is treated as a solid: a pattern or a picture fill in a
        ; theme is rare, and one flat colour is a better answer than nothing.
        st.kind = 0
        def col@(optional):PptxColor (this.colorIn(node))
        if (!null? col) {
            st.solid = (unwrap col)
        } {
            st.solid = (PptxColor.schemeOf("phClr"))
        }
        return st
    }

    fn gradientStops:[PptxColor] (node:XmlNode) {
        def out:[PptxColor]
        def lst@(optional):XmlNode (node.firstChild("gsLst"))
        if (null? lst) {
            return out
        }
        def gl:XmlNode (unwrap lst)
        def gs:[XmlNode] (gl.childrenNamed("gs"))
        def i:int 0
        while (i < (array_length gs)) {
            def col@(optional):PptxColor (this.colorIn((itemAt gs i)))
            if (!null? col) {
                push out (unwrap col)
            }
            i = (i + 1)
        }
        return out
    }

    ; `a:lin ang` is in 1/60000 of a degree, clockwise from "left to right".
    ; The model only says vertical or horizontal, so the angle is rounded to
    ; whichever it is nearer.
    sfn gradientDir:int (node:XmlNode) {
        def lin@(optional):XmlNode (node.firstChild("lin"))
        if (null? lin) {
            return 0
        }
        def a:string ((unwrap lin).attr("ang"))
        if ((strlen a) == 0) {
            return 0
        }
        def av@(optional):double (str2double a)
        def deg:double ((?? av 0.0) / 60000.0)
        while (deg < 0.0) {
            deg = (deg + 360.0)
        }
        while (deg >= 360.0) {
            deg = (deg - 360.0)
        }
        if (deg < 45.0) {
            return 1
        }
        if (deg < 135.0) {
            return 0
        }
        if (deg < 225.0) {
            return 1
        }
        if (deg < 315.0) {
            return 0
        }
        return 1
    }

    ; `<p:style>` — the shape asking for a theme fill, outline, effect and text
    ; colour rather than stating its own. Extremely common: every shape a user
    ; inserts and does not restyle by hand is written this way, and a reader
    ; that skips it draws them all as nothing.
    fn parseStyle:void (node:XmlNode shape:PptxShape) {
        def st@(optional):XmlNode (node.firstChild("style"))
        if (null? st) {
            return
        }
        def sn:XmlNode (unwrap st)
        ; That the block EXISTS is the thing the writer needs: a shape with a
        ; style reference follows the theme, and one without it does not.
        shape.hasStyle = true
        def fill@(optional):XmlNode (sn.firstChild("fillRef"))
        if (!null? fill) {
            def fr:XmlNode (unwrap fill)
            def idx@(optional):int (str2int (fr.attr("idx")))
            shape.fillRef = (?? idx 0)
            def col@(optional):PptxColor (this.colorIn(fr))
            if (!null? col) {
                shape.fillRefColor = (unwrap col)
            }
        }
        def line@(optional):XmlNode (sn.firstChild("lnRef"))
        if (!null? line) {
            def lr:XmlNode (unwrap line)
            def idx2@(optional):int (str2int (lr.attr("idx")))
            shape.lineRef = (?? idx2 0)
            def col2@(optional):PptxColor (this.colorIn(lr))
            if (!null? col2) {
                shape.lineRefColor = (unwrap col2)
            }
        }
        def eff@(optional):XmlNode (sn.firstChild("effectRef"))
        if (!null? eff) {
            def idx3@(optional):int (str2int ((unwrap eff).attr("idx")))
            shape.effectRef = (?? idx3 0)
        }
        def font@(optional):XmlNode (sn.firstChild("fontRef"))
        if (!null? font) {
            def fn:XmlNode (unwrap font)
            shape.fontRef = (fn.attr("idx"))
            def col3@(optional):PptxColor (this.colorIn(fn))
            if (!null? col3) {
                shape.fontRefColor = (unwrap col3)
            }
        }
    }

    fn parseTheme:PptxTheme (partPath:string) {
        def theme (new PptxTheme())
        ; Sensible Office defaults even if theme is missing
        theme.setColor("dk1" "000000")
        theme.setColor("lt1" "FFFFFF")
        theme.setColor("dk2" "44546A")
        theme.setColor("lt2" "E7E6E6")
        theme.setColor("accent1" "4472C4")
        theme.setColor("accent2" "ED7D31")
        theme.setColor("accent3" "A5A5A5")
        theme.setColor("accent4" "FFC000")
        theme.setColor("accent5" "5B9BD5")
        theme.setColor("accent6" "70AD47")
        theme.setColor("hlink" "0563C1")
        theme.setColor("folHlink" "954F72")
        if ((strlen partPath) == 0) {
            return theme
        }
        def xml:string (pkg.readXml(partPath))
        if ((strlen xml) == 0) {
            return theme
        }
        def root@(optional):XmlNode (xmlParser.parse(xml))
        if (null? root) {
            return theme
        }
        def doc:XmlNode (unwrap root)
        def scheme@(optional):XmlNode (doc.find("clrScheme"))
        if (!null? scheme) {
            def sch:XmlNode (unwrap scheme)
            def i:int 0
            while (i < (sch.childCount())) {
                def child:XmlNode (sch.childAt(i))
                if (child.isText == false) {
                    def name:string child.name
                    def srgb@(optional):XmlNode (child.firstChild("srgbClr"))
                    if (!null? srgb) {
                        theme.setColor(name ((unwrap srgb).attr("val")))
                    }
                    def sys@(optional):XmlNode (child.firstChild("sysClr"))
                    if (!null? sys) {
                        def last:string ((unwrap sys).attr("lastClr"))
                        if ((strlen last) == 6) {
                            theme.setColor(name last)
                        }
                    }
                }
                i = (i + 1)
            }
        }
        this.parseFormatScheme(theme doc)
        def major@(optional):XmlNode (doc.find("majorFont"))
        if (!null? major) {
            def latin@(optional):XmlNode ((unwrap major).firstChild("latin"))
            if (!null? latin) {
                def tf:string ((unwrap latin).attr("typeface"))
                if ((strlen tf) > 0) {
                    theme.majorFont = tf
                }
            }
        }
        def minor@(optional):XmlNode (doc.find("minorFont"))
        if (!null? minor) {
            def latin2@(optional):XmlNode ((unwrap minor).firstChild("latin"))
            if (!null? latin2) {
                def tf2:string ((unwrap latin2).attr("typeface"))
                if ((strlen tf2) > 0) {
                    theme.minorFont = tf2
                }
            }
        }
        return theme
    }

    ; `p14:sectionLst`, which lives in the presentation's extLst. A deck with
    ; no sections is the common case and parses to an empty list, not an error.
    fn parseSections:void (pres:PptxPresentation doc:XmlNode) {
        def lst@(optional):XmlNode (doc.find("sectionLst"))
        if (null? lst) {
            return
        }
        def node:XmlNode (unwrap lst)
        def secs:[XmlNode] (node.childrenNamed("section"))
        def i:int 0
        while (i < (array_length secs)) {
            def sn:XmlNode (itemAt secs i)
            def sec (new PptxSection())
            sec.name = (sn.attr("name"))
            sec.id = (sn.attr("id"))
            def ids@(optional):XmlNode (sn.find("sldIdLst"))
            if (!null? ids) {
                def idNode:XmlNode (unwrap ids)
                def kids:[XmlNode] (idNode.childrenNamed("sldId"))
                def k:int 0
                while (k < (array_length kids)) {
                    def kid:XmlNode (itemAt kids k)
                    def v@(optional):int (str2int (kid.attr("id")))
                    push sec.slideIds (?? v 0)
                    k = (k + 1)
                }
            }
            push pres.sections sec
            i = (i + 1)
        }
    }

    fn parsePresentation:PptxPresentation () {
        def pres (new PptxPresentation())
        def xml:string (pkg.readXml("ppt/presentation.xml"))
        if ((strlen xml) == 0) {
            return pres
        }
        def root@(optional):XmlNode (xmlParser.parse(xml))
        if (null? root) {
            return pres
        }
        def doc:XmlNode (unwrap root)
        def sldSz@(optional):XmlNode (doc.find("sldSz"))
        if (!null? sldSz) {
            def sz:XmlNode (unwrap sldSz)
            pres.slideWidth = (PptxUnits.emuToPt((this.parseDoubleAttr(sz "cx"))))
            pres.slideHeight = (PptxUnits.emuToPt((this.parseDoubleAttr(sz "cy"))))
        }
        ; Slide order from sldIdLst → relationships. The `id` on each entry is
        ; the name sections use for a slide, so it is kept alongside the part.
        def slideIds:[int]
        def idLst@(optional):XmlNode (doc.find("sldIdLst"))
        if (!null? idLst) {
            def lst:XmlNode (unwrap idLst)
            def ids:[XmlNode] (lst.childrenNamed("sldId"))
            def i:int 0
            while (i < (array_length ids)) {
                def idNode:XmlNode (itemAt ids i)
                def rid:string (idNode.attr("r:id"))
                def own:string (idNode.attr("id"))
                if ((strlen rid) == 0) {
                    ; Rare writers omit the prefix
                    rid = own
                    own = ""
                }
                def part:string (pkg.resolveRelationship("ppt/presentation.xml" rid))
                if ((strlen part) > 0) {
                    push pres.slideParts part
                    def sid@(optional):int (str2int own)
                    push slideIds (?? sid 0)
                }
                i = (i + 1)
            }
        }
        this.parseSections(pres doc)
        ; Theme via master
        def masterPart:string (pkg.findRelationshipByType("ppt/presentation.xml" "/slideMaster"))
        if ((strlen masterPart) > 0) {
            pres.themePart = (pkg.findRelationshipByType(masterPart "/theme"))
        }
        if ((strlen pres.themePart) == 0) {
            ; Common default path
            if (pkg.hasPart("ppt/theme/theme1.xml")) {
                pres.themePart = "ppt/theme/theme1.xml"
            }
        }
        pres.theme = (this.parseTheme(pres.themePart))
        ; Parse each slide + ensure layout/master sheets are cached
        def si:int 0
        while (si < (array_length pres.slideParts)) {
            def part:string (itemAt pres.slideParts si)
            def slide:PptxSlide (this.parseSlide(part pres.slideWidth pres.slideHeight))
            if (si < (array_length slideIds)) {
                slide.slideId = (itemAt slideIds si)
            }
            if ((strlen slide.layoutPart) > 0) {
                slide.masterPart = (pkg.findRelationshipByType(slide.layoutPart "/slideMaster"))
                this.ensureSheet(pres.layouts slide.layoutPart)
            }
            if ((strlen slide.masterPart) > 0) {
                this.ensureSheet(pres.masters slide.masterPart)
            }
            push pres.slides slide
            si = (si + 1)
        }
        return pres
    }
}

; ==============================================================================
; PptxParser - OPC package → PptxPresentation / raw slides
; ==============================================================================
;
; Reads presentation.xml for slide order + size, then each slide part into a
; PptxSlide with shapes / pictures / groups / text. Theme and master inheritance
; are left to PptxResolver — this layer only materialises what the XML says.
; ==============================================================================

Import "OpcPackage.rgr"
Import "PptxXml.rgr"
Import "PptxModel.rgr"
Import "PptxGeom.rgr"

class PptxParser {
    def pkg:OpcPackage (new OpcPackage())
    def xmlParser:PptxXmlParser (new PptxXmlParser())

    Constructor () {
    }

    fn close:void () {
        pkg.close()
    }

    fn open:boolean (fullPath:string) {
        return (pkg.open(fullPath))
    }

    fn openParts:boolean (path:string name:string) {
        return (pkg.openParts(path name))
    }

    fn openBytes:boolean (bytes:buffer name:string) {
        return (pkg.openBytes(bytes name))
    }

    fn parseDoubleAttr:double (node:PptxXmlNode name:string) {
        def s:string (node.attr(name))
        if ((strlen s) == 0) {
            return 0.0
        }
        def d@(optional):double (str2double s)
        return (?? d 0.0)
    }

    fn parseColor@(optional):PptxColor (parent:PptxXmlNode) {
        ; Look for solidFill → srgbClr | schemeClr under parent
        def solid@(optional):PptxXmlNode (parent.firstChild("solidFill"))
        if (null? solid) {
            ; Also allow parent itself to be solidFill
            if (parent.name == "solidFill") {
                solid = parent
            }
        }
        if (null? solid) {
            def __missing@(optional):PptxColor
            return __missing
        }
        def snode:PptxXmlNode (unwrap solid)
        def srgb@(optional):PptxXmlNode (snode.firstChild("srgbClr"))
        if (!null? srgb) {
            def sn:PptxXmlNode (unwrap srgb)
            def hex:string (sn.attr("val"))
            if ((strlen hex) == 6) {
                def hit@(optional):PptxColor (PptxColor.srgbOf(hex))
                return hit
            }
        }
        def sch@(optional):PptxXmlNode (snode.firstChild("schemeClr"))
        if (!null? sch) {
            def sc:PptxXmlNode (unwrap sch)
            def name:string (sc.attr("val"))
            if ((strlen name) > 0) {
                def hit2@(optional):PptxColor (PptxColor.schemeOf(name))
                return hit2
            }
        }
        def __missing@(optional):PptxColor
        return __missing
    }

    fn parseXfrm:void (xfrm:PptxXmlNode shape:PptxShape) {
        shape.hasXfrm = true
        def rotS:string (xfrm.attr("rot"))
        if ((strlen rotS) > 0) {
            def rd@(optional):double (str2double rotS)
            def rot:double (?? rd 0.0)
            shape.rotation = (PptxUnits.rotToDeg(rot))
        }
        if ((xfrm.attr("flipH")) == "1") {
            shape.flipH = true
        }
        if ((xfrm.attr("flipV")) == "1") {
            shape.flipV = true
        }
        def off@(optional):PptxXmlNode (xfrm.firstChild("off"))
        if (!null? off) {
            def o:PptxXmlNode (unwrap off)
            shape.x = (PptxUnits.emuToPt((this.parseDoubleAttr(o "x"))))
            shape.y = (PptxUnits.emuToPt((this.parseDoubleAttr(o "y"))))
        }
        def ext@(optional):PptxXmlNode (xfrm.firstChild("ext"))
        if (!null? ext) {
            def e:PptxXmlNode (unwrap ext)
            shape.width = (PptxUnits.emuToPt((this.parseDoubleAttr(e "cx"))))
            shape.height = (PptxUnits.emuToPt((this.parseDoubleAttr(e "cy"))))
        }
        def chOff@(optional):PptxXmlNode (xfrm.firstChild("chOff"))
        if (!null? chOff) {
            def co:PptxXmlNode (unwrap chOff)
            shape.chX = (PptxUnits.emuToPt((this.parseDoubleAttr(co "x"))))
            shape.chY = (PptxUnits.emuToPt((this.parseDoubleAttr(co "y"))))
        }
        def chExt@(optional):PptxXmlNode (xfrm.firstChild("chExt"))
        if (!null? chExt) {
            def ce:PptxXmlNode (unwrap chExt)
            shape.chW = (PptxUnits.emuToPt((this.parseDoubleAttr(ce "cx"))))
            shape.chH = (PptxUnits.emuToPt((this.parseDoubleAttr(ce "cy"))))
        }
    }

    fn applyRPrToRun:void (rp:PptxXmlNode run:PptxTextRun) {
        def sz:string (rp.attr("sz"))
        if ((strlen sz) > 0) {
            def sd@(optional):double (str2double sz)
            run.fontSizePt = (PptxUnits.hundredthsPtToPt((?? sd 1800.0)))
            run.sizeSet = true
        }
        if ((rp.attr("b")) == "1") {
            run.bold = true
        }
        if ((rp.attr("i")) == "1") {
            run.italic = true
        }
        def latin@(optional):PptxXmlNode (rp.firstChild("latin"))
        if (!null? latin) {
            def ln:PptxXmlNode (unwrap latin)
            def tf:string (ln.attr("typeface"))
            if ((strlen tf) > 0) {
                run.fontFamily = tf
            }
        }
        def col@(optional):PptxColor (this.parseColor(rp))
        if (!null? col) {
            run.color = (unwrap col)
        }
    }

    fn parseLstStyleDefaults:void (txBody:PptxXmlNode body:PptxTextBody) {
        def lst@(optional):PptxXmlNode (txBody.firstChild("lstStyle"))
        if (null? lst) {
            return
        }
        def ls:PptxXmlNode (unwrap lst)
        ; Prefer lvl1pPr, then defPPr
        def lvl@(optional):PptxXmlNode (ls.firstChild("lvl1pPr"))
        if (null? lvl) {
            lvl = (ls.firstChild("defPPr"))
        }
        if (null? lvl) {
            return
        }
        def ln:PptxXmlNode (unwrap lvl)
        def algn:string (ln.attr("algn"))
        if ((strlen algn) > 0) {
            body.defAlign = algn
        }
        def defRPr@(optional):PptxXmlNode (ln.firstChild("defRPr"))
        if (null? defRPr) {
            return
        }
        def rp:PptxXmlNode (unwrap defRPr)
        body.hasDefRPr = true
        def sz:string (rp.attr("sz"))
        if ((strlen sz) > 0) {
            def sd@(optional):double (str2double sz)
            body.defFontSizePt = (PptxUnits.hundredthsPtToPt((?? sd 1800.0)))
        }
        if ((rp.attr("b")) == "1") {
            body.defBold = true
        }
        if ((rp.attr("i")) == "1") {
            body.defItalic = true
        }
        def latin@(optional):PptxXmlNode (rp.firstChild("latin"))
        if (!null? latin) {
            def tf:string ((unwrap latin).attr("typeface"))
            if ((strlen tf) > 0) {
                body.defFontFamily = tf
            }
        }
        def col@(optional):PptxColor (this.parseColor(rp))
        if (!null? col) {
            body.defColor = (unwrap col)
        }
    }

    fn parseTextBody:PptxTextBody (txBody:PptxXmlNode) {
        def body (new PptxTextBody())
        def bodyPr@(optional):PptxXmlNode (txBody.firstChild("bodyPr"))
        if (!null? bodyPr) {
            def bp:PptxXmlNode (unwrap bodyPr)
            def lIns:string (bp.attr("lIns"))
            if ((strlen lIns) > 0) {
                def ld@(optional):double (str2double lIns)
                body.insetL = (PptxUnits.emuToPt((?? ld 0.0)))
                body.insetsSet = true
            }
            def tIns:string (bp.attr("tIns"))
            if ((strlen tIns) > 0) {
                def td@(optional):double (str2double tIns)
                body.insetT = (PptxUnits.emuToPt((?? td 0.0)))
                body.insetsSet = true
            }
            def rIns:string (bp.attr("rIns"))
            if ((strlen rIns) > 0) {
                def rd@(optional):double (str2double rIns)
                body.insetR = (PptxUnits.emuToPt((?? rd 0.0)))
                body.insetsSet = true
            }
            def bIns:string (bp.attr("bIns"))
            if ((strlen bIns) > 0) {
                def bd@(optional):double (str2double bIns)
                body.insetB = (PptxUnits.emuToPt((?? bd 0.0)))
                body.insetsSet = true
            }
            def anc:string (bp.attr("anchor"))
            if ((strlen anc) > 0) {
                body.anchor = anc
                body.anchorSet = true
            }
            def wrap:string (bp.attr("wrap"))
            if (wrap == "none") {
                body.wrap = false
            }
        }
        this.parseLstStyleDefaults(txBody body)
        def paras:[PptxXmlNode] (txBody.childrenNamed("p"))
        def i:int 0
        while (i < (array_length paras)) {
            def pnode:PptxXmlNode (itemAt paras i)
            def para (new PptxParagraph())
            def pPr@(optional):PptxXmlNode (pnode.firstChild("pPr"))
            if (!null? pPr) {
                def pp:PptxXmlNode (unwrap pPr)
                def algn:string (pp.attr("algn"))
                if ((strlen algn) > 0) {
                    para.align = algn
                    para.alignSet = true
                }
                def lvlS:string (pp.attr("lvl"))
                if ((strlen lvlS) > 0) {
                    def lv@(optional):int (str2int lvlS)
                    para.level = (?? lv 0)
                }
                def buFont@(optional):PptxXmlNode (pp.firstChild("buFont"))
                def buChar@(optional):PptxXmlNode (pp.firstChild("buChar"))
                def buNone@(optional):PptxXmlNode (pp.firstChild("buNone"))
                def buAuto@(optional):PptxXmlNode (pp.firstChild("buAutoNum"))
                if (!null? buNone) {
                    para.hasBullet = false
                } {
                    if (!null? buChar) {
                        para.hasBullet = true
                        def ch:string ((unwrap buChar).attr("char"))
                        if ((strlen ch) > 0) {
                            para.bulletChar = ch
                        }
                    } {
                        if (!null? buAuto) {
                            para.hasBullet = true
                            para.bulletChar = "•"
                        } {
                            if (!null? buFont) {
                                para.hasBullet = true
                            }
                        }
                    }
                }
                def spcBef@(optional):PptxXmlNode (pp.firstChild("spcBef"))
                if (!null? spcBef) {
                    def spc:PptxXmlNode (unwrap spcBef)
                    def pts@(optional):PptxXmlNode (spc.firstChild("spcPts"))
                    if (!null? pts) {
                        def pv@(optional):double (str2double ((unwrap pts).attr("val")))
                        para.spaceBeforePt = ((?? pv 0.0) / 100.0)
                    }
                }
                def spcAft@(optional):PptxXmlNode (pp.firstChild("spcAft"))
                if (!null? spcAft) {
                    def spa:PptxXmlNode (unwrap spcAft)
                    def pts2@(optional):PptxXmlNode (spa.firstChild("spcPts"))
                    if (!null? pts2) {
                        def pv2@(optional):double (str2double ((unwrap pts2).attr("val")))
                        para.spaceAfterPt = ((?? pv2 0.0) / 100.0)
                    }
                }
                def lnSpc@(optional):PptxXmlNode (pp.firstChild("lnSpc"))
                if (!null? lnSpc) {
                    def lsp:PptxXmlNode (unwrap lnSpc)
                    def pct@(optional):PptxXmlNode (lsp.firstChild("spcPct"))
                    if (!null? pct) {
                        def pcv@(optional):double (str2double ((unwrap pct).attr("val")))
                        para.lineSpacingPct = ((?? pcv 100000.0) / 1000.0)
                    }
                }
            }
            ; Runs and FIELDS, in the order the paragraph has them: a page
            ; number sits between words often enough that reading the runs
            ; first and the fields after would reorder the line.
            def j:int 0
            while (j < (pnode.childCount())) {
                def child:PptxXmlNode (pnode.childAt(j))
                def isRun:boolean false
                def isField:boolean false
                if (child.isText == false) {
                    if (child.name == "r") {
                        isRun = true
                    }
                    if (child.name == "fld") {
                        isField = true
                    }
                }
                if (isRun || isField) {
                    def run (new PptxTextRun())
                    def rPr@(optional):PptxXmlNode (child.firstChild("rPr"))
                    if (!null? rPr) {
                        this.applyRPrToRun((unwrap rPr) run)
                    }
                    def t@(optional):PptxXmlNode (child.firstChild("t"))
                    if (!null? t) {
                        def tn:PptxXmlNode (unwrap t)
                        run.text = (tn.textContent())
                    }
                    if isField {
                        run.field = (child.attr("type"))
                        if ((strlen run.field) == 0) {
                            run.field = "slidenum"
                        }
                    }
                    push para.runs run
                }
                j = (j + 1)
            }
            push body.paragraphs para
            i = (i + 1)
        }
        return body
    }

    fn parsePlaceholderAttrs:void (sp:PptxXmlNode shape:PptxShape) {
        def nv@(optional):PptxXmlNode (sp.firstChild("nvSpPr"))
        if (null? nv) {
            ; Pictures use nvPicPr
            nv = (sp.firstChild("nvPicPr"))
        }
        if (null? nv) {
            return
        }
        def nvPr@(optional):PptxXmlNode ((unwrap nv).firstChild("nvPr"))
        if (null? nvPr) {
            return
        }
        def ph@(optional):PptxXmlNode ((unwrap nvPr).firstChild("ph"))
        if (null? ph) {
            return
        }
        def phn:PptxXmlNode (unwrap ph)
        shape.isPlaceholder = true
        def typ:string (phn.attr("type"))
        if ((strlen typ) > 0) {
            shape.phType = typ
        } {
            ; OOXML: omitted type means body
            shape.phType = "body"
        }
        def idxS:string (phn.attr("idx"))
        if ((strlen idxS) > 0) {
            def id@(optional):int (str2int idxS)
            shape.phIdx = (?? id -1)
        }
    }

    fn parseDirectColor@(optional):PptxColor (parent:PptxXmlNode) {
        def srgb@(optional):PptxXmlNode (parent.firstChild("srgbClr"))
        if (!null? srgb) {
            def hex:string ((unwrap srgb).attr("val"))
            if ((strlen hex) == 6) {
                def hit@(optional):PptxColor (PptxColor.srgbOf(hex))
                return hit
            }
        }
        def sch@(optional):PptxXmlNode (parent.firstChild("schemeClr"))
        if (!null? sch) {
            def name:string ((unwrap sch).attr("val"))
            if ((strlen name) > 0) {
                def hit2@(optional):PptxColor (PptxColor.schemeOf(name))
                return hit2
            }
        }
        def viaSolid@(optional):PptxColor (this.parseColor(parent))
        return viaSolid
    }

    fn parseGradient@(optional):PptxGradient (parent:PptxXmlNode) {
        def gf@(optional):PptxXmlNode (parent.firstChild("gradFill"))
        if (null? gf) {
            def __missing@(optional):PptxGradient
            return __missing
        }
        def gnode:PptxXmlNode (unwrap gf)
        def g (new PptxGradient())
        g.isSet = true
        def lin@(optional):PptxXmlNode (gnode.firstChild("lin"))
        if (!null? lin) {
            def angS:string ((unwrap lin).attr("ang"))
            def ang@(optional):double (str2double angS)
            def a:double (?? ang 0.0)
            if (a > 2700000.0) {
                g.dir = 0
            } {
                g.dir = 1
            }
        }
        def gsLst@(optional):PptxXmlNode (gnode.firstChild("gsLst"))
        if (!null? gsLst) {
            def lst:PptxXmlNode (unwrap gsLst)
            def stops:[PptxXmlNode] (lst.childrenNamed("gs"))
            if ((array_length stops) > 0) {
                def c0@(optional):PptxColor (this.parseDirectColor((itemAt stops 0)))
                if (!null? c0) {
                    g.c1 = (unwrap c0)
                }
            }
            if ((array_length stops) > 1) {
                def last:int ((array_length stops) - 1)
                def c1@(optional):PptxColor (this.parseDirectColor((itemAt stops last)))
                if (!null? c1) {
                    g.c2 = (unwrap c1)
                }
            }
        }
        if (g.c1.isSet == false) {
            g.c1 = (PptxColor.srgbOf("4472C4"))
        }
        if (g.c2.isSet == false) {
            g.c2 = (PptxColor.srgbOf("FFFFFF"))
        }
        def hit@(optional):PptxGradient g
        return hit
    }

    fn parseShadow:void (spPr:PptxXmlNode shape:PptxShape) {
        def eff@(optional):PptxXmlNode (spPr.firstChild("effectLst"))
        if (null? eff) {
            return
        }
        def outer@(optional):PptxXmlNode ((unwrap eff).firstChild("outerShdw"))
        if (null? outer) {
            return
        }
        def o:PptxXmlNode (unwrap outer)
        shape.shadow.isSet = true
        def blurS:string (o.attr("blurRad"))
        if ((strlen blurS) > 0) {
            def bd@(optional):double (str2double blurS)
            shape.shadow.blurPt = (PptxUnits.emuToPt((?? bd 0.0)))
        }
        def distS:string (o.attr("dist"))
        def dirS:string (o.attr("dir"))
        def dist:double 0.0
        if ((strlen distS) > 0) {
            def dd@(optional):double (str2double distS)
            dist = (PptxUnits.emuToPt((?? dd 0.0)))
        }
        def dirDeg:double 45.0
        if ((strlen dirS) > 0) {
            def dr@(optional):double (str2double dirS)
            dirDeg = (PptxUnits.rotToDeg((?? dr 2700000.0)))
        }
        ; Approximate offset from polar dist/dir (dir 0 = right in DrawingML)
        ; Use simple quadrant: default down-right.
        shape.shadow.offsetXPt = (dist * 0.7)
        shape.shadow.offsetYPt = (dist * 0.7)
        if (dirDeg > 90.0) {
            if (dirDeg < 180.0) {
                shape.shadow.offsetXPt = (0.0 - (dist * 0.7))
            }
        }
        def col@(optional):PptxColor (this.parseColor(o))
        if (!null? col) {
            shape.shadow.color = (unwrap col)
        } {
            ; Often srgbClr is direct child of outerShdw
            def srgb@(optional):PptxXmlNode (o.firstChild("srgbClr"))
            if (!null? srgb) {
                def hex:string ((unwrap srgb).attr("val"))
                if ((strlen hex) == 6) {
                    shape.shadow.color = (PptxColor.srgbOf(hex))
                }
                def alpha@(optional):PptxXmlNode ((unwrap srgb).firstChild("alpha"))
                if (!null? alpha) {
                    def av@(optional):double (str2double ((unwrap alpha).attr("val")))
                    ; alpha is 1000ths of a percent (100000 = opaque)
                    shape.shadow.alpha = ((?? av 35000.0) / 100000.0)
                }
            }
            def sch@(optional):PptxXmlNode (o.firstChild("schemeClr"))
            if (!null? sch) {
                shape.shadow.color = (PptxColor.schemeOf(((unwrap sch).attr("val"))))
            }
        }
        if (shape.shadow.color.isSet == false) {
            shape.shadow.color = (PptxColor.srgbOf("000000"))
        }
    }

    fn parseCustGeomPath:void (spPr:PptxXmlNode shape:PptxShape) {
        def cust@(optional):PptxXmlNode (spPr.firstChild("custGeom"))
        if (null? cust) {
            return
        }
        def pathLst@(optional):PptxXmlNode ((unwrap cust).firstChild("pathLst"))
        if (null? pathLst) {
            return
        }
        def path@(optional):PptxXmlNode ((unwrap pathLst).firstChild("path"))
        if (null? path) {
            return
        }
        def pnode:PptxXmlNode (unwrap path)
        def wS:string (pnode.attr("w"))
        def hS:string (pnode.attr("h"))
        def pw:double 1.0
        def ph:double 1.0
        if ((strlen wS) > 0) {
            def wd@(optional):double (str2double wS)
            pw = (?? wd 1.0)
        }
        if ((strlen hS) > 0) {
            def hd@(optional):double (str2double hS)
            ph = (?? hd 1.0)
        }
        if (pw < 1.0) { pw = 1.0 }
        if (ph < 1.0) { ph = 1.0 }
        ; DrawingML's path grammar is not SVG's, but it says the same things,
        ; so it is TRANSLATED here and flattened by EVG's own path stack. That
        ; is what makes `cubicBezTo`, `quadBezTo` and `arcTo` draw at all: they
        ; used to be skipped, so a curved custom shape came out as a polygon of
        ; whichever of its points happened to be straight lines.
        def data:string ""
        def curX:double 0.0
        def curY:double 0.0
        def i:int 0
        while (i < (pnode.childCount())) {
            def ch:PptxXmlNode (pnode.childAt(i))
            if (ch.isText == false) {
                def kids:[PptxXmlNode] (ch.childrenNamed("pt"))
                if (ch.name == "moveTo") {
                    if ((array_length kids) >= 1) {
                        def m0:PptxXmlNode (itemAt kids 0)
                        curX = ((this.parseDoubleAttr(m0 "x")) / pw)
                        curY = ((this.parseDoubleAttr(m0 "y")) / ph)
                        data = ((data + " M ") + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "lnTo") {
                    if ((array_length kids) >= 1) {
                        def l0:PptxXmlNode (itemAt kids 0)
                        curX = ((this.parseDoubleAttr(l0 "x")) / pw)
                        curY = ((this.parseDoubleAttr(l0 "y")) / ph)
                        data = ((data + " L ") + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "cubicBezTo") {
                    if ((array_length kids) >= 3) {
                        def c1:PptxXmlNode (itemAt kids 0)
                        def c2:PptxXmlNode (itemAt kids 1)
                        def c3:PptxXmlNode (itemAt kids 2)
                        def x1:double ((this.parseDoubleAttr(c1 "x")) / pw)
                        def y1:double ((this.parseDoubleAttr(c1 "y")) / ph)
                        def x2:double ((this.parseDoubleAttr(c2 "x")) / pw)
                        def y2:double ((this.parseDoubleAttr(c2 "y")) / ph)
                        curX = ((this.parseDoubleAttr(c3 "x")) / pw)
                        curY = ((this.parseDoubleAttr(c3 "y")) / ph)
                        data = ((data + " C ") + (PptxGeom.pathNum(x1)) + "," + (PptxGeom.pathNum(y1)) + " " + (PptxGeom.pathNum(x2)) + "," + (PptxGeom.pathNum(y2)) + " " + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "quadBezTo") {
                    if ((array_length kids) >= 2) {
                        def q1:PptxXmlNode (itemAt kids 0)
                        def q2:PptxXmlNode (itemAt kids 1)
                        def qx:double ((this.parseDoubleAttr(q1 "x")) / pw)
                        def qy:double ((this.parseDoubleAttr(q1 "y")) / ph)
                        curX = ((this.parseDoubleAttr(q2 "x")) / pw)
                        curY = ((this.parseDoubleAttr(q2 "y")) / ph)
                        data = ((data + " Q ") + (PptxGeom.pathNum(qx)) + "," + (PptxGeom.pathNum(qy)) + " " + (PptxGeom.pathNum(curX)) + "," + (PptxGeom.pathNum(curY)))
                    }
                }
                if (ch.name == "arcTo") {
                    ; An arc is stated from where the pen is, as two radii and
                    ; two angles; SVG states it as two radii and where the pen
                    ; ENDS, plus which of the four arcs between them is meant.
                    def wR:double ((this.parseDoubleAttr(ch "wR")) / pw)
                    def hR:double ((this.parseDoubleAttr(ch "hR")) / ph)
                    def stDeg:double ((this.parseDoubleAttr(ch "stAng")) / 60000.0)
                    def swDeg:double ((this.parseDoubleAttr(ch "swAng")) / 60000.0)
                    def rad:double 0.017453292519943295
                    def st:double (stDeg * rad)
                    def en:double ((stDeg + swDeg) * rad)
                    def ccx:double (curX - (wR * (cos st)))
                    def ccy:double (curY - (hR * (sin st)))
                    def ex:double (ccx + (wR * (cos en)))
                    def ey:double (ccy + (hR * (sin en)))
                    def large:string "0"
                    def spanAbs:double (fabs swDeg)
                    if (spanAbs > 180.0) {
                        large = "1"
                    }
                    def sweep:string "0"
                    if (swDeg > 0.0) {
                        sweep = "1"
                    }
                    def rx:double (fabs wR)
                    def ry:double (fabs hR)
                    data = ((data + " A ") + (PptxGeom.pathNum(rx)) + "," + (PptxGeom.pathNum(ry)) + " 0 " + large + " " + sweep + " " + (PptxGeom.pathNum(ex)) + "," + (PptxGeom.pathNum(ey)))
                    curX = ex
                    curY = ey
                }
                if (ch.name == "close") {
                    data = (data + " Z")
                }
            }
            i = (i + 1)
        }
        if ((strlen data) == 0) {
            return
        }
        def pts:[double] (PptxGeom.flattenData(data))
        if ((array_length pts) >= 6) {
            shape.hasPath = true
            shape.pathUnit = pts
        }
    }

    fn parseSpPr:void (spPr:PptxXmlNode shape:PptxShape) {
        def xfrm@(optional):PptxXmlNode (spPr.firstChild("xfrm"))
        if (!null? xfrm) {
            this.parseXfrm((unwrap xfrm) shape)
        }
        def geom@(optional):PptxXmlNode (spPr.firstChild("prstGeom"))
        if (!null? geom) {
            def g:PptxXmlNode (unwrap geom)
            def prst:string (g.attr("prst"))
            if ((strlen prst) > 0) {
                shape.preset = prst
            }
        }
        this.parseCustGeomPath(spPr shape)
        def fill@(optional):PptxColor (this.parseColor(spPr))
        if (!null? fill) {
            shape.fill = (unwrap fill)
        }
        def grad@(optional):PptxGradient (this.parseGradient(spPr))
        if (!null? grad) {
            shape.fillGrad = (unwrap grad)
        }
        ; noFill explicitly clears
        def nf@(optional):PptxXmlNode (spPr.firstChild("noFill"))
        if (!null? nf) {
            shape.fill = (new PptxColor())
            shape.fillGrad = (new PptxGradient())
        }
        def ln@(optional):PptxXmlNode (spPr.firstChild("ln"))
        if (!null? ln) {
            def lineNode:PptxXmlNode (unwrap ln)
            def w:string (lineNode.attr("w"))
            if ((strlen w) > 0) {
                def wd@(optional):double (str2double w)
                shape.lineWidthPt = (PptxUnits.emuToPt((?? wd 0.0)))
            }
            def lc@(optional):PptxColor (this.parseColor(lineNode))
            if (!null? lc) {
                shape.line = (unwrap lc)
            }
        }
        this.parseShadow(spPr shape)
    }

    fn parseShape:PptxShape (sp:PptxXmlNode) {
        def shape (new PptxShape())
        shape.kind = 0
        def nv@(optional):PptxXmlNode (sp.firstChild("nvSpPr"))
        if (!null? nv) {
            def nvn:PptxXmlNode (unwrap nv)
            def cNv@(optional):PptxXmlNode (nvn.firstChild("cNvPr"))
            if (!null? cNv) {
                shape.name = ((unwrap cNv).attr("name"))
            }
            ; `a:spLocks` is how a deck says a shape is not to be dragged.
            ; Any of the three we care about counts as locked, because an
            ; editor that let you move a shape it refuses to resize would be
            ; the worst of both.
            def sp2@(optional):PptxXmlNode (nvn.firstChild("cNvSpPr"))
            if (!null? sp2) {
                def locks@(optional):PptxXmlNode ((unwrap sp2).firstChild("spLocks"))
                if (!null? locks) {
                    def ln:PptxXmlNode (unwrap locks)
                    if ((ln.attr("noMove")) == "1") {
                        shape.locked = true
                    }
                    if ((ln.attr("noResize")) == "1") {
                        shape.locked = true
                    }
                    if ((ln.attr("noSelect")) == "1") {
                        shape.locked = true
                    }
                }
            }
        }
        this.parsePlaceholderAttrs(sp shape)
        def spPr@(optional):PptxXmlNode (sp.firstChild("spPr"))
        if (!null? spPr) {
            this.parseSpPr((unwrap spPr) shape)
        }
        def tx@(optional):PptxXmlNode (sp.firstChild("txBody"))
        if (!null? tx) {
            shape.hasText = true
            shape.text = (this.parseTextBody((unwrap tx)))
        }
        return shape
    }

    fn parsePicture:PptxShape (pic:PptxXmlNode slidePart:string) {
        def shape (new PptxShape())
        shape.kind = 1
        def nv@(optional):PptxXmlNode (pic.firstChild("nvPicPr"))
        if (!null? nv) {
            def nvn:PptxXmlNode (unwrap nv)
            def cNv@(optional):PptxXmlNode (nvn.firstChild("cNvPr"))
            if (!null? cNv) {
                shape.name = ((unwrap cNv).attr("name"))
            }
        }
        def blipFill@(optional):PptxXmlNode (pic.firstChild("blipFill"))
        if (!null? blipFill) {
            def bf:PptxXmlNode (unwrap blipFill)
            def blip@(optional):PptxXmlNode (bf.firstChild("blip"))
            if (!null? blip) {
                def b:PptxXmlNode (unwrap blip)
                def rid:string (b.attr("r:embed"))
                if ((strlen rid) == 0) {
                    rid = (b.attr("embed"))
                }
                shape.imageRid = rid
                if ((strlen rid) > 0) {
                    shape.imagePart = (pkg.resolveRelationship(slidePart rid))
                    if ((strlen shape.imagePart) > 0) {
                        shape.imageBytes = (pkg.readBinary(shape.imagePart))
                    }
                }
            }
        }
        def spPr@(optional):PptxXmlNode (pic.firstChild("spPr"))
        if (!null? spPr) {
            this.parseSpPr((unwrap spPr) shape)
        }
        return shape
    }

    fn parseGroup:PptxShape (grp:PptxXmlNode slidePart:string) {
        def shape (new PptxShape())
        shape.kind = 2
        def nv@(optional):PptxXmlNode (grp.firstChild("nvGrpSpPr"))
        if (!null? nv) {
            def nvn:PptxXmlNode (unwrap nv)
            def cNv@(optional):PptxXmlNode (nvn.firstChild("cNvPr"))
            if (!null? cNv) {
                shape.name = ((unwrap cNv).attr("name"))
            }
        }
        def grpSpPr@(optional):PptxXmlNode (grp.firstChild("grpSpPr"))
        if (!null? grpSpPr) {
            def gsp:PptxXmlNode (unwrap grpSpPr)
            def xfrm@(optional):PptxXmlNode (gsp.firstChild("xfrm"))
            if (!null? xfrm) {
                this.parseXfrm((unwrap xfrm) shape)
            }
        }
        ; Children: sp / pic / grpSp / cxnSp
        def i:int 0
        while (i < (grp.childCount())) {
            def child:PptxXmlNode (grp.childAt(i))
            if (child.isText == false) {
                def parsed@(optional):PptxShape (this.parseTreeChild(child slidePart))
                if (!null? parsed) {
                    push shape.children (unwrap parsed)
                }
            }
            i = (i + 1)
        }
        return shape
    }

    fn parseTableCell:PptxTableCell (tc:PptxXmlNode) {
        def cell (new PptxTableCell())
        def txBody@(optional):PptxXmlNode (tc.find("txBody"))
        if (!null? txBody) {
            def body:PptxTextBody (this.parseTextBody((unwrap txBody)))
            cell.text = (body.plainText())
            if ((array_length body.paragraphs) > 0) {
                def para:PptxParagraph (itemAt body.paragraphs 0)
                cell.align = para.align
                if ((array_length para.runs) > 0) {
                    def run:PptxTextRun (itemAt para.runs 0)
                    cell.fontSizePt = run.fontSizePt
                    cell.bold = run.bold
                }
            }
        }
        def tcPr@(optional):PptxXmlNode (tc.firstChild("tcPr"))
        if (!null? tcPr) {
            def fill@(optional):PptxColor (this.parseColor((unwrap tcPr)))
            if (!null? fill) {
                cell.fill = (unwrap fill)
            }
        }
        return cell
    }

    fn parseTable:PptxShape (tbl:PptxXmlNode x:double y:double w:double h:double) {
        def shape (new PptxShape())
        shape.kind = 4
        shape.name = "Table"
        shape.x = x
        shape.y = y
        shape.width = w
        shape.height = h
        shape.hasXfrm = true
        def grid@(optional):PptxXmlNode (tbl.firstChild("tblGrid"))
        def cols:int 0
        if (!null? grid) {
            def gcs:[PptxXmlNode] ((unwrap grid).childrenNamed("gridCol"))
            cols = (array_length gcs)
        }
        def rows:[PptxXmlNode] (tbl.childrenNamed("tr"))
        shape.tableRows = (array_length rows)
        shape.tableCols = cols
        def ri:int 0
        while (ri < (array_length rows)) {
            def tr:PptxXmlNode (itemAt rows ri)
            def tcs:[PptxXmlNode] (tr.childrenNamed("tc"))
            if ((array_length tcs) > shape.tableCols) {
                shape.tableCols = (array_length tcs)
            }
            def ci:int 0
            while (ci < (array_length tcs)) {
                push shape.tableCells (this.parseTableCell((itemAt tcs ci)))
                ci = (ci + 1)
            }
            ; Pad row if short
            while (ci < shape.tableCols) {
                push shape.tableCells (new PptxTableCell())
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        return shape
    }

    fn parseChartPart:PptxChart (chartPart:string) {
        def chart (new PptxChart())
        def xml:string (pkg.readXml(chartPart))
        if ((strlen xml) == 0) {
            return chart
        }
        def root@(optional):PptxXmlNode (xmlParser.parse(xml))
        if (null? root) {
            return chart
        }
        def doc:PptxXmlNode (unwrap root)
        def title@(optional):PptxXmlNode (doc.find("title"))
        if (!null? title) {
            def t:PptxXmlNode (unwrap title)
            def tv@(optional):PptxXmlNode (t.find("t"))
            if (!null? tv) {
                chart.title = ((unwrap tv).textContent())
            }
        }
        def bar@(optional):PptxXmlNode (doc.find("barChart"))
        if (!null? bar) {
            chart.chartType = "bar"
        }
        def line@(optional):PptxXmlNode (doc.find("lineChart"))
        if (!null? line) {
            chart.chartType = "line"
        }
        def pie@(optional):PptxXmlNode (doc.find("pieChart"))
        if (!null? pie) {
            chart.chartType = "pie"
        }
        ; Categories from first ser/cat/strRef/strCache or numCache
        def ser@(optional):PptxXmlNode (doc.find("ser"))
        if (null? ser) {
            return chart
        }
        def snode:PptxXmlNode (unwrap ser)
        def series (new PptxChartSeries())
        def tx@(optional):PptxXmlNode (snode.firstChild("tx"))
        if (!null? tx) {
            def vt@(optional):PptxXmlNode ((unwrap tx).find("v"))
            if (!null? vt) {
                series.name = ((unwrap vt).textContent())
            }
        }
        def cat@(optional):PptxXmlNode (snode.firstChild("cat"))
        if (!null? cat) {
            def cache@(optional):PptxXmlNode ((unwrap cat).find("strCache"))
            if (null? cache) {
                cache = ((unwrap cat).find("numCache"))
            }
            if (!null? cache) {
                def pts2:[PptxXmlNode] ((unwrap cache).childrenNamed("pt"))
                def pi:int 0
                while (pi < (array_length pts2)) {
                    def pt:PptxXmlNode (itemAt pts2 pi)
                    def v@(optional):PptxXmlNode (pt.firstChild("v"))
                    if (!null? v) {
                        push chart.categories ((unwrap v).textContent())
                    }
                    pi = (pi + 1)
                }
            }
        }
        def val@(optional):PptxXmlNode (snode.firstChild("val"))
        if (!null? val) {
            def ncache@(optional):PptxXmlNode ((unwrap val).find("numCache"))
            if (!null? ncache) {
                def vpts:[PptxXmlNode] ((unwrap ncache).childrenNamed("pt"))
                def vi:int 0
                while (vi < (array_length vpts)) {
                    def vp:PptxXmlNode (itemAt vpts vi)
                    def vv@(optional):PptxXmlNode (vp.firstChild("v"))
                    if (!null? vv) {
                        def vd@(optional):double (str2double ((unwrap vv).textContent()))
                        push series.values (?? vd 0.0)
                    }
                    vi = (vi + 1)
                }
            }
        }
        push chart.series series
        return chart
    }

    fn parseGraphicFrame@(optional):PptxShape (gf:PptxXmlNode slidePart:string) {
        def x:double 0.0
        def y:double 0.0
        def w:double 0.0
        def h:double 0.0
        def xfrm@(optional):PptxXmlNode (gf.find("xfrm"))
        if (!null? xfrm) {
            def tmp (new PptxShape())
            this.parseXfrm((unwrap xfrm) tmp)
            x = tmp.x
            y = tmp.y
            w = tmp.width
            h = tmp.height
        }
        ; Table?
        def tbl@(optional):PptxXmlNode (gf.find("tbl"))
        if (!null? tbl) {
            def hit@(optional):PptxShape (this.parseTable((unwrap tbl) x y w h))
            return hit
        }
        ; Chart via graphicData / chart r:id
        def chartEl@(optional):PptxXmlNode (gf.find("chart"))
        if (!null? chartEl) {
            def rid:string ((unwrap chartEl).attr("r:id"))
            if ((strlen rid) == 0) {
                rid = ((unwrap chartEl).attr("id"))
            }
            def shape (new PptxShape())
            shape.kind = 5
            shape.name = "Chart"
            shape.x = x
            shape.y = y
            shape.width = w
            shape.height = h
            shape.hasXfrm = true
            if ((strlen rid) > 0) {
                def part:string (pkg.resolveRelationship(slidePart rid))
                if ((strlen part) > 0) {
                    shape.chart = (this.parseChartPart(part))
                }
            }
            def hit2@(optional):PptxShape shape
            return hit2
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    fn parseTreeChild@(optional):PptxShape (node:PptxXmlNode slidePart:string) {
        if (node.name == "sp") {
            def hit@(optional):PptxShape (this.parseShape(node))
            return hit
        }
        if (node.name == "pic") {
            def hit2@(optional):PptxShape (this.parsePicture(node slidePart))
            return hit2
        }
        if (node.name == "grpSp") {
            def hit3@(optional):PptxShape (this.parseGroup(node slidePart))
            return hit3
        }
        if (node.name == "cxnSp") {
            def shape (new PptxShape())
            shape.kind = 3
            def spPr@(optional):PptxXmlNode (node.firstChild("spPr"))
            if (!null? spPr) {
                this.parseSpPr((unwrap spPr) shape)
            }
            def hit4@(optional):PptxShape shape
            return hit4
        }
        if (node.name == "graphicFrame") {
            return (this.parseGraphicFrame(node slidePart))
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    fn parseSpTreeInto:void (tree:PptxXmlNode partPath:string shapes:[PptxShape]) {
        def i:int 0
        while (i < (tree.childCount())) {
            def child:PptxXmlNode (tree.childAt(i))
            if (child.isText == false) {
                if ((child.name != "nvGrpSpPr") && (child.name != "grpSpPr")) {
                    def parsed@(optional):PptxShape (this.parseTreeChild(child partPath))
                    if (!null? parsed) {
                        push shapes (unwrap parsed)
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn parseSheet:PptxSheet (partPath:string) {
        def sheet (new PptxSheet())
        sheet.partPath = partPath
        def xml:string (pkg.readXml(partPath))
        if ((strlen xml) == 0) {
            return sheet
        }
        def root@(optional):PptxXmlNode (xmlParser.parse(xml))
        if (null? root) {
            return sheet
        }
        def doc:PptxXmlNode (unwrap root)
        def cSld@(optional):PptxXmlNode (doc.find("cSld"))
        if (!null? cSld) {
            def cs:PptxXmlNode (unwrap cSld)
            def bg@(optional):PptxXmlNode (cs.firstChild("bg"))
            if (!null? bg) {
                def bgNode:PptxXmlNode (unwrap bg)
                def bgPr@(optional):PptxXmlNode (bgNode.firstChild("bgPr"))
                if (!null? bgPr) {
                    def col@(optional):PptxColor (this.parseColor((unwrap bgPr)))
                    if (!null? col) {
                        sheet.bg = (unwrap col)
                    }
                }
            }
            def spTree@(optional):PptxXmlNode (cs.firstChild("spTree"))
            if (!null? spTree) {
                this.parseSpTreeInto((unwrap spTree) partPath sheet.shapes)
            }
        }
        return sheet
    }

    fn ensureSheet@(optional):PptxSheet (cache:[string:PptxSheet] partPath:string) {
        if ((strlen partPath) == 0) {
            def __missing@(optional):PptxSheet
            return __missing
        }
        def existing@(optional):PptxSheet (get cache partPath)
        if (!null? existing) {
            return existing
        }
        def sheet:PptxSheet (this.parseSheet(partPath))
        set cache partPath sheet
        def hit@(optional):PptxSheet sheet
        return hit
    }

    ; The speaker's notes, which live in a part of their own that the slide
    ; points at. Only the body placeholder is notes — a notes slide also holds
    ; a thumbnail of the slide and its number, and neither is anything anyone
    ; typed.
    fn parseNotes:void (slide:PptxSlide) {
        def part:string (pkg.findRelationshipByType(slide.partPath "/notesSlide"))
        if ((strlen part) == 0) {
            return
        }
        slide.notesPart = part
        def xml:string (pkg.readXml(part))
        if ((strlen xml) == 0) {
            return
        }
        def root@(optional):PptxXmlNode (xmlParser.parse(xml))
        if (null? root) {
            return
        }
        def doc:PptxXmlNode (unwrap root)
        def tree@(optional):PptxXmlNode (doc.find("spTree"))
        if (null? tree) {
            return
        }
        def shapes:[PptxXmlNode] ((unwrap tree).childrenNamed("sp"))
        def i:int 0
        while (i < (array_length shapes)) {
            def sp:PptxXmlNode (itemAt shapes i)
            def shape:PptxShape (this.parseShape(sp))
            def isBody:boolean false
            if (shape.isPlaceholder) {
                if (shape.phType == "body") {
                    isBody = true
                }
            }
            if isBody {
                slide.notes = shape
                slide.notes.inherited = false
                return
            }
            i = (i + 1)
        }
    }

    fn parseSlide:PptxSlide (partPath:string width:double height:double) {
        def slide (new PptxSlide())
        slide.partPath = partPath
        slide.width = width
        slide.height = height
        def xml:string (pkg.readXml(partPath))
        if ((strlen xml) == 0) {
            return slide
        }
        def root@(optional):PptxXmlNode (xmlParser.parse(xml))
        if (null? root) {
            return slide
        }
        def doc:PptxXmlNode (unwrap root)
        ; Background
        def cSld@(optional):PptxXmlNode (doc.find("cSld"))
        if (!null? cSld) {
            def cs:PptxXmlNode (unwrap cSld)
            def bg@(optional):PptxXmlNode (cs.firstChild("bg"))
            if (!null? bg) {
                def bgNode:PptxXmlNode (unwrap bg)
                def bgPr@(optional):PptxXmlNode (bgNode.firstChild("bgPr"))
                if (!null? bgPr) {
                    def col@(optional):PptxColor (this.parseColor((unwrap bgPr)))
                    if (!null? col) {
                        slide.bg = (unwrap col)
                    }
                }
            }
            def spTree@(optional):PptxXmlNode (cs.firstChild("spTree"))
            if (!null? spTree) {
                this.parseSpTreeInto((unwrap spTree) partPath slide.shapes)
            }
        }
        ; Layout relationship
        slide.layoutPart = (pkg.findRelationshipByType(partPath "/slideLayout"))
        this.parseNotes(slide)
        return slide
    }

    fn parseTheme:PptxTheme (partPath:string) {
        def theme (new PptxTheme())
        ; Sensible Office defaults even if theme is missing
        theme.setColor("dk1" "000000")
        theme.setColor("lt1" "FFFFFF")
        theme.setColor("dk2" "44546A")
        theme.setColor("lt2" "E7E6E6")
        theme.setColor("accent1" "4472C4")
        theme.setColor("accent2" "ED7D31")
        theme.setColor("accent3" "A5A5A5")
        theme.setColor("accent4" "FFC000")
        theme.setColor("accent5" "5B9BD5")
        theme.setColor("accent6" "70AD47")
        theme.setColor("hlink" "0563C1")
        theme.setColor("folHlink" "954F72")
        if ((strlen partPath) == 0) {
            return theme
        }
        def xml:string (pkg.readXml(partPath))
        if ((strlen xml) == 0) {
            return theme
        }
        def root@(optional):PptxXmlNode (xmlParser.parse(xml))
        if (null? root) {
            return theme
        }
        def doc:PptxXmlNode (unwrap root)
        def scheme@(optional):PptxXmlNode (doc.find("clrScheme"))
        if (!null? scheme) {
            def sch:PptxXmlNode (unwrap scheme)
            def i:int 0
            while (i < (sch.childCount())) {
                def child:PptxXmlNode (sch.childAt(i))
                if (child.isText == false) {
                    def name:string child.name
                    def srgb@(optional):PptxXmlNode (child.firstChild("srgbClr"))
                    if (!null? srgb) {
                        theme.setColor(name ((unwrap srgb).attr("val")))
                    }
                    def sys@(optional):PptxXmlNode (child.firstChild("sysClr"))
                    if (!null? sys) {
                        def last:string ((unwrap sys).attr("lastClr"))
                        if ((strlen last) == 6) {
                            theme.setColor(name last)
                        }
                    }
                }
                i = (i + 1)
            }
        }
        def major@(optional):PptxXmlNode (doc.find("majorFont"))
        if (!null? major) {
            def latin@(optional):PptxXmlNode ((unwrap major).firstChild("latin"))
            if (!null? latin) {
                def tf:string ((unwrap latin).attr("typeface"))
                if ((strlen tf) > 0) {
                    theme.majorFont = tf
                }
            }
        }
        def minor@(optional):PptxXmlNode (doc.find("minorFont"))
        if (!null? minor) {
            def latin2@(optional):PptxXmlNode ((unwrap minor).firstChild("latin"))
            if (!null? latin2) {
                def tf2:string ((unwrap latin2).attr("typeface"))
                if ((strlen tf2) > 0) {
                    theme.minorFont = tf2
                }
            }
        }
        return theme
    }

    ; `p14:sectionLst`, which lives in the presentation's extLst. A deck with
    ; no sections is the common case and parses to an empty list, not an error.
    fn parseSections:void (pres:PptxPresentation doc:PptxXmlNode) {
        def lst@(optional):PptxXmlNode (doc.find("sectionLst"))
        if (null? lst) {
            return
        }
        def node:PptxXmlNode (unwrap lst)
        def secs:[PptxXmlNode] (node.childrenNamed("section"))
        def i:int 0
        while (i < (array_length secs)) {
            def sn:PptxXmlNode (itemAt secs i)
            def sec (new PptxSection())
            sec.name = (sn.attr("name"))
            sec.id = (sn.attr("id"))
            def ids@(optional):PptxXmlNode (sn.find("sldIdLst"))
            if (!null? ids) {
                def idNode:PptxXmlNode (unwrap ids)
                def kids:[PptxXmlNode] (idNode.childrenNamed("sldId"))
                def k:int 0
                while (k < (array_length kids)) {
                    def kid:PptxXmlNode (itemAt kids k)
                    def v@(optional):int (str2int (kid.attr("id")))
                    push sec.slideIds (?? v 0)
                    k = (k + 1)
                }
            }
            push pres.sections sec
            i = (i + 1)
        }
    }

    fn parsePresentation:PptxPresentation () {
        def pres (new PptxPresentation())
        def xml:string (pkg.readXml("ppt/presentation.xml"))
        if ((strlen xml) == 0) {
            return pres
        }
        def root@(optional):PptxXmlNode (xmlParser.parse(xml))
        if (null? root) {
            return pres
        }
        def doc:PptxXmlNode (unwrap root)
        def sldSz@(optional):PptxXmlNode (doc.find("sldSz"))
        if (!null? sldSz) {
            def sz:PptxXmlNode (unwrap sldSz)
            pres.slideWidth = (PptxUnits.emuToPt((this.parseDoubleAttr(sz "cx"))))
            pres.slideHeight = (PptxUnits.emuToPt((this.parseDoubleAttr(sz "cy"))))
        }
        ; Slide order from sldIdLst → relationships. The `id` on each entry is
        ; the name sections use for a slide, so it is kept alongside the part.
        def slideIds:[int]
        def idLst@(optional):PptxXmlNode (doc.find("sldIdLst"))
        if (!null? idLst) {
            def lst:PptxXmlNode (unwrap idLst)
            def ids:[PptxXmlNode] (lst.childrenNamed("sldId"))
            def i:int 0
            while (i < (array_length ids)) {
                def idNode:PptxXmlNode (itemAt ids i)
                def rid:string (idNode.attr("r:id"))
                def own:string (idNode.attr("id"))
                if ((strlen rid) == 0) {
                    ; Rare writers omit the prefix
                    rid = own
                    own = ""
                }
                def part:string (pkg.resolveRelationship("ppt/presentation.xml" rid))
                if ((strlen part) > 0) {
                    push pres.slideParts part
                    def sid@(optional):int (str2int own)
                    push slideIds (?? sid 0)
                }
                i = (i + 1)
            }
        }
        this.parseSections(pres doc)
        ; Theme via master
        def masterPart:string (pkg.findRelationshipByType("ppt/presentation.xml" "/slideMaster"))
        if ((strlen masterPart) > 0) {
            pres.themePart = (pkg.findRelationshipByType(masterPart "/theme"))
        }
        if ((strlen pres.themePart) == 0) {
            ; Common default path
            if (pkg.hasPart("ppt/theme/theme1.xml")) {
                pres.themePart = "ppt/theme/theme1.xml"
            }
        }
        pres.theme = (this.parseTheme(pres.themePart))
        ; Parse each slide + ensure layout/master sheets are cached
        def si:int 0
        while (si < (array_length pres.slideParts)) {
            def part:string (itemAt pres.slideParts si)
            def slide:PptxSlide (this.parseSlide(part pres.slideWidth pres.slideHeight))
            if (si < (array_length slideIds)) {
                slide.slideId = (itemAt slideIds si)
            }
            if ((strlen slide.layoutPart) > 0) {
                slide.masterPart = (pkg.findRelationshipByType(slide.layoutPart "/slideMaster"))
                this.ensureSheet(pres.layouts slide.layoutPart)
            }
            if ((strlen slide.masterPart) > 0) {
                this.ensureSheet(pres.masters slide.masterPart)
            }
            push pres.slides slide
            si = (si + 1)
        }
        return pres
    }
}

; ==============================================================================
; PptxTextMeasure - how wide a string is, asked once and answered consistently
; ==============================================================================
;
; The painter and the caret have to agree about the width of a piece of text or
; the caret sits somewhere the glyphs are not. That agreement is this class:
; one measurer, handed to the layout, used by both.
;
; It answers with the real font when a host has attached its text renderer, and
; with the old average-width guess (0.52em) when nothing has — a headless test
; or an export path has no fonts loaded, and a layout that cannot be computed
; at all is worse than one computed approximately.
; ==============================================================================

Import "../../game_engine/ui/UIContext.rgr"
Import "../../office/text/OfficeFont.rgr"

class PptxTextMeasure {
    def hasCtx:boolean false
    def ctx:UIContext (new UIContext)
    def family:string "Open Sans"
    def emFactor:double 0.52

    Constructor () {
    }

    fn attach:void (c:UIContext fam:string) {
        ctx = c
        family = fam
        hasCtx = true
    }

    ; The face the painter will actually use. `PptxView.paintTextCmd` switches
    ; the renderer's family by weight, so measuring has to switch the same way
    ; — a bold string is wider than the regular one, and a caret that measured
    ; the regular face lands short of the text it belongs to.
    ;
    ; The naming is `OfficeFont`'s, shared with the .docx reader, and so is the
    ; walk when the face is not loaded: this used to name "Family-Bold Italic"
    ; without ever asking whether such a face existed, so a deck whose family
    ; had no italic measured against whatever the renderer fell back to and
    ; never said which one that was.
    fn faceFor:string (bold:boolean italic:boolean) {
        if (hasCtx == false) {
            return (OfficeFont.faceName(family bold italic))
        }
        def hit:string (OfficeFont.resolve(ctx.tr.fm family bold italic family))
        if ((strlen hit) > 0) {
            return hit
        }
        return (OfficeFont.faceName(family bold italic))
    }

    ; Whether the face a deck NAMED is one we can actually draw with. When it
    ; is not, everything below measures a different font at the same point
    ; size, and a box the author sized to fit is a box the text spills out of.
    ; With no renderer attached there is no substitution to detect, so nothing
    ; here reports one.
    fn hasFamily:boolean (fam:string) {
        if ((strlen fam) == 0) {
            return true
        }
        if (hasCtx == false) {
            return true
        }
        return ((OfficeFont.substituted(ctx.tr.fm fam)) == false)
    }

    fn widthOf:double (text:string sizePx:double bold:boolean italic:boolean) {
        if ((strlen text) == 0) {
            return 0.0
        }
        if (hasCtx == false) {
            return ((to_double (strlen text)) * sizePx * emFactor)
        }
        def prev:string ctx.tr.fontFamily
        ctx.tr.fontFamily = (this.faceFor(bold italic))
        def w:double (ctx.measureWidth(text sizePx))
        ctx.tr.fontFamily = prev
        return w
    }
}

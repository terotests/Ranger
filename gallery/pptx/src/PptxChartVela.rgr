; ==============================================================================
; PptxChartVela - PptxChart → Vega-Lite → Vela commands → EVGDrawCmd rects
; ==============================================================================
;
; Proof-of-concept only: bar/column charts with categories + one series.
; EVG still never sees ChartML — only resolved draw commands.
; ==============================================================================

Import "PptxModel.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../vela/src/VlJson.rgr"
Import "../../vela/src/VlCompile.rgr"
Import "../../vela/src/VlRuntime.rgr"
Import "../../vela/src/VlCommand.rgr"

class PptxChartVela {
    Constructor () {
    }

    sfn jsonEscape:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (c == 34) {
                out = (out + "\\\"")
            } {
                if (c == 92) {
                    out = (out + "\\\\")
                } {
                    out = (out + (strfromcode c))
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn buildVlJson:string (chart:PptxChart) {
        def values:string ""
        def n:int (array_length chart.categories)
        def series:PptxChartSeries (new PptxChartSeries())
        if ((array_length chart.series) > 0) {
            series = (itemAt chart.series 0)
        }
        def i:int 0
        while (i < n) {
            if (i > 0) {
                values = (values + ",")
            }
            def cat:string (itemAt chart.categories i)
            def val:double 0.0
            if (i < (array_length series.values)) {
                val = (itemAt series.values i)
            }
            values = (values + "{\"a\":\"" + (PptxChartVela.jsonEscape(cat)) + "\",\"b\":" + (to_string val) + "}")
            i = (i + 1)
        }
        def mark:string "bar"
        def xField:string "{\"field\":\"a\",\"type\":\"nominal\"}"
        def yField:string "{\"field\":\"b\",\"type\":\"quantitative\"}"
        if (chart.chartType == "col") {
            mark = "bar"
        }
        if (chart.chartType == "line") {
            mark = "line"
        }
        def title:string ""
        if ((strlen chart.title) > 0) {
            title = (",\"title\":\"" + (PptxChartVela.jsonEscape(chart.title)) + "\"")
        }
        return ("{\"data\":{\"values\":[" + values + "]},\"mark\":\"" + mark + "\",\"encoding\":{\"x\":" + xField + ",\"y\":" + yField + "}" + title + "}")
    }

    sfn parseHexColor:EVGColor (fill:string) {
        if ((strlen fill) >= 7) {
            if ((charAt fill 0) == 35) {
                def hex:string (substring fill 1 7)
                return (EVGColor.parse("#" + hex))
            }
        }
        return (EVGColor.rgb(68 114 196))
    }

    ; Emit chart into an existing display list inside the given pixel box.
    sfn emitToDisplayList:void (dl:EVGDisplayList chart:PptxChart x:double y:double w:double h:double) {
        if ((array_length chart.categories) == 0) {
            ; Fallback empty frame
            def c (new EVGDrawCmd())
            c.kind = 0
            c.x = x
            c.y = y
            c.w = w
            c.h = h
            c.r = 240
            c.g = 240
            c.b = 245
            c.a = 1.0
            push dl.cmds c
            return
        }
        def vlText:string (PptxChartVela.buildVlJson(chart))
        def parser (new VlJsonParser())
        def vl:VlJson (parser.parse(vlText))
        if (parser.ok == false) {
            return
        }
        def compiler (new VlCompile())
        def vg:VlJson (compiler.compile(vl))
        def rt (new VlRuntime())
        def scene:VlSceneMark (rt.run(vg))
        def list:VlCommandList (VlSceneCommands.build(scene))
        def viewW:double (rt.viewWidth())
        def viewH:double (rt.viewHeight())
        if (viewW < 1.0) { viewW = 400.0 }
        if (viewH < 1.0) { viewH = 300.0 }
        def sx:double (w / viewW)
        def sy:double (h / viewH)
        def pad:double 4.0
        ; Background
        def bg (new EVGDrawCmd())
        bg.kind = 0
        bg.x = x
        bg.y = y
        bg.w = w
        bg.h = h
        bg.r = 250
        bg.g = 250
        bg.b = 252
        bg.a = 1.0
        push dl.cmds bg
        def i:int 0
        while (i < (array_length list.commands)) {
            def cmd:VlDrawCommand (itemAt list.commands i)
            if (cmd.op == "rect") {
                if cmd.hasFill {
                    def col:EVGColor (PptxChartVela.parseHexColor(cmd.fill))
                    def r (new EVGDrawCmd())
                    r.kind = 0
                    r.x = (x + pad + (cmd.x * sx))
                    r.y = (y + pad + (cmd.y * sy))
                    r.w = (cmd.width * sx)
                    r.h = (cmd.height * sy)
                    if (r.w < 1.0) { r.w = 1.0 }
                    if (r.h < 1.0) { r.h = 1.0 }
                    r.r = (col.red())
                    r.g = (col.green())
                    r.b = (col.blue())
                    r.a = 1.0
                    push dl.cmds r
                }
            }
            if (cmd.op == "text") {
                def tcol:EVGColor (EVGColor.rgb(40 40 50))
                if cmd.hasFill {
                    tcol = (PptxChartVela.parseHexColor(cmd.fill))
                }
                def t (new EVGDrawCmd())
                t.kind = 3
                t.x = (x + pad + (cmd.x * sx))
                t.y = (y + pad + (cmd.y * sy))
                t.text = cmd.text
                t.fontSize = (cmd.fontSize * sy)
                if (t.fontSize < 9.0) {
                    t.fontSize = 9.0
                }
                if (t.fontSize > 18.0) {
                    t.fontSize = 18.0
                }
                t.fontFamily = "Open Sans"
                t.r = (tcol.red())
                t.g = (tcol.green())
                t.b = (tcol.blue())
                t.a = 1.0
                push dl.cmds t
            }
            i = (i + 1)
        }
    }
}

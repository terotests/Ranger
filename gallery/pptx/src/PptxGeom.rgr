; ==============================================================================
; PptxGeom - DrawingML geometry → flat polygon points (unit box)
; ==============================================================================
;
; Returns [x0,y0,x1,y1,…] in unit space [0,1]×[0,1]; `scaleToBox` puts that in
; the shape's rectangle and SoftCanvas / WebGL fill it.
;
; The shapes are written as **SVG path data** and flattened by EVG's own vector
; stack (`SVGPathParser`), rather than as tables of points typed out here. That
; is the difference between a circle and a twelve-sided polygon: `parse` turns
; an `A` arc into cubics the way SVG says to, and `flatten` walks the curve at
; whatever resolution it is asked for. It also means a preset is one readable
; line — the same line a designer would write — instead of twenty pushes.
;
; What it deliberately does NOT do is holes: `flatten` welds every subpath into
; one ring, and the display list's polygon primitive has no even-odd rule, so a
; donut would come out solid. Single-contour presets only, until the painter
; grows rings.
; ==============================================================================

Import "../../evg/SVGPathParser.rgr"

class PptxGeom {
    Constructor () {
    }

    sfn pushPt:void (pts:[double] x:double y:double) {
        push pts x
        push pts y
    }

    ; Segments per curve. 16 puts an ellipse's error under a thousandth of its
    ; box, which is finer than a pixel on any slide anyone will project.
    sfn curveSteps:int () {
        return 16
    }

    ; A preset as SVG path data in the unit box. An empty string means "this is
    ; not a path shape" — `rect` and `roundRect` are drawn by the rounded-rect
    ; primitive, which knows about gradients and shadows in a way a polygon
    ; does not.
    sfn presetPath:string (preset:string) {
        if (preset == "ellipse") {
            return "M 1,0.5 A 0.5,0.5 0 1 1 0,0.5 A 0.5,0.5 0 1 1 1,0.5 Z"
        }
        if (preset == "triangle") {
            return "M 0.5,0 L 1,1 L 0,1 Z"
        }
        if (preset == "rtTriangle") {
            return "M 0,0 L 0,1 L 1,1 Z"
        }
        if (preset == "diamond") {
            return "M 0.5,0 L 1,0.5 L 0.5,1 L 0,0.5 Z"
        }
        if (preset == "parallelogram") {
            return "M 0.25,0 L 1,0 L 0.75,1 L 0,1 Z"
        }
        if (preset == "trapezoid") {
            return "M 0.25,0 L 0.75,0 L 1,1 L 0,1 Z"
        }
        if (preset == "pentagon") {
            return "M 0.5,0 L 1,0.38 L 0.81,1 L 0.19,1 L 0,0.38 Z"
        }
        if (preset == "hexagon") {
            return "M 0.25,0 L 0.75,0 L 1,0.5 L 0.75,1 L 0.25,1 L 0,0.5 Z"
        }
        if (preset == "octagon") {
            return "M 0.29,0 L 0.71,0 L 1,0.29 L 1,0.71 L 0.71,1 L 0.29,1 L 0,0.71 L 0,0.29 Z"
        }
        if (preset == "chevron") {
            return "M 0,0 L 0.65,0 L 1,0.5 L 0.65,1 L 0,1 L 0.35,0.5 Z"
        }
        if (preset == "homePlate") {
            return "M 0,0 L 0.75,0 L 1,0.5 L 0.75,1 L 0,1 Z"
        }
        if (preset == "star5") {
            return "M 0.5,0 L 0.62,0.35 L 1,0.38 L 0.7,0.62 L 0.81,1 L 0.5,0.78 L 0.19,1 L 0.3,0.62 L 0,0.38 L 0.38,0.35 Z"
        }
        if (preset == "rightArrow") {
            return "M 0,0.3 L 0.6,0.3 L 0.6,0.05 L 1,0.5 L 0.6,0.95 L 0.6,0.7 L 0,0.7 Z"
        }
        if (preset == "leftArrow") {
            return "M 1,0.3 L 0.4,0.3 L 0.4,0.05 L 0,0.5 L 0.4,0.95 L 0.4,0.7 L 1,0.7 Z"
        }
        if (preset == "upArrow") {
            return "M 0.3,1 L 0.3,0.4 L 0.05,0.4 L 0.5,0 L 0.95,0.4 L 0.7,0.4 L 0.7,1 Z"
        }
        if (preset == "downArrow") {
            return "M 0.3,0 L 0.3,0.6 L 0.05,0.6 L 0.5,1 L 0.95,0.6 L 0.7,0.6 L 0.7,0 Z"
        }
        if (preset == "plus") {
            return "M 0.35,0 L 0.65,0 L 0.65,0.35 L 1,0.35 L 1,0.65 L 0.65,0.65 L 0.65,1 L 0.35,1 L 0.35,0.65 L 0,0.65 L 0,0.35 L 0.35,0.35 Z"
        }
        if (preset == "flowChartTerminator") {
            return "M 0.17,0 L 0.83,0 A 0.17,0.5 0 0 1 0.83,1 L 0.17,1 A 0.17,0.5 0 0 1 0.17,0 Z"
        }
        ; Brackets and braces are OPEN paths — they are a stroke, not a filled
        ; area, which is what a shape with `noFill` and a line is.
        if (preset == "leftBracket") {
            return "M 1,0 L 0.25,0 L 0,0.12 L 0,0.88 L 0.25,1 L 1,1"
        }
        if (preset == "rightBracket") {
            return "M 0,0 L 0.75,0 L 1,0.12 L 1,0.88 L 0.75,1 L 0,1"
        }
        if (preset == "leftBrace") {
            return "M 1,0 L 0.62,0.06 L 0.62,0.44 L 0,0.5 L 0.62,0.56 L 0.62,0.94 L 1,1"
        }
        if (preset == "rightBrace") {
            return "M 0,0 L 0.38,0.06 L 0.38,0.44 L 1,0.5 L 0.38,0.56 L 0.38,0.94 L 0,1"
        }
        if (preset == "line") {
            return "M 0,0 L 1,1"
        }
        if (preset == "roundRect") {
            return ""
        }
        return ""
    }

    ; A path that is a line rather than an area: filling it would draw a solid
    ; blob where the deck asked for a stroke.
    sfn isOpenPath:boolean (preset:string) {
        if (preset == "leftBracket") { return true }
        if (preset == "rightBracket") { return true }
        if (preset == "leftBrace") { return true }
        if (preset == "rightBrace") { return true }
        if (preset == "line") { return true }
        if (preset == "straightConnector1") { return true }
        return false
    }

    ; Flatten path data into the unit-space point list the painter consumes.
    sfn flattenData:[double] (data:string) {
        def parser (new SVGPathParser())
        parser.parse(data)
        return (parser.flatten((PptxGeom.curveSteps())))
    }

    sfn unitPreset:[double] (preset:string) {
        def data:string (PptxGeom.presetPath(preset))
        if ((strlen data) > 0) {
            return (PptxGeom.flattenData(data))
        }
        def pts:[double]
        PptxGeom.pushPt(pts 0.0 0.0)
        PptxGeom.pushPt(pts 1.0 0.0)
        PptxGeom.pushPt(pts 1.0 1.0)
        PptxGeom.pushPt(pts 0.0 1.0)
        return pts
    }

    ; A number in path data, without an exponent: `1e-7` is a perfectly good
    ; double and not a number any path parser has to accept.
    sfn pathNum:string (v:double) {
        ; Rounded on the magnitude and the sign put back, because `to_int`
        ; FLOORS: `(v - 0.5)` on a negative rounds away from zero twice and
        ; -0.25 comes out -0.250001. The same shape of bug the JPEG encoder
        ; had in its quantizer.
        def neg:boolean (v < 0.0)
        def mag:double v
        if neg {
            mag = (0.0 - v)
        }
        def r:int (to_int ((mag * 1000000.0) + 0.5))
        def back:double ((to_double r) / 1000000.0)
        if neg {
            back = (0.0 - back)
        }
        return (to_string back)
    }

    sfn scaleToBox:[double] (unit:[double] x:double y:double w:double h:double) {
        def out:[double]
        def i:int 0
        while (i < (array_length unit)) {
            def ux:double (itemAt unit i)
            def uy:double (itemAt unit (i + 1))
            push out (x + (ux * w))
            push out (y + (uy * h))
            i = (i + 2)
        }
        return out
    }

    sfn needsPath:boolean (preset:string) {
        return ((strlen (PptxGeom.presetPath(preset))) > 0)
    }
}

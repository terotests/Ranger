; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxVegaShapes.rgr — a Vega specification becomes DrawingML, not a picture
; ==============================================================================
;
; The usual way to put a chart on a slide is to draw it and paste the pixels in.
; That is what every "export chart to PowerPoint" path does, and the deck then
; carries a PNG: a quarter of a megabyte for something that is forty rectangles,
; blurred at any zoom the author did not anticipate, and dead — nobody can
; recolour a bar, fix a typo in an axis title or read the numbers out of it
; again.
;
; None of that is necessary. Vela already compiles a Vega or Vega-Lite
; specification down to `VlCommandList`: a flat list of absolute-coordinate
; drawing commands — rects, lines, text, outlines. And PresentationML's shape
; tree is also rects, lines, text and outlines. The two meet directly, with no
; raster step between them, so this file is a translation rather than a
; renderer. What comes out is a `p:grpSp` of ordinary `p:sp`s that PowerPoint,
; Keynote and Google Slides treat as shapes they drew themselves.
;
; WHAT THAT BUYS, MEASURED. A four-bar Vega-Lite chart with both axes is 35
; shapes: 14.5 KB of slide XML, which deflates to 1.4 KB. Drawn instead as a
; picture of the same slide it is a 30.7 KB PNG at 1280x720 — twenty times the
; compressed size, and fixed at that resolution. It stays sharp when the deck
; is shown on a projector. Every bar is selectable, every label is editable,
; and the text is in the slide's text — so search, alt text and a screen reader
; all reach it, which no image of a chart offers.
;
; One caveat on the first number: the OPC writer stores its parts rather than
; deflating them, so today a chart adds its full 14.5 KB to the .pptx. The
; deflated figure is what the same bytes cost in a package written by
; PowerPoint, and what they will cost here when ZipWriter learns method 8.
;
; HOW EACH COMMAND IS SPELLED. The choice is always the smallest DrawingML that
; says the same thing, because the alternative — one `custGeom` per command —
; is both larger and unhelpful to somebody who then wants to nudge a bar:
;
;   rect, square corners  -> prstGeom "rect"        (a bar, a legend swatch)
;   rect, rounded corners -> prstGeom "roundRect"   (with the adjust value)
;   line, two points      -> prstGeom "line"        (gridlines, ticks, rules)
;   symbol "circle"       -> prstGeom "ellipse"     (a scatter point)
;   text                  -> a text box            (labels, titles, legends)
;   anything else         -> custGeom              (areas, wedges, curves)
;
; The last row is where the curves go. `VlShape` — the same file the SVG and
; EVG backends ask for their outlines, so a wedge here is the wedge there —
; builds the outline, and it is FLATTENED to a polyline at `steps` segments per
; curve. DrawingML has cubic segments and could carry the curves as curves; the
; model's path is a point list, and widening it is a change to the parser, the
; editor and the round trip rather than to this file. Sixteen segments on a
; chart-sized arc is under a tenth of a point of error, which is below what a
; projector can show.
;
; WHAT THIS DOES NOT DO. A ring with a hole in it — an even-odd fill — becomes
; one shape per ring, so a donut's hole is filled rather than cut. No chart in
; the Vega-Lite examples produces one; a Vega specification with a hand-written
; `path` mark can. Gradients, dash patterns and clip paths are dropped rather
; than approximated: each is a visible lie about what the specification said,
; and the fill, the stroke and the geometry — which are what the picture is —
; are carried exactly.
; ==============================================================================

Import "PptxModel.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../evg/PathBuilder.rgr"
Import "../../evg/SVGPathParser.rgr"
Import "../../vela/src/VlJson.rgr"
Import "../../vela/src/VlCompile.rgr"
Import "../../vela/src/VlRuntime.rgr"
Import "../../vela/src/VlCommand.rgr"
Import "../../vela/src/VlShape.rgr"

class PptxVegaShapes {
    ; Curve subdivision, and the same budget VlEvgList uses: a chart is small
    ; and its curves are short, so this is fixed rather than derived from the
    ; drawn size.
    def steps:int 16
    ; What "sans-serif" is called on a slide. Vega names a CSS family and a
    ; deck names a font; writing "sans-serif" into a run gives every reader a
    ; different chart, and picking the theme's minor font gives every DECK a
    ; different chart. A stated name is the only one of the three that is the
    ; same everywhere, and it is settable for a house font.
    def sansFamily:string "Calibri"
    ; Below this a label is a smudge at any zoom, and a smudge that is still
    ; selectable is worse than one that is not there.
    def minFontPt:double 5.0

    ; How it went. There are no exceptions here for the same reason there are
    ; none in PptxApi: a failure is a value, so a caller can look at it.
    def ok:boolean false
    def error:string ""
    ; What was emitted, for a test that wants to assert a chart drew something
    ; without owning a rasterizer.
    def shapeCount:int 0
    def textCount:int 0
    ; What the specification asked to be, before it was fitted to the box.
    def viewWidth:double 0.0
    def viewHeight:double 0.0

    Constructor () {
    }

    ; --- entry -----------------------------------------------------------

    ; Compile `specJson` and lay the result out inside the box, in points.
    ;
    ; The view keeps its aspect ratio and is centred: a specification that says
    ; 200×200 put into a 400×200 box is a square chart in the middle of it,
    ; rather than a square chart stretched into an oblong. Ask for the box you
    ; want the chart to have and let the specification state the size.
    fn build:PptxShape (specJson:string x:double y:double w:double h:double) {
        ok = false
        error = ""
        shapeCount = 0
        textCount = 0
        def group (new PptxShape())
        group.kind = (PptxShapeKind.group())
        group.name = "Chart"
        group.x = x
        group.y = y
        group.width = w
        group.height = h
        group.hasXfrm = true
        ; The child coordinate space is the group's own box, so a child holds
        ; slide points and nothing is scaled twice. A group whose chExt differs
        ; from its ext scales its children — including, in some readers, their
        ; text and in others not, which is exactly the sort of difference that
        ; shows up only on the projector.
        group.chX = x
        group.chY = y
        group.chW = w
        group.chH = h

        def parser (new VlJsonParser())
        def vl:VlJson (parser.parse(specJson))
        if (parser.ok == false) {
            error = ("the specification is not JSON: " + parser.err)
            return group
        }
        def compiler (new VlCompile())
        def vg:VlJson (compiler.compile(vl))
        def rt (new VlRuntime())
        def scene:VlSceneMark (rt.run(vg))
        def errs:int (rt.errorCount())
        if (errs > 0) {
            error = "the specification did not compile"
            return group
        }
        def list:VlCommandList (VlSceneCommands.build(scene))
        def viewW:double (rt.viewWidth())
        def viewH:double (rt.viewHeight())
        viewWidth = viewW
        viewHeight = viewH
        if (viewW < 1.0) {
            error = "the specification has no width"
            return group
        }
        if (viewH < 1.0) {
            error = "the specification has no height"
            return group
        }
        def sx:double (w / viewW)
        def sy:double (h / viewH)
        def scale:double sx
        if (sy < scale) {
            scale = sy
        }
        if (scale <= 0.0) {
            error = "the box has no room in it"
            return group
        }
        ; The plot's own origin sits inside the view, with the axis chrome
        ; around it at negative coordinates; every command is relative to that
        ; origin. See VlRuntime.plotOriginX.
        def originX:double (rt.plotOriginX())
        def originY:double (rt.plotOriginY())
        def ox:double ((x + (((w - (viewW * scale)) * 0.5))) + (originX * scale))
        def oy:double ((y + (((h - (viewH * scale)) * 0.5))) + (originY * scale))

        def n:int (array_length list.commands)
        def i:int 0
        while (i < n) {
            def cmd:VlDrawCommand (itemAt list.commands i)
            this.emit(group cmd ox oy scale)
            i = (i + 1)
        }
        ok = true
        return group
    }

    ; --- one command ------------------------------------------------------

    fn emit:void (group:PptxShape cmd:VlDrawCommand ox:double oy:double scale:double) {
        if (cmd.opacity <= 0.0) {
            return
        }
        if (cmd.op == "text") {
            this.emitText(group cmd ox oy scale)
            return
        }
        ; Groups are layout, not ink: the coordinates are already absolute by
        ; the time they reach here, so a group marker has nothing to say.
        if (cmd.op == "group-begin") {
            return
        }
        if (cmd.op == "group-end") {
            return
        }
        ; An image mark is the one thing here that IS a picture, and the point
        ; of this file is that a chart is not. Dropped rather than smuggled in.
        if (cmd.op == "image") {
            return
        }
        def wantFill:boolean false
        if cmd.hasFill {
            wantFill = (PptxVegaShapes.paints(cmd.fill))
        }
        def wantStroke:boolean false
        if cmd.hasStroke {
            if (cmd.strokeWidth > 0.0) {
                wantStroke = (PptxVegaShapes.paints(cmd.stroke))
            }
        }
        if (wantFill == false) {
            if (wantStroke == false) {
                return
            }
        }
        if (cmd.op == "rect") {
            this.emitRect(group cmd ox oy scale wantFill wantStroke)
            return
        }
        if (cmd.op == "line") {
            this.emitLine(group cmd ox oy scale)
            return
        }
        if (cmd.op == "symbol") {
            if (cmd.shape == "circle") {
                this.emitCircle(group cmd ox oy scale wantFill wantStroke)
                return
            }
        }
        this.emitOutline(group cmd ox oy scale wantFill wantStroke)
    }

    ; A bar. The commonest command in the list by a distance, and the one it is
    ; most worth spelling as a preset: `<a:prstGeom prst="rect"/>` is eleven
    ; bytes larger than nothing and it is a rectangle an author can drag.
    fn emitRect:void (group:PptxShape cmd:VlDrawCommand ox:double oy:double scale:double wantFill:boolean wantStroke:boolean) {
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.hasXfrm = true
        sh.x = (ox + (cmd.x * scale))
        sh.y = (oy + (cmd.y * scale))
        sh.width = (cmd.width * scale)
        sh.height = (cmd.height * scale)
        sh.preset = "rect"
        ; A stack rounds only the end that is exposed, so the four corners can
        ; differ. DrawingML's roundRect has ONE adjust value; the largest is
        ; the one a reader would notice going missing.
        def r:double (PptxVegaShapes.largest4(cmd.cornerTL cmd.cornerTR cmd.cornerBR cmd.cornerBL))
        if (r > 0.0) {
            sh.preset = "roundRect"
            def shortest:double sh.width
            if (sh.height < shortest) {
                shortest = sh.height
            }
            if (shortest > 0.0) {
                def adj:double ((r * scale) / shortest)
                if (adj > 0.5) {
                    adj = 0.5
                }
                sh.adj = adj
            }
        }
        sh.name = ("Bar " + (to_string ((array_length group.children) + 1)))
        this.paint(sh cmd wantFill wantStroke scale)
        this.attach(group sh)
    }

    ; A gridline, a tick, an axis rule. `prstGeom "line"` runs from the top
    ; left of the box to the bottom right, so the direction of the segment is
    ; carried by the flips rather than by the geometry — which is how
    ; PowerPoint itself writes a straight connector, and why a zero-height box
    ; is legal here and would not be for a custGeom.
    fn emitLine:void (group:PptxShape cmd:VlDrawCommand ox:double oy:double scale:double) {
        def x1:double (ox + (cmd.x * scale))
        def y1:double (oy + (cmd.y * scale))
        def x2:double (ox + (cmd.x2 * scale))
        def y2:double (oy + (cmd.y2 * scale))
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.hasXfrm = true
        sh.preset = "line"
        sh.x = x1
        sh.y = y1
        sh.width = (x2 - x1)
        sh.height = (y2 - y1)
        if (sh.width < 0.0) {
            sh.x = x2
            sh.width = (0.0 - sh.width)
            sh.flipH = true
        }
        if (sh.height < 0.0) {
            sh.y = y2
            sh.height = (0.0 - sh.height)
            sh.flipV = true
        }
        sh.name = ("Line " + (to_string ((array_length group.children) + 1)))
        sh.noFill = true
        def col:EVGColor (EVGColor.parse(cmd.stroke))
        sh.line = (PptxVegaShapes.colorOf(col (cmd.strokeOpacity * cmd.opacity)))
        sh.lineWidthPt = (cmd.strokeWidth * scale)
        if (sh.lineWidthPt < 0.25) {
            sh.lineWidthPt = 0.25
        }
        this.attach(group sh)
    }

    ; A scatter point. `size` is an AREA — VlShape's convention, taken from the
    ; reference — so the circle's diameter is its square root.
    fn emitCircle:void (group:PptxShape cmd:VlDrawCommand ox:double oy:double scale:double wantFill:boolean wantStroke:boolean) {
        def side:double (sqrt cmd.size)
        def d:double (side * scale)
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.hasXfrm = true
        sh.preset = "ellipse"
        sh.x = ((ox + (cmd.x * scale)) - (d * 0.5))
        sh.y = ((oy + (cmd.y * scale)) - (d * 0.5))
        sh.width = d
        sh.height = d
        sh.name = ("Point " + (to_string ((array_length group.children) + 1)))
        this.paint(sh cmd wantFill wantStroke scale)
        this.attach(group sh)
    }

    ; Everything with a curve or a corner in it: an area, a pie wedge, a line
    ; mark, a diamond, a hand-written `path`. The outline comes from VlShape —
    ; the same file the SVG backend asks — and is flattened to rings, one shape
    ; per ring.
    fn emitOutline:void (group:PptxShape cmd:VlDrawCommand ox:double oy:double scale:double wantFill:boolean wantStroke:boolean) {
        def builder (new PathBuilder)
        PptxVegaShapes.appendGeometry(builder cmd)
        def empty:boolean (builder.isEmpty())
        if empty {
            return
        }
        def outline:[PathCommand] (builder.getCommands())
        def parser:SVGPathParser (SVGPathParser.fromCommands(outline))
        def rings:[PathRing] (parser.flattenRings(steps scale 0.0 0.0 scale ox oy))
        def rn:int (array_length rings)
        def i:int 0
        while (i < rn) {
            def ring:PathRing (itemAt rings i)
            this.emitRing(group cmd ring wantFill wantStroke scale)
            i = (i + 1)
        }
    }

    ; One ring becomes one `custGeom`. The path is stated in the shape's own
    ; unit square, which is what `PptxShape.pathUnit` holds and what the writer
    ; multiplies back up by 100000 — so the box has to be the ring's bounding
    ; box, and a flat ring (a horizontal line mark with one datum) has to be
    ; given a box with room in it or every point divides by zero.
    fn emitRing:void (group:PptxShape cmd:VlDrawCommand ring:PathRing wantFill:boolean wantStroke:boolean scale:double) {
        def n:int (array_length ring.pts)
        if (n < 4) {
            return
        }
        def minX:double (itemAt ring.pts 0)
        def minY:double (itemAt ring.pts 1)
        def maxX:double minX
        def maxY:double minY
        def k:int 2
        while (k < n) {
            def px:double (itemAt ring.pts k)
            def py:double (itemAt ring.pts (k + 1))
            if (px < minX) { minX = px }
            if (px > maxX) { maxX = px }
            if (py < minY) { minY = py }
            if (py > maxY) { maxY = py }
            k = (k + 2)
        }
        def bw:double (maxX - minX)
        def bh:double (maxY - minY)
        ; A degenerate box is a real shape — a single-point line series, a zero
        ; height area — and it still has to be drawn. Widening the box moves
        ; nothing, because the points are then all at the same fraction of it.
        if (bw < 0.01) {
            bw = 0.01
        }
        if (bh < 0.01) {
            bh = 0.01
        }
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.hasXfrm = true
        sh.x = minX
        sh.y = minY
        sh.width = bw
        sh.height = bh
        sh.hasPath = true
        ; A stroke-only command is a POLYLINE, not an outline: closing it draws
        ; a segment back to the start that the specification never asked for,
        ; and filling it paints a blob over the plot. That is what `pathClosed`
        ; is for, and it is why the writer had to learn to honour it.
        sh.pathClosed = wantFill
        def unit:[double]
        def j:int 0
        while (j < n) {
            def qx:double (itemAt ring.pts j)
            def qy:double (itemAt ring.pts (j + 1))
            push unit ((qx - minX) / bw)
            push unit ((qy - minY) / bh)
            j = (j + 2)
        }
        sh.pathUnit = unit
        sh.name = ("Mark " + (to_string ((array_length group.children) + 1)))
        this.paint(sh cmd wantFill wantStroke scale)
        this.attach(group sh)
    }

    ; --- text --------------------------------------------------------------

    ; A label, an axis title, a legend entry.
    ;
    ; A command carries an anchor POINT and an alignment; a slide carries a
    ; BOX. So the box is built around the anchor wide enough that the text
    ; cannot reach either end, wrapping is turned off, and the alignment inside
    ; the box does the placing — which puts the glyphs where the anchor says
    ; without this file owning a font metric.
    ;
    ; Vega rotates a label about its ANCHOR and DrawingML rotates a shape about
    ; its CENTRE, so for a rotated label the box's centre is itself rotated
    ; about the anchor first. Without that, every y-axis title on every chart
    ; sat a box-width away from where it belonged — and the wider the label,
    ; the further out, which reads as a layout bug rather than a rotation one.
    fn emitText:void (group:PptxShape cmd:VlDrawCommand ox:double oy:double scale:double) {
        def body:string cmd.text
        if ((strlen body) == 0) {
            return
        }
        def size:double (cmd.fontSize * scale)
        if (size < minFontPt) {
            return
        }
        def ax:double ((ox + ((cmd.x + cmd.dx) * scale)))
        def ay:double ((oy + ((cmd.y + cmd.dy) * scale)))
        ; Room for a label of any length this can be handed. A box too wide
        ; costs nothing — the text is centred, left- or right-aligned in it and
        ; the box itself has no fill and no line — while a box too narrow wraps
        ; a label onto two lines and moves it.
        def chars:int ((strlen body) + 4)
        def boxW:double (size * (to_double chars))
        def boxH:double (size * 1.6)
        ; Where the box's centre sits relative to the anchor, before rotation.
        def cx:double 0.0
        if (cmd.align == "left") {
            cx = (boxW * 0.5)
        }
        if (cmd.align == "right") {
            cx = (0.0 - (boxW * 0.5))
        }
        def cy:double 0.0
        if (cmd.baseline == "top") {
            cy = (boxH * 0.5)
        }
        if (cmd.baseline == "bottom") {
            cy = (0.0 - (boxH * 0.5))
        }
        ; `alphabetic` puts the ANCHOR on the baseline, which is roughly a
        ; third of the size below the visual centre of a line of Latin text.
        if (cmd.baseline == "alphabetic") {
            cy = (0.0 - (size * 0.34))
        }
        def rot:double cmd.angle
        def rx:double cx
        def ry:double cy
        if ((rot > 0.001) || (rot < (0.0 - 0.001))) {
            def rad:double ((rot * 3.141592653589793) / 180.0)
            def cs:double (cos rad)
            def sn:double (sin rad)
            rx = ((cx * cs) - (cy * sn))
            ry = ((cx * sn) + (cy * cs))
        }
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.hasXfrm = true
        sh.preset = "rect"
        sh.x = ((ax + rx) - (boxW * 0.5))
        sh.y = ((ay + ry) - (boxH * 0.5))
        sh.width = boxW
        sh.height = boxH
        sh.rotation = rot
        sh.noFill = true
        sh.noLine = true
        sh.name = ("Label " + (to_string ((array_length group.children) + 1)))

        def tb (new PptxTextBody())
        tb.wrap = false
        tb.anchor = "ctr"
        tb.anchorSet = true
        tb.insetL = 0.0
        tb.insetR = 0.0
        tb.insetT = 0.0
        tb.insetB = 0.0
        tb.insetsSet = true
        def para (new PptxParagraph())
        para.align = "ctr"
        if (cmd.align == "left") {
            para.align = "l"
        }
        if (cmd.align == "right") {
            para.align = "r"
        }
        para.alignSet = true
        def run (new PptxTextRun())
        run.text = body
        run.fontFamily = sansFamily
        run.fontSizePt = size
        run.sizeSet = true
        run.boldSet = true
        run.bold = (PptxVegaShapes.isBold(cmd.fontWeight))
        def col:EVGColor (EVGColor.rgb(0 0 0))
        if cmd.hasFill {
            def paints:boolean (PptxVegaShapes.paints(cmd.fill))
            if paints {
                col = (EVGColor.parse(cmd.fill))
            }
        }
        run.color = (PptxVegaShapes.colorOf(col (cmd.fillOpacity * cmd.opacity)))
        push para.runs run
        push tb.paragraphs para
        sh.hasText = true
        sh.text = tb
        textCount = (textCount + 1)
        this.attach(group sh)
    }

    ; --- shared -------------------------------------------------------------

    fn attach:void (group:PptxShape sh:PptxShape) {
        push group.children sh
        shapeCount = (shapeCount + 1)
    }

    fn paint:void (sh:PptxShape cmd:VlDrawCommand wantFill:boolean wantStroke:boolean scale:double) {
        if wantFill {
            def col:EVGColor (EVGColor.parse(cmd.fill))
            sh.fill = (PptxVegaShapes.colorOf(col (cmd.fillOpacity * cmd.opacity)))
        } {
            sh.noFill = true
        }
        if wantStroke {
            def scol:EVGColor (EVGColor.parse(cmd.stroke))
            sh.line = (PptxVegaShapes.colorOf(scol (cmd.strokeOpacity * cmd.opacity)))
            sh.lineWidthPt = (cmd.strokeWidth * scale)
            if (sh.lineWidthPt < 0.25) {
                sh.lineWidthPt = 0.25
            }
        } {
            sh.noLine = true
        }
    }

    ; The outline, in the command's own coordinates. Lifted from VlEvgList
    ; deliberately: one of these two drawing a wedge differently would be a bug
    ; nothing catches, so they call the same VlShape.
    sfn appendGeometry:void (builder:PathBuilder cmd:VlDrawCommand) {
        if (cmd.op == "rect") {
            VlShape.appendRect(builder cmd.x cmd.y cmd.width cmd.height cmd.cornerTL cmd.cornerTR cmd.cornerBR cmd.cornerBL)
            return
        }
        if (cmd.op == "line") {
            builder.addLine(cmd.x cmd.y cmd.x2 cmd.y2)
            return
        }
        if (cmd.op == "symbol") {
            VlShape.appendSymbol(builder cmd.shape cmd.size cmd.x cmd.y)
            return
        }
        if ((cmd.op == "polyline") || (cmd.op == "polygon")) {
            VlShape.appendBrokenCurve(builder cmd.points cmd.breaks cmd.interpolate cmd.tension (cmd.op == "polygon"))
            return
        }
        if (cmd.op == "trail") {
            VlShape.appendBrokenTrail(builder cmd.points cmd.widths cmd.breaks)
            return
        }
        if (cmd.op == "arc") {
            VlShape.appendArc(builder cmd.x cmd.y cmd.startAngle cmd.endAngle cmd.innerRadius cmd.outerRadius)
            return
        }
        if (cmd.op == "path") {
            builder.addPathData(cmd.pathData)
        }
    }

    ; "none" is how a specification says "do not paint this", and it is not a
    ; colour: parsing it would give black, which is the most visible possible
    ; way to be wrong.
    sfn paints:boolean (colour:string) {
        if ((strlen colour) == 0) {
            return false
        }
        if (colour == "none") {
            return false
        }
        if (colour == "transparent") {
            return false
        }
        return true
    }

    sfn isBold:boolean (weight:string) {
        if (weight == "bold") {
            return true
        }
        if (weight == "bolder") {
            return true
        }
        if (weight == "600") {
            return true
        }
        if (weight == "700") {
            return true
        }
        if (weight == "800") {
            return true
        }
        if (weight == "900") {
            return true
        }
        return false
    }

    sfn largest4:double (a:double b:double c:double d:double) {
        def m:double a
        if (b > m) { m = b }
        if (c > m) { m = c }
        if (d > m) { m = d }
        return m
    }

    ; An EVG colour as a slide states one: six hexadecimal digits and an alpha.
    sfn colorOf:PptxColor (col:EVGColor alpha:double) {
        def r:int (col.red())
        def g:int (col.green())
        def b:int (col.blue())
        def hex:string ((PptxVegaShapes.hex2(r)) + (PptxVegaShapes.hex2(g)) + (PptxVegaShapes.hex2(b)))
        def out:PptxColor (PptxColor.srgbOf(hex))
        def a:double (col.alpha())
        out.alpha = (a * alpha)
        if (out.alpha > 1.0) {
            out.alpha = 1.0
        }
        if (out.alpha < 0.0) {
            out.alpha = 0.0
        }
        return out
    }

    sfn hex2:string (v:int) {
        def n:int v
        if (n < 0) { n = 0 }
        if (n > 255) { n = 255 }
        def hi:int (idiv n 16)
        def lo:int (n - (hi * 16))
        return ((PptxVegaShapes.hexDigit(hi)) + (PptxVegaShapes.hexDigit(lo)))
    }

    sfn hexDigit:string (v:int) {
        if (v < 10) {
            return (strfromcode (48 + v))
        }
        return (strfromcode (65 + (v - 10)))
    }
}

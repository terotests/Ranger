; ==============================================================================
; PptxToEvg - ResolvedSlide → EVGElement tree (+ display-list painter helpers)
; ==============================================================================
;
; PowerPoint slides are absolute scenes — no flex/grid needed. Each shape
; becomes a positioned View (div) with background / border / text / image.
; Groups nest as EVG groups with the same transform box.
;
; EMU → pt already happened in the model; here we map pt → CSS px at 96dpi
; (1pt = 96/72 px) so SoftCanvas / WebGL paint at screen pixels.
; ==============================================================================

Import "PptxModel.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../evg/EVGDisplayList.rgr"

class PptxToEvg {
    def scale:double 1.0        ; extra zoom on top of pt→px

    Constructor () {
    }

    fn setScale:void (s:double) {
        scale = s
    }

    ; 1 typographic point → CSS px
    fn ptToPx:double (pt:double) {
        return ((pt * (96.0 / 72.0)) * scale)
    }

    fn colorFrom:EVGColor (c:PptxColor) {
        if (c.isSet == false) {
            return (EVGColor.rgba(0 0 0 0.0))
        }
        def hex:string ("#" + c.srgb)
        def col:EVGColor (EVGColor.parse(hex))
        if (c.alpha < 0.999) {
            return (EVGColor.create((to_double (col.red())) (to_double (col.green())) (to_double (col.blue())) c.alpha))
        }
        return col
    }

    fn hexCss:string (c:PptxColor) {
        if (c.isSet == false) {
            return "transparent"
        }
        return ("#" + c.srgb)
    }

    fn alignCss:string (algn:string) {
        if (algn == "ctr") {
            return "center"
        }
        if (algn == "r") {
            return "right"
        }
        if (algn == "just") {
            return "justify"
        }
        return "left"
    }

    fn applyBox:void (el:EVGElement shape:PptxShape) {
        el.left = (EVGUnit.px((this.ptToPx(shape.x))))
        el.top = (EVGUnit.px((this.ptToPx(shape.y))))
        el.width = (EVGUnit.px((this.ptToPx(shape.width))))
        el.height = (EVGUnit.px((this.ptToPx(shape.height))))
        el.position = "absolute"
        if (shape.rotation != 0.0) {
            el.rotate = shape.rotation
        }
        if (shape.fill.isSet) {
            el.backgroundColor = (this.colorFrom(shape.fill))
        }
        if ((shape.line.isSet) && (shape.lineWidthPt > 0.0)) {
            el.borderWidth = (EVGUnit.px((this.ptToPx(shape.lineWidthPt))))
            el.borderColor = (this.colorFrom(shape.line))
        }
        if (shape.preset == "ellipse") {
            ; Approximate ellipse with a large border-radius
            def rx:double (this.ptToPx((shape.width * 0.5)))
            el.setAttribute("border-radius" ((to_string (to_int rx)) + "px"))
        }
        if (shape.preset == "roundRect") {
            el.setAttribute("border-radius" "12px")
        }
    }

    fn textElement:EVGElement (shape:PptxShape) {
        def box (EVGElement.createDiv())
        this.applyBox(box shape)
        def body:PptxTextBody shape.text
        def padL:double (this.ptToPx(body.insetL))
        def padT:double (this.ptToPx(body.insetT))
        box.paddingLeft = (EVGUnit.px(padL))
        box.paddingTop = (EVGUnit.px(padT))
        box.paddingRight = (EVGUnit.px((this.ptToPx(body.insetR))))
        box.paddingBottom = (EVGUnit.px((this.ptToPx(body.insetB))))
        ; Flatten paragraphs into textContent for MVP EVG text (structured runs
        ; are preserved on the model for a future text-engine pass).
        def plain:string (body.plainText())
        box.textContent = plain
        if ((array_length body.paragraphs) > 0) {
            def para:PptxParagraph (itemAt body.paragraphs 0)
            box.textAlign = (this.alignCss(para.align))
            if ((array_length para.runs) > 0) {
                def run:PptxTextRun (itemAt para.runs 0)
                box.fontSize = (EVGUnit.px((this.ptToPx(run.fontSizePt))))
                if ((strlen run.fontFamily) > 0) {
                    box.fontFamily = run.fontFamily
                }
                if run.bold {
                    box.fontWeight = "bold"
                }
                if (run.color.isSet) {
                    box.color = (this.colorFrom(run.color))
                }
            }
        }
        return box
    }

    fn shapeElement:EVGElement (shape:PptxShape) {
        if (shape.kind == 1) {
            def img (EVGElement.createImg())
            this.applyBox(img shape)
            if ((strlen shape.imagePart) > 0) {
                img.src = shape.imagePart
            }
            return img
        }
        if (shape.kind == 2) {
            def grp (EVGElement.createDiv())
            this.applyBox(grp shape)
            def i:int 0
            while (i < (array_length shape.children)) {
                def child:PptxShape (itemAt shape.children i)
                ; Child coords are in the group's child space; map into group box
                def mapped (new PptxShape())
                ; Shallow-copy relevant fields then offset
                mapped.kind = child.kind
                mapped.name = child.name
                mapped.preset = child.preset
                mapped.fill = child.fill
                mapped.line = child.line
                mapped.lineWidthPt = child.lineWidthPt
                mapped.hasText = child.hasText
                mapped.text = child.text
                mapped.imageRid = child.imageRid
                mapped.imagePart = child.imagePart
                mapped.imageBytes = child.imageBytes
                mapped.rotation = child.rotation
                mapped.children = child.children
                def ox:double 0.0
                def oy:double 0.0
                def sx:double 1.0
                def sy:double 1.0
                if ((shape.chW > 0.0) && (shape.width > 0.0)) {
                    sx = (shape.width / shape.chW)
                }
                if ((shape.chH > 0.0) && (shape.height > 0.0)) {
                    sy = (shape.height / shape.chH)
                }
                mapped.x = (shape.x + ((child.x - shape.chX) * sx))
                mapped.y = (shape.y + ((child.y - shape.chY) * sy))
                mapped.width = (child.width * sx)
                mapped.height = (child.height * sy)
                ; Nested absolute coords are page-relative after mapping — but
                ; as EVG children of the group we want group-local coords.
                mapped.x = (mapped.x - shape.x)
                mapped.y = (mapped.y - shape.y)
                grp.addChild((this.shapeElement(mapped)))
                i = (i + 1)
            }
            return grp
        }
        ; kind 0 / 3 — geometric shape, optionally with text
        if shape.hasText {
            return (this.textElement(shape))
        }
        def el (EVGElement.createDiv())
        this.applyBox(el shape)
        return el
    }

    fn slideToEvg:EVGElement (slide:PptxSlide) {
        def page (EVGElement.createDiv())
        page.width = (EVGUnit.px((this.ptToPx(slide.width))))
        page.height = (EVGUnit.px((this.ptToPx(slide.height))))
        if (slide.bg.isSet) {
            page.backgroundColor = (this.colorFrom(slide.bg))
        } {
            page.backgroundColor = (EVGColor.parse("#FFFFFF"))
        }
        page.position = "relative"
        def i:int 0
        while (i < (array_length slide.shapes)) {
            page.addChild((this.shapeElement((itemAt slide.shapes i))))
            i = (i + 1)
        }
        return page
    }

    ; --------------------------------------------------------------------------
    ; Direct display-list emission for the SoftCanvas / WebGL viewer path.
    ; Bypasses EVGLayout so absolute PowerPoint coords paint 1:1.
    ; --------------------------------------------------------------------------

    fn pushRect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor) {
        def c (new EVGDrawCmd())
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn pushBorder:void (dl:EVGDisplayList x:double y:double w:double h:double thickness:double col:EVGColor) {
        def c (new EVGDrawCmd())
        c.kind = 1
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.thickness = thickness
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn pushText:void (dl:EVGDisplayList text:string x:double y:double size:double col:EVGColor fontFamily:string rotate:double) {
        if ((strlen text) == 0) {
            return
        }
        def c (new EVGDrawCmd())
        c.kind = 3
        c.x = x
        c.y = y
        c.w = 0.0
        c.h = size
        c.text = text
        c.fontFamily = fontFamily
        c.fontSize = size
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        c.rotate = rotate
        push dl.cmds c
    }

    fn pushImage:void (dl:EVGDisplayList src:string x:double y:double w:double h:double) {
        def c (new EVGDrawCmd())
        c.kind = 2
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.src = src
        c.a = 1.0
        push dl.cmds c
    }

    fn emitShape:void (dl:EVGDisplayList shape:PptxShape ox:double oy:double) {
        def x:double (this.ptToPx((shape.x + ox)))
        def y:double (this.ptToPx((shape.y + oy)))
        def w:double (this.ptToPx(shape.width))
        def h:double (this.ptToPx(shape.height))
        if (shape.kind == 2) {
            def i:int 0
            while (i < (array_length shape.children)) {
                def child:PptxShape (itemAt shape.children i)
                def sx:double 1.0
                def sy:double 1.0
                if ((shape.chW > 0.0) && (shape.width > 0.0)) {
                    sx = (shape.width / shape.chW)
                }
                if ((shape.chH > 0.0) && (shape.height > 0.0)) {
                    sy = (shape.height / shape.chH)
                }
                def mapped (new PptxShape())
                mapped.kind = child.kind
                mapped.name = child.name
                mapped.preset = child.preset
                mapped.fill = child.fill
                mapped.line = child.line
                mapped.lineWidthPt = child.lineWidthPt
                mapped.hasText = child.hasText
                mapped.text = child.text
                mapped.imagePart = child.imagePart
                mapped.rotation = (child.rotation + shape.rotation)
                mapped.children = child.children
                mapped.chX = child.chX
                mapped.chY = child.chY
                mapped.chW = child.chW
                mapped.chH = child.chH
                mapped.x = ((child.x - shape.chX) * sx)
                mapped.y = ((child.y - shape.chY) * sy)
                mapped.width = (child.width * sx)
                mapped.height = (child.height * sy)
                this.emitShape(dl mapped (ox + shape.x) (oy + shape.y))
                i = (i + 1)
            }
            return
        }
        if (shape.kind == 1) {
            if ((strlen shape.imagePart) > 0) {
                this.pushImage(dl shape.imagePart x y w h)
            } {
                ; Placeholder when media missing
                this.pushRect(dl x y w h (EVGColor.rgb(200 210 230)))
            }
            return
        }
        if (shape.fill.isSet) {
            this.pushRect(dl x y w h (this.colorFrom(shape.fill)))
        }
        if ((shape.line.isSet) && (shape.lineWidthPt > 0.0)) {
            this.pushBorder(dl x y w h (this.ptToPx(shape.lineWidthPt)) (this.colorFrom(shape.line)))
        }
        if shape.hasText {
            def body:PptxTextBody shape.text
            def tx:double (x + (this.ptToPx(body.insetL)))
            def ty:double (y + (this.ptToPx(body.insetT)))
            def pi:int 0
            while (pi < (array_length body.paragraphs)) {
                def para:PptxParagraph (itemAt body.paragraphs pi)
                def line:string ""
                def fontSize:double 18.0
                def fontFamily:string "Calibri"
                def col:EVGColor (EVGColor.rgb(0 0 0))
                def ri:int 0
                while (ri < (array_length para.runs)) {
                    def run:PptxTextRun (itemAt para.runs ri)
                    line = (line + run.text)
                    fontSize = (this.ptToPx(run.fontSizePt))
                    if ((strlen run.fontFamily) > 0) {
                        fontFamily = run.fontFamily
                    }
                    if (run.color.isSet) {
                        col = (this.colorFrom(run.color))
                    }
                    ri = (ri + 1)
                }
                ; Approximate centered / right alignment inside the box
                def drawX:double tx
                if (para.align == "ctr") {
                    ; SoftCanvas path does not measure here — nudge toward center
                    drawX = (x + (w * 0.15))
                }
                if (para.align == "r") {
                    drawX = (x + (w * 0.4))
                }
                this.pushText(dl line drawX ty fontSize col fontFamily shape.rotation)
                ty = (ty + (fontSize * 1.25))
                pi = (pi + 1)
            }
        }
    }

    fn slideToDisplayList:EVGDisplayList (slide:PptxSlide) {
        def dl (new EVGDisplayList())
        def pw:double (this.ptToPx(slide.width))
        def ph:double (this.ptToPx(slide.height))
        def bg:EVGColor (EVGColor.parse("#FFFFFF"))
        if (slide.bg.isSet) {
            bg = (this.colorFrom(slide.bg))
        }
        this.pushRect(dl 0.0 0.0 pw ph bg)
        def i:int 0
        while (i < (array_length slide.shapes)) {
            this.emitShape(dl (itemAt slide.shapes i) 0.0 0.0)
            i = (i + 1)
        }
        return dl
    }
}

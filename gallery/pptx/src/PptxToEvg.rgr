; ==============================================================================
; PptxToEvg - ResolvedSlide → EVGElement tree (+ display-list painter helpers)
; ==============================================================================
;
; PowerPoint slides are absolute scenes — no flex/grid needed. Each shape
; becomes a positioned View (div) with background / border / text / image.
; Groups nest as EVG groups with the same transform box.
;
; EMU → pt already happened in the model; here we map pt → CSS px at 96dpi
; (1pt = 96/72 px) so SoftCanvas / WebGL paint at screen pixels.
; ==============================================================================

Import "PptxModel.rgr"
Import "PptxGeom.rgr"
Import "PptxTextLayout.rgr"
Import "PptxChartVela.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../evg/EVGDisplayList.rgr"

class PptxToEvg {
    def scale:double 1.0        ; extra zoom on top of pt→px
    ; Who says how wide a string is. A host attaches its text renderer to this
    ; and the painter, the caret and the click all measure through the one
    ; object — the whole point of the layout below.
    def measure:PptxTextMeasure (new PptxTextMeasure())
    ; Which slide is being drawn, for the `slidenum` fields on it. A deck
    ; carries the number each field had when it was saved; the number it has
    ; now is the one to draw.
    def slideNumber:int 0

    Constructor () {
    }

    fn setScale:void (s:double) {
        scale = s
    }

    ; 1 typographic point → CSS px
    fn ptToPx:double (pt:double) {
        return ((pt * (96.0 / 72.0)) * scale)
    }

    fn colorFrom:EVGColor (c:PptxColor) {
        if (c.isSet == false) {
            return (EVGColor.rgba(0 0 0 0.0))
        }
        def hex:string ("#" + c.srgb)
        def col:EVGColor (EVGColor.parse(hex))
        if (c.alpha < 0.999) {
            return (EVGColor.create((to_double (col.red())) (to_double (col.green())) (to_double (col.blue())) c.alpha))
        }
        return col
    }

    fn hexCss:string (c:PptxColor) {
        if (c.isSet == false) {
            return "transparent"
        }
        return ("#" + c.srgb)
    }

    fn alignCss:string (algn:string) {
        if (algn == "ctr") {
            return "center"
        }
        if (algn == "r") {
            return "right"
        }
        if (algn == "just") {
            return "justify"
        }
        return "left"
    }

    fn alignToken:string (algn:string) {
        if (algn == "ctr") {
            return "center"
        }
        if (algn == "r") {
            return "right"
        }
        return "left"
    }

    fn applyBox:void (el:EVGElement shape:PptxShape) {
        el.left = (EVGUnit.px((this.ptToPx(shape.x))))
        el.top = (EVGUnit.px((this.ptToPx(shape.y))))
        el.width = (EVGUnit.px((this.ptToPx(shape.width))))
        el.height = (EVGUnit.px((this.ptToPx(shape.height))))
        el.position = "absolute"
        if (shape.rotation != 0.0) {
            el.rotate = shape.rotation
        }
        if (shape.fill.isSet) {
            el.backgroundColor = (this.colorFrom(shape.fill))
        }
        if ((shape.line.isSet) && (shape.lineWidthPt > 0.0)) {
            el.borderWidth = (EVGUnit.px((this.ptToPx(shape.lineWidthPt))))
            el.borderColor = (this.colorFrom(shape.line))
        }
        if (shape.preset == "ellipse") {
            ; Approximate ellipse with a large border-radius
            def rx:double (this.ptToPx((shape.width * 0.5)))
            el.setAttribute("border-radius" ((to_string (to_int rx)) + "px"))
        }
        if (shape.preset == "roundRect") {
            el.setAttribute("border-radius" "12px")
        }
    }

    fn textElement:EVGElement (shape:PptxShape) {
        def box (EVGElement.createDiv())
        this.applyBox(box shape)
        def body:PptxTextBody shape.text
        def padL:double (this.ptToPx(body.insetL))
        def padT:double (this.ptToPx(body.insetT))
        box.paddingLeft = (EVGUnit.px(padL))
        box.paddingTop = (EVGUnit.px(padT))
        box.paddingRight = (EVGUnit.px((this.ptToPx(body.insetR))))
        box.paddingBottom = (EVGUnit.px((this.ptToPx(body.insetB))))
        def plain:string (body.plainText())
        box.textContent = plain
        if ((array_length body.paragraphs) > 0) {
            def para:PptxParagraph (itemAt body.paragraphs 0)
            box.textAlign = (this.alignCss(para.align))
            if ((array_length para.runs) > 0) {
                def run:PptxTextRun (itemAt para.runs 0)
                box.fontSize = (EVGUnit.px((this.ptToPx(run.fontSizePt))))
                if ((strlen run.fontFamily) > 0) {
                    box.fontFamily = run.fontFamily
                }
                if run.bold {
                    box.fontWeight = "bold"
                }
                if (run.color.isSet) {
                    box.color = (this.colorFrom(run.color))
                }
            }
        }
        return box
    }

    fn mapGroupChild:PptxShape (shape:PptxShape child:PptxShape) {
        def mapped (new PptxShape())
        mapped.kind = child.kind
        mapped.name = child.name
        mapped.preset = child.preset
        mapped.fill = child.fill
        mapped.line = child.line
        mapped.lineWidthPt = child.lineWidthPt
        mapped.hasText = child.hasText
        mapped.text = child.text
        mapped.imageRid = child.imageRid
        mapped.imagePart = child.imagePart
        mapped.imageBytes = child.imageBytes
        mapped.imageOk = child.imageOk
        mapped.rotation = (child.rotation + shape.rotation)
        mapped.children = child.children
        mapped.chX = child.chX
        mapped.chY = child.chY
        mapped.chW = child.chW
        mapped.chH = child.chH
        mapped.isPlaceholder = child.isPlaceholder
        mapped.phType = child.phType
        mapped.phIdx = child.phIdx
        mapped.inherited = child.inherited
        mapped.adj = child.adj
        mapped.noFill = child.noFill
        mapped.noLine = child.noLine
        mapped.headEnd = child.headEnd
        mapped.tailEnd = child.tailEnd
        mapped.flipH = child.flipH
        mapped.flipV = child.flipV
        mapped.fillGrad = child.fillGrad
        mapped.shadow = child.shadow
        mapped.hasPath = child.hasPath
        mapped.pathUnit = child.pathUnit
        def sx:double 1.0
        def sy:double 1.0
        if ((shape.chW > 0.0) && (shape.width > 0.0)) {
            sx = (shape.width / shape.chW)
        }
        if ((shape.chH > 0.0) && (shape.height > 0.0)) {
            sy = (shape.height / shape.chH)
        }
        mapped.x = ((child.x - shape.chX) * sx)
        mapped.y = ((child.y - shape.chY) * sy)
        mapped.width = (child.width * sx)
        mapped.height = (child.height * sy)
        mapped.hasXfrm = true
        return mapped
    }

    fn shapeElement:EVGElement (shape:PptxShape) {
        if (shape.kind == (PptxShapeKind.picture())) {
            def img (EVGElement.createImg())
            this.applyBox(img shape)
            if ((strlen shape.imagePart) > 0) {
                img.src = shape.imagePart
            }
            return img
        }
        if (shape.kind == (PptxShapeKind.group())) {
            def grp (EVGElement.createDiv())
            this.applyBox(grp shape)
            def i:int 0
            while (i < (array_length shape.children)) {
                def child:PptxShape (itemAt shape.children i)
                def mapped:PptxShape (this.mapGroupChild(shape child))
                ; Nested absolute coords are page-relative after mapping — but
                ; as EVG children of the group we want group-local coords.
                mapped.x = mapped.x
                mapped.y = mapped.y
                grp.addChild((this.shapeElement(mapped)))
                i = (i + 1)
            }
            return grp
        }
        if shape.hasText {
            return (this.textElement(shape))
        }
        def el (EVGElement.createDiv())
        this.applyBox(el shape)
        return el
    }

    fn slideToEvg:EVGElement (slide:PptxSlide) {
        def page (EVGElement.createDiv())
        page.width = (EVGUnit.px((this.ptToPx(slide.width))))
        page.height = (EVGUnit.px((this.ptToPx(slide.height))))
        if (slide.bg.isSet) {
            page.backgroundColor = (this.colorFrom(slide.bg))
        } {
            page.backgroundColor = (EVGColor.parse("#FFFFFF"))
        }
        page.position = "relative"
        def i:int 0
        while (i < (array_length slide.shapes)) {
            page.addChild((this.shapeElement((itemAt slide.shapes i))))
            i = (i + 1)
        }
        return page
    }

    ; --------------------------------------------------------------------------
    ; Direct display-list emission for the SoftCanvas / WebGL viewer path.
    ; --------------------------------------------------------------------------

    fn pushRect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor) {
        def c (new EVGDrawCmd())
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn pushBorder:void (dl:EVGDisplayList x:double y:double w:double h:double thickness:double col:EVGColor) {
        def c (new EVGDrawCmd())
        c.kind = 1
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.thickness = thickness
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn pushTextCmd:void (dl:EVGDisplayList text:string x:double y:double size:double col:EVGColor fontFamily:string rotate:double align:string boxW:double bold:boolean maxW:double) {
        if ((strlen text) == 0) {
            return
        }
        def c (new EVGDrawCmd())
        c.kind = 3
        c.x = x
        c.y = y
        c.w = boxW
        c.h = size
        c.text = text
        c.fontFamily = fontFamily
        c.fontSize = size
        c.textAlign = align
        c.maxWidth = maxW
        if bold {
            c.fontWeight = "bold"
        }
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        c.rotate = rotate
        push dl.cmds c
    }

    fn pushImage:void (dl:EVGDisplayList src:string x:double y:double w:double h:double flipH:boolean flipV:boolean rotate:double) {
        def c (new EVGDrawCmd())
        c.kind = 2
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.src = src
        c.a = 1.0
        c.flipH = flipH
        c.flipV = flipV
        c.rotate = rotate
        push dl.cmds c
    }

    ; A point turned about another one. Both backends rotate an element about
    ; the element's OWN centre — the shader says so and so does the software
    ; canvas — which is right for a shape's box and wrong for everything drawn
    ; inside it: a line of text turned twenty degrees about its own middle is
    ; not the same as the same line turned with the shape it sits in.
    sfn rotateAbout:[double] (px:double py:double cx:double cy:double degrees:double) {
        def out:[double]
        def rad:double (degrees * 0.017453292519943295)
        def cs:double (cos rad)
        def sn:double (sin rad)
        def dx:double (px - cx)
        def dy:double (py - cy)
        push out (cx + ((dx * cs) - (dy * sn)))
        push out (cy + ((dx * sn) + (dy * cs)))
        return out
    }

    ; Every point of a path, turned about the shape's centre. A filled polygon
    ; carries no rotation of its own in the display list, so a preset shape
    ; that had been rotated drew straight in BOTH backends until now.
    sfn rotatePoints:[double] (pts:[double] cx:double cy:double degrees:double) {
        if ((degrees > (0.0 - 0.001)) && (degrees < 0.001)) {
            return pts
        }
        def out:[double]
        def rad:double (degrees * 0.017453292519943295)
        def cs:double (cos rad)
        def sn:double (sin rad)
        def i:int 0
        while (i < (array_length pts)) {
            def dx:double ((itemAt pts i) - cx)
            def dy:double ((itemAt pts (i + 1)) - cy)
            push out (cx + ((dx * cs) - (dy * sn)))
            push out (cy + ((dx * sn) + (dy * cs)))
            i = (i + 2)
        }
        return out
    }

    ; A mirrored shape is its path read from the other side of its own box.
    sfn mirrorUnit:[double] (unit:[double] flipH:boolean flipV:boolean) {
        if (flipH == false) {
            if (flipV == false) {
                return unit
            }
        }
        def out:[double]
        def i:int 0
        while (i < (array_length unit)) {
            def ux:double (itemAt unit i)
            def uy:double (itemAt unit (i + 1))
            if flipH {
                ux = (1.0 - ux)
            }
            if flipV {
                uy = (1.0 - uy)
            }
            push out ux
            push out uy
            i = (i + 2)
        }
        return out
    }

    ; The lines of a shape's text, in painter pixels. One layout, asked for by
    ; the painter below and by the host that draws the caret — which is what
    ; makes a caret land on the glyphs of a WRAPPED line and not just on the
    ; first line of the paragraph.
    fn lineBoxes:[PptxTextLine] (shape:PptxShape x:double y:double w:double h:double) {
        def s:double ((96.0 / 72.0) * scale)
        def fit:double (this.substituteFit(shape.text (w - (this.ptToPx((shape.text.insetL + shape.text.insetR)))) s))
        return (PptxTextLayout.layout(shape.text measure (s * fit) x y w h))
    }

    ; How much to shrink a body whose font we do not have.
    ;
    ; A deck names Calibri; we draw Open Sans, which is wider; a label the
    ; author sized to fit spills onto a second line. Nothing in the file is
    ; wrong and nothing in the layout is wrong — the font is simply not the
    ; one the box was measured against.
    ;
    ; The file does say how wide the text was meant to be, though: the author
    ; made the box fit it. So a paragraph that overflows its box by a LITTLE
    ; is taken as our metrics being off by that little, and the body is scaled
    ; to fit — which is what PowerPoint's own autofit does, for the same
    ; reason. A paragraph that overflows by a lot is a paragraph that really
    ; wraps, and `floor` is what keeps the two apart: nothing here can shrink
    ; text by more than a sixth, so a real body of prose is left alone.
    ;
    ; Only when the face was substituted. A deck whose fonts we have is
    ; measured correctly already, and second-guessing it would be a bug.
    fn substituteFit:double (body:PptxTextBody contentW:double s:double) {
        if (contentW <= 1.0) {
            return 1.0
        }
        def floor:double 0.84
        def fit:double 1.0
        def substituted:boolean false
        def pi:int 0
        while (pi < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs pi)
            def natural:double 0.0
            def ri:int 0
            while (ri < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs ri)
                if ((measure.hasFamily(run.fontFamily)) == false) {
                    substituted = true
                }
                natural = (natural + (measure.widthOf(run.text (run.fontSizePt * s) run.bold run.italic)))
                ri = (ri + 1)
            }
            ; The indent this paragraph's level pushes it in by counts against
            ; the width it has, or a bulleted line is judged against a box it
            ; never had.
            def avail:double (contentW - (this.ptToPx(para.marginLeftPt)))
            if (avail > 1.0) {
                if (natural > avail) {
                    def need:double (avail / natural)
                    if (need < fit) {
                        fit = need
                    }
                }
            }
            pi = (pi + 1)
        }
        if (substituted == false) {
            return 1.0
        }
        if (fit < floor) {
            return 1.0
        }
        if (fit >= 1.0) {
            return 1.0
        }
        ; A hair under, so a line that measures exactly its box does not sit
        ; on the boundary and wrap anyway.
        return (fit * 0.999)
    }

    fn emitTextBody:void (dl:EVGDisplayList shape:PptxShape x:double y:double w:double h:double) {
        def lines:[PptxTextLine] (this.lineBoxes(shape x y w h))
        def body:PptxTextBody shape.text
        ; The SAME scale the lines were laid out at. Shrinking the layout and
        ; drawing at full size would put the right number of lines on the
        ; slide with the wrong glyphs in them.
        def s:double (((96.0 / 72.0) * scale) * (this.substituteFit(body (w - (this.ptToPx((body.insetL + body.insetR)))) ((96.0 / 72.0) * scale))))
        ; The shape's centre, which is what its text turns about.
        def rotDeg:double shape.rotation
        def hasRot:boolean false
        if ((rotDeg > 0.001) || (rotDeg < -0.001)) {
            hasRot = true
        }
        def pivotX:double (x + (w * 0.5))
        def pivotY:double (y + (h * 0.5))
        def li:int 0
        while (li < (array_length lines)) {
            def line:PptxTextLine (itemAt lines li)
            def para:PptxParagraph (itemAt body.paragraphs line.para)
            if ((strlen line.bullet) > 0) {
                def bw:double (measure.widthOf(line.bullet line.bulletSize false false))
                def bx:double line.bulletX
                def by:double line.y
                if hasRot {
                    def bcx:double (bx + (bw * 0.5))
                    def bcy:double (by + (line.h * 0.5))
                    def bp:[double] (PptxToEvg.rotateAbout(bcx bcy pivotX pivotY rotDeg))
                    bx = ((itemAt bp 0) - (bw * 0.5))
                    by = ((itemAt bp 1) - (line.h * 0.5))
                }
                ; A bullet has its own colour, which is not the text's: a deck
                ; states it per level, and drawing it in one grey for every
                ; level throws away half of what a list style says.
                def bcol:EVGColor (EVGColor.rgb(40 40 50))
                if para.bulletColor.isSet {
                    bcol = (this.colorFrom(para.bulletColor))
                } {
                    if ((array_length para.runs) > 0) {
                        def firstRun:PptxTextRun (itemAt para.runs 0)
                        if firstRun.color.isSet {
                            bcol = (this.colorFrom(firstRun.color))
                        }
                    }
                }
                def bfont:string "Calibri"
                if ((strlen para.bulletFont) > 0) {
                    bfont = para.bulletFont
                }
                this.pushTextCmd(dl line.bullet bx by line.bulletSize bcol bfont shape.rotation "left" 0.0 false 0.0)
            }
            ; Each run's slice of this line, placed by measurement rather than
            ; by an average character width — which is why a paragraph of two
            ; sizes no longer draws its second half on top of its first.
            def penX:double line.x
            def at:int 0
            def ri:int 0
            while (ri < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs ri)
                def len:int (strlen run.text)
                def s0:int at
                def s1:int (at + len)
                def a:int line.startCol
                def b:int line.endCol
                if (a < s0) {
                    a = s0
                }
                if (b > s1) {
                    b = s1
                }
                if (b > a) {
                    def piece:string (substring run.text (a - s0) (b - s0))
                    if (run.field == "slidenum") {
                        if (slideNumber > 0) {
                            piece = (to_string slideNumber)
                        }
                    }
                    def fontSize:double (run.fontSizePt * s)
                    def pieceW:double (measure.widthOf(piece fontSize run.bold run.italic))
                    def drawX:double penX
                    def drawY:double line.y
                    if hasRot {
                        def pcx:double (penX + (pieceW * 0.5))
                        def pcy:double (line.y + (line.h * 0.5))
                        def rp:[double] (PptxToEvg.rotateAbout(pcx pcy pivotX pivotY rotDeg))
                        drawX = ((itemAt rp 0) - (pieceW * 0.5))
                        drawY = ((itemAt rp 1) - (line.h * 0.5))
                    }
                    def fontFamily:string "Calibri"
                    if ((strlen run.fontFamily) > 0) {
                        fontFamily = run.fontFamily
                    }
                    def col:EVGColor (EVGColor.rgb(0 0 0))
                    if (run.color.isSet) {
                        col = (this.colorFrom(run.color))
                    }
                    ; A highlight is drawn behind the run, over the line it
                    ; sits on — a marker pen, which is what a deck uses it as.
                    if (run.highlight.isSet) {
                        this.pushRect(dl drawX drawY pieceW line.h (this.colorFrom(run.highlight)))
                    }
                    def weight:string ""
                    if run.bold {
                        if run.italic {
                            weight = "bolditalic"
                        } {
                            weight = "bold"
                        }
                    } {
                        if run.italic {
                            weight = "italic"
                        }
                    }
                    def c (new EVGDrawCmd())
                    c.kind = 3
                    c.x = drawX
                    c.y = drawY
                    c.w = 0.0
                    c.h = fontSize
                    c.text = piece
                    c.fontFamily = fontFamily
                    c.fontSize = fontSize
                    c.textAlign = "left"
                    c.maxWidth = 0.0
                    c.fontWeight = weight
                    c.r = (col.red())
                    c.g = (col.green())
                    c.b = (col.blue())
                    c.a = (col.alpha())
                    c.rotate = shape.rotation
                    push dl.cmds c
                    penX = (penX + pieceW)
                }
                at = s1
                ri = (ri + 1)
            }
            li = (li + 1)
        }
    }

    ; `addPolygon` rather than a command built here: it is the one place that
    ; also closes the ring list and derives the box from the points. Built by
    ; hand, this shape reached the software canvas — which reads `pts` — and
    ; nothing else, because a path with no rings serialises to a path with no
    ; points.
    fn pushPathFill:void (dl:EVGDisplayList pts:[double] col:EVGColor) {
        dl.addPolygon(pts col)
    }

    fn pushGradRect:void (dl:EVGDisplayList x:double y:double w:double h:double grad:PptxGradient) {
        def c (new EVGDrawCmd())
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.hasGrad = true
        c.gradDir = grad.dir
        def c1:EVGColor (this.colorFrom(grad.c1))
        def c2:EVGColor (this.colorFrom(grad.c2))
        c.r = (c1.red())
        c.g = (c1.green())
        c.b = (c1.blue())
        c.a = (c1.alpha())
        c.r2 = (c2.red())
        c.g2 = (c2.green())
        c.b2 = (c2.blue())
        c.a2 = (c2.alpha())
        push dl.cmds c
    }

    fn applyShadowToCmd:void (c:EVGDrawCmd shape:PptxShape) {
        if (shape.shadow.isSet == false) {
            return
        }
        c.hasShadow = true
        c.shadowX = (this.ptToPx(shape.shadow.offsetXPt))
        c.shadowY = (this.ptToPx(shape.shadow.offsetYPt))
        c.shadowBlur = (this.ptToPx(shape.shadow.blurPt))
        def sc:EVGColor (this.colorFrom(shape.shadow.color))
        c.shadowR = (sc.red())
        c.shadowG = (sc.green())
        c.shadowB = (sc.blue())
        c.shadowA = shape.shadow.alpha
    }

    ; The grid the file states, scaled to the frame the table is actually in —
    ; the two disagree whenever a table has been resized, and the columns are
    ; the file's proportions rather than equal shares.
    fn tableTracks:[double] (stated:[double] count:int total:double) {
        def out:[double]
        def sum:double 0.0
        def i:int 0
        while (i < (array_length stated)) {
            sum = (sum + (itemAt stated i))
            i = (i + 1)
        }
        if (count < 1) {
            return out
        }
        if ((array_length stated) != count) {
            sum = 0.0
        }
        if (sum <= 0.0) {
            def even:double (total / (to_double count))
            def k:int 0
            while (k < count) {
                push out even
                k = (k + 1)
            }
            return out
        }
        def f:double (total / sum)
        def j:int 0
        while (j < count) {
            push out ((itemAt stated j) * f)
            j = (j + 1)
        }
        return out
    }

    ; How tall a cell's words are in the width it has. The layout that answers
    ; this is the same one that will draw them, so the two cannot disagree.
    fn cellHeight:double (cell:PptxTableCell width:double) {
        if ((strlen cell.text) == 0) {
            return 0.0
        }
        def inner (new PptxShape())
        inner.kind = (PptxShapeKind.shape())
        inner.hasText = true
        inner.text = cell.body
        def ml:double (this.ptToPx(cell.marLPt))
        def mr:double (this.ptToPx(cell.marRPt))
        def mt:double (this.ptToPx(cell.marTPt))
        def mb:double (this.ptToPx(cell.marBPt))
        def bw:double ((width - ml) - mr)
        if (bw <= 0.0) {
            return 0.0
        }
        def lines:[PptxTextLine] (this.lineBoxes(inner 0.0 0.0 bw 100000.0))
        if ((array_length lines) == 0) {
            return 0.0
        }
        def last:PptxTextLine (itemAt lines ((array_length lines) - 1))
        return (((last.y + last.h) + mt) + mb)
    }

    fn emitTable:void (dl:EVGDisplayList shape:PptxShape x:double y:double w:double h:double) {
        def rows:int shape.tableRows
        def cols:int shape.tableCols
        if (rows < 1) { rows = 1 }
        if (cols < 1) { cols = 1 }
        def colW:[double] (this.tableTracks(shape.tableColW cols w))
        def rowH:[double] (this.tableTracks(shape.tableRowH rows h))
        ; A row is at least as tall as its words: a stated height is a minimum
        ; in this format, and a row that ignores it draws its second line over
        ; the row underneath.
        def grown:boolean false
        def gi:int 0
        while (gi < (array_length shape.tableCells)) {
            def gcell:PptxTableCell (itemAt shape.tableCells gi)
            def gr:int (idiv gi cols)
            def gc:int (gi - (gr * cols))
            if (gr < rows) {
                if (gcell.merged == false) {
                    if (gcell.rowSpan == 1) {
                        def avail:double (itemAt colW gc)
                        def sp:int 1
                        while (sp < gcell.gridSpan) {
                            if ((gc + sp) < cols) {
                                avail = (avail + (itemAt colW (gc + sp)))
                            }
                            sp = (sp + 1)
                        }
                        def need:double (this.cellHeight(gcell avail))
                        if (need > (itemAt rowH gr)) {
                            set_at rowH gr need
                            grown = true
                        }
                    }
                }
            }
            gi = (gi + 1)
        }
        ; Where each track starts, so a cell that spans several knows how far
        ; it reaches.
        def colX:[double]
        def cx0:double x
        def c0:int 0
        while (c0 < cols) {
            push colX cx0
            cx0 = (cx0 + (itemAt colW c0))
            c0 = (c0 + 1)
        }
        def rowY:[double]
        def ry0:double y
        def r0:int 0
        while (r0 < rows) {
            push rowY ry0
            ry0 = (ry0 + (itemAt rowH r0))
            r0 = (r0 + 1)
        }
        def i:int 0
        while (i < (array_length shape.tableCells)) {
            def cell:PptxTableCell (itemAt shape.tableCells i)
            def ri:int (idiv i cols)
            def ci:int (i - (ri * cols))
            if (ri >= rows) {
                i = (i + 1)
                continue
            }
            if cell.merged {
                i = (i + 1)
                continue
            }
            def cx:double (itemAt colX ci)
            def cy:double (itemAt rowY ri)
            def cw:double 0.0
            def sc2:int 0
            while (sc2 < cell.gridSpan) {
                if ((ci + sc2) < cols) {
                    cw = (cw + (itemAt colW (ci + sc2)))
                }
                sc2 = (sc2 + 1)
            }
            def ch:double 0.0
            def sr:int 0
            while (sr < cell.rowSpan) {
                if ((ri + sr) < rows) {
                    ch = (ch + (itemAt rowH (ri + sr)))
                }
                sr = (sr + 1)
            }
            ; A cell is only filled when it says so. Painting an unfilled cell
            ; white put a white table on every dark slide in the deck.
            if (cell.fill.isSet) {
                this.pushRect(dl cx cy cw ch (this.colorFrom(cell.fill)))
            }
            this.emitCellEdges(dl cell cx cy cw ch)
            this.emitCellText(dl cell cx cy cw ch)
            i = (i + 1)
        }
    }

    ; Each edge on its own, because that is how a table states them: a header
    ; rule under the first row and nothing else is a very common table, and a
    ; box around every cell is a different picture entirely.
    fn emitCellEdges:void (dl:EVGDisplayList cell:PptxTableCell cx:double cy:double cw:double ch:double) {
        this.emitCellEdge(dl cell.lnT cx cy cw 0.0)
        this.emitCellEdge(dl cell.lnB cx (cy + ch) cw 0.0)
        this.emitCellEdge(dl cell.lnL cx cy 0.0 ch)
        this.emitCellEdge(dl cell.lnR (cx + cw) cy 0.0 ch)
    }

    fn emitCellEdge:void (dl:EVGDisplayList line:PptxTableLine x:double y:double w:double h:double) {
        if (line.isSet == false) {
            return
        }
        if (line.color.isSet == false) {
            return
        }
        def col:EVGColor (this.colorFrom(line.color))
        if ((col.alpha()) <= 0.004) {
            return
        }
        def t:double (this.ptToPx(line.widthPt))
        if (t < 1.0) {
            t = 1.0
        }
        def rw:double w
        def rh:double h
        if (rw <= 0.0) {
            rw = t
        }
        if (rh <= 0.0) {
            rh = t
        }
        this.pushRect(dl (x - (t * 0.5)) (y - (t * 0.5)) rw rh col)
    }

    ; A cell's words go through the same layout as a shape's: it IS a text body
    ; in a box, and giving it its own one-line painter is how a table ends up
    ; with text running out the side of every cell.
    fn emitCellText:void (dl:EVGDisplayList cell:PptxTableCell cx:double cy:double cw:double ch:double) {
        if ((strlen cell.text) == 0) {
            return
        }
        def inner (new PptxShape())
        inner.kind = (PptxShapeKind.shape())
        inner.hasText = true
        inner.text = cell.body
        inner.text.anchor = cell.anchor
        inner.text.anchorSet = true
        def ml:double (this.ptToPx(cell.marLPt))
        def mr:double (this.ptToPx(cell.marRPt))
        def mt:double (this.ptToPx(cell.marTPt))
        def mb:double (this.ptToPx(cell.marBPt))
        def bx:double (cx + ml)
        def by:double (cy + mt)
        def bw:double ((cw - ml) - mr)
        def bh:double ((ch - mt) - mb)
        if (bw <= 0.0) {
            return
        }
        dl.addClip(cx cy cw ch)
        this.emitTextBody(dl inner bx by bw bh)
        dl.addClipEnd()
    }

    ; A path drawn as a LINE rather than as an area: each segment is a quad,
    ; and the joins are square, which is what `a:round` on a thin bracket looks
    ; like at any size a slide is shown at.
    fn pushPathStroke:void (dl:EVGDisplayList pts:[double] width:double col:EVGColor closed:boolean) {
        def n:int (idiv (array_length pts) 2)
        if (n < 2) {
            return
        }
        def hw:double (width * 0.5)
        if (hw < 0.5) {
            hw = 0.5
        }
        def segs:int (n - 1)
        if closed {
            segs = n
        }
        def i:int 0
        while (i < segs) {
            def a:int (i * 2)
            def b:int (((i + 1) % n) * 2)
            def x0:double (itemAt pts a)
            def y0:double (itemAt pts (a + 1))
            def x1:double (itemAt pts b)
            def y1:double (itemAt pts (b + 1))
            def dx:double (x1 - x0)
            def dy:double (y1 - y0)
            def len:double (sqrt ((dx * dx) + (dy * dy)))
            if (len > 0.0001) {
                def nx:double ((0.0 - (dy / len)) * hw)
                def ny:double ((dx / len) * hw)
                def quad:[double] ([] _:double (
                    (x0 + nx) (y0 + ny)
                    (x1 + nx) (y1 + ny)
                    (x1 - nx) (y1 - ny)
                    (x0 - nx) (y0 - ny)
                ))
                this.pushPathFill(dl quad col)
                ; A square patch at the join, so a corner is not a notch.
                def join:[double] ([] _:double (
                    (x1 - hw) (y1 - hw)
                    (x1 + hw) (y1 - hw)
                    (x1 + hw) (y1 + hw)
                    (x1 - hw) (y1 + hw)
                ))
                if (i < (segs - 1)) {
                    this.pushPathFill(dl join col)
                }
            }
            i = (i + 1)
        }
    }

    ; The corner radius a rounded rectangle actually asks for: `adj` times the
    ; shorter side. DrawingML's default is 16667 (a sixth), which is what a
    ; shape that states no adjustment gets — not the fixed 12 pixels every
    ; rounded rectangle used to be drawn with whatever its size.
    sfn cornerRadius:double (shape:PptxShape w:double h:double) {
        def adj:double shape.adj
        if (adj < 0.0) {
            adj = 0.16667
        }
        def short:double w
        if (h < w) {
            short = h
        }
        def r:double (adj * short)
        if (r < 0.0) {
            r = 0.0
        }
        if (r > (short * 0.5)) {
            r = (short * 0.5)
        }
        return r
    }

    ; The outline of a rounded rectangle as points, so it can be STROKED. The
    ; display list's border primitive draws square corners, and a rounded box
    ; with only an outline came out square.
    sfn roundRectPoints:[double] (x:double y:double w:double h:double r:double) {
        def out:[double]
        if (r <= 0.5) {
            push out x
            push out y
            push out (x + w)
            push out y
            push out (x + w)
            push out (y + h)
            push out x
            push out (y + h)
            return out
        }
        def steps:int 6
        def cx:[double] ([] _:double ( (x + w - r) (x + w - r) (x + r) (x + r) ))
        def cy:[double] ([] _:double ( (y + r) (y + h - r) (y + h - r) (y + r) ))
        ; Corner order: top-right, bottom-right, bottom-left, top-left.
        def start:[double] ([] _:double ( -90.0 0.0 90.0 180.0 ))
        def c:int 0
        while (c < 4) {
            def a0:double (itemAt start c)
            def s:int 0
            while (s <= steps) {
                def a:double (a0 + ((90.0 * (to_double s)) / (to_double steps)))
                def rad:double ((a * 3.14159265358979) / 180.0)
                push out ((itemAt cx c) + (r * (cos rad)))
                push out ((itemAt cy c) + (r * (sin rad)))
                s = (s + 1)
            }
            c = (c + 1)
        }
        return out
    }

    ; --- connectors -----------------------------------------------------------

    fn emitConnector:void (dl:EVGDisplayList shape:PptxShape x:double y:double w:double h:double) {
        def col:EVGColor (EVGColor.rgb(60 60 70))
        if (shape.line.isSet) {
            col = (this.colorFrom(shape.line))
        }
        def width:double (this.ptToPx(shape.lineWidthPt))
        if (width < 1.0) {
            width = 1.0
        }
        def x0:double x
        def y0:double y
        def x1:double (x + w)
        def y1:double (y + h)
        if shape.flipH {
            x0 = (x + w)
            x1 = x
        }
        if shape.flipV {
            y0 = (y + h)
            y1 = y
        }
        def cx:double (x + (w * 0.5))
        def cy:double (y + (h * 0.5))
        if (shape.rotation != 0.0) {
            def ends:[double] ([] _:double ( x0 y0 x1 y1 ))
            def turned:[double] (PptxToEvg.rotatePoints(ends cx cy shape.rotation))
            x0 = (itemAt turned 0)
            y0 = (itemAt turned 1)
            x1 = (itemAt turned 2)
            y1 = (itemAt turned 3)
        }
        ; The line itself, as a quad — a display list has no stroke primitive,
        ; and a polygon is what both backends already draw.
        def dx:double (x1 - x0)
        def dy:double (y1 - y0)
        def len:double (sqrt ((dx * dx) + (dy * dy)))
        if (len < 0.0001) {
            return
        }
        def ux:double (dx / len)
        def uy:double (dy / len)
        def nx:double (0.0 - uy)
        def ny:double ux
        def hw:double (width * 0.5)
        ; The line stops short of an arrowhead, so the point is the end and not
        ; a blunt overhang past it.
        def headLen:double (width * 3.5)
        def sx:double x0
        def sy:double y0
        def ex:double x1
        def ey:double y1
        def hasHead:boolean (PptxToEvg.isArrow(shape.headEnd))
        def hasTail:boolean (PptxToEvg.isArrow(shape.tailEnd))
        if hasHead {
            sx = (x0 + (ux * (headLen * 0.6)))
            sy = (y0 + (uy * (headLen * 0.6)))
        }
        if hasTail {
            ex = (x1 - (ux * (headLen * 0.6)))
            ey = (y1 - (uy * (headLen * 0.6)))
        }
        def quad:[double] ([] _:double (
            (sx + (nx * hw)) (sy + (ny * hw))
            (ex + (nx * hw)) (ey + (ny * hw))
            (ex - (nx * hw)) (ey - (ny * hw))
            (sx - (nx * hw)) (sy - (ny * hw))
        ))
        this.pushPathFill(dl quad col)
        if hasHead {
            this.pushArrowHead(dl x0 y0 (0.0 - ux) (0.0 - uy) headLen (width * 1.6) col)
        }
        if hasTail {
            this.pushArrowHead(dl x1 y1 ux uy headLen (width * 1.6) col)
        }
    }

    sfn isArrow:boolean (kind:string) {
        if ((strlen kind) == 0) {
            return false
        }
        if (kind == "none") {
            return false
        }
        return true
    }

    ; A triangle with its point at the end of the line, pointing along it.
    fn pushArrowHead:void (dl:EVGDisplayList tipX:double tipY:double ux:double uy:double len:double halfW:double col:EVGColor) {
        def nx:double (0.0 - uy)
        def ny:double ux
        def bx:double (tipX - (ux * len))
        def by:double (tipY - (uy * len))
        def tri:[double] ([] _:double (
            tipX tipY
            (bx + (nx * halfW)) (by + (ny * halfW))
            (bx - (nx * halfW)) (by - (ny * halfW))
        ))
        this.pushPathFill(dl tri col)
    }

    fn emitShape:void (dl:EVGDisplayList shape:PptxShape ox:double oy:double) {
        def x:double (this.ptToPx((shape.x + ox)))
        def y:double (this.ptToPx((shape.y + oy)))
        def w:double (this.ptToPx(shape.width))
        def h:double (this.ptToPx(shape.height))
        if (shape.kind == (PptxShapeKind.group())) {
            def i:int 0
            while (i < (array_length shape.children)) {
                def child:PptxShape (itemAt shape.children i)
                def mapped:PptxShape (this.mapGroupChild(shape child))
                this.emitShape(dl mapped (ox + shape.x) (oy + shape.y))
                i = (i + 1)
            }
            return
        }
        if (shape.kind == (PptxShapeKind.picture())) {
            if ((strlen shape.imagePart) > 0) {
                this.pushImage(dl shape.imagePart x y w h shape.flipH shape.flipV shape.rotation)
            } {
                this.pushRect(dl x y w h (EVGColor.rgb(200 210 230)))
            }
            return
        }
        if (shape.kind == (PptxShapeKind.table())) {
            this.emitTable(dl shape x y w h)
            return
        }
        if (shape.kind == (PptxShapeKind.chart())) {
            PptxChartVela.emitToDisplayList(dl shape.chart x y w h)
            return
        }
        ; A connector is a LINE across its box, not a rectangle: the box states
        ; the two ends, and `flipH` / `flipV` say which corner is which. Drawn
        ; as a rectangle it was invisible — no fill, and an outline around a
        ; box nobody can see.
        if (shape.kind == (PptxShapeKind.connector())) {
            this.emitConnector(dl shape x y w h)
            return
        }
        ; Fill: gradient, path preset, or rect
        def filled:boolean false
        ; An open path has already been stroked with the shape's own line, and
        ; must not also get a rectangle drawn round it.
        def strokedPath:boolean false
        if (shape.fillGrad.isSet) {
            def gc (new EVGDrawCmd())
            ; use pushGradRect path via temporary
            this.pushGradRect(dl x y w h shape.fillGrad)
            def last:EVGDrawCmd (itemAt dl.cmds ((array_length dl.cmds) - 1))
            last.rotate = shape.rotation
            this.applyShadowToCmd(last shape)
            filled = true
        } {
            def usePath:boolean shape.hasPath
            if (usePath == false) {
                usePath = (PptxGeom.needsPath(shape.preset))
            }
            if usePath {
                def unit:[double] shape.pathUnit
                if (shape.hasPath == false) {
                    unit = (PptxGeom.unitPreset(shape.preset))
                }
                unit = (PptxToEvg.mirrorUnit(unit shape.flipH shape.flipV))
                def pathCx:double (x + (w * 0.5))
                def pathCy:double (y + (h * 0.5))
                def flat:[double] (PptxGeom.scaleToBox(unit x y w h))
                def pts:[double] (PptxToEvg.rotatePoints(flat pathCx pathCy shape.rotation))
                def col:EVGColor (EVGColor.rgb(180 180 190))
                if (shape.fill.isSet) {
                    col = (this.colorFrom(shape.fill))
                }
                ; shadow as offset dark polygon first
                if (shape.shadow.isSet) {
                    def sflat:[double] (PptxGeom.scaleToBox(unit (x + (this.ptToPx(shape.shadow.offsetXPt))) (y + (this.ptToPx(shape.shadow.offsetYPt))) w h))
                    def spts:[double] (PptxToEvg.rotatePoints(sflat pathCx pathCy shape.rotation))
                    def sc:EVGColor (this.colorFrom(shape.shadow.color))
                    def shc:EVGColor (EVGColor.rgba((sc.red()) (sc.green()) (sc.blue()) shape.shadow.alpha))
                    dl.addPolygon(spts shc)
                }
                ; An open path — a bracket, a brace, a line — is a stroke and
                ; not an area: filling it draws a solid blob where the deck
                ; asked for a rule.
                def openPath:boolean false
                if (shape.hasPath == false) {
                    openPath = (PptxGeom.isOpenPath(shape.preset))
                }
                if openPath {
                    def lw:double (this.ptToPx(shape.lineWidthPt))
                    if (lw < 1.0) {
                        lw = 1.0
                    }
                    def lc:EVGColor (EVGColor.rgb(60 60 70))
                    if (shape.line.isSet) {
                        lc = (this.colorFrom(shape.line))
                    }
                    this.pushPathStroke(dl pts lw lc false)
                    strokedPath = true
                } {
                    this.pushPathFill(dl pts col)
                }
                filled = true
            } {
                if (shape.fill.isSet) {
                    def rc (new EVGDrawCmd())
                    rc.kind = 0
                    rc.x = x
                    rc.y = y
                    rc.w = w
                    rc.h = h
                    def col2:EVGColor (this.colorFrom(shape.fill))
                    rc.r = (col2.red())
                    rc.g = (col2.green())
                    rc.b = (col2.blue())
                    rc.a = (col2.alpha())
                    if (shape.preset == "roundRect") {
                        rc.radius = (PptxToEvg.cornerRadius(shape w h))
                    }
                    rc.rotate = shape.rotation
                    this.applyShadowToCmd(rc shape)
                    push dl.cmds rc
                    filled = true
                } {
                    if (shape.shadow.isSet) {
                        def rc2 (new EVGDrawCmd())
                        rc2.kind = (PptxShapeKind.shape())
                        rc2.x = x
                        rc2.y = y
                        rc2.w = w
                        rc2.h = h
                        rc2.r = 255
                        rc2.g = 255
                        rc2.b = 255
                        rc2.a = 0.0
                        rc2.rotate = shape.rotation
                        this.applyShadowToCmd(rc2 shape)
                        push dl.cmds rc2
                    }
                }
            }
        }
        if ((shape.line.isSet) && (shape.lineWidthPt > 0.0)) {
            def lw2:double (this.ptToPx(shape.lineWidthPt))
            def lcol:EVGColor (this.colorFrom(shape.line))
            if (shape.preset == "roundRect") {
                ; A rounded box's outline follows its corners. The border
                ; primitive only knows square ones.
                def r2:double (PptxToEvg.cornerRadius(shape w h))
                def ring:[double] (PptxToEvg.roundRectPoints(x y w h r2))
                def turned:[double] (PptxToEvg.rotatePoints(ring (x + (w * 0.5)) (y + (h * 0.5)) shape.rotation))
                this.pushPathStroke(dl turned lw2 lcol true)
            } {
                if (strokedPath == false) {
                    this.pushBorder(dl x y w h lw2 lcol)
                    def border:EVGDrawCmd (itemAt dl.cmds ((array_length dl.cmds) - 1))
                    border.rotate = shape.rotation
                }
            }
        }
        if shape.hasText {
            this.emitTextBody(dl shape x y w h)
        }
    }

    fn slideToDisplayList:EVGDisplayList (slide:PptxSlide) {
        def dl (new EVGDisplayList())
        def pw:double (this.ptToPx(slide.width))
        def ph:double (this.ptToPx(slide.height))
        def bg:EVGColor (EVGColor.parse("#FFFFFF"))
        if (slide.bg.isSet) {
            bg = (this.colorFrom(slide.bg))
        }
        this.pushRect(dl 0.0 0.0 pw ph bg)
        def i:int 0
        while (i < (array_length slide.shapes)) {
            this.emitShape(dl (itemAt slide.shapes i) 0.0 0.0)
            i = (i + 1)
        }
        return dl
    }
}

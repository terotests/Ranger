; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxResolver - theme / layout / master → resolved slide scene
; ==============================================================================
;
; Pipeline:
;   theme → slide master → slide layout → slide → ResolvedSlide → EVG
;
; EVG never sees relationships, placeholders, or schemeClr — only concrete
; geometry, sRGB colors, fonts, and image part paths after this pass.
; ==============================================================================

Import "PptxModel.rgr"
Import "../../office/drawing/OfficeColor.rgr"

class PptxResolver {
    Constructor () {
    }

    ; Map placeholder / mapped scheme names used on slides (bg1, tx1, …) onto
    ; the theme's clrScheme keys. Masters can remap these; MVP uses defaults.
    fn mapSchemeName:string (name:string) {
        return (OfficeTheme.mapSchemeName(name))
    }

    fn resolveColor:PptxColor (c:PptxColor theme:PptxTheme) {
        if (c.isSet == false) {
            return c
        }
        if (c.isScheme == false) {
            return c
        }
        if c.baked {
            return c
        }
        def key:string (this.mapSchemeName(c.scheme))
        def hex:string (theme.colorOf(key))
        def out:PptxColor (PptxColor.srgbOf(hex))
        out.alpha = c.alpha
        out.copyModsFrom(c)
        ; Where the colour CAME FROM is kept, not just what it resolved to.
        ; Painting only ever reads `srgb`, so this costs nothing to draw — and
        ; it is the whole of what re-theming a deck needs: every colour that
        ; came from the palette can be asked to resolve again from a new one.
        out.isScheme = true
        out.scheme = c.scheme
        return out
    }

    fn resolveFont:string (face:string theme:PptxTheme) {
        if ((strlen face) == 0) {
            return theme.minorFont
        }
        if (face == "+mj-lt") {
            return theme.majorFont
        }
        if (face == "+mn-lt") {
            return theme.minorFont
        }
        if (face == "+mj-ea") {
            return theme.majorFont
        }
        if (face == "+mn-ea") {
            return theme.minorFont
        }
        return face
    }

    fn cloneColor:PptxColor (c:PptxColor) {
        def out (new PptxColor())
        out.isSet = c.isSet
        out.isScheme = c.isScheme
        out.scheme = c.scheme
        out.srgb = c.srgb
        out.alpha = c.alpha
        out.baked = c.baked
        out.copyModsFrom(c)
        return out
    }

    fn cloneRun:PptxTextRun (run:PptxTextRun) {
        def out (new PptxTextRun())
        out.text = run.text
        out.fontFamily = run.fontFamily
        out.fontSizePt = run.fontSizePt
        out.resolvedFontSig = run.resolvedFontSig
        out.resolvedColorSig = run.resolvedColorSig
        out.resolvedSizeSig = run.resolvedSizeSig
        out.sizeSet = run.sizeSet
        out.bold = run.bold
        out.italic = run.italic
        out.color = (this.cloneColor(run.color))
        out.highlight = (this.cloneColor(run.highlight))
        return out
    }

    fn cloneTextBody:PptxTextBody (body:PptxTextBody) {
        def out (new PptxTextBody())
        out.insetL = body.insetL
        out.insetT = body.insetT
        out.insetR = body.insetR
        out.insetB = body.insetB
        out.insetsSet = body.insetsSet
        out.anchor = body.anchor
        out.anchorSet = body.anchorSet
        out.wrap = body.wrap
        out.hasDefRPr = body.hasDefRPr
        out.defFontSizePt = body.defFontSizePt
        out.defBold = body.defBold
        out.defItalic = body.defItalic
        out.defFontFamily = body.defFontFamily
        out.defColor = (this.cloneColor(body.defColor))
        out.defAlign = body.defAlign
        out.fontScale = body.fontScale
        out.lineScale = body.lineScale
        out.listStyle = body.listStyle
        def i:int 0
        while (i < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs i)
            def op (new PptxParagraph())
            op.align = para.align
            op.alignSet = para.alignSet
            op.spaceBeforePt = para.spaceBeforePt
            op.spaceAfterPt = para.spaceAfterPt
            op.lineSpacingPct = para.lineSpacingPct
            op.level = para.level
            op.hasBullet = para.hasBullet
            op.bulletSet = para.bulletSet
            op.bulletChar = para.bulletChar
            op.marginLeftPt = para.marginLeftPt
            op.marginSet = para.marginSet
            op.indentPt = para.indentPt
            op.indentSet = para.indentSet
            op.bulletColor = (this.cloneColor(para.bulletColor))
            op.bulletSizePct = para.bulletSizePct
            op.bulletSizePt = para.bulletSizePt
            op.bulletFont = para.bulletFont
            def j:int 0
            while (j < (array_length para.runs)) {
                push op.runs (this.cloneRun((itemAt para.runs j)))
                j = (j + 1)
            }
            push out.paragraphs op
            i = (i + 1)
        }
        return out
    }

    fn cloneShape:PptxShape (shape:PptxShape) {
        def out (new PptxShape())
        out.kind = shape.kind
        out.name = shape.name
        out.x = shape.x
        out.y = shape.y
        out.width = shape.width
        out.height = shape.height
        out.hasXfrm = shape.hasXfrm
        out.rotation = shape.rotation
        out.preset = shape.preset
        out.adj = shape.adj
        out.shapeId = shape.shapeId
        out.noFill = shape.noFill
        out.noLine = shape.noLine
        out.headEnd = shape.headEnd
        out.tailEnd = shape.tailEnd
        out.fillRef = shape.fillRef
        out.fillRefColor = (this.cloneColor(shape.fillRefColor))
        out.lineRef = shape.lineRef
        out.lineRefColor = (this.cloneColor(shape.lineRefColor))
        out.effectRef = shape.effectRef
        out.fontRefColor = (this.cloneColor(shape.fontRefColor))
        out.hasPath = shape.hasPath
        out.pathUnit = shape.pathUnit
        out.pathEnds = shape.pathEnds
        ; Dropping this drew every custom path closed, whatever the file said:
        ; the parser reads `Z` and the renderer asks for it, and the resolved
        ; copy in between was answering `false`... which the renderer's own
        ; default then turned back into "closed". A hand-drawn open stroke came
        ; out joined end to end.
        out.pathClosed = shape.pathClosed
        out.fill = (this.cloneColor(shape.fill))
        out.line = (this.cloneColor(shape.line))
        out.lineWidthPt = shape.lineWidthPt
        out.hasText = shape.hasText
        out.text = (this.cloneTextBody(shape.text))
        out.imageRid = shape.imageRid
        out.imagePart = shape.imagePart
        out.imageBytes = shape.imageBytes
        out.imageOk = shape.imageOk
        out.altText = shape.altText
        out.hasStyle = shape.hasStyle
        out.fontRef = shape.fontRef
        out.styleFillSig = shape.styleFillSig
        out.styleLineSig = shape.styleLineSig
        out.sheetXfrmSig = shape.sheetXfrmSig
        out.isPlaceholder = shape.isPlaceholder
        out.phType = shape.phType
        out.phIdx = shape.phIdx
        out.inherited = shape.inherited
        out.locked = shape.locked
        out.flipH = shape.flipH
        out.flipV = shape.flipV
        out.chX = shape.chX
        out.chY = shape.chY
        out.chW = shape.chW
        out.chH = shape.chH
        def i:int 0
        while (i < (array_length shape.children)) {
            push out.children (this.cloneShape((itemAt shape.children i)))
            i = (i + 1)
        }
        return out
    }

    fn phTypeCompatible:boolean (a:string b:string) {
        if (a == b) {
            return true
        }
        ; Title family
        if (((a == "title") || (a == "ctrTitle")) && ((b == "title") || (b == "ctrTitle"))) {
            return true
        }
        if (((a == "body") || (a == "obj") || (a == "subTitle")) && ((b == "body") || (b == "obj") || (b == "subTitle"))) {
            return true
        }
        return false
    }

    fn findPlaceholder@(optional):PptxShape (shapes:[PptxShape] phType:string phIdx:int) {
        ; 1) exact type + idx
        def i:int 0
        while (i < (array_length shapes)) {
            def s:PptxShape (itemAt shapes i)
            if s.isPlaceholder {
                if ((this.phTypeCompatible(s.phType phType)) && (s.phIdx == phIdx) && (phIdx >= 0)) {
                    def hit@(optional):PptxShape s
                    return hit
                }
            }
            i = (i + 1)
        }
        ; 2) type match (ignore idx)
        def j:int 0
        while (j < (array_length shapes)) {
            def s2:PptxShape (itemAt shapes j)
            if s2.isPlaceholder {
                if (this.phTypeCompatible(s2.phType phType)) {
                    def hit2@(optional):PptxShape s2
                    return hit2
                }
            }
            j = (j + 1)
        }
        ; 3) idx-only match
        if (phIdx >= 0) {
            def k:int 0
            while (k < (array_length shapes)) {
                def s3:PptxShape (itemAt shapes k)
                if s3.isPlaceholder {
                    if (s3.phIdx == phIdx) {
                        def hit3@(optional):PptxShape s3
                        return hit3
                    }
                }
                k = (k + 1)
            }
        }
        def __missing@(optional):PptxShape
        return __missing
    }

    ; Which of the master's three styles a placeholder of this kind uses.
    ; PowerPoint's own rule: titles take the title style, bodies and the things
    ; that behave like bodies take the body style, everything else — and every
    ; shape that is not a placeholder at all — takes the other style.
    sfn styleForPh:PptxListStyle (master:PptxSheet phType:string) {
        if ((phType == "title") || (phType == "ctrTitle")) {
            return master.titleStyle
        }
        if ((phType == "body") || (phType == "subTitle") || (phType == "obj")) {
            return master.bodyStyle
        }
        return master.otherStyle
    }

    ; The typography a shape inherits when it is not a placeholder: the
    ; master's `otherStyle`, with whatever the shape itself said over it.
    ;
    ; `p:defaultTextStyle` in presentation.xml is the step below this one and
    ; is not read here. In every deck seen so far it repeats what `otherStyle`
    ; says — the one this was reported on states 14 points in both — so it
    ; would change nothing; a deck that has the second and not the first would
    ; still fall back to this reader's own default.
    fn applyOtherStyle:void (shape:PptxShape master@(optional):PptxSheet) {
        if (null? master) {
            return
        }
        def mas:PptxSheet (unwrap master)
        if (mas.otherStyle.isSet == false) {
            return
        }
        def inherited (new PptxListStyle())
        inherited.mergeFrom(mas.otherStyle)
        inherited.mergeFrom(shape.text.listStyle)
        shape.text.listStyle = inherited
    }

    ; The same inheritance, down through a group.
    ;
    ; `resolveShape` already walks a group's children — for their fills, their
    ; lines and their own text bodies — but the typography was applied only to
    ; the shapes a slide lists directly, so anything inside a `p:grpSp` got
    ; none of it. On the deck this was reported from, four boxes sat in one
    ; group and were the only four still drawn in this reader's defaults: 18
    ; points where the deck said 14, and WHITE where the deck said black,
    ; because a missing inherited style loses the colour exactly as it loses
    ; the size. They were also the only four that looked wrong after the size
    ; was fixed everywhere else, which is what pointed at the group.
    fn inheritChildren:void (shape:PptxShape master@(optional):PptxSheet theme:PptxTheme) {
        def i:int 0
        while (i < (array_length shape.children)) {
            def kid:PptxShape (itemAt shape.children i)
            if (kid.isPlaceholder == false) {
                this.applyOtherStyle(kid master)
            }
            this.applyListStyle(kid.text theme)
            this.inheritChildren(kid master theme)
            i = (i + 1)
        }
    }

    ; Put the effective list style onto the paragraphs: each one takes the
    ; level it sits at, and states nothing it stated itself. This is where nine
    ; levels of inheritance become one paragraph's size, colour and indent.
    fn applyListStyle:void (body:PptxTextBody theme:PptxTheme) {
        if (body.listStyle.isSet == false) {
            return
        }
        def i:int 0
        while (i < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs i)
            def bodyListStyle (body.listStyle)
            def lvl:PptxLevelStyle (bodyListStyle.at(para.level))
            if (para.alignSet == false) {
                if lvl.alignSet {
                    para.align = lvl.align
                    para.alignSet = true
                }
            }
            ; An indent taken from the level style is as much a stated indent
            ; as one written on the paragraph — the deck said it, one link up
            ; the chain — so the flag is set too. Without that, a deck saved
            ; out of here (which writes the resolved indent on the paragraph)
            ; laid its text out differently from the deck it came from.
            if lvl.marginSet {
                if (para.marginSet == false) {
                    para.marginLeftPt = lvl.marginLeftPt
                    para.marginSet = true
                }
            }
            if lvl.indentSet {
                if (para.indentSet == false) {
                    para.indentPt = lvl.indentPt
                    para.indentSet = true
                }
            }
            if lvl.spaceBeforeSet {
                if (para.spaceBeforePt == 0.0) {
                    para.spaceBeforePt = lvl.spaceBeforePt
                }
            }
            if lvl.spaceAfterSet {
                if (para.spaceAfterPt == 0.0) {
                    para.spaceAfterPt = lvl.spaceAfterPt
                }
            }
            if lvl.lineSpacingSet {
                if (para.lineSpacingPct == 100.0) {
                    para.lineSpacingPct = lvl.lineSpacingPct
                }
            }
            ; The bullet, when the paragraph did not decide for itself — and
            ; `<a:buNone/>` on the paragraph IS deciding.
            if (para.bulletSet == false) {
                if (lvl.bulletKind == "char") {
                    para.hasBullet = true
                    para.bulletChar = lvl.bulletChar
                }
                if (lvl.bulletKind == "autonum") {
                    para.hasBullet = true
                    para.bulletAutoNum = true
                    para.bulletScheme = lvl.bulletScheme
                    para.bulletStartAt = lvl.bulletStartAt
                }
                if (lvl.bulletKind == "none") {
                    para.hasBullet = false
                }
            }
            if lvl.bulletColor.isSet {
                if (para.bulletColor.isSet == false) {
                    para.bulletColor = (this.resolveColor((this.cloneColor(lvl.bulletColor)) theme))
                }
            }
            if lvl.bulletSizePctSet {
                if (para.bulletSizePct == 100.0) {
                    para.bulletSizePct = lvl.bulletSizePct
                }
            }
            if lvl.bulletSizePtSet {
                if (para.bulletSizePt == 0.0) {
                    para.bulletSizePt = lvl.bulletSizePt
                }
            }
            if ((strlen para.bulletFont) == 0) {
                para.bulletFont = lvl.bulletFont
            }
            ; …and the run properties, for every run that states none.
            def k:int 0
            while (k < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs k)
                if (run.sizeSet == false) {
                    if lvl.sizeSet {
                        run.fontSizePt = lvl.fontSizePt
                        run.sizeSet = true
                    }
                }
                if ((strlen run.fontFamily) == 0) {
                    if ((strlen lvl.fontFamily) > 0) {
                        run.fontFamily = lvl.fontFamily
                    }
                }
                if (run.color.isSet == false) {
                    if lvl.color.isSet {
                        run.color = (this.cloneColor(lvl.color))
                    }
                }
                ; The level style decides only when the RUN said nothing.
                ; `run.bold == false` was the test here, which is also true of
                ; a run that said `b="0"` — so a word deliberately taken out of
                ; a bold list level came back bold.
                if (run.boldSet == false) {
                    if lvl.boldSet {
                        run.bold = lvl.bold
                        run.boldSet = true
                    }
                }
                if (run.italicSet == false) {
                    if lvl.italicSet {
                        run.italic = lvl.italic
                        run.italicSet = true
                    }
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        ; What PowerPoint already shrank the text by to make it fit.
        if (body.fontScale != 1.0) {
            def pi:int 0
            while (pi < (array_length body.paragraphs)) {
                def p2:PptxParagraph (itemAt body.paragraphs pi)
                def ri:int 0
                while (ri < (array_length p2.runs)) {
                    def r2:PptxTextRun (itemAt p2.runs ri)
                    r2.fontSizePt = (r2.fontSizePt * body.fontScale)
                    ri = (ri + 1)
                }
                p2.lineSpacingPct = (p2.lineSpacingPct * body.lineScale)
                pi = (pi + 1)
            }
        }
    }

    fn applyDefRPrToRun:void (run:PptxTextRun body:PptxTextBody) {
        if (body.hasDefRPr == false) {
            return
        }
        if (run.sizeSet == false) {
            run.fontSizePt = body.defFontSizePt
            run.sizeSet = true
        }
        if ((strlen run.fontFamily) == 0) {
            if ((strlen body.defFontFamily) > 0) {
                run.fontFamily = body.defFontFamily
            }
        }
        if (run.color.isSet == false) {
            if (body.defColor.isSet) {
                run.color = (this.cloneColor(body.defColor))
            }
        }
        if (run.boldSet == false) {
            if body.defBoldSet {
                run.bold = body.defBold
                run.boldSet = true
            }
        }
        if (run.italicSet == false) {
            if body.defItalicSet {
                run.italic = body.defItalic
                run.italicSet = true
            }
        }
    }

    fn mergePlaceholderFrom:void (dst:PptxShape src:PptxShape) {
        ; Geometry: slide wins when it supplied an xfrm with positive size
        if ((dst.hasXfrm == false) || ((dst.width <= 0.0) && (dst.height <= 0.0))) {
            dst.x = src.x
            dst.y = src.y
            dst.width = src.width
            dst.height = src.height
            dst.rotation = src.rotation
            dst.hasXfrm = true
            ; Inherited, not stated — recorded as it stands now, so a later
            ; move stops matching and IS written. See `sheetXfrmSig`.
            dst.sheetXfrmSig = (dst.xfrmSignature())
        }
        if ((strlen dst.preset) == 0) {
            dst.preset = src.preset
        }
        if ((dst.preset == "rect") && (src.preset != "rect")) {
            if (dst.hasXfrm == false) {
                dst.preset = src.preset
            }
        }
        if (dst.fill.isSet == false) {
            if (src.fill.isSet) {
                dst.fill = (this.cloneColor(src.fill))
            }
        }
        if (dst.line.isSet == false) {
            if (src.line.isSet) {
                dst.line = (this.cloneColor(src.line))
                dst.lineWidthPt = src.lineWidthPt
            }
        }
        ; Text style / body props from placeholder definition
        if src.hasText {
            def srcBody:PptxTextBody src.text
            if (dst.hasText == false) {
                dst.hasText = true
                dst.text = (this.cloneTextBody(srcBody))
            } {
                def dstBody:PptxTextBody dst.text
                if (dstBody.insetsSet == false) {
                    if srcBody.insetsSet {
                        dstBody.insetL = srcBody.insetL
                        dstBody.insetT = srcBody.insetT
                        dstBody.insetR = srcBody.insetR
                        dstBody.insetB = srcBody.insetB
                        dstBody.insetsSet = true
                    }
                }
                if (dstBody.anchorSet == false) {
                    if srcBody.anchorSet {
                        dstBody.anchor = srcBody.anchor
                        dstBody.anchorSet = true
                    }
                }
                if (dstBody.hasDefRPr == false) {
                    if srcBody.hasDefRPr {
                        dstBody.hasDefRPr = true
                        dstBody.defFontSizePt = srcBody.defFontSizePt
                        dstBody.defBold = srcBody.defBold
                        dstBody.defItalic = srcBody.defItalic
                        dstBody.defFontFamily = srcBody.defFontFamily
                        dstBody.defColor = (this.cloneColor(srcBody.defColor))
                        dstBody.defAlign = srcBody.defAlign
                    }
                }
                def pi:int 0
                while (pi < (array_length dstBody.paragraphs)) {
                    def para:PptxParagraph (itemAt dstBody.paragraphs pi)
                    if (para.alignSet == false) {
                        if ((strlen dstBody.defAlign) > 0) {
                            para.align = dstBody.defAlign
                        } {
                            if ((array_length srcBody.paragraphs) > 0) {
                                def sp:PptxParagraph (itemAt srcBody.paragraphs 0)
                                if sp.alignSet {
                                    para.align = sp.align
                                }
                            }
                        }
                    }
                    ; The placeholder's default run properties are NOT applied
                    ; here. They are level one of a list style, and applying
                    ; them now marks every run as sized and coloured before the
                    ; LEVEL each paragraph actually sits at has been consulted
                    ; — which drew every sub-bullet in the top level's size.
                    ; `resolveTextBody` applies them afterwards, to whatever the
                    ; level style left unset, which is the right order.
                    pi = (pi + 1)
                }
            }
        }
    }

    fn resolveTextBody:void (body:PptxTextBody theme:PptxTheme) {
        def i:int 0
        while (i < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs i)
            def j:int 0
            while (j < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs j)
                ; What the run itself said, before anything is filled in.
                def statedFont:boolean ((strlen run.fontFamily) > 0)
                def statedColor:boolean run.color.isSet
                def statedSize:boolean run.sizeSet
                this.applyDefRPrToRun(run body)
                run.fontFamily = (this.resolveFont(run.fontFamily theme))
                if (run.highlight.isSet) {
                    run.highlight = (this.resolveColor(run.highlight theme))
                }
                if (run.color.isSet) {
                    run.color = (this.resolveColor(run.color theme))
                } {
                    if (body.defColor.isSet) {
                        run.color = (this.resolveColor(body.defColor theme))
                    } {
                        run.color = (this.resolveColor((PptxColor.schemeOf("dk1")) theme))
                    }
                }
                ; Recorded as it stands now. Anything the user changes later
                ; stops matching, and the writer states the change.
                if (statedFont == false) {
                    run.resolvedFontSig = run.fontFamily
                }
                if (statedColor == false) {
                    run.resolvedColorSig = (run.color.signature())
                }
                if (statedSize == false) {
                    run.resolvedSizeSig = (to_string (to_int ((run.fontSizePt * 100.0) + 0.5)))
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
    }

    ; --- colour adjustments ---------------------------------------------------
    ;
    ; DrawingML states a colour and then a chain of adjustments to it, and a
    ; theme's fill styles are made almost entirely of those adjustments — the
    ; colour in them is the placeholder `phClr`. Dropping them draws a themed
    ; shape flat, and dropping the STYLE draws it not at all.

    sfn hexNibble:int (c:string) {
        def i:int 0
        def digits:string "0123456789abcdef"
        def lower:string c
        if (lower == "A") { lower = "a" }
        if (lower == "B") { lower = "b" }
        if (lower == "C") { lower = "c" }
        if (lower == "D") { lower = "d" }
        if (lower == "E") { lower = "e" }
        if (lower == "F") { lower = "f" }
        while (i < 16) {
            if ((substring digits i (i + 1)) == lower) {
                return i
            }
            i = (i + 1)
        }
        return 0
    }

    ; Hex in, hex out, and the clamp between them — `OfficeColor`'s, shared
    ; with the spreadsheet. They were the same three functions written twice.
    sfn byteAt:int (hex:string at:int) {
        return (OfficeColorMath.byteAt(hex at))
    }

    sfn hexOf:string (v:int) {
        return (OfficeColorMath.hexOf(v))
    }

    sfn clamp01:double (v:double) {
        return (OfficeColorMath.clamp01(v))
    }

    ; A `PptxColor` as the shared carrier wants it. Only the modifiers matter
    ; here — this is handed straight to `applyDrawingMods` and thrown away.
    sfn asOfficeColor:OfficeColor (col:PptxColor) {
        def out (new OfficeColor())
        out.isSet = col.isSet
        out.isScheme = col.isScheme
        out.scheme = col.scheme
        out.srgb = col.srgb
        out.alpha = col.alpha
        out.lumMod = col.lumMod
        out.lumOff = col.lumOff
        out.tint = col.tint
        out.shade = col.shade
        out.satMod = col.satMod
        out.baked = col.baked
        return out
    }

    ; The adjustments, in the order DrawingML applies them. The maths is
    ; `OfficeColorMath.applyDrawingMods`, shared with the spreadsheet's
    ; drawings and charts — and deliberately NOT shared with Excel's cell
    ; `tint`, which scales HLS luminance rather than the RGB channels and is a
    ; different function with the same name.
    sfn applyMods:string (hex:string col:PptxColor) {
        return (OfficeColorMath.applyDrawingMods(hex (PptxResolver.asOfficeColor(col))))
    }

    ; A theme fill style, with the placeholder colour filled in from the
    ; shape's own `fillRef`. The style's colours carry the modifiers; the ref
    ; carries the colour they are applied to.
    fn styleColor:PptxColor (styleCol:PptxColor refCol:PptxColor theme:PptxTheme) {
        def base:PptxColor refCol
        if (styleCol.isSet) {
            if (styleCol.isScheme == false) {
                base = styleCol
            } {
                if (styleCol.scheme != "phClr") {
                    base = styleCol
                }
            }
        }
        def resolved:PptxColor (this.resolveColor(base theme))
        def out (new PptxColor())
        out.isSet = true
        out.isScheme = resolved.isScheme
        out.scheme = resolved.scheme
        out.alpha = (resolved.alpha * styleCol.alpha)
        ; The reference's own modifiers apply first, then the style's.
        def once:string (PptxResolver.applyMods(resolved.srgb base))
        out.srgb = (PptxResolver.applyMods(once styleCol))
        out.baked = true
        return out
    }

    ; A shape that states no fill of its own but carries a `<p:style>` gets the
    ; theme's fill — which is where a deck's gradients usually live.
    fn applyStyleRefs:void (shape:PptxShape theme:PptxTheme) {
        if (shape.fillRef > 0) {
            if (shape.fill.isSet == false) {
                if (shape.fillGrad.isSet == false) {
                    if (shape.noFill == false) {
                        def st@(optional):PptxFillStyle (theme.fillStyleAt(shape.fillRef))
                        if (!null? st) {
                            def style:PptxFillStyle (unwrap st)
                            if (style.kind == 1) {
                                shape.fillGrad.isSet = true
                                shape.fillGrad.dir = style.dir
                                shape.fillGrad.c1 = (this.styleColor(style.c1 shape.fillRefColor theme))
                                shape.fillGrad.c2 = (this.styleColor(style.c2 shape.fillRefColor theme))
                                ; Worked out here, not read from the file. A
                                ; save that writes it back as the shape's own
                                ; fill would bake the theme into the deck.
                            } {
                                if (style.kind == 0) {
                                    shape.fill = (this.styleColor(style.solid shape.fillRefColor theme))
                                }
                            }
                            ; Recorded as it stands NOW. If the user changes
                            ; the fill later it stops matching, and the writer
                            ; states the change rather than the inheritance.
                            shape.styleFillSig = (shape.fillSignature())
                        }
                    }
                }
            }
        }
        if (shape.lineRef > 0) {
            if ((shape.line.isSet == false) && (shape.noLine == false)) {
                def ls@(optional):PptxLineStyle (theme.lineStyleAt(shape.lineRef))
                if (!null? ls) {
                    def lstyle:PptxLineStyle (unwrap ls)
                    shape.line = (this.styleColor(lstyle.color shape.lineRefColor theme))
                    if (shape.lineWidthPt <= 0.0) {
                        shape.lineWidthPt = lstyle.widthPt
                    }
                    shape.styleLineSig = (shape.lineSignature())
                }
            }
        }
        if (shape.effectRef > 0) {
            if (shape.shadow.isSet == false) {
                if (theme.effectShadowAt(shape.effectRef)) {
                    shape.shadow.isSet = true
                    shape.shadow.color = (PptxColor.srgbOf("000000"))
                }
            }
        }
    }

    ; The default text colour for a shape styled by the theme. `fontRef` sits
    ; below what a run says and below what the body's own default style says,
    ; and above the "black" everything else falls back to — which is why white
    ; text on a themed shape used to come out black.
    fn applyFontRef:void (shape:PptxShape theme:PptxTheme) {
        if (shape.fontRefColor.isSet == false) {
            return
        }
        if (shape.hasText == false) {
            return
        }
        if (shape.text.defColor.isSet) {
            return
        }
        shape.text.defColor = (this.styleColor(shape.fontRefColor shape.fontRefColor theme))
    }

    fn resolveTableLine:void (line:PptxTableLine theme:PptxTheme) {
        if (line.isSet == false) {
            return
        }
        if (line.color.isSet) {
            line.color = (this.resolveColor(line.color theme))
        }
    }

    fn resolveShape:void (shape:PptxShape theme:PptxTheme) {
        this.applyStyleRefs(shape theme)
        if (shape.fill.isSet) {
            shape.fill = (this.resolveColor(shape.fill theme))
        }
        if (shape.fillGrad.isSet) {
            shape.fillGrad.c1 = (this.resolveColor(shape.fillGrad.c1 theme))
            shape.fillGrad.c2 = (this.resolveColor(shape.fillGrad.c2 theme))
        }
        if (shape.line.isSet) {
            shape.line = (this.resolveColor(shape.line theme))
        }
        if (shape.shadow.isSet) {
            shape.shadow.color = (this.resolveColor(shape.shadow.color theme))
        }
        if shape.hasText {
            this.applyFontRef(shape theme)
            this.resolveTextBody(shape.text theme)
        }
        if (shape.kind == (PptxShapeKind.table())) {
            def ti:int 0
            while (ti < (array_length shape.tableCells)) {
                def cell:PptxTableCell (itemAt shape.tableCells ti)
                if (cell.fill.isSet) {
                    cell.fill = (this.resolveColor(cell.fill theme))
                }
                this.resolveTextBody(cell.body theme)
                this.resolveTableLine(cell.lnL theme)
                this.resolveTableLine(cell.lnR theme)
                this.resolveTableLine(cell.lnT theme)
                this.resolveTableLine(cell.lnB theme)
                ti = (ti + 1)
            }
        }
        def i:int 0
        while (i < (array_length shape.children)) {
            this.resolveShape((itemAt shape.children i) theme)
            i = (i + 1)
        }
    }

    fn sheetOf@(optional):PptxSheet (cache:[string:PptxSheet] part:string) {
        if ((strlen part) == 0) {
            def __missing@(optional):PptxSheet
            return __missing
        }
        def hit@(optional):PptxSheet (get cache part)
        return hit
    }

    fn resolveSlide:PptxSlide (slide:PptxSlide theme:PptxTheme layouts:[string:PptxSheet] masters:[string:PptxSheet]) {
        def layout@(optional):PptxSheet (this.sheetOf(layouts slide.layoutPart))
        def master@(optional):PptxSheet (this.sheetOf(masters slide.masterPart))

        ; Background: slide → layout → master → lt1.
        ;
        ; Everything past the first line is INHERITED, and a save that wrote it
        ; back as the slide's own would freeze it — see `bgFromSheet`.
        slide.bgFromSheet = (slide.bg.isSet == false)
        if (slide.bg.isSet == false) {
            if (!null? layout) {
                def lay:PptxSheet (unwrap layout)
                if (lay.bg.isSet) {
                    slide.bg = (this.cloneColor(lay.bg))
                }
            }
        }
        if (slide.bg.isSet == false) {
            if (!null? master) {
                def mas:PptxSheet (unwrap master)
                if (mas.bg.isSet) {
                    slide.bg = (this.cloneColor(mas.bg))
                }
            }
        }
        if (slide.bg.isSet) {
            slide.bg = (this.resolveColor(slide.bg theme))
        } {
            slide.bg = (this.resolveColor((PptxColor.schemeOf("lt1")) theme))
        }

        def resolved:[PptxShape]

        ; Master chrome (non-placeholders), then layout chrome
        if (!null? master) {
            def ms:PptxSheet (unwrap master)
            def mi:int 0
            while (mi < (array_length ms.shapes)) {
                def mshape:PptxShape (itemAt ms.shapes mi)
                if (mshape.isPlaceholder == false) {
                    def mc:PptxShape (this.cloneShape(mshape))
                    mc.inherited = true
                    this.resolveShape(mc theme)
                    push resolved mc
                }
                mi = (mi + 1)
            }
        }
        if (!null? layout) {
            def ls:PptxSheet (unwrap layout)
            def li:int 0
            while (li < (array_length ls.shapes)) {
                def lshape:PptxShape (itemAt ls.shapes li)
                if (lshape.isPlaceholder == false) {
                    def lc:PptxShape (this.cloneShape(lshape))
                    lc.inherited = true
                    ; Decoration from the layout is still a shape with text in
                    ; it, and inherits the same way a slide's own does.
                    this.applyOtherStyle(lc master)
                    this.applyListStyle(lc.text theme)
                    this.inheritChildren(lc master theme)
                    this.resolveShape(lc theme)
                    push resolved lc
                }
                li = (li + 1)
            }
        }

        ; Slide shapes with placeholder inheritance
        def i:int 0
        while (i < (array_length slide.shapes)) {
            def shape:PptxShape (itemAt slide.shapes i)
            if shape.isPlaceholder {
                def matched@(optional):PptxShape
                if (!null? layout) {
                    def lay2:PptxSheet (unwrap layout)
                    matched = (this.findPlaceholder(lay2.shapes shape.phType shape.phIdx))
                }
                if (null? matched) {
                    if (!null? master) {
                        def mas2:PptxSheet (unwrap master)
                        matched = (this.findPlaceholder(mas2.shapes shape.phType shape.phIdx))
                    }
                }
                if (!null? matched) {
                    this.mergePlaceholderFrom(shape (unwrap matched))
                }
                ; The typography a placeholder inherits: the master's style for
                ; this KIND of placeholder first, then the layout's own list
                ; style over it, then whatever the shape itself says. Most
                ; placeholders in most decks state nothing at all, so without
                ; this a deck is drawn in this reader's defaults rather than in
                ; its own.
                def inherited (new PptxListStyle())
                if (!null? master) {
                    def mas3:PptxSheet (unwrap master)
                    ; `p:txStyles` is the LAST resort, under the master's own
                    ; placeholder — which is where a deck built by anything but
                    ; PowerPoint puts its real typography, leaving txStyles as
                    ; a generic black nobody meant.
                    inherited.mergeFrom((PptxResolver.styleForPh(mas3 shape.phType)))
                    def mph@(optional):PptxShape (this.findPlaceholder(mas3.shapes shape.phType shape.phIdx))
                    if (!null? mph) {
                        def mp:PptxShape (unwrap mph)
                        inherited.mergeFrom(mp.text.listStyle)
                    }
                }
                if (!null? matched) {
                    def mt:PptxShape (unwrap matched)
                    inherited.mergeFrom(mt.text.listStyle)
                }
                inherited.mergeFrom(shape.text.listStyle)
                shape.text.listStyle = inherited
            } {
                ; …and a shape that is NOT a placeholder inherits too. The rule
                ; is written a page up on `styleForPh` — "everything else, and
                ; every shape that is not a placeholder at all, takes the other
                ; style" — and this branch is where it was missing: the whole
                ; block above sat inside the placeholder test, so a plain box
                ; with words in it inherited nothing and fell back to THIS
                ; READER's defaults.
                ;
                ; That is 18 points against the 14 the deck asked for, which is
                ; a quarter too big: reported on a diagram of boxes where every
                ; label overflowed its box and wrapped mid-word — "Prosess/i",
                ; "Terveys-/tietokan/ta" — while the title, which states its own
                ; size, was correct. A deck exported from Google Slides is
                ; entirely such shapes; there is not one placeholder on the
                ; slide.
                this.applyOtherStyle(shape master)
            }
            this.applyListStyle(shape.text theme)
            this.inheritChildren(shape master theme)
            this.resolveShape(shape theme)
            push resolved shape
            i = (i + 1)
        }
        slide.shapes = resolved
        return slide
    }

    ; A master or layout can be opened for editing, and then it is drawn like a
    ; slide — so its own background has to be a colour, not a theme slot that
    ; nothing has looked up yet.
    fn resolveSheetBackgrounds:void (cache:[string:PptxSheet] theme:PptxTheme) {
        def parts:[string] (keys cache)
        def i:int 0
        while (i < (array_length parts)) {
            def hit@(optional):PptxSheet (get cache (itemAt parts i))
            if (!null? hit) {
                def sheet:PptxSheet (unwrap hit)
                if (sheet.bg.isSet) {
                    sheet.bg = (this.resolveColor(sheet.bg theme))
                } {
                    sheet.bg = (this.resolveColor((PptxColor.schemeOf("lt1")) theme))
                }
            }
            i = (i + 1)
        }
    }

    fn resolvePresentation:PptxPresentation (pres:PptxPresentation) {
        def i:int 0
        while (i < (array_length pres.slides)) {
            this.resolveSlide((itemAt pres.slides i) pres.theme pres.layouts pres.masters)
            i = (i + 1)
        }
        this.resolveSheetBackgrounds(pres.masters pres.theme)
        this.resolveSheetBackgrounds(pres.layouts pres.theme)
        return pres
    }
}

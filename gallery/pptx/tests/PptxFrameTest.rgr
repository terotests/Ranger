; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxFrameTest — the deck viewer stops drawing its own chrome.
; ==============================================================================
;
; There was a third toolbar here, and it was the least of the three: a dark
; rectangle and one string — the deck name, the slide numbers and a pair of
; arrow characters — assembled out of raw EVGDrawCmds inside the view. It was
; in a style nothing else used, nothing else could reuse it, and a fix to the
; spreadsheet's strip never reached it.
;
; It has the shared one now, with the shared window layer and the shared
; command table behind it. What this checks is that they are the SHARED ones
; and that they work: the strip is an `EVGToolbar` carrying the shared icon
; numbers, its buttons name commands the table has heard of, clicking one turns
; the slide, the picker is an `EVGWindow`, and a press lands on the window
; before it lands on the slide underneath.
;
;   npm run pptx:frame:test
; ==============================================================================

Import "../src/PptxApp.rgr"

class FrameCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }
}

class PptxFrameTest {
    sfn build:PptxApp () {
        def app:PptxApp (new PptxApp)
        app.init("gallery/pdf_writer/assets/fonts")
        app.resize(960 720)
        if ((app.loadParts("gallery/pptx/fixtures" "04-multi.pptx")) == false) {
            print "  could not open the fixture"
        }
        return app
    }

    ; A one-run label in a box of a stated width, naming Calibri — which is
    ; what the decks that show this up actually contain.
    sfn labelShape:PptxShape (text:string sizePt:double widthPt:double) {
        def sh (new PptxShape())
        sh.width = widthPt
        sh.height = 40.0
        sh.hasText = true
        def para (new PptxParagraph())
        def run (new PptxTextRun())
        run.text = text
        run.fontSizePt = sizePt
        run.fontFamily = "Calibri"
        push para.runs run
        push sh.text.paragraphs para
        return sh
    }

    sfn setFamily:void (sh:PptxShape fam:string) {
        def para:PptxParagraph (itemAt sh.text.paragraphs 0)
        def run:PptxTextRun (itemAt para.runs 0)
        run.fontFamily = fam
    }

    ; Lengthen the open deck until it has `want` slides, by repeating the ones
    ; it already has. The panel only scrolls when there are more thumbnails
    ; than fit, and the fixtures are all short.
    ; A wheel or a two-finger swipe at a point, in the browser's own units:
    ; pixels of travel, positive right and positive down. The negation X takes
    ; on the way into `UIInput` is part of what this checks, so it is done here
    ; exactly as the web binding does it rather than skipped.
    sfn wheelAt:void (app:PptxApp x:int y:int dx:int dy:int) {
        def input (new UIInput)
        input.newFrame()
        input.setPointerPos(x y)
        input.addScroll(dy)
        input.addScrollX((0 - dx))
        app.update(input)
    }

    sfn padSlides:void (app:PptxApp want:int) {
        def have:int (array_length app.presentation.slides)
        if (have <= 0) {
            return
        }
        def i:int have
        while (i < want) {
            def src:PptxSlide (itemAt app.presentation.slides (i % have))
            push app.presentation.slides src
            i = (i + 1)
        }
    }

    ; Decimal codepoints to a string, so a test reads as what it tests and
    ; encodes the same way on both targets.
    sfn cps:string (spec:string) {
        def out:string ""
        def cur:int 0
        def any:boolean false
        def i:int 0
        while (i < (strlen spec)) {
            def ch:int (charAt spec i)
            if (ch == 32) {
                if any {
                    out = (out + (EVGCodepoint.toStr(cur)))
                }
                cur = 0
                any = false
            } {
                cur = ((cur * 10) + (ch - 48))
                any = true
            }
            i = (i + 1)
        }
        if any {
            out = (out + (EVGCodepoint.toStr(cur)))
        }
        return out
    }

    sfn countText:int (dl:EVGDisplayList want:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds i)
            if (cmd.kind == 3) {
                if (cmd.text == want) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    sfn indexOfCommand:int (app:PptxApp id:string) {
        def i:int 0
        while (i < (app.toolbar.count())) {
            def t:ToolItem (app.toolbar.at(i))
            if (t.command == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn click:void (app:PptxApp x:int y:int) {
        app.pointer(x y true true false)
        app.pointer(x y false false true)
    }

    sfn main:void () {
        def c:FrameCheck (new FrameCheck)
        print "== PptxFrameTest =="

        def app:PptxApp (PptxFrameTest.build())
        c.ok("a deck is open" ((app.slideCount()) > 1))

        print "-- the strip is the shared one --"
        c.ok("it has buttons" ((app.toolbar.count()) > 5))
        def ni:int (PptxFrameTest.indexOfCommand(app "slide.next"))
        c.ok("next is one of them" (ni >= 0))
        def nt:ToolItem (app.toolbar.at(ni))
        ; It used to be enough to say "the same icon as Redo": every arrow in
        ; the catalogue WAS the redo arrow, which is exactly the reason the
        ; strip was hard to read. Now that Next has its own, the check says
        ; what it always meant — the button draws from the shared catalogue
        ; rather than from a picture the deck viewer keeps to itself.
        c.eqInt("drawn with the shared next-slide icon" nt.icon (ToolIcon.navNext()))
        c.ok("the strip is as tall as it needs" (app.toolbarH == (app.toolbar.heightFor(960))))
        ; And the slide is given the room that is left, not the whole window —
        ; the strip and the status line above and below it, the notes strip
        ; under it, the slide panel beside it.
        c.eqInt("the fit-to-window scale keeps the frame clear" app.view.chromeH ((app.toolbarH + app.statusH) + (app.notesHeight())))
        c.eqInt("and the panel's width with it" app.view.chromeW (app.panelWidth()))

        print "-- every button names a command the app answers --"
        def i:int 0
        def unknown:int 0
        while (i < (app.toolbar.count())) {
            def t:ToolItem (app.toolbar.at(i))
            ; A dropdown runs nothing itself: pressing it opens its list,
            ; and the ENTRIES under it are what carry commands. Those entries
            ; live in this same array, so they are still swept here — only
            ; the button that opens them is exempt.
            if ((t.isSeparator == false) && (t.isMenu == false)) {
                if ((app.commands.has(t.command)) == false) {
                    unknown = (unknown + 1)
                    print ("    no command for " + t.command)
                }
            }
            i = (i + 1)
        }
        c.eqInt("no button runs a command the table has never heard of" unknown 0)

        print "-- and clicking one turns the slide --"
        c.eqInt("on the first slide" app.index 0)
        def bx:int (nt.x + (idiv nt.w 2))
        def by:int (nt.y + (idiv nt.h 2))
        PptxFrameTest.click(app bx by)
        c.eqInt("clicking Next moved on" app.index 1)
        def pi:int (PptxFrameTest.indexOfCommand(app "slide.prev"))
        def pt:ToolItem (app.toolbar.at(pi))
        PptxFrameTest.click(app (pt.x + (idiv pt.w 2)) (pt.y + (idiv pt.h 2)))
        c.eqInt("and Previous came back" app.index 0)
        c.ok("last runs" (app.runCommand("slide.last" "")))
        c.eqInt("and lands on the last one" app.index ((app.slideCount()) - 1))
        c.ok("goto runs" (app.runCommand("slide.goto" "1")))
        c.eqInt("where it was told" app.index 1)

        print "-- the picker is a window --"
        def w:PptxApp (PptxFrameTest.build())
        c.ok("no argument opens it" (w.runCommand("slide.pick" "")))
        c.ok("and it is up" w.slideDialog.visible)
        ; Choosing a slide in it is a click in the window layer.
        ; The last slide, whatever this deck has — the picker lists one entry
        ; per slide, so its id is the slide's own number.
        def lastIdx:int ((w.slideCount()) - 1)
        def wantId:int (1601 + lastIdx)
        def ctrl:EVGControl (w.slideDialog.controlById(wantId))
        c.eqInt("the picker lists the slides" ctrl.id wantId)
        w.slideDialog.handlePointer((w.slideDialog.x + ctrl.x + 4) (w.slideDialog.y + ctrl.y + 4) true true false)
        w.pollDialogs()
        c.eqInt("picking one goes there" w.index lastIdx)

        print "-- and a press goes to the window before the slide --"
        def p:PptxApp (PptxFrameTest.build())
        p.runCommand("slide.pick" "")
        def before:int p.index
        ; The right third of the window is "next slide" when the press reaches
        ; the slide; inside an open picker it must not.
        def taken:boolean (p.pointer((p.slideDialog.x + 6) (p.slideDialog.y + 6) true true false))
        c.ok("the window took it" taken)
        c.eqInt("and the slide did not turn" p.index before)

        print "-- the frame draws, and the old chrome is gone --"
        def d:PptxApp (PptxFrameTest.build())
        def dl:EVGDisplayList (d.buildFrame())
        c.ok("there is a picture" ((array_length dl.cmds) > 20))
        ; The status line says what the old band said, in the shared palette.
        def texts:int 0
        def arrows:int 0
        def ti:int 0
        while (ti < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds ti)
            if (cmd.kind == 3) {
                texts = (texts + 1)
                if ((indexOf cmd.text "←") >= 0) {
                    arrows = (arrows + 1)
                }
            }
            ti = (ti + 1)
        }
        c.ok("with text in it" (texts > 1))
        c.eqInt("and no hand-rolled arrow band" arrows 0)
        ; The slide was moved under the strip rather than drawn over it.
        def high:int 0
        def si:int 0
        while (si < (array_length dl.cmds)) {
            def cmd2:EVGDrawCmd (itemAt dl.cmds si)
            if (cmd2.kind == 2) {
                if (cmd2.y < (to_double d.toolbarH)) {
                    high = (high + 1)
                }
            }
            si = (si + 1)
        }
        c.eqInt("no slide picture is drawn over the toolbar" high 0)
        def js:string (d.sceneJson())
        c.ok("the scene is the frame, not the slide alone" ((strlen js) > 200))

        ; --- emoji ------------------------------------------------------------
        ;
        ; A text face has no emoji glyphs, so a codepoint it cannot draw comes
        ; out as `.notdef` — a filled circle, which is what a deck with a 😆 in
        ; it was showing. The fix was two things: an emoji face loaded for
        ; fallback, and the rasterizer actually being GIVEN the manager that
        ; knows which face has which codepoint.
        print "-- the chrome at the size it is being shown --"
        ; A deck editor on a phone is the same program as on a desktop and the
        ; difference is entirely numbers. They come from a stylesheet with
        ; `@media` in it, so a host can change the breakpoints without
        ; patching the app — and so there is ONE definition of "small screen"
        ; rather than one per caller.
        def rsp:PptxApp (PptxFrameTest.build())
        rsp.resize(1280 800)
        c.eqInt("a desktop keeps the full slide list" (rsp.panelWidth()) 150)
        c.ok("and the notes" ((rsp.notesHeight()) > 0))
        c.eqInt("with mouse-sized buttons" rsp.toolbar.iconW 30)

        rsp.resize(820 700)
        c.eqInt("a tablet narrows the list" (rsp.panelWidth()) 96)
        c.ok("but keeps the notes" ((rsp.notesHeight()) > 0))

        rsp.resize(390 844)
        ; A phone turns the column into a strip across the top: a phone is
        ; narrow and tall, and a column spends the dimension there is least
        ; of — which is the one the slide needs, because a slide is wider
        ; than it is tall.
        c.ok("a phone puts the deck on top" (rsp.panelOnTop()))
        c.eqInt("so it takes nothing out of the width" (rsp.panelWidth()) 0)
        c.ok("and takes its room out of the height instead" ((rsp.panelHeight()) > 0))
        ; The thumbnails now run left to right, and the strip is as tall as
        ; one of them plus its number.
        c.ok("the thumbnails run across" ((rsp.panelThumbXAt(1)) > (rsp.panelThumbXAt(0))))
        c.eqInt("all on the same line" (rsp.panelThumbYAt(1)) (rsp.panelThumbYAt(0)))
        c.ok("and a thumbnail is wider than it is tall" ((rsp.panelThumbW()) > (rsp.panelThumbH())))
        ; A press still picks the slide it looks like it would.
        def last:int ((rsp.slideCount()) - 1)
        def hitX:int ((rsp.panelThumbXAt(last)) + (idiv (rsp.panelThumbW()) 2))
        def hitY:int ((rsp.panelThumbYAt(last)) + (idiv (rsp.panelThumbH()) 2))
        c.ok("the deck has more than one slide to test with" (last > 0))
        c.eqInt("a press in the strip finds the slide under it" (rsp.panelSlideAt(hitX hitY)) last)
        ; …and a press below the strip is the slide, not the deck.
        c.eqInt("below the strip is not the deck any more"
                (rsp.panelSlideAt(hitX ((rsp.toolbarH + (rsp.panelHeight())) + 10))) (0 - 1))
        ; The slide starts under the strip rather than beside it.
        c.ok("the slide is drawn below the strip" ((rsp.slideOriginY()) >= (to_double (rsp.toolbarH + (rsp.panelHeight())))))
        c.ok("and starts at the left edge" ((rsp.slideOriginX()) < 40.0))
        ; Height is what a phone has least of, and the notes are the least
        ; useful thing to spend it on.
        c.eqInt("and folds the notes away" (rsp.notesHeight()) 0)
        ; What folding the notes away buys: the height they were taking is
        ; the slide's now.
        def freeH:int ((rsp.H - rsp.toolbarH) - rsp.statusH)
        c.ok("leaving the slide the tallest thing on screen" (freeH > (idiv rsp.H 2)))

        ; Nothing about a window's WIDTH says what is pointing at it: a laptop
        ; with a touchscreen is wide and coarse at once.
        rsp.resize(1280 800)
        c.eqInt("a wide window with a mouse keeps small chips" rsp.toolbar.iconW 30)
        rsp.setCoarsePointer(true)
        c.eqInt("a wide window with a FINGER gets 44px ones" rsp.toolbar.iconW 44)
        rsp.setCoarsePointer(false)
        c.eqInt("and back" rsp.toolbar.iconW 30)

        ; A host with different ideas replaces the sheet rather than the app.
        rsp.setChromeCss(".slide-panel { width: 210px } .notes { height: 40px }")
        rsp.resize(1280 800)
        c.eqInt("a host can state its own chrome" (rsp.panelWidth()) 210)
        c.eqInt("including the notes" (rsp.notesHeight()) 40)
        ; …and with no breakpoints in it, a phone gets the same numbers,
        ; because the host said so.
        rsp.resize(390 844)
        c.eqInt("with no breakpoints, a phone gets what it asked for" (rsp.panelWidth()) 210)

        print "-- a box sized for a font we do not have --"
        ; A deck names Calibri; we draw Open Sans, which is wider; a label the
        ; author sized to fit came out on two lines. The layout shrinks a body
        ; whose face was substituted just enough to fit, and only by a little —
        ; a paragraph that really wraps has to keep wrapping.
        def fd:PptxApp (PptxFrameTest.build())
        def conv:PptxToEvg fd.view.converter
        c.ok("the face this deck asks for is not one we have"
             ((conv.measure.hasFamily("Calibri")) == false))
        c.ok("and the face we draw with is" (conv.measure.hasFamily("Open Sans")))
        def tight:PptxShape (PptxFrameTest.labelShape("Urheiijat" 18.0 85.05))
        def snug:double (conv.substituteFit(tight.text (conv.ptToPx((85.05 - 14.4))) ((96.0 / 72.0) * conv.scale)))
        c.ok("a label that just overflows is brought in" (snug < 1.0))
        c.ok("and only just" (snug > 0.9))
        def roomy:PptxShape (PptxFrameTest.labelShape("Haku" 18.0 85.05))
        def none:double (conv.substituteFit(roomy.text (conv.ptToPx((85.05 - 14.4))) ((96.0 / 72.0) * conv.scale)))
        c.ok("a label that already fits is left alone" (none == 1.0))
        def prose:PptxShape (PptxFrameTest.labelShape("a paragraph long enough that it truly has to wrap onto several lines whatever face draws it" 18.0 85.05))
        def big:double (conv.substituteFit(prose.text (conv.ptToPx((85.05 - 14.4))) ((96.0 / 72.0) * conv.scale)))
        c.ok("and text that really wraps still wraps" (big == 1.0))
        def ours:PptxShape (PptxFrameTest.labelShape("Urheiijat" 18.0 85.05))
        PptxFrameTest.setFamily(ours "Open Sans")
        def kept:double (conv.substituteFit(ours.text (conv.ptToPx((85.05 - 14.4))) ((96.0 / 72.0) * conv.scale)))
        c.ok("a deck whose font we DO have is measured as it stands" (kept == 1.0))

        print "-- emoji come from a face that has them --"
        def emoji:string (EVGCodepoint.toStr(128518))
        def tr:UITextRenderer d.view.ctx.tr
        def emW:double (tr.measureWidth(emoji 32.0))
        c.ok("an emoji measures as a real glyph" (emW > 20.0))
        ; `.notdef` in Open Sans is a rectangle of the same width as a digit —
        ; the emoji face's own advance is wider than that, so the two cannot be
        ; confused.
        def digitW:double (tr.measureWidth("0" 32.0))
        c.ok("and not as the primary face's notdef" (emW > (digitW * 1.5)))
        ; A codepoint NOTHING has must still not reach the glyph tables of an
        ; unloaded face: it draws notdef from the primary, and does not throw.
        def weird:string (EVGCodepoint.toStr(984567))
        def wW:double (tr.measureWidth(weird 32.0))
        c.ok("a codepoint no face has still measures" (wW >= 0.0))
        def probe:EVGDisplayList (new EVGDisplayList)
        probe.addText(("a" + emoji + "b" + weird) 10.0 40.0 32.0 (EVGColor.rgb(0 0 0)) "Open Sans" false false 400.0 40.0)
        d.view.paintSoftCanvas(probe)
        c.ok("and drawing it does not fall over" true)

        print "-- the panel follows the slide the reader is on --"
        ; Twenty slides into the Varusteleka deck the panel was still showing
        ; the first seven: `gotoSlide` asked the panel to scroll itself, and
        ; `nextSlide`/`prevSlide` — the arrow keys and the two buttons on the
        ; strip — did not. The reader turned pages and the left edge sat
        ; still, so the highlighted thumbnail was somewhere off the bottom.
        ;
        ; The fix does not patch the three call sites; it records which slide
        ; the panel last scrolled itself to and checks that where the panel is
        ; PAINTED, which covers every way the index can change. These checks
        ; are written against `nextSlide` for that reason: it is the path that
        ; never asked.
        def f:PptxApp (PptxFrameTest.build())
        PptxFrameTest.padSlides(f 24)
        c.ok("a deck long enough to scroll the panel" ((f.slideCount()) >= 24))
        def bottom:int (f.H - f.statusH)
        c.ok("and longer than the panel is tall" ((f.panelMaxScroll()) > 0))
        f.buildFrame()
        c.eqInt("the panel starts at the top" f.panelScroll 0)

        def steps:int 0
        while (steps < 18) {
            f.nextSlide()
            steps = (steps + 1)
        }
        c.eqInt("eighteen presses of Next" f.index 18)
        ; Before the frame is built nothing has scrolled — the panel follows
        ; when it is painted, not when the index moves.
        def hidden:int (f.panelThumbY(18))
        c.ok("and slide 19's thumbnail is off the bottom" ((hidden + (f.panelThumbH())) > bottom))
        f.buildFrame()
        def shown:int (f.panelThumbY(18))
        c.ok("painting the frame brought it into view" (shown >= f.toolbarH))
        c.ok("wholly into view" ((shown + (f.panelThumbH())) <= bottom))

        ; Going back up follows too — the thumbnail above the viewport is as
        ; invisible as the one below it. Sending the panel to its very bottom
        ; first is what makes this check mean something: slide 3's thumbnail
        ; is then well above the top edge, so only a panel that actually
        ; scrolls itself back can show it.
        f.scrollPanelPixels(10000)
        c.eqInt("the panel is at its bottom" f.panelScroll (f.panelMaxScroll()))
        def back:int 0
        while (back < 16) {
            f.prevSlide()
            back = (back + 1)
        }
        f.buildFrame()
        def upper:int (f.panelThumbY(2))
        c.ok("and Previous brings the panel back up" (upper >= f.toolbarH))
        c.ok("with the thumbnail whole" ((upper + (f.panelThumbH())) <= bottom))

        ; But a reader who scrolls the panel BY HAND is left alone. Scrolling
        ; does not change the index, so nothing pulls the panel back to the
        ; selected slide on the next frame — which is what calling
        ; `ensureSlideVisible` on every frame would have done, and would have
        ; made the panel impossible to browse.
        f.scrollPanelPixels((0 - 10000))
        c.eqInt("from the top of the panel" f.panelScroll 0)
        f.scrollPanelPixels(120)
        c.eqInt("a hand scroll moves it" f.panelScroll 120)
        f.buildFrame()
        c.eqInt("and the next frame leaves it where the reader put it" f.panelScroll 120)

        print "-- two fingers over the thumbnails, in either layout --"
        ; The wheel arrives with a POSITION, and the app decides from it
        ; whether the gesture belongs to the thumbnails. It used to decide by
        ; asking whether x was left of `panelWidth()` — and `panelWidth()`
        ; answers 0 when the panel is a strip along the TOP rather than a
        ; column down the side, which is the layout every narrow window gets.
        ; So on a narrow window the test read `x < 0`, never true, and the
        ; thumbnails could not be scrolled at all. Reported as "two fingers on
        ; the trackpad do not move the thumbnails".
        ;
        ; Both layouts, through `update` with a pointer position, because that
        ; is the path a browser takes — calling `scrollPanelPixels` directly
        ; is the one part of it that was never broken.
        def wide:PptxApp (PptxFrameTest.build())
        wide.resize(1280 800)
        PptxFrameTest.padSlides(wide 40)
        wide.buildFrame()
        c.ok("the column layout" ((wide.panelWidth()) > 0))
        c.ok("with somewhere to scroll" ((wide.panelMaxScroll()) > 0))
        def w0:int wide.panelScroll
        PptxFrameTest.wheelAt(wide (idiv (wide.panelWidth()) 2) (idiv wide.H 2) 0 120)
        c.ok("a wheel over the column scrolls it" (wide.panelScroll > w0))
        ; …and one over the SLIDE does not: the gesture belongs to whatever is
        ; under it, and swallowing every wheel would make the panel jump
        ; whenever a reader scrolled anywhere.
        def w1:int wide.panelScroll
        PptxFrameTest.wheelAt(wide ((wide.panelWidth()) + 200) (idiv wide.H 2) 0 120)
        c.eqInt("but one over the slide does not" wide.panelScroll w1)

        ; The narrow window: the panel is a strip along the top, and
        ; `panelWidth()` is 0 there by design.
        def tall:PptxApp (PptxFrameTest.build())
        tall.resize(420 820)
        PptxFrameTest.padSlides(tall 40)
        tall.buildFrame()
        c.ok("the strip layout" (tall.panelOnTop()))
        c.eqInt("takes nothing out of the width" (tall.panelWidth()) 0)
        c.ok("and has somewhere to scroll" ((tall.panelMaxScroll()) > 0))
        def stripY:int (tall.toolbarH + (idiv (tall.panelHeight()) 2))
        def t0:int tall.panelScroll
        PptxFrameTest.wheelAt(tall 200 stripY 0 120)
        c.ok("a wheel over the strip scrolls it" (tall.panelScroll > t0))
        ; A strip runs across, so a SIDEWAYS swipe has to move it too — that is
        ; the gesture a reader makes at a horizontal row of pictures, and the
        ; only one a trackpad reports as deltaX.
        def t1:int tall.panelScroll
        PptxFrameTest.wheelAt(tall 200 stripY 120 0)
        c.ok("and so does a sideways one" (tall.panelScroll > t1))
        ; Both the same way along the deck. Sideways travel is negated once on
        ; its way in — `UIInput` counts X positive LEFTWARDS — and a sign got
        ; wrong there would scroll the strip backwards rather than not at all.
        def t2:int tall.panelScroll
        PptxFrameTest.wheelAt(tall 200 stripY (0 - 240) 0)
        c.ok("a swipe the other way goes back" (tall.panelScroll < t2))
        ; And a wheel below the strip is the slide's, not the panel's.
        def t3:int tall.panelScroll
        PptxFrameTest.wheelAt(tall 200 (tall.toolbarH + (tall.panelHeight()) + 200) 0 120)
        c.eqInt("a wheel under the strip is not the panel's" tall.panelScroll t3)

        print "-- the thumbnails are their own list, and hold still --"
        ; The panel is most of a frame and almost never differs from the frame
        ; before it. On the six-slide chart deck it is 7,500 of the frame's
        ; 9,400 commands, and dragging a shape changes none of them — yet every
        ; one was re-encoded across the bridge and re-decoded in JavaScript on
        ; every pointer move. Measured on the code-editor page: 11.5 ms of
        ; encode and decode a frame, down to 4.7 once the panel came out.
        ;
        ; So the frame can be had without the panel, the panel on its own, and
        ; `panelStamp` says whether last frame's panel will still do.
        def sp:PptxApp (PptxFrameTest.build())
        sp.resize(1280 800)
        PptxFrameTest.padSlides(sp 40)
        def whole:EVGDisplayList (sp.buildFrame())
        def scene:EVGDisplayList (sp.buildSceneFrame())
        def strip:EVGDisplayList (sp.buildPanelFrame())
        c.ok("the panel is worth taking out" ((array_length strip.cmds) > (array_length scene.cmds)))
        ; Nothing lost and nothing drawn twice: the two lists are the frame.
        c.eqInt("the two lists are the whole frame"
                ((array_length scene.cmds) + (array_length strip.cmds))
                (array_length whole.cmds))
        ; And `buildFrame` is unchanged for everything that never asked —
        ; the flag it turns off has to come back on.
        def again:EVGDisplayList (sp.buildFrame())
        c.eqInt("asking for the frame again gives the whole frame" (array_length again.cmds) (array_length whole.cmds))

        ; The stamp is the whole point: same string, same picture.
        def st0:string (sp.panelStamp())
        c.ok("the stamp says something" ((strlen st0) > 0))
        sp.buildSceneFrame()
        c.ok("and does not change from being asked twice" ((sp.panelStamp()) == st0))
        ; Turning a slide changes it — the ring moves, and on a long deck the
        ; panel scrolls.
        sp.gotoSlide(20)
        sp.buildSceneFrame()
        c.ok("turning the page changes it" ((sp.panelStamp()) != st0))
        ; …and so does editing a slide, because a thumbnail is keyed by its
        ; slide's revision. A stamp that missed this would leave a stale
        ; picture of a slide the reader had just changed.
        def st1:string (sp.panelStamp())
        def edited:PptxSlide (itemAt sp.presentation.slides 20)
        edited.revision = (edited.revision + 1)
        c.ok("and so does editing a slide" ((sp.panelStamp()) != st1))
        ; But moving a shape on the slide the reader is looking at does NOT,
        ; until the edit is recorded — which is what makes a drag cheap.
        def st2:string (sp.panelStamp())
        sp.buildSceneFrame()
        c.ok("a frame on its own leaves it alone" ((sp.panelStamp()) == st2))

        print "-- a slide added from a script is scrolled to --"
        ; Everything that moves the current slide from the EDITOR's side comes
        ; through `syncFromEditor`: adding a slide, undoing one, and every call
        ; an API script makes. It set the index and left the panel alone, so a
        ; script that appended a slide to a deck of forty left the status line
        ; saying "41" with the thumbnails still showing one to eight — which
        ; reads as the script having done nothing at all.
        def api:PptxApp (PptxFrameTest.build())
        PptxFrameTest.padSlides(api 40)
        api.buildFrame()
        c.eqInt("the panel starts at the top of a long deck" api.panelScroll 0)
        api.editor.slideIndex = 33
        api.syncFromEditor()
        c.eqInt("the app follows the editor" api.index 33)
        c.ok("and so does the panel, before anything is painted" (api.panelScroll > 0))
        def seen:int (api.panelThumbY(33))
        c.ok("the slide's own thumbnail is in view" (seen >= api.toolbarH))
        c.ok("wholly so" ((seen + (api.panelThumbH())) <= (api.H - api.statusH)))

        print "-- a hover asks for the frame to be drawn again --"
        ; The hosts redraw when `pointer` says true, and a bare move over the
        ; strip said false. The hot item changed, the pill and the tooltip
        ; were computed correctly from it, and nothing ever painted them: the
        ; strip read as having no hover and no tooltips at all.
        def hv:PptxApp (PptxFrameTest.build())
        hv.buildFrame()
        def hbi:int (PptxFrameTest.indexOfCommand(hv "slide.next"))
        def hb:ToolItem (hv.toolbar.at(hbi))
        def hx:int (hb.x + (idiv hb.w 2))
        def hy:int (hb.y + (idiv hb.h 2))
        c.eqInt("nothing is hot to begin with" hv.toolbar.hot -1)
        def moved:boolean (hv.pointer(hx hy false false false))
        c.ok("moving onto a button asks for a repaint" moved)
        c.ok("and lights it up" (hv.toolbar.hot >= 0))
        c.eqStr("the tooltip is that button's name" (hv.toolbar.hotLabel()) hb.label)
        ; Staying on it does not ask again — a repaint per mouse move over one
        ; button is a frame per pixel for nothing.
        def again:boolean (hv.pointer((hx + 1) hy false false false))
        c.ok("staying on it does not ask again" (again == false))
        ; And the tip is in the overlay, so it survives the slide being drawn.
        def hdl:EVGDisplayList (hv.buildFrame())
        def tips:int 0
        def hi:int 0
        while (hi < (array_length hdl.cmds)) {
            def hc:EVGDrawCmd (itemAt hdl.cmds hi)
            if (hc.kind == 3) {
                if (hc.text == hb.label) {
                    tips = (tips + 1)
                }
            }
            hi = (hi + 1)
        }
        c.eqInt("and the frame carries the tooltip" tips 1)
        ; Moving off asks once more, so the pill goes out again.
        def off:boolean (hv.pointer(hx (hv.H - 4) false false false))
        c.ok("moving off asks for a repaint too" off)
        c.eqInt("and nothing is hot" hv.toolbar.hot -1)

        print "-- the notes strip goes through the shared core like everything else --"
        ; It was the one string in the deck viewer that did not.
        ;
        ; The slide's text is reordered and shaped on the way into the display
        ; list; the notes went in raw. That looked RIGHT in the browser,
        ; because `fillText` runs the bidirectional algorithm itself and was
        ; quietly doing the work — and it was wrong everywhere else, because
        ; the software canvas draws the string it is handed. One rule, broken
        ; in one place, hidden by the backend that papered over it.
        ;
        ; Reading a screenshot could not find this: the browser build showed
        ; correct notes over a scrambled slide, and the desktop build the
        ; other way round, so each looked like a different bug.
        def nv:PptxApp (PptxFrameTest.build())
        def note:string (PptxFrameTest.cps("1605 1585 1581 1576 1575"))
        nv.runCommand("notes.set" note)
        def ndl:EVGDisplayList (nv.buildFrame())
        def want:string (OfficeText.forDisplayDir(note -1))
        c.ok("the note is not stored the way it is drawn" ((want == note) == false))
        def raw:int (PptxFrameTest.countText(ndl note))
        def done:int (PptxFrameTest.countText(ndl want))
        c.eqInt("the notes strip draws the reordered text" done 1)
        c.eqInt("and never the stored text" raw 0)

        print ""
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

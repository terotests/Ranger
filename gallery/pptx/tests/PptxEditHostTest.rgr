; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxEditHostTest — the editor as a host reaches it: pointer, keys, overlay
; ==============================================================================
;
; `PptxEditorTest` checks the model operations. This checks the seam above
; them: that a press in window pixels lands on the right shape in slide
; points, that a drag is one history step, that the selection is drawn into
; the same display list as the slide, and that clicking the slide never turns
; the page — which it did, once, and which made the editor unusable: the first
; click on a shape moved the deck out from under it.
;
;   npm run pptx:editor:host:test
; ==============================================================================

Import "../src/PptxApp.rgr"

class EditHostCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }
}

class PptxEditHostTest {
    sfn build:PptxApp () {
        return (PptxEditHostTest.buildDeck("02-shapes.pptx"))
    }

    sfn buildDeck:PptxApp (name:string) {
        def app:PptxApp (new PptxApp)
        app.init("gallery/pdf_writer/assets/fonts")
        app.resize(960 720)
        if ((app.loadParts("gallery/pptx/fixtures" name)) == false) {
            print "  could not open the fixture"
        }
        return app
    }

    ; A one-run label naming a face we do NOT have, in a box the author sized
    ; to fit it — which is what makes the layout shrink it.
    sfn calibriLabel:PptxShape (text:string sizePt:double widthPt:double) {
        def sh (new PptxShape())
        sh.width = widthPt
        sh.height = 40.0
        sh.hasText = true
        def para (new PptxParagraph())
        def run (new PptxTextRun())
        run.text = text
        run.fontSizePt = sizePt
        run.fontFamily = "Calibri"
        push para.runs run
        push sh.text.paragraphs para
        return sh
    }

    sfn screenX:int (app:PptxApp xPt:double) {
        def sc:double (app.ptScale())
        return (to_int ((xPt * sc) + (app.slideOriginX())))
    }

    sfn screenY:int (app:PptxApp yPt:double) {
        def sc:double (app.ptScale())
        def v:double ((yPt * sc) + (app.slideOriginY()))
        return (to_int v)
    }

    sfn firstShape:PptxShape (app:PptxApp) {
        def shapes:[PptxShape] (app.editor.editableShapes())
        return (itemAt shapes 0)
    }

    sfn dist:double (x0:double y0:double x1:double y1:double) {
        def dx:double (x1 - x0)
        def dy:double (y1 - y0)
        return (sqrt ((dx * dx) + (dy * dy)))
    }

    sfn numbered:void (body:PptxTextBody level:int text:string) {
        def para (new PptxParagraph())
        para.level = level
        para.hasBullet = true
        para.bulletAutoNum = true
        def run (new PptxTextRun())
        run.text = text
        push para.runs run
        push body.paragraphs para
    }

    sfn indexOfCommand:int (app:PptxApp id:string) {
        def i:int 0
        while (i < (app.toolbar.count())) {
            def t:ToolItem (app.toolbar.at(i))
            if (t.command == id) {
                return i
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    sfn countRotated:int (dl:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (dl.count())) {
            def c:EVGDrawCmd (dl.at(i))
            if ((c.rotate > 0.001) || (c.rotate < -0.001)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn countFlipped:int (dl:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (dl.count())) {
            def c:EVGDrawCmd (dl.at(i))
            if (c.kind == 2) {
                if (c.flipH) {
                    n = (n + 1)
                }
                if (c.flipV) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    sfn copyOf:buffer (src:buffer) {
        def n:int (buffer_length src)
        def out:buffer (buffer_alloc n)
        def i:int 0
        while (i < n) {
            buffer_set out i (buffer_get src i)
            i = (i + 1)
        }
        return out
    }

    sfn sameBytes:boolean (a:buffer b:buffer) {
        def n:int (buffer_length a)
        if (n != (buffer_length b)) {
            return false
        }
        def i:int 0
        while (i < n) {
            if ((buffer_get a i) != (buffer_get b i)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; How many of the current slide's shapes the show would draw right now —
    ; a build hides the ones whose step has not been reached.
    sfn visibleCount:int (app:PptxApp) {
        def slide@(optional):PptxSlide (app.currentSlide())
        if (null? slide) {
            return 0
        }
        def s:PptxSlide (unwrap slide)
        def n:int 0
        def i:int 0
        while (i < (array_length s.shapes)) {
            if (app.editor.shapeVisibleAt(s (itemAt s.shapes i) app.presentStep)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn near:boolean (a:double b:double tol:double) {
        def d:double (fabs (a - b))
        return (d < tol)
    }

    sfn main:void () {
        def c (new EditHostCheck)
        print "=== PptxEditHostTest ==="

        print "-- the strip carries the editing commands --"
        def app:PptxApp (PptxEditHostTest.build())
        def wanted:[string] ([] _:string ( "edit.toggle" "edit.undo" "edit.redo" "edit.delete" "shape.rect" "text.add" "edit.group" "edit.align.left" "slide.add" ))
        def missing:int 0
        def unknown:int 0
        def wi:int 0
        while (wi < (array_length wanted)) {
            def id:string (itemAt wanted wi)
            def found:boolean false
            def i:int 0
            while (i < (app.toolbar.count())) {
                def t:ToolItem (app.toolbar.at(i))
                if (t.command == id) {
                    found = true
                }
                i = (i + 1)
            }
            if (found == false) {
                missing = (missing + 1)
            }
            if ((app.commands.has(id)) == false) {
                unknown = (unknown + 1)
            }
            wi = (wi + 1)
        }
        c.ok("every editing button is on the strip" (missing == 0))
        c.ok("and the command table has heard of them all" (unknown == 0))
        ; Two buttons with one picture is a strip nobody can read. The deck's
        ; had five such pairs, every one of them an icon borrowed from the
        ; spreadsheet for a command that has nothing to do with it.
        def dup:int (app.toolbar.duplicateIcon())
        c.ok(("no two commands share an icon (found " + ((to_string dup) + ")")) (dup == 0))

        print "-- edit mode is a mode, and the deck opens in it --"
        c.ok("a deck opens ready to edit" app.editMode)
        c.ok("and the strip says so" app.toolbar.editOn)
        c.ok("the toggle is a command" (app.runCommand("edit.toggle" "")))
        c.ok("editing can be turned off" (app.editMode == false))
        app.runCommand("edit.toggle" "")
        c.ok("and back on" app.editMode)

        print "-- a click in the slide picks a shape up --"
        def app2:PptxApp (PptxEditHostTest.build())
        def sh:PptxShape (PptxEditHostTest.firstShape(app2))
        def cxPt:double (sh.x + (sh.width * 0.5))
        def cyPt:double (sh.y + (sh.height * 0.5))
        def px:int (PptxEditHostTest.screenX(app2 cxPt))
        def py:int (PptxEditHostTest.screenY(app2 cyPt))
        app2.pointer(px py true true false)
        c.ok("the press selected something" ((app2.editor.selectionCount()) == 1))
        c.ok("and it is the shape that was under it" (app2.editor.isSelected(sh.editId)))
        app2.pointer(px py false false true)
        c.ok("a first click does not start typing" ((app2.editor.isEditingText()) == false))

        print "-- clicking the shape again puts a caret in it --"
        ; The complaint this answers: clicking and double-clicking a text box
        ; did nothing, because the only ways in were F2, Enter and the command.
        ; A double click reaches this too — its second release is a click on a
        ; shape the first one already selected.
        app2.pointer(px py true true false)
        app2.pointer(px py false false true)
        c.ok("the second click starts typing" (app2.editor.isEditingText()))
        c.ok("in the shape that was clicked" (app2.editor.isSelected(sh.editId)))
        def before:int (strlen (sh.text.plainText()))
        app2.editor.typeAtCaret("Z")
        c.ok("and what is typed lands in it" ((strlen (sh.text.plainText())) == (before + 1)))
        ; And it lands where the click did, not at the end: a click near the
        ; left edge of the text gives an earlier column than one near the
        ; right edge. This is the part that makes clicking worth doing.
        def leftX:int (PptxEditHostTest.screenX(app2 (sh.x + (sh.width * 0.05))))
        def rightX:int (PptxEditHostTest.screenX(app2 (sh.x + (sh.width * 0.9))))
        def topY:int (PptxEditHostTest.screenY(app2 (sh.y + (sh.height * 0.2))))
        def atLeft:PptxTextPos (app2.caretFromPoint(sh leftX topY))
        def atRight:PptxTextPos (app2.caretFromPoint(sh rightX topY))
        c.ok("a click on the left of a line comes before one on the right" (atLeft.col < atRight.col))
        app2.editor.endTextEdit()

        print "-- a selection turns as one thing --"
        ; Turning every shape by the same angle about its own centre leaves
        ; them all where they were and spins each in place: on screen a group
        ; came apart instead of turning. A selection turns about the
        ; selection's centre.
        def ra:PptxApp (PptxEditHostTest.build())
        def rs:[PptxShape] (ra.editor.editableShapes())
        if ((array_length rs) >= 2) {
            def s1:PptxShape (itemAt rs 0)
            def s2:PptxShape (itemAt rs 1)
            ra.editor.select(s1.editId)
            ra.editor.addToSelection(s2.editId)
            def bnd:PptxEditRect (ra.editor.selectionBounds())
            def pcx:double (bnd.midX())
            def pcy:double (bnd.midY())
            def ax0:double (s1.x + (s1.width * 0.5))
            def ay0:double (s1.y + (s1.height * 0.5))
            def s2x0:double (s2.x + (s2.width * 0.5))
            def s2y0:double (s2.y + (s2.height * 0.5))
            def far0:double (PptxEditHostTest.dist(ax0 ay0 pcx pcy))
            c.ok("the two shapes are not both at the centre" (far0 > 1.0))
            c.ok("the selection can be turned" (ra.editor.rotateSelection(90.0)))
            def ax1:double (s1.x + (s1.width * 0.5))
            def ay1:double (s1.y + (s1.height * 0.5))
            c.ok("the shape moved, rather than spinning where it stood"
                 ((PptxEditHostTest.dist(ax1 ay1 ax0 ay0)) > 1.0))
            c.ok("and it is the same distance from the centre it turned about"
                 (PptxEditHostTest.near((PptxEditHostTest.dist(ax1 ay1 pcx pcy)) far0 0.01)))
            c.ok("its own angle went round with it" (PptxEditHostTest.near(s1.rotation 90.0 0.001)))
            ; The group did not come apart: the two shapes are still the same
            ; distance from each other. (Their axis-aligned bounding box is
            ; NOT preserved by a rotation and is not the thing to check.)
            def bx0:double (s2.x + (s2.width * 0.5))
            def by0:double (s2.y + (s2.height * 0.5))
            c.ok("and the shapes kept their distance from each other"
                 (PptxEditHostTest.near((PptxEditHostTest.dist(ax1 ay1 bx0 by0))
                                        (PptxEditHostTest.dist(ax0 ay0 s2x0 s2y0)) 0.01)))
            ; A quarter turn four times is where it started.
            ra.editor.rotateSelection(90.0)
            ra.editor.rotateSelection(90.0)
            ra.editor.rotateSelection(90.0)
            def ax4:double (s1.x + (s1.width * 0.5))
            def ay4:double (s1.y + (s1.height * 0.5))
            c.ok("four quarter turns come back to the start"
                 (PptxEditHostTest.near((PptxEditHostTest.dist(ax4 ay4 ax0 ay0)) 0.0 0.01)))
            ; One shape still turns about itself, which is what its handle says.
            ra.editor.select(s1.editId)
            def solo0:double (s1.x + (s1.width * 0.5))
            ra.editor.rotateSelection(45.0)
            c.ok("one shape on its own still turns where it stands"
                 (PptxEditHostTest.near((s1.x + (s1.width * 0.5)) solo0 0.001)))
        }

        print "-- lists --"
        ; A numbered list's numbers are not in the file: the paragraph says it
        ; is numbered and in which scheme, and the number is its place in the
        ; run of items above it. A viewer that drew the stored character put a
        ; dot in front of every item instead.
        def lb:PptxApp (PptxEditHostTest.build())
        def ls:PptxShape (PptxEditHostTest.firstShape(lb))
        lb.editor.select(ls.editId)
        c.ok("a box with text starts with no list" ((lb.editor.listKind()) == "none"))
        c.ok("it can be made a bulleted one" (lb.editor.setListKind("bullet")))
        c.ok("and says so" ((lb.editor.listKind()) == "bullet"))
        c.ok("it can be made numbered instead" (lb.editor.setListKind("number")))
        c.ok("and says so" ((lb.editor.listKind()) == "number"))
        def firstPara:PptxParagraph (itemAt ls.text.paragraphs 0)
        c.ok("the paragraph is numbered" firstPara.bulletAutoNum)
        c.ok("the list button turns it off again" (lb.runCommand("text.number" "")))
        c.ok("and it is off" ((lb.editor.listKind()) == "none"))

        print "-- what a numbered item is numbered --"
        def body (new PptxTextBody())
        PptxEditHostTest.numbered(body 0 "one")
        PptxEditHostTest.numbered(body 0 "two")
        PptxEditHostTest.numbered(body 1 "under two")
        PptxEditHostTest.numbered(body 1 "also under two")
        PptxEditHostTest.numbered(body 0 "three")
        c.ok("the first item is 1." ((PptxTextLayout.autoNumber(body 0)) == "1."))
        c.ok("the second is 2." ((PptxTextLayout.autoNumber(body 1)) == "2."))
        c.ok("a nested item starts over at 1." ((PptxTextLayout.autoNumber(body 2)) == "1."))
        c.ok("and counts on from there" ((PptxTextLayout.autoNumber(body 3)) == "2."))
        c.ok("the outer list carries on past the nested one" ((PptxTextLayout.autoNumber(body 4)) == "3."))
        c.ok("letters count like spreadsheet columns" ((PptxTextLayout.numberIn("alphaLcParenR" 27)) == "aa)"))
        c.ok("roman numerals are roman" ((PptxTextLayout.numberIn("romanUcPeriod" 24)) == "XXIV."))
        c.ok("and a scheme in brackets gets both" ((PptxTextLayout.numberIn("arabicParenBoth" 7)) == "(7)"))

        print "-- a line break inside a paragraph --"
        ; `<a:br/>` — shift+Enter — and a newline left in a run's text. Both
        ; ended a line in PowerPoint and neither did here: the text ran on and
        ; wrapped wherever the box happened to end.
        def brBody (new PptxTextBody())
        brBody.wrap = true
        def brPara (new PptxParagraph())
        def r1 (new PptxTextRun())
        r1.text = "one"
        r1.fontSizePt = 12.0
        def r2 (new PptxTextRun())
        r2.text = "\n"
        r2.fontSizePt = 12.0
        def r3 (new PptxTextRun())
        r3.text = "two"
        r3.fontSizePt = 12.0
        push brPara.runs r1
        push brPara.runs r2
        push brPara.runs r3
        push brBody.paragraphs brPara
        def brLines:[PptxTextLine] (PptxTextLayout.layout(brBody lb.view.converter.measure 1.0 0.0 0.0 400.0 200.0))
        c.ok("the break makes two lines out of one paragraph" ((array_length brLines) == 2))
        if ((array_length brLines) == 2) {
            def l1:PptxTextLine (itemAt brLines 0)
            def l2:PptxTextLine (itemAt brLines 1)
            c.ok("both belong to the same paragraph" ((l1.para == 0) && (l2.para == 0)))
            c.ok("and the second is below the first" (l2.y > l1.y))
        }

        print "-- a drag is one edit, however many frames it took --"
        def depth0:int (app2.editor.historyDepth())
        def x0:double sh.x
        app2.pointer(px py true true false)
        def step:int 1
        while (step <= 10) {
            app2.pointer((px + (step * 3)) py false true false)
            step = (step + 1)
        }
        app2.pointer((px + 30) py false false true)
        def moved@(optional):PptxShape (app2.editor.findShape(sh.editId))
        c.ok("the shape is still there after the drag" (!null? moved))
        if (!null? moved) {
            def m:PptxShape (unwrap moved)
            def sc:double (app2.ptScale())
            def wantX:double (x0 + (30.0 / sc))
            c.ok("it followed the pointer" (PptxEditHostTest.near(m.x wantX 4.0)))
        }
        c.ok("the whole drag is one history step" ((app2.editor.historyDepth()) == (depth0 + 1)))
        c.ok("and undo takes the drag back" (app2.runCommand("edit.undo" "")))
        def back@(optional):PptxShape (app2.editor.findShape(sh.editId))
        if (!null? back) {
            def b2:PptxShape (unwrap back)
            c.ok("back where it was pressed" (PptxEditHostTest.near(b2.x x0 0.5)))
        }

        print "-- the selection is drawn into the same display list --"
        def bare:PptxApp (PptxEditHostTest.build())
        def plain:EVGDisplayList (bare.buildFrame())
        def plainCount:int (plain.count())
        def sh2:PptxShape (PptxEditHostTest.firstShape(bare))
        bare.editor.select(sh2.editId)
        def withSel:EVGDisplayList (bare.buildFrame())
        c.ok("selecting adds chrome to the frame" ((withSel.count()) > plainCount))
        bare.editor.clearSelection()
        def cleared:EVGDisplayList (bare.buildFrame())
        c.ok("and clearing it takes the chrome away" ((cleared.count()) == plainCount))

        print "-- a corner handle resizes --"
        def app3:PptxApp (PptxEditHostTest.build())
        def sh3:PptxShape (PptxEditHostTest.firstShape(app3))
        app3.editor.select(sh3.editId)
        def hx:int (PptxEditHostTest.screenX(app3 (sh3.x + sh3.width)))
        def hy:int (PptxEditHostTest.screenY(app3 (sh3.y + sh3.height)))
        c.ok("the south-east handle is where the corner is" ((app3.handleAt(hx hy)) == 4))
        c.ok("and the middle of the shape is not a handle" ((app3.handleAt((PptxEditHostTest.screenX(app3 (sh3.x + (sh3.width * 0.5)))) (PptxEditHostTest.screenY(app3 (sh3.y + (sh3.height * 0.5)))))) == (0 - 1)))
        def w0:double sh3.width
        app3.pointer(hx hy true true false)
        app3.pointer((hx + 20) (hy + 20) false true false)
        app3.pointer((hx + 20) (hy + 20) false false true)
        def sized@(optional):PptxShape (app3.editor.findShape(sh3.editId))
        if (!null? sized) {
            def s4:PptxShape (unwrap sized)
            c.ok("the shape grew" (s4.width > w0))
        }

        print "-- a caret inside a shape --"
        def app5:PptxApp (PptxEditHostTest.buildDeck("01-text.pptx"))
        def texts:[PptxShape] (app5.editor.editableShapes())
        def target@(optional):PptxShape
        def ti:int 0
        while (ti < (array_length texts)) {
            def cand:PptxShape (itemAt texts ti)
            if cand.hasText {
                if ((strlen (cand.text.plainText())) > 4) {
                    if (null? target) {
                        target = cand
                    }
                }
            }
            ti = (ti + 1)
        }
        c.ok("the fixture has a shape with text in it" (!null? target))
        if (!null? target) {
            def ts:PptxShape (unwrap target)
            app5.editor.select(ts.editId)
            c.ok("F2 is a command as well as a key" (app5.runCommand("text.edit" "")))
            c.ok("there is a caret now" (app5.editor.isEditingText()))
            ; The caret is a rectangle inside the shape it is in.
            def shapeBox:PptxEditRect (app5.shapeScreenBox(ts))
            def atEnd:PptxEditRect (app5.caretRect(ts app5.editor.caret))
            c.ok("the caret has height" (atEnd.h > 2.0))
            c.ok("and it is inside the shape" ((atEnd.x >= (shapeBox.x - 1.0)) && (atEnd.x <= ((shapeBox.x + shapeBox.w) + 1.0))))
            def atStart:PptxEditRect (app5.caretRect(ts (PptxTextPos.of(0 0))))
            c.ok("the end of the line is further right than its start" (atEnd.x > atStart.x))
            ; Measured there, measured back: clicking on a caret's own
            ; rectangle puts the caret back where it was.
            def probe:PptxTextPos (PptxTextPos.of(0 3))
            def r3:PptxEditRect (app5.caretRect(ts probe))
            def back:PptxTextPos (app5.caretFromPoint(ts (to_int (r3.x + 1.0)) (to_int (r3.y + 2.0))))
            c.ok("a click lands on the column it was measured from" ((back.para == 0) && (back.col == 3)))
            ; It is drawn, and a selection is drawn behind it.
            def noCaret:PptxApp (PptxEditHostTest.buildDeck("01-text.pptx"))
                noCaret.editor.select(ts.editId)
            def plainCount:int ((noCaret.buildFrame()).count())
            def withCaret:int ((app5.buildFrame()).count())
            c.ok("the caret is drawn into the frame" (withCaret > plainCount))
            app5.editor.selectAllText()
            def withSel:int ((app5.buildFrame()).count())
            c.ok("and a selection is drawn behind it" (withSel > withCaret))
            ; A press inside keeps the caret; a press outside gives it up.
            def cx:int (to_int (shapeBox.x + (shapeBox.w * 0.5)))
            def cy:int (to_int (shapeBox.y + (shapeBox.h * 0.5)))
            app5.pointer(cx cy true true false)
            app5.pointer(cx cy false false true)
            c.ok("a press inside still has the caret" (app5.editor.isEditingText()))
            c.ok("and did not start a drag" (app5.dragMode == 0))
            def outX:int (to_int (shapeBox.x + shapeBox.w + 30.0))
            app5.pointer(outX cy true true false)
            app5.pointer(outX cy false false true)
            c.ok("a press outside stops typing" ((app5.editor.isEditingText()) == false))
        }

        print "-- a caret on a wrapped line --"
        def app6:PptxApp (PptxEditHostTest.buildDeck("01-text.pptx"))
        def boxId:int (app6.editor.addTextBox(60.0 260.0 200.0 120.0 "The quick brown fox jumps over the lazy dog and keeps going for a while"))
        app6.editor.beginTextEdit(boxId)
        def wrapped@(optional):PptxShape (app6.editor.findShape(boxId))
        c.ok("the text box is there" (!null? wrapped))
        if (!null? wrapped) {
            def ws:PptxShape (unwrap wrapped)
            def lines:[PptxTextLine] (app6.lineBoxesFor(ws))
            c.ok("the paragraph wrapped into several lines" ((array_length lines) > 2))
            if ((array_length lines) > 2) {
                def second:PptxTextLine (itemAt lines 1)
                def third:PptxTextLine (itemAt lines 2)
                c.ok("the second line is below the first" (second.y > ((itemAt lines 0).y)))
                ; A caret in the middle of the second line, measured out to a
                ; rectangle and clicked back in, comes home.
                def mid:int (second.startCol + (idiv (second.endCol - second.startCol) 2))
                def r:PptxEditRect (app6.caretRect(ws (PptxTextPos.of(0 mid))))
                c.ok("the caret is on the second line's row" ((fabs (r.y - second.y)) < 0.01))
                def back:PptxTextPos (app6.caretFromPoint(ws (to_int (r.x + 1.0)) (to_int (r.y + 2.0))))
                c.ok("clicking it comes back to the same column" ((back.para == 0) && (back.col == mid)))
                ; A click on the third line is on the third line, which is the
                ; thing a per-paragraph caret could not do at all.
                def onThird:PptxTextPos (app6.caretFromPoint(ws (to_int (third.x + 2.0)) (to_int (third.y + 2.0))))
                c.ok("a click on the third line lands in its columns" ((onThird.col >= third.startCol) && (onThird.col <= third.endCol)))
                ; And the selection highlight over a wrapped range draws a rect
                ; per line rather than one enormous one.
                app6.editor.setCaretPos(0 0 false)
                app6.editor.setCaretPos(0 (third.endCol) true)
                def painted:EVGDisplayList (app6.buildFrame())
                app6.editor.setCaretPos(0 0 false)
                def bare2:EVGDisplayList (app6.buildFrame())
                c.ok("a wrapped selection is drawn" ((painted.count()) > (bare2.count())))
            }
        }

        print "-- a rubber band, a rotation handle and a lock --"
        def app7:PptxApp (PptxEditHostTest.buildDeck("02-shapes.pptx"))
        def all7:[PptxShape] (app7.editor.editableShapes())
        c.ok("the fixture has shapes to band over" ((array_length all7) >= 2))
        if ((array_length all7) >= 2) {
            ; A drag from an empty corner across everything.
            def bandStartX:int (PptxEditHostTest.screenX(app7 2.0))
            def bandStartY:int (PptxEditHostTest.screenY(app7 2.0))
            def slideWpt:double (app7.slideW())
            def slideHpt:double (app7.slideH())
            def bandEndX:int (PptxEditHostTest.screenX(app7 (slideWpt - 4.0)))
            def bandEndY:int (PptxEditHostTest.screenY(app7 (slideHpt - 4.0)))
            app7.pointer(bandStartX bandStartY true true false)
            c.ok("a press on empty canvas starts a band" (app7.dragMode == 3))
            app7.pointer((idiv (bandStartX + bandEndX) 2) (idiv (bandStartY + bandEndY) 2) false true false)
            app7.pointer(bandEndX bandEndY false true false)
            app7.pointer(bandEndX bandEndY false false true)
            c.ok("and letting go selects what it touched" ((app7.editor.selectionCount()) == (array_length all7)))
            c.ok("the band is gone afterwards" (app7.dragMode == 0))
            ; The rotation handle sits above the selection box.
            def one:PptxShape (itemAt all7 0)
            app7.editor.select(one.editId)
            def sb:PptxEditRect (app7.shapeScreenBox(one))
            def rotX:int (to_int (sb.x + (sb.w * 0.5)))
            def rotY:int (to_int (app7.rotateHandleY(sb.y)))
            c.ok("the rotation handle is the ninth" ((app7.handleAt(rotX rotY)) == 8))
            app7.pointer(rotX rotY true true false)
            c.ok("dragging it is a rotation, not a resize" (app7.dragMode == 4))
            def sideX:int (to_int (sb.x + sb.w + 40.0))
            def sideY:int (to_int (sb.y + (sb.h * 0.5)))
            app7.pointer(sideX sideY false true false)
            app7.pointer(sideX sideY false false true)
            def turned@(optional):PptxShape (app7.editor.findShape(one.editId))
            if (!null? turned) {
                def ts:PptxShape (unwrap turned)
                c.ok("the shape turned toward the pointer" ((fabs (ts.rotation - 90.0)) < 6.0))
            }
            c.ok("and it is one history step" (app7.runCommand("edit.undo" "")))
            ; A locked selection draws no handles.
            app7.editor.select(one.editId)
            def unlockedCount:int ((app7.buildFrame()).count())
            app7.runCommand("edit.lock" "")
            c.ok("the lock command locks" (app7.editor.selectionLocked()))
            def lockedCount:int ((app7.buildFrame()).count())
            c.ok("a locked shape shows no handles" (lockedCount < unlockedCount))
            app7.runCommand("edit.lock" "")
            c.ok("and unlocks again" ((app7.editor.selectionLocked()) == false))
            ; Copy and paste through the command surface.
            def before7:int (array_length (app7.editor.editableShapes()))
            c.ok("copy is a command" (app7.runCommand("edit.copy" "")))
            c.ok("paste is a command" (app7.runCommand("edit.paste" "")))
            c.ok("and it put one down" ((array_length (app7.editor.editableShapes())) == (before7 + 1)))
            ; The grid is a command too, and it draws.
            def plain7:int ((app7.buildFrame()).count())
            app7.runCommand("view.grid" "")
            c.ok("the grid turns on" app7.editor.gridEnabled)
            c.ok("and it is drawn" (((app7.buildFrame()).count()) > plain7))
            app7.runCommand("view.grid" "")
        }

        print "-- a mirrored picture, and the format painter --"
        def app8:PptxApp (PptxEditHostTest.buildDeck("16-image-png.pptx"))
        def pics:[PptxShape] (app8.editor.editableShapes())
        def picId:int 0
        def pi:int 0
        while (pi < (array_length pics)) {
            def cand:PptxShape (itemAt pics pi)
            if (cand.kind == 1) {
                if (picId == 0) {
                    picId = cand.editId
                }
            }
            pi = (pi + 1)
        }
        c.ok("the fixture has a picture" (picId > 0))
        if (picId > 0) {
            app8.editor.select(picId)
            ; The flags reach the display list, which is what both backends read.
            def plainList:EVGDisplayList (app8.buildFrame())
            def mirroredBefore:int (PptxEditHostTest.countFlipped(plainList))
            c.ok("nothing is mirrored yet" (mirroredBefore == 0))
            c.ok("flip it across" (app8.runCommand("edit.flip.h" "")))
            def flippedList:EVGDisplayList (app8.buildFrame())
            ; The slide draws it, and so does its thumbnail in the panel: both
            ; are the same scene, which is the point of the panel.
            c.ok("the picture command carries the mirror" ((PptxEditHostTest.countFlipped(flippedList)) > 0))
            ; And the pixels differ, which is the part a flag alone would not
            ; prove: a mirrored blit reads the other column.
            app8.renderOracleSlide(0)
            def afterPixels:buffer (PptxEditHostTest.copyOf((app8.raw())))
            app8.runCommand("edit.undo" "")
            app8.renderOracleSlide(0)
            def beforePixels:buffer (app8.raw())
            c.ok("and the picture is drawn differently" ((PptxEditHostTest.sameBytes(beforePixels afterPixels)) == false))
        }

        print "-- a turned shape's chrome and its axes --"
        def appR:PptxApp (PptxEditHostTest.buildDeck("02-shapes.pptx"))
        def rShapes:[PptxShape] (appR.editor.editableShapes())
        if ((array_length rShapes) > 0) {
            def rs:PptxShape (itemAt rShapes 0)
            appR.editor.select(rs.editId)
            ; Upright, the handles are where the box says they are.
            def upright:[double] (appR.handlePos(4))
            def sb2:PptxEditRect (appR.shapeScreenBox(rs))
            c.ok("the south-east handle is on the corner" (((fabs ((itemAt upright 0) - (sb2.x + sb2.w))) < 1.0) && ((fabs ((itemAt upright 1) - (sb2.y + sb2.h))) < 1.0)))
            c.ok("and there is no angle to draw at" ((appR.selectionAngle()) == 0.0))
            ; Everything the shape draws carries the angle — the fill, the
            ; outline and the picture as well as the text. Only text used to,
            ; which is why a turned shape drew its box straight and its words
            ; crooked.
            appR.editor.setSelectionRotation(30.0)
            def turnedFrame:EVGDisplayList (appR.buildFrame())
            def turnedCmds:int (PptxEditHostTest.countRotated(turnedFrame))
            appR.editor.setSelectionRotation(0.0)
            def straightFrame:EVGDisplayList (appR.buildFrame())
            c.ok("turning a shape turns what it draws" (turnedCmds > (PptxEditHostTest.countRotated(straightFrame))))
            ; Turn it a quarter turn: the handles turn with it, and the one
            ; that was on the right is now at the bottom.
            appR.editor.setSelectionRotation(90.0)
            c.ok("the selection has an angle now" ((fabs ((appR.selectionAngle()) - 90.0)) < 0.01))
            def turnedH:[double] (appR.handlePos(3))
            def cx2:double (sb2.x + (sb2.w * 0.5))
            def cy2:double (sb2.y + (sb2.h * 0.5))
            c.ok("the east handle went to the bottom" ((itemAt turnedH 1) > cy2))
            c.ok("and onto the centre line" ((fabs ((itemAt turnedH 0) - cx2)) < 1.5))
            c.ok("clicking there finds the east handle" ((appR.handleAt((to_int (itemAt turnedH 0)) (to_int (itemAt turnedH 1)))) == 3))
            ; Dragging it away from the centre makes the shape LONGER, not
            ; taller: a turned shape resizes along its own axes.
            def w0:double rs.width
            def h0:double rs.height
            def dragX:int (to_int (itemAt turnedH 0))
            def dragY:int (to_int (itemAt turnedH 1))
            appR.pointer(dragX dragY true true false)
            appR.pointer(dragX (dragY + 30) false true false)
            appR.pointer(dragX (dragY + 30) false false true)
            def sized@(optional):PptxShape (appR.editor.findShape(rs.editId))
            if (!null? sized) {
                def ss:PptxShape (unwrap sized)
                c.ok("the width grew" (ss.width > (w0 + 4.0)))
                c.ok("and the height did not" ((fabs (ss.height - h0)) < 0.5))
            }
        }

        print "-- the slide panel --"
        def app9:PptxApp (PptxEditHostTest.buildDeck("20-business-deck.pptx"))
        c.ok("the deck has several slides" ((app9.slideCount()) > 2))
        c.ok("the panel is up by default" app9.panelVisible)
        c.ok("and it takes width out of the slide" ((app9.slideOriginX()) >= (to_double (app9.panelWidth()))))
        ; A thumbnail is the slide's own scene, so the panel draws a lot.
        def withPanel:int ((app9.buildFrame()).count())
        app9.runCommand("view.panel" "")
        c.ok("it can be folded away" ((app9.panelVisible) == false))
        def withoutPanel:int ((app9.buildFrame()).count())
        c.ok("and folding it away draws less" (withoutPanel < withPanel))
        c.ok("the slide then starts at the window edge" ((app9.slideOriginX()) < 2.0))
        app9.runCommand("view.panel" "")
        c.ok("and it comes back" app9.panelVisible)
        ; Clicking a thumbnail goes to that slide.
        def thumbX:int ((app9.panelThumbX()) + (idiv (app9.panelThumbW()) 2))
        def thumb2Y:int ((app9.panelThumbY(2)) + (idiv (app9.panelThumbH()) 2))
        app9.pointer(thumbX thumb2Y true true false)
        app9.pointer(thumbX thumb2Y false false true)
        c.ok("clicking the third thumbnail goes to the third slide" (app9.index == 2))
        c.ok("and the editor followed" (app9.editor.slideIndex == 2))
        ; Dragging one reorders the deck.
        def firstPart:string ((itemAt app9.presentation.slides 2).partPath)
        def thumb0Y:int ((app9.panelThumbY(0)) + 2)
        app9.pointer(thumbX thumb2Y true true false)
        c.ok("a press on a thumbnail picks the slide up" (app9.panelDrag == 2))
        app9.pointer(thumbX thumb0Y false true false)
        app9.pointer(thumbX thumb0Y false false true)
        c.ok("dropping it at the top moves it there" (((itemAt app9.presentation.slides 0).partPath) == firstPart))
        c.ok("and the viewer is on it" (app9.index == 0))
        c.ok("undo puts the order back" (app9.runCommand("edit.undo" "")))
        c.ok("the deck is in its old order" (((itemAt app9.presentation.slides 2).partPath) == firstPart))
        ; A press on the toolbar above the panel is still the toolbar's.
        def firstButton:int (PptxEditHostTest.indexOfCommand(app9 "slide.next"))
        if (firstButton >= 0) {
            def t9:ToolItem (app9.toolbar.at(firstButton))
            def beforeIdx:int app9.index
            app9.pointer((t9.x + 2) (t9.y + 2) true true false)
            c.ok("the strip still works over the panel" (app9.index != beforeIdx))
        }

        print "-- clicking the slide never turns the page --"
        def viewer:PptxApp (PptxEditHostTest.buildDeck("04-multi.pptx"))
        def before:int viewer.index
        ; The right-hand third of the window, which used to be "next slide".
        viewer.pointer(700 400 true true false)
        viewer.pointer(700 400 false false true)
        c.ok("a click on the right of the slide stays on the slide" (viewer.index == before))
        ; And the left-hand third, which used to be "previous slide".
        viewer.gotoSlide(1)
        viewer.pointer(320 400 true true false)
        viewer.pointer(320 400 false false true)
        c.ok("and a click on the left stays too" (viewer.index == 1))
        ; The ways that DO turn the page still do.
        viewer.gotoSlide(0)
        c.ok("the strip turns it" (viewer.runCommand("slide.next" "")))
        c.ok("and the deck moved" (viewer.index == 1))
        ; An arrow with nothing selected is the deck; with a shape selected it
        ; is the shape, which is why Page Down exists.
        viewer.editor.clearSelection()
        def keyInput (new UIInput)
        keyInput.newFrame()
        keyInput.pushKey((UIKey.left()))
        viewer.update(keyInput)
        c.ok("an arrow with nothing selected turns it" (viewer.index == 0))
        def shapes0:[PptxShape] (viewer.editor.editableShapes())
        if ((array_length shapes0) > 0) {
            def s0:PptxShape (itemAt shapes0 0)
            viewer.editor.select(s0.editId)
            def x0:double s0.x
            def nudge (new UIInput)
            nudge.newFrame()
            nudge.pushKey((UIKey.right()))
            viewer.update(nudge)
            c.ok("an arrow with a shape selected moves the shape" (viewer.index == 0))
            def moved0@(optional):PptxShape (viewer.editor.findShape(s0.editId))
            if (!null? moved0) {
                def m0:PptxShape (unwrap moved0)
                c.ok("and it really moved" (m0.x > x0))
            }
            def pager (new UIInput)
            pager.newFrame()
            pager.pushKey((UIKey.pageDown()))
            viewer.update(pager)
            c.ok("but Page Down still turns the page" (viewer.index == 1))
        }

        print "-- inserting, deleting, and the slide list --"
        def app4:PptxApp (PptxEditHostTest.build())
        def n0:int (array_length (app4.editor.editableShapes()))
        c.ok("insert a box" (app4.runCommand("shape.rect" "")))
        c.ok("inserting turns editing on" app4.editMode)
        c.ok("there is one more shape" ((array_length (app4.editor.editableShapes())) == (n0 + 1)))
        c.ok("and it is selected" ((app4.editor.selectionCount()) == 1))
        c.ok("delete takes it away" (app4.runCommand("edit.delete" "")))
        c.ok("back to where we started" ((array_length (app4.editor.editableShapes())) == n0))
        def slides0:int (app4.slideCount())
        c.ok("a new slide" (app4.runCommand("slide.add" "")))
        c.ok("the deck grew" ((app4.slideCount()) == (slides0 + 1)))
        c.ok("and the viewer is on it" (app4.index == (app4.editor.slideIndex)))
        c.ok("undo removes the slide again" (app4.runCommand("edit.undo" "")))
        c.ok("the deck is back" ((app4.slideCount()) == slides0))
        c.ok("and the viewer is on a slide that exists" (app4.index < (app4.slideCount())))

        print "-- the master, the footer and the sections --"
        def app5:PptxApp (PptxEditHostTest.buildDeck("20-business-deck.pptx"))
        def onSlide:int (array_length (app5.editor.editableShapes()))
        c.ok("the master opens" (app5.runCommand("master.edit" "")))
        c.ok("and the app says so" (app5.editor.isEditingSheet()))
        def masterShapes:[PptxShape] (app5.editor.editableShapes())
        def sheet@(optional):PptxSheet (app5.editor.masterSheet())
        def fromSheet:boolean false
        if (!null? sheet) {
            def ms:PptxSheet (unwrap sheet)
            if ((array_length masterShapes) == (array_length ms.shapes)) {
                fromSheet = true
                def mi:int 0
                while (mi < (array_length masterShapes)) {
                    def a:PptxShape (itemAt masterShapes mi)
                    def b:PptxShape (itemAt ms.shapes mi)
                    if (a.editId != b.editId) {
                        fromSheet = false
                    }
                    mi = (mi + 1)
                }
            }
        }
        c.ok("what is editable is the master's own shapes" fromSheet)
        c.ok("leaving it works" (app5.runCommand("master.exit" "")))
        c.ok("and puts the slide back" ((app5.editor.isEditingSheet()) == false))
        c.ok("with the shapes it had" ((array_length (app5.editor.editableShapes())) == onSlide))
        c.ok("leaving again does nothing" ((app5.runCommand("master.exit" "")) == false))
        ; The frame still builds while the master is open — the master is drawn
        ; through the same path as a slide.
        app5.runCommand("master.edit" "")
        def masterFrame:EVGDisplayList (app5.buildFrame())
        c.ok("the master draws" ((array_length masterFrame.cmds) > 0))
        app5.runCommand("master.exit" "")

        c.ok("a footer can be set from a command" (app5.runCommand("footer.set" "Internal only")))
        c.ok("and it is on the master" ((app5.editor.footerText()) == "Internal only"))
        c.ok("slide numbers toggle on" (app5.runCommand("slide.numbers" "")))
        c.ok("and read as on" (app5.editor.slideNumbersShown()))
        c.ok("and off again" (app5.runCommand("slide.numbers" "")))
        c.ok("reading as off" ((app5.editor.slideNumbersShown()) == false))

        def secs0:int (app5.editor.sectionCount())
        app5.gotoSlide(0)
        c.ok("a section starts here" (app5.runCommand("section.add" "Opening")))
        c.ok("the deck has one more" ((app5.editor.sectionCount()) == (secs0 + 1)))
        c.ok("this slide is in it" ((app5.editor.sectionOfSlide(0)) >= 0))
        c.ok("renaming it works" (app5.runCommand("section.rename" "Overview")))
        def at0:int (app5.editor.sectionOfSlide(0))
        c.ok("and the name took" ((app5.editor.sectionNameAt(at0)) == "Overview"))
        c.ok("an unnamed rename is refused" ((app5.runCommand("section.rename" "")) == false))
        def sectionFrame:EVGDisplayList (app5.buildFrame())
        c.ok("the panel draws with a section header" ((array_length sectionFrame.cmds) > 0))
        c.ok("removing it works" (app5.runCommand("section.remove" "")))
        c.ok("and the deck is back to none here" ((app5.editor.sectionOfSlide(0)) < 0))
        c.ok("removing again is refused" ((app5.runCommand("section.remove" "")) == false))

        print "-- the deck, shown --"
        def show:PptxApp (PptxEditHostTest.buildDeck("28-transitions.pptx"))
        c.ok("the deck opens" ((show.slideCount()) == 2))
        c.ok("a show starts" (show.runCommand("show.start" "")))
        c.ok("and it is presenting" show.presenting)
        c.ok("editing is off while it runs" (show.editMode == false))
        ; The slide fills the window: no strip, no panel, no status line.
        def full:EVGDisplayList (show.buildFrame())
        c.ok("the show draws" ((array_length full.cmds) > 0))
        c.ok("the slide starts at the top of the window" ((show.slideOriginY()) < 40.0))
        ; Slide one has a two-step build, so the first clicks build it.
        def steps:int (show.editor.buildCount())
        c.ok("slide one has a build" (steps == 2))
        def hiddenAtStart:int (PptxEditHostTest.visibleCount(show))
        c.ok("a click builds rather than turning the page" (show.presentNext()))
        c.ok("still on the first slide" (show.index == 0))
        c.ok("and one more shape is on it" ((PptxEditHostTest.visibleCount(show)) == (hiddenAtStart + 1)))
        show.presentNext()
        c.ok("the build is finished" (show.presentStep == steps))
        c.ok("the next click turns the page" (show.presentNext()))
        c.ok("and it turned" (show.index == 1))
        ; Slide two pushes up, so a transition is running and has a length.
        c.ok("a transition is running" (show.showLength > 0.0))
        c.ok("which has not finished yet" ((show.showProgress()) < 1.0))
        def mid:EVGDisplayList (show.buildFrame())
        c.ok("a transition draws both pages" ((array_length mid.cmds) > (array_length full.cmds)))
        show.tick(2.0)
        c.ok("time finishes it" ((show.showLength) == 0.0))
        def after:EVGDisplayList (show.buildFrame())
        c.ok("and the frame is one page again" ((array_length after.cmds) > 0))
        c.ok("the last slide does not go further" ((show.presentNext()) == false))
        c.ok("back works" (show.presentPrev()))
        c.ok("and lands on the slide before" (show.index == 0))
        c.ok("fully built" (show.presentStep == steps))

        print "-- what a presenter reaches for --"
        c.ok("N shows the presenter's own screen" (show.showChar("n")))
        c.ok("and it is up" show.presenterView)
        def pres:EVGDisplayList (show.buildFrame())
        c.ok("which draws the next slide and the notes beside it" ((array_length pres.cmds) > 0))
        c.ok("the slide is narrower for it" ((show.showAreaW()) < (to_double show.W)))
        show.showChar("n")
        c.ok("and N puts it away" (show.presenterView == false))
        c.ok("B blanks the screen" (show.showChar("b")))
        def blank:EVGDisplayList (show.buildFrame())
        c.ok("a blanked screen draws almost nothing" ((array_length blank.cmds) < 8))
        show.showChar("b")
        c.ok("and B brings it back" (show.showBlank == false))
        c.ok("P puts a pen out" (show.showChar("p")))
        c.ok("and the pen is out" (show.penMode == "pen"))
        ; Drawing with it: a press, a drag, a release — one stroke on this
        ; slide, in slide points, so it stays where it was drawn.
        def inkBefore:int (show.inkStrokeCount())
        show.pointer(300 300 true true false)
        show.pointer(340 320 false true false)
        show.pointer(380 300 false false true)
        c.ok("a stroke was drawn" ((show.inkStrokeCount()) == (inkBefore + 1)))
        def inked:EVGDisplayList (show.buildFrame())
        c.ok("and it is in the picture" ((array_length inked.cmds) > (array_length full.cmds)))
        c.ok("the pen does not turn the page" (show.index == 0))
        c.ok("E rubs it off" (show.showChar("e")))
        c.ok("and the slide is clean" ((show.inkStrokeCount()) == 0))
        c.ok("L is a laser instead" (show.showChar("l")))
        c.ok("which is not ink" (show.penMode == "laser"))
        show.pointer(400 300 false false true)
        c.ok("and a laser leaves nothing behind" ((show.inkStrokeCount()) == 0))
        ; Escape gives up the pen first and the show second, so a presenter
        ; cannot drop out of the show by trying to put the pen away.
        def esc (new UIInput)
        esc.newFrame()
        esc.pushKey((UIKey.escape()))
        show.update(esc)
        c.ok("Escape puts the pointer away" ((strlen show.penMode) == 0))
        c.ok("and stays in the show" show.presenting)
        def esc2 (new UIInput)
        esc2.newFrame()
        esc2.pushKey((UIKey.escape()))
        show.update(esc2)
        c.ok("a second Escape ends it" (show.presenting == false))

        print "-- the show is made in the editor --"
        def maker:PptxApp (PptxEditHostTest.buildDeck("04-multi.pptx"))
        c.ok("a transition can be set from a command" (maker.runCommand("slide.transition" "wipe:d:0.5")))
        c.ok("and it took" ((maker.editor.transitionKind()) == "wipe"))
        ; The fixture's own shapes, plus one inserted, so the build is about
        ; the build and not about how many shapes the deck happened to have.
        maker.runCommand("shape.rect" "")
        maker.runCommand("shape.ellipse" "")
        def shapes2:[PptxShape] (maker.editor.editableShapes())
        c.ok("there are shapes to animate" ((array_length shapes2) >= 2))
        if ((array_length shapes2) >= 2) {
            def a1:PptxShape (itemAt shapes2 0)
            def a2:PptxShape (itemAt shapes2 1)
            maker.editor.select(a1.editId)
            maker.editor.addToSelection(a2.editId)
            c.ok("both can be animated" (maker.runCommand("shape.animate" "fade")))
            c.ok("which is a two-step build" ((maker.editor.buildCount()) == 2))
            maker.editor.select(a2.editId)
            c.ok("the second step can be moved earlier" (maker.runCommand("build.earlier" "")))
            def slideNow@(optional):PptxSlide (maker.editor.currentSlide())
            if (!null? slideNow) {
                def sn:PptxSlide (unwrap slideNow)
                def first:PptxBuildStep (itemAt sn.build 0)
                c.ok("and it went first" (first.editId == a2.editId))
            }
            c.ok("the build can be cleared" (maker.runCommand("shape.animate.clear" "")))
            c.ok("leaving none" ((maker.editor.buildCount()) == 0))
        }
        c.ok("a slide can advance itself" (maker.runCommand("slide.advance" "3")))
        def s0@(optional):PptxSlide (maker.editor.currentSlide())
        if (!null? s0) {
            def sv:PptxSlide (unwrap s0)
            c.ok("after the time it was given" (sv.transition.afterSeconds > 2.9))
            ; …and the show acts on it without a click.
            maker.runCommand("show.start" "")
            def wasAt:int maker.index
            maker.tick(4.0)
            c.ok("a timed slide turns on its own" (maker.index != wasAt))
        }

        print "-- the panel builds what is on screen, and keeps it --"
        def big:PptxApp (PptxEditHostTest.buildDeck("20-business-deck.pptx"))
        ; A deck long enough that the panel cannot be drawing all of it: the
        ; deck is duplicated until it is well past a screenful.
        while ((big.slideCount()) < 60) {
            big.runCommand("slide.duplicate" "")
        }
        big.gotoSlide(0)
        def f1:EVGDisplayList (big.buildFrame())
        def built1:int (big.panelBuiltLastFrame())
        c.ok("the deck is long" ((big.slideCount()) >= 60))
        c.ok("but the panel builds only what fits" (built1 < 20))
        c.ok("and it built something" (built1 > 0))
        ; The same frame again: nothing changed, so nothing is built again.
        def f2:EVGDisplayList (big.buildFrame())
        c.ok("an idle frame builds no thumbnail at all" ((big.panelBuiltLastFrame()) == 0))
        c.ok("it keeps the ones it had" ((big.panelKeptLastFrame()) == built1))
        ; Change a slide and its thumbnail — and only its thumbnail — is built
        ; again, because a kept picture is tagged with the revision it was
        ; taken at.
        def sel:[PptxShape] (big.editor.editableShapes())
        if ((array_length sel) > 0) {
            def s1:PptxShape (itemAt sel 0)
            big.editor.select(s1.editId)
            big.editor.moveSelection(12.0 0.0)
            def f3:EVGDisplayList (big.buildFrame())
            c.ok("an edited slide is drawn again" ((big.panelBuiltLastFrame()) == 1))
            c.ok("and the rest are kept" ((big.panelKeptLastFrame()) == (built1 - 1)))
        }
        ; Scrolling moves them, so they are built where they now are.
        big.scrollPanel(-3)
        def f4:EVGDisplayList (big.buildFrame())
        c.ok("scrolling builds them where they moved to" ((big.panelBuiltLastFrame()) > 0))
        def f5:EVGDisplayList (big.buildFrame())
        c.ok("and stopping keeps them again" ((big.panelBuiltLastFrame()) == 0))

        print "-- the caret is measured at the size the glyphs were DRAWN at --"
        ; A deck names Calibri and we draw Open Sans, which is wider. A label
        ; the author sized to fit would spill, so the body is shrunk to fit —
        ; `substituteFit` — and the painter lays out AND draws at that reduced
        ; scale. The caret was measured at the host's scale instead, so it sat
        ; to the right of the glyphs: a pixel at the start of a short label,
        ; and further with every column along a long one. Slightly wrong, all
        ; the time, while typing — which is the worst kind of wrong to find.
        ;
        ; The check is the end of the line: the caret at the last column has
        ; to land where the painted text ends, and the painter draws from
        ; `line.x` for `line.w`.
        def cf:PptxApp (PptxEditHostTest.buildDeck("04-multi.pptx"))
        def shrunk:PptxShape (PptxEditHostTest.calibriLabel("Urheiijat" 18.0 85.05))
        def cslide:PptxSlide (cf.editor.currentSlide())
        push cslide.shapes shrunk
        def cconv:PptxToEvg cf.view.converter
        c.ok("the face this deck asks for is not one we have"
             ((cconv.measure.hasFamily("Calibri")) == false))
        def cs:double ((96.0 / 72.0) * cconv.scale)
        def cfit:double (cconv.substituteFit(shrunk.text (cconv.ptToPx((85.05 - 14.4))) cs))
        c.ok("so the body is shrunk to fit" (cfit < 1.0))
        def clines:[PptxTextLine] (cf.lineBoxesFor(shrunk))
        c.ok("on one line" ((array_length clines) == 1))
        def cl:PptxTextLine (itemAt clines 0)
        c.ok("the line records the scale it was drawn at" (cl.scale < (cf.ptScale())))
        def caretEnd:double (cf.caretXOnLine(shrunk cl cl.endCol))
        def paintEnd:double (cl.x + cl.w)
        def drift:double (fabs (caretEnd - paintEnd))
        c.ok(("the caret at the end of the line is where the text ends (off by " + (to_string drift) + ")")
             (drift < 0.01))
        ; And at the start, where there is nothing to measure, it is still on
        ; the text's own left edge — the check above would pass on its own if
        ; the caret simply never moved.
        def caretStart:double (cf.caretXOnLine(shrunk cl cl.startCol))
        c.ok("and at the start it is on the left edge" ((fabs (caretStart - cl.x)) < 0.01))
        c.ok("with the line actually as wide as a word" (cl.w > 20.0))

        ; A body whose face we DO have is not shrunk, and the caret is where
        ; it always was — this must not have moved anything for those.
        def kf:PptxApp (PptxEditHostTest.buildDeck("04-multi.pptx"))
        def kept:PptxShape (PptxEditHostTest.calibriLabel("Urheiijat" 18.0 85.05))
        def kpara:PptxParagraph (itemAt kept.text.paragraphs 0)
        def krun:PptxTextRun (itemAt kpara.runs 0)
        krun.fontFamily = "Open Sans"
        def kslide:PptxSlide (kf.editor.currentSlide())
        push kslide.shapes kept
        def klines:[PptxTextLine] (kf.lineBoxesFor(kept))
        def kl:PptxTextLine (itemAt klines 0)
        c.ok("a face we have is laid out at the host's own scale" ((fabs (kl.scale - (kf.ptScale()))) < 0.0001))
        def kEnd:double (kf.caretXOnLine(kept kl kl.endCol))
        c.ok("and its caret still ends on its text" ((fabs (kEnd - (kl.x + kl.w))) < 0.01))

        print ""
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

; ==============================================================================
; PptxEditorTest - the editing core, on a deck built in memory
; ==============================================================================

Import "../src/PptxModel.rgr"
Import "../src/PptxEdit.rgr"
Import "../src/PptxParser.rgr"
Import "../src/PptxResolver.rgr"

class PptxEditorTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new PptxEditorTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn near:boolean (a:double b:double) {
        def d:double (fabs (a - b))
        return (d < 0.01)
    }

    ; A two-shape slide: a box at 100,100 and a box at 300,200.
    fn buildDeck:PptxPresentation () {
        def pres (new PptxPresentation())
        pres.slideWidth = 720.0
        pres.slideHeight = 540.0
        def slide (new PptxSlide())
        slide.width = 720.0
        slide.height = 540.0
        def chrome (new PptxShape())
        chrome.name = "layout footer"
        chrome.x = 0.0
        chrome.y = 500.0
        chrome.width = 720.0
        chrome.height = 40.0
        chrome.inherited = true
        push slide.shapes chrome
        def a (new PptxShape())
        a.name = "A"
        a.x = 100.0
        a.y = 100.0
        a.width = 200.0
        a.height = 100.0
        a.hasXfrm = true
        a.fill = (PptxColor.srgbOf("4472C4"))
        push slide.shapes a
        def b (new PptxShape())
        b.name = "B"
        b.x = 300.0
        b.y = 200.0
        b.width = 120.0
        b.height = 60.0
        b.hasXfrm = true
        b.fill = (PptxColor.srgbOf("ED7D31"))
        push slide.shapes b
        push pres.slides slide
        return pres
    }

    fn run:void () {
        print "=== PptxEditorTest ==="
        this.testIds()
        this.testHitTest()
        this.testSelection()
        this.testMoveUndo()
        this.testResize()
        this.testMultiResize()
        this.testZOrder()
        this.testGroup()
        this.testAlign()
        this.testSnap()
        this.testStructure()
        this.testStyle()
        this.testSlides()
        this.testTyping()
        this.testDragSeam()
        this.testMarquee()
        this.testClipboard()
        this.testLocking()
        this.testGrid()
        this.testFlip()
        this.testFormatPainter()
        this.testLayouts()
        this.testMasterEditing()
        this.testTheme()
        this.testBackground()
        this.testNotes()
        this.testHistoryLimit()
        this.testRealDeck()
        this.testShow()
        this.testSharedHistory()
        this.testDeckWideUndo()
        print ""
        print ("passed = " + (to_string passed) + "  failed = " + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testIds:void () {
        print "--- ids ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        this.check("ids handed out" (a.editId > 0))
        this.check("ids are distinct" (a.editId != b.editId))
        def found@(optional):PptxShape (ed.findShape(b.editId))
        this.check("find by id" (!null? found))
        def editable:[PptxShape] (ed.editableShapes())
        this.check("inherited chrome is not editable" ((array_length editable) == 2))
        this.check("history starts with one step" ((ed.historyDepth()) == 1))
        this.check("nothing to undo yet" ((ed.canUndo()) == false))
    }

    fn testHitTest:void () {
        print "--- hit test ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        this.check("inside A" ((ed.hitTest(150.0 150.0)) == a.editId))
        this.check("inside B" ((ed.hitTest(350.0 220.0)) == b.editId))
        this.check("empty slide area" ((ed.hitTest(600.0 60.0)) == 0))
        this.check("layout chrome is not hit" ((ed.hitTest(360.0 520.0)) == 0))
        ; A quarter turn about the centre puts 100x200 where 200x100 was.
        a.rotation = 90.0
        this.check("rotated shape follows its corners" ((ed.hitTest(160.0 60.0)) == a.editId))
        this.check("rotated shape drops the old corner" ((ed.hitTest(110.0 110.0)) == 0))
    }

    fn testSelection:void () {
        print "--- selection ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        this.check("click selects" (ed.selectAt(150.0 150.0 false)))
        this.check("one selected" ((ed.selectionCount()) == 1))
        this.check("it is A" (ed.isSelected(a.editId)))
        ed.selectAt(350.0 220.0 true)
        this.check("shift-click adds" ((ed.selectionCount()) == 2))
        ed.selectAt(350.0 220.0 true)
        this.check("shift-click again removes" ((ed.selectionCount()) == 1))
        ed.selectAt(600.0 60.0 false)
        this.check("click on nothing clears" ((ed.selectionCount()) == 0))
        ed.selectAll()
        this.check("select all skips chrome" ((ed.selectionCount()) == 2))
        def bounds:PptxEditRect (ed.selectionBounds())
        this.check("bounds x" (this.near(bounds.x 100.0)))
        this.check("bounds w" (this.near(bounds.w 320.0)))
        this.check("bounds h" (this.near(bounds.h 160.0)))
        this.check("b is in there" (ed.isSelected(b.editId)))
    }

    fn testMoveUndo:void () {
        print "--- move / undo ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        ed.moveSelection(40.0 -20.0)
        def moved@(optional):PptxShape (ed.findShape(a.editId))
        this.check("moved shape found" (!null? moved))
        if (!null? moved) {
            def m:PptxShape (unwrap moved)
            this.check("moved x" (this.near(m.x 140.0)))
            this.check("moved y" (this.near(m.y 80.0)))
        }
        this.check("undo available" (ed.canUndo()))
        ed.undo()
        def back@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? back) {
            def m2:PptxShape (unwrap back)
            this.check("undo puts it back" (this.near(m2.x 100.0)))
        }
        this.check("selection survives undo" (ed.isSelected(a.editId)))
        ed.redo()
        def again@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? again) {
            def m3:PptxShape (unwrap again)
            this.check("redo moves it again" (this.near(m3.x 140.0)))
        }
    }

    fn testResize:void () {
        print "--- resize / rotate ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        ; Pull the south-east corner 40 right and 20 down.
        ed.resizeSelection(4 40.0 20.0)
        this.check("se corner grows width" (this.near(a.width 240.0)))
        this.check("se corner grows height" (this.near(a.height 120.0)))
        this.check("se corner keeps the origin" (this.near(a.x 100.0)))
        ; The north-west corner moves the origin and shrinks the box.
        ed.resizeSelection(0 40.0 20.0)
        this.check("nw corner moves x" (this.near(a.x 140.0)))
        this.check("nw corner shrinks width" (this.near(a.width 200.0)))
        ; A drag past the far edge stops at the minimum rather than inverting.
        ed.resizeSelection(3 (0.0 - 500.0) 0.0)
        this.check("width clamps to the minimum" (this.near(a.width ed.minSizePt)))
        ed.rotateSelection(45.0)
        this.check("rotation applied" (this.near(a.rotation 45.0)))
        ed.rotateSelection(330.0)
        this.check("rotation wraps" (this.near(a.rotation 15.0)))
        ed.setSelectionRotation(0.0 - 90.0)
        this.check("negative rotation normalizes" (this.near(a.rotation 270.0)))
    }

    fn testMultiResize:void () {
        print "--- multi resize ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        ed.selectAll()
        ; Selection box is 100,100 320x160. Doubling its width doubles the
        ; offsets inside it too, so the arrangement is kept.
        ed.resizeSelection(3 320.0 0.0)
        this.check("first shape scales" (this.near(a.width 400.0)))
        this.check("second shape follows the box" (this.near(b.x 500.0)))
        this.check("heights untouched" (this.near(b.height 60.0)))
    }

    fn testZOrder:void () {
        print "--- z-order ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        this.check("chrome sits first" (((itemAt slide.shapes 0).inherited) == true))
        ed.select(a.editId)
        ed.bringToFront()
        def last:PptxShape (itemAt slide.shapes ((array_length slide.shapes) - 1))
        this.check("to front is painted last" (last.editId == a.editId))
        ed.sendToBack()
        def firstAuthored:PptxShape (itemAt slide.shapes 1)
        this.check("to back stops before the chrome" (firstAuthored.editId == a.editId))
        this.check("chrome stays behind everything" (((itemAt slide.shapes 0).inherited) == true))
        ed.bringForward()
        this.check("forward is one step" (((itemAt slide.shapes 2).editId) == a.editId))
        ed.sendBackward()
        this.check("backward is one step back" (((itemAt slide.shapes 1).editId) == a.editId))
        this.check("b is still there" (b.editId > 0))
    }

    fn testGroup:void () {
        print "--- group / ungroup ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        def aId:int a.editId
        ed.selectAll()
        this.check("group needs two" (ed.groupSelection()))
        this.check("two shapes became one" ((array_length (ed.editableShapes())) == 1))
        def grp:PptxShape (itemAt (ed.editableShapes()) 0)
        this.check("it is a group" (grp.kind == 2))
        this.check("group box is the selection box" (this.near(grp.x 100.0)))
        this.check("group width" (this.near(grp.width 320.0)))
        this.check("child box is identity" (this.near(grp.chX grp.x)))
        this.check("children came along" ((array_length grp.children) == 2))
        this.check("group is selected" (ed.isSelected(grp.editId)))
        ; A shape inside a group is still findable, and a click lands on the
        ; group rather than on the child.
        def inner@(optional):PptxShape (ed.findShape(aId))
        this.check("child still findable by id" (!null? inner))
        this.check("click hits the group" ((ed.hitTest(150.0 150.0)) == grp.editId))
        this.check("ungroup opens it" (ed.ungroupSelection()))
        this.check("shapes are back on the slide" ((array_length (ed.editableShapes())) == 2))
        def back:PptxShape (itemAt (ed.editableShapes()) 0)
        this.check("child kept its position" (this.near(back.x 100.0)))
        this.check("children are selected after ungroup" ((ed.selectionCount()) == 2))
        ed.undo()
        this.check("undo re-groups" ((array_length (ed.editableShapes())) == 1))
        this.check("b is accounted for" (b.editId > 0))
    }

    fn testAlign:void () {
        print "--- align / distribute ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        ; One shape aligns to the slide.
        ed.select(a.editId)
        ed.alignSelection("hcenter")
        this.check("centre on the slide" (this.near(a.x 260.0)))
        ed.alignSelection("bottom")
        this.check("bottom of the slide" (this.near(a.y 440.0)))
        ; Two align to each other.
        ed.selectAll()
        ed.alignSelection("left")
        this.check("left edges agree" (this.near(a.x b.x)))
        ; Three distribute evenly.
        def c (new PptxShape())
        c.x = 600.0
        c.y = 300.0
        c.width = 40.0
        c.height = 40.0
        c.editId = 900
        push slide.shapes c
        ed.clearSelection()
        a.x = 0.0
        b.x = 100.0
        c.x = 300.0
        ed.addToSelection(a.editId)
        ed.addToSelection(b.editId)
        ed.addToSelection(900)
        this.check("distribute needs three" (ed.distributeSelection(true)))
        this.check("middle sits halfway" (this.near(b.x 150.0)))
        this.check("ends stay put" (this.near(c.x 300.0)))
    }

    fn testSnap:void () {
        print "--- snapping ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        ; B's left edge is at 300; drag A's right edge (300) to 302 and it
        ; should come back.
        ed.select(a.editId)
        ed.moveSelectionSnapped(2.0 0.0)
        this.check("snapped back to the neighbour" (this.near(a.x 100.0)))
        this.check("a guide was produced" ((array_length ed.guideX) == 1))
        ; Far enough away and nothing is snapped.
        ed.moveSelectionSnapped(40.0 0.0)
        this.check("a long drag is left alone" (this.near(a.x 140.0)))
        this.check("no guide for a free drag" ((array_length ed.guideX) == 0))
        ed.snapEnabled = false
        ed.moveSelectionSnapped(2.0 0.0)
        this.check("snapping can be turned off" (this.near(a.x 142.0)))
        this.check("b untouched" (this.near(b.x 300.0)))
    }

    fn testStructure:void () {
        print "--- insert / delete / duplicate ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def id:int (ed.addShapeAt("roundRect" 50.0 50.0 80.0 40.0))
        this.check("insert returns an id" (id > 0))
        this.check("insert selects the new shape" (ed.isSelected(id)))
        this.check("three editable shapes" ((array_length (ed.editableShapes())) == 3))
        def txt:int (ed.addTextBox(400.0 400.0 200.0 60.0 "Hello\nWorld"))
        def tshape@(optional):PptxShape (ed.findShape(txt))
        this.check("text box exists" (!null? tshape))
        if (!null? tshape) {
            def t:PptxShape (unwrap tshape)
            this.check("text box has text" (t.hasText))
            this.check("newline becomes a paragraph" ((array_length t.text.paragraphs) == 2))
            this.check("text reads back" ((t.text.plainText()) == "Hello\nWorld"))
        }
        ed.select(id)
        this.check("duplicate works" (ed.duplicateSelection()))
        this.check("duplicate selects the copy" ((ed.isSelected(id)) == false))
        this.check("five shapes now" ((array_length (ed.editableShapes())) == 5))
        def copyId:int (itemAt ed.selection 0)
        def copy@(optional):PptxShape (ed.findShape(copyId))
        if (!null? copy) {
            def c:PptxShape (unwrap copy)
            this.check("copy is offset" (this.near(c.x 60.0)))
        }
        this.check("delete removes it" (ed.deleteSelection()))
        this.check("four shapes left" ((array_length (ed.editableShapes())) == 4))
        this.check("delete clears the selection" ((ed.selectionCount()) == 0))
        ed.undo()
        this.check("undo brings it back" ((array_length (ed.editableShapes())) == 5))
        ; Chrome cannot be deleted, because it cannot be selected.
        def chrome:PptxShape (itemAt ((itemAt deck.slides 0).shapes) 0)
        ed.select(chrome.editId)
        this.check("chrome cannot be deleted" ((ed.deleteSelection()) == false))
    }

    fn testStyle:void () {
        print "--- style / text ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        ed.setFillHex("FF0000")
        this.check("fill set" (a.fill.srgb == "FF0000"))
        ed.setLineHex("000000" 1.5)
        this.check("line colour" (a.line.srgb == "000000"))
        this.check("line width" (this.near(a.lineWidthPt 1.5)))
        ed.clearFill()
        this.check("fill cleared" ((a.fill.isSet) == false))
        ed.setPreset("ellipse")
        this.check("preset changed" (a.preset == "ellipse"))
        ed.setShapeText(a.editId "Title")
        this.check("text set" ((a.text.plainText()) == "Title"))
        this.check("shape now carries text" (a.hasText))
        ed.setTextBold(true)
        ed.setTextSizePt(28.0)
        ed.setTextColorHex("112233")
        def para:PptxParagraph (itemAt a.text.paragraphs 0)
        def run:PptxTextRun (itemAt para.runs 0)
        this.check("bold" (run.bold))
        this.check("size" (this.near(run.fontSizePt 28.0)))
        this.check("colour" (run.color.srgb == "112233"))
        ed.setTextAlign("ctr")
        this.check("paragraph align" (para.align == "ctr"))
        ; Retyping keeps the look that was set.
        ed.setShapeText(a.editId "Second")
        def para2:PptxParagraph (itemAt a.text.paragraphs 0)
        def run2:PptxTextRun (itemAt para2.runs 0)
        this.check("retyped text keeps bold" (run2.bold))
        this.check("retyped text keeps size" (this.near(run2.fontSizePt 28.0)))
        this.check("retyped text keeps align" (para2.align == "ctr"))
        this.check("selection text reads back" ((ed.selectionText()) == "Second"))
    }

    fn testSlides:void () {
        print "--- slides ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        this.check("one slide to start" ((ed.slideCount()) == 1))
        this.check("delete refuses the last slide" ((ed.deleteSlide()) == false))
        this.check("add a slide" (ed.addSlide()))
        this.check("two slides" ((ed.slideCount()) == 2))
        this.check("the new one is in front of you" (ed.slideIndex == 1))
        this.check("new slide is empty" ((array_length (ed.editableShapes())) == 0))
        ed.gotoSlide(0)
        this.check("duplicate a slide" (ed.duplicateSlide()))
        this.check("three slides" ((ed.slideCount()) == 3))
        this.check("the copy is in front of you" (ed.slideIndex == 1))
        this.check("copy carries the shapes" ((array_length (ed.editableShapes())) == 2))
        ; A duplicated slide gets its own ids, or selecting on one would
        ; select on the other.
        def orig:PptxSlide (itemAt deck.slides 0)
        def copy:PptxSlide (itemAt deck.slides 1)
        def o0:PptxShape (itemAt orig.shapes 0)
        def c0:PptxShape (itemAt copy.shapes 0)
        this.check("copies get fresh ids" (o0.editId != c0.editId))
        this.check("move a slide down" (ed.moveSlide(1)))
        this.check("index follows the slide" (ed.slideIndex == 2))
        this.check("move refuses to walk off the end" ((ed.moveSlide(1)) == false))
        this.check("delete a slide" (ed.deleteSlide()))
        this.check("two slides left" ((ed.slideCount()) == 2))
        ed.undo()
        this.check("undo restores the slide" ((ed.slideCount()) == 3))
    }

    ; The editor's own contract on a real deck: ids over parsed shapes, a hit
    ; test in slide points, and a move that survives a round trip.
    fn testRealDeck:void () {
        print "--- a parsed deck ---"
        def parser (new PptxParser())
        def ok:boolean (parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx"))
        this.check("open the business deck" ok)
        if (ok == false) {
            return
        }
        def resolver (new PptxResolver())
        def raw:PptxPresentation (parser.parsePresentation())
        def pres:PptxPresentation (resolver.resolvePresentation(raw))
        def ed (new PptxEditor())
        ed.attach(pres)
        this.check("slides came through" ((ed.slideCount()) > 1))
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("slide one has authored shapes" ((array_length shapes) > 0))
        def first:PptxShape (itemAt shapes 0)
        this.check("parsed shapes got ids" (first.editId > 0))
        def cx:double (first.x + (first.width * 0.5))
        def cy:double (first.y + (first.height * 0.5))
        def hit:int (ed.hitTest(cx cy))
        this.check("a click in a shape finds a shape" (hit > 0))
        ed.select(hit)
        def before@(optional):PptxShape (ed.findShape(hit))
        def x0:double 0.0
        if (!null? before) {
            def bs:PptxShape (unwrap before)
            x0 = bs.x
        }
        ed.moveSelection(12.0 0.0)
        def after@(optional):PptxShape (ed.findShape(hit))
        if (!null? after) {
            def m:PptxShape (unwrap after)
            this.check("it moved on the real deck" (this.near(m.x (x0 + 12.0))))
        }
        ed.undo()
        def back@(optional):PptxShape (ed.findShape(hit))
        if (!null? back) {
            def m2:PptxShape (unwrap back)
            this.check("and moved back" (this.near(m2.x x0)))
        }
        this.check("the deck is marked changed" (ed.dirty))
        parser.close()
    }

    fn testHistoryLimit:void () {
        print "--- history ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        ed.historyLimit = 5
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        def i:int 0
        while (i < 20) {
            ed.moveSelection(1.0 0.0)
            i = (i + 1)
        }
        this.check("history is capped" ((ed.historyDepth()) == 5))
        this.check("still undoable" (ed.canUndo()))
        ; A new step after an undo drops the redo tail — the future you did
        ; not take.
        ed.undo()
        this.check("redo available after undo" (ed.canRedo()))
        ed.moveSelection(1.0 0.0)
        this.check("a new step drops the redo tail" ((ed.canRedo()) == false))
    }


    fn testTyping:void () {
        print "--- typing ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        def depth0:int (ed.historyDepth())
        ed.appendText("H")
        ed.appendText("i")
        this.check("characters land on the shape" ((a.text.plainText()) == "Hi"))
        this.check("a burst of typing is one step" ((ed.historyDepth()) == (depth0 + 1)))
        ed.backspaceText()
        this.check("backspace takes one back" ((a.text.plainText()) == "H"))
        this.check("still one step" ((ed.historyDepth()) == (depth0 + 1)))
        ed.undo()
        ; Undo swaps the deck for the snapshot's copy, so a held reference is
        ; stale by design — a host looks the shape up again by id.
        def after@(optional):PptxShape (ed.findShape(a.editId))
        this.check("undo hands back a live shape" (!null? after))
        if (!null? after) {
            def t:PptxShape (unwrap after)
            this.check("undo drops the whole burst" ((t.text.plainText()) == ""))
        }
        ; A move between bursts breaks the coalescing.
        ed.appendText("A")
        ed.moveSelection(1.0 0.0)
        ed.appendText("B")
        this.check("a new burst after a move is its own step" ((ed.historyDepth()) == (depth0 + 3)))
    }

    fn testDragSeam:void () {
        print "--- drag seam ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        def depth0:int (ed.historyDepth())
        ; What a host does between press and release: apply, apply, apply,
        ; then one snapshot.
        def i:int 0
        while (i < 10) {
            ed.applyMove(1.0 0.5)
            i = (i + 1)
        }
        this.check("the shape followed the pointer" (this.near(a.x 110.0)))
        this.check("no history yet" ((ed.historyDepth()) == depth0))
        ed.pushSnapshot("move")
        this.check("release is one step" ((ed.historyDepth()) == (depth0 + 1)))
        def j:int 0
        while (j < 5) {
            ed.applyResize(4 2.0 0.0)
            j = (j + 1)
        }
        this.check("resize followed the pointer" (this.near(a.width 210.0)))
        this.check("resize drag is not history either" ((ed.historyDepth()) == (depth0 + 1)))
        ed.undo()
        def back@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? back) {
            def m:PptxShape (unwrap back)
            this.check("undo after a live drag restores the press" (this.near(m.x 100.0)))
            this.check("and the size it was pressed at" (this.near(m.width 200.0)))
        }
    }


    fn testMarquee:void () {
        print "--- a rubber band ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        ; A band over both.
        this.check("a band takes what it touches" ((ed.selectInRect(80.0 80.0 400.0 300.0 false)) == 2))
        this.check("both are selected" ((ed.selectionCount()) == 2))
        ; A band that touches only one.
        ed.selectInRect(80.0 80.0 60.0 60.0 false)
        this.check("a smaller band takes one" ((ed.selectionCount()) == 1))
        this.check("and it is the one it touched" (ed.isSelected(a.editId)))
        ; A band drawn backwards is the same band.
        ed.selectInRect(480.0 380.0 (0.0 - 400.0) (0.0 - 300.0) false)
        this.check("a band drawn upwards works too" ((ed.selectionCount()) == 2))
        ; Empty canvas takes nothing, and the chrome is never taken.
        ed.selectInRect(600.0 40.0 40.0 40.0 false)
        this.check("a band over nothing takes nothing" ((ed.selectionCount()) == 0))
        this.check("a band over the whole slide skips the chrome" ((ed.selectInRect(0.0 0.0 720.0 540.0 false)) == 2))
        this.check("b was in it" (ed.isSelected(b.editId)))
        ; Additive keeps what was there.
        ed.select(a.editId)
        ed.selectInRect(290.0 190.0 140.0 80.0 true)
        this.check("an additive band adds" ((ed.selectionCount()) == 2))
    }

    fn testClipboard:void () {
        print "--- copy, cut, paste ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        this.check("nothing on the clipboard yet" ((ed.clipboardCount()) == 0))
        this.check("pasting nothing does nothing" ((ed.pasteClipboard(true)) == false))
        ed.select(a.editId)
        this.check("copy takes one" ((ed.copySelection()) == 1))
        this.check("the clipboard has it" ((ed.clipboardCount()) == 1))
        this.check("the slide still has both" ((array_length (ed.editableShapes())) == 2))
        this.check("paste puts it down" (ed.pasteClipboard(true)))
        this.check("three shapes now" ((array_length (ed.editableShapes())) == 3))
        this.check("and the pasted one is selected" ((ed.selectionCount()) == 1))
        def pastedId:int (itemAt ed.selection 0)
        this.check("it is a new shape, not the old one" (pastedId != a.editId))
        def pasted@(optional):PptxShape (ed.findShape(pastedId))
        if (!null? pasted) {
            def ps:PptxShape (unwrap pasted)
            this.check("offset from the original" (this.near(ps.x (a.x + 10.0))))
        }
        ; Pasting again makes another, from the same clipboard.
        ed.pasteClipboard(true)
        this.check("pasting again makes another" ((array_length (ed.editableShapes())) == 4))
        ; On another slide it lands where it was.
        ed.addSlide()
        this.check("a new slide is empty" ((array_length (ed.editableShapes())) == 0))
        ed.pasteClipboard(false)
        this.check("pasting on another slide works" ((array_length (ed.editableShapes())) == 1))
        def onTwo:PptxShape (itemAt (ed.editableShapes()) 0)
        this.check("and keeps its place" (this.near(onTwo.x a.x)))
        ; Cut removes what it took.
        ed.gotoSlide(0)
        def before:int (array_length (ed.editableShapes()))
        ed.select(a.editId)
        this.check("cut takes one" ((ed.cutSelection()) == 1))
        this.check("and the slide is one shorter" ((array_length (ed.editableShapes())) == (before - 1)))
        this.check("undo brings it back" (ed.undo()))
    }

    fn testLocking:void () {
        print "--- locking ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        this.check("not locked to begin with" ((ed.selectionLocked()) == false))
        this.check("lock it" (ed.setLocked(true)))
        def locked@(optional):PptxShape (ed.findShape(a.editId))
        this.check("the shape says so" (!null? locked))
        if (null? locked) {
            return
        }
        def ls:PptxShape (unwrap locked)
        this.check("selection reports it" (ed.selectionLocked()))
        def x0:double ls.x
        ed.moveSelection(30.0 30.0)
        this.check("a locked shape does not move" (this.near(ls.x x0)))
        ed.resizeSelection(4 40.0 40.0)
        this.check("nor resize" (this.near(ls.width 200.0)))
        ed.rotateSelection(45.0)
        this.check("nor rotate" (this.near(ls.rotation 0.0)))
        this.check("nor delete" ((ed.deleteSelection()) == false))
        this.check("but it can still be selected" (ed.isSelected(ls.editId)))
        ed.setLocked(false)
        ed.moveSelection(30.0 0.0)
        def freed@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? freed) {
            def fs:PptxShape (unwrap freed)
            this.check("unlocked, it moves again" (this.near(fs.x (x0 + 30.0))))
        }
        ; A locked shape in a mixed selection holds still while the others move.
        def b:PptxShape (itemAt (ed.editableShapes()) 1)
        ed.select(a.editId)
        ed.setLocked(true)
        ed.addToSelection(b.editId)
        def bx:double b.x
        def ax:double ((itemAt (ed.editableShapes()) 0).x)
        ed.moveSelection(25.0 0.0)
        def shapesNow:[PptxShape] (ed.editableShapes())
        this.check("the locked one stayed" (this.near(((itemAt shapesNow 0).x) ax)))
        this.check("the free one moved" (this.near(((itemAt shapesNow 1).x) (bx + 25.0))))
    }

    fn testGrid:void () {
        print "--- the grid ---"
        this.check("a step rounds to the nearest" (this.near((PptxEditor.snapToStep(11.0 9.0)) 9.0)))
        this.check("upwards too" (this.near((PptxEditor.snapToStep(14.0 9.0)) 18.0)))
        def negStep:double (PptxEditor.snapToStep((0.0 - 11.0) 9.0))
        this.check("and negatives" (this.near(negStep (0.0 - 9.0))))
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ; Away from its neighbour, so only the grid is near.
        a.x = 500.0
        a.y = 400.0
        ed.select(a.editId)
        ed.setGrid(true)
        ed.gridPt = 10.0
        ed.moveSelectionSnapped(2.0 0.0)
        def moved@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? moved) {
            def ms:PptxShape (unwrap moved)
            this.check("a small drag lands on the grid" (this.near(ms.x 500.0)))
        }
        ed.setGrid(false)
        ed.moveSelectionSnapped(2.0 0.0)
        def free@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? free) {
            def fs:PptxShape (unwrap free)
            this.check("with the grid off it goes where it was pushed" (this.near(fs.x 502.0)))
        }
    }


    fn testFlip:void () {
        print "--- mirroring ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        ed.select(a.editId)
        this.check("nothing is mirrored to begin with" ((a.flipH == false) && (a.flipV == false)))
        this.check("flip across" (ed.flipSelection(true)))
        this.check("it took" a.flipH)
        this.check("and only across" (a.flipV == false))
        this.check("the box did not move" (this.near(a.x 100.0)))
        this.check("nor change size" (this.near(a.width 200.0)))
        ed.flipSelection(true)
        this.check("flipping again puts it back" (a.flipH == false))
        ed.flipSelection(false)
        this.check("flip down" a.flipV)
        ed.undo()
        def back@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? back) {
            def bs:PptxShape (unwrap back)
            this.check("undo unmirrors it" (bs.flipV == false))
        }
        ; A locked shape does not mirror either.
        def c@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? c) {
            def cs:PptxShape (unwrap c)
            ed.select(cs.editId)
            ed.setLocked(true)
            ed.flipSelection(true)
            this.check("a locked shape does not mirror" (cs.flipH == false))
        }
    }

    fn testFormatPainter:void () {
        print "--- the format painter ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def b:PptxShape (itemAt slide.shapes 2)
        this.check("nothing picked up yet" ((ed.hasFormat()) == false))
        this.check("and nothing to paint" ((ed.applyFormat()) == false))
        ; Dress the first shape up.
        ed.select(a.editId)
        ed.setFillHex("C00000")
        ed.setLineHex("203864" 3.0)
        ed.setShapeText(a.editId "Styled")
        ed.setTextBold(true)
        ed.setTextSizePt(28.0)
        ed.setTextColorHex("FFFFFF")
        ed.setTextAlign("ctr")
        this.check("pick the formatting up" (ed.copyFormat()))
        this.check("the editor is holding it" (ed.hasFormat()))
        ; Paint it onto the other one, which has text of its own.
        ed.select(b.editId)
        ed.setShapeText(b.editId "Plain")
        this.check("paint it on" (ed.applyFormat()))
        def painted@(optional):PptxShape (ed.findShape(b.editId))
        this.check("the target is there" (!null? painted))
        if (null? painted) {
            return
        }
        def ps:PptxShape (unwrap painted)
        this.check("the fill came across" (ps.fill.srgb == "C00000"))
        this.check("the outline too" (ps.line.srgb == "203864"))
        this.check("and its width" (this.near(ps.lineWidthPt 3.0)))
        def para:PptxParagraph (itemAt ps.text.paragraphs 0)
        def run:PptxTextRun (itemAt para.runs 0)
        this.check("the text is bold now" run.bold)
        this.check("and the size came across" (this.near(run.fontSizePt 28.0)))
        this.check("and the colour" (run.color.srgb == "FFFFFF"))
        this.check("and the alignment" (para.align == "ctr"))
        this.check("but the words are the target's own" ((ps.text.plainText()) == "Plain"))
        this.check("and its geometry is untouched" ((this.near(ps.x 300.0)) && (this.near(ps.width 120.0))))
        ed.undo()
        def before@(optional):PptxShape (ed.findShape(b.editId))
        if (!null? before) {
            def bs:PptxShape (unwrap before)
            this.check("undo takes the paint off" (bs.fill.srgb != "C00000"))
        }
    }


    ; --- the document, not the slide ------------------------------------------

    fn testTheme:void () {
        print "--- re-theming ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ; A shape whose colour came from the palette, the way a real deck's do.
        def slide:PptxSlide (itemAt deck.slides 0)
        def a:PptxShape (itemAt slide.shapes 1)
        def themed (new PptxColor())
        themed.isSet = true
        themed.isScheme = true
        themed.scheme = "accent1"
        themed.srgb = "4472C4"
        a.fill = themed
        ; …and one that was picked by hand, which must not move.
        def b:PptxShape (itemAt slide.shapes 2)
        b.fill = (PptxColor.srgbOf("123456"))
        deck.theme.setColor("accent1" "4472C4")
        ed.attach(deck)
        this.check("the deck starts on its own palette" ((ed.themeColor("accent1")) == "4472C4"))
        this.check("a palette applies" (ed.applyPalette("forest")))
        this.check("the theme took it" ((ed.themeColor("accent1")) == "217346"))
        def after@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? after) {
            def sh:PptxShape (unwrap after)
            this.check("a palette colour followed the theme" (sh.fill.srgb == "217346"))
            this.check("and still knows where it came from" (sh.fill.scheme == "accent1"))
        }
        def other@(optional):PptxShape (ed.findShape(b.editId))
        if (!null? other) {
            def sh2:PptxShape (unwrap other)
            this.check("a colour picked by hand did not move" (sh2.fill.srgb == "123456"))
        }
        this.check("one slot can be set on its own" (ed.setThemeColor("accent1" "FF0000")))
        def again@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? again) {
            def sh3:PptxShape (unwrap again)
            this.check("and that followed too" (sh3.fill.srgb == "FF0000"))
        }
        this.check("undo puts the palette back" (ed.undo()))
        def back@(optional):PptxShape (ed.findShape(a.editId))
        if (!null? back) {
            def sh4:PptxShape (unwrap back)
            this.check("and the colour with it" (sh4.fill.srgb == "217346"))
        }
        this.check("an unknown palette is the default one" (ed.applyPalette("no-such-palette")))
        this.check("which is Office's" ((ed.themeColor("accent2")) == "ED7D31"))
        this.check("there are palettes to choose from" ((array_length (PptxEditor.paletteNames())) >= 4))
    }

    fn testBackground:void () {
        print "--- the slide's background ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        def slide:PptxSlide (itemAt deck.slides 0)
        this.check("set it" (ed.setSlideBackground("FFF2CC")))
        this.check("it took" (slide.bg.srgb == "FFF2CC"))
        this.check("a scheme background" (ed.setSlideBackgroundScheme("accent2")))
        this.check("resolves through the theme" (slide.bg.isScheme))
        this.check("and follows a re-theme" ((strlen slide.bg.srgb) == 6))
        def was:string slide.bg.srgb
        ed.applyPalette("berry")
        this.check("the background moved with the palette" (slide.bg.srgb != was))
        this.check("clear it" (ed.clearSlideBackground()))
        this.check("and it is unset" ((slide.bg.isSet) == false))
        ed.undo()
        def slideNow:PptxSlide (itemAt deck.slides 0)
        this.check("undo brings the background back" (slideNow.bg.isSet))
    }

    fn testNotes:void () {
        print "--- the speaker's notes ---"
        def ed (new PptxEditor())
        def deck:PptxPresentation (this.buildDeck())
        ed.attach(deck)
        this.check("a slide starts with none" ((ed.notesText()) == ""))
        this.check("set them" (ed.setNotes("Remember the numbers"))) 
        this.check("they read back" ((ed.notesText()) == "Remember the numbers"))
        ; The notes are a shape, so the caret works on them — and they are not
        ; on the slide, so editing them selects nothing.
        this.check("the caret can go there" (ed.editNotes()))
        this.check("and it knows it is in the notes" (ed.isEditingNotes()))
        this.check("nothing on the slide is selected" ((ed.selectionCount()) == 0))
        ed.typeAtCaret("!")
        this.check("typing lands in the notes" ((ed.notesText()) == "Remember the numbers!"))
        ed.moveCaretBy("home" false)
        ed.typeAtCaret("PS: ")
        this.check("and the caret moves in them" ((ed.notesText()) == "PS: Remember the numbers!"))
        ed.endTextEdit()
        this.check("editing ends" ((ed.isEditingNotes()) == false))
        ed.undo()
        this.check("undo takes the typing back" ((ed.notesText()) != "PS: Remember the numbers!"))
        ; Notes belong to their own slide.
        ed.addSlide()
        this.check("a new slide has none" ((ed.notesText()) == ""))
        ed.setNotes("second")
        ed.gotoSlide(0)
        this.check("and the first slide kept its own" ((ed.notesText()) != "second"))
    }


    fn testLayouts:void () {
        print "--- picking a layout ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        def parts:[string] (ed.layoutParts())
        this.check("the deck has layouts to pick from" ((array_length parts) > 1))
        if ((array_length parts) < 2) {
            return
        }
        ed.gotoSlide(1)
        def was:string (ed.slideLayout())
        this.check("the slide is on one of them" ((strlen was) > 0))
        ; Pick the other one.
        def other:string (itemAt parts 0)
        if (other == was) {
            other = (itemAt parts 1)
        }
        def authoredBefore:int (array_length (ed.editableShapes()))
        this.check("apply it" (ed.applyLayout(other)))
        this.check("the slide says so" ((ed.slideLayout()) == other))
        this.check("what the slide itself declares is untouched" ((array_length (ed.editableShapes())) == authoredBefore))
        ; The chrome came from the new layout: every inherited shape has an id
        ; of its own, and there is some.
        def slide:PptxSlide (itemAt pres.slides 1)
        def inherited:int 0
        def ids:boolean true
        def i:int 0
        while (i < (array_length slide.shapes)) {
            def sh:PptxShape (itemAt slide.shapes i)
            if sh.inherited {
                inherited = (inherited + 1)
                if (sh.editId == 0) {
                    ids = false
                }
            }
            i = (i + 1)
        }
        this.check("the new layout brought chrome with it" (inherited > 0))
        this.check("and every piece of it has an id" ids)
        this.check("undo puts the old layout back" (ed.undo()))
        this.check("and says so" ((ed.slideLayout()) == was))
        this.check("an unknown layout is refused" ((ed.applyLayout("ppt/slideLayouts/nope.xml")) == false))
        parser.close()
    }


    fn testMasterEditing:void () {
        print "--- editing the master ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "11-master-background.pptx")) == false) {
            this.check("open 11-master-background" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        def masters:[string] (ed.masterParts())
        this.check("the deck has a master" ((array_length masters) > 0))
        if ((array_length masters) == 0) {
            return
        }
        def slide:PptxSlide (itemAt pres.slides 0)
        def chromeBefore:int 0
        def i:int 0
        while (i < (array_length slide.shapes)) {
            if (((itemAt slide.shapes i).inherited)) {
                chromeBefore = (chromeBefore + 1)
            }
            i = (i + 1)
        }
        this.check("and the slide inherits chrome from it" (chromeBefore > 0))
        this.check("not editing a sheet to begin with" ((ed.isEditingSheet()) == false))
        def part:string (itemAt masters 0)
        this.check("step into the master" (ed.editSheet(part)))
        this.check("it says which one" ((ed.editingSheetPart()) == part))
        def masterShapes:int (array_length (ed.editableShapes()))
        this.check("the master's own shapes are what is editable" (masterShapes > 0))
        ; Put something on the master and give it back to the deck.
        def added:int (ed.addShapeAt("rect" 10.0 10.0 60.0 20.0))
        this.check("a shape can be added to it" (added > 0))
        this.check("step out again" (ed.exitSheet()))
        this.check("and it is no longer a sheet being edited" ((ed.isEditingSheet()) == false))
        def slideAfter:PptxSlide (itemAt pres.slides 0)
        def chromeAfter:int 0
        def j:int 0
        while (j < (array_length slideAfter.shapes)) {
            if (((itemAt slideAfter.shapes j).inherited)) {
                chromeAfter = (chromeAfter + 1)
            }
            j = (j + 1)
        }
        this.check("the slide inherited the new chrome" (chromeAfter == (chromeBefore + 1)))
        ; The sheet itself is marked, so a save knows to rewrite its part.
        def sheet@(optional):PptxSheet (ed.sheetFor(part))
        if (!null? sheet) {
            this.check("the master is marked as changed" (((unwrap sheet).dirty)))
        }
        ; Undo reaches inside a master, because the snapshots carry the sheets.
        ed.editSheet(part)
        def beforeUndo:int (array_length (ed.editableShapes()))
        this.check("undo works in there" (ed.undo()))
        this.check("and it took the shape back" ((array_length (ed.editableShapes())) == (beforeUndo - 1)))
        ed.exitSheet()
        this.check("an unknown sheet is refused" ((ed.editSheet("ppt/slideMasters/none.xml")) == false))
        parser.close()
    }

    ; --- the show ------------------------------------------------------------

    fn testShow:void () {
        print "--- transitions and builds ---"
        def parser (new PptxParser())
        def ok:boolean (parser.openParts("gallery/pptx/fixtures" "28-transitions.pptx"))
        this.check("open the show fixture" ok)
        if (ok == false) {
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        def slide1:PptxSlide (itemAt pres.slides 0)
        this.check("slide one has a transition" slide1.transition.isSet)
        this.check("and it is a fade" (slide1.transition.kind == "fade"))
        this.check("a medium fade is three quarters of a second" (this.near(slide1.transition.seconds 0.75)))
        def slide2:PptxSlide (itemAt pres.slides 1)
        this.check("slide two pushes" (slide2.transition.kind == "push"))
        this.check("upwards" (slide2.transition.dir == "u"))
        this.check("and advances on its own after four seconds" (this.near(slide2.transition.afterSeconds 4.0)))

        this.check("slide one has a two-step build" ((array_length slide1.build) == 2))
        if ((array_length slide1.build) == 2) {
            def b0:PptxBuildStep (itemAt slide1.build 0)
            def b1:PptxBuildStep (itemAt slide1.build 1)
            this.check("the first step fades" (b0.kind == "fade"))
            this.check("the second wipes" (b1.kind == "wipe(right)"))
            this.check("the first waits for a click" (b0.start == "click"))
            this.check("the second runs three quarters of a second" (this.near(b1.seconds 0.75)))
            ; The file names shapes by its own number; the editor names them by
            ; editId, and the two have to have been linked on attach.
            this.check("the first step names a shape the editor knows" (b0.editId > 0))
            this.check("and the two steps are different shapes" (b0.editId != b1.editId))
        }

        ; What is on screen at each step of the build.
        def notAnimated:PptxShape (itemAt slide1.shapes 0)
        this.check("a shape with no step is there from the start" (ed.shapeVisibleAt(slide1 notAnimated 0)))
        def firstStep:PptxBuildStep (itemAt slide1.build 0)
        def animated@(optional):PptxShape (ed.findShape(firstStep.editId))
        this.check("the animated shape is found" (!null? animated))
        if (!null? animated) {
            def an:PptxShape (unwrap animated)
            this.check("it is not there at step 0" ((ed.shapeVisibleAt(slide1 an 0)) == false))
            this.check("and it is after one click" (ed.shapeVisibleAt(slide1 an 1)))
        }

        ; Setting one from the editor.
        ed.gotoSlide(1)
        this.check("a transition can be set" (ed.setTransition("wipe" "d" 0.5)))
        this.check("and reads back" ((ed.transitionKind()) == "wipe"))
        this.check("clearing it works" (ed.setTransition("" "" 0.0)))
        this.check("and it reads as none" ((ed.transitionKind()) == ""))
        ed.undo()
        this.check("undo brings the transition back" ((ed.transitionKind()) == "wipe"))

        ; Animating a selection, and reordering the build.
        ed.gotoSlide(0)
        this.check("clearing the build works" (ed.clearAnimation()))
        this.check("and there is nothing left" ((ed.buildCount()) == 0))
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("the slide has shapes to animate" ((array_length shapes) >= 2))
        if ((array_length shapes) >= 2) {
            def s1:PptxShape (itemAt shapes 0)
            def s2:PptxShape (itemAt shapes 1)
            ed.select(s1.editId)
            ed.addToSelection(s2.editId)
            this.check("both can be animated" (ed.animateSelection("fade" 0.4)))
            this.check("which is two steps" ((ed.buildCount()) == 2))
            this.check("animating them again does not double them" (ed.animateSelection("wipe" 0.4)))
            this.check("still two steps" ((ed.buildCount()) == 2))
            def slide:PptxSlide (itemAt pres.slides 0)
            def step0:PptxBuildStep (itemAt slide.build 0)
            def was:int step0.editId
            this.check("a step can be moved later" (ed.moveBuildStep(0 1)))
            def step1:PptxBuildStep (itemAt slide.build 1)
            def now:int step1.editId
            this.check("and it went there" (now == was))
            this.check("moving nowhere is refused" ((ed.moveBuildStep(1 1)) == false))
            this.check("moving off the end is refused" ((ed.moveBuildStep(0 9)) == false))
            ed.undo()
            ; Undo restores the deck, so the slide has to be looked up again.
            def after:PptxSlide (itemAt pres.slides 0)
            def stepBack:PptxBuildStep (itemAt after.build 0)
            def back:int stepBack.editId
            this.check("undo puts the order back" (back == was))
        }
        parser.close()
    }


    ; --- history that does not copy the deck ----------------------------------
    ;
    ; A step shares its copies of the slides that did not change, which is the
    ; whole of phase E7's history work and the one place where being wrong is
    ; silent: a shared copy that goes stale gives an undo that restores the
    ; wrong thing, and nothing else notices. The rule it rests on is that a
    ; slide's revision changes whenever its content does, so these are the
    ; checks that the rule holds — including for the two operations that
    ; rewrite EVERY slide rather than the one in front of you.

    fn testSharedHistory:void () {
        print "--- a step copies only what changed ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        this.check("the deck has several slides" ((ed.slideCount()) > 2))
        this.check("every slide got a key" (PptxEditorTest.allKeyed(pres)))
        this.check("and the keys are all different" (PptxEditorTest.keysUnique(pres)))

        ; A step on slide two shares slide one's copy with the step before it.
        ed.gotoSlide(1)
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("slide two has a shape" ((array_length shapes) > 0))
        if ((array_length shapes) == 0) {
            parser.close()
            return
        }
        def sh:PptxShape (itemAt shapes 0)
        ed.select(sh.editId)
        ed.moveSelection(10.0 0.0)
        def a:PptxEditSnapshot (itemAt ed.history ((array_length ed.history) - 2))
        def b:PptxEditSnapshot (itemAt ed.history ((array_length ed.history) - 1))
        def shared:PptxSlide (itemAt a.slides 0)
        def shared2:PptxSlide (itemAt b.slides 0)
        this.check("the slide that did not change is the same copy" (shared.revision == shared2.revision))
        def moved:PptxSlide (itemAt a.slides 1)
        def moved2:PptxSlide (itemAt b.slides 1)
        this.check("and the one that did is a different one" (moved.revision != moved2.revision))

        ; The copy the history holds must not be reachable from the deck: move
        ; the shape again and the earlier copy has to stay where it was.
        def kept0:PptxShape (itemAt moved.shapes 0)
        def before:double kept0.x
        ed.moveSelection(25.0 0.0)
        def kept1:PptxShape (itemAt moved.shapes 0)
        def after:double kept1.x
        this.check("a copy in the history is not the live slide" (before == after))

        ; And the undo it is all for.
        def liveNow@(optional):PptxShape (ed.findShape(sh.editId))
        def x1:double 0.0
        if (!null? liveNow) {
            def ln:PptxShape (unwrap liveNow)
            x1 = ln.x
        }
        ed.undo()
        ed.undo()
        def liveBack@(optional):PptxShape (ed.findShape(sh.editId))
        this.check("the shape survives two undos" (!null? liveBack))
        if (!null? liveBack) {
            def back:PptxShape (unwrap liveBack)
            this.check("and is back where it started" (back.x < (x1 - 30.0)))
        }
        ed.redo()
        ed.redo()
        def liveFwd@(optional):PptxShape (ed.findShape(sh.editId))
        if (!null? liveFwd) {
            def lf:PptxShape (unwrap liveFwd)
            this.check("redo puts it back again" (PptxEditorTest.near2(lf.x x1)))
        }
        parser.close()
    }

    fn testDeckWideUndo:void () {
        print "--- the operations that rewrite every slide ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck for palettes" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ; Re-theming touches every slide, and a history that shares its copies
        ; would give back the old colours on the slides it thought unchanged.
        ; The deck's own fills are hand-picked and deliberately do not move, so
        ; a scheme colour is put on each slide first — that is what a palette
        ; is about, and what has to come back.
        def si:int 0
        while (si < (array_length pres.slides)) {
            ed.gotoSlide(si)
            ed.setSlideBackgroundScheme("accent1")
            si = (si + 1)
        }
        def sig0:string (PptxEditorTest.colourSignature(pres))
        this.check("the deck has colours to change" ((strlen sig0) > 0))
        this.check("a palette can be applied" (ed.applyPalette("forest")))
        def sig1:string (PptxEditorTest.colourSignature(pres))
        this.check("and every slide changed" (sig1 != sig0))
        ed.undo()
        def sig2:string (PptxEditorTest.colourSignature(pres))
        this.check("undo puts every slide back" (sig2 == sig0))
        ed.redo()
        this.check("and redo takes them all forward" ((PptxEditorTest.colourSignature(pres)) == sig1))

        ; A footer goes on the master and re-merges the chrome onto every
        ; slide — the other deck-wide operation.
        def count0:int (PptxEditorTest.shapeTotal(pres))
        this.check("a footer can be set" (ed.setFooter("Internal only")))
        def count1:int (PptxEditorTest.shapeTotal(pres))
        this.check("which reaches every slide" (count1 > count0))
        ed.undo()
        this.check("and undo takes it off all of them" ((PptxEditorTest.shapeTotal(pres)) == count0))
        parser.close()
    }

    sfn allKeyed:boolean (pres:PptxPresentation) {
        def i:int 0
        while (i < (array_length pres.slides)) {
            def sl:PptxSlide (itemAt pres.slides i)
            if (sl.key == 0) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn keysUnique:boolean (pres:PptxPresentation) {
        def i:int 0
        while (i < (array_length pres.slides)) {
            def a:PptxSlide (itemAt pres.slides i)
            def k:int (i + 1)
            while (k < (array_length pres.slides)) {
                def b:PptxSlide (itemAt pres.slides k)
                if (a.key == b.key) {
                    return false
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return true
    }

    ; Every fill on every slide, run together — one string that changes if any
    ; colour anywhere in the deck does.
    sfn colourSignature:string (pres:PptxPresentation) {
        def out:string ""
        def i:int 0
        while (i < (array_length pres.slides)) {
            def slide:PptxSlide (itemAt pres.slides i)
            out = (out + slide.bg.srgb + "|")
            def k:int 0
            while (k < (array_length slide.shapes)) {
                def sh:PptxShape (itemAt slide.shapes k)
                if sh.fill.isSet {
                    out = (out + sh.fill.srgb + ",")
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return out
    }

    sfn shapeTotal:int (pres:PptxPresentation) {
        def n:int 0
        def i:int 0
        while (i < (array_length pres.slides)) {
            def sl2:PptxSlide (itemAt pres.slides i)
            n = (n + (array_length sl2.shapes))
            i = (i + 1)
        }
        return n
    }

    sfn near2:boolean (a:double b:double) {
        def d:double (fabs (a - b))
        return (d < 0.5)
    }

}

; ==============================================================================
; PptxWriterTest — write a deck, read it back, and see whether it is the same
; ==============================================================================
;
; The writer's only honest test is a round trip: build or open a deck, write it
; through `PptxWriter`, open what came out with the repository's own parser and
; ask whether the geometry, the text, the colours and the pictures survived.
;
;   npm run pptx:writer:test
; ==============================================================================

Import "../src/PptxModel.rgr"
Import "../src/PptxWriter.rgr"
Import "../src/PptxParser.rgr"
Import "../src/PptxResolver.rgr"
Import "../src/PptxEdit.rgr"
Import "../src/OpcPackage.rgr"

class PptxWriterTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new PptxWriterTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn near:boolean (a:double b:double) {
        def d:double (fabs (a - b))
        return (d < 0.6)
    }

    fn run:void () {
        print "=== PptxWriterTest ==="
        this.testUnits()
        this.testRoundTripBuilt()
        this.testRoundTripFixtures()
        this.testFlattening()
        this.testPictures()
        this.testEditedDeck()
        this.testLockRoundTrip()
        this.testFlipRoundTrip()
        this.testNotesRoundTrip()
        this.testNotesOverExistingDeck()
        this.testThemeInFile()
        this.testSaveOver()
        this.testSaveOverStructure()
        print ""
        print ("passed = " + (to_string passed) + "  failed = " + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testUnits:void () {
        print "--- units and escaping ---"
        this.check("1 inch is 914400 EMU" ((PptxWriter.emu(72.0)) == "914400"))
        this.check("a point is 12700" ((PptxWriter.emu(1.0)) == "12700"))
        this.check("18pt is sz 1800" ((PptxWriter.hundredths(18.0)) == "1800"))
        this.check("half opacity is 50000" ((PptxWriter.pct(0.5)) == "50000"))
        this.check("90 degrees is 5400000" ((PptxWriter.deg60k(90.0)) == "5400000"))
        this.check("a negative angle wraps" ((PptxWriter.deg60k(0.0 - 90.0)) == "16200000"))
        this.check("markup in text is escaped" ((PptxWriter.esc("a<b&c\"d")) == "a&lt;b&amp;c&quot;d"))
        def u:buffer (PptxWriter.utf8("aä"))
        this.check("utf-8: one byte then two" ((buffer_length u) == 3))
        def euro:buffer (PptxWriter.utf8("€"))
        this.check("utf-8: three bytes for U+20AC" ((buffer_length euro) == 3))
    }

    ; A deck assembled in memory, written, and read back.
    fn testRoundTripBuilt:void () {
        print "--- a deck built here ---"
        def pres (new PptxPresentation())
        pres.slideWidth = 960.0
        pres.slideHeight = 540.0
        def slide (new PptxSlide())
        slide.width = 960.0
        slide.height = 540.0
        slide.bg = (PptxColor.srgbOf("FFFFFF"))
        def box (new PptxShape())
        box.name = "Box"
        box.x = 100.0
        box.y = 80.0
        box.width = 240.0
        box.height = 120.0
        box.hasXfrm = true
        box.rotation = 30.0
        box.fill = (PptxColor.srgbOf("4472C4"))
        box.line = (PptxColor.srgbOf("203864"))
        box.lineWidthPt = 2.0
        box.hasText = true
        def para (new PptxParagraph())
        para.align = "ctr"
        para.alignSet = true
        def run (new PptxTextRun())
        run.text = "Sähkö & <deck>"
        run.fontSizePt = 24.0
        run.sizeSet = true
        run.bold = true
        run.color = (PptxColor.srgbOf("FFFFFF"))
        push para.runs run
        push box.text.paragraphs para
        push slide.shapes box
        def oval (new PptxShape())
        oval.name = "Oval"
        oval.preset = "ellipse"
        oval.x = 500.0
        oval.y = 300.0
        oval.width = 160.0
        oval.height = 160.0
        oval.hasXfrm = true
        oval.fill = (PptxColor.srgbOf("ED7D31"))
        push slide.shapes oval
        push pres.slides slide

        def second (new PptxSlide())
        second.width = 960.0
        second.height = 540.0
        def grp (new PptxShape())
        grp.kind = 2
        grp.x = 40.0
        grp.y = 40.0
        grp.width = 200.0
        grp.height = 100.0
        grp.chX = 40.0
        grp.chY = 40.0
        grp.chW = 200.0
        grp.chH = 100.0
        def child (new PptxShape())
        child.x = 60.0
        child.y = 60.0
        child.width = 80.0
        child.height = 40.0
        child.hasXfrm = true
        child.fill = (PptxColor.srgbOf("70AD47"))
        push grp.children child
        push second.shapes grp
        push pres.slides second

        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "roundtrip.pptx")

        def parser (new PptxParser())
        def ok:boolean (parser.openParts("gallery/pptx/bin" "roundtrip.pptx"))
        this.check("the package opens" ok)
        if (ok == false) {
            return
        }
        def raw:PptxPresentation (parser.parsePresentation())
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation(raw))
        this.check("two slides came back" ((back.slideCount()) == 2))
        this.check("the slide size survived" (this.near(back.slideWidth 960.0)))
        def s1:PptxSlide (itemAt back.slides 0)
        def authored:[PptxShape]
        def i:int 0
        while (i < (array_length s1.shapes)) {
            def sh:PptxShape (itemAt s1.shapes i)
            if (sh.inherited == false) {
                push authored sh
            }
            i = (i + 1)
        }
        this.check("two shapes on the first slide" ((array_length authored) == 2))
        if ((array_length authored) < 2) {
            return
        }
        def b2:PptxShape (itemAt authored 0)
        this.check("x survived" (this.near(b2.x 100.0)))
        this.check("width survived" (this.near(b2.width 240.0)))
        this.check("rotation survived" (this.near(b2.rotation 30.0)))
        this.check("fill survived" (b2.fill.srgb == "4472C4"))
        this.check("outline survived" (b2.line.srgb == "203864"))
        this.check("outline width survived" (this.near(b2.lineWidthPt 2.0)))
        this.check("text survived, ampersand and all" ((b2.text.plainText()) == "Sähkö & <deck>"))
        def p2:PptxParagraph (itemAt b2.text.paragraphs 0)
        def r2:PptxTextRun (itemAt p2.runs 0)
        this.check("bold survived" r2.bold)
        this.check("size survived" (this.near(r2.fontSizePt 24.0)))
        this.check("run colour survived" (r2.color.srgb == "FFFFFF"))
        this.check("alignment survived" (p2.align == "ctr"))
        def ov:PptxShape (itemAt authored 1)
        this.check("the preset survived" (ov.preset == "ellipse"))
        ; The group on slide two.
        def s2:PptxSlide (itemAt back.slides 1)
        def groups:int 0
        def j:int 0
        while (j < (array_length s2.shapes)) {
            def sh2:PptxShape (itemAt s2.shapes j)
            if (sh2.kind == 2) {
                groups = (groups + 1)
                this.check("the group kept its children" ((array_length sh2.children) == 1))
                this.check("the child box survived" (this.near(sh2.chW 200.0)))
            }
            j = (j + 1)
        }
        this.check("a group came back as a group" (groups == 1))
        parser.close()
    }

    ; Every fixture: open it, write it, open what was written, and compare the
    ; shape counts and the text. This is the check that catches a part the
    ; writer forgot — a deck that cannot be reopened at all fails here.
    fn testRoundTripFixtures:void () {
        print "--- the fixtures, out and back ---"
        def names:[string] ([] _:string ( "01-text.pptx" "02-shapes.pptx" "04-multi.pptx" "05-group.pptx" "06-text-runs.pptx" "08-presets.pptx" "16-image-png.pptx" "19-text-fidelity.pptx" "20-business-deck.pptx" "21-gradient.pptx" "22-shadow.pptx" "23-bullets.pptx" "25-table.pptx" "27-accented-text.pptx" ))
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            this.roundTripFixture(name)
            i = (i + 1)
        }
    }

    fn roundTripFixture:void (name:string) {
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" name)) == false) {
            this.check(("open " + name) false)
            return
        }
        def before:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def writer (new PptxWriter())
        writer.save(before "gallery/pptx/bin" ("rt-" + name))
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" ("rt-" + name)))
        this.check((name + ": reopens") ok)
        if (ok == false) {
            return
        }
        def after:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check((name + ": same slide count") ((after.slideCount()) == (before.slideCount())))
        def si:int 0
        def sameShapes:boolean true
        def sameText:boolean true
        while (si < (before.slideCount())) {
            if (si < (after.slideCount())) {
                def a:PptxSlide (itemAt before.slides si)
                def b:PptxSlide (itemAt after.slides si)
                def na:int (PptxWriterTest.countShapes(a))
                def nb:int (PptxWriterTest.countShapes(b))
                if (na != nb) {
                    sameShapes = false
                }
                if ((PptxWriterTest.textOf(a)) != (PptxWriterTest.textOf(b))) {
                    sameText = false
                }
            }
            si = (si + 1)
        }
        this.check((name + ": same shapes on every slide") sameShapes)
        this.check((name + ": same text on every slide") sameText)
        p2.close()
    }

    ; Everything on the resolved slide, chrome included. What is written is
    ; the resolved deck — the master's footer is a shape on the slide in the
    ; file that comes out, which is the flattening the writer documents — so
    ; the count that has to match is the total, not the authored half.
    sfn countShapes:int (slide:PptxSlide) {
        return (array_length slide.shapes)
    }

    sfn textOf:string (slide:PptxSlide) {
        def out:string ""
        def i:int 0
        while (i < (array_length slide.shapes)) {
            def sh:PptxShape (itemAt slide.shapes i)
            if sh.hasText {
                out = ((out + (sh.text.plainText())) + "|")
            }
            i = (i + 1)
        }
        return out
    }

    ; And the flattening itself, stated once rather than implied: a deck that
    ; has been through the writer inherits nothing, because there is nothing
    ; left to inherit from.
    fn testFlattening:void () {
        print "--- what the writer flattens ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "15-master-layout-mixed.pptx")) == false) {
            this.check("open 15-master-layout-mixed" false)
            return
        }
        def before:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def slideBefore:PptxSlide (itemAt before.slides 0)
        def inheritedBefore:int 0
        def i:int 0
        while (i < (array_length slideBefore.shapes)) {
            def sh:PptxShape (itemAt slideBefore.shapes i)
            if sh.inherited {
                inheritedBefore = (inheritedBefore + 1)
            }
            i = (i + 1)
        }
        this.check("the deck we read inherits chrome" (inheritedBefore > 0))
        def writer (new PptxWriter())
        writer.save(before "gallery/pptx/bin" "rt-flat.pptx")
        parser.close()
        def p2 (new PptxParser())
        if ((p2.openParts("gallery/pptx/bin" "rt-flat.pptx")) == false) {
            this.check("the flattened deck opens" false)
            return
        }
        def after:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def slideAfter:PptxSlide (itemAt after.slides 0)
        def inheritedAfter:int 0
        def j:int 0
        while (j < (array_length slideAfter.shapes)) {
            def sh2:PptxShape (itemAt slideAfter.shapes j)
            if sh2.inherited {
                inheritedAfter = (inheritedAfter + 1)
            }
            j = (j + 1)
        }
        this.check("the deck we wrote inherits nothing" (inheritedAfter == 0))
        this.check("and has the same shapes on it" ((array_length slideAfter.shapes) == (array_length slideBefore.shapes)))
        p2.close()
    }

    ; The point of the writer: what an edit did is in the file afterwards.
    fn testEditedDeck:void () {
        print "--- an edited deck ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "01-text.pptx")) == false) {
            this.check("open 01-text" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        def id:int (ed.addShapeAt("roundRect" 120.0 200.0 300.0 90.0))
        ed.setFillHex("C00000")
        ed.setShapeText(id "Written by the editor")
        ed.moveSelection(20.0 10.0)
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "edited.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "edited.pptx"))
        this.check("the edited deck opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def slide:PptxSlide (itemAt back.slides 0)
        def found:boolean false
        def i:int 0
        while (i < (array_length slide.shapes)) {
            def sh:PptxShape (itemAt slide.shapes i)
            if sh.hasText {
                if ((sh.text.plainText()) == "Written by the editor") {
                    found = true
                    this.check("the inserted shape kept its fill" (sh.fill.srgb == "C00000"))
                    this.check("and the move it was given" (this.near(sh.x 140.0)))
                    this.check("and its rounded preset" (sh.preset == "roundRect"))
                }
            }
            i = (i + 1)
        }
        this.check("the inserted shape is in the file" found)
        p2.close()
    }

    ; A picture is bytes in the package, not a reference to one that was in
    ; the deck we read — the file has to stand on its own.
    fn testPictures:void () {
        print "--- pictures ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "18-image-mixed.pptx")) == false) {
            this.check("open 18-image-mixed" false)
            return
        }
        def before:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def writer (new PptxWriter())
        writer.save(before "gallery/pptx/bin" "rt-images.pptx")
        this.check("the media were collected" ((array_length writer.media) > 0))
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "rt-images.pptx"))
        this.check("the deck with pictures reopens" ok)
        if (ok == false) {
            return
        }
        def after:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def pics:int 0
        def withBytes:int 0
        def si:int 0
        while (si < (array_length after.slides)) {
            def slide:PptxSlide (itemAt after.slides si)
            def i:int 0
            while (i < (array_length slide.shapes)) {
                def sh:PptxShape (itemAt slide.shapes i)
                if (sh.kind == 1) {
                    pics = (pics + 1)
                    if ((buffer_length sh.imageBytes) > 0) {
                        withBytes = (withBytes + 1)
                    }
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        this.check("the pictures came back" (pics > 0))
        this.check("and every one of them carries its bytes" (pics == withBytes))
        p2.close()
    }


    fn testLockRoundTrip:void () {
        print "--- a lock is in the file ---"
        def pres (new PptxPresentation())
        def slide (new PptxSlide())
        slide.width = 720.0
        slide.height = 540.0
        def a (new PptxShape())
        a.x = 50.0
        a.y = 50.0
        a.width = 100.0
        a.height = 50.0
        a.hasXfrm = true
        a.locked = true
        a.fill = (PptxColor.srgbOf("4472C4"))
        push slide.shapes a
        def b (new PptxShape())
        b.x = 200.0
        b.y = 50.0
        b.width = 100.0
        b.height = 50.0
        b.hasXfrm = true
        b.fill = (PptxColor.srgbOf("ED7D31"))
        push slide.shapes b
        push pres.slides slide
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "locks.pptx")
        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "locks.pptx"))
        this.check("a deck with a lock opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def s1:PptxSlide (itemAt back.slides 0)
        def locked:int 0
        def free:int 0
        def i:int 0
        while (i < (array_length s1.shapes)) {
            def sh:PptxShape (itemAt s1.shapes i)
            if (sh.inherited == false) {
                if sh.locked {
                    locked = (locked + 1)
                } {
                    free = (free + 1)
                }
            }
            i = (i + 1)
        }
        this.check("the locked shape came back locked" (locked == 1))
        this.check("and the other one did not" (free == 1))
        p2.close()
    }

    fn testFlipRoundTrip:void () {
        print "--- a mirror is in the file ---"
        def pres (new PptxPresentation())
        def slide (new PptxSlide())
        slide.width = 720.0
        slide.height = 540.0
        def a (new PptxShape())
        a.x = 40.0
        a.y = 40.0
        a.width = 120.0
        a.height = 60.0
        a.hasXfrm = true
        a.flipH = true
        a.preset = "triangle"
        a.fill = (PptxColor.srgbOf("4472C4"))
        push slide.shapes a
        def b (new PptxShape())
        b.x = 200.0
        b.y = 40.0
        b.width = 120.0
        b.height = 60.0
        b.hasXfrm = true
        b.flipV = true
        b.rotation = 30.0
        b.fill = (PptxColor.srgbOf("ED7D31"))
        push slide.shapes b
        push pres.slides slide
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "flips.pptx")
        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "flips.pptx"))
        this.check("a deck with mirrors opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def s1:PptxSlide (itemAt back.slides 0)
        def authored:[PptxShape]
        def i:int 0
        while (i < (array_length s1.shapes)) {
            def sh:PptxShape (itemAt s1.shapes i)
            if (sh.inherited == false) {
                push authored sh
            }
            i = (i + 1)
        }
        this.check("both shapes came back" ((array_length authored) == 2))
        if ((array_length authored) < 2) {
            return
        }
        def one:PptxShape (itemAt authored 0)
        def two:PptxShape (itemAt authored 1)
        this.check("the horizontal mirror survived" one.flipH)
        this.check("and did not become a vertical one" (one.flipV == false))
        this.check("the vertical mirror survived" two.flipV)
        this.check("beside its rotation" (this.near(two.rotation 30.0)))
        p2.close()
    }

    fn testNotesRoundTrip:void () {
        print "--- the speaker's notes are in the file ---"
        def pres (new PptxPresentation())
        def slide (new PptxSlide())
        slide.width = 720.0
        slide.height = 540.0
        def a (new PptxShape())
        a.x = 40.0
        a.y = 40.0
        a.width = 200.0
        a.height = 80.0
        a.hasXfrm = true
        a.fill = (PptxColor.srgbOf("4472C4"))
        push slide.shapes a
        push pres.slides slide
        def second (new PptxSlide())
        second.width = 720.0
        second.height = 540.0
        push pres.slides second
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        ed.setNotes("Open with the numbers\nThen the demo")
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "notes.pptx")
        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "notes.pptx"))
        this.check("a deck with notes opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def s1:PptxSlide (itemAt back.slides 0)
        this.check("the notes came back" ((s1.notesText()) == "Open with the numbers\nThen the demo"))
        this.check("and the slide points at them" ((strlen s1.notesPart) > 0))
        def s2:PptxSlide (itemAt back.slides 1)
        this.check("a slide with none has none" ((s2.notesText()) == ""))
        this.check("and no part for them" ((strlen s2.notesPart) == 0))
        p2.close()
    }

    fn testNotesOverExistingDeck:void () {
        print "--- notes added to a deck that had none ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "04-multi.pptx")) == false) {
            this.check("open 04-multi" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(1)
        ed.setNotes("Said out loud, not on the slide")
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-notes.pptx")
        parser.close()
        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-notes.pptx"))
        this.check("the kept-package deck opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def s2:PptxSlide (itemAt back.slides 1)
        this.check("the notes are on the slide they were typed on" ((s2.notesText()) == "Said out loud, not on the slide"))
        def s1:PptxSlide (itemAt back.slides 0)
        this.check("and not on the other one" ((s1.notesText()) == ""))
        p2.close()
    }

    fn testThemeInFile:void () {
        print "--- a re-themed deck keeps its palette ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "07-theme-fills.pptx")) == false) {
            this.check("open 07-theme-fills" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.applyPalette("berry")
        def wanted:string (ed.themeColor("accent1"))
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "themed.pptx")
        parser.close()
        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "themed.pptx"))
        this.check("the themed deck opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("the palette is in the theme part" ((back.theme.colorOf("accent1")) == wanted))
        ; A shape that took its colour from the palette resolves to the new one
        ; when the file is read again.
        def s1:PptxSlide (itemAt back.slides 0)
        def matched:boolean false
        def i:int 0
        while (i < (array_length s1.shapes)) {
            def sh:PptxShape (itemAt s1.shapes i)
            if (sh.fill.isSet) {
                if (sh.fill.srgb == wanted) {
                    matched = true
                }
            }
            i = (i + 1)
        }
        this.check("and a themed shape came back in it" matched)
        p2.close()
    }

    ; --- saving the file that was opened -------------------------------------
    ;
    ; The flat writer loses everything the model does not describe. This is the
    ; other route: keep the package, rewrite the slides that were touched.

    fn testSaveOver:void () {
        print "--- save over: the parts nobody edited are untouched ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ; Touch slide 2 and nothing else.
        ed.gotoSlide(1)
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("slide two has something to move" ((array_length shapes) > 0))
        if ((array_length shapes) == 0) {
            return
        }
        def first:PptxShape (itemAt shapes 0)
        ed.select(first.editId)
        ed.moveSelection(15.0 5.0)
        def slide1:PptxSlide (itemAt pres.slides 0)
        def slide2:PptxSlide (itemAt pres.slides 1)
        this.check("the edited slide is marked" slide2.dirty)
        this.check("and the others are not" (slide1.dirty == false))

        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-business.pptx")
        PptxWriter.markSaved(pres)
        this.check("saving clears the marks" (slide2.dirty == false))

        def out (new OpcPackage())
        def opened:boolean (out.openParts("gallery/pptx/bin" "over-business.pptx"))
        this.check("the written package opens" opened)
        if (opened == false) {
            return
        }
        ; Every part of the original is still there.
        def missing:int 0
        def srcParts:[string] (parser.pkg.listParts())
        def i:int 0
        while (i < (array_length srcParts)) {
            def part:string (itemAt srcParts i)
            if ((out.hasPart(part)) == false) {
                missing = (missing + 1)
            }
            i = (i + 1)
        }
        this.check("every part of the original survives" (missing == 0))
        ; The slides nobody touched are byte for byte the same.
        def changed:int 0
        def same:int 0
        def j:int 0
        while (j < (array_length srcParts)) {
            def part2:string (itemAt srcParts j)
            if ((indexOf part2 "ppt/slides/slide") == 0) {
                if ((indexOf part2 ".rels") < 0) {
                    def a:buffer (parser.pkg.readBinary(part2))
                    def b:buffer (out.readBinary(part2))
                    if (PptxWriterTest.sameBytes(a b)) {
                        same = (same + 1)
                    } {
                        changed = (changed + 1)
                    }
                }
            }
            j = (j + 1)
        }
        this.check("exactly one slide was rewritten" (changed == 1))
        this.check("and the rest came through untouched" (same == 4))
        ; The master and the layouts came through, so the chrome is inherited
        ; again rather than baked into the slides.
        def p2 (new PptxParser())
        def ok2:boolean (p2.openParts("gallery/pptx/bin" "over-business.pptx"))
        this.check("it reopens as a deck" ok2)
        if (ok2 == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("same number of slides" ((back.slideCount()) == (pres.slideCount())))
        def inherited:int 0
        def authored:int 0
        def bslide:PptxSlide (itemAt back.slides 1)
        def k:int 0
        while (k < (array_length bslide.shapes)) {
            def sh:PptxShape (itemAt bslide.shapes k)
            if sh.inherited {
                inherited = (inherited + 1)
            } {
                authored = (authored + 1)
            }
            k = (k + 1)
        }
        this.check("the chrome is inherited, not baked in" (inherited > 0))
        this.check("and the slide still has its own shapes" (authored > 0))
        ; The edit is in the file.
        def moved:PptxShape (itemAt bslide.shapes 0)
        def foundMove:boolean false
        def m:int 0
        while (m < (array_length bslide.shapes)) {
            def cand:PptxShape (itemAt bslide.shapes m)
            if (cand.inherited == false) {
                if (this.near(cand.x (first.x))) {
                    foundMove = true
                }
            }
            m = (m + 1)
        }
        this.check("the move that was made is in the file" foundMove)
        ; Pictures were referenced where they lay rather than copied.
        def mediaCopies:int 0
        def outParts:[string] (out.listParts())
        def q:int 0
        while (q < (array_length outParts)) {
            def op:string (itemAt outParts q)
            if ((indexOf op "ppt/media/") == 0) {
                mediaCopies = (mediaCopies + 1)
            }
            q = (q + 1)
        }
        this.check("no picture was duplicated" (mediaCopies == 2))
        p2.close()
        out.close()
        parser.close()
    }

    fn testSaveOverStructure:void () {
        print "--- save over: slides added and removed ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "04-multi.pptx")) == false) {
            this.check("open 04-multi" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def before:int (pres.slideCount())
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        ed.duplicateSlide()
        def id:int (ed.addShapeAt("roundRect" 60.0 60.0 200.0 80.0))
        ed.setShapeText(id "On a slide that did not exist")
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-multi.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-multi.pptx"))
        this.check("a deck with a new slide opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("it has one more slide" ((back.slideCount()) == (before + 1)))
        def added:PptxSlide (itemAt back.slides 1)
        def found:boolean false
        def i:int 0
        while (i < (array_length added.shapes)) {
            def sh:PptxShape (itemAt added.shapes i)
            if sh.hasText {
                if ((sh.text.plainText()) == "On a slide that did not exist") {
                    found = true
                }
            }
            i = (i + 1)
        }
        this.check("the new slide carries what was put on it" found)
        this.check("the new slide got a part of its own" ((strlen added.partPath) > 0))
        p2.close()

        ; …and taking one away removes its part.
        def p3 (new PptxParser())
        p3.openParts("gallery/pptx/bin" "over-multi.pptx")
        def pres3:PptxPresentation ((new PptxResolver()).resolvePresentation((p3.parsePresentation())))
        def ed3 (new PptxEditor())
        ed3.attach(pres3)
        ed3.gotoSlide(1)
        def goneName:string ((itemAt pres3.slides 1).partPath)
        ed3.deleteSlide()
        def w3 (new PptxWriter())
        w3.saveOver(pres3 p3.pkg "gallery/pptx/bin" "over-multi-less.pptx")
        p3.close()
        def out3 (new OpcPackage())
        if (out3.openParts("gallery/pptx/bin" "over-multi-less.pptx")) {
            this.check("the deleted slide's part is gone" ((out3.hasPart(goneName)) == false))
            def p4 (new PptxParser())
            if (p4.openParts("gallery/pptx/bin" "over-multi-less.pptx")) {
                def back4:PptxPresentation ((new PptxResolver()).resolvePresentation((p4.parsePresentation())))
                this.check("and the deck is one shorter" ((back4.slideCount()) == before))
                p4.close()
            }
            out3.close()
        }
    }

    sfn sameBytes:boolean (a:buffer b:buffer) {
        def n:int (buffer_length a)
        if (n != (buffer_length b)) {
            return false
        }
        def i:int 0
        while (i < n) {
            if ((buffer_get a i) != (buffer_get b i)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

}

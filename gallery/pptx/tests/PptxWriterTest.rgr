    fn testThemeInFile:void () {
        print "--- a re-themed deck keeps its palette ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "07-theme-fills.pptx")) == false) {
            this.check("open 07-theme-fills" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.applyPalette("berry")
        def wanted:string (ed.themeColor("accent1"))
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "themed.pptx")
        parser.close()
        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "themed.pptx"))
        this.check("the themed deck opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("the palette is in the theme part" ((back.theme.colorOf("accent1")) == wanted))
        ; A shape that took its colour from the palette resolves to the new one
        ; when the file is read again.
        def s1:PptxSlide (itemAt back.slides 0)
        def matched:boolean false
        def i:int 0
        while (i < (array_length s1.shapes)) {
            def sh:PptxShape (itemAt s1.shapes i)
            if (sh.fill.isSet) {
                if (sh.fill.srgb == wanted) {
                    matched = true
                }
            }
            i = (i + 1)
        }
        this.check("and a themed shape came back in it" matched)
        p2.close()
    }

    ; --- saving the file that was opened -------------------------------------
    ;
    ; The flat writer loses everything the model does not describe. This is the
    ; other route: keep the package, rewrite the slides that were touched.

    fn testSaveOver:void () {
        print "--- save over: the parts nobody edited are untouched ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ; Touch slide 2 and nothing else.
        ed.gotoSlide(1)
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("slide two has something to move" ((array_length shapes) > 0))
        if ((array_length shapes) == 0) {
            return
        }
        def first:PptxShape (itemAt shapes 0)
        ed.select(first.editId)
        ed.moveSelection(15.0 5.0)
        def slide1:PptxSlide (itemAt pres.slides 0)
        def slide2:PptxSlide (itemAt pres.slides 1)
        this.check("the edited slide is marked" slide2.dirty)
        this.check("and the others are not" (slide1.dirty == false))

        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-business.pptx")
        PptxWriter.markSaved(pres)
        this.check("saving clears the marks" (slide2.dirty == false))

        def out (new OpcPackage())
        def opened:boolean (out.openParts("gallery/pptx/bin" "over-business.pptx"))
        this.check("the written package opens" opened)
        if (opened == false) {
            return
        }
        ; Every part of the original is still there.
        def missing:int 0
        def srcParts:[string] (parser.pkg.listParts())
        def i:int 0
        while (i < (array_length srcParts)) {
            def part:string (itemAt srcParts i)
            if ((out.hasPart(part)) == false) {
                missing = (missing + 1)
            }
            i = (i + 1)
        }
        this.check("every part of the original survives" (missing == 0))
        ; The slides nobody touched are byte for byte the same.
        def changed:int 0
        def same:int 0
        def j:int 0
        while (j < (array_length srcParts)) {
            def part2:string (itemAt srcParts j)
            if ((indexOf part2 "ppt/slides/slide") == 0) {
                if ((indexOf part2 ".rels") < 0) {
                    def a:buffer (parser.pkg.readBinary(part2))
                    def b:buffer (out.readBinary(part2))
                    if (PptxWriterTest.sameBytes(a b)) {
                        same = (same + 1)
                    } {
                        changed = (changed + 1)
                    }
                }
            }
            j = (j + 1)
        }
        this.check("exactly one slide was rewritten" (changed == 1))
        this.check("and the rest came through untouched" (same == 4))
        ; The master and the layouts came through, so the chrome is inherited
        ; again rather than baked into the slides.
        def p2 (new PptxParser())
        def ok2:boolean (p2.openParts("gallery/pptx/bin" "over-business.pptx"))
        this.check("it reopens as a deck" ok2)
        if (ok2 == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("same number of slides" ((back.slideCount()) == (pres.slideCount())))
        def inherited:int 0
        def authored:int 0
        def bslide:PptxSlide (itemAt back.slides 1)
        def k:int 0
        while (k < (array_length bslide.shapes)) {
            def sh:PptxShape (itemAt bslide.shapes k)
            if sh.inherited {
                inherited = (inherited + 1)
            } {
                authored = (authored + 1)
            }
            k = (k + 1)
        }
        this.check("the chrome is inherited, not baked in" (inherited > 0))
        this.check("and the slide still has its own shapes" (authored > 0))
        ; The edit is in the file.
        def moved:PptxShape (itemAt bslide.shapes 0)
        def foundMove:boolean false
        def m:int 0
        while (m < (array_length bslide.shapes)) {
            def cand:PptxShape (itemAt bslide.shapes m)
            if (cand.inherited == false) {
                if (this.near(cand.x (first.x))) {
                    foundMove = true
                }
            }
            m = (m + 1)
        }
        this.check("the move that was made is in the file" foundMove)
        ; Pictures were referenced where they lay rather than copied.
        def mediaCopies:int 0
        def outParts:[string] (out.listParts())
        def q:int 0
        while (q < (array_length outParts)) {
            def op:string (itemAt outParts q)
            if ((indexOf op "ppt/media/") == 0) {
                mediaCopies = (mediaCopies + 1)
            }
            q = (q + 1)
        }
        this.check("no picture was duplicated" (mediaCopies == 2))
        p2.close()
        out.close()
        parser.close()
    }

    fn testSaveOverStructure:void () {
        print "--- save over: slides added and removed ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "04-multi.pptx")) == false) {
            this.check("open 04-multi" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def before:int (pres.slideCount())
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        ed.duplicateSlide()
        def id:int (ed.addShapeAt("roundRect" 60.0 60.0 200.0 80.0))
        ed.setShapeText(id "On a slide that did not exist")
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-multi.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-multi.pptx"))
        this.check("a deck with a new slide opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("it has one more slide" ((back.slideCount()) == (before + 1)))
        def added:PptxSlide (itemAt back.slides 1)
        def found:boolean false
        def i:int 0
        while (i < (array_length added.shapes)) {
            def sh:PptxShape (itemAt added.shapes i)
            if sh.hasText {
                if ((sh.text.plainText()) == "On a slide that did not exist") {
                    found = true
                }
            }
            i = (i + 1)
        }
        this.check("the new slide carries what was put on it" found)
        this.check("the new slide got a part of its own" ((strlen added.partPath) > 0))
        p2.close()

        ; …and taking one away removes its part.
        def p3 (new PptxParser())
        p3.openParts("gallery/pptx/bin" "over-multi.pptx")
        def pres3:PptxPresentation ((new PptxResolver()).resolvePresentation((p3.parsePresentation())))
        def ed3 (new PptxEditor())
        ed3.attach(pres3)
        ed3.gotoSlide(1)
        def goneName:string ((itemAt pres3.slides 1).partPath)
        ed3.deleteSlide()
        def w3 (new PptxWriter())
        w3.saveOver(pres3 p3.pkg "gallery/pptx/bin" "over-multi-less.pptx")
        p3.close()
        def out3 (new OpcPackage())
        if (out3.openParts("gallery/pptx/bin" "over-multi-less.pptx")) {
            this.check("the deleted slide's part is gone" ((out3.hasPart(goneName)) == false))
            def p4 (new PptxParser())
            if (p4.openParts("gallery/pptx/bin" "over-multi-less.pptx")) {
                def back4:PptxPresentation ((new PptxResolver()).resolvePresentation((p4.parsePresentation())))
                this.check("and the deck is one shorter" ((back4.slideCount()) == before))
                p4.close()
            }
            out3.close()
        }
    }

    ; --- sections and edited masters -----------------------------------------

    fn testSectionsRoundTrip:void () {
        print "--- sections survive a save ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "04-multi.pptx")) == false) {
            this.check("open 04-multi" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        this.check("slides come back with ids" (((itemAt pres.slides 0).slideId) > 0))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        ed.addSection("Opening")
        if ((pres.slideCount()) > 1) {
            ed.gotoSlide(1)
            ed.addSection("The rest")
        }
        this.check("two sections were made" ((ed.sectionCount()) == 2))
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-sections.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-sections.pptx"))
        this.check("a sectioned deck opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        this.check("both sections came back" ((array_length back.sections) == 2))
        if ((array_length back.sections) == 2) {
            this.check("with their names" (((itemAt back.sections 0).name) == "Opening"))
            this.check("and the second one too" (((itemAt back.sections 1).name) == "The rest"))
            def ed2 (new PptxEditor())
            ed2.attach(back)
            this.check("slide one is in the first section" ((ed2.sectionOfSlide(0)) == 0))
            if ((back.slideCount()) > 1) {
                this.check("and slide two in the second" ((ed2.sectionOfSlide(1)) == 1))
            }
            ; Taking every section away leaves a file that still opens.
            ed2.removeSection(1)
            ed2.removeSection(0)
            def w2 (new PptxWriter())
            w2.saveOver(back p2.pkg "gallery/pptx/bin" "over-unsectioned.pptx")
            def p3 (new PptxParser())
            if (p3.openParts("gallery/pptx/bin" "over-unsectioned.pptx")) {
                def back3:PptxPresentation ((new PptxResolver()).resolvePresentation((p3.parsePresentation())))
                this.check("the unsectioned deck has none" ((array_length back3.sections) == 0))
                this.check("and still has its slides" ((back3.slideCount()) == (back.slideCount())))
                p3.close()
            } {
                this.check("the unsectioned deck opens" false)
            }
        }
        p2.close()
    }

    fn testSheetEditRoundTrip:void () {
        print "--- an edited master is written back ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        def master:string ((itemAt pres.slides 0).masterPart)
        this.check("the slide names a master" ((strlen master) > 0))
        if ((strlen master) == 0) {
            return
        }
        this.check("the master opens for editing" (ed.editSheet(master)))
        def id:int (ed.addShapeAt("rect" 20.0 20.0 120.0 40.0))
        ed.setShapeText(id "Drawn on the master")
        ed.exitSheet()
        this.check("and editing it ends" ((ed.isEditingSheet()) == false))
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-master.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-master.pptx"))
        this.check("the deck with an edited master opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def sheet@(optional):PptxSheet (get back.masters master)
        this.check("the master is still there" (!null? sheet))
        if (null? sheet) {
            p2.close()
            return
        }
        def sh:PptxSheet (unwrap sheet)
        def found:boolean false
        def i:int 0
        while (i < (array_length sh.shapes)) {
            def s2:PptxShape (itemAt sh.shapes i)
            if s2.hasText {
                if ((s2.text.plainText()) == "Drawn on the master") {
                    found = true
                }
            }
            i = (i + 1)
        }
        this.check("and carries what was drawn on it" found)
        p2.close()
    }

    fn testFooterRoundTrip:void () {
        print "--- a footer and page numbers reach the file ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "20-business-deck.pptx")) == false) {
            this.check("open the business deck" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(1)
        this.check("page numbers can be turned on" (ed.showSlideNumbers(true)))
        this.check("and they read as on" (ed.slideNumbersShown()))
        this.check("a footer can be set" (ed.setFooter("Q3 review — internal")))
        this.check("and reads back" ((ed.footerText()) == "Q3 review — internal"))
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-footer.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-footer.pptx"))
        this.check("the deck with a footer opens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def ed2 (new PptxEditor())
        ed2.attach(back)
        ed2.gotoSlide(1)
        this.check("the footer came back" ((ed2.footerText()) == "Q3 review — internal"))
        this.check("and the page numbers did too" (ed2.slideNumbersShown()))
        ; The number is a field, not the text that was written into it, so it
        ; still counts up when the slide moves.
        def sheet@(optional):PptxSheet (ed2.masterSheet())
        this.check("the master is there" (!null? sheet))
        if (!null? sheet) {
            def hit@(optional):PptxShape (PptxEditor.namedShape((unwrap sheet) "Slide Number Placeholder"))
            this.check("with a slide-number shape" (!null? hit))
            if (!null? hit) {
                def sh:PptxShape (unwrap hit)
                def isField:boolean false
                def pi:int 0
                while (pi < (array_length sh.text.paragraphs)) {
                    def para:PptxParagraph (itemAt sh.text.paragraphs pi)
                    def ri:int 0
                    while (ri < (array_length para.runs)) {
                        def run:PptxTextRun (itemAt para.runs ri)
                        if (run.field == "slidenum") {
                            isField = true
                        }
                        ri = (ri + 1)
                    }
                    pi = (pi + 1)
                }
                this.check("that is still a field" isField)
            }
        }
        p2.close()
    }

    fn testShowRoundTrip:void () {
        print "--- a transition and a build survive a save ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "28-transitions.pptx")) == false) {
            this.check("open the show fixture" false)
            return
        }
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def ed (new PptxEditor())
        ed.attach(pres)
        ; Touch both slides so both parts are rewritten from the model rather
        ; than copied through — otherwise the check proves nothing.
        ed.gotoSlide(0)
        ed.setTransition("wipe" "d" 0.5)
        ed.gotoSlide(1)
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("slide two has a shape" ((array_length shapes) > 0))
        if ((array_length shapes) == 0) {
            return
        }
        def sh:PptxShape (itemAt shapes 0)
        ed.select(sh.editId)
        ed.animateSelection("fade" 0.6)
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-show.pptx")
        parser.close()

        def p2 (new PptxParser())
        def ok:boolean (p2.openParts("gallery/pptx/bin" "over-show.pptx"))
        this.check("the show reopens" ok)
        if (ok == false) {
            return
        }
        def back:PptxPresentation ((new PptxResolver()).resolvePresentation((p2.parsePresentation())))
        def s1:PptxSlide (itemAt back.slides 0)
        this.check("the transition that was set came back" (s1.transition.kind == "wipe"))
        this.check("with its direction" (s1.transition.dir == "d"))
        this.check("the build on slide one came through" ((array_length s1.build) == 2))
        def s2:PptxSlide (itemAt back.slides 1)
        this.check("slide two still pushes" (s2.transition.kind == "push"))
        this.check("and still advances on a timer" (s2.transition.afterSeconds > 3.0))
        this.check("the step that was added is there" ((array_length s2.build) == 1))
        if ((array_length s2.build) == 1) {
            def step:PptxBuildStep (itemAt s2.build 0)
            this.check("it fades" (step.kind == "fade"))
            ; The file renumbers shapes on every save, so the step has to name
            ; the shape it was about and not the number it had before.
            def ed2 (new PptxEditor())
            ed2.attach(back)
            ed2.gotoSlide(1)
            def found@(optional):PptxShape (ed2.findShape(step.editId))
            this.check("and still names a shape on the slide" (!null? found))
        }
        p2.close()
    }

    sfn sameBytes:boolean (a:buffer b:buffer) {
        def n:int (buffer_length a)
        if (n != (buffer_length b)) {
            return false
        }
        def i:int 0
        while (i < n) {
            if ((buffer_get a i) != (buffer_get b i)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }


    ; --- what this writer does not understand has to survive it ---------------
    ;
    ; A shape tree carries more than shapes: SmartArt and newer chart types
    ; arrive wrapped in `mc:AlternateContent`, ink as `p:contentPart`, and
    ; `p:extLst` holds whatever the writing tool wanted to say to itself.
    ; `PptxModel` has no room for any of it, so before the parser recorded
    ; WHERE each one was, editing the slide around them deleted them: a save
    ; regenerated the tree out of the shapes, and the shapes were all it had.
    ;
    ; This edits the slide those three sit on, which is the case that has to
    ; work — an UNtouched slide is copied through byte for byte and proves
    ; nothing.
    fn testUnmodelledContentSurvives:void () {
        print "--- what the model does not describe survives a save ---"
        def parser (new PptxParser())
        if ((parser.openParts("gallery/pptx/fixtures" "32-unmodelled-content.pptx")) == false) {
            this.check("open the deck with unmodelled content" false)
            return
        }
        def raw:PptxPresentation (parser.parsePresentation())
        def slideRaw:PptxSlide (itemAt raw.slides 0)
        this.check("the three unmodelled children were noticed" ((array_length slideRaw.opaque) == 3))
        if ((array_length slideRaw.opaque) == 3) {
            def diagram:PptxOpaque (itemAt slideRaw.opaque 0)
            def ink:PptxOpaque (itemAt slideRaw.opaque 1)
            def exts:PptxOpaque (itemAt slideRaw.opaque 2)
            this.check("the diagram sits between the two shapes"
                ((diagram.name == "AlternateContent") && (diagram.afterShapes == 1)))
            this.check("the ink comes after both" (ink.afterShapes == 2))
            this.check("and so does the extension list" (exts.name == "extLst"))
            ; A self-closing element is the case a span recorded only at an end
            ; tag would get wrong.
            this.check("the self-closing one has a span too" ink.source.known)
        }

        ; And one level up: `<p:sld>` also holds a colour map override before
        ; the transition and an extension list after it. CT_Slide orders its
        ; children, so each has to go back on the side of the transition it
        ; came from.
        this.check("the colour map override was kept" ((array_length slideRaw.sldHead) == 1))
        this.check("and the extension list after the transition" ((array_length slideRaw.sldTail) == 1))
        if ((array_length slideRaw.sldHead) == 1) {
            def head0:PptxOpaque (itemAt slideRaw.sldHead 0)
            this.check("the head one is the colour map" (head0.name == "clrMapOvr"))
        }
        if ((array_length slideRaw.sldTail) == 1) {
            def tail0:PptxOpaque (itemAt slideRaw.sldTail 0)
            this.check("the tail one is the extension list" (tail0.name == "extLst"))
        }

        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation(raw))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        def shapes:[PptxShape] (ed.editableShapes())
        this.check("the slide has shapes to edit" ((array_length shapes) > 0))
        if ((array_length shapes) == 0) {
            return
        }
        ; Undo and redo go through the snapshot clone, which is the other place
        ; the spans can be dropped.
        def target:PptxShape (itemAt shapes 0)
        ed.select(target.editId)
        ed.moveSelection(12.0 4.0)
        ed.undo()
        ed.redo()
        def slide:PptxSlide (itemAt pres.slides 0)
        this.check("the edit marked the slide" slide.dirty)
        this.check("and history kept the unmodelled children" ((array_length slide.opaque) == 3))

        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" "over-unmodelled.pptx")
        def out (new OpcPackage())
        if ((out.openParts("gallery/pptx/bin" "over-unmodelled.pptx")) == false) {
            this.check("the written deck opens" false)
            return
        }
        def before:string (parser.pkg.readXml("ppt/slides/slide1.xml"))
        def after:string (out.readXml("ppt/slides/slide1.xml"))
        this.check("the slide really was rewritten" (after != before))
        this.check("the diagram is still there" ((indexOf after "<mc:AlternateContent") >= 0))
        this.check("with the part of it nothing here can read"
            ((indexOf after "drawingml/2006/diagram") >= 0))
        this.check("and its fallback picture" ((indexOf after "Diagram fallback") >= 0))
        this.check("the ink is still there" ((indexOf after "<p:contentPart") >= 0))
        ; The tree's own extension list, told apart from the slide's by its uri
        ; — both hold a `creationId`, which is why counting that would not say
        ; which one came back.
        this.check("the extension list is still there" ((indexOf after "BB962C8B") >= 0))
        this.check("each of them exactly once"
            (((PptxWriterTest.countOf(after "<mc:AlternateContent")) == 1)
                && ((PptxWriterTest.countOf(after "<p:contentPart")) == 1)
                && ((PptxWriterTest.countOf(after "BB962C8B")) == 1)))
        ; Order, not just presence: an element put back in the wrong slot is a
        ; diagram that has moved behind the text.
        def diagramAt:int (indexOf after "<mc:AlternateContent")
        def headingAt:int (indexOf after "Before the diagram")
        def footerAt:int (indexOf after "After the diagram")
        def inkAt:int (indexOf after "<p:contentPart")
        this.check("the diagram is still after the heading" (diagramAt > headingAt))
        this.check("and still before the footer" (diagramAt < footerAt))
        this.check("and the ink after both" (inkAt > footerAt))

        ; Slide level: kept, once, and on the right side of the transition.
        this.check("the slide's extension list is still there" ((indexOf after "DEADBEEF") >= 0))
        this.check("exactly once" ((PptxWriterTest.countOf(after "DEADBEEF")) == 1))
        this.check("the colour map override is still there, once"
            ((PptxWriterTest.countOf(after "<p:clrMapOvr")) == 1))
        def mapAt:int (indexOf after "<p:clrMapOvr")
        def transAt:int (indexOf after "<p:transition")
        def extAt:int (indexOf after "DEADBEEF")
        this.check("the colour map comes before the transition" ((mapAt >= 0) && (mapAt < transAt)))
        this.check("and the extension list after it" (extAt > transAt))

        ; The relationships the preserved XML names. A diagram points at four
        ; parts of its own and the ink at one; a rewrite that rebuilt the
        ; relationship part from the shapes alone would leave every one of them
        ; pointing at nothing, and the preserved markup would be a reference to
        ; a part that is not there.
        def outRels:string (out.readXml("ppt/slides/_rels/slide1.xml.rels"))
        this.check("the diagram's own relationships came through"
            (((indexOf outRels "rId10") >= 0) && ((indexOf outRels "rId13") >= 0)))
        this.check("and the ink's" ((indexOf outRels "rId20") >= 0))
        this.check("and the parts they name are still in the package"
            ((out.hasPart("ppt/diagrams/data1.xml")) && (out.hasPart("ppt/ink/ink1.xml"))))
        this.check("with their content types"
            ((strlen (out.contentTypeFor("ppt/diagrams/data1.xml"))) > 0))

        ; And the deck still reads back as a deck.
        def again (new PptxParser())
        if (again.openParts("gallery/pptx/bin" "over-unmodelled.pptx")) {
            def back:PptxPresentation (again.parsePresentation())
            def backSlide:PptxSlide (itemAt back.slides 0)
            this.check("reopening finds the shapes" ((array_length backSlide.shapes) == 2))
            this.check("and the three unmodelled children again" ((array_length backSlide.opaque) == 3))
            this.check("and the slide-level pair again"
                (((array_length backSlide.sldHead) == 1) && ((array_length backSlide.sldTail) == 1)))
            this.check("with the transition still on it" backSlide.transition.isSet)
            again.close()
        }
        out.close()
        parser.close()
    }

    sfn countOf:int (haystack:string needle:string) {
        def n:int 0
        def at:int 0
        while (true) {
            def hit:int (indexOfFrom haystack needle at)
            if (hit < 0) {
                return n
            }
            n = (n + 1)
            at = (hit + (strlen needle))
        }
        return n
    }

}

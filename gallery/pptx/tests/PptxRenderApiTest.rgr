; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; PptxRenderApiTest — the drawn half of the published surface.
; ==============================================================================
;
; The trap this test is written around: a PNG encoder always produces a valid
; PNG. Checking the signature and the dimensions proves the ENCODER ran, not
; that the deck was drawn — a blank white page passes every one of those checks,
; and a renderer that silently drew nothing would ship.
;
; So the assertions below are about DIFFERENCE. The same slide with a different
; fill has to encode to different bytes; a slide with a shape on it has to
; differ from an empty one; and doubling the scale has to double the pixels.
; Those cannot be satisfied by a blank page.
; ==============================================================================

Import "../api/PptxRenderApi.rgr"
Import "../../zip/Inflate.rgr"
Import "../../pdf_writer/src/core/Buffer.rgr"

class PptxRenderApiTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new PptxRenderApiTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.check((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    ; The four bytes at 12..15 of a PNG are "IHDR"; the width and height are the
    ; two big-endian 32-bit numbers straight after it.
    sfn ihdrW:int (b:buffer) {
        return (PptxRenderApiTest.be32(b 16))
    }

    sfn ihdrH:int (b:buffer) {
        return (PptxRenderApiTest.be32(b 20))
    }

    sfn be32:int (b:buffer at:int) {
        def b0:int (buffer_get b at)
        def b1:int (buffer_get b (at + 1))
        def b2:int (buffer_get b (at + 2))
        def b3:int (buffer_get b (at + 3))
        return ((((b0 * 256) + b1) * 256 + b2) * 256 + b3)
    }

    sfn isPng:boolean (b:buffer) {
        if ((buffer_length b) < 24) {
            return false
        }
        def sig0:int (buffer_get b 0)
        def sig1:int (buffer_get b 1)
        def sig2:int (buffer_get b 2)
        def sig3:int (buffer_get b 3)
        return ((((sig0 == 137) && (sig1 == 80)) && (sig2 == 78)) && (sig3 == 71))
    }

    sfn sameBytes:boolean (a:buffer b:buffer) {
        if ((buffer_length a) != (buffer_length b)) {
            return false
        }
        def i:int 0
        while (i < (buffer_length a)) {
            def x:int (buffer_get a i)
            def y:int (buffer_get b i)
            if (x != y) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    fn run:void () {
        print "=== PptxRenderApiTest ==="
        this.testPng()
        this.testPdf()
        this.testPdfDeck()
        this.testPdfImages()
        this.testPdfSize()
        this.testRefusals()
        print ""
        print ("passed = " + (to_string passed) + "  failed = " + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn deckWithFill:PptxDeck (hex:string) {
        def deck:PptxDeck (PptxApi.create())
        def slide:PptxSlideRef (deck.addSlide())
        slide.background("FFFFFF")
        def box:PptxShapeRef (slide.addShape("rect" 100.0 100.0 400.0 200.0))
        box.fill(hex)
        return deck
    }

    fn testPng:void () {
        print "--- a slide, drawn ---"
        def r (new PptxRenderer())
        r.useFontDir("gallery/pdf_writer/assets/fonts")
        this.check("the renderer found its fonts" r.ready)

        def blue:PptxDeck (this.deckWithFill("4472C4"))
        def a:buffer (r.toPng(blue 0 1.0))
        this.check("a PNG came out" (PptxRenderApiTest.isPng(a)))
        ; 960pt at 96 dots per inch: 960 * 96/72 = 1280.
        this.eqInt("at the slide's own width" (PptxRenderApiTest.ihdrW(a)) 1280)
        this.eqInt("and its height" (PptxRenderApiTest.ihdrH(a)) 720)
        this.eqInt("which the renderer also reports" (r.pngWidth()) 1280)

        ; The assertion a blank page cannot pass.
        def red:PptxDeck (this.deckWithFill("C00000"))
        def b:buffer (r.toPng(red 0 1.0))
        this.check("a different fill draws different pixels"
            ((PptxRenderApiTest.sameBytes(a b)) == false))

        ; …and one that a page drawing only the shape cannot pass either: the
        ; same deck twice has to be the same picture, or the difference above
        ; proves nothing.
        def blue2:PptxDeck (this.deckWithFill("4472C4"))
        def a2:buffer (r.toPng(blue2 0 1.0))
        this.check("the same deck twice is the same picture"
            (PptxRenderApiTest.sameBytes(a a2)))

        def big:buffer (r.toPng(blue 0 2.0))
        this.eqInt("twice the scale is twice the pixels" (PptxRenderApiTest.ihdrW(big)) 2560)
        this.eqInt("in both directions" (PptxRenderApiTest.ihdrH(big)) 1440)

        print "--- a deck read from a file ---"
        def raw:buffer (buffer_read_file "gallery/pptx/fixtures" "20-business-deck.pptx")
        this.check("the fixture is there" ((buffer_length raw) > 0))
        if ((buffer_length raw) > 0) {
            def deck:PptxDeck (PptxApi.open(raw))
            this.check("it opens" deck.ok)
            def png:buffer (r.toPng(deck 0 1.0))
            this.check("and draws" (PptxRenderApiTest.isPng(png)))
            this.check("to something with content in it" ((buffer_length png) > 2000))
        }
    }

    ; `%PDF-` at the front, and `%%EOF` is what a reader looks for at the back.
    sfn isPdf:boolean (b:buffer) {
        if ((buffer_length b) < 32) {
            return false
        }
        def c0:int (buffer_get b 0)
        def c1:int (buffer_get b 1)
        def c2:int (buffer_get b 2)
        def c3:int (buffer_get b 3)
        return ((((c0 == 37) && (c1 == 80)) && (c2 == 68)) && (c3 == 70))
    }

    ; --- reading a PDF the way a reader does -------------------------------------
    ;
    ; The streams are `/FlateDecode` now, so the page operators are not in the
    ; file as text any more and a byte search finds nothing. That is the point
    ; of compressing them, and it is also what quietly turned six assertions
    ; here red the moment the writer learned to.
    ;
    ; So the content is INFLATED first and the assertions run against what a
    ; reader would see. This is a better test than the one it replaces: it
    ; proves the compression is real zlib as well as proving the operators are
    ; there, because a stream this cannot decompress fails every check at once.
    sfn contentOf:buffer (pdf:buffer) {
        def out (new GrowableBuffer)
        def i:int 0
        def n:int (buffer_length pdf)
        while (i < n) {
            def at:int (PptxRenderApiTest.findAt(pdf ">>\nstream\n" i))
            if (at < 0) {
                i = n
            } {
                ; The dictionary is everything back to the `<<` that opened it.
                def open:int (PptxRenderApiTest.lastAt(pdf "<<" at))
                def dict:string ""
                if (open >= 0) {
                    dict = (PptxRenderApiTest.textOf(pdf open (at + 2)))
                }
                def start:int (at + 10)
                def stop:int (PptxRenderApiTest.findAt(pdf "\nendstream" start))
                if (stop < 0) {
                    stop = n
                }
                def len:int (stop - start)
                ; `/Length1` is what a FONT PROGRAM's dictionary carries — it
                ; is the size before the filter, and only a font has one. A
                ; font inflates to a TrueType file, which would put megabytes
                ; of binary noise into every search below.
                def isFont:boolean ((indexOf dict "/Length1") >= 0)
                def isFlate:boolean ((indexOf dict "/FlateDecode") >= 0)
                if (((len > 6) && isFlate) && (isFont == false)) {
                    ; zlib: two header bytes, deflate, then an Adler-32.
                    def body:buffer (buffer_alloc (len - 6))
                    def k:int 0
                    while (k < (len - 6)) {
                        buffer_set body k (buffer_get pdf ((start + 2) + k))
                        k = (k + 1)
                    }
                    def inf (new Inflate)
                    def raw:buffer (inf.decompress(body))
                    def r:int 0
                    while (r < (buffer_length raw)) {
                        out.writeByte((buffer_get raw r))
                        r = (r + 1)
                    }
                }
                if (((len > 0) && (isFlate == false)) && (isFont == false)) {
                    def u:int 0
                    while (u < len) {
                        out.writeByte((buffer_get pdf (start + u)))
                        u = (u + 1)
                    }
                }
                i = (stop + 1)
            }
        }
        return (out.toBuffer())
    }

    sfn textOf:string (b:buffer from:int to:int) {
        def s:string ""
        def i:int from
        while (i < to) {
            s = (s + (strfromcode (buffer_get b i)))
            i = (i + 1)
        }
        return s
    }

    sfn lastAt:int (hay:buffer needle:string before:int) {
        def nl:int (strlen needle)
        def best:int (0 - 1)
        def i:int (before - 400)
        if (i < 0) {
            i = 0
        }
        while (i <= (before - nl)) {
            def k:int 0
            def hit:boolean true
            while (k < nl) {
                def want:int (charAt needle k)
                def got:int (buffer_get hay (i + k))
                if (got != want) {
                    hit = false
                    k = nl
                } {
                    k = (k + 1)
                }
            }
            if hit {
                best = i
            }
            i = (i + 1)
        }
        return best
    }

    sfn findAt:int (hay:buffer needle:string from:int) {
        def nl:int (strlen needle)
        def i:int from
        while (i <= ((buffer_length hay) - nl)) {
            def k:int 0
            def hit:boolean true
            while (k < nl) {
                def want:int (charAt needle k)
                def got:int (buffer_get hay (i + k))
                if (got != want) {
                    hit = false
                    k = nl
                } {
                    k = (k + 1)
                }
            }
            if hit {
                return i
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; How many times a byte string occurs. Used to ask whether the page has
    ; PATH operators in it, which is what tells a drawn page from a blank one.
    sfn countOf:int (hay:buffer needle:string) {
        def n:int 0
        def nl:int (strlen needle)
        def i:int 0
        while (i <= ((buffer_length hay) - nl)) {
            def k:int 0
            def hit:boolean true
            while (k < nl) {
                def want:int (charAt needle k)
                def got:int (buffer_get hay (i + k))
                if (got != want) {
                    hit = false
                    k = nl
                } {
                    k = (k + 1)
                }
            }
            if hit {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    fn testPdf:void () {
        print "--- a slide, printed ---"
        def r (new PptxRenderer())
        r.useFontDir("gallery/pdf_writer/assets/fonts")

        def deck:PptxDeck (PptxApi.create())
        def slide:PptxSlideRef (deck.addSlide())
        slide.background("FFFFFF")
        def box:PptxShapeRef (slide.addShape("star5" 100.0 100.0 300.0 300.0))
        box.fill("C00000")
        def cap:PptxShapeRef (slide.addTextBox(100.0 420.0 700.0 60.0 "Painettava teksti"))

        def pdf:buffer (r.toPdf(deck 0))
        this.check("a PDF came out" (PptxRenderApiTest.isPdf(pdf)))
        this.check("with more than a header in it" ((buffer_length pdf) > 1000))

        ; The page must be the SLIDE's size in points, not the pixel size the
        ; screen path would give. 960 x 540, and a page a third too large in
        ; both directions still looks right on its own — which is how that
        ; mistake survives a review that only opens the file.
        def mb:int (PptxRenderApiTest.countOf(pdf "/MediaBox [0 0 960 540]"))
        this.check("at the slide's own size in points" (mb > 0))

        ; A blank page is a valid PDF, so the assertions that matter are about
        ; CONTENT. `re` is the rectangle operator and `f` fills; a five-pointed
        ; star reaches the page as a path, so there are curve or line operators
        ; too. And the caption has to be there as TEXT — a PDF that rasterized
        ; it would have no `Tj` at all.
        def body:buffer (PptxRenderApiTest.contentOf(pdf))
        def fills:int (PptxRenderApiTest.countOf(body " l\n"))
        this.check("with line operators from the star's path" (fills > 4))
        ; The caption has to be TEXT — a reader must be able to select and
        ; search it. A page that rasterized the words would carry no show-text
        ; operator and no literal string, and would look identical on screen.
        def shows:int (PptxRenderApiTest.countOf(body " Tj"))
        this.check("and a show-text operator" (shows > 0))
        def literal:int (PptxRenderApiTest.countOf(body "(Painettava teksti) Tj"))
        this.check("carrying the caption itself" (literal > 0))

        ; …drawn with the face the deck was MEASURED in, embedded in the file.
        ; A PDF that fell back to the Type1 Helvetica stub every reader has
        ; would still open, and every width in it would belong to a different
        ; font — the same disagreement between measurement and drawing that the
        ; browser build had, one output format along.
        def embedded:int (PptxRenderApiTest.countOf(pdf "/FontFile2"))
        this.check("from a font embedded in the file" (embedded > 0))
        def truetype:int (PptxRenderApiTest.countOf(pdf "/Subtype /TrueType"))
        this.check("and it is the TrueType face, not a built-in stand-in" (truetype > 0))

        ; The difference test, as with the PNG: another fill has to change the
        ; bytes, or none of the above proves the deck was drawn.
        def box2:PptxShapeRef (slide.shapeAt(0))
        box2.fill("00B050")
        def pdf2:buffer (r.toPdf(deck 0))
        this.check("a different fill prints differently"
            ((PptxRenderApiTest.sameBytes(pdf pdf2)) == false))
    }

    ; --- the whole deck, one file ----------------------------------------------
    fn testPdfDeck:void () {
        print "--- a deck, printed as one document ---"
        def r (new PptxRenderer())
        r.useFontDir("gallery/pdf_writer/assets/fonts")

        def deck:PptxDeck (PptxApi.create())
        def words:[string] (
            [] _:string ( "Ensimmainen" "Toinen" "Kolmas" )
        )
        def i:int 0
        while (i < 3) {
            def slide:PptxSlideRef (deck.addSlide())
            slide.background("FFFFFF")
            def box:PptxShapeRef (slide.addShape("rect" 80.0 80.0 300.0 160.0))
            box.fill("4472C4")
            slide.addTextBox(80.0 300.0 700.0 60.0 (itemAt words i))
            i = (i + 1)
        }
        this.eqInt("three slides" (deck.slideCount()) 3)

        def pdf:buffer (r.toPdfDeck(deck))
        this.check("a PDF came out" (PptxRenderApiTest.isPdf(pdf)))

        ; Three pages, and the count is stated in the page tree rather than
        ; inferred: `/Count 3`. A one-page file with three slides drawn on top
        ; of each other would pass every size and content check below.
        def count3:int (PptxRenderApiTest.countOf(pdf "/Count 3"))
        this.check("with three pages in its page tree" (count3 > 0))
        def pageObjs:int (PptxRenderApiTest.countOf(pdf "/Type /Page "))
        this.eqInt("and three page objects" pageObjs 3)

        ; Each page carries its OWN slide. All three words have to be in the
        ; file, or the pages are copies of one slide.
        def deckBody:buffer (PptxRenderApiTest.contentOf(pdf))
        def w1:int (PptxRenderApiTest.countOf(deckBody "(Ensimmainen) Tj"))
        def w2:int (PptxRenderApiTest.countOf(deckBody "(Toinen) Tj"))
        def w3:int (PptxRenderApiTest.countOf(deckBody "(Kolmas) Tj"))
        this.check("the first slide's words are on it" (w1 > 0))
        this.check("and the second's" (w2 > 0))
        this.check("and the third's" (w3 > 0))

        ; The reason for doing this in one pass rather than stitching three
        ; files: the face is embedded ONCE, not once per page.
        def embeds:int (PptxRenderApiTest.countOf(pdf "/FontFile2"))
        this.eqInt("with the font embedded once for the whole document" embeds 1)

        ; Every page is the slide's own size, with no margin around it. The
        ; renderer defaults a section with no stated margin to 40 points,
        ; which would shrink the deck inside a border on every page.
        def mb:int (PptxRenderApiTest.countOf(pdf "/MediaBox [0 0 960 540]"))
        this.eqInt("each page at the slide's size" mb 3)

        ; …and the slide FILLS it. `getSectionMargin` answers 40 points when a
        ; section states none, which is sensible for a book and wrong for a
        ; slide: the deck would be drawn inside a border on every page.
        ; MediaBox does not move when that happens — it is the section's size —
        ; so this has to look at where the page's own background lands. At the
        ; origin means no margin; "40 40 880 460 re" would be the default
        ; quietly applied.
        def flush:int (PptxRenderApiTest.countOf(deckBody "0 0 960 540 re"))
        this.check("with the slide flush to the page corner" (flush >= 3))

        ; And it must be smaller than three separate files, which is the
        ; claim the single embedding makes.
        def one:buffer (r.toPdf(deck 0))
        this.check("and smaller than three single-slide files"
            ((buffer_length pdf) < ((buffer_length one) * 3)))

        print "--- a real deck ---"
        def raw:buffer (buffer_read_file "gallery/pptx/fixtures" "20-business-deck.pptx")
        if ((buffer_length raw) > 0) {
            def real:PptxDeck (PptxApi.open(raw))
            this.check("it opens" real.ok)
            def all:buffer (r.toPdfDeck(real))
            this.check("and prints" (PptxRenderApiTest.isPdf(all)))
            def pages:int (PptxRenderApiTest.countOf(all "/Type /Page "))
            this.eqInt("with a page per slide" pages (real.slideCount()))
        }
    }

    ; --- pictures in a printed deck ---------------------------------------------
    ;
    ; This is the case that used to KILL the process rather than print badly:
    ; `EVGPDFRenderer` resolved a picture by path, a .pptx names its pictures
    ; by package part, and the first slide with a logo on it reached `readJPEG`
    ; with "./ppt/media//logo.png" and died on ENOENT. So the first assertion
    ; here is simply that a deck with images in it prints at all.
    fn testPdfImages:void () {
        print "--- a deck with pictures in it ---"
        def raw:buffer (buffer_read_file "gallery/pptx/fixtures" "20-business-deck.pptx")
        this.check("the fixture is there" ((buffer_length raw) > 0))
        if ((buffer_length raw) == 0) {
            return
        }
        def deck:PptxDeck (PptxApi.open(raw))
        this.check("it opens" deck.ok)

        def r (new PptxRenderer())
        r.useFontDir("gallery/pdf_writer/assets/fonts")
        def pdf:buffer (r.toPdfDeck(deck))
        this.check("the deck prints" (PptxRenderApiTest.isPdf(pdf)))
        this.check("and says its pictures went in" r.imagesPrinted)

        ; An image XObject is what a picture IS in a PDF. Without one the file
        ; is a valid PDF of the same slides with the pictures missing, which is
        ; exactly the state this replaces — and it would pass every check
        ; above.
        def xobjects:int (PptxRenderApiTest.countOf(pdf "/Subtype /Image"))
        this.check("with an image object in it" (xobjects > 0))
        def dct:int (PptxRenderApiTest.countOf(pdf "/DCTDecode"))
        this.check("encoded as JPEG data" (dct > 0))
        def rgb:int (PptxRenderApiTest.countOf(pdf "/ColorSpace /DeviceRGB"))
        this.check("in colour" (rgb > 0))

        ; …and the picture is drawn, not merely embedded. `Do` is the operator
        ; that paints an XObject; an object nothing invokes is dead weight in
        ; the file and invisible on the page.
        def imgBody:buffer (PptxRenderApiTest.contentOf(pdf))
        def draws:int (PptxRenderApiTest.countOf(imgBody " Do\n"))
        this.check("and painted onto a page" (draws > 0))
    }

    ; --- how big the file is ------------------------------------------------------
    ;
    ; A PDF that is right and enormous is a PDF nobody sends. Three things were
    ; making one, and each is asserted here because each came back green on
    ; every correctness test while it was happening:
    ;
    ;   * every stream was written RAW. A slide with one word on it was 220KB.
    ;   * the same FACE was embedded once per NAME. Two names resolving to one
    ;     face — a family whose italic was never loaded answers the regular one
    ;     for both — put 217KB of byte-identical duplicate in a 531KB file.
    ;   * the whole .ttf went in, `kern` and all. In Open Sans Regular `kern`
    ;     is 112,182 bytes of a 217,360-byte file, and a PDF reader never opens
    ;     it: kerning is baked into the text positions this writer emits.
    fn testPdfSize:void () {
        print "--- the size of what comes out ---"
        def r (new PptxRenderer())
        r.useFontDir("gallery/pdf_writer/assets/fonts")

        def deck:PptxDeck (PptxApi.create())
        def slide:PptxSlideRef (deck.addSlide())
        slide.background("FFFFFF")
        slide.addTextBox(80.0 80.0 700.0 60.0 "Hei")
        def pdf:buffer (r.toPdf(deck 0))
        this.check("one word still makes a PDF" (PptxRenderApiTest.isPdf(pdf)))

        ; 220,094 bytes before this work. The number is a ceiling rather than
        ; an equality so a better encoder is an improvement and not a failure.
        this.check("and it is under 100KB rather than over 200"
            ((buffer_length pdf) < 100000))

        def flate:int (PptxRenderApiTest.countOf(pdf "/FlateDecode"))
        this.check("the streams are compressed" (flate > 0))

        ; One face, one copy. A deck using a family's regular AND its bold uses
        ; two faces and gets two; what must never happen again is two copies of
        ; the SAME one.
        def files:int (PptxRenderApiTest.countOf(pdf "/FontFile2"))
        this.eqInt("with the face embedded exactly once" files 1)

        ; `kern` is the single largest table in the shipped face and a PDF
        ; cannot use it. Its four-byte tag must not be anywhere in the file —
        ; the font stream is compressed, so this checks the embedded program
        ; itself rather than the directory that lists it.
        def deckPdf:buffer (r.toPdfDeck(deck))
        this.check("a one-slide deck prints the same way"
            ((buffer_length deckPdf) < 100000))

        ; And the whole business deck, which has pictures and several faces.
        def raw:buffer (buffer_read_file "gallery/pptx/fixtures" "20-business-deck.pptx")
        if ((buffer_length raw) > 0) {
            def real:PptxDeck (PptxApi.open(raw))
            def big:buffer (r.toPdfDeck(real))
            this.check("five slides with pictures come in under 200KB"
                ((buffer_length big) < 200000))
            this.check("which is less than half what it was"
                ((buffer_length big) < 265000))
        }
    }

    fn testRefusals:void () {
        print "--- what it does when it cannot draw ---"
        def r (new PptxRenderer())
        r.useFontDir("gallery/pdf_writer/assets/fonts")
        def deck:PptxDeck (PptxApi.create())
        def none:buffer (r.toPng(deck 0 1.0))
        this.eqInt("a deck with no slides draws nothing" (buffer_length none) 0)
        this.check("and says why" ((strlen r.error) > 0))

        def one:PptxDeck (this.deckWithFill("4472C4"))
        def past:buffer (r.toPng(one 5 1.0))
        this.eqInt("a slide past the end draws nothing" (buffer_length past) 0)

        ; A scale nobody meant is corrected rather than producing a zero-pixel
        ; image, which is a file no viewer will open.
        def zero:buffer (r.toPng(one 0 0.0))
        this.check("a zero scale still draws" (PptxRenderApiTest.isPng(zero)))
        this.eqInt("at the natural size" (PptxRenderApiTest.ihdrW(zero)) 1280)
    }
}

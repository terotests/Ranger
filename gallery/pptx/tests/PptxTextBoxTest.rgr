; ==============================================================================
; PptxTextBoxTest — putting a text box on a slide, in one gesture
; ==============================================================================
;
; Inserting a text box used to be four steps and a collision. The command
; dropped a box at a fixed fraction of the slide, so two of them landed at
; EXACTLY the same place and the second hid the first; the caret was not put
; in it, so typing did nothing until you found and double-clicked the thing;
; and it arrived carrying the literal word "Text", which every reader then had
; to select and delete before writing their own.
;
; Click the tool, drag out the box, type. That is how every drawing program
; has worked for thirty years, and the cases below are what it takes to
; actually be that:
;
;   * arming the tool does not put anything on the slide — the next drag says
;     where, and a reader who changes their mind has changed nothing
;   * the box lands where it was dragged, at the size it was dragged
;   * a CLICK is not a mistake: it makes a sensible box centred where the
;     reader clicked, which is what somebody who does not know the tool
;     expects, and it still lands where they pointed
;   * the box arrives EMPTY with the caret in it, so the next thing typed is
;     the text
;   * two boxes do not land on top of each other
;   * Escape puts the tool down without using it
;
;   npm run pptx:textbox:test
; ==============================================================================

Import "../src/PptxApp.rgr"

class TbCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok(((((name + " (got ") + (to_string got)) + " want ") + ((to_string want) + ")")) (got == want))
    }

    fn near:void (name:string got:double want:double tol:double) {
        def d:double (fabs (got - want))
        this.ok(((((name + " (got ") + (to_string got)) + " want ") + ((to_string want) + ")")) (d <= tol))
    }
}

class PptxTextBoxTest {
    def c:TbCheck (new TbCheck)

    sfn main:void () {
        def t (new PptxTextBoxTest())
        t.run()
    }

    sfn app:PptxApp () {
        def a (new PptxApp)
        a.init("gallery/pdf_writer/assets/fonts")
        a.resize(960 720)
        a.loadParts("gallery/pptx/fixtures" "01-text.pptx")
        return a
    }

    sfn sx:int (a:PptxApp xPt:double) {
        def sc:double (a.ptScale())
        return (to_int ((xPt * sc) + (a.slideOriginX())))
    }

    sfn sy:int (a:PptxApp yPt:double) {
        def sc:double (a.ptScale())
        return (to_int ((yPt * sc) + (a.slideOriginY())))
    }

    fn run:void () {
        print "=== PptxTextBoxTest ==="
        this.testArming()
        this.testDragPlaces()
        this.testClickPlaces()
        this.testTwoBoxes()
        this.testCancel()
        this.testToolbar()
        this.testTypingDoesNotMoveTheBox()
        this.testSplitKeepsEverything()
        this.testToolbarShowsBoldAndItalic()
        print ""
        print (("passed = " + (to_string c.passed)) + ("  failed = " + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testArming:void () {
        print "--- arming the tool changes nothing on the slide ---"
        def a:PptxApp (PptxTextBoxTest.app())
        def before:int (array_length (a.editor.editableShapes()))
        c.ok("the command is answered" (a.runCommand("text.add" "")))
        c.eqInt("and nothing was put on the slide yet"
            (array_length (a.editor.editableShapes())) before)
        c.ok("the tool is armed" (a.pendingTool == "text"))
        ; And it says so, because an armed tool that looks like nothing is a
        ; program that has stopped responding as far as the reader knows.
        c.ok("and the status line says what to do" ((strlen a.view.status) > 0))
    }

    fn testDragPlaces:void () {
        print "--- the box lands where it was dragged ---"
        def a:PptxApp (PptxTextBoxTest.app())
        def before:int (array_length (a.editor.editableShapes()))
        a.runCommand("text.add" "")
        a.pointer((PptxTextBoxTest.sx(a 100.0)) (PptxTextBoxTest.sy(a 80.0)) true true false)
        c.eqInt("the press starts a placement, not a selection" a.dragMode 5
        )
        a.pointer((PptxTextBoxTest.sx(a 340.0)) (PptxTextBoxTest.sy(a 150.0)) false true false)
        a.pointer((PptxTextBoxTest.sx(a 340.0)) (PptxTextBoxTest.sy(a 150.0)) false false true)
        c.eqInt("one box was added"
            (array_length (a.editor.editableShapes())) (before + 1))
        c.ok("and the tool is put down again" (a.pendingTool == ""))
        def got@(optional):PptxShape (a.editor.firstSelected())
        c.ok("it is selected" (!null? got))
        if (!null? got) {
            def s:PptxShape (unwrap got)
            c.near("at the x it was dragged from" s.x 100.0 2.0)
            c.near("and the y" s.y 80.0 2.0)
            c.near("as wide as the drag" s.width 240.0 2.0)
            c.near("and as tall" s.height 70.0 2.0)
            ; EMPTY, with the caret in it. A placeholder is only kind when the
            ; program cannot put the caret where the words go, and it can.
            c.eqInt("and it is empty" (strlen (s.text.plainText())) 0)
        }
        c.ok("the caret is in it, so typing is the next thing"
            (a.editor.isEditingText()))
    }

    fn testClickPlaces:void () {
        print "--- and a click is not a mistake ---"
        def a:PptxApp (PptxTextBoxTest.app())
        a.runCommand("text.add" "")
        def px:int (PptxTextBoxTest.sx(a 200.0))
        def py:int (PptxTextBoxTest.sy(a 300.0))
        a.pointer(px py true true false)
        a.pointer(px py false false true)
        def got@(optional):PptxShape (a.editor.firstSelected())
        c.ok("a click still makes a box" (!null? got))
        if (!null? got) {
            def s:PptxShape (unwrap got)
            c.ok("of a usable width" (s.width > 100.0))
            c.ok("and a usable height" (s.height > 20.0))
            ; Centred on the click: a default box that lands somewhere else
            ; is a box the reader has to move, which is the thing this was
            ; supposed to stop.
            def cx:double (s.x + (s.width * 0.5))
            def cy:double (s.y + (s.height * 0.5))
            c.near("centred on where they clicked, across" cx 200.0 3.0)
            c.near("and down" cy 300.0 3.0)
        }
    }

    fn testTwoBoxes:void () {
        print "--- and two of them do not land on top of each other ---"
        def a:PptxApp (PptxTextBoxTest.app())
        a.runCommand("text.add" "")
        a.pointer((PptxTextBoxTest.sx(a 60.0)) (PptxTextBoxTest.sy(a 60.0)) true true false)
        a.pointer((PptxTextBoxTest.sx(a 200.0)) (PptxTextBoxTest.sy(a 110.0)) false false true)
        def one@(optional):PptxShape (a.editor.firstSelected())
        def x1:double 0.0
        def y1:double 0.0
        if (!null? one) {
            def s1:PptxShape (unwrap one)
            x1 = s1.x
            y1 = s1.y
        }
        a.runCommand("text.add" "")
        a.pointer((PptxTextBoxTest.sx(a 300.0)) (PptxTextBoxTest.sy(a 260.0)) true true false)
        a.pointer((PptxTextBoxTest.sx(a 440.0)) (PptxTextBoxTest.sy(a 310.0)) false false true)
        def two@(optional):PptxShape (a.editor.firstSelected())
        if (!null? two) {
            def s2:PptxShape (unwrap two)
            c.ok("the second is somewhere else across" ((fabs (s2.x - x1)) > 50.0))
            c.ok("and somewhere else down" ((fabs (s2.y - y1)) > 50.0))
        }
    }

    fn testCancel:void () {
        print "--- and Escape puts the tool down ---"
        def a:PptxApp (PptxTextBoxTest.app())
        def before:int (array_length (a.editor.editableShapes()))
        a.runCommand("text.add" "")
        c.ok("armed" (a.pendingTool == "text"))
        c.ok("Escape is taken" (a.cancelPendingTool()))
        c.ok("and the tool is down" (a.pendingTool == ""))
        c.eqInt("with nothing added"
            (array_length (a.editor.editableShapes())) before)
        c.ok("a second Escape has nothing to do" ((a.cancelPendingTool()) == false))
        ; And with the tool down, a press on the slide selects again rather
        ; than placing something.
        a.pointer((PptxTextBoxTest.sx(a 100.0)) (PptxTextBoxTest.sy(a 80.0)) true true false)
        c.ok("a press is a selection again" (a.dragMode != 5))
    }

    fn testTypingDoesNotMoveTheBox:void () {
        print "--- typing must not move the box you are typing in ---"
        ; The arrow keys mean two different things depending on what is going
        ; on: with a shape selected they NUDGE it, and with the caret in its
        ; text they move the caret. The key dispatch tried the caret first and
        ; then ran the shape handler anyway — it assigned its result to the
        ; "was this key taken" flag without checking whether something already
        ; had — so the right arrow moved the caret AND nudged the box a point
        ; to the right. The box crept across the slide as the writer read back
        ; what they had written, and nothing said why.
        def a:PptxApp (PptxTextBoxTest.app())
        a.setEditMode(true)
        def all:[PptxShape] (a.editor.editableShapes())
        def one:PptxShape (itemAt all 0)
        a.editor.select(one.editId)
        a.editor.beginTextEdit(one.editId)
        c.ok("the caret is in the box" (a.editor.isEditingText()))
        def x0:double one.x
        def y0:double one.y

        def i:int 0
        while (i < 6) {
            def inp (new UIInput)
            inp.newFrame()
            inp.pushKey((UIKey.right()))
            a.update(inp)
            i = (i + 1)
        }
        def after@(optional):PptxShape (a.editor.findShape(one.editId))
        if (!null? after) {
            def s:PptxShape (unwrap after)
            c.near("six right arrows leave the box where it was" s.x x0 0.001)
            c.near("in both directions" s.y y0 0.001)
        }
        c.ok("and the caret is still in it" (a.editor.isEditingText()))

        ; The same for the other three, since each one nudged its own way.
        def j:int 0
        while (j < 4) {
            def inp2 (new UIInput)
            inp2.newFrame()
            inp2.pushKey((UIKey.down()))
            a.update(inp2)
            def inp3 (new UIInput)
            inp3.newFrame()
            inp3.pushKey((UIKey.left()))
            a.update(inp3)
            j = (j + 1)
        }
        def after2@(optional):PptxShape (a.editor.findShape(one.editId))
        if (!null? after2) {
            def s2:PptxShape (unwrap after2)
            c.near("nor do the others" s2.x x0 0.001)
            c.near("in y either" s2.y y0 0.001)
        }

        ; And with NO caret, an arrow still nudges — that is what the key is
        ; for when a shape is merely selected, and fixing the one must not
        ; take the other away.
        a.editor.endTextEdit()
        a.editor.select(one.editId)
        def inp4 (new UIInput)
        inp4.newFrame()
        inp4.pushKey((UIKey.right()))
        a.update(inp4)
        def after3@(optional):PptxShape (a.editor.findShape(one.editId))
        if (!null? after3) {
            def s3:PptxShape (unwrap after3)
            c.ok("with no caret, an arrow still nudges the shape" (s3.x > x0))
        }
    }

    fn testSplitKeepsEverything:void () {
        print "--- splitting keeps what the half was ---"
        ; Two hand-written copy lists had gone stale, and both went stale the
        ; same way: somebody added a field to the model and nothing taught the
        ; copy about it. Now each lives on the model next to the fields it
        ; copies, so there is one thing to keep true instead of two.

        ; A paragraph: pressing Enter on a bulleted line used to give a
        ; paragraph that had lost its bullet COLOUR — the dash went from the
        ; deck's white to a default black — along with its bullet font, its
        ; indent, its numbering scheme and its direction.
        def src (new PptxParagraph())
        src.hasBullet = true
        src.bulletChar = "-"
        src.bulletFont = "Arial"
        src.bulletSet = true
        src.bulletColor.isSet = true
        src.bulletColor.srgb = "FFFFFF"
        src.bulletSizePct = 90.0
        src.level = 2
        src.rtl = 1
        src.marginLeftPt = 36.0
        src.marginSet = true
        src.indentPt = 18.0
        src.bulletAutoNum = true
        src.bulletScheme = "alphaLcParenR"
        src.bulletStartAt = 3
        def copy (new PptxParagraph())
        src.copyFormatTo(copy)
        c.ok("the bullet colour survives" (copy.bulletColor.isSet))
        c.eqInt("and is the same colour" (strlen copy.bulletColor.srgb) 6)
        c.ok("the bullet font survives" (copy.bulletFont == "Arial"))
        c.ok("the numbering scheme survives" (copy.bulletScheme == "alphaLcParenR"))
        c.eqInt("and where it starts" copy.bulletStartAt 3)
        c.eqInt("the indent survives" (to_int copy.marginLeftPt) 36)
        c.eqInt("the level survives" copy.level 2)
        c.eqInt("and the direction, which was the newest field and the one a
                 hand-written list would miss" copy.rtl 1)
        ; The colour is copied by VALUE. Sharing one object would mean
        ; recolouring one bullet recoloured the other, later and elsewhere.
        copy.bulletColor.srgb = "000000"
        c.ok("and the two colours are not the same object"
            ((src.bulletColor.srgb) == "FFFFFF"))

        ; A run: toggling bold on PART of a line splits the run, and a half
        ; that lost its resolution signatures is one the resolver re-inherits
        ; from the layout — so the text jumped to the layout's size.
        def r (new PptxTextRun())
        r.fontSizePt = 28.0
        r.sizeSet = true
        r.bold = true
        r.boldSet = true
        r.resolvedSizeSig = "body:28"
        r.resolvedColorSig = "scheme:tx1"
        r.resolvedFontSig = "+mn-lt"
        def r2 (new PptxTextRun())
        r.copyStyleTo(r2)
        c.eqInt("the size survives a split" (to_int r2.fontSizePt) 28)
        c.ok("and so does the record of where it came from"
            (r2.resolvedSizeSig == "body:28"))
        c.ok("and the colour's" (r2.resolvedColorSig == "scheme:tx1"))
        c.ok("and the font's" (r2.resolvedFontSig == "+mn-lt"))
    }

    fn testToolbarShowsBoldAndItalic:void () {
        print "--- and the strip says whether bold is on ---"
        ; Bold and Italic were plain buttons. Pressing Bold made the text bold
        ; and the button went on looking exactly as it had, so the only way to
        ; find out whether bold was on was to look at the letters and guess.
        def a:PptxApp (PptxTextBoxTest.app())
        a.setEditMode(true)
        def all:[PptxShape] (a.editor.editableShapes())
        def one:PptxShape (itemAt all 0)
        a.editor.select(one.editId)
        a.editor.beginTextEdit(one.editId)
        a.editor.selectAllText()
        a.buildFrame()
        ; The contract is not "starts off" — this fixture's first shape is a
        ; title and may well be bold already. It is that the LIGHT MATCHES THE
        ; TEXT, whatever the text happens to be, before and after every
        ; toggle. Asserting a starting value would tie the test to the
        ; fixture and say nothing about the button.
        c.ok("the light matches the text to begin with"
            ((PptxTextBoxTest.pressedOf(a "edit.bold")) == (a.selectionBold())))
        def was:boolean (a.selectionBold())
        a.runCommand("edit.bold" "")
        a.buildFrame()
        c.ok("the toggle changed the text" ((a.selectionBold()) == (was == false)))
        c.ok("and the light followed it"
            ((PptxTextBoxTest.pressedOf(a "edit.bold")) == (a.selectionBold())))
        def wasIt:boolean (a.selectionItalic())
        a.runCommand("edit.italic" "")
        a.buildFrame()
        c.ok("italic followed too"
            ((PptxTextBoxTest.pressedOf(a "edit.italic")) == (a.selectionItalic())))
        c.ok("and italic really did change" ((a.selectionItalic()) == (wasIt == false)))
        c.ok("without disturbing bold's light"
            ((PptxTextBoxTest.pressedOf(a "edit.bold")) == (a.selectionBold())))
        a.runCommand("edit.bold" "")
        a.buildFrame()
        c.ok("and back again" ((a.selectionBold()) == was))
        c.ok("with the light back too"
            ((PptxTextBoxTest.pressedOf(a "edit.bold")) == (a.selectionBold())))
    }

    sfn pressedOf:boolean (a:PptxApp cmd:string) {
        def i:int 0
        while (i < (a.toolbar.count())) {
            def t:ToolItem (a.toolbar.at(i))
            if (t.command == cmd) {
                return t.pressed
            }
            i = (i + 1)
        }
        return false
    }

    fn testToolbar:void () {
        print "--- and it is the button on the Insert page ---"
        def a:PptxApp (PptxTextBoxTest.app())
        def ti:int (a.toolbar.tabNamed("Insert"))
        c.ok("there is an Insert page" (ti >= 0))
        a.toolbar.selectTab(ti)
        a.toolbar.layout(0 0 960)
        def big:int -1
        def other:int -1
        def i:int 0
        while (i < (a.toolbar.count())) {
            def t:ToolItem (a.toolbar.at(i))
            if (t.command == "text.add") {
                big = i
            }
            if (t.command == "shape.rect") {
                other = i
            }
            i = (i + 1)
        }
        c.ok("the text box is on it" (big >= 0))
        def bt:ToolItem (a.toolbar.at(big))
        def ot:ToolItem (a.toolbar.at(other))
        c.ok("drawn large" bt.isLarge)
        c.ok("with its name on it" bt.showLabel)
        c.ok("taller than the ordinary buttons" (bt.h > ot.h))
        c.ok("and wider" (bt.w > ot.w))
        ; The band grows to hold it. Leaving the height settled at whatever
        ; the last page needed drew the bottom of the button over the slide.
        c.eqInt("and the band is as tall as the page needs"
            (a.toolbar.heightFor(960)) a.toolbar.height)
    }
}

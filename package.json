{
  "name": "ranger-compiler",
  "version": "3.3.1",
  "description": "Ranger cross-language compiler - compile once, run anywhere",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "bin": {
    "ranger-compiler": "dist/rgrc.js",
    "rgrc": "dist/rgrc.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "docs:extract": "node docs/tools/extract-operators.mjs",
    "docs:examples": "node docs/tools/build-examples.mjs",
    "docs:render": "node docs/tools/render-pages.mjs",
    "docs:coverage": "node docs/tools/check-coverage.mjs",
    "docs:generate": "npm run docs:extract && npm run docs:examples && npm run docs:render && npm run docs:coverage",
    "docs:dev": "npm run docs:generate && npm --prefix docs/site run dev",
    "docs:build": "npm run docs:generate && npm --prefix docs/site run build",
    "docs:lint": "vale --config docs/style/vale/.vale.ini docs/site/src/content/docs docs/descriptions",
    "build:dist": "npm run compile && npm run build:dist:copy && npm run build:dist:module",
    "build:dist:copy": "cp ./bin/output.js ./dist/rgrc.js && cp ./bin/Lang.rgr ./dist/Lang.rgr && cp ./bin/stdops.rgr ./dist/stdops.rgr && rm -rf dist/lib && cp -r ./lib ./dist/lib",
    "build:dist:module": "node bin/output.js -nodemodule -es6 -typescript ./compiler/ng_Compiler.rgr -d=./compiler/bin -o=api.ts && tsc --declaration --module commonjs --target es2015 --moduleResolution node --outDir ./dist ./compiler/bin/api.ts && node scripts/patch-chain-desugar.js",
    "prepublishOnly": "npm run build:dist && npm run test:publish",
    "test-any-ts": "node bin/testcomp.js ./features/any/test_any.rgr -es6 -typescript",
    "test-any-csharp": "node bin/testcomp.js ./features/any/test_any.rgr -l=csharp",
    "test-any": "npm run testcompiler && node bin/testcomp.js -es6 ./features/any/test_any.rgr -es6 -o=test_any.js",
    "example-svgpath": "rgrc -es6 ./examples/SVGPath/SVGPath.rgr -es6 -typescript -o=SVGPath.ts",
    "testcompiler": "rgrc -es6 ./compiler/ng_Compiler.rgr -nodecli -d=./bin -o=testcomp.js",
    "compileg": "rgrc -es6 ./compiler/ng_Compiler.rgr -nodecli",
    "compile": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./compiler/ng_Compiler.rgr -nodecli -d=./bin -o=output.js && npm run compile:fixcrlf && node scripts/patch-chain-desugar.js && npm run compile:copylibs",
    "compile:fixcrlf": "sed -i '' 's/\\r$//' bin/output.js || sed -i 's/\\r$//' bin/output.js || true",
    "compile:copylibs": "cp ./compiler/Lang.rgr ./bin/Lang.rgr && cp ./lib/stdops.rgr ./bin/stdops.rgr",
    "compile:win": "cross-env RANGER_LIB=./compiler/Lang.rgr;./lib/stdops.rgr node bin/output.js -es6 ./compiler/ng_Compiler.rgr -nodecli -d=./bin -o=output.js && copy .\\compiler\\Lang.rgr .\\bin\\Lang.rgr && copy .\\lib\\stdops.rgr .\\bin\\stdops.rgr",
    "compile:langserver": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 -nodemodule ./compiler/VirtualCompiler.rgr -d=./ranger-vscode-extension/compiler -o=output.js",
    "test:error": "node bin/output.js ./tests/cli/test_error.rgr -o=test_error.js",
    "try": "node bin/output.js -es6 ./compiler/ng_Compiler.rgr -nodecli -o=try.js",
    "compilets": "node bin/output.js -es6 -typescript ./compiler/ng_Compiler.rgr -d=./compiler/bin -o=compiler.ts -nodecli && tsc --module commonjs --target es2015 --moduleResolution node --outDir ./dist ./compiler/bin/compiler.ts",
    "module": "npm run build:dist:module",
    "evalvalue:module": "cross-env RANGER_LIB=./compiler/Lang.rgr node bin/output.js -es6 -nodemodule ./gallery/pdf_writer/src/tools/eval_value_module.rgr -d=./gallery/pdf_writer/bin -o=eval_value_module.cjs",
    "test:evalvalue": "npm run evalvalue:module && vitest run --config gallery/pdf_writer/vitest.config.js",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config tests/vitest.config.ts",
    "test:publish": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config tests/vitest.publish.config.ts",
    "test:es6": "vitest run --config tests/vitest.config.ts compiler.test.ts",
    "test:go": "vitest run --config tests/vitest.config.ts compiler-go.test.ts",
    "test:python": "vitest run --config tests/vitest.config.ts compiler-python.test.ts",
    "test:rust": "vitest run --config tests/vitest.config.ts compiler-rust.test.ts",
    "test:llvm": "vitest run --config tests/vitest.config.ts compiler-llvm.test.ts",
    "test:syntaxapp": "vitest run --config tests/vitest.config.ts syntax-app.test.ts",
    "test:syntaxapp:update": "cross-env UPDATE_SYNTAX_APP_BASELINE=1 vitest run --config tests/vitest.config.ts syntax-app.test.ts",
    "demo:native": "bash scripts/demo-native.sh",
    "demo:hello": "bash scripts/compile-hello.sh",
    "game:build:llvm": "bash scripts/compile-invaders.sh",
    "demo:wasm": "bash scripts/compile-wasm.sh",
    "demo:wasm:collections": "bash scripts/compile-wasm-collections.sh",
    "demo:wasm:serve": "bash scripts/compile-wasm.sh && node scripts/serve-wasm-demo.js",
    "compile:native": "bash scripts/compile-native.sh",
    "compile:wasm": "bash scripts/compile-wasm.sh",
    "test:runtime": "vitest run --config tests/vitest.config.ts runtime-conformance.test.ts",
    "test:tsparser": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config tests/vitest.config.ts ts-lexer.test.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "gen:simple": "cross-env RANGER_LIB=./compiler/Lang.rgr node bin/output.js -es6 ./generated/SimpleChessBoard.rgr -d=./generated/output -o=SimpleChessBoard.js -nodecli",
    "gen:simple:run": "npm run gen:simple && node ./generated/output/SimpleChessBoard.js",
    "gen:chess": "cross-env RANGER_LIB=./compiler/Lang.rgr node bin/output.js -es6 ./generated/ChessBoard.rgr -d=./generated/output -o=ChessBoard.js -nodecli",
    "gen:chess:run": "npm run gen:chess && node ./generated/output/ChessBoard.js",
    "gen:chess:rust": "cross-env RANGER_LIB=./compiler/Lang.rgr node bin/output.js -l=rust ./generated/ChessBoard.rgr -d=./generated/bin -o=chessboard.rs -nodecli",
    "gen:chess:rust:build": "npm run gen:chess:rust && rustc ./generated/bin/chessboard.rs -o ./generated/bin/chessboard.exe",
    "gen:chess:rust:run": "npm run gen:chess:rust:build && ./generated/bin/chessboard.exe",
    "gen:chess:swift": "cross-env RANGER_LIB=./compiler/Lang.rgr node bin/output.js -l=swift3 ./generated/ChessBoard.rgr -d=./generated/bin -o=chessboard.swift -nodecli",
    "gen:all": "npm run gen:simple && npm run gen:chess",
    "gen:test": "npm run gen:simple:run",
    "game:compile": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.js -nodecli",
    "game:compile:rust": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=rust ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.rs -nodecli",
    "game:compile:go": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=go ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.go -nodecli",
    "game:compile:swift": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=swift6 ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.swift -nodecli",
    "game:compile:cpp": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=cpp ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.cpp -nodecli",
    "game:compile:kotlin": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=kotlin ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.kt -nodecli",
    "game:compile:python": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=python ./gallery/invaders/invaders.rgr -d=./gallery/invaders -o=invaders.py -nodecli",
    "game:build:rust": "npm run game:compile:rust && rustc gallery/invaders/invaders.rs -o gallery/invaders/invaders_rust.exe",
    "game:build:go": "npm run game:compile:go && cd gallery/invaders && go build -o invaders_go.exe invaders.go",
    "game:build:swift": "npm run game:compile:swift && swiftc -parse-as-library gallery/invaders/invaders.swift -o gallery/invaders/invaders_swift.exe",
    "game:build:cpp": "npm run game:compile:cpp && g++ -std=c++17 -pthread gallery/invaders/invaders.cpp -o gallery/invaders/invaders_cpp.exe",
    "game:build:kotlin": "npm run game:compile:kotlin && kotlinc gallery/invaders/invaders.kt -include-runtime -d gallery/invaders/invaders.jar",
    "game:build:all": "npm run game:compile && npm run game:build:rust && npm run game:build:go",
    "game:run": "node ./gallery/invaders/invaders.js",
    "game:run:rust": "./gallery/invaders/invaders_rust.exe",
    "game:run:go": "./gallery/invaders/invaders_go.exe",
    "game:run:swift": "./gallery/invaders/invaders_swift.exe",
    "game:run:cpp": "./gallery/invaders/invaders_cpp.exe",
    "game:run:kotlin": "java -jar ./gallery/invaders/invaders.jar",
    "game": "npm run game:compile && npm run game:run",
    "engine:compile": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ranger_games/pong.rgr -d=./gallery/game_engine/ranger_games -o=pong.js -nodecli",
    "engine:compile:cpp": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=cpp ./gallery/game_engine/ranger_games/pong.rgr -d=./gallery/game_engine/ranger_games -o=pong.cpp -nodecli",
    "engine:compile:rust": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=rust ./gallery/game_engine/ranger_games/pong.rgr -d=./gallery/game_engine/ranger_games -o=pong.rs -nodecli",
    "engine:build:native": "bash gallery/game_engine/scripts/build-native.sh",
    "build:raspberry": "bash gallery/game_engine/scripts/build-raspberry.sh",
    "deploy:pi": "bash gallery/game_engine/scripts/deploy-pi.sh",
    "engine:run": "node ./gallery/game_engine/ranger_games/pong.js",
    "engine:ui:demo": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/ui_editor_demo.rgr -d=./gallery/game_engine/ui -o=ui_editor_demo.js -nodecli && node ./gallery/game_engine/ui/ui_editor_demo.js",
    "engine:ui:test": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/tests/UITest.rgr -d=./gallery/game_engine/ui/tests -o=UITest.js -nodecli && node ./gallery/game_engine/ui/tests/UITest.js",
    "engine:ui:wasm-select": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/wasm_ui_select_demo.rgr -d=./gallery/game_engine/ui -o=wasm_ui_select_demo.js -nodecli && node ./gallery/game_engine/ui/wasm_ui_select_demo.js",
    "engine:ui:wasm-guest": "bash gallery/game_engine/games/ui_menu/src/build.sh && node gallery/game_engine/games/ui_menu/src/tools/parity.cjs",
    "engine:ui:effects": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/ui_effects_demo.rgr -d=./gallery/game_engine/scripting -o=ui_effects_demo.js -nodecli && node ./gallery/game_engine/scripting/ui_effects_demo.js",
    "engine:ui:effects-guest": "bash gallery/game_engine/games/ui_effects/src/build.sh && node gallery/game_engine/games/ui_effects/src/tools/parity.cjs",
    "engine:ui:game": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/ui_menu_runner_demo.rgr -d=./gallery/game_engine/scripting -o=ui_menu_runner_demo.js -nodecli && node ./gallery/game_engine/scripting/ui_menu_runner_demo.js",
    "engine:ui:as": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/as_ui_menu_src_demo.rgr -d=./gallery/game_engine/scripting -o=as_ui_menu_src_demo.js -nodecli && node ./gallery/game_engine/scripting/as_ui_menu_src_demo.js",
    "engine:as:sprites": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/as_sprite_demo.rgr -d=./gallery/game_engine/scripting -o=as_sprite_demo.js -nodecli && node ./gallery/game_engine/scripting/as_sprite_demo.js",
    "engine:as:sprites2p": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/pyorretris2p_demo.rgr -d=./gallery/game_engine/scripting -o=pyorretris2p_demo.js -nodecli && node ./gallery/game_engine/scripting/pyorretris2p_demo.js",
    "engine:ui:anim": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/ui_anim_demo.rgr -d=./gallery/game_engine/ui -o=ui_anim_demo.js -nodecli && node ./gallery/game_engine/ui/ui_anim_demo.js",
    "engine:ui:anim-visual": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/ui_anim_visual_demo.rgr -d=./gallery/game_engine/ui -o=ui_anim_visual_demo.js -nodecli && node ./gallery/game_engine/ui/ui_anim_visual_demo.js",
    "engine:ui:bgimage": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/ui_bgimage_demo.rgr -d=./gallery/game_engine/ui -o=ui_bgimage_demo.js -nodecli && node ./gallery/game_engine/ui/ui_bgimage_demo.js",
    "engine:as:classes": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/tests/interp/as_class_demo.rgr -d=./gallery/game_engine/tests/interp -o=as_class_demo.js -nodecli && node ./gallery/game_engine/tests/interp/as_class_demo.js",
    "engine:catalog:categories": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/game_catalog_category_demo.rgr -d=./gallery/game_engine/scripting -o=game_catalog_category_demo.js -nodecli && node ./gallery/game_engine/scripting/game_catalog_category_demo.js",
    "engine:menu:launcher": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/menu_launcher_demo.rgr -d=./gallery/game_engine/scripting -o=menu_launcher_demo.js -nodecli && node ./gallery/game_engine/scripting/menu_launcher_demo.js",
    "engine:game:icons": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/scripting/game_icon_shots_demo.rgr -d=./gallery/game_engine/scripting -o=game_icon_shots_demo.js -nodecli && node ./gallery/game_engine/scripting/game_icon_shots_demo.js",
    "engine:ui:launcher": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/ui/evg_launcher_demo.rgr -d=./gallery/game_engine/ui -o=evg_launcher_demo.js -nodecli && node ./gallery/game_engine/ui/evg_launcher_demo.js",
    "engine:compile:sdl": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -l=cpp ./gallery/game_engine/ranger_games/pong_sdl.rgr -d=./gallery/game_engine/ranger_games -o=pong_sdl.cpp -nodecli",
    "engine:sdl": "bash gallery/game_engine/scripts/build-sdl.sh",
    "engine:sdl:run": "bash gallery/game_engine/scripts/build-sdl.sh --run",
    "engine:v2:test": "bash gallery/game_engine/v2/tests/run.sh",
    "engine:v2:mesh:test": "bash gallery/game_engine/v2/mesh_editor/tests/run.sh",
    "engine:v2:mesh:e2e": "node gallery/game_engine/v2/mesh_editor/tests/e2e/mesh_editor_e2e.mjs",
    "engine:v2:mesh:dev": "npm --prefix gallery/game_engine/v2/mesh_editor/app run dev",
    "engine:v2:shot:ylos2": "bash gallery/game_engine/v2/tests/tools/ylos2_screenshot.sh",
    "engine:v2:pinball3d:build": "node gallery/game_engine/v2/web/build-pinball3d.mjs --out gallery/game_engine/v2/web/dist/pinball3d",
    "engine:v2:pinball3d:shot": "npm run engine:v2:pinball3d:build && node gallery/game_engine/v2/web/tests/browser_smoke.mjs gallery/game_engine/v2/web/dist/pinball3d --canvas '#screen' --ms 2000 --shot gallery/game_engine/v2/web/dist/pinball3d/pinball_gpu.png",
    "engine:game-sdl": "bash gallery/game_engine/scripts/build-game-sdl.sh",
    "engine:game-sdl:run": "bash gallery/game_engine/scripts/build-game-sdl.sh --run",
    "engine:game-sdl:launcher": "bash gallery/game_engine/scripts/build-game-sdl.sh --run",
    "engine:game-sdl:launcher:v2": "bash gallery/game_engine/scripts/build-sdl-v2.sh --run",
    "engine:game-sdl:run:pong": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/pong/index.tsx",
    "engine:game-sdl:run:invaders": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/invaders/index.tsx",
    "engine:game-sdl:run:breakout": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/breakout/index.tsx",
    "engine:game-sdl:run:littleciv": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/littleciv/index.tsx",
    "engine:game-sdl:smoke:littleciv": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/littleciv/index.tsx 300",
    "engine:littleciv:runner": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/tests/littleciv_runner_demo.rgr -d=./tests/.output -o=littleciv_runner_demo.js -nodecli && node ./tests/.output/littleciv_runner_demo.js 240",
    "engine:game-sdl:run:chess": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/chess/index.tsx",
    "engine:game-sdl:smoke:chess": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/chess/index.tsx 300",
    "engine:chess:runner": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/tests/chess_runner_demo.rgr -d=./tests/.output -o=chess_runner_demo.js -nodecli && node ./tests/.output/chess_runner_demo.js 120",
    "engine:chess:assets": "bash gallery/game_engine/games/chess/build-assets.sh",
    "engine:game-sdl:run:f1_arcade": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/f1_arcade/index.tsx",
    "engine:game-sdl:smoke:f1_arcade": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/f1_arcade/index.tsx 300",
    "engine:f1_arcade:runner": "cross-env RANGER_LIB=./compiler/Lang.rgr:./lib/stdops.rgr node bin/output.js -es6 ./gallery/game_engine/tests/f1_arcade_runner_demo.rgr -d=./tests/.output -o=f1_arcade_runner_demo.js -nodecli && node ./tests/.output/f1_arcade_runner_demo.js 360",
    "engine:game-sdl:run:ylos": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/ylos/index.tsx",
    "engine:game-sdl:run:ylos2": "bash gallery/game_engine/scripts/build-lpc.sh --run && bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/ylos2/index.tsx",
    "engine:game-sdl:run:ylos3": "bash gallery/game_engine/scripts/build-lpc.sh --run && bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/ylos3/index.tsx",
    "engine:game-sdl:run:ylos4": "bash gallery/game_engine/scripts/build-lpc.sh --run && bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/ylos4/index.tsx",
    "engine:game-sdl:run:physics_sandbox": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/physics_sandbox/index.tsx",
    "engine:game-sdl:run:sprite": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/sprite_char/sprite_char.wasm",
    "engine:game-sdl:smoke": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/scripting/pong.game.tsx 300",
    "engine:game-sdl:smoke:invaders": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/scripting/invaders.game.tsx 300",
    "engine:game-sdl:smoke:breakout": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/scripting/breakout.game.tsx 300",
    "engine:game-sdl:smoke:pacman": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/pacman/index.tsx 300",
    "engine:game-sdl:run:pacman": "bash gallery/game_engine/scripts/build-game-sdl.sh --run gallery/game_engine/games/pacman/index.tsx",
    "engine:game:watch:invaders": "node gallery/game_engine/scripts/watch-game-sdl.mjs invaders",
    "engine:game:watch:pacman": "node gallery/game_engine/scripts/watch-game-sdl.mjs pacman",
    "engine:game:watch:pong": "node gallery/game_engine/scripts/watch-game-sdl.mjs pong",
    "engine:game:watch:breakout": "node gallery/game_engine/scripts/watch-game-sdl.mjs breakout",
    "engine:lpc:build": "bash gallery/game_engine/scripts/build-lpc.sh",
    "engine:lpc:run": "bash gallery/game_engine/scripts/build-lpc.sh --run",
    "engine:lpc:batch": "bash gallery/game_engine/scripts/build-lpc-batch.sh",

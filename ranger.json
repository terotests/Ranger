      "rev": "32435100570ed4b8d08d94f8392c4c9f63bc5e45",
      "subdir": "engine"
    },
    "cer": {
      "git": "https://github.com/terotests/componentengine.git",
      "rev": "32435100570ed4b8d08d94f8392c4c9f63bc5e45",
      "subdir": "cer"
    },
    "vela": {
      "git": "https://github.com/terotests/VelaCharts.git",
      "rev": "8747b4f51d2d29a93aea754d116a4186df5df247",
      "subdir": "vela"
    },
    "zip": {
      "path": "lib/zip"

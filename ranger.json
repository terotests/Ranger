{
  "name": "ranger",
  "version": "4.0.2",
  "license": "MIT",
  "description": "The packages this tree takes from other repositories. npm run deps fetches them (rgrc install) and puts each where scripts/deps.mjs says: lib/evg, lib/image, gallery/componentengine, gallery/cer, gallery/vela. \"sources\" are source trees it fetches with git rather than rgrc install: gallery/datagrid, gallery/docx_viewer, and the UI controllers and their theme (gallery/ui/src, gallery/ui/theme) from EVGUI.",
  "dependencies": {
    "evg": {
      "git": "https://github.com/terotests/evg.git",
      "rev": "68408e0c0e93a72d4a0aa048a505a818b8de2120",
      "subdir": "storm"
    },
    "componentengine": {
      "git": "https://github.com/terotests/componentengine.git",
      "rev": "32435100570ed4b8d08d94f8392c4c9f63bc5e45",
      "subdir": "engine"
    },
    "cer": {
      "git": "https://github.com/terotests/componentengine.git",
      "rev": "32435100570ed4b8d08d94f8392c4c9f63bc5e45",
      "subdir": "cer"
    },
    "vela": {
      "git": "https://github.com/terotests/VelaCharts.git",
      "rev": "8747b4f51d2d29a93aea754d116a4186df5df247",
      "subdir": "vela"
    },
    "zip": {
      "path": "lib/zip"
    },
    "ts_parser": {
      "path": "gallery/ts_parser"
    }
  },
  "sources": {
    "datagrid": {
      "git": "https://github.com/terotests/EVGSheets.git",
      "rev": "68e4fd803e753a5f110cd70afe464f664580b101",
      "subdir": "datagrid"
    },
    "docx_viewer": {
      "git": "https://github.com/terotests/RangerDocx.git",
      "rev": "1a6e40967dfee056dc8a8ca7bd8239b0371dd9f3",
      "subdir": "."
    },
    "ui_src": {
      "git": "https://github.com/terotests/EVGUI.git",
      "rev": "4fa46f9b97a7ca15dec38ae2503afb919ef4ba7a",
      "subdir": "src"
    },
    "ui_theme": {
      "git": "https://github.com/terotests/EVGUI.git",
      "rev": "4fa46f9b97a7ca15dec38ae2503afb919ef4ba7a",
      "subdir": "theme"
    }
  }
}

Import "sx_base.rgr"

; Custom operators: the feature that lets a program add to the language.
;   - a macro operator that expands to Ranger source and is then compiled the
;     normal way for every target
;   - a direct template operator that writes target source, with per target
;     entries and a `*` fallback
;   - an operator overload on a class type (`*` for Vec2)
;   - an operator that matches an Enum
;   - an operator that takes a block, so it reads like a control structure
;   - an `operator type:` block, which turns ordinary Ranger functions into
;     methods of a receiver type

Enum Channel (
    Red
    Green
    Blue
)

class Vec2 {
    def x:double 0.0
    def y:double 0.0

    fn set:Vec2 (nx:double ny:double) {
        x = nx
        y = ny
        return this
    }

    fn scale:Vec2 (factor:double) {
        def res (new Vec2)
        res.x = (x * factor)
        res.y = (y * factor)
        return res
    }

    fn plus:Vec2 (other:Vec2) {
        def res (new Vec2)
        res.x = (x + other.x)
        res.y = (y + other.y)
        return res
    }

    fn dot:double (other:Vec2) {
        return ((x * other.x) + (y * other.y))
    }

    fn label:string () {
        def text ((("(" + (to_string (to_int x))) + ",") + ((to_string (to_int y)) + ")"))
        return text
    }
}

operators {

    ; A macro. The template writes Ranger source, the compiler parses it and
    ; then compiles the result, so one definition serves every target.
    sx_triple _:int ( value:int ) {
        templates {
            * @macro(true) ( "(" (e 1) " * 3)" )
        }
    }

    ; A direct template operator. Each entry writes target source. The `*`
    ; fallback covers the targets with no entry of their own.
    sx_bump _:int ( value:int ) {
        templates {
            es6 ( "(" (e 1) " + 1)" )
            go ( "(" (e 1) " + 1)" )
            python ( "(" (e 1) " + 1)" )
            * ( "(" (e 1) " + 1)" )
        }
    }

    ; Operator overloading on a class type: `*` between two Vec2 values is the
    ; dot product, and `+` is componentwise addition.
    * _:double ( left:Vec2 right:Vec2 ) {
        templates {
            * @macro(true) ( (e 1) ".dot(" (e 2) ")" )
        }
    }

    + _:Vec2 ( left:Vec2 right:Vec2 ) {
        templates {
            * @macro(true) ( (e 1) ".plus(" (e 2) ")" )
        }
    }

    ; An operator that matches an Enum argument, so the dispatch is on the
    ; declared type and not on a string.
    sx_channel_code _:int ( ch:Channel ) {
        templates {
            * @macro(true) ( "(? (" (e 1) " == Channel.Red) 1 (? (" (e 1) " == Channel.Green) 2 3))" )
        }
    }

    ; An operator that takes a block. The block is emitted inside the loop the
    ; template writes, so the call site reads like a control structure.
    sx_repeat _:void ( times:int body:block ) {
        templates {
            ranger ( "(sx_repeat " (e 1) " " (block 2) ")" )
            es6 ( "for(let _sx=0;_sx<" (e 1) ";_sx++) {" nl I (block 2) nl i "}" nl )
            go ( "for _sx := 0; _sx < int(" (e 1) "); _sx++ {" nl I (block 2) nl i "}" nl )
            python ( "for _sx in range(" (e 1) "):" nl I (block 2) nl i )
            * ( "for(int _sx=0;_sx<" (e 1) ";_sx++) {" nl I (block 2) nl i "}" nl )
        }
    }
}

; An `operator type:` block. The functions are ordinary Ranger code, so they
; compile for every target that compiles this file, and they are called with
; receiver syntax.
operator type:[int] all {

    fn sx_sum:int () {
        def total@(mutable):int 0
        for self v:int i {
            total = (total + v)
        }
        return total
    }

    fn sx_scaled:[int] (factor:int) {
        def res:[int]
        for self v:int i {
            push res (v * factor)
        }
        return res
    }
}

class OperatorsSection {
    Extends(SyntaxSection)

    fn title:string () {
        return "operators"
    }

    fn run:void () {
        ; The macro and the direct template operator.
        this.sayInt("macro_operator" (sx_triple 14))
        this.sayInt("template_operator" (sx_bump 41))
        this.sayInt("operator_nested" (sx_triple (sx_bump 1)))

        ; The overloaded operators on Vec2.
        def a (new Vec2)
        a.set(3.0 4.0)
        def b (new Vec2)
        b.set(1.0 2.0)
        this.sayD("operator_star" (a * b))
        def sum:Vec2 (a + b)
        this.say("operator_plus" (sum.label()))

        ; The Enum matching operator.
        this.sayInt("enum_operator_red" (sx_channel_code Channel.Red))
        this.sayInt("enum_operator_blue" (sx_channel_code Channel.Blue))

        ; The block operator, used as a loop.
        def counted@(mutable):int 0
        sx_repeat 4 {
            counted = (counted + 10)
        }
        this.sayInt("block_operator" counted)

        ; The receiver methods added by the `operator type:` block.
        def values:[int] ([] _:int (1 2 3 4))
        this.sayInt("type_method_sum" (values.sx_sum()))
        def scaled:[int] (values.sx_scaled(3))
        this.sayInt("type_method_map" (scaled.sx_sum()))
    }
}

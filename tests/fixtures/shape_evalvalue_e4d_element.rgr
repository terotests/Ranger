; E4d1: Element.element on body is SoT (no EvalPayload.ElemBox).
; The element type is EvElement, the engine's own -- JSX stopped evaluating
; into a renderer's layout object, so this fixture no longer reaches for one.
Import "../../gallery/game_engine/v2/interp/migrate/src/EvValueBridge.rgr"

class Main {
    sfn main:void () {
        def el:EvElement (new EvElement())
        el.tagName = "div"
        def v:EvHandle (EvValueBridge.taggedElement(el))
        if (v.hasElement()) {
            def got:EvElement (v.elementOf())
            if (got.tagName == "div") {
                print "el"
            } {
                print "WRONG: tag"
            }
        } {
            print "WRONG: hasElement"
        }

        def shaped:EvalValue (EvValueBridge.fromTagged(v))
        if (EvalValue.isElement(shaped)) {
            case shaped ee:EvalValue.Element {
                def se:EvElement (unwrap ee.element)
                if (se.tagName == "div") {
                    print "sot"
                } {
                    print "WRONG: body element"
                }
            }
        } {
            print "WRONG: fromTagged"
        }

        ; Round-trip keeps the same handle (===). Compare identityIds via
        ; locals — equals(same Rc) RefCell-panics on Rust.
        def again:EvHandle (EvHandle.fromBody(shaped))
        def aid:int again.identityId
        def vid:int v.identityId
        if ((aid > 0) && (aid == vid)) {
            print "id"
        } {
            print "WRONG: identity"
        }
    }
}

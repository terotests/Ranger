; Shapes the compiler's own sources use, which the LLVM backend got wrong
; until the compiler compiled for LLVM again (CHANGELOG 4.1.0).
class Chain {
  def name:string ""
}
class Node {
  def chain@(optional):[Chain]
  def params:[string:string]
  fn getParam@(optional):string (name:string) {
    return (get params name)
  }
  fn walk:int (entry:string) {
    if (null? chain) {
      return 0
    }
    def cs:[Chain] (unwrap chain)
    def n 0
    for cs c:Chain i {
      n = n + (strlen c.name) + (strlen entry)
    }
    return n
  }
}
class Main {
  sfn m@(main):void () {
    def nd (new Node)
    set nd.params "a" "x"
    def o@(optional) (nd.getParam("format"))
    if (!null? o) {
      print "format present"
    } {
      print "format absent"
    }
    def c1 (new Chain)
    c1.name = "ab"
    def arr:[Chain]
    push arr c1
    nd.chain = arr
    print ("walk " + (nd.walk("e")))
    print ("walk again " + (nd.walk("e")))
    def s "aäb"
    print ("chars " + (char_length s))
    def cs:[int] (to_chars s)
    print ("codes " + (array_length cs) + " " + (itemAt cs 1))
    def b1 (buffer_from_string "hello")
    def b2 (buffer_alloc 5)
    buffer_copy b2 0 b1 1 3
    print ("copy " + (buffer_get b2 0) + " " + (buffer_get b2 2))
    def t "  key  "
    if (((strlen t) > 0) && ((trim t) == "key")) {
      print "trimmed"
    }
    def missing@(optional) (read_file_sync "." "no-such-file.txt")
    if (null? missing) {
      print "no file"
    }
  }
}

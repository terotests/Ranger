; A shape body holds cases, groups and methods. Anything else is an error
; rather than something the lowering silently drops — `def` at the top level of
; a shape looks like a field of the family, which no case would carry.
shape Broken {
    case A
    def stray:int 0
}

class BrokenProbe {
    sfn main:void () {
        print "unreachable"
    }
}

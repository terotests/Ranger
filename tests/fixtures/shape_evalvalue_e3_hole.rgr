; E3 smoke test: Hole kind is shape-owned (PLAN_SHAPES.md §7.5).
; Creation goes EvalValue.Hole → toTagged; engine API is EvValueBridge.taggedHole.
Import "../../gallery/game_engine/v2/interp/migrate/src/EvValueBridge.rgr"

class Main {
    sfn main:void () {
        ; shape → tagged → shape round-trip
        def shaped:EvalValue (EvalValue.hole())
        def tagged:EvHandle (EvValueBridge.toTagged(shaped))
        def back:EvalValue (EvValueBridge.fromTagged(tagged))
        if (EvalValue.isHole(back)) {
            print "roundtrip"
        } {
            print "WRONG: Hole round-trip failed"
        }

        ; engine creation surface
        def eng:EvHandle (EvValueBridge.taggedHole())
        if (EvValueBridge.isHole(eng)) {
            print "engine"
        } {
            print "WRONG: taggedHole not a hole"
        }

        ; Hole is not Undefined
        def u:EvHandle (EvHandle.undefined())
        if (EvValueBridge.isHole(u)) {
            print "WRONG: undefined is a hole"
        } {
            print "distinct"
        }
        def us:EvalValue (EvValueBridge.fromTagged(u))
        if (EvalValue.isUndefined(us)) {
            if (EvalValue.isHole(us)) {
                print "WRONG: undefined shaped as hole"
            } {
                print "undef"
            }
        } {
            print "WRONG: lost Undefined"
        }

        ; Hole is falsy
        if (EvalValue.toBool(shaped)) {
            print "WRONG: Hole is truthy"
        } {
            print "falsy"
        }
    }
}

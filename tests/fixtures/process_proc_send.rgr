
Import "RangerProcess.rgr"

class AlphaPage @process(true) @name("app.alpha") extends RangerProcessBase {
  def pingCount:int 0
  def lastName:string ""
  def lastValue:string ""

  fn receiveMessage:void (name:string value:string) {
    pingCount = pingCount + 1
    lastName = name
    lastValue = value
    print ("  [app.alpha] receiveMessage #" + (to_string pingCount) + " name=" + name + " value=" + value)
    this.markStateDirty()
  }

  fn printInbox:void () {
    print ("  [app.alpha] inbox pingCount=" + (to_string pingCount) + " last=" + lastName + ":" + lastValue)
  }
}

class BetaPage @process(true) @name("app.beta") extends RangerProcessBase {
  def note:string ""
  def messageCount:int 0

  fn receiveMessage:void (name:string value:string) {
    messageCount = messageCount + 1
    note = (name + "=" + value)
    print ("  [app.beta] receiveMessage #" + (to_string messageCount) + " " + note)
    this.markStateDirty()
  }

  fn printInbox:void () {
    print ("  [app.beta] inbox count=" + (to_string messageCount) + " note=" + note)
  }
}

class ProcSendDemo {
  fn run:void () {
    print "== proc_send demo =="

    def alphaPage:AlphaPage (new AlphaPage)
    proc_start alphaPage
    print "1) send by named path (app.alpha)"
    proc_send "app.alpha" "hello" "world"
    alphaPage.printInbox()

    if (alphaPage.pingCount != 1) {
      print "FAIL proc_send: alpha pingCount"
      return
    }
    if (alphaPage.lastName != "hello") {
      print "FAIL proc_send: alpha lastName"
      return
    }
    if (alphaPage.lastValue != "world") {
      print "FAIL proc_send: alpha lastValue"
      return
    }

    def betaPage:BetaPage (new BetaPage)
    proc_start betaPage
    print "2) send to beta by path, then ping alpha by process reference"
    proc_send "app.beta" "greet" "from-demo"
    betaPage.printInbox()
    proc_send alphaPage "ping" "via-ref"
    alphaPage.printInbox()

    if (alphaPage.pingCount != 2) {
      print "FAIL proc_send: via proc reference"
      return
    }
    if (alphaPage.lastName != "ping") {
      print "FAIL proc_send: alpha lastName via ref"
      return
    }
    if (betaPage.messageCount != 1) {
      print "FAIL proc_send: beta messageCount"
      return
    }

    print "3) find_process still resolves alpha"
    def alphaFound@(optional):RangerProcessBase (find_process "app.alpha")
    if (null? alphaFound) {
      print "FAIL proc_send: find_process after send"
      return
    }
    def alphaViaPath:AlphaPage (cast (unwrap alphaFound) to:AlphaPage)
    alphaViaPath.printInbox()

    print "4) stop processes; late send must not deliver"
    proc_stop alphaPage
    proc_stop betaPage
    proc_send "app.alpha" "after-stop" "ignored"
    proc_send "app.beta" "late" "ignored"
    alphaPage.printInbox()
    betaPage.printInbox()

    if (alphaPage.pingCount != 2) {
      print "FAIL proc_send: should not deliver to stopped process"
      return
    }
    if (betaPage.messageCount != 1) {
      print "FAIL proc_send: beta should not receive after stop"
      return
    }

    print "OK process proc_send"
  }
}

class Test_ProcSend {
  sfn m@(main):void () {
    def demo (new ProcSendDemo)
    demo.run()
  }
}

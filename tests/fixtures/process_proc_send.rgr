
Import "RangerProcess.rgr"

class AppRoot @process(true) @name("app.root") @singleton(true) extends RangerProcessBase {
  fn start:void () {
  }

  fn startAlpha:AlphaPage () {
    def page:AlphaPage (new AlphaPage)
    proc_start page
    return page
  }

  fn startBeta:BetaPage () {
    def page:BetaPage (new BetaPage)
    proc_start page
    return page
  }
}

class AlphaPage @process(true) @name("app.alpha") extends RangerProcessBase {
  fn start:void () {
  }

  def pingCount:int 0
  def lastName:string ""
  def lastValue:string ""

  fn onHello:void (name:string value:string) {
    pingCount = pingCount + 1
    lastName = name
    lastValue = value
    print ("  [app.alpha] onHello #" + (to_string pingCount) + " name=" + name + " value=" + value)
    this.markStateDirty()
  }

  fn onPing:void (value:string) {
    pingCount = pingCount + 1
    lastName = "ping"
    lastValue = value
    print ("  [app.alpha] onPing #" + (to_string pingCount) + " value=" + value)
    this.markStateDirty()
  }

  fn printInbox:void () {
    print ("  [app.alpha] inbox pingCount=" + (to_string pingCount) + " last=" + lastName + ":" + lastValue)
  }
}

class BetaPage @process(true) @name("app.beta") extends RangerProcessBase {
  fn start:void () {
  }

  def note:string ""
  def messageCount:int 0

  fn onGreet:void (name:string value:string) {
    messageCount = messageCount + 1
    note = (name + "=" + value)
    print ("  [app.beta] onGreet #" + (to_string messageCount) + " " + note)
    this.markStateDirty()
  }

  fn printInbox:void () {
    print ("  [app.beta] inbox count=" + (to_string messageCount) + " note=" + note)
  }
}

class ProcSendDemo {
  fn run:void (root:AppRoot) {
    print "== proc_send demo =="

    def alphaPage:AlphaPage (root.startAlpha())
    print "1) send to started alpha page"
    proc_send alphaPage onHello "hello" "world"
    alphaPage.printInbox()

    if (alphaPage.pingCount != 1) {
      print "FAIL proc_send: alpha pingCount"
      return
    }
    if (alphaPage.lastName != "hello") {
      print "FAIL proc_send: alpha lastName"
      return
    }
    if (alphaPage.lastValue != "world") {
      print "FAIL proc_send: alpha lastValue"
      return
    }

    def betaPage:BetaPage (root.startBeta())
    print "2) send to beta by path, then ping alpha by process reference"
    proc_send betaPage onGreet "greet" "from-demo"
    betaPage.printInbox()
    proc_send alphaPage onPing "via-ref"
    alphaPage.printInbox()

    if (alphaPage.pingCount != 2) {
      print "FAIL proc_send: via proc reference"
      return
    }
    if (alphaPage.lastName != "ping") {
      print "FAIL proc_send: alpha lastName via ref"
      return
    }
    if (betaPage.messageCount != 1) {
      print "FAIL proc_send: beta messageCount"
      return
    }

    print "3) find_process still resolves alpha"
    def alphaFound@(optional):RangerProcessBase (find_process "app.alpha")
    if (null? alphaFound) {
      print "FAIL proc_send: find_process after send"
      return
    }
    def alphaViaPath:AlphaPage (cast (unwrap alphaFound) to:AlphaPage)
    alphaViaPath.printInbox()

    print "4) stop processes; late send must not deliver"
    proc_stop alphaPage
    proc_stop betaPage
    proc_send alphaPage onHello "after-stop" "ignored"
    proc_send betaPage onGreet "late" "ignored"
    alphaPage.printInbox()
    betaPage.printInbox()

    if (alphaPage.pingCount != 2) {
      print "FAIL proc_send: should not deliver to stopped process"
      return
    }
    if (betaPage.messageCount != 1) {
      print "FAIL proc_send: beta should not receive after stop"
      return
    }

    print "OK process proc_send"
  }
}

class Test_ProcSend {
  sfn m@(main):void () {
    def root:AppRoot (new AppRoot)
    proc_start root
    def demo (new ProcSendDemo)
    demo.run(root)
  }
}

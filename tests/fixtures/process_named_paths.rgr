
Import "RangerProcess.rgr"

class AppRoot @process(true) @name("app.root") @singleton(true) extends RangerProcessBase {
  fn start:void () {
  }

  fn startAlpha:AlphaPage () {
    def page:AlphaPage (new AlphaPage)
    proc_start page
    return page
  }

  fn startBeta:BetaPage () {
    def page:BetaPage (new BetaPage)
    proc_start page
    return page
  }
}

class AlphaPage @process(true) @name("app.alpha") extends RangerProcessBase {
  fn start:void () {
  }

  def score:int 0

  fn bump:void () {
    score = score + 1
    print ("  AlphaPage.bump -> score=" + (to_string score))
    this.markStateDirty()
  }

  fn printStatus:void () {
    print ("  AlphaPage status path=app.alpha score=" + (to_string score))
  }

  fn resetScore:void () {
    score = 0
    print "  AlphaPage.resetScore"
    this.markStateDirty()
  }

  fn onPing:void (from:string) {
    print ("  AlphaPage.onPing from=" + from)
    score = score + 1
    this.markStateDirty()
  }
}

class BetaPage @process(true) @name("app.beta") extends RangerProcessBase {
  fn start:void () {
  }

  def label:string "beta"

  fn setLabel:void (next:string) {
    label = next
    print ("  BetaPage.setLabel -> " + label)
    this.markStateDirty()
  }

  fn printLabel:void () {
    print ("  BetaPage label=" + label)
  }

  fn onRename:void (next:string) {
    print ("  BetaPage.onRename -> " + next)
    label = next
    this.markStateDirty()
  }
}

class NamedPathsDemo {
  fn run:void (root:AppRoot) {
    print "== named @process paths =="

    def alphaPage:AlphaPage (root.startAlpha())
    def betaPage:BetaPage (root.startBeta())

    print "1) direct calls on started instances"
    alphaPage.bump()
    betaPage.setLabel("ready")
    betaPage.printLabel()

    print "2) find_process + cast -> call typed methods"
    def alphaFound@(optional):RangerProcessBase (find_process "app.alpha")
    if (null? alphaFound) {
      print "FAIL named: alpha not found"
      return
    }
    def alphaViaPath:AlphaPage (cast (unwrap alphaFound) to:AlphaPage)
    alphaViaPath.printStatus()
    alphaViaPath.bump()

    def betaFound@(optional):RangerProcessBase (find_process "app.beta")
    if (null? betaFound) {
      print "FAIL named: beta not found"
      return
    }
    def betaViaPath:BetaPage (cast (unwrap betaFound) to:BetaPage)
    betaViaPath.printLabel()
    betaViaPath.setLabel("via-find-process")

    print "3) proc_send by path and by reference"
    proc_send alphaPage onPing "from-demo"
    proc_send betaPage onRename "renamed-by-path"

    if (alphaPage.score != 3) {
      print "FAIL named: alpha score (expected 3)"
      return
    }
    if (betaPage.label != "renamed-by-path") {
      print "FAIL named: beta label"
      return
    }

    def registry (ProcessNameRegistry.__singleton())
    if (registry.hasLive("app.beta") == false) {
      print "FAIL named: beta not live"
      return
    }

    print "4) stop and verify registry"
    proc_stop alphaPage
    proc_stop betaPage
    if (registry.hasLive("app.alpha")) {
      print "FAIL named: alpha still live after stop"
      return
    }
    proc_send alphaPage onPing "ignored"
    if (alphaPage.score != 3) {
      print "FAIL named: message after stop should not change score"
      return
    }

    print "OK process named paths"
  }
}

class Test_NamedPaths {
  sfn m@(main):void () {
    def root:AppRoot (new AppRoot)
    proc_start root
    def demo (new NamedPathsDemo)
    demo.run(root)
  }
}

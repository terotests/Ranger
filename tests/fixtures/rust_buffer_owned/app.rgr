; a borrowed buffer parameter returned or bound to a local is copied into
; the owned Vec, and buffer_to_base64 needs no crate on Rust
class B {
    sfn same:buffer (bytes:buffer) {
        if ((buffer_length bytes) > 100) {
            return (buffer_alloc 0)
        }
        return bytes
    }
    sfn keep:buffer (b:buffer) {
        def raw:buffer b
        return raw
    }
    sfn main@(main):void () {
        def b:buffer (buffer_alloc 3)
        buffer_set b 0 77
        buffer_set b 1 97
        buffer_set b 2 110
        print (buffer_to_base64 (B.same((B.keep(b)))))
    }
}

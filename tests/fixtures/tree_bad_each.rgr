; SPDX-License-Identifier: MIT
; Negative control: the item of an each form needs its type.

class Box {
    def name:string ""
    def kids:[Box]
    Constructor () { }
    fn addKid:void (k:Box) {
        push kids k
    }
}

treefactory UiTree {
    child addKid
    tag   Row Box
}

class T {
    sfn main:void () {
        def names:[string]
        def b (tree UiTree (Row (each names n (Row (props (name n))))))
        print b.name
    }
}

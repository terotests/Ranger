; Hostile input for the line formatter, which is a TEXT rule and so has to be
; probed the way a text rule fails: arguments that contain the very characters
; the scanner looks for, a chain nested inside a condition where breaking would
; be wrong, and a call whose own arguments are calls.
;
; Every target must still print the same answer.
class SRow {
  def cells:[string]
  fn put:SRow (k:string v:string) {
    push cells (k + "=" + v)
    return this
  }
  fn size:int () {
    return (array_length cells)
  }
}
class SMain {
  sfn join3:string (a:string b:string c:string d:string) {
    return (((a + "/") + b) + "/") + c + "/" + d
  }
  sfn main:void () {
    def r:SRow (new SRow())
    ; a chain whose arguments contain the very characters the scanner looks for
    r.put("dot" "a.b().c()").put("paren" "))((").put("comma" "x,y,z").put("quote" "he said \"hi\"").put("slash" "http://x//y")
    def n:int (r.size())
    ; a chain inside an if condition, which must NOT be broken at depth > 0
    if ((r.put("k" "v").size()) > 0) {
      n = n + 100
    }
    ; a wide call whose arguments are themselves calls
    def s:string (SMain.join3((SMain.join3("aa" "bb" "cc" "dd")) "eeeeeeeeeeee" "ffffffffffff" "gggggggggggg"))
    print ("" + n + " " + s)
  }
}

; E2 smoke test: compatibility factories + tagged → shape bridge for primitives.
Import "../../gallery/game_engine/v2/interp/migrate/src/EvValueBridge.rgr"

class Main {
    sfn main:void () {
        def n:EvalValue (EvalValue.number(3.0))
        if (EvalValue.isNumber(n)) {
            print "num"
        } {
            print "WRONG: not a number"
        }
        if (EvalValue.toBool(n)) {
            print "truthy"
        } {
            print "WRONG: 3 is falsy"
        }
        def tagged:EvHandle (EvHandle.number(0.0))
        def shaped:EvalValue (EvValueBridge.fromTagged(tagged))
        if (EvalValue.isNumber(shaped)) {
            if (EvalValue.toBool(shaped)) {
                print "WRONG: zero from tagged is truthy"
            } {
                print "zero"
            }
        } {
            print "WRONG: bridge lost Number"
        }
        def h:EvHandle (EvHandle.hole())
        def hs:EvalValue (EvValueBridge.fromTagged(h))
        if (EvalValue.isHole(hs)) {
            print "hole"
        } {
            print "WRONG: bridge lost Hole"
        }
    }
}

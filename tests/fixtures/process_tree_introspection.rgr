; Verifies ProcessRuntime.collectAllLiveRoots + ProcessTreeView (debugger-style CLI).
Import "RangerProcess.rgr"

class AppRoot @process(true) @name("app.root") @singleton(true) extends RangerProcessBase {
  fn start:void () {
  }

  fn bootTreeDemo:ScreenProcess () {
    def screen:ScreenProcess (new ScreenProcess)
    proc_start screen
    def page:HostPage (screen.openPage())
    proc_start page
    def counter:CounterProcess (page.spawnCounter())
    proc_start counter
    counter.value = 7
    return screen
  }
}

class ScreenProcess @process(true) extends RangerProcessBase {
  fn start:void () {
  }

  fn openPage:HostPage () {
    def page (new HostPage)
    page.screen = this
    return page
  }
}

class HostPage @process(true) extends RangerProcessBase {
  fn start:void () {
  }

  def screen@(optional):ScreenProcess
  def title:string "Workout"

  fn spawnCounter:CounterProcess () {
    def c (new CounterProcess)
    c.page = this
    c.label = "Set A"
    return c
  }
}

class CounterProcess @process(true) extends RangerProcessBase {
  fn start:void () {
  }

  def page@(optional):HostPage
  def label:string ""
  def value:int 0
}

class TreeIntrospectionDemo {
  def passed:boolean true

  fn run:void (root:AppRoot) {
    print "  process tree introspection"
    def screen:ScreenProcess (root.bootTreeDemo())

    def roots (ProcessRuntime.collectAllLiveRoots())
    def rootCount:int (size roots)
    print ("  roots=" + (to_string rootCount))
    if (rootCount != 1) {
      print "FAIL expected 1 root (AppRoot)"
      passed = false
    }
    def counters (CounterProcess.allInstances())
    if ((size counters) == 0) {
      print "FAIL expected counter instance"
      passed = false
    } {
      def counter:CounterProcess (at counters 0)
      def screenId:int (ScreenProcess.parentIdOf(counter))
      print ("  Screen.parentIdOf(counter)=" + (to_string screenId))
      if (screenId != screen.__rangerId) {
        print "FAIL parentIdOf chain to screen"
        passed = false
      }
    }
    ProcessRuntime.printProcessTreeTitled("  @process tree")
    def counters2 (CounterProcess.allInstances())
    if ((size counters2) > 0) {
      def counter:CounterProcess (at counters2 0)
      proc_stop counter
    }
    def pages (HostPage.allInstances())
    if ((size pages) > 0) {
      def page:HostPage (at pages 0)
      proc_stop page
    }
    proc_stop screen
    proc_stop root
    print ""
    if (passed) {
      print "OK process tree introspection"
    } {
      print "FAILED process tree introspection"
    }
  }
}

class Test_ProcessTreeIntrospection {
  sfn m@(main):void () {
    def root:AppRoot (new AppRoot)
    proc_start root
    def app (new TreeIntrospectionDemo)
    app.run(root)
  }
}

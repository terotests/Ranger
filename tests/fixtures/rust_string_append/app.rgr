; `x = x + y` on a string appends in place on Rust (push_str), see
; tests/rust-string-append.test.ts.
class Buf {
  def out:string ""
  def name:string "n"
  fn label:string () {
    return (name + "!")
  }
  fn add:void (s:string n:int) {
    out = out + s
    out = out + "<" + s + ">" + n
    this.out = this.out + "{x}"
    out = out + (this.label())
    out = out + name
  }
}
class Main {
  sfn m@(main):void () {
    def s:string ""
    def i:int 0
    while (i < 4) {
      s = s + i
      s = s + "," + (2.5 * (int2double i)) + ";"
      i = i + 1
    }
    s = s + s
    s = "pre" + s
    def b:Buf (new Buf)
    b.add("a" 3)
    b.out = b.out + "?"
    print s
    print b.out
  }
}

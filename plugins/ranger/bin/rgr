#!/usr/bin/env bash
#
# rgr — compile a Ranger program and run it, and FAIL when the compile fails.
#
# WHY THIS EXISTS. The Ranger compiler prints `[FAIL]` and `Compilation FAILED`
# and then exits 0. Written the obvious way,
#
#     rgrc Main.rgr -o=Main.js && node bin/Main.js
#
# the `&&` is satisfied by that zero, the PREVIOUS build is still on disk, and
# node runs that one. The program prints what it printed before the change —
# so the edit looks applied, the test looks green, and neither is true. It is
# the most expensive half-hour available in this toolchain, and it is available
# every single time.
#
# So: the output file is deleted first, the compiler's log is read for the
# failure it will not put in its exit status, and a missing output file is
# itself an error.
#
#   rgr run   <src.rgr> [args…]      compile to JavaScript and run it
#   rgr build <src.rgr> [-l=<lang>]  compile only
#   rgr check <src.rgr>              compile, report, keep nothing
#
# Anything after `--` goes to the compiler:  rgr build Main.rgr -- -deadcode
set -u

usage() {
  cat >&2 <<'USAGE'
usage: rgr run   <src.rgr> [args…]        compile to JavaScript and run it
       rgr build <src.rgr> [-l=<lang>]    compile only (default: es6)
       rgr check <src.rgr>                compile and report, run nothing

  -l=<lang>   es6 (default), python, go, cpp, java7, swift6, kotlin, dart,
              php, csharp, rust, scala, llvm
  -d=<dir>    output directory (default: bin)
  --          pass the rest to the compiler
USAGE
}

cmd=${1-}
case "$cmd" in
  run|build|check) shift ;;
  -h|--help|"") usage; exit 1 ;;
  *) echo "rgr: unknown command '$cmd'" >&2; usage; exit 1 ;;
esac

src=${1-}
if [ -z "$src" ]; then usage; exit 1; fi
shift

lang=es6
outdir=bin
passthru=()
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -l=*) lang=${1#-l=} ;;
    -d=*) outdir=${1#-d=} ;;
    --) shift; passthru=("$@"); break ;;
    *) args+=("$1") ;;
  esac
  shift
done

base=$(basename "$src" .rgr)
case "$lang" in
  es6) ext=js ;;
  python) ext=py ;;
  go) ext=go ;;
  cpp) ext=cpp ;;
  rust) ext=rs ;;
  java7) ext=java ;;
  kotlin) ext=kt ;;
  swift6|swift3) ext=swift ;;
  dart) ext=dart ;;
  php) ext=php ;;
  csharp) ext=cs ;;
  scala) ext=scala ;;
  llvm) ext=ll ;;
  *) ext=out ;;
esac
out="$base.$ext"

# The compiler: this repository's own when run inside it, the installed one
# otherwise. A checkout compiles with the sources beside it; a project that
# installed `ranger-compiler` gets `rgrc` from node_modules.
if [ -f ./dist/rgrc.js ] && [ -f ./compiler/Lang.rgr ]; then
  : "${RANGER_LIB:=./compiler/Lang.rgr:./lib/stdops.rgr}"
  export RANGER_LIB
  compiler=(node ./dist/rgrc.js)
else
  compiler=(npx --no-install rgrc)
  if ! npx --no-install rgrc --help >/dev/null 2>&1; then
    compiler=(npx rgrc)
  fi
fi

mkdir -p "$outdir"
rm -f "$outdir/$out"

log=$("${compiler[@]}" "$src" "-l=$lang" "-d=$outdir" "-o=$out" -nodecli "${passthru[@]+"${passthru[@]}"}" 2>&1)
status=$?

if [ $status -ne 0 ] || printf '%s' "$log" | grep -q "Compilation FAILED"; then
  printf '%s\n' "$log" | grep -B2 -A4 "\[FAIL\]" | head -60
  echo "rgr: $src did not compile" >&2
  exit 1
fi
if [ ! -f "$outdir/$out" ]; then
  printf '%s\n' "$log" | tail -20
  echo "rgr: the compiler wrote no $outdir/$out" >&2
  exit 1
fi

if [ "$cmd" = "check" ]; then
  echo "rgr: $src compiles ($lang)"
  exit 0
fi
if [ "$cmd" = "build" ]; then
  echo "rgr: $outdir/$out"
  exit 0
fi

case "$lang" in
  es6) exec node "$outdir/$out" ${args[@]+"${args[@]}"} ;;
  python) exec python3 "$outdir/$out" ${args[@]+"${args[@]}"} ;;
  go) exec go run "$outdir/$out" ${args[@]+"${args[@]}"} ;;
  *)
    echo "rgr: built $outdir/$out — running $lang is up to its own toolchain" >&2
    exit 0
    ;;
esac

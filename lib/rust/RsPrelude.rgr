function rs_f64_prec(x, p) {
  var m = Math.pow(10, p);
  var y = x * m;
  var t = Math.trunc(y);
  if (Math.abs(y - t) === 0.5 && Number.isSafeInteger(t)) {
    var n = (Math.abs(t) % 2 === 0) ? t : t + Math.sign(y);
    return (n / m).toFixed(p);
  }
  return x.toFixed(p);
}

      php ( "rs_f64_prec(" (e 1) ", " (e 2) ")"
(create_polyfill "
// The decimal digits of $m * 2^$e * 10^k, k = max(0, -$e), exact.
function rs_exact($m, $e) {
  $limbs = [];
  while ($m > 0) { $limbs[] = $m % 1000000000; $m = intdiv($m, 1000000000); }
  if (count($limbs) == 0) { $limbs[] = 0; }
  $f = $e < 0 ? 5 : 2;
  for ($n = abs($e); $n > 0; $n--) {
    $carry = 0;
    $len = count($limbs);
    for ($i = 0; $i < $len; $i++) {
      $t = $limbs[$i] * $f + $carry;
      $limbs[$i] = $t % 1000000000;
      $carry = intdiv($t, 1000000000);
    }
    if ($carry > 0) { $limbs[] = $carry; }
  }
  $s = (string)$limbs[count($limbs) - 1];
  for ($i = count($limbs) - 2; $i >= 0; $i--) { $s .= str_pad((string)$limbs[$i], 9, '0', STR_PAD_LEFT); }
  return $s;
}
// Adds one to a digit string.
function rs_digits_inc($s) {
  $i = strlen($s) - 1;
  while ($i >= 0 && $s[$i] == '9') { $s[$i] = '0'; $i--; }
  if ($i < 0) { return '1' . $s; }
  $s[$i] = chr(ord($s[$i]) + 1);
  return $s;
}
")
(create_polyfill "
// `{:.N}`: the exact value rounded to N decimals, a tie to even.
function rs_f64_prec($x, $p) {
  if (is_nan($x)) { return 'NaN'; }
  if (is_infinite($x)) { return $x > 0 ? 'inf' : '-inf'; }
  $w = unpack('N2', pack('E', (float)$x));
  $hi = $w[1];
  $lo = $w[2];
  $neg = ($hi >> 31) == 1;
  $be = ($hi >> 20) & 0x7FF;
  $m = (($hi & 0xFFFFF) << 32) | $lo;
  if ($be == 0) { $be = 1; } else { $m = $m | (1 << 52); }
  $e = $be - 1075;
  $k = $e < 0 ? -$e : 0;
  $digits = rs_exact($m, $e);
  if ($k > $p) {
    $cut = $k - $p;
    if (strlen($digits) <= $cut) { $digits = str_repeat('0', $cut - strlen($digits) + 1) . $digits; }
    $head = substr($digits, 0, strlen($digits) - $cut);
    $tail = substr($digits, strlen($digits) - $cut);
    $half = '5' . str_repeat('0', $cut - 1);
    $c = strcmp($tail, $half);
    if ($c > 0 || ($c == 0 && ((int)$head[strlen($head) - 1]) % 2 == 1)) { $head = rs_digits_inc($head); }
    $digits = $head;
  } else {
    $digits = $digits . str_repeat('0', $p - $k);
  }
  if (strlen($digits) <= $p) { $digits = str_repeat('0', $p - strlen($digits) + 1) . $digits; }
  $ip = ltrim(substr($digits, 0, strlen($digits) - $p), '0');
  if ($ip === '') { $ip = '0'; }
  $res = $p > 0 ? $ip . '.' . substr($digits, strlen($digits) - $p) : $ip;
  return $neg ? '-' . $res : $res;
}
"))

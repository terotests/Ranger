      php ( "rs_f64(" (e 1) ")"
(create_polyfill "
function rs_f64($x) {
  if (is_nan($x)) { return 'NaN'; }
  if (is_infinite($x)) { return $x > 0 ? 'inf' : '-inf'; }
  $s = var_export((float)$x, true);
  $neg = $s[0] == '-';
  if ($neg) { $s = substr($s, 1); }
  $ep = strpos($s, 'E');
  if ($ep !== false) {
    $mant = substr($s, 0, $ep);
    $exp = (int)substr($s, $ep + 1);
    $dot = strpos($mant, '.');
    $digits = rtrim(str_replace('.', '', $mant), '0');
    if ($digits === '') { $digits = '0'; }
    $intLen = ($dot === false ? strlen($mant) : $dot) + $exp;
    if ($intLen <= 0) { $s = '0.' . str_repeat('0', -$intLen) . $digits; }
    elseif ($intLen >= strlen($digits)) { $s = $digits . str_repeat('0', $intLen - strlen($digits)); }
    else { $s = substr($digits, 0, $intLen) . '.' . substr($digits, $intLen); }
  }
  if (substr($s, -2) === '.0') { $s = substr($s, 0, -2); }
  return $neg ? '-' . $s : $s;
}
"))
      * ( "rs_f64(" (e 1) ")" )
    }
  }

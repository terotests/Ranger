; SPDX-License-Identifier: MIT

; Runtime support for Rust-syntax modules (PLAN_RUST_SYNTAX.md).
;
; A `.rs` module is translated to Ranger (compiler/frontend/rust/lower) and
; imports this file. Rust fixes semantics that Ranger's own operators leave to
; the target -- integer division and remainder truncate toward zero, `as`
; truncates a float, `{}` prints a float in its shortest round-trip form and
; never in exponent notation -- and every target must print what the native
; Rust build prints. The operators here give each of those one meaning.
;
; Most are type-overloaded (`rs_div` on two ints, on two doubles), so the
; translator can emit one name and leave the choice to Ranger's type checker.

operators {

  ; ------------------------------------------------------------ arithmetic

  ; Integer division truncates toward zero (Python's `//` floors). Every
  ; target is spelled out: an operator with a `* @macro` template ignores its
  ; per-target ones.
  rs_div _:int (a:int b:int) {
    templates {
      ranger ( "(rs_div " (e 1) " " (e 2) ")" )
      es6 ( "Math.trunc(" (e 1) " / " (e 2) ")" )
      python ( "rs_idiv(" (e 1) ", " (e 2) ")"
(create_polyfill "
def rs_idiv(a, b):
    q = abs(a) // abs(b)
    return q if (a >= 0) == (b >= 0) else -q
"))
      dart ( "(" (e 1) " ~/ " (e 2) ")" )
      php ( "intdiv(" (e 1) ", " (e 2) ")" )
      * ( "(" (e 1) " / " (e 2) ")" )
    }
  }
  rs_div _:double (a:double b:double) {
    templates {
      * @macro(true) ( "(" "(" (e 1) ")" " / " "(" (e 2) ")" ")" )
    }
  }

  ; The remainder has the sign of the dividend (Python's `%` has the sign of
  ; the divisor).
  rs_rem _:int (a:int b:int) {
    templates {
      ranger ( "(rs_rem " (e 1) " " (e 2) ")" )
      python ( "rs_irem(" (e 1) ", " (e 2) ")"
(create_polyfill "
def rs_irem(a, b):
    r = abs(a) % abs(b)
    return r if a >= 0 else -r
"))
      dart ( "(" (e 1) ").remainder(" (e 2) ")" )
      * ( "(" (e 1) " % " (e 2) ")" )
    }
  }
  rs_rem _:double (a:double b:double) {
    templates {
      ranger ( "(rs_rem" " " (e 1) " " (e 2) ")" )
      python ( "math.fmod(" (e 1) ", " (e 2) ")" (imp "math") )
      go ( "math.Mod(" (e 1) ", " (e 2) ")" (imp "math") )
      cpp ( "std::fmod(" (e 1) ", " (e 2) ")" (imp "<cmath>") )
      php ( "fmod(" (e 1) ", " (e 2) ")" )
      * ( "(" (e 1) " % " (e 2) ")" )
    }
  }

  rs_neg _:int (a:int) {
    templates {
      * @macro(true) ( "(0 - " "(" (e 1) ")" ")" )
    }
  }
  rs_neg _:double (a:double) {
    templates {
      * @macro(true) ( "(0.0 - " "(" (e 1) ")" ")" )
    }
  }

  rs_abs _:int (a:int) {
    templates {
      * @macro(true) ( "(? (" "(" (e 1) ")" " < 0) (0 - " "(" (e 1) ")" ") " "(" (e 1) ")" ")" )
    }
  }
  rs_abs _:double (a:double) {
    templates {
      * @macro(true) ( "(? (" "(" (e 1) ")" " < 0.0) (0.0 - " "(" (e 1) ")" ") " "(" (e 1) ")" ")" )
    }
  }

  rs_min _:int (a:int b:int) {
    templates {
      * @macro(true) ( "(? (" "(" (e 1) ")" " < " "(" (e 2) ")" ") " "(" (e 1) ")" " " "(" (e 2) ")" ")" )
    }
  }
  rs_min _:double (a:double b:double) {
    templates {
      * @macro(true) ( "(? (" "(" (e 1) ")" " < " "(" (e 2) ")" ") " "(" (e 1) ")" " " "(" (e 2) ")" ")" )
    }
  }
  rs_max _:int (a:int b:int) {
    templates {
      * @macro(true) ( "(? (" "(" (e 1) ")" " > " "(" (e 2) ")" ") " "(" (e 1) ")" " " "(" (e 2) ")" ")" )
    }
  }
  rs_max _:double (a:double b:double) {
    templates {
      * @macro(true) ( "(? (" "(" (e 1) ")" " > " "(" (e 2) ")" ") " "(" (e 1) ")" " " "(" (e 2) ")" ")" )
    }
  }

  rs_sqrt _:double (a:double) {
    templates {
      * @macro(true) ( "(sqrt " "(" (e 1) ")" ")" )
    }
  }
  rs_floor _:double (a:double) {
    templates {
      * @macro(true) ( "(floor " "(" (e 1) ")" ")" )
    }
  }
  rs_ceil _:double (a:double) {
    templates {
      * @macro(true) ( "(ceil " "(" (e 1) ")" ")" )
    }
  }
  rs_powi _:double (a:double n:int) {
    templates {
      ranger ( "(rs_powi" " " (e 1) " " (e 2) ")" )
      es6 ( "Math.pow(" (e 1) ", " (e 2) ")" )
      python ( "float(" (e 1) " ** " (e 2) ")" )
      go ( "math.Pow(" (e 1) ", float64(" (e 2) "))" (imp "math") )
      cpp ( "std::pow(" (e 1) ", (double)" (e 2) ")" (imp "<cmath>") )
      kotlin ( "Math.pow(" (e 1) ", (" (e 2) ").toDouble())" )
      csharp ( "System.Math.Pow(" (e 1) ", " (e 2) ")" )
      dart ( "pow(" (e 1) ", " (e 2) ").toDouble()" (imp "dart:math") )
      scala ( "math.pow(" (e 1) ", (" (e 2) ").toDouble)" )
      php ( "((float)pow(" (e 1) ", " (e 2) "))" )
      * ( "Math.pow(" (e 1) ", " (e 2) ")" )
    }
  }
  rs_pow _:int (a:int n:int) {
    templates {
      ranger ( "(rs_pow" " " (e 1) " " (e 2) ")" )
      es6 ( "Math.pow(" (e 1) ", " (e 2) ")" )
      python ( "(" (e 1) " ** " (e 2) ")" )
      go ( "rs_ipow(" (e 1) ", " (e 2) ")"
(create_polyfill "
func rs_ipow(a int64, n int64) int64 {
	r := int64(1)
	for i := int64(0); i < n; i++ {
		r *= a
	}
	return r
}
"))
      cpp ( "rs_ipow(" (e 1) ", " (e 2) ")"
(create_polyfill "
inline long long rs_ipow(long long a, long long n) {
    long long r = 1;
    for (long long i = 0; i < n; i++) { r *= a; }
    return r;
}
"))
      java7 ( "rs_ipow(" (e 1) ", " (e 2) ")"
(create_polyfill "
static int rs_ipow(int a, int n) {

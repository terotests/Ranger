      csharp ( "rs_f64_prec(" (e 1) ", " (e 2) ")"
(create_polyfill "
// The decimal digits of mant * 2^e * 10^k, k = max(0, -e): exact, so no
// digit depends on the runtime's number formatting.
static string rs_exact(long mant, int e) {
    var limbs = new System.Collections.Generic.List<ulong>();
    while (mant > 0) { limbs.Add((ulong)(mant % 1000000000L)); mant /= 1000000000L; }
    if (limbs.Count == 0) { limbs.Add(0); }
    ulong f = e < 0 ? 5UL : 2UL;
    for (int n = (e < 0 ? -e : e); n > 0; n--) {
        ulong carry = 0;
        for (int i = 0; i < limbs.Count; i++) {
            ulong t = limbs[i] * f + carry;
            limbs[i] = t % 1000000000UL;
            carry = t / 1000000000UL;
        }
        if (carry > 0) { limbs.Add(carry); }
    }
    var sb = new System.Text.StringBuilder();
    sb.Append(limbs[limbs.Count - 1]);
    for (int i = limbs.Count - 2; i >= 0; i--) { sb.Append(limbs[i].ToString(\"D9\")); }
    return sb.ToString();
}
// Adds one to a digit string; the result may be one digit longer.
static string rs_digits_inc(string s) {
    char[] c = s.ToCharArray();
    int i = c.Length - 1;
    while (i >= 0 && c[i] == '9') { c[i] = '0'; i--; }
    if (i < 0) { return \"1\" + new string(c); }
    c[i]++;
    return new string(c);
}
// Compares two digit strings as numbers.
static int rs_digits_cmp(string a, string b) {
    a = a.TrimStart('0');
    b = b.TrimStart('0');
    if (a.Length != b.Length) { return a.Length < b.Length ? -1 : 1; }
    return System.Math.Sign(string.CompareOrdinal(a, b));
}
// digits * 10^-k written without an exponent.
static string rs_place(string digits, int k) {
    if (digits.Length <= k) { digits = new string('0', k - digits.Length + 1) + digits; }
    string ip = digits.Substring(0, digits.Length - k).TrimStart('0');
    if (ip.Length == 0) { ip = \"0\"; }
    return k > 0 ? ip + \".\" + digits.Substring(digits.Length - k) : ip;
}
")
(create_polyfill "
// `{:.N}`: the exact value rounded to N decimals, a tie to even.
static string rs_f64_prec(double x, int p) {
    if (double.IsNaN(x)) { return \"NaN\"; }
    if (double.IsPositiveInfinity(x)) { return \"inf\"; }
    if (double.IsNegativeInfinity(x)) { return \"-inf\"; }
    long bits = System.BitConverter.DoubleToInt64Bits(x);
    int be = (int)((bits >> 52) & 0x7FF);
    long m = bits & 0xFFFFFFFFFFFFFL;
    if (be == 0) { be = 1; } else { m |= 1L << 52; }
    int e = be - 1075;
    int k = e < 0 ? -e : 0;
    string digits = rs_exact(m, e);
    if (k > p) {
        string head = digits.Length > k - p ? digits.Substring(0, digits.Length - (k - p)) : \"0\";
        string tail = digits.Length > k - p ? digits.Substring(digits.Length - (k - p)) : digits.PadLeft(k - p, '0');
        int c = rs_digits_cmp(tail, \"5\" + new string('0', tail.Length - 1));
        if (c > 0 || (c == 0 && ((head[head.Length - 1] - '0') % 2) == 1)) { head = rs_digits_inc(head); }
        digits = head;
    } else {
        digits = digits + new string('0', p - k);
    }
    string res = rs_place(digits, p);
    return bits < 0 ? \"-\" + res : res;
}
"))
      dart ( "rs_f64_prec(" (e 1) ", " (e 2) ")" (imp "dart:typed_data")
(create_polyfill "
String rs_f64_prec(double x, int p) {
  if (x.isNaN) { return 'NaN'; }
  if (x.isInfinite) { return x > 0 ? 'inf' : '-inf'; }
  var bd = ByteData(8)..setFloat64(0, x);
  var hi = bd.getUint32(0);
  var lo = bd.getUint32(4);
  var neg = (hi >> 31) == 1;
  var be = (hi >> 20) & 0x7FF;
  var m = (BigInt.from(hi & 0xFFFFF) << 32) | BigInt.from(lo);
  if (be == 0) { be = 1; } else { m = m | (BigInt.one << 52); }
  var e = be - 1075;
  // the exact value times 10^p, rounded half to even
  var n = m * BigInt.from(10).pow(p);
  if (e >= 0) {
    n = n << e;
  } else {
    var q = n >> -e;
    var r = n - (q << -e);
    var half = BigInt.one << (-e - 1);
    if (r > half || (r == half && q.isOdd)) { q = q + BigInt.one; }
    n = q;
  }
  var s = n.toString();
  if (p > 0) {
    s = s.padLeft(p + 1, '0');
    s = s.substring(0, s.length - p) + '.' + s.substring(s.length - p);
  }
  return neg ? '-' + s : s;
}
"))

      kotlin ( "rs_f64_prec(" (e 1) ", " (e 2) ")"
(create_polyfill "
fun rs_f64_prec(x: Double, p: Int): String {
    if (x.isNaN()) { return \"NaN\" }
    if (x.isInfinite()) { return if (x > 0) \"inf\" else \"-inf\" }
    val r = java.math.BigDecimal(x).setScale(p, java.math.RoundingMode.HALF_EVEN)

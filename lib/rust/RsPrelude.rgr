(create_polyfill "
inline long rs_case_map(long c, bool up) {
    if (up) {
        if (c >= 'a' && c <= 'z') { return c - 32; }
        if ((c >= 0xE0 && c <= 0xFE && c != 0xF7)) { return c - 32; }
        if (c == 0xFF) { return 0x178; }
        if (c >= 0x100 && c <= 0x17F && c != 0x130 && c != 0x131 && c != 0x138 && c != 0x149 && c != 0x17F) {
            bool oddLow = (c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E);
            if (oddLow) { return (c % 2 == 0) ? c - 1 : c; }
            return (c % 2 == 1) ? c - 1 : c;
        }
        if (c >= 0x3B1 && c <= 0x3C9 && c != 0x3C2) { return c - 32; }
        if (c >= 0x430 && c <= 0x44F) { return c - 32; }
        if (c >= 0x450 && c <= 0x45F) { return c - 80; }
        return c;
    }
    if (c >= 'A' && c <= 'Z') { return c + 32; }
    if ((c >= 0xC0 && c <= 0xDE && c != 0xD7)) { return c + 32; }
    if (c == 0x178) { return 0xFF; }
    if (c >= 0x100 && c <= 0x17F && c != 0x130 && c != 0x131 && c != 0x138 && c != 0x149 && c != 0x17F) {
        bool oddLow = (c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E);
        if (oddLow) { return (c % 2 == 1) ? c + 1 : c; }
        return (c % 2 == 0) ? c + 1 : c;
    }
    if (c >= 0x391 && c <= 0x3A9 && c != 0x3A2) { return c + 32; }
    if (c >= 0x410 && c <= 0x42F) { return c + 32; }
    if (c >= 0x400 && c <= 0x40F) { return c + 80; }
    return c;
}
inline std::string rs_case(const std::string& s, bool up) {
    std::string out;
    size_t i = 0;
    while (i < s.size()) {
        unsigned char b = (unsigned char)s[i];
        long c = b;
        size_t n = 1;
        if (b >= 0xF0) { c = b & 0x07; n = 4; }
        else if (b >= 0xE0) { c = b & 0x0F; n = 3; }
        else if (b >= 0xC0) { c = b & 0x1F; n = 2; }
        for (size_t k = 1; k < n && i + k < s.size(); k++) { c = (c << 6) | ((unsigned char)s[i + k] & 0x3F); }
        i += n;
        if (up && c == 0xDF) { out += \"SS\"; continue; }
        long m = rs_case_map(c, up);
        if (m < 0x80) { out += (char)m; }
        else if (m < 0x800) { out += (char)(0xC0 | (m >> 6)); out += (char)(0x80 | (m & 0x3F)); }
        else if (m < 0x10000) { out += (char)(0xE0 | (m >> 12)); out += (char)(0x80 | ((m >> 6) & 0x3F)); out += (char)(0x80 | (m & 0x3F)); }
        else { out += (char)(0xF0 | (m >> 18)); out += (char)(0x80 | ((m >> 12) & 0x3F)); out += (char)(0x80 | ((m >> 6) & 0x3F)); out += (char)(0x80 | (m & 0x3F)); }
    }
    return out;
}
"))

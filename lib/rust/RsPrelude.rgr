  ; ----------------------------------------------------------------- casts

  ; `x as i64` on a float truncates toward zero (`to_int` floors).
  rs_f2i _:int (a:double) {
    templates {
      ranger ( "(rs_f2i" " " (e 1) ")" )
      es6 ( "Math.trunc(" (e 1) ")" )
      python ( "int(" (e 1) ")" )
      go ( "rs_f2i(" (e 1) ")"
(create_polyfill "
func rs_f2i(x float64) int64 {
	return int64(x)
}
"))
      cpp ( "(long long)(" (e 1) ")" )
      java7 ( "((int)(double)(" (e 1) "))" )
      kotlin ( "(" (e 1) ").toInt()" )
      csharp ( "((int)(" (e 1) "))" )
      dart ( "(" (e 1) ").toInt()" )
      scala ( "(" (e 1) ").toInt" )
      php ( "((int)(" (e 1) "))" )
      * ( "Math.trunc(" (e 1) ")" )
    }
  }
  rs_i2f _:double (a:int) {
    templates {
      * @macro(true) ( "(to_double " "(" (e 1) ")" ")" )
    }
  }
  rs_wrap_u8 _:int (a:int) {
    templates {
      * @macro(true) ( "(bit_and " "(" (e 1) ")" " 255)" )
    }
  }
  rs_wrap_u16 _:int (a:int) {
    templates {
      * @macro(true) ( "(bit_and " "(" (e 1) ")" " 65535)" )
    }
  }

  ; A Rust `char` is a one-character string here; these cross to and from
  ; its code point.
  rs_char_code _:int (c:string) {
    templates {
      * @macro(true) ( "(itemAt (to_chars " "(" (e 1) ")" ") 0)" )
    }
  }
  rs_char_from _:string (code:int) {
    templates {
      es6 ( "String.fromCodePoint(" (e 1) ")" )
      python ( "chr(" (e 1) ")" )
      go ( "string(rune(" (e 1) "))" )
      java7 ( "(new String(Character.toChars(" (e 1) ")))" )
      kotlin ( "String(Character.toChars(" (e 1) "))" )
      csharp ( "char.ConvertFromUtf32(" (e 1) ")" )
      dart ( "String.fromCharCode(" (e 1) ")" )
      scala ( "new String(Character.toChars(" (e 1) "))" )
      php ( "mb_chr(" (e 1) ", 'UTF-8')" )
      * @macro(true) ( "(strfromcode " "(" (e 1) ")" ")" )
    }
  }

  ; ------------------------------------------------------------ formatting

  ; `{}` of a float: shortest round-trip digits, never an exponent, no
  ; trailing `.0` -- what Rust's Display writes.
  rs_fmt _:string (a:double) {
    templates {
      ranger ( "(rs_fmt" " " (e 1) ")" )
      es6 ( "rs_f64(" (e 1) ")"
(create_polyfill "
function rs_expand_exp(s) {
  var neg = s.charAt(0) === '-';
  if (neg) { s = s.slice(1); }
  var parts = s.toLowerCase().split('e');
  var mant = parts[0];
  var exp = parseInt(parts[1], 10);
  var dot = mant.indexOf('.');
  var digits = mant.replace('.', '');
  var intLen = (dot < 0 ? mant.length : dot) + exp;
  var out;
  if (intLen <= 0) { out = '0.' + '0'.repeat(-intLen) + digits; }
  else if (intLen >= digits.length) { out = digits + '0'.repeat(intLen - digits.length); }
  else { out = digits.slice(0, intLen) + '.' + digits.slice(intLen); }
  return (neg ? '-' : '') + out;
}
function rs_f64(x) {
  if (Number.isNaN(x)) { return 'NaN'; }
  if (x === Infinity) { return 'inf'; }
  if (x === -Infinity) { return '-inf'; }
  if (x === 0 && 1 / x < 0) { return '-0'; }
  var s = String(x);
  return s.indexOf('e') < 0 ? s : rs_expand_exp(s);
}
"))
      python ( "rs_f64(" (e 1) ")"
(create_polyfill "
def rs_f64(x):
    import math
    if math.isnan(x):
        return 'NaN'
    if math.isinf(x):
        return 'inf' if x > 0 else '-inf'
    s = repr(float(x))
    if 'e' in s:
        neg = s.startswith('-')
        if neg:
            s = s[1:]
        mant, exp = s.split('e')
        exp = int(exp)
        dot = mant.find('.')
        digits = mant.replace('.', '')
        int_len = (len(mant) if dot < 0 else dot) + exp
        if int_len <= 0:
            s = '0.' + '0' * (-int_len) + digits
        elif int_len >= len(digits):
            s = digits + '0' * (int_len - len(digits))
        else:
            s = digits[:int_len] + '.' + digits[int_len:]
        if neg:
            s = '-' + s
    if s.endswith('.0'):
        s = s[:-2]
    return s
"))
      go ( "rs_f64(" (e 1) ")" (imp "strconv") (imp "math")
(create_polyfill "
func rs_f64(x float64) string {
	if math.IsNaN(x) {
		return \"NaN\"
	}
	if math.IsInf(x, 1) {
		return \"inf\"
	}
	if math.IsInf(x, -1) {
		return \"-inf\"
	}
	return strconv.FormatFloat(x, 'f', -1, 64)
}
"))
      cpp ( "rs_f64(" (e 1) ")" (imp "<charconv>") (imp "<cmath>") (imp "<string>")
(create_polyfill "
inline std::string rs_f64(double x) {
    if (std::isnan(x)) { return \"NaN\"; }
    if (std::isinf(x)) { return x > 0 ? \"inf\" : \"-inf\"; }
    char buf[400];
    auto r = std::to_chars(buf, buf + sizeof(buf), x, std::chars_format::fixed);
    return std::string(buf, r.ptr);
}
"))
      rust ( "format!(\"{}\", " (e 1) ")" )
      java7 ( "rs_f64(" (e 1) ")"
(create_polyfill "
static String rs_f64(double x) {
    if (Double.isNaN(x)) { return \"NaN\"; }
    if (Double.isInfinite(x)) { return x > 0 ? \"inf\" : \"-inf\"; }
    if (x == 0.0) { return (1.0 / x < 0) ? \"-0\" : \"0\"; }
    return new java.math.BigDecimal(Double.toString(x)).stripTrailingZeros().toPlainString();
}
"))
      kotlin ( "rs_f64(" (e 1) ")"
(create_polyfill "
fun rs_f64(x: Double): String {
    if (x.isNaN()) { return \"NaN\" }
    if (x.isInfinite()) { return if (x > 0) \"inf\" else \"-inf\" }
    if (x == 0.0) { return if (1.0 / x < 0) \"-0\" else \"0\" }
    return java.math.BigDecimal(x.toString()).stripTrailingZeros().toPlainString()
}
"))
      csharp ( "rs_f64(" (e 1) ")"
(create_polyfill "
// The decimal digits of mant * 2^e * 10^k, k = max(0, -e): exact, so no
// digit depends on the runtime's number formatting.
static string rs_exact(long mant, int e) {
    var limbs = new System.Collections.Generic.List<ulong>();
    while (mant > 0) { limbs.Add((ulong)(mant % 1000000000L)); mant /= 1000000000L; }
    if (limbs.Count == 0) { limbs.Add(0); }
    ulong f = e < 0 ? 5UL : 2UL;
    for (int n = (e < 0 ? -e : e); n > 0; n--) {
        ulong carry = 0;
        for (int i = 0; i < limbs.Count; i++) {
            ulong t = limbs[i] * f + carry;
            limbs[i] = t % 1000000000UL;
            carry = t / 1000000000UL;
        }
        if (carry > 0) { limbs.Add(carry); }
    }
    var sb = new System.Text.StringBuilder();
    sb.Append(limbs[limbs.Count - 1]);
    for (int i = limbs.Count - 2; i >= 0; i--) { sb.Append(limbs[i].ToString(\"D9\")); }
    return sb.ToString();
}
// Adds one to a digit string; the result may be one digit longer.
static string rs_digits_inc(string s) {
    char[] c = s.ToCharArray();
    int i = c.Length - 1;
    while (i >= 0 && c[i] == '9') { c[i] = '0'; i--; }
    if (i < 0) { return \"1\" + new string(c); }
    c[i]++;
    return new string(c);
}
// Compares two digit strings as numbers.
static int rs_digits_cmp(string a, string b) {
    a = a.TrimStart('0');
    b = b.TrimStart('0');
    if (a.Length != b.Length) { return a.Length < b.Length ? -1 : 1; }
    return System.Math.Sign(string.CompareOrdinal(a, b));
}
// digits * 10^-k written without an exponent.
static string rs_place(string digits, int k) {
    if (digits.Length <= k) { digits = new string('0', k - digits.Length + 1) + digits; }
    string ip = digits.Substring(0, digits.Length - k).TrimStart('0');
    if (ip.Length == 0) { ip = \"0\"; }
    return k > 0 ? ip + \".\" + digits.Substring(digits.Length - k) : ip;
}
")
(create_polyfill "
// Rust's Display: the shortest digits that read back as x (the one nearest
// x when there are two), never an exponent.
static string rs_f64(double x) {
    if (double.IsNaN(x)) { return \"NaN\"; }
    if (double.IsPositiveInfinity(x)) { return \"inf\"; }
    if (double.IsNegativeInfinity(x)) { return \"-inf\"; }
    if (x == 0.0) { return (1.0 / x < 0) ? \"-0\" : \"0\"; }
    long bits = System.BitConverter.DoubleToInt64Bits(x);
    int be = (int)((bits >> 52) & 0x7FF);
    long m = bits & 0xFFFFFFFFFFFFFL;
    if (be == 0) { be = 1; } else { m |= 1L << 52; }
    int e = be - 1077;
    // x and the halfway points to its neighbours, all times 2^e
    string xs = rs_exact(4 * m, e);
    string hi = rs_exact(4 * m + 2, e);
    string lo = rs_exact((m == (1L << 52) && be > 1) ? 4 * m - 1 : 4 * m - 2, e);
    bool incl = (m % 2) == 0;
    int k = e < 0 ? -e : 0;
    string res = xs;
    for (int n = 1; n <= xs.Length; n++) {
        string head = xs.Substring(0, n);
        string tail = xs.Substring(n);
        string zeros = new string('0', tail.Length);
        string down = head + zeros;
        string up = rs_digits_inc(head) + zeros;
        string half = \"5\" + new string('0', tail.Length > 0 ? tail.Length - 1 : 0);
        int c = tail.Length > 0 ? rs_digits_cmp(tail, half) : -1;
        bool nearUp = c > 0 || (c == 0 && ((head[n - 1] - '0') % 2) == 1);
        string first = nearUp ? up : down;
        string second = nearUp ? down : up;
        string pick = null;
        foreach (string cand in new string[] { first, second }) {
            int cl = rs_digits_cmp(cand, lo);
            int ch = rs_digits_cmp(cand, hi);
            if ((cl > 0 || (incl && cl == 0)) && (ch < 0 || (incl && ch == 0))) { pick = cand; break; }
        }
        if (pick != null) { res = pick; break; }
    }
    string o = rs_place(res, k);
    if (o.IndexOf('.') >= 0) { o = o.TrimEnd('0').TrimEnd('.'); }
    return bits < 0 ? \"-\" + o : o;
}
"))
      dart ( "rs_f64(" (e 1) ")"
(create_polyfill "
String rs_f64(double x) {
  if (x.isNaN) { return 'NaN'; }
  if (x.isInfinite) { return x > 0 ? 'inf' : '-inf'; }
  if (x == 0.0) { return x.isNegative ? '-0' : '0'; }
  var s = x.toString();
  if (s.contains('e')) {
    var neg = s.startsWith('-');
    if (neg) { s = s.substring(1); }
    var parts = s.split('e');
    var mant = parts[0];
    var exp = int.parse(parts[1]);
    var dot = mant.indexOf('.');
    var digits = mant.replaceAll('.', '');
    var intLen = (dot < 0 ? mant.length : dot) + exp;
    if (intLen <= 0) { s = '0.' + ('0' * -intLen) + digits; }
    else if (intLen >= digits.length) { s = digits + ('0' * (intLen - digits.length)); }
    else { s = digits.substring(0, intLen) + '.' + digits.substring(intLen); }
    if (neg) { s = '-' + s; }
  }
  if (s.endsWith('.0')) { s = s.substring(0, s.length - 2); }
  return s;
}
"))
      scala ( "rs_f64(" (e 1) ")"
(create_polyfill "
def rs_f64(x: Double): String = {
  if (x.isNaN) \"NaN\"
  else if (x.isInfinite) (if (x > 0) \"inf\" else \"-inf\")
  else if (x == 0.0) (if (1.0 / x < 0) \"-0\" else \"0\")
  else new java.math.BigDecimal(java.lang.Double.toString(x)).stripTrailingZeros().toPlainString()
}

; SPDX-License-Identifier: MIT

; Inflate and ZipReader against streams zlib wrote, and against streams no
; encoder writes: cut short, hostile, lying about their size. Each must end,
; and none may allocate more than it is allowed.
;
;   npm run zip:limits

Import "../Inflate.rgr"
Import "../../../gallery/zip/ZipReader.rgr"

class InflateLimitsTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new InflateLimitsTest)
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    sfn hexBytes:buffer (hex:string) {
        def n:int (idiv (strlen hex) 2)
        def b:buffer (buffer_alloc n)
        def i:int 0
        while (i < n) {
            def hi:int (InflateLimitsTest.nibble((charAt hex (i * 2))))
            def lo:int (InflateLimitsTest.nibble((charAt hex ((i * 2) + 1))))
            buffer_set b i ((hi * 16) + lo)
            i = (i + 1)
        }
        return b
    }

    sfn nibble:int (c:int) {
        if (c <= 57) {
            return (c - 48)
        }
        return ((c - 97) + 10)
    }

    sfn slice:buffer (b:buffer n:int) {
        def out:buffer (buffer_alloc n)
        buffer_copy out 0 b 0 n
        return out
    }

    sfn text:string (b:buffer) {
        def s:string ""
        def i:int 0
        while (i < (buffer_length b)) {
            s = (s + (strfromcode (buffer_get b i)))
            i = (i + 1)
        }
        return s
    }

    fn run:void () {
        print "inflate"
        this.testInflate()
        print "zip reader"
        this.testZip()
        print ""
        if (failed == 0) {
            print ("ALL PASS  " + (to_string passed))
        } {
            print ((((to_string failed) + " FAILED  ") + (to_string passed)) + " passed")
        }
    }

    fn testInflate:void () {
        def inf (new Inflate())
        def hello:buffer (inf.decompress((InflateLimitsTest.hexBytes("cb48cdc9c957c840277514caf38b7252ac90c500"))))
        this.check("zlib stream" (((InflateLimitsTest.text(hello)) == "hello hello hello hello, world: hello hello") && ((strlen inf.error) == 0)))
        this.check("whole stream is not truncated" (inf.truncated == false))

        ; 1 MiB of zeros in about a kilobyte
        def bomb:buffer (InflateLimitsTest.hexBytes(""))
        def free (new Inflate())
        this.check("no limit: all of it" ((buffer_length (free.decompress(bomb))) == 1048576))
        def capped (new Inflate())
        capped.maxOutput = 1000
        def got:buffer (capped.decompress(bomb))
        this.check("over the limit: nothing" ((buffer_length got) == 0))
        this.check("over the limit: said why" ((indexOf capped.error "larger than 1000") >= 0))
        def exact (new Inflate())
        exact.maxOutput = 1048576
        this.check("at the limit: all of it" ((buffer_length (exact.decompress(bomb))) == 1048576))

        ; the first half of a stream: what it held, and it ends
        def whole:buffer (InflateLimitsTest.hexBytes(""))
        def cut (new Inflate())
        def part:buffer (cut.decompress((InflateLimitsTest.slice(whole (idiv (buffer_length whole) 2)))))
        def full:buffer ((new Inflate()).decompress(whole))
        this.check("full text" ((buffer_length full) == 4090))
        def n:int (buffer_length part)
        def prefix:boolean ((n > 0) && (n < 4090))
        def k:int 0
        while (prefix && (k < n)) {
            if ((buffer_get part k) != (buffer_get full k)) {
                prefix = false
            }
            k = (k + 1)
        }
        this.check("cut short: a prefix of the text" prefix)
        this.check("cut short: truncated, no error" (cut.truncated && ((strlen cut.error) == 0)))

        ; a final block of the reserved type 3
        def r (new Inflate())
        def reserved:buffer (buffer_alloc 1)
        buffer_set reserved 0 7
        this.check("reserved block type" (((buffer_length (r.decompress(reserved))) == 0) && ((strlen r.error) > 0)))

        ; a stored block whose length and complement disagree
        def s (new Inflate())
        def stored:buffer (InflateLimitsTest.hexBytes("010500000041414141"))
        this.check("stored length mismatch" (((buffer_length (s.decompress(stored))) == 0) && ((strlen s.error) > 0)))

        ; a back-reference before the first byte (fixed codes: length 3, distance 1)
        def d (new Inflate())
        def back:buffer (InflateLimitsTest.hexBytes("030200"))
        d.decompress(back)
        this.check("distance before the start" ((strlen d.error) > 0))

        ; every one-byte and some longer junk ends
        def j:int 0
        def ended:int 0
        while (j < 256) {
            def junk:buffer (buffer_alloc 3)
            buffer_set junk 0 j
            buffer_set junk 1 ((j * 7) % 256)
            buffer_set junk 2 ((j * 13) % 256)
            def jf (new Inflate())
            jf.maxOutput = 65536
            jf.decompress(junk)
            ended = (ended + 1)
            j = (j + 1)
        }
        this.check("junk streams end" (ended == 256))
    }

    fn testZip:void () {
        def ok (new ZipReader())
        ok.openBytes((InflateLimitsTest.hexBytes("")))
        def e@(optional):ZipEntry (ok.getEntry("a.txt"))
        this.check("member found" (!null? e))
        if (!null? e) {
            this.check("member unpacked" ((buffer_length (ok.extract((unwrap e)))) == 100000))
        }

        def lies (new ZipReader())
        lies.openBytes((InflateLimitsTest.hexBytes("")))
        def e2@(optional):ZipEntry (lies.getEntry("a.txt"))
        if (!null? e2) {
            this.check("member larger than its header: refused" ((buffer_length (lies.extract((unwrap e2)))) == 0))
            this.check("member larger than its header: said why" ((strlen lies.lastError) > 0))
        }

        def huge (new ZipReader())
        huge.openBytes((InflateLimitsTest.hexBytes("")))
        def e3@(optional):ZipEntry (huge.getEntry("a.txt"))
        if (!null? e3) {
            this.check("member over maxEntryBytes: refused" ((buffer_length (huge.extract((unwrap e3)))) == 0))
            this.check("member over maxEntryBytes: said why" ((indexOf huge.lastError "larger than") >= 0))
        }
    }
}

; SPDX-License-Identifier: MIT

; =============================================================================
; EVGHoles / EVGDress — a `{key}` in a document, and what fills it in a design
; =============================================================================
;
; A document that drives an app writes a control's state as a HOLE:
;
;   class-name="ui-switch ui-switch-state-{wifi}"
;
; At run time a machine fills it from its context, and the class becomes
; `ui-switch-state-checked`, which is what the stylesheet paints. That is the
; app runtime's job and it lives with the app runtime.
;
; At DESIGN time there is no machine, and until now the hole was left exactly
; as written — so `ui-switch-state-{wifi}` matched no rule, the track got no
; colour and the switch was invisible on the very screen somebody was drawing.
; The workaround people found was to hand-write base paint into the document's
; stylesheet so the unmatched state would not matter. That is a second copy of
; every control's look, kept in step by hand, and it is what this file exists
; to make unnecessary.
;
; The document already knows what each control is showing: `checked` is on the
; node, and it is the same value `evg_app init` reads to write the machine's
; opening context. So a design can fill its own holes from itself, and the
; picture a designer sees is the picture the app boots with.
;
; It fills by ADDING, never by replacing:
;
;   ui-switch-track-state-{wifi}
;   ui-switch-track-state-{wifi} ui-switch-track-state-checked
;
; The hole stays in the class list, which matters for three reasons. Nothing
; downstream can mistake a dressed design for a bound app. `EVGMeasure` can
; still tell a control that is bound from one whose state is a fixed word —
; the `frozen` check reads exactly that. And the document on disk is never
; touched: this dresses a tree in memory, on its way to a layout.
;
; The app runtime does NOT call this. A machine's value and the document's
; value disagree the moment anything is pressed, and two state classes on one
; element would then paint whichever the sheet happened to reach last.
; =============================================================================

Import "EVGElement.rgr"

class EVGHoles {
    ; --- THE TWO SHAPES OF A HOLE ---------------------------------------------
    ;
    ;   {wifi}              the key's value, whatever it is
    ;   {cinematic=4k30}    "checked" when the key IS that value, else "unchecked"
    ;
    ; The second exists because one thing a screen does constantly has no
    ; expression in the first: CHOOSING ONE OF SEVERAL. A list of six
    ; resolutions with a tick against the chosen one is not six switches —
    ; it is one value, asked six different questions. Encoded with plain
    ; holes it becomes a key per row that something has to keep consistent,
    ; and the thing that has to is a person, who will get it wrong.
    ;
    ; Asking the question in the hole keeps the fact in one place. The answer
    ; is a STATE WORD rather than a boolean because that is the vocabulary
    ; every control in this engine already paints with, so a tick needs two
    ; rules in the sheet — `.check-state-checked`, `.check-state-unchecked` —
    ; and those two serve every row of every group in the app.
    ;
    ; A key with a `=` in it is not addressable, which is the price and is
    ; cheap: `=` is not in any key anybody writes.
    sfn keyOf:string (name:string) {
        def cut:int (indexOf name "=")
        if (cut < 0) {
            return name
        }
        return (substring name 0 cut)
    }

    ; "" when the hole asks for the value rather than testing it.
    sfn wantOf:string (name:string) {
        def cut:int (indexOf name "=")
        if (cut < 0) {
            return ""
        }
        return (substring name (cut + 1) (strlen name))
    }

    sfn asksEquals:boolean (name:string) {
        return ((indexOf name "=") >= 0)
    }

    ; The `{name}` syntax, defined once. `EvgAppRules.fillText` fills the same
    ; holes from a machine's context; it differs only in where the value comes
    ; from, and it scans with this.
    ;
    ; A `{key=value}` reports `key`: the name a machine has to hold is the
    ; key, and the value is the question being asked about it.
    sfn scan:void (text:string out:[string]) {
        def n:int (strlen text)
        def i@(mutable):int 0
        while (i < n) {
            if ((charAt text i) == 123) {
                def j@(mutable):int (i + 1)
                def close@(mutable):int (0 - 1)
                while (j < n) {
                    if ((charAt text j) == 125) {
                        if (close < 0) {
                            close = j
                        }
                    }
                    j = (j + 1)
                }
                if (close < 0) {
                    i = n
                } {
                    def name:string (substring text (i + 1) close)
                    def key:string (EVGHoles.keyOf(name))
                    if ((strlen key) > 0) {
                        if ((EVGHoles.mentions(out key)) == false) {
                            push out key
                        }
                    }
                    i = (close + 1)
                }
            } {
                i = (i + 1)
            }
        }
    }

    ; Every hole in `text` replaced by one word. A design has a single answer
    ; for a control — what it is showing — so it does not need a per-key
    ; lookup, and an unclosed `{` is left alone rather than swallowing the
    ; rest of the string.
    sfn fillWith:string (text:string word:string) {
        def out@(mutable):string ""
        def i@(mutable):int 0
        def n:int (strlen text)
        while (i < n) {
            def c:int (charAt text i)
            if (c == 123) {
                def close@(mutable):int (0 - 1)
                def j@(mutable):int (i + 1)
                while (j < n) {
                    if ((charAt text j) == 125) {
                        if (close < 0) {
                            close = j
                        }
                    }
                    j = (j + 1)
                }
                if (close < 0) {
                    out = (out + (substring text i (i + 1)))
                    i = (i + 1)
                } {
                    out = (out + word)
                    i = (close + 1)
                }
            } {
                out = (out + (substring text i (i + 1)))
                i = (i + 1)
            }
        }
        return out
    }

    sfn hasHole:boolean (text:string) {
        return ((indexOf text "{") >= 0)
    }

    sfn mentions:boolean (list:[string] want:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == want) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}

class EVGDress {
    ; Fill a design's own state holes, in place, on a tree that is on its way
    ; to a layout. Safe to call twice: a class that is already there is not
    ; added again.
    sfn dress:void (root:EVGElement) {
        EVGDress.walk(root "")
    }

    ; The state word flows DOWN. A track and a thumb carry the same hole as the
    ; switch above them and say nothing themselves about what they are showing,
    ; because the control is the thing that has a state — so the nearest
    ; ancestor with a role is what answers for them.
    sfn walk:void (el:EVGElement word:string) {
        def here:string word
        if ((strlen el.role) > 0) {
            def own:string (EVGDress.wordFor(el))
            if ((strlen own) > 0) {
                here = own
            }
        }
        if ((strlen here) > 0) {
            if ((strlen el.className) > 0) {
                el.className = (EVGDress.dressed(el.className here))
            }
        }
        def i:int 0
        while (i < (array_length el.children)) {
            EVGDress.walk((itemAt el.children i) here)
            i = (i + 1)
        }
    }

    ; What this control is showing, as the word a state class is spelled with.
    ; A control that says nothing is showing `unchecked`: that is what a
    ; machine written by `evg_app init` opens with, so it is what a design of
    ; it should look like rather than a hole.
    sfn wordFor:string (el:EVGElement) {
        if (el.a11yChecked == 2) {
            return "checked"
        }
        if (el.a11yChecked == 3) {
            return "indeterminate"
        }
        if (el.a11yChecked == 1) {
            return "unchecked"
        }
        if (EVGDress.isStateful(el.role)) {
            return "unchecked"
        }
        return ""
    }

    sfn isStateful:boolean (role:string) {
        if (role == "switch") {
            return true
        }
        if (role == "checkbox") {
            return true
        }
        if (role == "radio") {
            return true
        }
        return false
    }

    ; Each holed class token gets a filled copy beside it. The hole itself
    ; stays: see the header — this is the difference between a design that
    ; paints and a design that has quietly become an app.
    sfn dressed:string (className:string word:string) {
        if ((EVGHoles.hasHole(className)) == false) {
            return className
        }
        def out@(mutable):string className
        def n:int (strlen className)
        def at@(mutable):int 0
        while (at < n) {
            def rest:string (substring className at n)
            def sp:int (indexOf rest " ")
            def end@(mutable):int n
            if (sp >= 0) {
                end = (at + sp)
            }
            def tok:string (substring className at end)
            if (EVGHoles.hasHole(tok)) {
                def filled:string (EVGHoles.fillWith(tok word))
                if (filled != tok) {
                    if ((EVGDress.carries(out filled)) == false) {
                        out = ((out + " ") + filled)
                    }
                }
            }
            at = (end + 1)
        }
        return out
    }

    ; Is `want` already one of the space-separated tokens of `className`?
    ; `indexOf` would say yes to `ui-switch` inside `ui-switch-track`.
    sfn carries:boolean (className:string want:string) {
        def n:int (strlen className)
        def at@(mutable):int 0
        while (at < n) {
            def rest:string (substring className at n)
            def sp:int (indexOf rest " ")
            def end@(mutable):int n
            if (sp >= 0) {
                end = (at + sp)
            }
            if ((substring className at end) == want) {
                return true
            }
            at = (end + 1)
        }
        return false
    }
}

; SPDX-License-Identifier: MIT

; EVGGradient.rgr - Gradient parsing and storage for EVG layout
; Supports: linear-gradient, radial-gradient with multiple color stops

Import "EVGColor.rgr"

; A single color stop in a gradient
class EVGGradientStop {
    def percentage:double 0.0   ; 0.0 to 1.0 (or 0 to 100 if not normalized)
    def color:EVGColor (new EVGColor())
    
    Constructor () {
    }
    
    sfn create:EVGGradientStop (pct:double col:EVGColor) {
        def stop:EVGGradientStop (new EVGGradientStop())
        stop.percentage = pct
        stop.color = col
        return stop
    }
}

; Gradient definition with type, angle, and color stops
class EVGGradient {
    def isSet:boolean false
    def isLinear:boolean true     ; true = linear, false = radial
    def angle:double 0.0          ; degrees for linear gradient (0 = to top, 90 = to right)
    def stops:[EVGGradientStop]
    
    Constructor () {
        def s:[EVGGradientStop]
        stops = s
    }
    
    ; Get the first color (for simple 2-color gradients)
    fn getStartColor:EVGColor () {
        if ((array_length stops) > 0) {
            def stop:EVGGradientStop (itemAt stops 0)
            return stop.color
        }
        return (EVGColor.noColor())
    }
    
    ; Get the last color (for simple 2-color gradients)
    fn getEndColor:EVGColor () {
        def len:int (array_length stops)
        if (len > 0) {
            def stop:EVGGradientStop (itemAt stops (len - 1))
            return stop.color
        }
        return (EVGColor.noColor())
    }
    
    ; Get number of color stops
    fn getStopCount:int () {
        return (array_length stops)
    }
    
    ; Get a specific color stop
    fn getStop:EVGGradientStop (index:int) {
        return (itemAt stops index)
    }
    
    ; Add a color stop
    fn addStop:void (percentage:double color:EVGColor) {
        def stop:EVGGradientStop (EVGGradientStop.create(percentage color))
        push stops stop
    }
    
    ; Parse a CSS gradient string like:
    ; linear-gradient(90deg, #3498db, #9b59b6)
    ; linear-gradient(45deg, #e74c3c, #f39c12)
    ; radial-gradient(circle, #9b59b6, #2c3e50)
    ; linear-gradient(90deg, #e74c3c, #f39c12, #2ecc71, #3498db)
    sfn parse:EVGGradient (gradStr:string) {
        def grad:EVGGradient (new EVGGradient())

        def len:int (strlen gradStr)
        if (len == 0) {
            return grad
        }

        def linearIdx:int (indexOf gradStr "linear-gradient")
        def radialIdx:int (indexOf gradStr "radial-gradient")

        if (linearIdx >= 0) {
            grad.isLinear = true
            grad.isSet = true
            ; CSS with no direction runs TOP TO BOTTOM. The field's own default
            ; is 0 — to the top — so a gradient written the shortest way came
            ; out upside down, and every painter agreed with the other about
            ; the wrong answer.
            grad.angle = 180.0
        }
        if (radialIdx >= 0) {
            grad.isLinear = false
            grad.isSet = true
        }

        if (grad.isSet == false) {
            return grad
        }

        ; The arguments, split where CSS splits them. A naive split on every
        ; comma cuts `rgb(52,120,90)` into three pieces that are not colors,
        ; which is why a gradient written in `rgb()` used to parse to a
        ; gradient with NO STOPS — and an element with no stops emitted no
        ; background at all, so the node disappeared from the picture.
        def args:[string]
        EVGGradient.splitArgs(gradStr args)
        def n:int (array_length args)
        if (n == 0) {
            return grad
        }

        def first:int 0
        def head:string (trim (itemAt args 0))
        if ((EVGGradient.colorOf(head)).isSet) {
        } {
            ; Not a color, so it is the direction (or a radial's shape).
            first = 1
            if grad.isLinear {
                grad.angle = (EVGGradient.angleOf(head grad.angle))
            }
        }

        def colors:[EVGColor]
        def stopsAt:[double]
        def i:int first
        while (i < n) {
            def arg:string (trim (itemAt args i))
            def col:EVGColor (EVGGradient.colorOf(arg))
            if col.isSet {
                push colors col
                push stopsAt (EVGGradient.positionOf(arg))
            }
            i = (i + 1)
        }

        def numColors:int (array_length colors)
        if (numColors > 0) {
            def colorIdx:int 0
            while (colorIdx < numColors) {
                def pct:double (itemAt stopsAt colorIdx)
                if (pct < 0.0) {
                    pct = 0.0
                    if (numColors > 1) {
                        pct = ((to_double colorIdx) / (to_double (numColors - 1)))
                    }
                }
                def col:EVGColor (itemAt colors colorIdx)
                grad.addStop(pct col)
                colorIdx = colorIdx + 1
            }
        }

        return grad
    }

    ; What is inside the outermost parentheses, cut at the commas that are not
    ; inside a nested call.
    sfn splitArgs:void (src:string out:[string]) {
        def len:int (strlen src)
        def open:int (indexOf src "(")
        if (open < 0) {
            return
        }
        def depth:int 0
        def cur:string ""
        def i:int open
        while (i < len) {
            def c:int (charAt src i)
            if (c == 40) {
                depth = (depth + 1)
                if (depth > 1) {
                    cur = (cur + "(")
                }
            } {
                if (c == 41) {
                    depth = (depth - 1)
                    if (depth == 0) {
                        if ((strlen (trim cur)) > 0) {
                            push out cur
                        }
                        return
                    }
                    cur = (cur + ")")
                } {
                    if ((c == 44) && (depth == 1)) {
                        if ((strlen (trim cur)) > 0) {
                            push out cur
                        }
                        cur = ""
                    } {
                        cur = (cur + (substring src i (i + 1)))
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen (trim cur)) > 0) {
            push out cur
        }
    }

    ; The color in one argument, ignoring a stop position written after it.
    ; `rgb(…)` and friends end at their own closing bracket; everything else
    ; ends at the first space.
    sfn colorOf:EVGColor (arg:string) {
        def text:string (trim arg)
        def n:int (strlen text)
        if (n == 0) {
            return (EVGColor.noColor())
        }
        def close:int (indexOf text ")")
        if (close >= 0) {
            return (EVGColor.parse((substring text 0 (close + 1))))
        }
        def sp:int (indexOf text " ")
        if (sp > 0) {
            return (EVGColor.parse((substring text 0 sp)))
        }
        return (EVGColor.parse(text))
    }

    ; A stop written as a percentage, or -1 when the argument does not say.
    sfn positionOf:double (arg:string) {
        def text:string (trim arg)
        def pct:int (indexOf text "%")
        if (pct <= 0) {
            return (0.0 - 1.0)
        }
        def start:int pct
        while (start > 0) {
            def c:int (charAt text (start - 1))
            def isNum:boolean (((c >= 48) && (c <= 57)) || ((c == 46) || (c == 45)))
            if (isNum == false) {
                break
            }
            start = (start - 1)
        }
        if (start == pct) {
            return (0.0 - 1.0)
        }
        def v@(optional):double (to_double (substring text start pct))
        if (null? v) {
            return (0.0 - 1.0)
        }
        return ((unwrap v) / 100.0)
    }

    ; `45deg`, or the `to …` keywords CSS accepts in place of one. An angle is
    ; the direction the ramp TRAVELS, 0 to the top and 90 to the right.
    sfn angleOf:double (spec:string fallback:double) {
        def text:string (trim spec)
        def deg:int (indexOf text "deg")
        if (deg > 0) {
            def v@(optional):double (to_double (trim (substring text 0 deg)))
            if (null? v) {
                return fallback
            }
            return (unwrap v)
        }
        if ((indexOf text "to ") == 0) {
            def toTop:boolean ((indexOf text "top") > 0)
            def toBottom:boolean ((indexOf text "bottom") > 0)
            def toLeft:boolean ((indexOf text "left") > 0)
            def toRight:boolean ((indexOf text "right") > 0)
            if (toTop && toRight) {
                return 45.0
            }
            if (toBottom && toRight) {
                return 135.0
            }
            if (toBottom && toLeft) {
                return 225.0
            }
            if (toTop && toLeft) {
                return 315.0
            }
            if toTop {
                return 0.0
            }
            if toRight {
                return 90.0
            }
            if toBottom {
                return 180.0
            }
            if toLeft {
                return 270.0
            }
        }
        return fallback
    }

    ; Convert back to CSS string
    fn toCSSString:string () {
        if (isSet == false) {
            return ""
        }
        
        def result:string ""
        if isLinear {
            result = "linear-gradient(" + (to_string angle) + "deg"
        } {
            result = "radial-gradient(circle"
        }
        
        def numStops:int (array_length stops)
        def i:int 0
        while (i < numStops) {
            def stop:EVGGradientStop (itemAt stops i)
            result = result + ", " + (stop.color.toCSSString())
            i = i + 1
        }
        
        result = result + ")"
        return result
    }
}

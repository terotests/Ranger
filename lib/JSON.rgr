(create_polyfill "
func r_get_opt_json_string( data map[string]interface{}, key string ) *GoNullable  {
    res := new(GoNullable)
    v, ok := data[key]
    if ok {
        if arr, ok := v.(string); ok {
            res.has_value = true
            res.value = arr
            return res
        }
    }
    res.has_value = false
    return res
}
")


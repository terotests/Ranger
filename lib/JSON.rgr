    if (v is bool) { o.Append(((bool)v) ? \"true\" : \"false\"); return; }
    if (v is int) { o.Append(((int)v).ToString(System.Globalization.CultureInfo.InvariantCulture)); return; }
    if (v is long) { o.Append(((long)v).ToString(System.Globalization.CultureInfo.InvariantCulture)); return; }

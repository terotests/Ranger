static ArrayList<String> __getJSONKeys(JSONObject obj) 
{
    ArrayList<String> list = new ArrayList<String>();     
    try {
        JSONArray jsonArray = obj.names();
        if (jsonArray != null) { 
            int len = jsonArray.length();
            for (int i=0;i<len;i++){ 
                list.add(jsonArray.get(i).toString());
            } 
        } 
    } catch( Exception e) {
    }
    return list;
}    

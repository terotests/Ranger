inline void rg_json_write_str(const std::string& s, std::string& out) {
    out.push_back((char)34);
    for (size_t i = 0; i < s.size(); i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == 34 || c == 92) { out.push_back((char)92); out.push_back((char)c); }
        else if (c == 10) { out.push_back((char)92); out.push_back('n'); }
        else if (c == 13) { out.push_back((char)92); out.push_back('r'); }
        else if (c == 9) { out.push_back((char)92); out.push_back('t'); }
        else if (c < 32) {
            static const char* rg_json_hexd = \"0123456789abcdef\";
            out.push_back((char)92); out.push_back('u'); out.push_back('0'); out.push_back('0');
            out.push_back(rg_json_hexd[(c >> 4) & 15]); out.push_back(rg_json_hexd[c & 15]);
        }
        else { out.push_back((char)c); }
    }
    out.push_back((char)34);
}
inline void rg_json_write(const rg_json_val& v, std::string& out);
inline void rg_json_write_obj(const rg_json_obj& o, std::string& out) {
    out.push_back('{');
    if (o) {
        for (size_t i = 0; i < o->items.size(); i++) {
            if (i > 0) { out.push_back(','); }
            rg_json_write_str(o->items[i].first, out);
            out.push_back(':');
            rg_json_write(o->items[i].second, out);
        }
    }
    out.push_back('}');
}
inline void rg_json_write_arr(const rg_json_arr& a, std::string& out) {
    out.push_back('[');
    if (a) {
        for (size_t i = 0; i < a->items.size(); i++) {
            if (i > 0) { out.push_back(','); }
            rg_json_write(a->items[i], out);
        }
    }
    out.push_back(']');
}
inline void rg_json_write(const rg_json_val& v, std::string& out) {
    if (std::holds_alternative<std::string>(v)) { rg_json_write_str(std::get<std::string>(v), out); return; }
    if (std::holds_alternative<bool>(v)) { out += (std::get<bool>(v) ? \"true\" : \"false\"); return; }
    if (std::holds_alternative<int>(v)) { out += std::to_string(std::get<int>(v)); return; }
    if (std::holds_alternative<double>(v)) {
        std::string t = std::to_string(std::get<double>(v));
        while (t.size() > 1 && t[t.size() - 1] == '0' && t.find('.') != std::string::npos) { t.erase(t.size() - 1); }
        if (t.size() > 1 && t[t.size() - 1] == '.') { t.erase(t.size() - 1); }
        out += t;
        return;
    }
    if (std::holds_alternative<rg_json_obj>(v)) { rg_json_write_obj(std::get<rg_json_obj>(v), out); return; }
    if (std::holds_alternative<rg_json_arr>(v)) { rg_json_write_arr(std::get<rg_json_arr>(v), out); return; }
    out += \"null\";
}
inline std::string rg_json_obj_to_string(const rg_json_obj& o) { std::string out; rg_json_write_obj(o, out); return out; }
inline std::string rg_json_arr_to_string(const rg_json_arr& a) { std::string out; rg_json_write_arr(a, out); return out; }

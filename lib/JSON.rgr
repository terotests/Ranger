fun __getJSONKeys(obj: JSONObject): ArrayList<String> {
    val list = ArrayList<String>()
    try {
        val jsonArray = obj.names()
        if (jsonArray != null) {
            val len = jsonArray.length()
            for (i in 0 until len) {
                list.add(jsonArray.get(i).toString())
            }
        }
    } catch (e: Exception) {
    }
    return list
}

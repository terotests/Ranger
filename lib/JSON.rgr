        if d == 44 || d == 125 || d == 93 || d == 32 || d == 10 || d == 13 || d == 9 { break; }
        *i += 1;
    }
    let text = String::from_utf8_lossy(&s[start..*i]).to_string();
    if is_double { RJson::Double(text.parse::<f64>().unwrap_or(0.0)) } else { RJson::Int(text.parse::<i64>().unwrap_or(0)) }
}

; SPDX-License-Identifier: MIT

; EVG and EVGr in one program, for a target the JavaScript harness cannot
; drive: the fixtures of lib/evg/bench/layout-bench.mjs built for both
; engines, laid out, and timed. One line per fixture, size and engine:
;
;   <fixture> <size> <engine> <nodes> <layout ms> <checksum>
;
; `layout ms` is the median of five re-layouts after one warm-up; the
; checksum sums x + y + w + h over every box, so the two engines can be
; compared on the same tree. `bench/speed.mjs --targets cpp,go` builds this
; for C++ and Go and prints the table.

Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../src/lib.rs"

class NativeBench {

    sfn setCss:void (el:EVGElement css:string) {
        def decls:[string] (strsplit css ";")
        for decls d:string i {
            def t:string (trim d)
            if ((strlen t) == 0) {
                continue
            }
            def c:int (indexOf t ":")
            if (c < 0) {
                continue
            }
            el.setAttribute((trim (substring t 0 c)) (trim (substring t (c + 1) (strlen t))))
        }
    }

    sfn node:EVGElement (css:string) {
        def el:EVGElement (new EVGElement())
        NativeBench.setCss(el css)
        return el
    }

    sfn css:string (name:string) {
        if (name == "page") {
            return "display:flex;flex-direction:column;flex-wrap:nowrap;width:1200px;gap:8px;align-items:stretch"
        }
        if (name == "card") {
            return "display:flex;flex-direction:row;flex-wrap:nowrap;gap:12px;padding:8px;align-items:stretch"
        }
        if (name == "rail") {
            return "width:48px;height:56px;background-color:#e4e4e7"
        }
        if (name == "body") {
            return "display:flex;flex-direction:column;flex-wrap:nowrap;flex-grow:1;gap:4px;align-items:stretch"
        }
        if (name == "line") {
            return "height:16px;background-color:#f4f4f5"
        }
        if (name == "gridc") {
            return "display:grid;grid-template-columns:repeat(4, 1fr);gap:10px;width:1200px"
        }
        if (name == "cell") {
            return "display:flex;flex-direction:column;flex-wrap:nowrap;gap:4px;padding:6px;align-items:stretch"
        }
        return "font-size:14px"
    }

    sfn word:string (i:int) {
        def words:[string] ([] _:string ("Ada Lovelace" "Grace Hopper" "Alan Turing" "Edsger Dijkstra" "Barbara McClintock"))
        return (itemAt words (i % 5))
    }

    sfn count:int (n:int per:int) {
        def c:int (to_int ((to_double n) / (to_double per) + 0.5))
        if (c < 1) {
            return 1
        }
        return c
    }

    ; --- EVG

    sfn evgTree:EVGElement (fixture:string n:int) {
        if (fixture == "grid") {
            def g:EVGElement (NativeBench.node((NativeBench.css("gridc"))))
            def cells:int (NativeBench.count(n 5))
            def i:int 0
            while (i < cells) {
                def cell:EVGElement (NativeBench.node((NativeBench.css("cell"))))
                def j:int 0
                while (j < 4) {
                    cell.addChild((NativeBench.node((NativeBench.css("line")))))
                    j = j + 1
                }
                g.addChild(cell)
                i = i + 1
            }
            return g
        }
        def page:EVGElement (NativeBench.node((NativeBench.css("page"))))
        def cards:int (NativeBench.count(n 7))
        def k:int 0
        while (k < cards) {
            def card:EVGElement (NativeBench.node((NativeBench.css("card"))))
            card.addChild((NativeBench.node((NativeBench.css("rail")))))
            def body:EVGElement (NativeBench.node((NativeBench.css("body"))))
            def q:int 0
            while (q < 4) {
                if ((fixture == "text") && (q == 0)) {
                    def tx:EVGElement (NativeBench.node((NativeBench.css("text"))))
                    tx.elementType = 1
                    tx.textContent = (NativeBench.word(k))
                    body.addChild(tx)
                } {
                    body.addChild((NativeBench.node((NativeBench.css("line")))))
                }
                q = q + 1
            }
            card.addChild(body)
            page.addChild(card)
            k = k + 1
        }
        return page
    }

    sfn evgSum:double (el:EVGElement) {
        def s:double (((el.calculatedX + el.calculatedY) + el.calculatedWidth) + el.calculatedHeight)
        for el.children k:EVGElement i {
            s = s + (NativeBench.evgSum(k))
        }
        return s
    }

    sfn evgCount:int (el:EVGElement) {
        def c:int 1
        for el.children k:EVGElement i {
            c = c + (NativeBench.evgCount(k))
        }
        return c
    }

    ; --- EVGr

    sfn evgrTree:EvgrTree (fixture:string n:int) {
        def t:EvgrTree (EvgrTree.new_())
        if (fixture == "grid") {
            def g:int (t.add(-1 (NativeBench.css("gridc"))))
            def cells:int (NativeBench.count(n 5))
            def i:int 0
            while (i < cells) {
                def cell:int (t.add(g (NativeBench.css("cell"))))
                def j:int 0
                while (j < 4) {
                    t.add(cell (NativeBench.css("line")))
                    j = j + 1
                }
                i = i + 1
            }
            return t
        }
        def page:int (t.add(-1 (NativeBench.css("page"))))
        def cards:int (NativeBench.count(n 7))
        def k:int 0
        while (k < cards) {
            def card:int (t.add(page (NativeBench.css("card"))))
            t.add(card (NativeBench.css("rail")))
            def body:int (t.add(card (NativeBench.css("body"))))
            def q:int 0
            while (q < 4) {
                if ((fixture == "text") && (q == 0)) {
                    t.add_text(body (NativeBench.css("text")) (NativeBench.word(k)))
                } {
                    t.add(body (NativeBench.css("line")))
                }
                q = q + 1
            }
            k = k + 1
        }
        return t
    }

    sfn evgrSum:double (t:EvgrTree) {
        def s:double 0.0
        def i:int 0
        def n:int (t.count())
        while (i < n) {
            s = s + (((t.x(i) + t.y(i)) + t.w(i)) + t.h(i))
            i = i + 1
        }
        return s
    }

    sfn median:double (xs:[double]) {
        def s:[double] (sort xs)
        return (itemAt s (idiv (array_length s) 2))
    }

    sfn fmt:string (v:double) {
        def whole:int (to_int (v * 1000.0))
        return (to_string ((to_double whole) / 1000.0))
    }

    sfn report:void (fx:string n:int engine:string nodes:int ms:double sum:double) {
        def line:string ((fx + " ") + (to_string n))
        line = ((line + " ") + engine)
        line = ((line + " ") + (to_string nodes))
        line = ((line + " ") + (NativeBench.fmt(ms)))
        ; the checksum in hundreds, which an int of every target holds
        line = ((line + " ") + (to_string (to_int (sum / 100.0))))
        print line
    }

    sfn main:void () {
        def fixtures:[string] ([] _:string ("flex" "grid" "text"))
        def sizes:[int] ([] _:int (1000 10000 100000))
        for fixtures fx:string fi {
            for sizes n:int si {
                ; EVG
                def root:EVGElement (NativeBench.evgTree(fx n))
                def lay:EVGLayout (new EVGLayout())
                lay.setPageSize(1200.0 900.0)
                lay.layout(root)
                def times:[double]
                def r:int 0
                while (r < 5) {
                    def a:double (wall_clock_ms)
                    lay.layout(root)
                    push times ((wall_clock_ms) - a)
                    r = r + 1
                }
                NativeBench.report(fx n "evg" (NativeBench.evgCount(root)) (NativeBench.median(times)) (NativeBench.evgSum(root)))
                ; EVGr
                def t:EvgrTree (NativeBench.evgrTree(fx n))
                t.layout(1200.0 900.0)
                def times2:[double]
                def r2:int 0
                while (r2 < 5) {
                    def b:double (wall_clock_ms)
                    t.layout(1200.0 900.0)
                    push times2 ((wall_clock_ms) - b)
                    r2 = r2 + 1
                }
                NativeBench.report(fx n "evgr" (t.count()) (NativeBench.median(times2)) (NativeBench.evgrSum(t)))
            }
        }
    }
}
